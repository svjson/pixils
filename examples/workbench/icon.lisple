(ns workbench.icon
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            pixils.ui.icon))



;; Icon primitive

(def icon-width 78)
(def icon-height 58)
(def icon-image-x 23)
(def icon-image-y 4)
(def icon-title-y 41)

(def white {:r 0xff :g 0xff :b 0xff})
(def black {:r 0x00 :g 0x00 :b 0x00})
(def blue {:r 0x00 :g 0x55 :b 0xaa})
(def orange {:r 0xff :g 0x99 :b 0x33})
(def gray {:r 0x99 :g 0x99 :b 0x99})

(defun icon-entry [state]
  (or (:item state) (:entry state)))

(defun icon-selected? [state]
  (= (:id (icon-entry state))
     (:selected-id state)))

(defun icon-hidden? [state]
  (nil? (or (:item state) (:entry state))))

(defun icon-position [state]
  (or (:position state)
      (:position (icon-entry state))))

(defun position-icon! [state ctx]
  (let [pos (icon-position state)]
    (do
      (when pos
        (ui/style! (:view ctx)
                   {:position :absolute
                    :left (:x pos)
                    :top (:y pos)}))
      (ui/style! (:view ctx)
                 {:hidden (icon-hidden? state)})
      state)))

(defun draw-disk! []
  (do
    (r/rect! {:x icon-image-x :y icon-image-y :w 29 :h 25}
             {:fill true :color gray})
    (r/rect! {:x icon-image-x :y icon-image-y :w 29 :h 25}
             {:color black})
    (r/rect! {:x (+ icon-image-x 5) :y (+ icon-image-y 4) :w 19 :h 7}
             {:fill true :color white})
    (r/rect! {:x (+ icon-image-x 7) :y (+ icon-image-y 16) :w 15 :h 5}
             {:fill true :color black})))

(defun draw-drawer! []
  (do
    (r/rect! {:x icon-image-x :y (+ icon-image-y 8) :w 31 :h 19}
             {:fill true :color orange})
    (r/rect! {:x icon-image-x :y (+ icon-image-y 8) :w 31 :h 19}
             {:color black})
    (r/rect! {:x (+ icon-image-x 3) :y icon-image-y :w 14 :h 8}
             {:fill true :color orange})
    (r/line! {:x (+ icon-image-x 3) :y (+ icon-image-y 8)}
             {:x (+ icon-image-x 17) :y (+ icon-image-y 8)}
             black)))

(defun draw-tool! []
  (do
    (r/rect! {:x (+ icon-image-x 6) :y icon-image-y :w 18 :h 25}
             {:fill true :color white})
    (r/rect! {:x (+ icon-image-x 6) :y icon-image-y :w 18 :h 25}
             {:color black})
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 7)}
             {:x (+ icon-image-x 20) :y (+ icon-image-y 7)}
             black)
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 13)}
             {:x (+ icon-image-x 20) :y (+ icon-image-y 13)}
             black)))

(defun draw-trash! []
  (do
    (r/rect! {:x (+ icon-image-x 5) :y (+ icon-image-y 7) :w 22 :h 22}
             {:fill true :color gray})
    (r/rect! {:x (+ icon-image-x 5) :y (+ icon-image-y 7) :w 22 :h 22}
             {:color black})
    (r/line! {:x (+ icon-image-x 3) :y (+ icon-image-y 5)}
             {:x (+ icon-image-x 29) :y (+ icon-image-y 5)}
             black)
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 12)}
             {:x (+ icon-image-x 10) :y (+ icon-image-y 24)}
             black)
    (r/line! {:x (+ icon-image-x 17) :y (+ icon-image-y 12)}
             {:x (+ icon-image-x 17) :y (+ icon-image-y 24)}
             black)))

(defun draw-project! []
  (do
    (r/rect! {:x (+ icon-image-x 6) :y icon-image-y :w 20 :h 27}
             {:fill true :color white})
    (r/rect! {:x (+ icon-image-x 6) :y icon-image-y :w 20 :h 27}
             {:color black})
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 8)}
             {:x (+ icon-image-x 22) :y (+ icon-image-y 8)}
             black)
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 14)}
             {:x (+ icon-image-x 22) :y (+ icon-image-y 14)}
             black)
    (r/line! {:x (+ icon-image-x 10) :y (+ icon-image-y 20)}
             {:x (+ icon-image-x 18) :y (+ icon-image-y 20)}
             black)))

(defun draw-icon-image! [entry]
  (case (:type entry)
    :disk (draw-disk!)
    :drawer (draw-drawer!)
    :trash (draw-trash!)
    :project (draw-project!)
    :default (draw-tool!)))

(defun draw-title! [entry selected?]
  (let [title (or (:title entry) "")
        text-size (r/text-size title)
        text-x (max 0 (int (/ (- icon-width (:w text-size)) 2)))]
    (do
      (when selected?
        (r/rect! {:x 3 :y icon-title-y :w (- icon-width 6) :h 13}
                 {:fill true :color blue}))
      (r/text! title
               {:x text-x :y (+ icon-title-y 2)}
               {:color (if selected? white black)}))))

(defcomponent workbench-icon
  (ui/make-draggable
   {:extend 'ui/icon
    :style {:width icon-width
            :height icon-height
            :cursor :workbench/pointer}
    :update position-icon!
    :render (fn [state ctx]
              (when (not (icon-hidden? state))
                (let [entry (icon-entry state)
                      selected? (icon-selected? state)]
                  (do
                    (draw-icon-image! entry)
                    (draw-title! entry selected?)))))}
   {:start-event :ui/icon-drag-start
    :move-event :ui/icon-drag-move
    :end-event :ui/icon-drag-end}))

(defcomponent workbench-icon-preview
  {:extend 'ui/icon-preview
   :style {:position :absolute
           :width icon-width
           :height icon-height
           :hit-test false
           :cursor :workbench/pointer}
   :render (fn [state ctx]
             (when (not (icon-hidden? state))
               (let [entry (icon-entry state)]
                 (do
                   (draw-icon-image! entry)
                   (draw-title! entry true)))))})
