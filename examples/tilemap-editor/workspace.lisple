(ns tilemap-editor.workspace
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.split-pane :as split]
            tilemap-editor.canvas
            tilemap-editor.controls
            [tilemap-editor.inspector :as inspector]
            [tilemap-editor.palette :as palette]))



;; Workspace layout

(defcomponent side-panel
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children [{:mode 'layer-controls
               :state {:selected-layer-index (ui/bind-state :selected-layer-index)
                       :selected-layer-label (ui/bind-state :selected-layer-label)
                       :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                       :layers (ui/bind-state :layers)}}
              {:mode 'tileset-controls
               :state {:selected-tileset-index (ui/bind-state :selected-tileset-index)
                       :selected-layer-index (ui/bind-state :selected-layer-index)
                       :layers (ui/bind-state :layers)}}
              {:mode 'zoom-control
               :state {:zoom (ui/bind-state :zoom)
                       :zoom-label (ui/bind-state :zoom-label)}}
              (palette/make-tile-palette)
              (inspector/make-inspector-panel)]})

(defcomponent workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :children [(split/make
               {:style {:width :fill
                        :height :fill}
                :axis :x
                :split 0.72
                :min-first 280
                :min-second 220
                :state {:selected-tile (ui/bind-state :selected-tile)
                        :selected-label (ui/bind-state :selected-label)
                        :selected-tileset-index (ui/bind-state :selected-tileset-index)
                        :tileset (ui/bind-state :tileset)
                        :selected-layer-index (ui/bind-state :selected-layer-index)
                        :selected-layer-label (ui/bind-state :selected-layer-label)
                        :layers (ui/bind-state :layers)
                        :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                        :map-offset (ui/bind-state :map-offset)
                        :zoom (ui/bind-state :zoom)
                        :zoom-label (ui/bind-state :zoom-label)
                        :show-grid? (ui/bind-state :show-grid?)}
                :children [{:mode 'map-area
                            :state {:selected-tile (ui/bind-state :selected-tile)
                                    :selected-layer-index (ui/bind-state :selected-layer-index)
                                    :layers (ui/bind-state :layers)
                                    :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                                    :map-offset (ui/bind-state :map-offset)
                                    :zoom (ui/bind-state :zoom)
                                    :show-grid? (ui/bind-state :show-grid?)}}
                           {:mode 'side-panel
                            :style {:padding {:l 8}}
                            :state {:selected-tile (ui/bind-state :selected-tile)
                                    :selected-label (ui/bind-state :selected-label)
                                    :selected-tileset-index (ui/bind-state :selected-tileset-index)
                                    :tileset (ui/bind-state :tileset)
                                    :selected-layer-index (ui/bind-state :selected-layer-index)
                                    :selected-layer-label (ui/bind-state :selected-layer-label)
                                    :layers (ui/bind-state :layers)
                                    :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                                    :zoom (ui/bind-state :zoom)
                                    :zoom-label (ui/bind-state :zoom-label)}}]})]})
