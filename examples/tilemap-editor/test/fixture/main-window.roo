(ns tilemap-editor.fixture.main-window
  (:require proof.core
            [pixils.test :as px]
            [pixils.test.tab-panel :as tab-panel]
            [tilemap-editor.fixture.io.project :as project]))

(defun make-app-with-buffer [buffer-width buffer-height]
  (px/make-app {:package-root "."
                     :buffer-width buffer-width
                     :buffer-height buffer-height}))

(defun make-app []
  (make-app-with-buffer 800 600))

(defun open-project-app! [app project-id]
  (px/push-mode! app 'main-mode)
  (px/update! app)
  (px/set-active-state! app
                             (assoc (px/active-state app)
                                    :project-history-path (project/history-path project-id)
                                    :recent-projects []))
  (px/push-mode-with-overrides!
   app
   'ui/tab-panel-empty
   nil
   {:origin {:view (px/active-mode app)
             :event :project/file-dialog-result}})
  (px/pop-mode! app (project/file-dialog-payload project-id
                                                      :file-dialog/open))
  (px/update! app)
  (px/update! app)
  (px/render! app)
  app)

(defun open-project! [project-id]
  (open-project-app! (make-app) project-id))

(defun open-project-with-buffer! [project-id buffer-width buffer-height]
  (open-project-app! (make-app-with-buffer buffer-width buffer-height)
                     project-id))

(defun is-open? [app]
  (let [open? (= "main-mode" (px/active-mode-name app))]
    (is (= true open?))
    open?))

(defun tab-id [target]
  (case target
    :tab/map :map
    :tab/tilemap :map
    :tab/tiles :tilesets
    :tab/tilesets :tilesets
    :tab/terrains :terrains
    :tab/brushes :brushes
    :tab/resources :resources
    :tab/masks :masks
    :default target))

(defun switch-to! [app target opts]
  (let [id (tab-id target)]
    (tab-panel/switch-to! app id opts)
    (when (not= false (:verify-result opts))
      (is (= id (:workspace-tab (px/active-state app)))))
    app))

(defun menu-command [item]
  (case item
    :menu-item/edit :edit
    :menu-item/duplicate :duplicate
    :menu-item/delete :delete
    :menu-item/rename :rename
    :default item))

(defun choose-menu-item! [app item opts]
  (let [command (menu-command item)
        menu-item (or (px/find-view-containing app
                                                    "ui/popup-menu-item"
                                                    (str ":action " command))
                      (px/find-view-containing app
                                                    "ui/popup-menu-item"
                                                    (str ":command " command)))]
    (is (some? menu-item))
    (case (:by opts)
      :mouse/click (px/click! app menu-item)
      :default (px/click! app menu-item))
    (px/update! app)
    (px/render! app)
    app))

(defun cancel-dialog! [app]
  (px/pop-mode! app {:choice :dialog/cancel})
  (px/update! app)
  (px/render! app)
  app)
