(ns tilemap-editor.fixture.view.tilemap.tilemap-tab
  (:require proof.core
            [pixils.tilemap.project.model :as data]
            [pixils.test :as px]
            [pixils.test.combo-box :as combo-box]
            [tilemap-editor.fixture.components.tile-grid :as tile-grid]))

(defun tile-id [target]
  (let [text (str target)
        prefix ":tile/"]
    (if (= prefix (substr text 0 (count prefix)))
      (keyword (substr text (count prefix)))
      target)))

(defun layer-count-is? [app expected]
  (let [actual (count (px/find-views app "layer-row"))]
    (is (= expected actual))
    actual))

(defun palette-grid [app]
  (px/find-view app "tile-select-grid"))

(defun palette-option-index [app target]
  (let [grid (palette-grid app)
        id (tile-id target)]
    (is (some? grid))
    (find-index (:options (px/view-state grid))
                (fn [option]
                  (= id (:value option))))))

(defun palette-contains-tile? [app target]
  (let [index (palette-option-index app target)
        present? (some? index)]
    (is (= true present?))
    present?))

(defun select-palette-tile! [app target opts]
  (let [grid (palette-grid app)
        index (palette-option-index app target)]
    (is (some? grid))
    (is (some? index))
    (tile-grid/click-index! app grid index opts)))

(defun selected-palette-tile-is? [app target]
  (let [id (tile-id target)
        index (palette-option-index app target)
        grid (palette-grid app)
        grid-state (px/view-state grid)]
    (is (= id (:selected-tile (px/active-state app))))
    (is (= [index] (:selected-indices grid-state)))
    id))

(defun tileset-selector-has? [app text]
  (combo-box/has-visible-text? app text))

(defun select-map-region!
  "Selects a rectangular map region by dragging between two cells.

  Args:
  - `app`: Running Tilemap Editor test application.
  - `from`: Starting map cell with `:x` and `:y` coordinates.
  - `to`: Ending map cell with `:x` and `:y` coordinates.

  Returns:
  The application immediately after completing the drag."
  [app from to]
  (let [canvas (px/find-view app "map-canvas")]
    (is (some? canvas))
    (px/mouse-drag-in! app
                            canvas
                            (+ (* (:x from) data/tile-size) 2)
                            (+ (* (:y from) data/tile-size) 2)
                            (+ (* (:x to) data/tile-size) 2)
                            (+ (* (:y to) data/tile-size) 2))
    app))
