(ns tilemap-editor.fixture.view.property-sets.workspace
  (:require proof.core
            [pixils.ui :as ui]
            [pixils.test :as px]
            [pixils.test.combo-box :as combo-box]
            [pixils.test.list-box :as list-box]
            [pixils.test.tab-panel :as tab-panel]))

(defun open!
  "Opens the Property Sets workspace through its application tab.

  Args:
  - `app`: Running Tilemap Editor test application.

  Returns:
  The application immediately after clicking the Property Sets tab."
  [app]
  (let [tab (tab-panel/tab app :property-sets)]
    (is (some? tab))
    (px/click! app tab)
    app))

(defun request-add-set!
  "Requests a new property set through the workspace header.

  Args:
  - `app`: Tilemap Editor test application showing the Property Sets workspace.

  Returns:
  The application immediately after clicking the add button."
  [app]
  (let [panel (px/find-view-containing app
                                            "ui/header-panel"
                                            "Property Sets")
        header (when panel (head (ui/children panel)))
        button (when header (nth (ui/children header) 1))]
    (is (some? panel))
    (is (= "ui/button" (px/view-mode-name button)))
    (px/click! app button)
    app))

(defun request-add-property!
  "Requests a new property through the Fields header.

  Args:
  - `app`: Tilemap Editor test application showing a property set.

  Returns:
  The application immediately after clicking the add button."
  [app]
  (let [panel (px/find-view-containing app "ui/header-panel" "Fields")
        header (when panel (head (ui/children panel)))
        button (when header (nth (ui/children header) 1))]
    (is (some? panel))
    (is (= "ui/button" (px/view-mode-name button)))
    (px/click! app button)
    app))

(defun shows-list-item?
  "Checks whether a list box renders `label`.

  Args:
  - `app`: Running Tilemap Editor test application.
  - `label`: Exact item label expected in a list box.

  Returns:
  True when a list box renders `label`."
  [app label]
  (not-empty? (list-box/views-containing app label)))

(defun enum-value-editor-visible?
  "Returns whether the selected property's enum-value editor is visible.

  Args:
  - `app`: Running Tilemap Editor test application.

  Returns:
  True when the form renders an array control for enum values."
  [app]
  (any? (px/find-views app "pixils/form-array-control")
        (fn [view]
          (= :values (-> view :state :field-id)))))

(defun enum-default-is?
  "Returns whether the selected enum property shows `value` as its default.

  Args:
  - `app`: Running Tilemap Editor test application.
  - `value`: Expected visible default value.

  Returns:
  True when a combo box renders `value`."
  [app value]
  (not-empty? (combo-box/views-containing app value)))

(defun request-add-enum-value!
  "Requests a new value through the selected enum property's array editor.

  Args:
  - `app`: Tilemap Editor test application showing an enum property.

  Returns:
  The application immediately after clicking the Add button."
  [app]
  (let [button (px/find-view-containing app "ui/button" "Add")]
    (is (some? button))
    (px/click! app button)
    app))

(defun enter-enum-value!
  "Enters `value` into the open enum-value dialog.

  Args:
  - `app`: Tilemap Editor test application with the enum-value dialog open.
  - `value`: Scalar text to enter.

  Returns:
  The application immediately after entering `value`."
  [app value]
  (let [input (find-first (px/find-views app "ui/text-input")
                          (fn [view]
                            (= "" (-> view :ui-state :value))))]
    (is (some? input))
    (px/click! app input)
    (for [character value]
      (px/press-key! app (keyword (str character))))
    app))

(defun confirm-enum-value!
  "Confirms the open enum-value dialog.

  Args:
  - `app`: Tilemap Editor test application with the enum-value dialog open.

  Returns:
  The application immediately after clicking the dialog's OK button."
  [app]
  (let [button (px/find-view-containing app "ui/button" "OK")]
    (is (some? button))
    (px/click! app button)
    app))

(defun set-property-label!
  "Changes an existing property's label through its form field.

  Args:
  - `app`: Tilemap Editor test application showing the property editor.
  - `current-label`: Current property label used to identify its field.
  - `label`: Replacement property label to enter.

  Returns:
  The application immediately after entering `label`."
  [app current-label label]
  (let [input (find-first (px/find-views app "ui/text-input")
                          (fn [view]
                            (= current-label (-> view :ui-state :value))))]
    (is (some? input))
    (px/click! app input)
    (px/press-modified-key! app :left-ctrl :a)
    (for [character label]
      (px/press-key! app (keyword (str character))))
    (px/click! app
                    (px/find-view-containing app "ui/text" "Fields"))
    app))

(defun project-state
  "Returns the project state relevant to property-set acceptance tests.

  Args:
  - `app`: Running Tilemap Editor test application.

  Returns:
  A map containing the active workspace, property sets, and their selection."
  [app]
  (select-keys (px/active-state app)
               [:workspace-tab
                :property-sets
                :selected-property-set-index]))
