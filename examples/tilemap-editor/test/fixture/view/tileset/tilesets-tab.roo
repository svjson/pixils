(ns tilemap-editor.fixture.view.tileset.tilesets-tab
  (:require proof.core
            [pixils.test :as px]
            [pixils.test.combo-box :as combo-box]
            [pixils.test.list-box :as list-box]
            [tilemap-editor.fixture.components.tile-grid :as tile-grid]
            [tilemap-editor.fixture.io.project :as project]))

(defun tileset-definition [app target]
  (let [id (project/tileset-id target)]
    (head (filter (or (:tilesets (px/active-state app)) [])
                  (fn [tileset]
                    (= id (:id tileset)))))))

(defun open-context-menu! [app target opts]
  (let [tileset (tileset-definition app target)
        row (px/find-view-containing app
                                          "tileset-definition-row"
                                          (:label tileset))]
    (is (not (nil? tileset)))
    (is (not (nil? row)))
    (case (:by opts)
      :mouse/right-click (px/mouse-click-in! app row 5 5 :right)
      :default (px/mouse-click-in! app row 5 5 :right))
    (px/render! app)
    app))

(defun edit-dialog-is-open? [app]
  (let [open? (= "tileset-edit-dialog-modal" (px/active-mode-name app))]
    (is (= true open?))
    open?))

(defun edit-dialog-matches? [app expected]
  (let [dialog-state (px/active-state app)]
    (is (= (get expected :tileset/id) (:tileset-id dialog-state)))
    (is (= (get expected :tileset/label) (:tileset-label dialog-state)))
    (is (= (get expected :tileset/tile-size) (:tile-size dialog-state)))
    true))

(defun tile-grid []
  "tileset-tile-grid")

(defun grid [app]
  (px/find-view app (tile-grid)))

(defun select-tile-range! [app from-index to-index opts]
  (let [view (grid app)]
    (is (not (nil? view)))
    (tile-grid/drag-range! app view from-index to-index opts)))

(defun select-tile! [app index opts]
  (let [view (grid app)]
    (is (not (nil? view)))
    (tile-grid/click-index! app view index opts)))

(defun move-selected-tile! [app direction opts]
  (tile-grid/move-selection! app direction opts))

(defun selected-tile-index-is? [app index]
  (let [selected (:selected-tileset-tile-index (px/active-state app))]
    (is (= index selected))
    selected))

(defun selected-tile-indices-are? [app indices]
  (let [selected (:selected-tileset-tile-indices (px/active-state app))]
    (is (= indices selected))
    selected))

(defun definition-list-contains? [app text]
  (list-box/has-visible-text? app text))

(defun tile-type-selector-is? [app text]
  (combo-box/count-is? app 1)
  (combo-box/has-visible-text? app text))

(defun tile-definition-panel-count-is? [app expected]
  (let [actual (count (px/find-views app "tile-definition-panel"))]
    (is (= expected actual))
    actual))

(defun request-delete-selection! [app opts]
  (case (:by opts)
    :keyboard/delete (px/key-down! app :delete)
    :default (px/key-down! app :delete))
  (px/update! app)
  (px/update! app)
  (px/render! app)
  app)

(defun delete-dialog-is-open? [app expected-indices]
  (let [payload (px/dialog-payload app)]
    (is (= true (px/dialog-open? app :delete-tiles)))
    (is (= expected-indices (:tile-indices payload)))
    true))

(defun open-tile-context-menu! [app target opts]
  (let [index (:tile-index target)
        view (grid app)]
    (is (not (nil? view)))
    (tile-grid/right-click-index! app view index opts)
    (is (= "ui/context-menu" (px/active-mode-name app)))
    app))
