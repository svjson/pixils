(ns tilemap-editor.fixture.view.terrains.terrains-tab
  (:require proof.core
            [pixils.test :as px]))

(defun switch-detail-to! [app target opts]
  (let [label (case target
                :detail/terrain "Terrain"
                :default target)
        tab (px/find-view-containing app "ui/tab" (str ":label \"" label "\""))]
    (is (some? tab))
    (case (:by opts)
      :mouse/click (px/click! app tab)
      :default (px/click! app tab))
    (px/update! app)
    (px/render! app)
    app))

(defun switch-rule-editor-to! [app tab-id opts]
  (let [tab (px/find-view-containing app "ui/tab" (str ":tab-id " tab-id))]
    (is (some? tab))
    (case (:by opts)
      :mouse/click (px/click! app tab)
      :default (px/click! app tab))
    (px/update! app)
    (px/render! app)
    app))

(defun switch-standard-output-picker-to! [app tab-id opts]
  (let [tab (px/find-view-containing app "ui/tab" (str ":tab-id " tab-id))]
    (is (some? tab))
    (case (:by opts)
      :mouse/click (px/click! app tab)
      :default (px/click! app tab))
    (px/update! app)
    (px/render! app)
    (let [selected-tab (px/find-view-containing app
                                                     "ui/tab"
                                                     (str ":tab-id " tab-id))]
      (is (= true (:selected? (px/view-state selected-tab)))))
    app))

(defun add-rule! [app opts]
  (let [button (px/find-view-containing app "ui/button" "Add rule")]
    (is (some? button))
    (case (:by opts)
      :mouse/click (px/click! app button)
      :default (px/click! app button))
    (px/update! app)
    (px/render! app)
    app))

(defun change-base-tile!
  "Changes the selected terrain's base tile through its popup picker.

  Args:
  - `app`: Running tilemap-editor test application.
  - `tile`: Tile identity to choose from the fixture's two-tile picker.
  - `opts`: Interaction options containing the requested `:by` mechanism.

  Returns:
  The running test application."
  [app tile opts]
  (let [preview (px/find-view app "terrain-preview")]
    (is (some? preview))
    (case (:by opts)
      :mouse/click (px/click! app preview)
      :default (px/click! app preview))
    (px/update! app)
    (px/render! app)
    (is (= "terrain-base-tile-popup" (px/active-mode-name app)))
    (let [picker (px/find-view app "terrain-base-tile-picker")
          x (case tile
              :water-fill 50
              :default 16)]
      (is (some? picker))
      (px/mouse-click-in! app picker x 16)
      (px/update! app)
      (px/render! app)
      app)))

(defun select-enum-property-value!
  "Selects an enum property value in the terrain property editor.

  Args:
  - `app`: Running tilemap-editor test application.
  - `property-id`: Identity of the terrain property to edit.
  - `value`: Enum value to select.
  - `opts`: Interaction options containing the requested `:by` mechanism.

  Returns:
  The running test application."
  [app property-id value opts]
  (let [control (px/find-view-containing
                 app
                 "property-value-enum-control"
                 (str ":property-id " property-id))
        option-index (when control
                       (find-index (:options (px/view-state control))
                                   (fn [option]
                                     (= (:value option) value))))]
    (is (some? control))
    (is (some? option-index))
    (case (:by opts)
      :mouse/click (px/click! app control)
      :default (px/click! app control))
    (px/update! app)
    (is (= "ui/combo-box-popup" (px/active-mode-name app)))
    (px/pop-mode! app {:selected-indices [option-index]})
    (px/update! app)
    (px/update! app)
    (px/render! app)
    app))

(defun terrain-by-id
  "Finds a terrain in the active project.

  Args:
  - `app`: Running tilemap-editor test application.
  - `terrain-set-id`: Identity of the terrain set to inspect.
  - `terrain-id`: Identity of the terrain to find.

  Returns:
  The matching terrain, or nil when it does not exist."
  [app terrain-set-id terrain-id]
  (let [terrain-set (find-first (:terrain-sets (px/active-state app))
                                (fn [candidate]
                                  (= (:id candidate) terrain-set-id)))]
    (find-first (:terrains terrain-set)
                (fn [candidate]
                  (= (:id candidate) terrain-id)))))

(defun terrain-base-tile-is?
  "Asserts the stored base tile for a terrain.

  Args:
  - `app`: Running tilemap-editor test application.
  - `terrain-set-id`: Identity of the terrain set to inspect.
  - `terrain-id`: Identity of the terrain to inspect.
  - `expected`: Expected base-tile identity.

  Returns:
  The stored base-tile identity."
  [app terrain-set-id terrain-id expected]
  (let [terrain (terrain-by-id app terrain-set-id terrain-id)
        actual (:tile terrain)]
    (is (= expected actual))
    actual))

(defun selected-rule-is? [app rule-id]
  (let [state (px/active-state app)]
    (is (= rule-id (:selected-terrain-rule-id state)))
    (is (some? (px/find-view-containing app
                                             "terrain-rule-list"
                                             (str rule-id))))
    (is (some? (px/find-view-containing app
                                             "terrain-rule-visual-editor"
                                             (str rule-id))))
    (is (some? (px/find-view-containing app
                                             "ui/list-box-item"
                                             (str rule-id))))
    true))

(defun selected-rule [app]
  (let [state (px/active-state app)
        ruleset (head (:rulesets state))]
    (head (:rules ruleset))))

(defun selected-rule-match [app direction]
  (get-in (selected-rule app) [:match direction]))

(defun selected-rule-output-tiles [app]
  (get-in (selected-rule app) [:output :layers 0 :tiles]))

(defun selected-rule-output-overlays [app]
  (get-in (selected-rule app) [:output :layers 0 :transition-overlays]))

(defun set-selected-rule-exclusive! [app exclusive? opts]
  (let [checkbox (px/find-view-containing app
                                               "ui/checkbox"
                                               ":terrain-rule-exclusive")]
    (is (some? checkbox))
    (case (:by opts)
      :mouse/click (px/click! app checkbox)
      :default (px/click! app checkbox))
    (px/update! app)
    (is (= exclusive? (:exclusive? (selected-rule app))))
    app))

(defun match-cell [app direction]
  (px/find-view-containing app
                                "terrain-match-tile-cell"
                                (str ":direction " direction " ")))

(defun match-cell-has-tile? [app target expected-tile]
  (let [cell (case target
               :match/center (px/find-view-containing app
                                                           "terrain-match-tile-cell"
                                                           ":center? true")
               :default (match-cell app target))]
    (is (some? cell))
    (let [tile (:tile (px/view-state cell))
          tile-id (if (map? tile)
                    (:id tile)
                    tile)]
      (is (= expected-tile tile-id)))
    true))

(defun cycle-match-cell! [app direction opts]
  (let [cell (match-cell app direction)]
    (is (some? cell))
    (case (:by opts)
      :mouse/right-click (px/mouse-click-in! app cell 8 8 :right)
      :mouse/left-click (px/mouse-click-in! app cell 8 8)
      :default (px/mouse-click-in! app cell 8 8 :right))
    (px/update! app)
    app))

(defun rule-match-is? [app direction expected]
  (let [actual (selected-rule-match app direction)]
    (is (= expected actual))
    actual))

(defun stamp-cell [app target]
  (case target
    :stamp/origin (px/find-view-containing app
                                                "terrain-stamp-grid-cell"
                                                ":visible? true")
    :default (px/find-view-containing app
                                           "terrain-stamp-grid-cell"
                                           ":visible? true")))

(defun tile-picker-position [tile]
  (case tile
    :tile/water-fill {:x 84 :y 16}
    :tile/none {:x 16 :y 16}
    :default {:x 16 :y 16}))

(defun selected-stamp-tile-is? [app tile]
  (let [selected (:terrain-rule-selected-tile (px/active-state app))]
    (is (= tile selected))
    selected))

(defun drag-stamp-tile! [app tile target opts]
  (let [picker (px/find-view app "terrain-stamp-tile-picker")
        cell (stamp-cell app target)
        pos (tile-picker-position tile)]
    (is (some? picker))
    (is (some? cell))
    (case (:by opts)
      :mouse/drag (px/mouse-drag-between! app
                                               picker
                                               (:x pos)
                                               (:y pos)
                                               cell
                                               8
                                               8)
      :default (px/mouse-drag-between! app
                                            picker
                                            (:x pos)
                                            (:y pos)
                                            cell
                                            8
                                            8))
    app))

(defun standard-role-slot [app role-id]
  (px/find-view-containing app
                                "terrain-standard-role-slot"
                                (str ":role-id " role-id)))

(defun drag-standard-role-tile! [app tile role-id opts]
  (let [picker (px/find-view app "terrain-stamp-tile-picker")
        cell (standard-role-slot app role-id)
        pos (tile-picker-position tile)]
    (is (some? picker))
    (is (some? cell))
    (case (:by opts)
      :mouse/drag (px/mouse-drag-between! app
                                               picker
                                               (:x pos)
                                               (:y pos)
                                               cell
                                               8
                                               8)
      :default (px/mouse-drag-between! app
                                            picker
                                            (:x pos)
                                            (:y pos)
                                            cell
                                            8
                                            8))
    app))

(defun output-tiles-are? [app tiles]
  (let [actual (selected-rule-output-tiles app)]
    (is (= tiles actual))
    actual))

(defun output-overlays-are? [app overlays]
  (let [actual (selected-rule-output-overlays app)]
    (is (= overlays actual))
    actual))
