(ns tilemap-editor.fixture.components.tile-grid
  (:require [pixils.test.runtime :as runtime]))

(def cell-size 16)
(def cell-point-offset 5)

(defun columns [grid]
  (max 1 (int (/ (max 1 (or (-> grid :bounds :w) 1))
                 cell-size))))

(defun index-x [grid index]
  (+ cell-point-offset (* (mod index (columns grid)) cell-size)))

(defun index-y [grid index]
  (+ cell-point-offset (* (int (/ index (columns grid))) cell-size)))

(defun click-index! [app grid index opts]
  (case (:by opts)
    :mouse/click (runtime/mouse-click-in! app grid (index-x grid index) (index-y grid index))
    :default (runtime/mouse-click-in! app grid (index-x grid index) (index-y grid index)))
  (runtime/update! app)
  (runtime/render! app)
  app)

(defun right-click-index! [app grid index opts]
  (case (:by opts)
    :mouse/right-click (runtime/mouse-click-in! app grid (index-x grid index) (index-y grid index) :right)
    :default (runtime/mouse-click-in! app grid (index-x grid index) (index-y grid index) :right))
  (runtime/update! app)
  (runtime/render! app)
  app)

(defun drag-range! [app grid from-index to-index opts]
  (case (:by opts)
    :mouse/shift-drag (do
                        (runtime/key-down! app :left-shift)
                        (runtime/mouse-drag-in! app
                                                grid
                                                (index-x grid from-index)
                                                (index-y grid from-index)
                                                (index-x grid to-index)
                                                (index-y grid to-index))
                        (runtime/key-up! app :left-shift))
    :mouse/drag (runtime/mouse-drag-in! app
                                        grid
                                        (index-x grid from-index)
                                        (index-y grid from-index)
                                        (index-x grid to-index)
                                        (index-y grid to-index))
    :default (runtime/mouse-drag-in! app
                                     grid
                                     (index-x grid from-index)
                                     (index-y grid from-index)
                                     (index-x grid to-index)
                                     (index-y grid to-index)))
  (runtime/update! app)
  (runtime/render! app)
  app)

(defun key [direction]
  (case direction
    :left :left
    :right :right
    :up :up
    :down :down
    :default direction))

(defun move-selection! [app direction opts]
  (case (:by opts)
    :keyboard (runtime/key-down! app (key direction))
    :default (runtime/key-down! app (key direction)))
  (runtime/update! app)
  (runtime/render! app)
  app)
