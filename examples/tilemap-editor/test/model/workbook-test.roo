(ns tilemap-editor.model.workbook-test
  (:require proof.core
            [tilemap-editor.model.workbook :as editor-workbook]))

(deftest change-records-history-outside-editable-state
  (let [state (editor-workbook/change
               {:layers [{:label "Ground"}]
                :selected-layer-label "Ground"}
               {:label "Rename layer"
                :patches [[:set [:layers 0 :label] "Terrain"]
                          [:set [:selected-layer-label] "Terrain"]]})]
    (is (= "Terrain" (get-in state [:layers 0 :label])))
    (is (= "Rename layer"
           (editor-workbook/undo-label state)))
    (is (nil? (get-in state [:workbook-history :value])))))

(deftest undo-restores-workbook-backed-change
  (let [state (editor-workbook/change
               {:layers [{:label "Ground"}]
                :selected-layer-label "Ground"}
               {:label "Rename layer"
                :patches [[:set [:layers 0 :label] "Terrain"]
                          [:set [:selected-layer-label] "Terrain"]]})
        undone (editor-workbook/undo state)]
    (is (= "Ground" (get-in undone [:layers 0 :label])))
    (is (= "Ground" (:selected-layer-label undone)))
    (is (= true (editor-workbook/can-redo? undone)))))

(deftest change-to-records-top-level-state-differences
  (let [state (editor-workbook/change-to
               {:layers [{:label "Ground"}]
                :selected-layer-label "Ground"
                :rendered-menu-state {:can-undo? false}}
               "Rename layer"
               {:layers [{:label "Terrain"}]
                :selected-layer-label "Terrain"
                :rendered-menu-state {:can-undo? true}})
        undone (editor-workbook/undo state)]
    (is (= "Rename layer" (editor-workbook/undo-label state)))
    (is (= "Terrain" (get-in state [:layers 0 :label])))
    (is (= "Terrain" (:selected-layer-label state)))
    (is (= "Ground" (get-in undone [:layers 0 :label])))
    (is (= "Ground" (:selected-layer-label undone)))
    (is (nil? (:rendered-menu-state state)))))

(deftest change-to-skips-history-when-state-is-unchanged
  (let [state {:layers [{:label "Ground"}]}
        next-state (editor-workbook/change-to state "Rename layer" state)]
    (is (= state next-state))
    (is (= false (editor-workbook/can-undo? next-state)))))

(deftest editable-state-excludes-map-edit-history-session
  (let [state (editor-workbook/change-to
               {:layers [{:tiles [[nil]]}]
                :map-edit-history-start {:layers [{:tiles [[nil]]}]}
                :map-edit-history-label "Paint map"}
               "Paint map"
               {:layers [{:tiles [[:grass]]}]
                :map-edit-history-start {:layers [{:tiles [[nil]]}]}
                :map-edit-history-label "Paint map"})
        undone (editor-workbook/undo state)]
    (is (= "Paint map" (editor-workbook/undo-label state)))
    (is (= [[nil]] (get-in undone [:layers 0 :tiles])))
    (is (nil? (:map-edit-history-start state)))
    (is (nil? (:map-edit-history-label state)))))
