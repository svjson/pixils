(ns tilemap-editor.view.tilemap.palette-test
  (:require proof.core
            [tilemap-editor.view.tilemap.palette :as palette]))

(deftest tile-palette-is-disabled-when-empty
  (is (= true
         (:disabled? (palette/tile-select-grid-state
                      {:tilesets []
                       :layers [{:id :ground
                                 :data-kind :tile-ref
                                 :tileset :colors}]
                       :selected-layer-index 0})))))

(deftest tile-palette-is-disabled-without-layers
  (let [tilesets [{:id :colors
                   :label "Colors"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= true
           (:disabled? (palette/tile-select-grid-state
                        {:tilesets tilesets
                         :layers []
                         :selected-layer-index nil}))))
    (is (not= true
              (:disabled? (palette/tile-select-grid-state
                           {:tilesets tilesets
                            :layers [{:id :ground
                                      :data-kind :tile-ref
                                      :tileset :colors}]
                            :selected-layer-index 0}))))))

(deftest tile-palette-state-ignores-stale-parent-disabled-flag-when-options-exist
  (let [tilesets [{:id :colors
                   :label "Colors"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (not= true
              (:disabled? (palette/tile-select-grid-state
                           {:tilesets tilesets
                            :layers [{:id :ground
                                      :data-kind :tile-ref
                                      :tileset :colors}]
                            :selected-layer-index 0
                            :disabled? true}))))))

(deftest terrain-palette-grid-lists-terrain-values
  (let [grid-state (palette/tile-select-grid-state
                    {:terrain-sets [{:id :overworld
                                     :terrains [{:id :grass
                                                 :label "Grass"}]}]
                     :layers [{:id :scene/terrain
                               :data-kind :terrain
                               :terrain-set :overworld}]
                     :selected-layer-index 0
                     :selected-tile :grass})]
    (is (not= true (:disabled? grid-state)))
    (is (= [{:value :grass
             :label "Grass"}]
           (:options grid-state)))
    (is (= [0]
           (palette/selected-tile-indices
            {:terrain-sets [{:id :overworld
                             :terrains [{:id :grass
                                         :label "Grass"}]}]
             :layers [{:id :scene/terrain
                       :data-kind :terrain
                       :terrain-set :overworld}]
             :selected-layer-index 0
             :selected-tile :grass})))))

(deftest tile-palette-content-height-grows-by-grid-rows
  (is (= 0 (palette/tile-select-grid-content-height 0 4)))
  (is (= 16 (palette/tile-select-grid-content-height 4 4)))
  (is (= 32 (palette/tile-select-grid-content-height 5 4))))

(deftest tile-palette-list-wraps-grid-in-scroll-pane
  (let [child (palette/tile-palette-list-child)]
    (is (= 'tile-select-grid-scroll-pane (:mode child)))
    (is (some? (-> child :state :selected-tile)))))

(deftest tile-palette-scroll-content-style-offsets-content
  (let [style (palette/tile-select-grid-scroll-content-style
               {:offset 32
                :content-height 96})]
    (is (= :absolute (:position style)))
    (is (= -32 (:top style)))
    (is (= 96 (:height style)))))



;; tilemap-editor.view.tilemap.palette/brush-palette-list-box-child

(deftest brush-palette-list-box-child/disables-empty-options
  (is (= {:options []
          :selected-indices []
          :disabled? true
          :force-selection? true}
         (select-keys
          (-> (palette/brush-palette-list-box-child [] false nil)
              :state
              :component)
          [:options :selected-indices :disabled? :force-selection?]))))

(deftest brush-palette-list-box-child/selects-first-available-brush
  (is (= {:options [{:value 0
                     :label "Stamp"}]
          :selected-indices [0]
          :disabled? false
          :force-selection? true}
         (select-keys
          (-> (palette/brush-palette-list-box-child
               [{:id :stamp
                 :label "Stamp"
                 :kind :pattern}]
               false
               nil)
              :state
              :component)
          [:options :selected-indices :disabled? :force-selection?]))))
