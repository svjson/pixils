(ns tilemap-editor.view.tilemap.canvas-test
  (:require proof.core
            [tilemap-editor.view.tilemap.canvas :as canvas]))

(deftest map-hover-cell-at-event-uses-scroll-offset
  (let [state {:map-width 4
               :map-height 4
               :tile-size 16
               :zoom 1
               :offset {:x 16 :y 32}}
        event {:position {:x 1 :y 1}}]
    (is (= {:x 1 :y 2}
           (canvas/map-hover-cell-at-event state event)))))

(deftest map-hover-cell-at-event-clears-out-of-bounds-positions
  (let [state {:map-width 2
               :map-height 2
               :tile-size 16
               :zoom 1
               :offset {:x 0 :y 0}}
        event {:position {:x 48 :y 0}}]
    (is (nil? (canvas/map-hover-cell-at-event state event)))))

(deftest hidden-render-layer-indices-hide-materialized-source-layers
  (let [input {:hidden-layer-indices [0]
               :layers [{:id :terrain}
                        {:id :visuals}]}
        render-map {:layers [{:id :terrain/world
                              :render-source-layer-id :terrain}
                             {:id :terrain/effects
                              :render-source-layer-id :terrain}
                             {:id :visuals
                              :render-source-layer-id :terrain
                              :ruleset :shore}
                             {:id :visuals}]}]
    (is (= [0 1 2]
           (canvas/hidden-render-layer-indices input render-map)))))

(deftest hidden-render-layer-indices-hide-materialized-target-layers
  (let [input {:hidden-layer-indices [1]
               :layers [{:id :terrain}
                        {:id :visuals}]}
        render-map {:layers [{:id :terrain/world
                              :render-source-layer-id :terrain}
                             {:id :visuals
                              :render-source-layer-id :terrain
                              :ruleset :shore}
                             {:id :visuals}]}]
    (is (= [1 2]
           (canvas/hidden-render-layer-indices input render-map)))))

(deftest render-cache-signature-changes-with-hidden-layers
  (let [render-map {:layers [{:id :terrain/world
                              :render-source-layer-id :terrain}
                             {:id :visuals}]}
        visible (canvas/map-canvas-render-cache-signature
                 {:hidden-layer-indices []
                  :layers [{:id :terrain}
                           {:id :visuals}]}
                 render-map)
        hidden (canvas/map-canvas-render-cache-signature
                {:hidden-layer-indices [0]
                 :layers [{:id :terrain}
                          {:id :visuals}]}
                 render-map)]
    (is (not= visible hidden))))

(deftest refresh-render-map-updates-input-when-only-visibility-changes
  (let [state (canvas/refresh-map-canvas-render-map
               {:map-width 1
                :map-height 1
                :tile-size 16
                :layers [{:id :base
                          :tileset :world
                          :tiles [[:grass]]}]
                :hidden-layer-indices []
                :tilesets []
                :terrain-sets []
                :rulesets []
                :render-map {:width 1
                             :height 1
                             :tile-size 16
                             :layers [{:id :base
                                       :tileset :world
                                       :tiles [[:grass]]
                                       :data-kind :tile-ref}]}
                :render-map-input-signature
                (canvas/map-canvas-render-input-signature
                 {:width 1
                  :height 1
                  :tile-size 16
                  :layers [{:id :base
                            :tileset :world
                            :tiles [[:grass]]}]
                  :tilesets []
                  :terrain-sets []
                  :show-terrain-rules? nil
                  :layer-profile nil
                  :rulesets []})})]
    (is (= []
           (get-in state [:render-map-input :hidden-layer-indices]))))
  (let [state (canvas/refresh-map-canvas-render-map
               {:map-width 1
                :map-height 1
                :tile-size 16
                :layers [{:id :base
                          :tileset :world
                          :tiles [[:grass]]}]
                :hidden-layer-indices [0]
                :tilesets []
                :terrain-sets []
                :rulesets []
                :render-map {:width 1
                             :height 1
                             :tile-size 16
                             :layers [{:id :base
                                       :tileset :world
                                       :tiles [[:grass]]
                                       :data-kind :tile-ref}]}
                :render-map-input-signature
                (canvas/map-canvas-render-input-signature
                 {:width 1
                  :height 1
                  :tile-size 16
                  :layers [{:id :base
                            :tileset :world
                            :tiles [[:grass]]}]
                  :tilesets []
                  :terrain-sets []
                  :show-terrain-rules? nil
                  :layer-profile nil
                  :rulesets []})})]
    (is (= [0]
           (get-in state [:render-map-input :hidden-layer-indices])))))

(deftest refresh-render-map-rebuilds-when-active-map-id-changes
  (let [previous-input {:map-id :map/one
                        :width 1
                        :height 1
                        :tile-size 16
                        :layers [{:id :base
                                  :tileset :world
                                  :tiles [[:grass]]}]
                        :tilesets []
                        :terrain-sets []
                        :show-terrain-rules? nil
                        :layer-profile nil
                        :rulesets []}
        state (canvas/refresh-map-canvas-render-map
               {:selected-map-id :map/two
                :map-width 1
                :map-height 1
                :tile-size 16
                :layers [{:id :base
                          :tileset :world
                          :tiles [[:water]]}]
                :hidden-layer-indices []
                :tilesets []
                :terrain-sets []
                :rulesets []
                :render-map {:width 1
                             :height 1
                             :tile-size 16
                             :layers [{:id :base
                                       :tileset :world
                                       :tiles [[:grass]]
                                       :data-kind :tile-ref}]}
                :render-map-input-signature
                (canvas/map-canvas-render-input-signature previous-input)})]
    (is (= :map/two (get-in state [:render-map-input :map-id])))
    (is (= :water (get-in state [:render-map :layers 0 :tiles 0 0])))))

(deftest render-input-signature-changes-with-tilesets
  (let [base-input {:width 1
                    :height 1
                    :tile-size 16
                    :tilesets [{:id :world
                                :tiles [{:id :grass}]}]
                    :layers []
                    :terrain-sets []
                    :show-terrain-rules? nil
                    :layer-profile nil
                    :rulesets []}
        changed-input (assoc base-input
                             :tilesets [{:id :world
                                         :tiles [{:id :grass}
                                                 {:id :water}]}])]
    (is (not= (canvas/map-canvas-render-input-signature base-input)
              (canvas/map-canvas-render-input-signature changed-input)))))

(deftest map-canvas-render-input-uses-active-map-tile-size
  (let [input (canvas/map-canvas-render-input
               {:map-width 2
                :map-height 1
                :tile-size 32
                :layers []
                :terrain-sets []
                :rulesets []
                :layer-profiles []})]
    (is (= {:w 32 :h 32} (:tile-size input)))))
