(ns tilemap-editor.view.tilemap.dimensions-dialog-test
  (:require proof.core
            [tilemap-editor.view.tilemap.dimensions-dialog :as dialog]))

(deftest map-dimensions-confirm-button-binds_dimensions
  (let [button (dialog/map-dimensions-confirm-button-child)]
    (is (= "OK" (get-in button [:state :label])))
    (is (contains? (:state button) :dimensions))
    (is (contains? (:state button) :valid?))))

(deftest map-dimensions-form-uses_pixils_form_schema_paths
  (let [view (dialog/dimension-form)]
    (is (= 'pixils/form (:mode view)))
    (is (= [:tile-size :w]
           (get-in view [:state :schema :map-dimensions/tile-width :path])))
    (is (= [:tile-size :h]
           (get-in view [:state :schema :map-dimensions/tile-height :path])))))

(deftest map-dimension-change-scales_locked_tile_proportion
  (let [state (dialog/apply-map-dimension-change
               {:tile-size {:w 18 :h 22}
                :tile-proportion {:w 18 :h 22}
                :lock-tile-proportion? true}
               :tile-width
               36)]
    (is (= {:w 36 :h 44} (:tile-size state)))))

(deftest map-dimension-change-can_adjust_tile_sides_independently
  (let [state (dialog/apply-map-dimension-change
               {:tile-size {:w 18 :h 22}
                :tile-proportion {:w 18 :h 22}
                :lock-tile-proportion? false}
               :tile-width
               36)]
    (is (= {:w 36 :h 22} (:tile-size state)))))

(deftest map-dimension-form-change-keeps_nested_dimensions_model
  (let [state (dialog/apply-dimension-form-change
               {:dimensions {:width 10
                             :height 12
                             :tile-size {:w 18 :h 22}}
                :tile-proportion {:w 18 :h 22}
                :lock-tile-proportion? true}
               :tile-width
               36)]
    (is (= {:width 10
            :height 12
            :tile-size {:w 36 :h 44}}
           (:dimensions state)))))
