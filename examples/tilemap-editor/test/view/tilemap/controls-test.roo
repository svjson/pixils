(ns tilemap-editor.view.tilemap.controls-test
  (:require proof.core
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.view.tilemap.controls :as controls]))

(deftest empty-layer-list-keeps-minimum-height
  (is (= 78 (controls/layer-list-height [])))
  (is (= 78 (controls/layer-list-height [1 2])))
  (is (= 104 (controls/layer-list-height [1 2 3 4]))))

(deftest tileset-selector-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/tileset-combo-child [] false)))))
  (is (= true (:disabled? (:state (controls/tileset-combo-child nil false)))))
  (is (= false (:disabled? (:state (controls/tileset-combo-child [{:id :terrain
                                                                    :label "Terrain"}]
                                                                  false))))))

(deftest map-chooser-menu-adds_action_and_checked_map_options
  (let [menu (controls/map-chooser-menu
              [{:id :map/main
                :label "Main"}
               {:id :map/cave
                :label "Cave"}])
        items (:items menu)]
    (is (= "Add New Map" (get-in items [0 :label])))
    (is (= :separator (nth items 1)))
    (is (= :option (get-in items [2 :type])))
    (is (= :map/main (get-in items [2 :value])))
    (is (= [:option-state :selected-map-id]
           (get-in items [2 :selected-path])))))

(deftest map-context-menu-includes_flip_commands
  (let [items (:items (controls/map-context-menu [{:id :map/main}
                                                  {:id :map/cave}]))]
    (is (= "Flip Horizontal" (get-in items [3 :label])))
    (is (= :flip-horizontal (get-in items [3 :payload :command])))
    (is (= "Flip Vertical" (get-in items [4 :label])))
    (is (= :flip-vertical (get-in items [4 :payload :command])))))

(deftest map-workspace-panel-wraps_body_with_title_and_chooser
  (let [panel (controls/make-map-workspace-panel
               {:state {:maps []
                        :selected-map-id :map/main
                        :selected-map-label "Main"}
                :body-state {}
                :children []})]
    (is (= 'map-header-title
           (get-in panel [:children 0 :children 0 :mode])))
    (is (= 'map-chooser-button
           (get-in panel [:children 0 :children 1 :mode])))))

(deftest zoom-slider-state-exposes_pixel_steps_and_percent_label
  (let [state (controls/zoom-slider-state {:tile-size 16
                                           :zoom 1})]
    (is (= 16 (:zoom-pixels state)))
    (is (= 1 (:min-zoom-pixels state)))
    (is (= 64 (:max-zoom-pixels state)))
    (is (= "Zoom 100%" (:zoom-label state))))
  (let [state (controls/apply-zoom-slider-change {:tile-size 16
                                                  :zoom 1}
                                                 4)]
    (is (= 0.25 (:zoom state)))
    (is (= 4 (:zoom-pixels state)))
    (is (= "Zoom 25%" (:zoom-label state)))))

(deftest map-dimensions-confirm-button-binds_tile_size
  (let [button (controls/map-dimensions-confirm-button-child)]
    (is (= "OK" (get-in button [:state :label])))
    (is (contains? (:state button) :width))
    (is (contains? (:state button) :height))
    (is (contains? (:state button) :tile-size))))

(deftest map-dimension-change-scales_locked_tile_proportion
  (let [state (controls/apply-map-dimension-change
               {:tile-size {:w 18 :h 22}
                :tile-proportion {:w 18 :h 22}
                :lock-tile-proportion? true}
               :tile-width
               36)]
    (is (= {:w 36 :h 44} (:tile-size state)))))

(deftest map-dimension-change-can_adjust_tile_sides_independently
  (let [state (controls/apply-map-dimension-change
               {:tile-size {:w 18 :h 22}
                :tile-proportion {:w 18 :h 22}
                :lock-tile-proportion? false}
               :tile-width
               36)]
    (is (= {:w 36 :h 22} (:tile-size state)))))

(deftest tileset-selector-is-disabled_without_layers
  (is (= true (:disabled? (:state (controls/tileset-combo-child [{:id :terrain
                                                                   :label "Terrain"}]
                                                                  true))))))

(deftest layer-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/layer-list-box-child [])))))
  (is (= true (:disabled? (:state (controls/layer-list-box-child nil)))))
  (is (not= true (:disabled? (:state (controls/layer-list-box-child [{:label "Ground"}]))))))

(deftest layer-list-is-reorderable
  (is (= true (:reorderable?
               (:state (controls/layer-list-box-child [{:label "Ground"}]))))))

(deftest layer-reorder-moves_layers_and_remaps_selected_and_hidden_indices
  (let [state (controls/apply-layer-reorder
               {:layers [{:label "A"}
                         {:label "B"}
                         {:label "C"}
                         {:label "D"}]
                :selected-layer-index 2
                :hidden-layer-indices [0 3]}
               {:from-index 0
                :to-index 2})]
    (is (= ["B" "C" "A" "D"] (map (:layers state) :label)))
    (is (= 1 (:selected-layer-index state)))
    (is (= "C" (:selected-layer-label state)))
    (is (= [2 3] (:hidden-layer-indices state)))))

(deftest layer-controls-has_add_button
  (let [panel (controls/make-layer-controls)]
    (is (= "+" (get-in panel [:children 0 :children 1 :state :label])))))

(deftest layer-type-options-show_disabled_terrain_without_sets
  (let [options (controls/layer-data-kind-options-for [])]
    (is (= "Tile layer" (get-in options [0 :label])))
    (is (= "Terrain layer" (get-in options [1 :label])))
    (is (= true (get-in options [1 :disabled?])))))

(deftest append-layer-adds_blank_tile_layer_and_selects_it
  (let [state (controls/append-layer
               {:layers []
                :tilesets [{:id :terrain
                            :label "Terrain"}]}
               "Terrain")]
    (is (= 0 (:selected-layer-index state)))
    (is (= "Terrain" (:selected-layer-label state)))
    (is (= :scene/terrain (get-in state [:layers 0 :id])))
    (is (= :terrain (get-in state [:layers 0 :tileset])))
    (is (= :source (get-in state [:layers 0 :role])))
    (is (= :tile-ref (get-in state [:layers 0 :data-kind])))
    (is (= data/map-height (count (get-in state [:layers 0 :tiles]))))
    (is (= data/map-width (count (get-in state [:layers 0 :tiles 0]))))))

(deftest append-layer-adds_blank_terrain_layer_when_requested
  (let [state (controls/append-layer
               {:layers []
                :terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               {:name "Terrain"
                :data-kind :terrain
                :terrain-set-index 0})]
    (is (= 0 (:selected-layer-index state)))
    (is (= "Terrain" (:selected-layer-label state)))
    (is (= :scene/terrain (get-in state [:layers 0 :id])))
    (is (= :source (get-in state [:layers 0 :role])))
    (is (= :terrain (get-in state [:layers 0 :data-kind])))
    (is (= :overworld (get-in state [:layers 0 :terrain-set])))
    (is (nil? (get-in state [:layers 0 :tileset])))
    (is (= data/map-height (count (get-in state [:layers 0 :tiles]))))
    (is (= data/map-width (count (get-in state [:layers 0 :tiles 0]))))))

(deftest layer-add-dialog-result-appends_unique_layer
  (let [state (controls/apply-layer-name-dialog-result
               {:layers [{:id :scene/layer
                          :label "Layer"}]}
               {:type :confirm
                :operation :add
                :name "Layer"})]
    (is (= "Layer 2" (get-in state [:layers 1 :label])))
    (is (= :scene/layer-2 (get-in state [:layers 1 :id])))
    (is (= 1 (:selected-layer-index state)))))

(deftest layer-add-dialog-result-appends_terrain_layer
  (let [state (controls/apply-layer-name-dialog-result
               {:layers []
                :terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               {:type :confirm
                :operation :add
                :name "Terrain"
                :data-kind :terrain
                :terrain-set-index 0})]
    (is (= :terrain (get-in state [:layers 0 :data-kind])))
    (is (= :overworld (get-in state [:layers 0 :terrain-set])))))

(deftest layer-terrain-set-dialog-result-updates_existing_terrain_layer
  (let [state (controls/apply-layer-name-dialog-result
               {:layers [{:id :scene/terrain
                          :label "Terrain"
                          :data-kind :terrain
                          :terrain-set :overworld
                          :tiles [[nil]]}]
                :terrain-sets [{:id :overworld
                                :label "Overworld"}
                               {:id :caves
                                :label "Caves"}]}
               {:type :confirm
                :operation :terrain-set
                :index 0
                :terrain-set-index 1})]
    (is (= :caves (get-in state [:layers 0 :terrain-set])))
    (is (= [[nil]] (get-in state [:layers 0 :tiles])))))

(deftest layer-terrain-set-dialog-result-ignores_tile_layers
  (let [state (controls/apply-layer-name-dialog-result
               {:layers [{:id :scene/ground
                          :label "Ground"
                          :data-kind :tile-ref
                          :tileset :terrain}]
                :terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               {:type :confirm
                :operation :terrain-set
                :index 0
                :terrain-set-index 0})]
    (is (= :terrain (get-in state [:layers 0 :tileset])))
    (is (nil? (get-in state [:layers 0 :terrain-set])))))

(deftest layer-row-source-label-uses_terrain_set_for_terrain_layers
  (is (= "Caves"
         (controls/layer-source-label
          {:terrain-sets [{:id :caves
                           :label "Caves"}]}
          {:data-kind :terrain
           :terrain-set :caves}))))

(deftest layer-context-menu-enables_terrain_set_for_terrain_layers
  (let [terrain-item (nth (:items (controls/layer-context-menu
                                   {:layer {:data-kind :terrain}
                                    :terrain-sets [{:id :caves}]}))
                         2)
        tile-item (nth (:items (controls/layer-context-menu
                                {:layer {:data-kind :tile-ref}
                                 :terrain-sets [{:id :caves}]}))
                       2)]
    (is (= :terrain-set (-> terrain-item :payload :command)))
    (is (not= true (:disabled? terrain-item)))
    (is (= true (:disabled? tile-item)))))

(deftest append-layer-deduplicates_layer_ids
  (let [state (controls/append-layer
               {:layers [{:id :scene/terrain
                          :label "Terrain"}]}
               "Terrain")]
    (is (= :scene/terrain-2 (get-in state [:layers 1 :id])))))
