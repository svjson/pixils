(ns tilemap-editor.view.menu-test
  (:require proof.core
            [tilemap-editor.view.menu :as menu]))

(deftest recent-project-menu-is-inert-when-empty
  (let [item (menu/recent-project-menu-item [])]
    (is (= "Recent Projects" (:label item)))
    (is (= true (:disabled? item)))
    (is (nil? (:items item)))))

(deftest recent-project-menu-opens-submenu-when-populated
  (let [item (menu/recent-project-menu-item [{:path "map.edn"
                                              :filename "map.edn"}])]
    (is (= "Recent Projects" (:label item)))
    (is (= "map.edn" (get-in item [:items 0 :label])))
    (is (= :project/open-recent (get-in item [:items 0 :action])))))

(deftest menu-keymap-binds_project_and_view_actions
  (is (= :project/new
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/shift :key/n])))
  (is (= :project/open
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/o])))
  (is (= :project/save
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/s])))
  (is (= :project/save-as
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/shift :key/s])))
  (is (= :edit/cut
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/x])))
  (is (= :edit/copy
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/c])))
  (is (= :edit/paste
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/v])))
  (is (= :view/toggle-grid
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/g])))
  (is (= :view/toggle-terrain-rules
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/t])))
  (is (= {:action :terrain-rules/set-application
          :payload :preview}
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/alt :key/p])))
  (is (= {:action :terrain-rules/set-application
          :payload :paint-baked}
         (get menu/tilemap-editor-menu-keymap [:key/ctrl :key/alt :key/b]))))

(deftest option-menu-reflects_current_view_state
  (let [menu (menu/tilemap-editor-menu
              {:show-grid? false
               :show-terrain-rules? true
               :map-selection {:rect {:x 1 :y 2 :w 3 :h 4}
                               :active? false}
               :map-clipboard {:type :tilemap/map-region}
               :terrain-rule-application :paint-baked})
        edit (get-in menu [:items 1 :items])
        options (get-in menu [:items 2 :items])]
    (is (= "Cu&t" (get-in edit [0 :label])))
    (is (= :edit/cut (get-in edit [0 :action])))
    (is (= [:key/ctrl :key/x] (get-in edit [0 :shortcut])))
    (is (nil? (get-in edit [0 :disabled?])))
    (is (= "&Copy" (get-in edit [1 :label])))
    (is (= :edit/copy (get-in edit [1 :action])))
    (is (= [:key/ctrl :key/c] (get-in edit [1 :shortcut])))
    (is (nil? (get-in edit [1 :disabled?])))
    (is (= "&Paste" (get-in edit [2 :label])))
    (is (= :edit/paste (get-in edit [2 :action])))
    (is (= [:key/ctrl :key/v] (get-in edit [2 :shortcut])))
    (is (nil? (get-in edit [2 :disabled?])))
    (is (= :separator (get-in edit [3])))
    (is (= "Map &Dimensions..." (get-in edit [4 :label])))
    (is (= :map/edit-dimensions (get-in edit [4 :action])))
    (is (= "Show &Grid" (get-in options [0 :label])))
    (is (= :toggle (get-in options [0 :type])))
    (is (= [:option-state :show-grid?] (get-in options [0 :selected-path])))
    (is (= "Show Terrain Rule &Output" (get-in options [1 :label])))
    (is (= :toggle (get-in options [1 :type])))
    (is (= [:option-state :show-terrain-rules?]
           (get-in options [1 :selected-path])))
    (is (= "Terrain Rule &Application" (get-in options [3 :label])))
    (is (= "&Preview Only" (get-in options [3 :items 0 :label])))
    (is (= :option (get-in options [3 :items 0 :type])))
    (is (= [:key/ctrl :key/alt :key/p]
           (get-in options [3 :items 0 :shortcut])))
    (is (= :preview (get-in options [3 :items 0 :value])))
    (is (= [:option-state :terrain-rule-application]
           (get-in options [3 :items 0 :selected-path])))
    (is (= "&Bake On Paint" (get-in options [3 :items 1 :label])))
    (is (= :option (get-in options [3 :items 1 :type])))
    (is (= [:key/ctrl :key/alt :key/b]
           (get-in options [3 :items 1 :shortcut])))
    (is (= :paint-baked (get-in options [3 :items 1 :value])))
    (is (= [:option-state :terrain-rule-application]
           (get-in options [3 :items 1 :selected-path])))
    (is (= "&Theme" (get-in options [5 :label])))
    (is (= "Pixils &Default" (get-in options [5 :items 0 :label])))
    (is (= :option (get-in options [5 :items 0 :type])))
    (is (= :pixils/default (get-in options [5 :items 0 :value])))
    (is (= [:option-state :application-theme]
           (get-in options [5 :items 0 :selected-path])))
    (is (nil? (get-in options [5 :items 0 :payload :theme])))
    (is (= "Windows &3" (get-in options [5 :items 1 :label])))
    (is (nil? (get-in options [5 :items 1 :action])))
    (is (= "&Light" (get-in options [5 :items 1 :items 0 :label])))
    (is (= :option (get-in options [5 :items 1 :items 0 :type])))
    (is (= :pixils/windows-3 (get-in options [5 :items 1 :items 0 :value])))
    (is (= [:option-state :application-theme]
           (get-in options [5 :items 1 :items 0 :selected-path])))
    (is (= 'pixils/windows-3
           (get-in options [5 :items 1 :items 0 :payload :theme])))
    (is (= :light (get-in options [5 :items 1 :items 0 :payload :variant])))
    (is (= "&Dark" (get-in options [5 :items 1 :items 1 :label])))
    (is (= :option (get-in options [5 :items 1 :items 1 :type])))
    (is (= :pixils/windows-3-dark
           (get-in options [5 :items 1 :items 1 :value])))
    (is (= [:option-state :application-theme]
           (get-in options [5 :items 1 :items 1 :selected-path])))
    (is (= 'pixils/windows-3
           (get-in options [5 :items 1 :items 1 :payload :theme])))
    (is (= :dark (get-in options [5 :items 1 :items 1 :payload :variant])))
    (is (= "Windows &95" (get-in options [5 :items 2 :label])))
    (is (nil? (get-in options [5 :items 2 :action])))
    (is (= "&Light" (get-in options [5 :items 2 :items 0 :label])))
    (is (= :pixils/windows-95
           (get-in options [5 :items 2 :items 0 :value])))
    (is (= 'pixils/windows-95
           (get-in options [5 :items 2 :items 0 :payload :theme])))
    (is (= :light (get-in options [5 :items 2 :items 0 :payload :variant])))
    (is (= "&Dark" (get-in options [5 :items 2 :items 1 :label])))
    (is (= :pixils/windows-95-dark
           (get-in options [5 :items 2 :items 1 :value])))
    (is (= 'pixils/windows-95
           (get-in options [5 :items 2 :items 1 :payload :theme])))
    (is (= :dark (get-in options [5 :items 2 :items 1 :payload :variant])))
    (is (= "&Classic Blue" (get-in options [5 :items 3 :label])))
    (is (= :pixils/classic-blue (get-in options [5 :items 3 :value])))
    (is (= 'pixils/classic-blue
           (get-in options [5 :items 3 :payload :theme])))))
