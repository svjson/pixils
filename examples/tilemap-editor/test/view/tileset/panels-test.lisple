(ns tilemap-editor.view.tileset.panels-test
  (:require proof.core
            [tilemap-editor.view.tileset.panels :as panels]))

(deftest tileset-definition-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (panels/tileset-list-box-child [])))))
  (is (= true (:disabled? (:state (panels/tileset-list-box-child nil)))))
  (is (not= true
            (:disabled? (:state (panels/tileset-list-box-child
                                 [{:id :terrain
                                   :label "Terrain"}]))))))

(deftest tile-context-menu-includes-rename-command
  (let [rename-item (head (:items panels/tile-context-menu))
        delete-item (nth (:items panels/tile-context-menu) 1)]
    (is (= "Rename" (:label rename-item)))
    (is (= :rename (-> rename-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest sprite-map-preview-source-rect-scales-from-full-asset
  (let [image-rect (panels/sprite-map-preview-image-rect {:w 800
                                                          :h 1280})
        source-rect (panels/sprite-map-preview-source-rect
                     {:x 0 :y 96 :w 16 :h 16}
                     image-rect)]
    (is (= 20 (:x image-rect)))
    (is (= 0 (:y image-rect)))
    (is (= 0.25 (:scale image-rect)))
    (is (= {:x 20 :y 24 :w 4 :h 4}
           source-rect))))

(deftest sprite-map-preview-position-selects_tile_coordinates
  (let [image-rect (panels/sprite-map-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 96 :w 16 :h 16}
           (panels/source-position-from-preview-position
            {:x 28 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            16)))))

(deftest sprite-map-preview-position-can_select_unsnapped_coordinates
  (let [image-rect (panels/sprite-map-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 34 :y 108 :w 16 :h 16}
           (panels/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            false
            16)))))

(deftest sprite-map-preview-position_uses_custom_snap_interval
  (let [image-rect (panels/sprite-map-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 104 :w 16 :h 16}
           (panels/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            8)))))

(deftest sprite-source-snap-settings_default_to_tile_size_and_enabled
  (is (= true (panels/source-position-snap-enabled? {})))
  (is (= 32
         (panels/source-position-snap-interval {:tile-size 32})))
  (is (= 8
         (panels/source-position-snap-interval
          {:tile-size 32
           :source-snap-interval 8
           :source-snap-interval-custom? true}))))

(deftest sprite-map-preview-source-navigation-clamps_to_asset_bounds
  (is (= {:x 784 :y 1264 :w 16 :h 16}
         (panels/move-source-position {:x 784 :y 1264 :w 16 :h 16}
                                      16
                                      16
                                      16
                                      {:w 800 :h 1280}
                                      true
                                      16)))
  (is (= {:x 0 :y 0 :w 16 :h 16}
         (panels/move-source-position {:x 0 :y 0 :w 16 :h 16}
                                      -16
                                      -16
                                      16
                                      {:w 800 :h 1280}
                                      true
                                      16))))
