(ns tilemap-editor.view.tileset.dialogs-test
  (:require proof.core
            [tilemap-editor.view.tileset.dialogs :as dialogs]))

(deftest tile-add-menu-disables_resource_import_without_project_resources
  (let [menu (dialogs/tile-add-menu false)
        item (head (:items menu))]
    (is (= "Add from resource" (:label item)))
    (is (= true (:disabled? item))))
  (let [menu (dialogs/tile-add-menu true)
        item (head (:items menu))]
    (is (= false (:disabled? item)))))

(deftest tile-add-menu-enables_multiple_file_import
  (let [menu (dialogs/tile-add-menu false)
        item (nth (:items menu) 2)]
    (is (= "Add multiple tiles from multiple files" (:label item)))
    (is (= nil (:disabled? item)))))

(deftest image-file-dialog-path-prefers_selected_tile_resource_directory
  (is (= "/tmp/assets"
         (dialogs/image-file-dialog-path
          {:resources {:bundles {:project-assets
                                 {:images {:sprites
                                           {:file-name "/tmp/assets/sprites.png"}}}}}
           :tilesets [{:id :terrain
                       :tiles [{:id :grass
                                :type :sprite
                                :image :project-assets/sprites}]}]
           :selected-tileset-definition-index 0
           :selected-tileset-tile-index 0
           :project-directory "/tmp/project"
           :last-image-file-directory "/tmp/last"}))))

(deftest image-file-dialog-path-falls_back_to_project_then_session_directory
  (is (= "/tmp/project"
         (dialogs/image-file-dialog-path
          {:tilesets [{:id :terrain
                       :tiles [{:id :grass
                                :type :color}]}]
           :selected-tileset-definition-index 0
           :selected-tileset-tile-index 0
           :project-directory "/tmp/project"
           :last-image-file-directory "/tmp/last"})))
  (is (= "/tmp/last"
         (dialogs/image-file-dialog-path
          {:tilesets [{:id :terrain
                       :tiles [{:id :grass
                                :type :color}]}]
           :selected-tileset-definition-index 0
           :selected-tileset-tile-index 0
           :last-image-file-directory "/tmp/last"}))))

(deftest import-file-resource-adds_project_bundle_metadata
  (let [state (dialogs/import-file-resource!
               {:resources {:bundles {}}
                :selected-resource-bundle nil}
               {:path "assets/simples_pimples.png"})]
    (is (= nil
           (get-in state [:resources :bundles :project-assets :dynamic?])))
    (is (= {:file-name "assets/simples_pimples.png"
            :name "Simples Pimples"}
           (get-in state
                   [:resources :bundles :project-assets :images :simples-pimples])))
    (is (= :project-assets (:selected-resource-bundle state)))
    (is (= :simples-pimples (:selected-image-resource state)))))

(deftest import-file-resources-adds_each_project_resource
  (let [state (dialogs/import-file-resources!
               {:resources {:bundles {}}
                :selected-resource-bundle nil}
               ["assets/red tile.png"
                "assets/blue tile.png"])]
    (is (= {:file-name "assets/red tile.png"
            :name "Red Tile"}
           (get-in state
                   [:resources :bundles :project-assets :images :red-tile])))
    (is (= {:file-name "assets/blue tile.png"
            :name "Blue Tile"}
           (get-in state
                   [:resources :bundles :project-assets :images :blue-tile])))
    (is (= [:project-assets/red-tile :project-assets/blue-tile]
           (map (:last-imported-image-resources state)
                (fn [resource]
                  (:key resource)))))))

(deftest tile-import-source-position-supports_custom_snap_interval
  (let [image-rect (dialogs/tile-import-preview-image-rect {:w 800
                                                            :h 1280})]
    (is (= {:x 32 :y 104 :w 16 :h 16}
           (dialogs/tile-import-source-at-position
            {:x 99.9375 :y 23.625}
            image-rect
            {:w 800 :h 1280}
            16
            true
            8)))))

(deftest tile-import-source-position-supports_unsnapped_coordinates
  (let [image-rect (dialogs/tile-import-preview-image-rect {:w 800
                                                            :h 1280})]
    (is (= {:x 34 :y 108 :w 16 :h 16}
           (dialogs/tile-import-source-at-position
            {:x 99.9375 :y 23.625}
            image-rect
            {:w 800 :h 1280}
            16
            false
            16)))))
