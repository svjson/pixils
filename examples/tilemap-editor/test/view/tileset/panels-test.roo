(ns tilemap-editor.view.tileset.panels-test
  (:require proof.core
            [pixils.test.runtime :as runtime]
            [tilemap-editor.view.tileset.panels :as panels]
            [tilemap-editor.view.tileset.sprite-source-editor :as sse]))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun variants-tab-probe-source []
  "(ns tilemap-editor.test.variants-tab-probe
     (:require pixils
               [pixils.ui :as ui]
               [tilemap-editor.view.tileset.model :as model]
               tilemap-editor.view.tileset.panels))

   (pixils/defmode root-mode
     {:style {:width 400
              :height 300}
      :init (fn [state ctx]
              (assoc state
                     :tile {:id :grass
                            :name \"Grass\"
                            :type :color
                            :color {:r 0
                                    :g 128
                                    :b 0}
                            :substitution {:seed 4
                                           :algorithm :weighted-random
                                           :choices [{:tile :grass
                                                      :weight 1}]}}
                     :tilesets [{:id :terrain
                                 :label \"Terrain\"
                                 :tile-size 16
                                 :tiles [{:id :grass
                                          :name \"Grass\"
                                          :type :color
                                          :color {:r 0
                                                  :g 128
                                                  :b 0}
                                          :substitution {:seed 4
                                                         :algorithm :weighted-random
                                                         :choices [{:tile :grass
                                                                    :weight 1}]}}
                                         {:id :water
                                          :name \"Water\"
                                          :type :color
                                          :color {:r 0
                                                  :g 0
                                                  :b 255}}]}]
                     :selected-tileset-definition-index 0
                     :selected-tileset-tile-index 0
                     :tile-definition-panel-disabled? false))
      :on {:tile-substitution/choices-change
           (fn [state event ctx]
             (let [next (model/set-selected-tile-substitution-choice-tiles
                         state
                         (:payload event))]
               (assoc next
                      :tile
                      (get-in next [:tilesets 0 :tiles 0]))))}
      :children [{:mode 'tile-definition-variants-tab
                  :state {:tile (ui/bind-state :tile)
                          :tilesets (ui/bind-state :tilesets)
                          :selected-tileset-definition-index
                          (ui/bind-state :selected-tileset-definition-index)
                          :tile-definition-panel-disabled?
                          (ui/bind-state
                           :tile-definition-panel-disabled?)}}]})")

(deftest tileset-definition-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (panels/tileset-list-box-child [])))))
  (is (= true (:disabled? (:state (panels/tileset-list-box-child nil)))))
  (is (not= true
            (:disabled? (:state (panels/tileset-list-box-child
                                 [{:id :terrain
                                   :label "Terrain"}]))))))

(deftest tileset-context-menu-includes_edit_properties_and_duplicate_commands
  (let [edit-item (head (:items panels/tileset-context-menu))
        properties-item (nth (:items panels/tileset-context-menu) 1)
        duplicate-item (nth (:items panels/tileset-context-menu) 2)]
    (is (= "Edit" (:label edit-item)))
    (is (= :edit (-> edit-item :payload :command)))
    (is (= "Properties" (:label properties-item)))
    (is (= :properties (-> properties-item :payload :command)))
    (is (= "Duplicate" (:label duplicate-item)))
    (is (= :duplicate (-> duplicate-item :payload :command)))))

(deftest tile-context-menu-includes-rename-command
  (let [rename-item (head (:items panels/tile-context-menu))
        delete-item (nth (:items panels/tile-context-menu) 1)]
    (is (= "Rename" (:label rename-item)))
    (is (= :rename (-> rename-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest tile-cell-rect-uses_tileset_tile_size
  (is (= {:x 32 :y 32 :w 32 :h 32}
         (panels/tile-cell-rect 3 2 32))))

(deftest tile-grid-content-height-fits_all_tile_rows
  (is (= 0 (panels/tile-grid-content-height 0 4 32)))
  (is (= 32 (panels/tile-grid-content-height 4 4 32)))
  (is (= 64 (panels/tile-grid-content-height 5 4 32))))

(deftest tile-grid-drag-payload-identifies_source_tile
  (is (= {:kind :tileset/tile
	          :source-tileset-index 0
	          :tile-index 1
	          :tile {:id :water}
	          :tile-size {:w 32 :h 32}
	          :width 32
          :height 32
          :offset {:x 33 :y 2}}
         (panels/tile-grid-drag-payload
          {:selected-tileset-definition-index 0
           :tilesets [{:tile-size 32
                       :tiles [{:id :grass}
                               {:id :water}]}]}
          {:start-position {:x 33 :y 2}}
          {:view {:bounds {:w 96
                           :h 64}}}))))

(deftest tileset-row-accepts_tile_drop_payloads
  (is (= {:source-tileset-index 0
          :target-tileset-index 1
          :tile-index 2}
         (panels/tile-drop-payload
          1
          {:kind :tileset/tile
           :source-tileset-index 0
           :tile-index 2})))
  (is (= nil
         (panels/tile-drop-payload
          0
          {:kind :tileset/tile
           :source-tileset-index 0
           :tile-index 2}))))

(deftest sprite-map-preview-source-rect-scales-from-full-asset
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})
        source-rect (sse/sprite-source-preview-source-rect
                     {:x 0 :y 96 :w 16 :h 16}
                     image-rect)]
    (is (= 20 (:x image-rect)))
    (is (= 0 (:y image-rect)))
    (is (= 0.25 (:scale image-rect)))
    (is (= {:x 20 :y 24 :w 4 :h 4}
           source-rect))))

(deftest sprite-map-preview-position-selects_tile_coordinates
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 96 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            16)))))

(deftest sprite-map-preview-position-can_select_unsnapped_coordinates
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 34 :y 108 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            false
            16)))))

(deftest sprite-map-preview-position_uses_custom_snap_interval
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 104 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            8)))))

(deftest sprite-source-snap-settings_default_to_tile_size_and_enabled
  (is (= true (sse/source-position-snap-enabled? {})))
  (is (= 32
         (sse/source-position-snap-interval {:tile-size 32})))
  (is (= 8
         (sse/source-position-snap-interval
          {:tile-size 32
           :source-snap-interval 8
           :source-snap-interval-custom? true}))))

(deftest tile-sprite-editor-binds_zoom_and_offset_to_preview
  (let [child (head (panels/tile-sprite-editor-children))]
    (is (= 'sprite-source-editor (:mode child)))
    (is (not (nil? (-> child :state :resources))))
    (is (not (nil? (-> child :state :tile))))))

(deftest sprite-source-editor-binds_zoom_and_offset_to_preview
  (let [children (sse/sprite-source-editor-children)
        snap-row (nth children 4)
        zoom-control (nth children 5)
        preview (nth children 6)]
    (is (= :source-snap-to-grid?
           (-> snap-row :children head :state :value)))
    (is (= 'image-panel-zoom-control (:mode zoom-control)))
    (is (= 'sprite-source-preview (:mode preview)))
    (is (not (nil? (-> preview :state :sprite-source-preview-zoom))))
    (is (not (nil? (-> preview :state :sprite-source-preview-offset))))
    (is (not (nil? (-> zoom-control :state :zoom))))))

(deftest tile-definition-detail-tabs-separate_tile_and_property_editors
  (let [tabs (panels/tile-definition-detail-tabs-child)
        tab-defs (-> tabs :state :tabs)
        tile-tab (-> tab-defs head :child)
        properties-tab (-> tab-defs (nth 1) :child)
        variants-tab (-> tab-defs (nth 2) :child)]
    (is (= 'ui/tab-panel (:mode tabs)))
    (is (= :tile (-> tab-defs head :id)))
    (is (= "Tile" (-> tab-defs head :label)))
    (is (= 'tile-definition-tile-tab (:mode tile-tab)))
    (is (= :properties (-> tab-defs (nth 1) :id)))
    (is (= "Properties" (-> tab-defs (nth 1) :label)))
    (is (= 'tile-definition-properties-tab (:mode properties-tab)))
    (is (= :variants (-> tab-defs (nth 2) :id)))
    (is (= "Variants" (-> tab-defs (nth 2) :label)))
    (is (= 'tile-definition-variants-tab (:mode variants-tab)))))

(deftest tile-definition-tile-tab-contains_type_sprite_and_color_editors
  (let [children (panels/tile-definition-tile-tab-children)]
    (is (= 'tile-definition-row (-> children head :mode)))
    (is (= 'tile-sprite-editor (-> children (nth 1) :mode)))
    (is (= 'tile-color-editor (-> children (nth 2) :mode)))))

(deftest tile-definition-properties-tab-contains_only_per_tile_property_editor
  (let [children (panels/tile-definition-properties-tab-children)]
    (is (= 1 (count children)))
    (is (= 'property-value-list (-> children head :mode)))
    (is (= "Tile Properties"
           (-> children head :state :title)))
    (is (= :tile
           (-> children head :state :kind)))))

(deftest tile-definition-variants-tab-contains-seed-grid-and-choice-editor
  (let [children (panels/tile-definition-variants-tab-children)]
    (is (= 'tile-substitution-seed-field (-> children head :mode)))
    (is (= 'tile-substitution-choice-grid-scroll-pane
           (-> children (nth 2) :mode)))
    (is (= 'tile-substitution-choices-editor
           (-> children (nth 4) :mode)))))

(deftest tile-substitution-choice-selection-uses-choice-tiles
  (let [state {:tile {:substitution {:choices [{:tile :water
                                                :weight 2}
                                               {:tile :lava
                                                :weight 1}]}}
               :selected-tileset-definition-index 0
               :tilesets [{:id :terrain
                           :tiles [{:id :grass}
                                   {:id :water}
                                   {:id :lava}]}]}]
    (is (= [1 2] (panels/tile-substitution-choice-indices state)))
    (is (= [:grass :lava]
           (panels/tile-ids-for-selection-indices state [0 2])))))

(deftest tile-substitution-choice-selection-toggles-in-tileset-order
  (is (= [0 2] (panels/toggle-selection-index [0 1 2] 1 4)))
  (is (= [0 1 2] (panels/toggle-selection-index [2 0] 1 4))))

(deftest tile-substitution-choice-row-label-uses-tile-id-and-tile
  (let [state {:tile {:substitution {:choices [{:tile :water
                                                :weight 2}]}}
               :selected-tileset-definition-index 0
               :tilesets [{:id :terrain
                           :tiles [{:id :grass}
                                   {:id :water
                                    :type :color
                                    :color {:r 0 :g 0 :b 255}}]}]}
        choice {:tile :water
                :weight 2}]
    (is (= ":water"
           (panels/tile-substitution-choice-label-value state choice)))
    (is (= {:id :water
            :type :color
            :color {:r 0 :g 0 :b 255}}
           (panels/tile-substitution-choice-tile-value state choice)))))

(deftest tile-substitution-choices-content-renders-header-and-choice-rows
  (let [content (panels/tile-substitution-choices-content-child
                 [{:tile :grass :weight 1}
                  {:tile :water :weight 2}])
        children (:children content)]
    (is (= "tile-substitution-choices-content" (:id content)))
    (is (= 3 (count children)))
    (is (= "Tile" (-> children head :children head :state :value)))
    (is (= 'tile-substitution-choice-row (-> children (nth 1) :mode)))
    (is (= 0 (-> children (nth 1) :state :choice-index)))
    (is (= 'tile-substitution-choice-row (-> children (nth 2) :mode)))
    (is (= 1 (-> children (nth 2) :state :choice-index)))))

(deftest tile-definition-variants-tab-renders-choice-editor
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 400
                               :buffer-height 300
                               :render-backend false})]
    (runtime/eval! app (variants-tab-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (is (not (nil? (runtime/find-view app
                                       "tile-substitution-choice-grid"))))
    (is (not (nil? (runtime/find-view app
                                       "tile-substitution-choices-editor"))))
    (is (not (nil? (runtime/find-view app
                                       "tile-substitution-choice-row"))))))

(deftest tile-substitution-choice-grid-click-adds-weight-row
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 400
                               :buffer-height 300
                               :render-backend false})]
    (runtime/eval! app (variants-tab-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [grid (runtime/find-view app "tile-substitution-choice-grid")]
      (runtime/mouse-click-in! app grid 20 8)
      (settle-layout! app)
      (is (= [{:tile :grass
               :weight 1}
              {:tile :water
               :weight 1}]
             (-> (runtime/active-state app) :tile :substitution :choices)))
      (is (= 2
             (count (runtime/find-views app
                                        "tile-substitution-choice-row")))))))

(deftest tile-definition-panel-scroll-content-wraps_detail_panel
  (let [content (panels/tile-definition-panel-content-child)
        style (panels/tile-definition-panel-scroll-content-style
               {:offset 48})]
    (is (= 'tile-definition-panel (:mode content)))
    (is (not (nil? (-> content :state :resources))))
    (is (= :fill (:width style)))
    (is (= -48 (:top style)))
    (is (= panels/tile-definition-panel-content-height (:height style)))))

(deftest sprite-map-preview-source-navigation-clamps_to_asset_bounds
  (is (= {:x 784 :y 1264 :w 16 :h 16}
         (sse/move-source-position {:x 784 :y 1264 :w 16 :h 16}
                                   16
                                   16
                                   16
                                   {:w 800 :h 1280}
                                   true
                                   16)))
  (is (= {:x 0 :y 0 :w 16 :h 16}
         (sse/move-source-position {:x 0 :y 0 :w 16 :h 16}
                                   -16
                                   -16
                                   16
                                   {:w 800 :h 1280}
                                   true
                                   16))))
