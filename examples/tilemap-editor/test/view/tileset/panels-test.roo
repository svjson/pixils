(ns tilemap-editor.view.tileset.panels-test
  (:require proof.core
            [tilemap-editor.view.tileset.panels :as panels]
            [tilemap-editor.view.tileset.sprite-source-editor :as sse]))

(deftest tileset-definition-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (panels/tileset-list-box-child [])))))
  (is (= true (:disabled? (:state (panels/tileset-list-box-child nil)))))
  (is (not= true
            (:disabled? (:state (panels/tileset-list-box-child
                                 [{:id :terrain
                                   :label "Terrain"}]))))))

(deftest tileset-context-menu-includes_edit_and_duplicate_commands
  (let [edit-item (head (:items panels/tileset-context-menu))
        duplicate-item (nth (:items panels/tileset-context-menu) 1)]
    (is (= "Edit" (:label edit-item)))
    (is (= :edit (-> edit-item :payload :command)))
    (is (= "Duplicate" (:label duplicate-item)))
    (is (= :duplicate (-> duplicate-item :payload :command)))))

(deftest tile-context-menu-includes-rename-command
  (let [rename-item (head (:items panels/tile-context-menu))
        delete-item (nth (:items panels/tile-context-menu) 1)]
    (is (= "Rename" (:label rename-item)))
    (is (= :rename (-> rename-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest tile-cell-rect-uses_tileset_tile_size
  (is (= {:x 32 :y 32 :w 32 :h 32}
         (panels/tile-cell-rect 3 2 32))))

(deftest tile-grid-content-height-fits_all_tile_rows
  (is (= 0 (panels/tile-grid-content-height 0 4 32)))
  (is (= 32 (panels/tile-grid-content-height 4 4 32)))
  (is (= 64 (panels/tile-grid-content-height 5 4 32))))

(deftest tile-grid-drag-payload-identifies_source_tile
  (is (= {:kind :tileset/tile
          :source-tileset-index 0
          :tile-index 1
          :tile {:id :water}
          :tile-size 32
          :width 32
          :height 32
          :offset {:x 33 :y 2}}
         (panels/tile-grid-drag-payload
          {:selected-tileset-definition-index 0
           :tilesets [{:tile-size 32
                       :tiles [{:id :grass}
                               {:id :water}]}]}
          {:start-position {:x 33 :y 2}}
          {:view {:bounds {:w 96
                           :h 64}}}))))

(deftest tileset-row-accepts_tile_drop_payloads
  (is (= {:source-tileset-index 0
          :target-tileset-index 1
          :tile-index 2}
         (panels/tile-drop-payload
          1
          {:kind :tileset/tile
           :source-tileset-index 0
           :tile-index 2})))
  (is (= nil
         (panels/tile-drop-payload
          0
          {:kind :tileset/tile
           :source-tileset-index 0
           :tile-index 2}))))

(deftest sprite-map-preview-source-rect-scales-from-full-asset
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})
        source-rect (sse/sprite-source-preview-source-rect
                     {:x 0 :y 96 :w 16 :h 16}
                     image-rect)]
    (is (= 20 (:x image-rect)))
    (is (= 0 (:y image-rect)))
    (is (= 0.25 (:scale image-rect)))
    (is (= {:x 20 :y 24 :w 4 :h 4}
           source-rect))))

(deftest sprite-map-preview-position-selects_tile_coordinates
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 96 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            16)))))

(deftest sprite-map-preview-position-can_select_unsnapped_coordinates
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 34 :y 108 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            false
            16)))))

(deftest sprite-map-preview-position_uses_custom_snap_interval
  (let [image-rect (sse/sprite-source-preview-image-rect {:w 800
                                                          :h 1280})]
    (is (= {:x 32 :y 104 :w 16 :h 16}
           (sse/source-position-from-preview-position
            {:x 28.5 :y 27}
            image-rect
            {:w 800 :h 1280}
            16
            true
            8)))))

(deftest sprite-source-snap-settings_default_to_tile_size_and_enabled
  (is (= true (sse/source-position-snap-enabled? {})))
  (is (= 32
         (sse/source-position-snap-interval {:tile-size 32})))
  (is (= 8
         (sse/source-position-snap-interval
          {:tile-size 32
           :source-snap-interval 8
           :source-snap-interval-custom? true}))))

(deftest tile-sprite-editor-binds_zoom_and_offset_to_preview
  (let [child (head (panels/tile-sprite-editor-children))]
    (is (= 'sprite-source-editor (:mode child)))
    (is (not (nil? (-> child :state :resources))))
    (is (not (nil? (-> child :state :tile))))))

(deftest sprite-source-editor-binds_zoom_and_offset_to_preview
  (let [children (sse/sprite-source-editor-children)
        snap-row (nth children 4)
        zoom-control (nth children 5)
        preview (nth children 6)]
    (is (= :source-snap-to-grid?
           (-> snap-row :children head :state :value)))
    (is (= 'image-panel-zoom-control (:mode zoom-control)))
    (is (= 'sprite-source-preview (:mode preview)))
    (is (not (nil? (-> preview :state :sprite-source-preview-zoom))))
    (is (not (nil? (-> preview :state :sprite-source-preview-offset))))
    (is (not (nil? (-> zoom-control :state :zoom))))))

(deftest tile-definition-panel-scroll-content-wraps_detail_panel
  (let [content (panels/tile-definition-panel-content-child)
        style (panels/tile-definition-panel-scroll-content-style
               {:offset 48})]
    (is (= 'tile-definition-panel (:mode content)))
    (is (not (nil? (-> content :state :resources))))
    (is (= :fill (:width style)))
    (is (= -48 (:top style)))
    (is (= panels/tile-definition-panel-content-height (:height style)))))

(deftest sprite-map-preview-source-navigation-clamps_to_asset_bounds
  (is (= {:x 784 :y 1264 :w 16 :h 16}
         (sse/move-source-position {:x 784 :y 1264 :w 16 :h 16}
                                   16
                                   16
                                   16
                                   {:w 800 :h 1280}
                                   true
                                   16)))
  (is (= {:x 0 :y 0 :w 16 :h 16}
         (sse/move-source-position {:x 0 :y 0 :w 16 :h 16}
                                   -16
                                   -16
                                   16
                                   {:w 800 :h 1280}
                                   true
                                   16))))
