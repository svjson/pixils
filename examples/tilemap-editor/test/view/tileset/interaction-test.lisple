(ns tilemap-editor.view.tileset.interaction-test
  (:require proof.core
            [tilemap-editor.fixture.main-window :as main-window]
            [tilemap-editor.fixture.io.project :as project]
            [tilemap-editor.fixture.view.tileset.tilesets-tab :as tilesets-tab]))

(deftest tileset-row-context-menu-opens-edit-dialog
  (given
    (project/write! :tileset-context
                    {:tilesets [{:id :loaded
                                 :label "Loaded"
                                 :tile-size 16
                                 :tiles [{:id :grass
                                          :name "Grass"
                                          :char "g"
                                          :type :color
                                          :color {:r 0 :g 128 :b 0}}]}]
                     :tilemap {:width 2
                               :height 2
                               :tile-size 16
                               :layers []}})
    (let [app (main-window/open-project! :tileset-context)]
      (main-window/is-open? app)
      (project/contains-tileset? app :loaded)
      app))

  (when [app]
    (main-window/switch-to! app :tab/tiles {:by :mouse/click})
    (tilesets-tab/open-context-menu! app :tileset/loaded {:by :mouse/right-click})
    (main-window/choose-menu-item! app :menu-item/edit {:by :mouse/click})
    app)

  (then [app]
    (tilesets-tab/edit-dialog-is-open? app)
    (tilesets-tab/edit-dialog-matches? app
                                       {:tileset/id "loaded"
                                        :tileset/label "Loaded"
                                        :tileset/tile-size 16})
    (project/cleanup! :tileset-context)))

(deftest tileset-tile-grid-drag-selects-and-delete-prompts
  (given
    (project/write! :tile-delete
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass
                                          :name "Grass"
                                          :char "g"
                                          :type :color
                                          :color {:r 0 :g 128 :b 0}}
                                         {:id :water
                                          :name "Water"
                                          :char "w"
                                          :type :color
                                          :color {:r 0 :g 0 :b 255}}
                                         {:id :lava
                                          :name "Lava"
                                          :char "l"
                                          :type :color
                                          :color {:r 255 :g 64 :b 0}}]}]
                     :tilemap {:width 2
                               :height 2
                               :tile-size 16
                               :layers []}})
    (let [app (main-window/open-project! :tile-delete)]
      (main-window/is-open? app)
      (project/contains-tileset? app :terrain)
      app))

  (when [app]
    (main-window/switch-to! app :tab/tiles {:by :mouse/click})
    (tilesets-tab/select-tile-range! app 0 1 {:by :mouse/drag})
    (tilesets-tab/selected-tile-indices-are? app [0 1])
    (tilesets-tab/request-delete-selection! app {:by :keyboard/delete})
    (tilesets-tab/delete-dialog-is-open? app [0 1])
    (main-window/cancel-dialog! app)
    (tilesets-tab/open-tile-context-menu! app {:tile-index 1} {:by :mouse/right-click})
    (main-window/choose-menu-item! app :menu-item/delete {:by :mouse/click})
    app)

  (then [app]
    (tilesets-tab/delete-dialog-is-open? app [0 1])
    (project/cleanup! :tile-delete)))
