(ns tilemap-editor.view.tileset.model-test
  (:require proof.core
            [tilemap-editor.view.tileset.model :as model]))

(deftest tileset-workspace-disables_dependent_panels_without_selection
  (let [empty-state (model/derive-tileset-workspace-state
                     {:selected-tileset-definition-index nil
                      :selected-tileset-tile-index nil})
        tileset-state (model/derive-tileset-workspace-state
                       {:selected-tileset-definition-index 0
                        :selected-tileset-tile-index nil})
        tile-state (model/derive-tileset-workspace-state
                    {:selected-tileset-definition-index 0
                     :selected-tileset-tile-index 0})]
    (is (= true (:tile-set-panel-disabled? empty-state)))
    (is (= true (:tile-definition-panel-disabled? empty-state)))
    (is (= false (:tile-set-panel-disabled? tileset-state)))
    (is (= true (:tile-definition-panel-disabled? tileset-state)))
    (is (= false (:tile-set-panel-disabled? tile-state)))
    (is (= false (:tile-definition-panel-disabled? tile-state)))))

(deftest tileset-workspace-knows_when_project_image_resources_exist
  (is (= false
         (:has-project-image-resources?
          (model/derive-tileset-workspace-state
           {:resources {:bundles {:editor-assets
                                  {:dynamic? false
                                   :images {:spritesheet
                                            {:file-name "sprites.png"}}}}}}))))
  (is (= true
         (:has-project-image-resources?
          (model/derive-tileset-workspace-state
           {:resources {:bundles {:project-assets
                                  {:images {:tiles
                                            {:file-name "tiles.png"}}}}}})))))

(deftest tileset-creation-adds_and_selects_new_tileset
  (let [state (model/add-tileset-definition!
               {:tilesets []
                :selected-tileset-definition-index nil
                :selected-tileset-tile-index nil}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 32})]
	    (is (= [{:id :terrain
	             :label "Terrain"
	             :tile-size {:w 32 :h 32}
	             :tiles []}]
	           (:tilesets state)))
    (is (= 0 (:selected-tileset-definition-index state)))
    (is (= nil (:selected-tileset-tile-index state)))))

(deftest tileset-creation-deduplicates_ids
  (let [state (model/add-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain Copy"
                :tile-size 16})]
    (is (= :terrain-2 (get-in state [:tilesets 1 :id])))))

(deftest tileset-duplicate-inserts_copy_after_source
  (let [state (model/duplicate-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass
                                     :type :sprite
                                     :source {:x 8 :y 16 :w 16 :h 16}}]}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]
                :selected-tileset-definition-index 0}
               {:type :confirm
                :source-tileset-index 0
                :tileset-id "terrain copy"
                :tileset-label "Terrain Copy"
                :tile-size 32})]
	    (is (= [:terrain :terrain-copy :decor]
	           (map (:tilesets state) :id)))
	    (is (= "Terrain Copy" (get-in state [:tilesets 1 :label])))
	    (is (= {:w 32 :h 32} (get-in state [:tilesets 1 :tile-size])))
    (is (= {:x 8 :y 16 :w 32 :h 32}
           (get-in state [:tilesets 1 :tiles 0 :source])))
    (is (= 1 (:selected-tileset-definition-index state)))
    (is (= 0 (:selected-tileset-tile-index state)))))

(deftest tileset-duplicate-deduplicates_id_and_default_label
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tile-size 16
                   :tiles []}
                  {:id :terrain-copy
                   :label "Terrain Copy"
                   :tile-size 16
                   :tiles []}]
        label (model/duplicate-tileset-label tilesets (head tilesets))
        state (model/duplicate-tileset-definition!
               {:tilesets tilesets}
               {:type :confirm
                :source-tileset-index 0
                :tileset-id "terrain copy"
                :tileset-label label
                :tile-size 16})]
    (is (= "Terrain Copy 2" label))
    (is (= :terrain-copy-2 (get-in state [:tilesets 1 :id])))))

(deftest tileset-edit-updates-definition-and-references
  (let [state (model/edit-tileset-definition!
               {:tileset :terrain
                :selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :layers [{:id :ground
                          :tileset :terrain}
                         {:id :details
                          :tileset :decor}]
                :brushes [{:id :stamp-brush
                           :kind :pattern
                           :pattern {:layers [{:id :stamp
                                                :tileset :terrain
                                                :tiles [[:grass]]}]}}]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass
                                     :type :sprite
                                     :source {:x 8 :y 16 :w 16 :h 16}}
                                    {:id :water
                                     :type :color
                                     :color {:r 0 :g 0 :b 255}}]}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "world terrain"
                :tileset-label "World Terrain"
                :tile-size 32})]
	    (is (= {:id :world-terrain
	            :label "World Terrain"
	            :tile-size {:w 32 :h 32}
	            :tiles [{:id :grass
                     :type :sprite
                     :source {:x 8 :y 16 :w 32 :h 32}}
                    {:id :water
                     :type :color
                     :color {:r 0 :g 0 :b 255}}]}
           (get-in state [:tilesets 0])))
    (is (= :world-terrain (:tileset state)))
    (is (= :world-terrain (get-in state [:layers 0 :tileset])))
    (is (= :decor (get-in state [:layers 1 :tileset])))
    (is (= :world-terrain
           (get-in state [:brushes 0 :pattern :layers 0 :tileset])))
    (is (= 0 (:selected-tileset-definition-index state)))
    (is (= 1 (:selected-tileset-tile-index state)))))

(deftest tileset-edit-adds-source-dimensions-to-existing-sprite-tiles
  (let [state (model/edit-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass
                                     :type :sprite}]}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 32})]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in state [:tilesets 0 :tiles 0 :source])))))

(deftest tileset-edit-deduplicates-id-excluding-current-tileset
  (let [state (model/edit-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles []}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "decor"
                :tileset-label "Decor Copy"
                :tile-size 16})]
    (is (= :decor-2 (get-in state [:tilesets 0 :id])))))

(deftest tileset-properties-apply_assignments_and_default_values
  (let [state (model/apply-tileset-properties!
               {:selected-tileset-definition-index 0
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :property-sets [:old]
                            :properties {:stale true}
                            :tiles []}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :property-sets [:movement]
                :properties {:walkable :yes
                                  :cost 3}})]
    (is (= [:movement]
           (get-in state [:tilesets 0 :property-sets])))
    (is (= {:walkable :yes
            :cost 3}
           (get-in state [:tilesets 0 :properties])))
    (is (= 0 (:selected-tileset-definition-index state)))))

(deftest tileset-properties-apply_removes_empty_default_values
  (let [state (model/apply-tileset-properties!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :property-sets [:movement]
                            :properties {:walkable :yes}
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :property-sets []
                :properties {}})]
    (is (= [] (get-in state [:tilesets 0 :property-sets])))
    (is (= nil (get-in state [:tilesets 0 :properties])))))

(deftest tile-creation-adds_and_selects_new_tile
  (let [state (model/add-tile-definition!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index nil
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 32
                            :tiles []}]}
               {:type :confirm
                :tile-id "grass"
                :tile-name "Grass"
                :tile-char "g"
                :tile-type :color})]
    (is (= {:id :grass
            :name "Grass"
            :char "g"
            :type :color
            :color {:r 0 :g 0 :b 0}}
           (get-in state [:tilesets 0 :tiles 0])))
    (is (= 0 (:selected-tileset-tile-index state)))))

(deftest tile-grid-selection-range-selects-rectangular_tiles
  (is (= [1 2 5 6]
         (model/tile-grid-selection-range 1 6 4 10))))

(deftest tileset-tile-delete-removes-selected-tiles-and-layer_refs
  (let [state (model/delete-tileset-tiles!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :selected-tileset-tile-indices [1 2]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass}
                                    {:id :water}
                                    {:id :lava}
                                    {:id :stone}]}
                           {:id :actors
                            :label "Actors"
                            :tile-size 16
                            :tiles [{:id :hero}]}]
                :layers [{:id :level
                          :tileset :terrain
                          :tiles [[:grass :water :lava :stone]
                                  [0 1 2 3]]}
                         {:id :actor
                          :tileset :actors
                          :tiles [[:hero :water]]}]
                :brushes [{:id :stamp-brush
                           :kind :pattern
                           :pattern {:layers [{:id :stamp
                                                :tileset :terrain
                                                :tiles [[:grass :water :lava :stone]
                                                        [0 1 2 3]]}
                                               {:id :actor-stamp
                                                :tileset :actors
                                                :tiles [[:hero :water]]}]}}]
                :terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass}
                                           {:id :water
                                            :tile :water}
                                           {:id :lava
                                            :tile :lava}]}]
                :rulesets [{:id :shore
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[:water
                                                                 :lava
                                                                 :stone]]}]}}]}]}
               {:choice :dialog/ok
                :payload {:operation :delete-tiles
                          :tile-indices [1 2]}})]
    (is (= [{:id :grass}
            {:id :stone}]
           (get-in state [:tilesets 0 :tiles])))
    (is (= [[:grass nil nil :stone]
            [0 nil nil 1]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[:hero :water]]
           (get-in state [:layers 1 :tiles])))
    (is (= [[:grass nil nil :stone]
            [0 nil nil 1]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= [[:hero :water]]
           (get-in state [:brushes 0 :pattern :layers 1 :tiles])))
    (is (nil? (get-in state [:terrain-sets 0 :terrains 1 :tile])))
    (is (nil? (get-in state [:terrain-sets 0 :terrains 2 :tile])))
    (is (= [[nil nil :stone]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= 1 (:selected-tileset-tile-index state)))
    (is (= [1] (:selected-tileset-tile-indices state)))))

(deftest tileset-tile-move-transfers_tile_and_cleans_source_refs
  (let [state (model/move-tileset-tile!
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 2
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :tileset :terrain
                                            :tiles [[:water 1]]}]}]
                :selected-layer-index 0
                :selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :selected-tileset-tile-indices [1]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass}
                                    {:id :water
                                     :name "Water"}
                                    {:id :stone}]}
                           {:id :dungeon
                            :label "Dungeon"
                            :tile-size 16
                            :tiles [{:id :water}]}]
                :layers [{:id :scene/terrain
                          :tileset :terrain
                          :tiles [[:water 1 :stone]]}]
                :maps [{:id :map/one
                        :label "One"
                        :width 3
                        :height 1
                        :layers [{:id :scene/terrain
                                  :tileset :terrain
                                  :tiles [[:water 1 :stone]]}]}]
                :brushes [{:id :stamp-brush
                           :kind :pattern
                           :pattern {:layers [{:id :stamp
                                                :tileset :terrain
                                                :tiles [[:water 1
                                                         :stone]]}]}}]
                :terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :water
                                            :tile :water}]}]
                :rulesets [{:id :shore
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[:water
                                                                 :stone]]}]}}]}]}
               {:source-tileset-index 0
                :target-tileset-index 1
                :tile-index 1})]
    (is (= [{:id :grass}
            {:id :stone}]
           (get-in state [:tilesets 0 :tiles])))
    (is (= [{:id :water}
            {:id :water-2
             :name "Water"}]
           (get-in state [:tilesets 1 :tiles])))
    (is (= [[nil nil :stone]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[nil nil :stone]]
           (get-in state [:maps 0 :layers 0 :tiles])))
    (is (= [[nil nil :stone]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))
    (is (nil? (get-in state [:terrain-sets 0 :terrains 0 :tile])))
    (is (= [[nil :stone]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= 1 (:selected-tileset-definition-index state)))
    (is (= 1 (:selected-tileset-tile-index state)))
    (is (= [1] (:selected-tileset-tile-indices state)))))

(deftest tile-rename-updates-definition-and-keyword-refs
  (let [state (model/rename-tile-definition!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :selected-tileset-tile-indices [1]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass}
                                    {:id :water
                                     :name "Water"
                                     :char "w"
                                     :type :color
                                     :color {:r 0 :g 0 :b 255}}]}
                           {:id :actors
                            :label "Actors"
                            :tile-size 16
                            :tiles [{:id :hero}]}]
                :layers [{:id :level
                          :tileset :terrain
                          :tiles [[:grass :water]
                                  [0 1]]}
                         {:id :actor
                          :tileset :actors
                          :tiles [[:water]]}]
                :brushes [{:id :stamp-brush
                           :kind :pattern
                           :pattern {:layers [{:id :stamp
                                                :tileset :terrain
                                                :tiles [[:water 1]]}
                                               {:id :actor-stamp
                                                :tileset :actors
                                                :tiles [[:water]]}]}}]
                :terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :water
                                            :tile :water}
                                           {:id :water-preview
                                            :preview-tile :water}
                                           {:id :water-legacy
                                            :preview :water}]
                                :property-sets []}
                               {:id :actors
                                :tileset :actors
                                :terrains [{:id :water
                                            :tile :water}]}]
                :rulesets [{:id :shore
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[:water]]}
                                                       {:tileset :actors
                                                        :tiles [[:water]]}]}}]}]}
               {:type :confirm
                :tile-index 1
                :tile-id "deep water"
                :tile-name "Deep Water"
                :tile-char "~"})]
    (is (= {:id :deep-water
            :name "Deep Water"
            :char "~"
            :type :color
            :color {:r 0 :g 0 :b 255}}
           (get-in state [:tilesets 0 :tiles 1])))
    (is (= [[:grass :deep-water]
            [0 1]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[:water]]
           (get-in state [:layers 1 :tiles])))
    (is (= [[:deep-water 1]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= [[:water]]
           (get-in state [:brushes 0 :pattern :layers 1 :tiles])))
    (is (= :deep-water (get-in state [:terrain-sets 0 :terrains 0 :tile])))
    (is (= :deep-water (get-in state [:terrain-sets 0 :terrains 1 :preview-tile])))
    (is (= :deep-water (get-in state [:terrain-sets 0 :terrains 2 :preview])))
    (is (= :water (get-in state [:terrain-sets 1 :terrains 0 :tile])))
    (is (= [[:deep-water]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[:water]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 1 :tiles])))
    (is (= 1 (:selected-tileset-tile-index state)))
    (is (= [1] (:selected-tileset-tile-indices state)))))

