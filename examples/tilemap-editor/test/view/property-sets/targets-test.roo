(ns tilemap-editor.view.property-sets.targets-test
  (:require proof.core
            [pixils.test :as px]
            [tilemap-editor.view.property-sets.targets :as targets]))

(defun property-value-list-probe-source []
  "(ns tilemap-editor.test.property-value-list-probe
     (:require pixils
               [pixils.ui :as ui]
               tilemap-editor.view.property-sets.targets))

   (pixils/defmode root-mode
     {:style {:width 320
              :height 120}
      :init (fn [state ctx]
              (assoc state
                     :property-sets [{:id :movement
                                      :label \"Movement\"
                                      :properties [{:id :cost
                                                    :label \"Cost\"
                                                    :type :number
                                                    :default 1}]}]
                     :property-set-ids [:movement]
                     :default-values {}
                     :override-values {:cost 4}
                     :disabled? false))
      :children [{:mode 'property-value-list
                  :state {:title \"Tile Properties\"
                          :kind :tile
                          :property-sets (ui/bind-state :property-sets)
                          :property-set-ids
                          (ui/bind-state :property-set-ids)
                          :default-values
                          (ui/bind-state :default-values)
                          :override-values
                          (ui/bind-state :override-values)
                          :disabled? (ui/bind-state :disabled?)}}]})")



;; tilemap-editor.view.property-sets.targets/property-set-assignment-list-content-child

(deftest property-set-assignment-list-content-child/shows-property-sets
  (let [content (targets/property-set-assignment-list-content-child
                 {:kind :tileset
                  :property-sets [{:id :movement
                                   :label "Movement"}]
                  :assigned-property-set-ids [:movement]})
        title (-> content :children head)
        row (-> content :children (nth 1))]
    (is (= "Property Sets" (-> title :state :value)))
    (is (= 'property-set-assignment-row (:mode row)))
    (is (= :tileset (-> row :state :kind)))
    (is (= true (-> row :state :attached?)))))



;; tilemap-editor.view.property-sets.targets/property-value-control-child

(deftest property-value-control-child/uses-number-input-for-number-properties
  (let [control (targets/property-value-control-child
                 {:id :cost
                  :label "Cost"
                  :type :number
                  :default 1})]
    (is (= 'property-value-number-control (:mode control)))
    (is (= :cost (-> control :state :property-id)))
    (is (some? (-> control :state :kind)))
    (is (some? (-> control :state :value)))
    (is (some? (-> control :state :disabled?)))))



;; tilemap-editor.view.property-sets.targets/property-value-list

(deftest property-value-list/keeps-control-view-when-value-changes
  (let [app (px/make-app {:package-root "."
                               :buffer-width 320
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (property-value-list-probe-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [control (px/find-view app "property-value-number-control")]
      (is (= 4 (:value (px/view-state control))))
      (px/set-active-state!
       app
       (assoc (px/active-state app)
              :override-values {:cost 5}))
      (px/settle-layout! app)
      (is (= control
             (px/find-view app "property-value-number-control")))
      (is (= 5 (:value (px/view-state control)))))))
