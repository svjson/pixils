(ns tilemap-editor.view.property-sets.model-test
  (:require proof.core
            [proof.syntax :as s]
            [tilemap-editor.view.property-sets.model :as model]))

(def movement-property-set
  {:id :movement
   :label "Movement"
   :properties [{:id :walkable
                 :label "Walkable"
                 :type :enum
                 :values [:yes :no]
                 :default :yes}
                {:id :cost
                 :label "Cost"
                 :type :number
                 :default 1}]})



;; tilemap-editor.view.property-sets.model/add-property-set-with-id

(deftest add-property-set-with-id/uses-confirmed-identity
  (s/when []
    (model/add-property-set-with-id {:property-sets []}
                                    "movement"
                                    "Movement"))

  (s/then [state]
    (is (= {:property-sets [{:id :movement
                             :label "Movement"
                             :properties []}]
            :selected-property-set-index 0
            :selected-property-definition-index nil}
           state))))



;; tilemap-editor.view.property-sets.model/set-selected-property-set-identity

(deftest set-selected-property-set-identity/updates-attachment-references
  (s/when []
    (model/set-selected-property-set-identity
     {:property-sets [{:id :movement
                       :label "Movement"
                       :properties []}]
      :selected-property-set-index 0
      :tilesets [{:id :terrain
                  :property-sets [:movement]}]
      :terrain-sets [{:id :overworld
                      :property-sets [:movement]}]}
     "collision"
     "Collision"))

  (s/then [state]
    (is (= {:property-set {:id :collision
                           :label "Collision"
                           :properties []}
            :tileset-refs [:collision]
            :terrain-set-refs [:collision]}
           {:property-set (get-in state [:property-sets 0])
            :tileset-refs (get-in state [:tilesets 0 :property-sets])
            :terrain-set-refs (get-in state
                                      [:terrain-sets 0 :property-sets])}))))



;; tilemap-editor.view.property-sets.model/delete-selected-property-set

(deftest delete-selected-property-set/removes-attachments-and-values
  (s/when []
    (model/delete-selected-property-set
     {:property-sets [movement-property-set]
      :selected-property-set-index 0
      :selected-property-definition-index 1
      :tilesets [{:id :terrain
                  :property-sets [:movement]
                  :properties {:walkable :no}
                  :tiles [{:id :grass
                           :properties {:cost 2}}]}]
      :terrain-sets [{:id :overworld
                      :property-sets [:movement]
                      :properties {:cost 4}
                      :terrains [{:id :grass
                                  :properties {:walkable :no}}]}]}))

  (s/then [state]
    (is (= {:property-sets []
            :selected-property-set-index nil
            :selected-property-definition-index nil
            :tileset {:id :terrain
                      :property-sets []
                      :tiles [{:id :grass}]}
            :terrain-set {:id :overworld
                          :property-sets []
                          :terrains [{:id :grass}]}}
           {:property-sets (:property-sets state)
            :selected-property-set-index
            (:selected-property-set-index state)
            :selected-property-definition-index
            (:selected-property-definition-index state)
            :tileset (get-in state [:tilesets 0])
            :terrain-set (get-in state [:terrain-sets 0])}))))



;; tilemap-editor.view.property-sets.model/add-property-definition-with-id

(deftest add-property-definition-with-id/uses-confirmed-identity
  (s/when []
    (model/add-property-definition-with-id
     {:property-sets [{:id :movement
                       :label "Movement"
                       :properties []}]
      :selected-property-set-index 0}
     "walkable"
     "Walkable"))

  (s/then [state]
    (is (= {:property {:id :walkable
                       :label "Walkable"
                       :type :any
                       :default nil}
            :selected-index 0}
           {:property (get-in state [:property-sets 0 :properties 0])
            :selected-index (:selected-property-definition-index state)}))))



;; tilemap-editor.view.property-sets.model/set-tileset-property-set-attachment

(deftest set-tileset-property-set-attachment/toggles-reference
  (s/when []
    (-> {:tilesets [{:id :terrain
                     :label "Terrain"}]}
        (model/set-tileset-property-set-attachment
         :terrain
         :movement
         true)
        (model/set-tileset-property-set-attachment
         :terrain
         :movement
         false)))

  (s/then [state]
    (is (= [] (get-in state [:tilesets 0 :property-sets])))))



;; tilemap-editor.view.property-sets.model/set-selected-tileset-property-set-attachment

(deftest set-selected-tileset-property-set-attachment/attaches-to-selection
  (s/when []
    (model/set-selected-tileset-property-set-attachment
     {:tilesets [{:id :terrain
                  :label "Terrain"}]
      :selected-tileset-definition-index 0}
     :movement
     true))

  (s/then [state]
    (is (= [:movement] (get-in state [:tilesets 0 :property-sets])))))



;; tilemap-editor.view.property-sets.model/set-selected-terrain-set-property-set-attachment

(deftest set-selected-terrain-set-property-set-attachment/attaches-to-selection
  (s/when []
    (model/set-selected-terrain-set-property-set-attachment
     {:terrain-sets [{:id :overworld
                      :label "Overworld"}]
      :selected-terrain-set-index 0}
     :movement
     true))

  (s/then [state]
    (is (= [:movement]
           (get-in state [:terrain-sets 0 :property-sets])))))



;; tilemap-editor.view.property-sets.model/set-selected-tileset-property-default-value

(deftest set-selected-tileset-property-default-value/stores-only-differences
  (s/when []
    (-> {:property-sets [movement-property-set]
         :tilesets [{:id :terrain
                     :property-sets [:movement]
                     :tiles []}]
         :selected-tileset-definition-index 0}
        (model/set-selected-tileset-property-default-value :walkable :no)
        (model/set-selected-tileset-property-default-value :cost 1)))

  (s/then [state]
    (is (= {:walkable :no}
           (get-in state [:tilesets 0 :properties])))))



;; tilemap-editor.view.property-sets.model/set-selected-terrain-set-property-default-value

(deftest set-selected-terrain-set-property-default-value/stores-only-differences
  (s/when []
    (-> {:property-sets [movement-property-set]
         :terrain-sets [{:id :overworld
                         :property-sets [:movement]
                         :terrains []}]
         :selected-terrain-set-index 0}
        (model/set-selected-terrain-set-property-default-value :cost 4)
        (model/set-selected-terrain-set-property-default-value :walkable :yes)))

  (s/then [state]
    (is (= {:cost 4}
           (get-in state [:terrain-sets 0 :properties])))))



;; tilemap-editor.view.property-sets.model/set-selected-tile-property-value

(deftest set-selected-tile-property-value/stores-only-differences
  (s/when []
    (-> {:property-sets [movement-property-set]
         :tilesets [{:id :terrain
                     :property-sets [:movement]
                     :properties {:walkable :yes
                                  :cost 2}
                     :tiles [{:id :grass
                              :type :color}]}]
         :selected-tileset-definition-index 0
         :selected-tileset-tile-index 0}
        (model/set-selected-tile-property-value :walkable :no)
        (model/set-selected-tile-property-value :cost 4)
        (model/set-selected-tile-property-value :walkable :yes)))

  (s/then [state]
    (is (= {:cost 4}
           (get-in state [:tilesets 0 :tiles 0 :properties])))))

(deftest set-selected-tile-property-value/stores-changed-enum-value
  (s/when []
    (model/set-selected-tile-property-value
     {:property-sets [movement-property-set]
      :tilesets [{:id :terrain
                  :property-sets [:movement]
                  :properties {:walkable :yes}
                  :tiles [{:id :grass
                           :type :color}]}]
      :selected-tileset-definition-index 0
      :selected-tileset-tile-index 0}
     :walkable
     :no))

  (s/then [state]
    (is (= {:walkable :no}
           (get-in state [:tilesets 0 :tiles 0 :properties])))))



;; tilemap-editor.view.property-sets.model/set-selected-terrain-property-value

(deftest set-selected-terrain-property-value/stores-only-differences
  (s/when []
    (-> {:property-sets [movement-property-set]
         :terrain-sets [{:id :overworld
                         :property-sets [:movement]
                         :properties {:walkable :yes
                                      :cost 2}
                         :terrains [{:id :grass}]}]
         :selected-terrain-set-index 0
         :selected-terrain-index 0}
        (model/set-selected-terrain-property-value :walkable :no)
        (model/set-selected-terrain-property-value :cost 2)))

  (s/then [state]
    (is (= {:walkable :no}
           (get-in state [:terrain-sets 0 :terrains 0 :properties])))))
