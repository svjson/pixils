(ns tilemap-editor.view.property-sets.layout-test
  (:require proof.core
            [pixils.test.runtime :as runtime]
            [tilemap-editor.view.property-sets.layout :as layout]
            [tilemap-editor.view.property-sets.targets :as targets]))

(defun property-value-list-probe-source []
  "(ns tilemap-editor.test.property-value-list-probe
     (:require pixils
               [pixils.ui :as ui]
               tilemap-editor.view.property-sets.targets))

   (pixils/defmode root-mode
     {:style {:width 320
              :height 120}
      :init (fn [state ctx]
              (assoc state
                     :property-sets [{:id :movement
                                      :label \"Movement\"
                                      :properties [{:id :cost
                                                    :label \"Cost\"
                                                    :type :number
                                                    :default 1}]}]
                     :property-set-ids [:movement]
                     :default-values {}
                     :override-values {:cost 4}
                     :disabled? false))
      :children [{:mode 'property-value-list
                  :state {:title \"Tile Properties\"
                          :kind :tile
                          :property-sets (ui/bind-state :property-sets)
                          :property-set-ids
                          (ui/bind-state :property-set-ids)
                          :default-values
                          (ui/bind-state :default-values)
                          :override-values
                          (ui/bind-state :override-values)
                          :disabled? (ui/bind-state :disabled?)}}]})")

(deftest property-set-list-panel-has-header-and-add-button
  (let [panel (layout/make-property-set-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Property Sets" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))
    (is (some? (-> panel :state :property-sets)))
    (is (some? (-> panel :state :selected-property-set-index)))))

(deftest property-set-rows-have-context-menu
  (let [row (layout/property-set-row-child 0 {:value 0 :label "Movement"})
        edit-item (head (:items layout/property-set-context-menu))
        delete-item (nth (:items layout/property-set-context-menu) 1)]
    (is (= "Edit" (:label edit-item)))
    (is (= :edit (-> edit-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))
    (is (= "Movement" (-> row :state :label)))))

(deftest property-definition-panel-has-disabled-bound-add-button
  (let [panel (layout/make-property-definition-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Fields" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))
    (is (some? (-> add-button :state :disabled?)))
    (is (some? (-> panel :state :property-sets)))
    (is (some? (-> panel :state :selected-property-set-index)))
    (is (some? (-> panel :state :selected-property-definition-index)))))

(deftest property-definition-panel-shows-only-property-detail
  (let [panel (layout/make-property-definition-panel)
        body (nth (:children panel) 1)
        children (:children body)
        detail (nth children 1)]
    (is (= 2 (count children)))
    (is (= 'property-definition-detail (:mode detail)))))

(deftest property-type-field-has-label
  (let [children (layout/property-definition-detail-children)
        type-field (nth children 2)]
    (is (= 'property-type-field (:mode type-field)))))

(deftest property-type-specific-fields-show-relevant-controls
  (let [any-fields (layout/property-type-specific-fields-child
                    {:type :any
                     :default "grass"}
                    false
                    true)
        enum-fields (layout/property-type-specific-fields-child
                     {:type :enum
                      :values [:yes :no]
                      :default :yes}
                     false
                     false)
        number-fields (layout/property-type-specific-fields-child
                       {:type :number
                        :default 1}
                       false
                       true)]
    (is (= :default
           (-> any-fields :children head :state :field)))
    (is (= 1 (count (:children any-fields))))
    (is (= 'property-enum-default-field
           (-> enum-fields :children head :mode)))
    (is (= 'property-enum-value-row
           (-> enum-fields :children (nth 2) :mode)))
    (is (= 'property-number-field
           (-> number-fields :children head :mode)))
    (is (= 1 (count (:children number-fields))))))

(deftest property-set-assignment-list-shows-property-sets
  (let [content (layout/property-set-assignment-list-content-child
                 {:kind :tileset
                  :property-sets [{:id :movement
                                   :label "Movement"}]
                  :assigned-property-set-ids [:movement]})
        title (-> content :children head)
        row (-> content :children (nth 1))]
    (is (= "Property Sets" (-> title :state :value)))
    (is (= 'property-set-assignment-row (:mode row)))
    (is (= :tileset (-> row :state :kind)))
    (is (= true (-> row :state :attached?)))))

(deftest property-value-control-uses-number-input-for-number-properties
  (let [control (targets/property-value-control-child
                 {:id :cost
                  :label "Cost"
                  :type :number
                  :default 1})]
    (is (= 'property-value-number-control (:mode control)))
    (is (= :cost (-> control :state :property-id)))
    (is (some? (-> control :state :kind)))
    (is (some? (-> control :state :value)))
    (is (some? (-> control :state :disabled?)))))

(deftest property-value-list-keeps-control-view-when-value-changes
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 320
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (property-value-list-probe-source))
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (let [control (runtime/find-view app "property-value-number-control")]
      (is (= 4 (:value (runtime/view-state control))))
      (runtime/set-active-state!
       app
       (assoc (runtime/active-state app)
              :override-values {:cost 5}))
      (runtime/settle-layout! app)
      (is (= control
             (runtime/find-view app "property-value-number-control")))
      (is (= 5 (:value (runtime/view-state control)))))))
