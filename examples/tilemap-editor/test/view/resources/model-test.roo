(ns tilemap-editor.view.resources.model-test
  (:require proof.core
            [pixils.resource :as res]
            [tilemap-editor.view.resources.model :as resources]))

(deftest image-resource-key-uses_bundle_and_local_id
  (is (= :terrain-assets/terrain
         (resources/image-resource-key :terrain-assets "terrain"))))

(deftest file-stem-removes_path_and_extension
  (is (= "tiles"
         (resources/file-stem "/tmp/maps/tiles.png"))))

(deftest file-directory-returns_parent_directory
  (is (= "/tmp/maps"
         (resources/file-directory "/tmp/maps/tiles.png")))
  (is (= nil
         (resources/file-directory "tiles.png"))))

(deftest project-file-directory-resolves_relative_directory_under_project
  (is (= "/tmp/project/assets"
         (resources/project-file-directory "assets/tiles.png" "/tmp/project")))
  (is (= "/tmp/assets"
         (resources/project-file-directory "/tmp/assets/tiles.png"
                                           "/tmp/project"))))

(deftest default-resource-fields-clean_file_stem
  (is (= "simples-pimples"
         (resources/default-resource-id "/tmp/maps/Simples_Pimples.png")))
  (is (= "Simples Pimples"
         (resources/default-resource-name "/tmp/maps/Simples_Pimples.png")))
  (is (= "Player Ship"
         (resources/default-resource-name "/tmp/maps/playerShip.png"))))

(deftest transparency-color-hex-round-trips
  (is (= {:r 90 :g 82 :b 104}
         (resources/transparency-color-map "#5a5268")))
  (is (= {:r 170 :g 187 :b 204}
         (resources/transparency-color-map "#abc")))
  (is (= "#5a5268"
         (resources/color-hex {:r 90 :g 82 :b 104}))))

(deftest project-bundle-entries-list_project_bundles
  (is (= [{:id :terrain-assets
           :bundle {:images {}}}]
         (resources/project-bundle-entries
          {:bundles {:terrain-assets {:images {}}}}))))

(deftest dynamic-project-bundles-ignore_static_editor_assets
  (is (= [{:id :terrain-assets
           :bundle {:images {}}}]
         (resources/dynamic-project-bundle-entries
          {:bundles {:editor-assets
                     {:images {:spritesheet {:file-name "sprites.png"}}}
                     :terrain-assets
                     {:images {}}}}))))

(deftest project-image-resource-entries_use_selected_bundle
  (is (= [{:id :tiles
           :bundle-id :terrain-assets
           :dependency {:file-name "/tmp/maps/tiles.png"}}]
         (resources/project-image-resource-entries
          {:bundles {:terrain-assets
                     {:images {:tiles {:file-name "/tmp/maps/tiles.png"}}}
                     :ui-assets
                     {:images {:icons {:file-name "/tmp/maps/icons.png"}}}}}
          :terrain-assets))))

(deftest first-image-resource-id-uses_selected_bundle
  (is (= :tiles
         (resources/first-image-resource-id
          {:bundles {:terrain-assets
                     {:images {:tiles {:file-name "/tmp/maps/tiles.png"}}}
                     :ui-assets
                     {:images {:icons {:file-name "/tmp/maps/icons.png"}}}}}
          :terrain-assets)))
  (is (= nil
         (resources/first-image-resource-id
          {:bundles {:terrain-assets {:images {}}}}
          :terrain-assets))))

(deftest project-image-resources-use_project_metadata
  (is (= [{:id :terrain
           :bundle-id :terrain-assets
           :key :terrain-assets/terrain
           :name "Terrain Sheet"
           :file-name "/tmp/maps/tiles.png"
           :transparency-color "#5a5268"}]
         (resources/project-image-resources
          {:bundles {:terrain-assets
                     {:images {:terrain {:name "Terrain Sheet"
                                         :file-name "/tmp/maps/tiles.png"
                                         :transparency-color "#5a5268"}}}}}
          :terrain-assets))))

(deftest resource-key-bundle-replacement-updates_matching_qualified_keys
  (is (= :terrain-v2/grass
         (resources/replace-resource-key-bundle
          :terrain-assets/grass
          :terrain-assets
          :terrain-v2)))
  (is (= :other/grass
         (resources/replace-resource-key-bundle
          :other/grass
          :terrain-assets
          :terrain-v2))))

(deftest resource-key-bundle-replacement-walks_nested_tile_data
  (is (= {:tile {:image :terrain-v2/sheet
                 :variants [:terrain-v2/one :other/two]}}
         (resources/replace-resource-key-bundle-in
          {:tile {:image :terrain-assets/sheet
                  :variants [:terrain-assets/one :other/two]}}
          :terrain-assets
          :terrain-v2))))

(deftest resource-key-replacement-updates_exact_resource_key_only
  (is (= :terrain-assets/tiles-v2
         (resources/replace-resource-key
          :terrain-assets/tiles
          :terrain-assets/tiles
          :terrain-assets/tiles-v2)))
  (is (= :terrain-assets/other
         (resources/replace-resource-key
          :terrain-assets/other
          :terrain-assets/tiles
          :terrain-assets/tiles-v2))))

(deftest resource-key-replacement-walks_nested_project_data
  (is (= {:tile {:image :terrain-assets/tiles-v2
                 :by-key {:terrain-assets/tiles-v2 true
                          :other/tiles true}}}
         (resources/replace-resource-key-in
          {:tile {:image :terrain-assets/tiles
                  :by-key {:terrain-assets/tiles true
                           :other/tiles true}}}
          :terrain-assets/tiles
          :terrain-assets/tiles-v2))))

(deftest bundle-rename-updates_tileset_image_references
  (is (= [{:id :terrain
           :tiles [{:id :grass
                    :type :sprite
                    :image :terrain-v2/sheet}
                   {:id :water
                    :type :sprite
                    :image :other/sheet}]}]
         (resources/rename-bundle-in-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :other/sheet}]}]
          :terrain-assets
          :terrain-v2))))

(deftest bundle-rename-updates_layer_resource_references
  (is (= [{:id :decor
           :stamp {:image :terrain-v2/decor}}]
         (resources/rename-bundle-in-layers
          [{:id :decor
            :stamp {:image :terrain-assets/decor}}]
          :terrain-assets
          :terrain-v2))))

(deftest bundle-rename-updates_brush_resource_references
  (is (= [{:id :stamp-brush
           :kind :pattern
           :pattern {:layers [{:id :decor
                                :tileset :terrain
                                :tiles [[{:image :terrain-v2/decor}
                                         {:image :other/decor}]]}]}}]
         (resources/rename-bundle-in-brushes
          [{:id :stamp-brush
            :kind :pattern
            :pattern {:layers [{:id :decor
                                 :tileset :terrain
                                 :tiles [[{:image :terrain-assets/decor}
                                          {:image :other/decor}]]}]}}]
          :terrain-assets
          :terrain-v2))))

(deftest resource-rename-updates_tileset_image_references
  (is (= [{:id :terrain
           :tiles [{:id :grass
                    :type :sprite
                    :image :terrain-assets/sheet-v2}
                   {:id :water
                    :type :sprite
                    :image :terrain-assets/other}]}]
         (resources/rename-resource-in-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :terrain-assets/other}]}]
          :terrain-assets
          :sheet
          :sheet-v2))))

(deftest resource-rename-updates_layer_resource_references
  (is (= [{:id :decor
           :stamp {:image :terrain-assets/decor-v2}}]
         (resources/rename-resource-in-layers
          [{:id :decor
            :stamp {:image :terrain-assets/decor}}]
          :terrain-assets
          :decor
          :decor-v2))))

(deftest resource-rename-updates_layer_resource_references_in_all_project_maps
  (res/create-bundle! :terrain-assets)
  (res/add-image! :terrain-assets/decor {:file-name "decor.png"})
  (let [state (resources/edit-image-resource!
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 1
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default :layers []}]
                :selected-layer-index 0
                :resources {:bundles {:terrain-assets
                                      {:images {:decor
                                                {:file-name "decor.png"
                                                 :name "Decor"}}}}}
                :layers [{:id :active
                          :stamp {:image :terrain-assets/decor}}]
                :maps [{:id :map/one
                        :label "One"
                        :width 1
                        :height 1
                        :layers [{:id :active
                                  :stamp {:image :terrain-assets/decor}}]}
                       {:id :map/two
                        :label "Two"
                        :width 1
                        :height 1
                        :layers [{:id :inactive
                                  :stamp {:image :terrain-assets/decor}}]}]}
               {:bundle-id :terrain-assets
                :previous-resource-id :decor
                :resource-id "decor-v2"
                :resource-name "Decor V2"
                :file-name "decor-v2.png"})]
    (is (= :terrain-assets/decor-v2
           (get-in state [:layers 0 :stamp :image])))
    (is (= :terrain-assets/decor-v2
           (get-in state [:maps 0 :layers 0 :stamp :image])))
    (is (= :terrain-assets/decor-v2
           (get-in state [:maps 1 :layers 0 :stamp :image])))))

(deftest resource-rename-updates_brush_resource_references
  (is (= [{:id :stamp-brush
           :kind :pattern
           :pattern {:layers [{:id :decor
                                :tileset :terrain
                                :tiles [[{:image :terrain-assets/decor-v2}
                                         {:image :terrain-assets/other}]]}]}}]
         (resources/rename-resource-in-brushes
          [{:id :stamp-brush
            :kind :pattern
            :pattern {:layers [{:id :decor
                                 :tileset :terrain
                                 :tiles [[{:image :terrain-assets/decor}
                                          {:image :terrain-assets/other}]]}]}}]
          :terrain-assets
          :decor
          :decor-v2))))

(deftest image-resource-replace-file-keeps_resource_key_and_metadata
  (res/create-bundle! :terrain-assets)
  (res/add-image! :terrain-assets/tiles {:file-name "old.png"})
  (let [state (resources/replace-image-resource-file!
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "old.png"
                                                 :name "Tiles"
                                                 :transparency-color "#5a5268"}}}}}
                :tilesets [{:id :terrain
                            :tiles [{:type :sprite
                                     :image :terrain-assets/tiles}]}]
                :selected-resource-bundle :terrain-assets
                :selected-image-resource :tiles
                :selected-image-resources [:tiles]}
               {:bundle-id :terrain-assets
                :resource-id :tiles
                :file-name "new.png"})]
    (is (= {:file-name "new.png"
            :name "Tiles"
            :transparency-color "#5a5268"}
           (get-in state [:resources :bundles :terrain-assets :images :tiles])))
    (is (= :tiles (:selected-image-resource state)))
    (is (= [:tiles] (:selected-image-resources state)))
    (is (= :terrain-assets/tiles
           (get-in state [:tilesets 0 :tiles 0 :image])))))

(deftest image-resource-move-transfers_dependency_and_updates_project_references
  (let [state (resources/move-image-resource!
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 1
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default
                                  :layers [{:id :profile
                                            :stamp {:image :terrain-assets/tiles}}]}]
                :resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "tiles.png"
                                                 :name "Tiles"}}}
                                      :ui-assets
                                      {:images {}}}}
                :tilesets [{:id :terrain
                            :tiles [{:id :grass
                                     :type :sprite
                                     :image :terrain-assets/tiles}]}]
                :brushes [{:id :stamp-brush
                           :kind :pattern
                           :pattern {:layers [{:tiles [[{:image :terrain-assets/tiles}]]}]}}]
                :layers [{:id :active
                          :stamp {:image :terrain-assets/tiles}}]
                :maps [{:id :map/one
                        :label "One"
                        :width 1
                        :height 1
                        :layers [{:id :active
                                  :stamp {:image :terrain-assets/tiles}}]}
                       {:id :map/two
                        :label "Two"
                        :width 1
                        :height 1
                        :layers [{:id :inactive
                                  :stamp {:image :terrain-assets/tiles}}]}]}
               {:source-bundle-id :terrain-assets
                :resource-id :tiles
                :target-bundle-id :ui-assets})]
    (is (= nil
           (get-in state [:resources :bundles :terrain-assets :images :tiles])))
    (is (= {:file-name "tiles.png"
            :name "Tiles"}
           (get-in state [:resources :bundles :ui-assets :images :tiles])))
    (is (= :ui-assets (:selected-resource-bundle state)))
    (is (= :tiles (:selected-image-resource state)))
    (is (= :ui-assets/tiles
           (get-in state [:tilesets 0 :tiles 0 :image])))
    (is (= :ui-assets/tiles
           (get-in state [:layers 0 :stamp :image])))
    (is (= :ui-assets/tiles
           (get-in state [:maps 0 :layers 0 :stamp :image])))
    (is (= :ui-assets/tiles
           (get-in state [:maps 1 :layers 0 :stamp :image])))
    (is (= :ui-assets/tiles
           (get-in state [:layer-profiles 0 :layers 0 :stamp :image])))
    (is (= :ui-assets/tiles
           (get-in state [:brushes 0 :pattern :layers 0 :tiles 0 0 :image])))))

(deftest image-resource-move-uses_unique_id_when_target_bundle_has_same_resource_id
  (let [state (resources/move-image-resource!
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "terrain.png"
                                                 :name "Terrain"}}}
                                      :ui-assets
                                      {:images {:tiles
                                                {:file-name "ui.png"
                                                 :name "UI"}}}}}
                :tilesets [{:id :terrain
                            :tiles [{:type :sprite
                                     :image :terrain-assets/tiles}]}]}
               {:source-bundle-id :terrain-assets
                :resource-id :tiles
                :target-bundle-id :ui-assets})]
    (is (= {:file-name "terrain.png"
            :name "Terrain"}
           (get-in state [:resources :bundles :ui-assets :images :tiles-2])))
    (is (= {:file-name "ui.png"
            :name "UI"}
           (get-in state [:resources :bundles :ui-assets :images :tiles])))
    (is (= :tiles-2 (:selected-image-resource state)))
    (is (= :ui-assets/tiles-2
           (get-in state [:tilesets 0 :tiles 0 :image])))))

(deftest resource-usage-counts_tiles_per_tileset
  (is (= [{:tileset-id :terrain
	           :label "Terrain"
	           :count 2}
	          {:tileset-id :empty
	           :label "Empty"
	           :count 0}
	          {:tileset-id :decor
	           :label "Decor"
	           :count 1}]
         (resources/resource-usage-by-tileset
          [{:id :terrain
            :label "Terrain"
            :tiles [{:type :sprite
                     :image :terrain-assets/sheet}
                    {:type :sprite
                     :image :terrain-assets/sheet}
                    {:type :sprite
                     :image :terrain-assets/other}]}
           {:id :empty
            :label "Empty"
            :tiles []}
           {:id :decor
            :label "Decor"
            :tiles [{:type :sprite
                     :image :terrain-assets/sheet}]}]
          :terrain-assets/sheet))))

(deftest resource-delete-can_remove_tiles_using_resource
  (is (= [{:id :terrain
           :tiles [{:id :water
                    :type :sprite
                    :image :terrain-assets/other}
                   {:id :plain
                    :type :color}]}]
         (resources/remove-resource-tiles-from-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :terrain-assets/other}
                    {:id :plain
                     :type :color}]}]
          :terrain-assets/sheet))))

(deftest replacement-resource-options-exclude_current_resource
  (is (= [{:value :terrain-assets/other
           :label ":terrain-assets/other  Other"
           :key :terrain-assets/other}]
         (resources/replacement-image-resource-options
          {:bundles {:terrain-assets
                     {:images {:sheet {:name "Sheet"
                                       :file-name "sheet.png"}
                               :other {:name "Other"
                                       :file-name "other.png"}}}}}
          :terrain-assets/sheet))))

(deftest runtime-image-dependency-strips_editor_metadata
  (is (= {:file-name "/tmp/maps/tiles.png"
          :transparency-color "#5a5268"}
         (resources/runtime-image-dependency
          {:file-name "/tmp/maps/tiles.png"
           :name "Terrain Sheet"
           :transparency-color "#5a5268"}))))

(deftest image-resource-dependency-includes-optional-transparency-color
  (is (= {:file-name "/tmp/maps/tiles.png"
          :name "Terrain Sheet"
          :transparency-color "#5a5268"}
         (resources/resource-dependency
          {:file-name "/tmp/maps/tiles.png"
           :resource-name "Terrain Sheet"
           :transparency-color "#5a5268"})))
  (is (= {:file-name "/tmp/maps/tiles.png"
          :name "Terrain Sheet"}
         (resources/resource-dependency
          {:file-name "/tmp/maps/tiles.png"
           :resource-name "Terrain Sheet"
           :transparency-color ""}))))

(deftest runtime-bundle-dependencies-reduces_image_map_by_key_value
  (is (= {:images {:simples_pimples {:file-name "/tmp/simples_pimples.png"}}}
         (resources/runtime-bundle-dependencies
          {:images {:simples_pimples
                    {:file-name "/tmp/simples_pimples.png"
                     :name "Simples Pimples"}}}))))

(deftest image-resource-options-preserve-resource-id
  (is (= [{:value :tiles
           :bundle-id :terrain-assets
           :key-label ":terrain-assets/tiles"
           :name "Tiles"
           :label ":terrain-assets/tiles"}]
         (resources/image-resource-options
          [{:id :tiles
            :bundle-id :terrain-assets
            :key :terrain-assets/tiles
            :name "Tiles"
            :file-name "/tmp/maps/tiles.png"}]))))

(deftest selected-resource-helpers-follow-selected-id
  (let [items [{:id :a}
               {:id :b}]]
    (is (= 1 (resources/selected-resource-index items :b)))
    (is (= [{:id :b}]
           [(resources/selected-resource items :b)]))
    (is (= [1] (resources/selected-resource-indices
                items
                :b)))))

(deftest selected-image-resource-directory-uses_selected_resource
  (is (= "/tmp/maps"
         (resources/selected-image-resource-directory
          {:resources {:bundles {:terrain-assets
                                 {:images {:tiles
                                           {:file-name "/tmp/maps/tiles.png"}}}}}
           :selected-resource-bundle :terrain-assets
           :selected-image-resource :tiles}))))

(deftest selected-image-resource-directory-resolves_relative_paths_from_project
  (is (= "/tmp/project/assets"
         (resources/selected-image-resource-directory
          {:resources {:bundles {:terrain-assets
                                 {:images {:tiles
                                           {:file-name "assets/tiles.png"}}}}}
           :project-directory "/tmp/project"
           :selected-resource-bundle :terrain-assets
           :selected-image-resource :tiles}))))

(deftest resource-workspace-state-ignores_static_editor_bundle_selection
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:editor-assets
                                      {:images {:spritesheet
                                                {:file-name "sprites.png"}}}}}
                :selected-resource-bundle :editor-assets
                :selected-image-resource :spritesheet})]
    (is (= nil (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= true (:image-resource-panel-disabled? state)))))

(deftest resource-workspace-state-selects_first_available_bundle
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets {:images {}}
                                      :ui-assets {:images {}}}}
                :selected-resource-bundle nil
                :selected-image-resource nil})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= false (:image-resource-panel-disabled? state)))
    (is (= false (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-selects_first_available_image_resource
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "/tmp/tiles.png"}
                                                :decor
                                                {:file-name "/tmp/decor.png"}}}}}
                :selected-resource-bundle :terrain-assets
                :selected-image-resource nil})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= :tiles (:selected-image-resource state)))
    (is (= [:tiles] (:selected-image-resources state)))
    (is (= false (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-keeps_multi_image_selection_and_disables_detail
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "/tmp/tiles.png"}
                                                :decor
                                                {:file-name "/tmp/decor.png"}}}}}
                :selected-resource-bundle :terrain-assets
                :selected-image-resources [:tiles :decor]})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= [:tiles :decor] (:selected-image-resources state)))
    (is (= true (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-clears_stale_image_selection
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets {:images {}}}}
                :selected-resource-bundle :terrain-assets
                :selected-image-resource :simples-pimples})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= false (:image-resource-panel-disabled? state)))
    (is (= false (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))

(deftest image-resource-delete-removes_multiple_resources_and_selects_remaining
  (let [state (resources/remove-image-resources!
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "tiles.png"}
                                                :decor
                                                {:file-name "decor.png"}
                                                :icons
                                                {:file-name "icons.png"}}}}}
                :tilesets [{:id :terrain
                            :tiles [{:type :sprite
                                     :image :terrain-assets/tiles}
                                    {:type :sprite
                                     :image :terrain-assets/decor}
                                    {:type :sprite
                                     :image :terrain-assets/icons}]}]
                :selected-resource-bundle :terrain-assets
                :selected-image-resources [:tiles :decor]}
               :terrain-assets
               [:tiles :decor])]
    (is (= nil
           (get-in state [:resources :bundles :terrain-assets :images :tiles])))
    (is (= nil
           (get-in state [:resources :bundles :terrain-assets :images :decor])))
    (is (= {:file-name "icons.png"}
           (get-in state [:resources :bundles :terrain-assets :images :icons])))
    (is (= :icons (:selected-image-resource state)))
    (is (= [:icons] (:selected-image-resources state)))
    (is (= [{:type :sprite
             :image :terrain-assets/icons}]
           (get-in state [:tilesets 0 :tiles])))))

(deftest resource-workspace-state-disables_image_panel_without_bundle
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {}}
                :selected-resource-bundle :missing
                :selected-image-resource :simples-pimples})]
    (is (= nil (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= true (:image-resource-panel-disabled? state)))
    (is (= true (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))
