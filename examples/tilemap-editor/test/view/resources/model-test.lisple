(ns tilemap-editor.view.resources.model-test
  (:require proof.core
            [tilemap-editor.view.resources.model :as resources]))

(deftest image-resource-key-uses_bundle_and_local_id
  (is (= :terrain-assets/terrain
         (resources/image-resource-key :terrain-assets "terrain"))))

(deftest file-stem-removes_path_and_extension
  (is (= "tiles"
         (resources/file-stem "/tmp/maps/tiles.png"))))

(deftest default-resource-fields-clean_file_stem
  (is (= "simples-pimples"
         (resources/default-resource-id "/tmp/maps/Simples_Pimples.png")))
  (is (= "Simples Pimples"
         (resources/default-resource-name "/tmp/maps/Simples_Pimples.png")))
  (is (= "Player Ship"
         (resources/default-resource-name "/tmp/maps/playerShip.png"))))

(deftest transparency-color-hex-round-trips
  (is (= {:r 90 :g 82 :b 104}
         (resources/transparency-color-map "#5a5268")))
  (is (= {:r 170 :g 187 :b 204}
         (resources/transparency-color-map "#abc")))
  (is (= "#5a5268"
         (resources/color-hex {:r 90 :g 82 :b 104}))))

(deftest project-bundle-entries-list_project_bundles
  (is (= [{:id :terrain-assets
           :bundle {:images {}}}]
         (resources/project-bundle-entries
          {:bundles {:terrain-assets {:images {}}}}))))

(deftest dynamic-project-bundles-ignore_static_editor_assets
  (is (= [{:id :terrain-assets
           :bundle {:images {}}}]
         (resources/dynamic-project-bundle-entries
          {:bundles {:editor-assets
                     {:images {:spritesheet {:file-name "sprites.png"}}}
                     :terrain-assets
                     {:images {}}}}))))

(deftest project-image-resource-entries_use_selected_bundle
  (is (= [{:id :tiles
           :bundle-id :terrain-assets
           :dependency {:file-name "/tmp/maps/tiles.png"}}]
         (resources/project-image-resource-entries
          {:bundles {:terrain-assets
                     {:images {:tiles {:file-name "/tmp/maps/tiles.png"}}}
                     :ui-assets
                     {:images {:icons {:file-name "/tmp/maps/icons.png"}}}}}
          :terrain-assets))))

(deftest first-image-resource-id-uses_selected_bundle
  (is (= :tiles
         (resources/first-image-resource-id
          {:bundles {:terrain-assets
                     {:images {:tiles {:file-name "/tmp/maps/tiles.png"}}}
                     :ui-assets
                     {:images {:icons {:file-name "/tmp/maps/icons.png"}}}}}
          :terrain-assets)))
  (is (= nil
         (resources/first-image-resource-id
          {:bundles {:terrain-assets {:images {}}}}
          :terrain-assets))))

(deftest project-image-resources-use_project_metadata
  (is (= [{:id :terrain
           :bundle-id :terrain-assets
           :key :terrain-assets/terrain
           :name "Terrain Sheet"
           :file-name "/tmp/maps/tiles.png"
           :transparency-color "#5a5268"}]
         (resources/project-image-resources
          {:bundles {:terrain-assets
                     {:images {:terrain {:name "Terrain Sheet"
                                         :file-name "/tmp/maps/tiles.png"
                                         :transparency-color "#5a5268"}}}}}
          :terrain-assets))))

(deftest resource-key-bundle-replacement-updates_matching_qualified_keys
  (is (= :terrain-v2/grass
         (resources/replace-resource-key-bundle
          :terrain-assets/grass
          :terrain-assets
          :terrain-v2)))
  (is (= :other/grass
         (resources/replace-resource-key-bundle
          :other/grass
          :terrain-assets
          :terrain-v2))))

(deftest resource-key-bundle-replacement-walks_nested_tile_data
  (is (= {:tile {:image :terrain-v2/sheet
                 :variants [:terrain-v2/one :other/two]}}
         (resources/replace-resource-key-bundle-in
          {:tile {:image :terrain-assets/sheet
                  :variants [:terrain-assets/one :other/two]}}
          :terrain-assets
          :terrain-v2))))

(deftest resource-key-replacement-updates_exact_resource_key_only
  (is (= :terrain-assets/tiles-v2
         (resources/replace-resource-key
          :terrain-assets/tiles
          :terrain-assets/tiles
          :terrain-assets/tiles-v2)))
  (is (= :terrain-assets/other
         (resources/replace-resource-key
          :terrain-assets/other
          :terrain-assets/tiles
          :terrain-assets/tiles-v2))))

(deftest resource-key-replacement-walks_nested_project_data
  (is (= {:tile {:image :terrain-assets/tiles-v2
                 :by-key {:terrain-assets/tiles-v2 true
                          :other/tiles true}}}
         (resources/replace-resource-key-in
          {:tile {:image :terrain-assets/tiles
                  :by-key {:terrain-assets/tiles true
                           :other/tiles true}}}
          :terrain-assets/tiles
          :terrain-assets/tiles-v2))))

(deftest bundle-rename-updates_tileset_image_references
  (is (= [{:id :terrain
           :tiles [{:id :grass
                    :type :sprite
                    :image :terrain-v2/sheet}
                   {:id :water
                    :type :sprite
                    :image :other/sheet}]}]
         (resources/rename-bundle-in-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :other/sheet}]}]
          :terrain-assets
          :terrain-v2))))

(deftest bundle-rename-updates_layer_resource_references
  (is (= [{:id :decor
           :stamp {:image :terrain-v2/decor}}]
         (resources/rename-bundle-in-layers
          [{:id :decor
            :stamp {:image :terrain-assets/decor}}]
          :terrain-assets
          :terrain-v2))))

(deftest bundle-rename-updates_brush_resource_references
  (is (= [{:id :stamp-brush
           :kind :pattern
           :pattern {:layers [{:id :decor
                                :tileset :terrain
                                :tiles [[{:image :terrain-v2/decor}
                                         {:image :other/decor}]]}]}}]
         (resources/rename-bundle-in-brushes
          [{:id :stamp-brush
            :kind :pattern
            :pattern {:layers [{:id :decor
                                 :tileset :terrain
                                 :tiles [[{:image :terrain-assets/decor}
                                          {:image :other/decor}]]}]}}]
          :terrain-assets
          :terrain-v2))))

(deftest resource-rename-updates_tileset_image_references
  (is (= [{:id :terrain
           :tiles [{:id :grass
                    :type :sprite
                    :image :terrain-assets/sheet-v2}
                   {:id :water
                    :type :sprite
                    :image :terrain-assets/other}]}]
         (resources/rename-resource-in-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :terrain-assets/other}]}]
          :terrain-assets
          :sheet
          :sheet-v2))))

(deftest resource-rename-updates_layer_resource_references
  (is (= [{:id :decor
           :stamp {:image :terrain-assets/decor-v2}}]
         (resources/rename-resource-in-layers
          [{:id :decor
            :stamp {:image :terrain-assets/decor}}]
          :terrain-assets
          :decor
          :decor-v2))))

(deftest resource-rename-updates_brush_resource_references
  (is (= [{:id :stamp-brush
           :kind :pattern
           :pattern {:layers [{:id :decor
                                :tileset :terrain
                                :tiles [[{:image :terrain-assets/decor-v2}
                                         {:image :terrain-assets/other}]]}]}}]
         (resources/rename-resource-in-brushes
          [{:id :stamp-brush
            :kind :pattern
            :pattern {:layers [{:id :decor
                                 :tileset :terrain
                                 :tiles [[{:image :terrain-assets/decor}
                                          {:image :terrain-assets/other}]]}]}}]
          :terrain-assets
          :decor
          :decor-v2))))

(deftest resource-usage-counts_tiles_per_tileset
  (is (= [{:tileset-id :terrain
	           :label "Terrain"
	           :count 2}
	          {:tileset-id :empty
	           :label "Empty"
	           :count 0}
	          {:tileset-id :decor
	           :label "Decor"
	           :count 1}]
         (resources/resource-usage-by-tileset
          [{:id :terrain
            :label "Terrain"
            :tiles [{:type :sprite
                     :image :terrain-assets/sheet}
                    {:type :sprite
                     :image :terrain-assets/sheet}
                    {:type :sprite
                     :image :terrain-assets/other}]}
           {:id :empty
            :label "Empty"
            :tiles []}
           {:id :decor
            :label "Decor"
            :tiles [{:type :sprite
                     :image :terrain-assets/sheet}]}]
          :terrain-assets/sheet))))

(deftest resource-delete-can_remove_tiles_using_resource
  (is (= [{:id :terrain
           :tiles [{:id :water
                    :type :sprite
                    :image :terrain-assets/other}
                   {:id :plain
                    :type :color}]}]
         (resources/remove-resource-tiles-from-tilesets
          [{:id :terrain
            :tiles [{:id :grass
                     :type :sprite
                     :image :terrain-assets/sheet}
                    {:id :water
                     :type :sprite
                     :image :terrain-assets/other}
                    {:id :plain
                     :type :color}]}]
          :terrain-assets/sheet))))

(deftest replacement-resource-options-exclude_current_resource
  (is (= [{:value :terrain-assets/other
           :label ":terrain-assets/other  Other"
           :key :terrain-assets/other}]
         (resources/replacement-image-resource-options
          {:bundles {:terrain-assets
                     {:images {:sheet {:name "Sheet"
                                       :file-name "sheet.png"}
                               :other {:name "Other"
                                       :file-name "other.png"}}}}}
          :terrain-assets/sheet))))

(deftest runtime-image-dependency-strips_editor_metadata
  (is (= {:file-name "/tmp/maps/tiles.png"
          :transparency-color "#5a5268"}
         (resources/runtime-image-dependency
          {:file-name "/tmp/maps/tiles.png"
           :name "Terrain Sheet"
           :transparency-color "#5a5268"}))))

(deftest image-resource-dependency-includes-optional-transparency-color
  (is (= {:file-name "/tmp/maps/tiles.png"
          :name "Terrain Sheet"
          :transparency-color "#5a5268"}
         (resources/resource-dependency
          {:file-name "/tmp/maps/tiles.png"
           :resource-name "Terrain Sheet"
           :transparency-color "#5a5268"})))
  (is (= {:file-name "/tmp/maps/tiles.png"
          :name "Terrain Sheet"}
         (resources/resource-dependency
          {:file-name "/tmp/maps/tiles.png"
           :resource-name "Terrain Sheet"
           :transparency-color ""}))))

(deftest runtime-bundle-dependencies-reduces_image_map_by_key_value
  (is (= {:images {:simples_pimples {:file-name "/tmp/simples_pimples.png"}}}
         (resources/runtime-bundle-dependencies
          {:images {:simples_pimples
                    {:file-name "/tmp/simples_pimples.png"
                     :name "Simples Pimples"}}}))))

(deftest image-resource-options-preserve-resource-id
  (is (= [{:value :tiles
           :bundle-id :terrain-assets
           :key-label ":terrain-assets/tiles"
           :name "Tiles"
           :label ":terrain-assets/tiles"}]
         (resources/image-resource-options
          [{:id :tiles
            :bundle-id :terrain-assets
            :key :terrain-assets/tiles
            :name "Tiles"
            :file-name "/tmp/maps/tiles.png"}]))))

(deftest selected-resource-helpers-follow-selected-id
  (let [items [{:id :a}
               {:id :b}]]
    (is (= 1 (resources/selected-resource-index items :b)))
    (is (= [{:id :b}]
           [(resources/selected-resource items :b)]))
    (is (= [1] (resources/selected-resource-indices
                items
                :b)))))

(deftest resource-workspace-state-ignores_static_editor_bundle_selection
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:editor-assets
                                      {:images {:spritesheet
                                                {:file-name "sprites.png"}}}}}
                :selected-resource-bundle :editor-assets
                :selected-image-resource :spritesheet})]
    (is (= nil (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= true (:image-resource-panel-disabled? state)))))

(deftest resource-workspace-state-selects_first_available_bundle
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets {:images {}}
                                      :ui-assets {:images {}}}}
                :selected-resource-bundle nil
                :selected-image-resource nil})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= false (:image-resource-panel-disabled? state)))
    (is (= false (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-selects_first_available_image_resource
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets
                                      {:images {:tiles
                                                {:file-name "/tmp/tiles.png"}
                                                :decor
                                                {:file-name "/tmp/decor.png"}}}}}
                :selected-resource-bundle :terrain-assets
                :selected-image-resource nil})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= :tiles (:selected-image-resource state)))
    (is (= false (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-clears_stale_image_selection
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {:terrain-assets {:images {}}}}
                :selected-resource-bundle :terrain-assets
                :selected-image-resource :simples-pimples})]
    (is (= :terrain-assets (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= false (:image-resource-panel-disabled? state)))
    (is (= false (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))

(deftest resource-workspace-state-disables_image_panel_without_bundle
  (let [state (resources/derive-resource-workspace-state
               {:resources {:bundles {}}
                :selected-resource-bundle :missing
                :selected-image-resource :simples-pimples})]
    (is (= nil (:selected-resource-bundle state)))
    (is (= nil (:selected-image-resource state)))
    (is (= true (:image-resource-panel-disabled? state)))
    (is (= true (:image-resource-add-disabled? state)))
    (is (= true (:image-resource-detail-disabled? state)))))
