(ns tilemap-editor.view.masks.panel-test
  (:require proof.core
            [tilemap-editor.view.masks.detail.mask.composition.canvas :as canvas]
            [tilemap-editor.view.masks.detail.mask.composition.selected-tile
             :as selected-tile]
            [tilemap-editor.view.masks.detail.mask.palette :as palette]
            [tilemap-editor.view.masks.masks.row :as mask-row]))

(def test-tilesets
  [{:id :terrain
    :label "Terrain"
    :tile-size 16
    :tiles [{:id :edge-n}
            {:id :edge-e}]}])

(def test-state
  {:tilesets test-tilesets
   :selected-mask-set-index 0
   :selected-mask-index 0
   :mask-sets [{:id :soft-edge
                :label "Soft Edge"
                :mask-size {:w 16
                            :h 16}
                :masks [{:id :north
                         :label "North"
                         :source {:type :tile-composition
                                  :tileset :terrain
                                  :tiles []}}]}]})

(deftest mask-canvas-view-size-uses-selected-mask-set-dimensions
  (is (= {:w 48
          :h 40}
         (canvas/view-size
          (assoc-in test-state
                    [:mask-sets 0 :mask-size]
                    {:w 32
                     :h 24})))))

(deftest mask-canvas-item-context-menu-removes-tiles
  (let [item (head (:items (canvas/item-context-menu 2)))]
    (is (= "Remove" (:label item)))
    (is (= :remove (-> item :payload :command)))
    (is (= 2 (-> item :payload :index)))))

(deftest mask-context-menu-includes-duplicate-command
  (let [duplicate (nth (:items mask-row/context-menu) 1)]
    (is (= "Duplicate Mask" (:label duplicate)))
    (is (= :duplicate (-> duplicate :payload :command)))))

(deftest mask-palette-tile-at-position-finds-swatch-tile
  (is (= :edge-e
         (palette/tile-at-position
          test-state
          {:x 36 :y 2}
          {:w 150 :h 192})))
  (is (nil?
       (palette/tile-at-position
        test-state
        {:x 33 :y 2}
        {:w 150 :h 192}))))

(deftest mask-canvas-selected-index-rejects-stale-indices
  (is (= 0
         (selected-tile/selected-index
          {:selected-mask-tile-item-index 0
           :selected-mask-tile-items [{:tile :edge-n}]})))
  (is (nil?
       (selected-tile/selected-index
        {:selected-mask-tile-item-index 1
         :selected-mask-tile-items [{:tile :edge-n}]}))))

(deftest selected-mask-tile-item-state-exposes-selected-offset
  (is (= {:selected-mask-tile-item-valid-index 1
          :selected-mask-tile-item-label "edge-e"
          :selected-mask-tile-offset-x -2
          :selected-mask-tile-offset-y 9
          :selected-mask-tile-offset-disabled? false}
         (selected-tile/selected-state
          {:selected-mask-tile-item-index 1
           :selected-mask-tile-items [{:tile :edge-n
                                       :offset {:x 0
                                                :y 0}}
                                      {:tile :edge-e
                                       :offset {:x -2
                                                :y 9}}]}))))

(deftest selected-mask-tile-item-state-disables-stale-selection
  (is (= {:selected-mask-tile-item-valid-index nil
          :selected-mask-tile-item-label "Select a tile"
          :selected-mask-tile-offset-x 0
          :selected-mask-tile-offset-y 0
          :selected-mask-tile-offset-disabled? true}
         (selected-tile/selected-state
          {:selected-mask-tile-item-index 4
           :selected-mask-tile-items [{:tile :edge-n
                                       :offset {:x 3
                                                :y 4}}]}))))

(deftest mask-tile-nudge-payload-moves-selected-tile-one-pixel
  (let [state {:selected-mask-tile-item-index 0
               :selected-mask-tile-items [{:tile :edge-n
                                           :offset {:x 2
                                                    :y 3}}]}]
    (is (= {:index 0
            :axis :both
            :value {:x 1
                    :y 3}}
           (selected-tile/nudge-payload state :key/left)))
    (is (= {:index 0
            :axis :both
            :value {:x 2
                    :y 4}}
           (selected-tile/nudge-payload state :key/down)))))

(deftest mask-tile-nudge-payload-ignores-stale-selection
  (is (nil? (selected-tile/nudge-payload
             {:selected-mask-tile-item-index 1
              :selected-mask-tile-items [{:tile :edge-n
                                          :offset {:x 2
                                                   :y 3}}]}
             :key/right))))

(deftest mask-canvas-drop-payload-adds-source-tile-at-drop-position
  (is (= {:tile :edge-n
          :tileset :terrain
          :offset {:x 8
                   :y 9}}
         (canvas/drop-payload
          test-state
          {:payload {:kind :mask/source-tile
                     :tile :edge-n
                     :tileset :terrain
                     :offset {:x 4
                              :y 5}}
           :position {:x 20
                      :y 22}}))))

(deftest mask-canvas-drop-payload-accepts-tileset-grid-tile
  (is (= {:tile :edge-e
          :tileset :terrain
          :offset {:x 4
                   :y 6}}
         (canvas/drop-payload
          test-state
          {:payload {:kind :tileset/tile
                     :source-tileset-index 0
                     :tile {:id :edge-e}
                     :offset {:x 8
                              :y 8}}
           :position {:x 20
                      :y 22}}))))

(deftest mask-canvas-drag-payload-identifies-composed-tile
  (is (= {:kind :mask/composed-tile
          :index 1
          :start-offset {:x 4
                         :y 5}}
         (canvas/drag-payload
          (assoc test-state
                 :selected-mask-tile-items
                 [{:tile :edge-n
                   :offset {:x 0
                            :y 0}}
                  {:tile :edge-e
                   :offset {:x 4
                            :y 5}}])
          {:start-position {:x 14
                            :y 15}}
          {}))))
