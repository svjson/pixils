(ns tilemap-editor.view.terrains.layout-test
  (:require proof.core
            [pixils.ui :as ui]
            [tilemap-editor.view.terrains.layout :as layout]))


;; tilemap-editor.view.terrains.layout/make

(deftest make/uses-split-pane-with-narrow-left-side
  (let [split-pane (head (layout/make))]
    (is (= 'ui/split-pane (:mode split-pane)))
    (is (= :x (-> split-pane :state :axis)))
    (is (= 0.26 (-> split-pane :state :split)))))

(deftest make/includes-stamp-tile-drag-preview
  (let [children (layout/make)
        preview (nth children 1)]
    (is (= 'terrain-stamp-tile-drag-preview (:mode preview)))))

(deftest make/groups-view-inputs-by-ownership
  (let [state (-> (layout/make) head :state)]
    (is (= {:terrain-sets (ui/project-state :terrain-sets)
            :rulesets (ui/project-state :rulesets)
            :transitions (ui/project-state :terrain-transitions)}
           (:subject state)))
    (is (= {:tilesets (ui/project-state :tilesets)
            :property-sets (ui/project-state :property-sets)
            :mask-sets (ui/project-state :mask-sets)
            :layer-profiles (ui/project-state :layer-profiles)}
           (:reference-data state)))
    (is (= {:layers (ui/project-state :layers)
            :layer-profile-id
            (ui/project-state :selected-layer-profile-id)}
           (:editor-context state)))
    (is (= {:selection
            {:terrain-set-index
             (ui/project-state :selected-terrain-set-index)
             :terrain-index (ui/project-state :selected-terrain-index)
             :ruleset-id (ui/project-state :selected-terrain-ruleset-id)
             :rule-id (ui/project-state :selected-terrain-rule-id)
             :transition-id
             (ui/project-state :selected-terrain-transition-id)
             :mask-set-index (ui/project-state :selected-mask-set-index)
             :mask-index (ui/project-state :selected-mask-index)}
            :tabs
            {:detail (ui/bind-state :terrain-detail-tab)
             :rule-editor (ui/bind-state :terrain-rule-editor-tab)
             :standard-output-picker
             (ui/bind-state :terrain-standard-output-picker-tab)}
            :rule-editor
            {:match-direction
             (ui/project-state :selected-terrain-rule-match-direction)
             :output-position
             (ui/project-state :selected-terrain-rule-output-position)
             :opposing (ui/project-state :terrain-standard-opposing)}
            :scroll
            {:rule-list-offset (ui/bind-state :terrain-rule-list-offset)}}
           (:workspace state)))
    (is (= {:rule-editor
            {:selected-tile (ui/project-state :terrain-rule-selected-tile)
             :selected-tile-output-tab
             (ui/project-state :terrain-rule-selected-tile-output-tab)
             :selected-mask (ui/project-state :terrain-rule-selected-mask)
             :mask-polarity (ui/project-state :terrain-rule-mask-polarity)}
            :stamp-tile-drag-preview
            (ui/project-state :terrain-stamp-tile-drag-preview)}
           (:interaction state)))
    (is (= {:rule-exclusive?
            (ui/project-state :selected-terrain-rule-exclusive?)
            :standard-role-cache-opposing
            (ui/project-state :terrain-standard-role-cache-opposing)
            :standard-role-slots
            (ui/project-state :terrain-standard-role-slots)
            :list-panel-disabled?
            (ui/project-state :terrain-list-panel-disabled?)
            :detail-panel-disabled?
            (ui/project-state :terrain-detail-panel-disabled?)}
           (:derived state)))))
