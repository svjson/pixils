(ns tilemap-editor.view.terrains.layout-test
  (:require proof.core
            [tilemap-editor.view.terrains.layout :as layout]))

(deftest terrain-set-list-panel-has_header_and_add_button
  (let [panel (layout/make-terrain-set-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrain Sets" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))))

(deftest terrain-set-list-rows-have_context_menu
  (let [row (layout/terrain-row-child 0 {:value 0 :label "Terrain Set"})
        menu-item (head (:items layout/terrain-set-context-menu))
        delete-item (nth (:items layout/terrain-set-context-menu) 1)]
    (is (= :terrain-set (-> row :state :context-kind)))
    (is (= "Rename Terrain Set" (:label menu-item)))
    (is (= :rename (-> menu-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest terrain-list-rows-have_delete_context_menu_item
  (let [row (layout/terrain-context-row-child 0 {:value 0 :label "Terrain"})
        delete-item (nth (:items layout/terrain-context-menu) 2)]
    (is (= :terrain (-> row :state :context-kind)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest terrain-list-panel-has_disabled_bound_add_button
  (let [panel (layout/make-terrain-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrains" (-> panel :state :title)))
    (is (= "+" (-> add-button :state :label)))
    (is (not (nil? (-> add-button :state :disabled?))))))

(deftest terrain-set-detail-editor-shows_identity_as_labels
  (let [children (layout/terrain-set-detail-editor-children)
        id-field (nth children 0)
        name-field (nth children 1)
        edit-button (nth children 2)]
    (is (= 'terrain-readonly-field (:mode id-field)))
    (is (= 'terrain-readonly-field (:mode name-field)))
    (is (= 'ui/button (:mode edit-button)))
    (is (= "Edit" (-> edit-button :state :label)))))

(deftest terrain-set-detail-editor-includes_terrain_unit_selector
  (let [children (layout/terrain-set-detail-editor-children)
        label (nth children 5)
        selector (nth children 6)]
    (is (= "Terrain unit" (-> label :state :value)))
    (is (= 'terrain-unit-selector (:mode selector)))))

(deftest terrain-set-detail-editor-includes_property_assignment_and_values
  (let [children (layout/terrain-set-detail-editor-children)
        assignment (nth children 7)
        values (nth children 8)]
    (is (= 'property-set-assignment-list (:mode assignment)))
    (is (= "Terrain Set Properties" (-> values :state :title)))))

(deftest terrain-identity-row-does_not_render_base_tile_dropdown
  (let [children (layout/terrain-identity-row-children)]
    (is (= 1 (count children)))
    (is (= 'terrain-readonly-field (-> children head :mode)))))

(deftest terrain-value-detail-header-is_compact
  (let [header (layout/terrain-value-detail-header-child)
        children (:children header)
        preview (head children)
        summary (nth children 1)
        id-row (head (:children summary))
        name-row (nth (:children summary) 1)
        edit-button (nth (:children id-row) 2)]
    (is (= 48 (-> header :style :height)))
    (is (= 'terrain-preview (:mode preview)))
    (is (= "Id" (-> id-row :children head :state :value)))
    (is (= "Name" (-> name-row :children head :state :value)))
    (is (= 'ui/button (:mode edit-button)))
    (is (= "Edit" (-> edit-button :state :label)))))

(deftest terrain-base-tile-popup-uses_tile_picker_panel
  (let [children (layout/terrain-base-tile-popup-children {:x 10 :y 20})
        picker (head children)]
    (is (= 'terrain-base-tile-picker-scroll-pane (:mode picker)))
    (is (= :absolute (-> picker :style :position)))
    (is (= 10 (-> picker :style :left)))
    (is (= 20 (-> picker :style :top)))))

(deftest stamp-tile-picker-columns-tolerates_unlaid_out_bounds
  (is (= 1 (layout/terrain-stamp-tile-picker-columns nil)))
  (is (= {:x 0 :y 0 :w 32 :h 32}
         (layout/terrain-stamp-tile-picker-cell-rect 0 nil))))

(deftest stamp-tile-picker-content-height-grows_for_hidden_rows
  (is (= 100 (layout/terrain-stamp-tile-picker-content-height 7 3)))
  (is (= 100 (layout/terrain-stamp-tile-picker-content-height 8 3)))
  (is (> (layout/terrain-stamp-tile-picker-content-height 22 3)
         layout/terrain-stamp-tile-picker-height)))

(deftest terrain-rule-context-menu-includes_duplicate_command
  (let [items (:items layout/terrain-rule-context-menu)
        duplicate (nth items 1)]
    (is (= "Duplicate" (:label duplicate)))
    (is (= :duplicate (-> duplicate :payload :command)))))

(deftest terrain-rule-list-is_reorderable
  (is (= true (:reorderable? (:state (layout/terrain-rule-list-child {}))))))

(deftest terrain-rule-transform-menu-includes_flip_and_rotate_commands
  (let [items (:items layout/terrain-rule-transform-menu)]
    (is (= :flip-horizontal (-> (nth items 0) :payload :command)))
    (is (= :flip-vertical (-> (nth items 1) :payload :command)))
    (is (= :rotate-left (-> (nth items 3) :payload :command)))
    (is (= :rotate-right (-> (nth items 4) :payload :command)))))

(deftest terrain-rule-tile-picker-is_column_shaped
  (is (= 116 layout/terrain-stamp-tile-picker-width))
  (is (= 232 layout/terrain-stamp-tile-picker-height)))

(deftest terrain-rule-editor-tabs-keep_manual_editor_first
  (let [panel (layout/terrain-rule-editor-tabs-panel)
        tabs (-> panel :state :tabs)]
    (is (= :rules (-> tabs head :id)))
    (is (= "Rule Editor" (-> tabs head :label)))
    (is (= 'terrain-rule-manual-editor (-> tabs head :child :mode)))
    (is (= :setups (-> tabs (nth 1) :id)))
    (is (= "Semantic Roles" (-> tabs (nth 1) :label)))
    (is (= 'terrain-standard-setup-editor (-> tabs (nth 1) :child :mode)))))

(deftest terrain-standard-output-picker-tabs_include_tiles_and_masks
  (let [panel (layout/terrain-standard-output-picker-tabs-panel)
        tabs (-> panel :state :tabs)]
    (is (= :tiles (-> tabs head :id)))
    (is (= "Tiles" (-> tabs head :label)))
    (is (= 'terrain-stamp-tile-picker-scroll-pane
           (-> tabs head :child :mode)))
    (is (= :masks (-> tabs (nth 1) :id)))
    (is (= "Masks" (-> tabs (nth 1) :label)))
    (is (= 'terrain-standard-mask-picker
           (-> tabs (nth 1) :child :mode)))))

(deftest terrain-detail-tabs_keep_existing_tabs_before_transitions
  (let [panel (layout/terrain-detail-tabs-child false)
        tabs (-> panel :state :tabs)]
    (is (= :terrain-set (-> tabs head :id)))
    (is (= "Terrain Set" (-> tabs head :label)))
    (is (= :terrain (-> tabs (nth 1) :id)))
    (is (= "Terrain" (-> tabs (nth 1) :label)))
    (is (not (nil? (-> tabs (nth 1) :child :state :mask-sets))))
    (is (not (nil? (-> tabs (nth 1) :child :state
                       :terrain-rule-selected-mask))))
    (is (= :transitions (-> tabs (nth 2) :id)))
    (is (= "Transitions" (-> tabs (nth 2) :label)))
    (is (= 'terrain-transition-editor
           (-> tabs (nth 2) :child :mode)))))

(deftest terrain-transition-editor_has_transition_summary_contract
  (let [panel (layout/terrain-detail-tabs-child false)
        transition-tab (nth (-> panel :state :tabs) 2)
        child (:child transition-tab)
        field (layout/terrain-transition-summary-field "Recipes" 2)]
    (is (= 'terrain-transition-editor (:mode child)))
    (is (not (nil? (-> child :state :mask-sets))))
    (is (nil? (-> child :state :selected-mask-set-index)))
    (is (nil? (-> child :state :selected-mask-index)))
    (is (not (nil? (-> child :state :terrain-transitions))))
    (is (= "Recipes" (-> field :children head :state :value)))
    (is (= 2 (-> field :children (nth 1) :state :value)))))

(deftest mask-set-list-rows-have_context_menu
  (let [row (layout/mask-set-row-child 0 {:value :soft-edge
                                          :label "Soft Edge"})
        rename-item (head (:items layout/mask-set-context-menu))
        delete-item (nth (:items layout/mask-set-context-menu) 1)]
    (is (= 'mask-set-row (:mode row)))
    (is (= "Rename Mask Set" (:label rename-item)))
    (is (= :rename (-> rename-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest mask-set-list-child-renders_current_mask_sets
  (let [list-box (layout/mask-set-list-child [{:id :soft-edge
                                               :label "Soft Edge"}]
                                             0)]
    (is (= [{:value :soft-edge
             :label "Soft Edge"}]
           (-> list-box :state :options)))
    (is (= [0] (-> list-box :state :selected-indices)))))

(deftest mask-list-rows-have_context_menu
  (let [row (layout/mask-row-child 0 {:value 0
                                      :label "North"})
        rename-item (head (:items layout/mask-context-menu))
        delete-item (nth (:items layout/mask-context-menu) 1)]
    (is (= 'mask-row (:mode row)))
    (is (= "Rename Mask" (:label rename-item)))
    (is (= :rename (-> rename-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

(deftest mask-list-child-renders_current_masks
  (let [list-box (layout/mask-list-child {:masks [{:id :n
                                                   :label "North"}]}
                                         0)]
    (is (= [{:value 0
             :label "North"}]
           (-> list-box :state :options)))
    (is (= [0] (-> list-box :state :selected-indices)))))

(deftest terrain-standard-mask-row-drag-payload-identifies_mask
  (let [payload (layout/terrain-standard-mask-drag-payload
                 {:value {:mask-set :soft-edge
                          :mask :north}
                  :label "North"}
                 {}
                 {})]
    (is (= :terrain-rule/mask-output (:kind payload)))
    (is (= {:mask-set :soft-edge
            :mask :north}
           (:mask payload)))))

(deftest terrain-standard-mask-list-scopes_options_to_selected_terrain
  (let [list-box (layout/terrain-standard-mask-list-child
                  {:terrain-sets [{:id :overworld
                                   :terrains [{:id :grass
                                               :transition-mask-set
                                               :soft-edge}]}]
                   :selected-terrain-set-index 0
                   :selected-terrain-index 0
                   :mask-sets [{:id :soft-edge
                                :masks [{:id :north
                                         :label "North"}]}
                               {:id :hard-edge
                                :masks [{:id :south
                                         :label "South"}]}]})]
    (is (= [{:value {:mask-set :soft-edge
                     :mask :north}
             :label "North"}]
           (-> list-box :state :options)))))

(deftest mask-definition-editor-exposes_source_controls
  (let [children (layout/mask-definition-editor-children)
        source-row (nth children 3)
        tileset-row (nth children 4)
        tile-row (nth children 5)
        tiles-label (nth children 6)
        item-list (nth children 7)]
    (is (= "Mask" (-> children head :state :value)))
    (is (= "Source" (-> source-row :children head :state :value)))
    (is (= 'mask-source-type-selector
           (-> source-row :children (nth 1) :mode)))
    (is (= "Tileset" (-> tileset-row :children head :state :value)))
    (is (= 'mask-source-tileset-selector
           (-> tileset-row :children (nth 1) :mode)))
    (is (= "Tile" (-> tile-row :children head :state :value)))
    (is (= 'mask-source-tile-selector
           (-> tile-row :children (nth 1) :children head :mode)))
    (is (= "Tiles" (-> tiles-label :state :value)))
    (is (= 'mask-tile-item-list (:mode item-list)))))

(deftest terrain-standard-setup-editor-exposes_role_slots
  (let [slot (layout/terrain-standard-role-slot-child :island-3x3 :n "N")]
    (is (= 'terrain-standard-role-slot (:mode slot)))
    (is (= :island-3x3 (-> slot :state :setup-id)))
    (is (= :n (-> slot :state :role-id)))))

(deftest terrain-standard-setup-editor-includes_group_visibility_menu_button
  (let [items (:items layout/terrain-standard-setup-menu)
        panel (layout/terrain-standard-setup-panel-child
               {:id :island-3x3
                :label "Island"
                :matrix [[:nw]]})]
    (is (= :terrain/standard-setup-visibility-toggle
           (-> items head :action)))
    (is (= :toggle (-> items head :type)))
    (is (= [:option-state :island-3x3]
           (-> items head :selected-path)))
    (is (= 'terrain-standard-setup-panel (:mode panel)))
    (is (= :island-3x3 (-> panel :state :setup-id)))
    (is (= false (contains? (:state panel) :rulesets)))))

(deftest terrain-standard-opposing-menu-includes_terrain_toggles
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}
                                          {:id :water
                                           :label "Water"}
                                          {:id :sand
                                           :label "Sand"}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :terrain-standard-opposing {:terrain-in [:water]}}
        menu (layout/terrain-standard-opposing-menu state)
        option-state (layout/terrain-standard-opposing-menu-option-state state)]
    (is (= "None" (-> menu :items head :label)))
    (is (= "Any other" (-> menu :items (nth 1) :label)))
    (is (= "Water" (-> menu :items (nth 2) :label)))
    (is (= :toggle (-> menu :items (nth 2) :type)))
    (is (= :toggle-terrain
           (-> menu :items (nth 2) :payload :action)))
    (is (= [:option-state :water]
           (-> menu :items (nth 2) :selected-path)))
    (is (= true (:water option-state)))
    (is (= false (:sand option-state)))))

(deftest terrain-standard-setup-groups-use_wrapped_row_layout
  (let [content (layout/terrain-standard-setup-panel-groups-content-child)
        layout-style (-> content :style :layout)
        children (:children content)]
    (is (= :row (:direction layout-style)))
    (is (= :line (:wrap layout-style)))
    (is (= layout/terrain-standard-setup-panel-column-gap
           (:gap layout-style)))
    (is (= layout/terrain-standard-setup-panel-row-gap
           (:line-gap layout-style)))
    (is (= 7 (count children)))
    (is (= 'terrain-standard-setup-panel (-> children head :mode)))
    (is (= :island-3x3 (-> children head :state :setup-id)))
    (is (= :stumps (-> children (nth 6) :state :setup-id)))))

(deftest terrain-standard-role-markers-use_not_same_match_directions
  (is (= [:n]
         (layout/terrain-standard-role-marker-directions :n)))
  (is (= [:nw]
         (layout/terrain-standard-role-marker-directions :inner-nw)))
  (is (= [:n :w :e :s]
         (layout/terrain-standard-role-marker-directions :isolated-cardinal)))
  (is (= [:nw :ne :sw :se]
         (layout/terrain-standard-role-marker-directions :isolated-diagonal))))

(deftest terrain-standard-role-surround_markers_are_only_for_isolated_setup
  (is (= false
         (layout/terrain-standard-role-uses-surround-markers?
          {:setup-id :island-3x3
           :role-id :n})))
  (is (= false
         (layout/terrain-standard-role-uses-surround-markers?
          {:setup-id :inner-corners
           :role-id :inner-nw})))
  (is (= true
         (layout/terrain-standard-role-uses-surround-markers?
          {:setup-id :isolated
           :role-id :isolated-cardinal}))))

(deftest terrain-standard-role-surround_marker_layout_is_only_for_isolated_setup
  (is (= 40
         (layout/terrain-standard-role-slot-size :island-3x3)))
  (is (= 40
         (layout/terrain-standard-role-slot-size :inner-corners)))
  (is (= 66
         (layout/terrain-standard-role-slot-size :isolated)))
  (is (= {:x 0 :y 0 :w 40 :h 40}
         (layout/terrain-standard-role-tile-rect {:setup-id :island-3x3})))
  (is (= {:x 13 :y 13 :w 40 :h 40}
         (layout/terrain-standard-role-tile-rect {:setup-id :isolated}))))

(deftest terrain-standard-role-marker-rects_are_third_sized_and_edge_aligned
  (is (= {:x 13 :y 0 :w 40 :h 13}
         (layout/terrain-standard-role-marker-rect :n)))
  (is (= {:x 0 :y 13 :w 13 :h 40}
         (layout/terrain-standard-role-marker-rect :w)))
  (is (= {:x 53 :y 53 :w 13 :h 13}
         (layout/terrain-standard-role-marker-rect :se))))

(deftest terrain-stamp-grid-size-follows_terrain_unit
  (is (= {:w 32 :h 32}
         (layout/terrain-stamp-grid-size-for-unit {:w 1 :h 1})))
  (is (= {:w 66 :h 66}
         (layout/terrain-stamp-grid-size-for-unit {:w 2 :h 2}))))

(deftest terrain-stamp-grid-renders_two_by_two_max
  (let [row (layout/terrain-stamp-grid-row 0)]
    (is (= 2 (count (:children row))))))

(deftest terrain-rule-output-tileset-options-use_tileset_ids
  (is (= [{:value :water :label "Water"}
          {:value :roads :label "Roads"}]
         (layout/terrain-rule-output-tileset-options
          [{:id :water :label "Water"}
           {:id :roads :label "Roads"}]))))

(deftest terrain-workspace-uses_split_pane_with_narrow_left_side
  (let [split-pane (head (layout/terrain-definition-workspace-children))]
    (is (= 'ui/split-pane (:mode split-pane)))
    (is (= :x (-> split-pane :state :axis)))
    (is (= 0.26 (-> split-pane :state :split)))))

(deftest terrain-workspace-includes_stamp_tile_drag_preview
  (let [children (layout/terrain-definition-workspace-children)
        preview (nth children 1)]
    (is (= 'terrain-stamp-tile-drag-preview (:mode preview)))))
