(ns tilemap-editor.view.terrains.rules.panel-test
  (:require proof.core
            [tilemap-editor.view.terrains.rules.panel :as panel]))



;; tilemap-editor.view.terrains.rules.panel/make-tabs

(deftest make-tabs/places-the-manual-editor-before-semantic-roles
  (is (= [{:id :rules
           :label "Rule Editor"
           :mode 'terrain-rule-manual-editor}
          {:id :setups
           :label "Semantic Roles"
           :mode 'terrain-standard-setup-editor}]
         (for [tab (-> (panel/make-tabs) :state :tabs)]
           {:id (:id tab)
            :label (:label tab)
            :mode (-> tab :child :mode)}))))
