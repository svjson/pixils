(ns tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list-test
  (:require proof.core
            [tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list
             :as rule-list]))



;; tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list/context-menu

(deftest context-menu/includes-duplicate-command
  (is (= {:label "Duplicate"
          :action :terrain/rule-context-dummy
          :payload {:command :duplicate}}
         (nth (:items rule-list/context-menu) 1))))



;; tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list/make-list-box

(deftest make-list-box/enables-reordering
  (is (= {:options []
          :disabled? true
          :reorderable? true
          :force-selection? true}
         (select-keys (-> (rule-list/make-list-box {})
                          :state
                          :component)
                      [:options
                       :disabled?
                       :reorderable?
                       :force-selection?]))))
