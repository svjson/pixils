(ns tilemap-editor.view.terrains.interaction-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]
            [tilemap-editor.fixture.io.project :as project]
            [tilemap-editor.fixture.main-window :as main-window]
            [tilemap-editor.fixture.view.terrains.rule-list :as rule-list]
            [tilemap-editor.fixture.view.terrains.terrains-tab :as terrains-tab]
            [tilemap-editor.model.workbook :as editor-workbook]))

(deftest interaction/terrain-lists-render-select-and-open-context-menu
  (s/given
    (project/write! :terrain-selection-lists
                    {:terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :terrains [{:id :grass
                                                 :label "Grass"}
                                                {:id :water
                                                 :label "Water"}]}]})
    (main-window/open-project! :terrain-selection-lists))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (px/render! app)
    (let [rows (px/find-views app "pixils/form-selection-list-item")
          overworld (find-first rows
                                (fn [row]
                                  (= "Overworld" (-> row :ui-state :label))))
          grass (find-first rows
                            (fn [row]
                              (= "Grass" (-> row :ui-state :label))))
          water (find-first rows
                            (fn [row]
                              (= "Water" (-> row :ui-state :label))))]
      (is (some? overworld))
      (is (some? grass))
      (is (some? water))
      (px/click! app water)
      (px/update! app)
      (is (= 1 (:selected-terrain-index (px/active-state app))))
      (is (= true
             (-> (px/find-view-containing
                  app
                  "pixils/form-selection-list-item"
                  "Water")
                 :ui-state
                 :selected)))
      (px/mouse-click-in! app water 5 5 :right)
      (px/update! app)
      (px/render! app)
      (is (= "ui/context-menu" (px/active-mode-name app)))
      (let [rename-item (px/find-view-containing app
                                                      "ui/popup-menu-item"
                                                      "Rename Terrain")]
        (is (some? rename-item))
        (px/click! app rename-item)
        (px/update! app)
        (px/render! app))
      {:dialog-mode (px/active-mode-name app)
       :dialog-value (:value (px/active-state app))
       :dialog-field-ids
       (for [field (px/find-views app "pixils/form-field")]
         (-> field :state :field-id))}))

  (s/then [result]
    (is (= {:dialog-mode "ui/dialog-frame"
            :dialog-value {:id :water
                           :label "Water"}
            :dialog-field-ids [:id :label]}
           result))
    (project/cleanup! :terrain-selection-lists)))

(deftest interaction/terrain-rule-add-button-creates-visible-rule
  (s/given
    (project/write! :terrain-rule
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :char "g"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}
                                         {:id :water-fill
                                          :name "Water Fill"
                                          :char "w"
                                          :type :color
                                          :color {:r 0 :g 0 :b 255}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}
                                                {:id :water
                                                 :label "Water"
                                                 :tile :water-fill}]}]
                     :rulesets []
                     :layer-profiles [{:id :default
                                       :label "Default"
                                       :layers [{:id :scene/terrain
                                                 :label "Terrain Source"
                                                 :kind :terrain
                                                 :data-kind :terrain
                                                 :terrain-set :overworld}
                                                {:id :scene/terrain-visuals
                                                 :label "Terrain Visuals"
                                                 :kind :tile
                                                 :data-kind :tile-ref
                                                 :tileset :terrain}]}]
                     :tilemap {:width 2
                               :height 2
                               :tile-size 16
                               :layer-profile :default
                               :layers []}})
    (let [app (main-window/open-project-with-buffer! :terrain-rule 1200 600)]
      (main-window/is-open? app)
      app))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (terrains-tab/switch-detail-to! app :detail/terrain {:by :mouse/click})
    (terrains-tab/add-rule! app {:by :mouse/click})
    (terrains-tab/selected-rule-is? app :rule)
    (terrains-tab/set-selected-rule-exclusive! app true {:by :mouse/click})
    (terrains-tab/match-cell-has-tile? app :match/center :grass-fill)

    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/rule-match-is? app :n :same)
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/rule-match-is? app :n :none)
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/rule-match-is? app :n :any-terrain)
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/left-click})
    (terrains-tab/rule-match-is? app :n :none)
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/rule-match-is? app :n :not-same)
    (terrains-tab/cycle-match-cell! app :n {:by :mouse/right-click})
    (terrains-tab/rule-match-is? app :n {:terrain :water})

    (terrains-tab/drag-stamp-tile! app :tile/water-fill :stamp/origin {:by :mouse/drag})
    (terrains-tab/selected-stamp-tile-is? app :water-fill)
    (terrains-tab/output-tiles-are? app [[:water-fill]])
    (terrains-tab/drag-stamp-tile! app :tile/none :stamp/origin {:by :mouse/drag})
    app)

  (s/then [app]
    (terrains-tab/output-tiles-are? app [[nil]])
    (project/cleanup! :terrain-rule)))

(deftest interaction/terrain-rule-context-menu-duplicates-rule
  (s/given
    (project/write! :terrain-rule-duplicate
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}]}]
                     :rulesets [{:id :overworld-rules
                                 :kind :terrain-stamp
                                 :terrain-set :overworld
                                 :rules [{:id :edge
                                          :label "Edge"
                                          :terrain :grass
                                          :match {:nw :ignore
                                                  :n :ignore
                                                  :ne :ignore
                                                  :w :ignore
                                                  :e :ignore
                                                  :sw :ignore
                                                  :s :ignore
                                                  :se :ignore}
                                          :output {:anchor {:x 0 :y 0}
                                                   :layers []}}]}]})
    (main-window/open-project! :terrain-rule-duplicate))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (terrains-tab/switch-detail-to! app :detail/terrain {:by :mouse/click})
    (rule-list/open-context-menu! app :edge {:by :mouse/right-click})
    (main-window/choose-menu-item! app
                                   :menu-item/duplicate
                                   {:by :mouse/click})
    app)

  (s/then [app]
    (rule-list/rule-ids-are? app [:edge :edge-copy])
    (terrains-tab/selected-rule-is? app :edge-copy)
    (project/cleanup! :terrain-rule-duplicate)))

(deftest interaction/terrain-base-tile-picker-records-selected-tile
  (s/given
    (project/write! :terrain-base-tile
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}
                                         {:id :water-fill
                                          :name "Water Fill"
                                          :type :color
                                          :color {:r 0 :g 0 :b 255}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}]}]})
    (main-window/open-project! :terrain-base-tile))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (terrains-tab/switch-detail-to! app :detail/terrain {:by :mouse/click})
    (terrains-tab/change-base-tile! app :water-fill {:by :mouse/click})
    app)

  (s/then [app]
    (terrains-tab/terrain-base-tile-is? app
                                        :overworld
                                        :grass
                                        :water-fill)
    (project/cleanup! :terrain-base-tile)))

(deftest interaction/terrain-property-editor-records-sparse-overrides
  (s/given
    (project/write! :terrain-property
                    {:property-sets
                     [{:id :movement
                       :label "Movement"
                       :properties [{:id :walkable
                                     :label "Walkable"
                                     :type :enum
                                     :values [:yes :no]
                                     :default :yes}]}]
                     :tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :property-sets [:movement]
                                     :properties {:walkable :yes}
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}]}]})
    (main-window/open-project! :terrain-property))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (terrains-tab/switch-detail-to! app :detail/terrain {:by :mouse/click})
    (terrains-tab/select-enum-property-value! app
                                               :walkable
                                               :no
                                               {:by :mouse/click})
    (let [changed-terrain (terrains-tab/terrain-by-id app
                                                      :overworld
                                                      :grass)
          undo-label (editor-workbook/undo-label (px/active-state app))
          app (terrains-tab/select-enum-property-value! app
                                                        :walkable
                                                        :yes
                                                        {:by :mouse/click})
          inherited-terrain (terrains-tab/terrain-by-id app
                                                        :overworld
                                                        :grass)
          app (px/press-modified-key! app :left-ctrl :z)
          undone-terrain (terrains-tab/terrain-by-id app
                                                     :overworld
                                                     :grass)]
      {:changed-terrain changed-terrain
       :undo-label undo-label
       :inherited-terrain inherited-terrain
       :undone-terrain undone-terrain}))

  (s/then [{:keys [changed-terrain
                   undo-label
                   inherited-terrain
                   undone-terrain]}]
    (is (= {:walkable :no} (:properties changed-terrain)))
    (is (= "Change terrain property" undo-label))
    (is (= false (contains? inherited-terrain :properties)))
    (is (= {:walkable :no} (:properties undone-terrain)))
    (project/cleanup! :terrain-property)))

(deftest terrain-standard-setup-slot-creates-visible-rule
  (s/given
    (project/write! :terrain-standard-rule
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :char "g"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}
                                         {:id :water-fill
                                          :name "Water Fill"
                                          :char "w"
                                          :type :color
                                          :color {:r 0 :g 0 :b 255}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}
                                                {:id :water
                                                 :label "Water"
                                                 :tile :water-fill}]}]
                     :rulesets []
                     :layer-profiles [{:id :default
                                       :label "Default"
                                       :layers [{:id :scene/terrain
                                                 :label "Terrain Source"
                                                 :kind :terrain
                                                 :data-kind :terrain
                                                 :terrain-set :overworld}
                                                {:id :scene/terrain-visuals
                                                 :label "Terrain Visuals"
                                                 :kind :tile
                                                 :data-kind :tile-ref
                                                 :tileset :terrain}]}]
                     :tilemap {:width 2
                               :height 2
                               :tile-size 16
                               :layer-profile :default
                               :layers []}})
    (let [app (main-window/open-project! :terrain-standard-rule)]
      (main-window/is-open? app)
      app))

  (s/when [app]
    (main-window/switch-to! app :tab/terrains {:by :mouse/click})
    (terrains-tab/switch-detail-to! app :detail/terrain {:by :mouse/click})
    (terrains-tab/switch-rule-editor-to! app :setups {:by :mouse/click})
    (terrains-tab/drag-standard-role-tile! app
                                           :tile/water-fill
                                           :n
                                           {:by :mouse/drag})
    app)

  (s/then [app]
    (terrains-tab/switch-rule-editor-to! app :rules {:by :mouse/click})
    (terrains-tab/selected-rule-is? app :rule)
    (terrains-tab/rule-match-is? app :n :none)
    (terrains-tab/rule-match-is? app :s :same)
    (terrains-tab/output-tiles-are? app [[:water-fill]])
    (project/cleanup! :terrain-standard-rule)))

(deftest interaction/terrain-standard-setup-overlay-tab-creates-transition-overlay-rule
  (s/given
    (project/write! :terrain-standard-overlay-rule
                    {:tilesets [{:id :terrain
                                 :label "Terrain"
                                 :tile-size 16
                                 :tiles [{:id :grass-fill
                                          :name "Grass Fill"
                                          :char "g"
                                          :type :color
                                          :color {:r 0 :g 255 :b 0}}
                                         {:id :water-fill
                                          :name "Water Fill"
                                          :char "w"
                                          :type :color
                                          :color {:r 0 :g 0 :b 255}}]}]
                     :terrain-sets [{:id :overworld
                                     :label "Overworld"
                                     :tileset :terrain
                                     :terrains [{:id :grass
                                                 :label "Grass"
                                                 :tile :grass-fill}
                                                {:id :water
                                                 :label "Water"
                                                 :tile :water-fill}]}]
                     :rulesets []
                     :layer-profiles [{:id :default
                                       :label "Default"
                                       :layers [{:id :scene/terrain
                                                 :label "Terrain Source"
                                                 :kind :terrain
                                                 :data-kind :terrain
                                                 :terrain-set :overworld}
                                                {:id :scene/terrain-visuals
                                                 :label "Terrain Visuals"
                                                 :kind :tile
                                                 :data-kind :tile-ref
                                                 :tileset :terrain}]}]
                     :tilemap {:width 2
                               :height 2
                               :tile-size 16
                               :layer-profile :default
                               :layers []}})
    (let [app (main-window/open-project! :terrain-standard-overlay-rule)]
