(ns tilemap-editor.view.terrains.selection-column.list-test
  (:require proof.core
            [tilemap-editor.view.terrains.selection-column.list :as list]))



;; tilemap-editor.view.terrains.selection-column.list/terrain-set-list-child

(deftest terrain-set-list-child/rows-have-context-menu
  (let [row (list/terrain-row-child 0 {:value 0 :label "Terrain Set"})
        menu-item (head (:items list/terrain-set-context-menu))
        delete-item (nth (:items list/terrain-set-context-menu) 1)]
    (is (= :terrain-set (-> row :state :context-kind)))
    (is (= "Rename Terrain Set" (:label menu-item)))
    (is (= :rename (-> menu-item :payload :command)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))


;; tilemap-editor.view.terrains.selection-column.list/terrain-list-child

(deftest terrain-list-child/rows-have-delete-context-menu-item
  (let [row (list/terrain-context-row-child 0 {:value 0 :label "Terrain"})
        delete-item (nth (:items list/terrain-context-menu) 2)]
    (is (= :terrain (-> row :state :context-kind)))
    (is (= "Delete" (:label delete-item)))
    (is (= :delete (-> delete-item :payload :command)))))

