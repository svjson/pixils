(ns tilemap-editor.view.terrains.selection-column.column-test
  (:require proof.core
            [tilemap-editor.view.terrains.selection-column.column :as column]))



;; tilemap-editor.view.terrains.selection-column.column/make-terrain-set-list-panel

(deftest make-terrain-set-list-panel/has-header-and-add-button
  (let [panel (column/make-terrain-set-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrain Sets" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))))



;; tilemap-editor.view.terrains.selection-column.column/make-terrain-list-panel

(deftest make-terrain-list-panel/projects-disabled-state-to-add-button
  (let [panel (column/make-terrain-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrains" (-> panel :state :title)))
    (is (= "+" (-> add-button :state :label)))
    (is (some? (-> add-button :state :disabled?)))))
