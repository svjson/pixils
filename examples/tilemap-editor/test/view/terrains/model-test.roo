(ns tilemap-editor.view.terrains.model-test
  (:require proof.core
            [tilemap-editor.view.terrains.model :as model]))

(deftest terrain-workspace-selects-first-available-set-and-terrain
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (= 0 (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-workspace-keeps-detail-enabled-without-terrains
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains []}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-workspace-selects-first-transition-for-selected-set
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains []}]
                :terrain-transitions [{:id :roads
                                       :terrain-set :overworld}
                                      {:id :caves
                                       :terrain-set :caves}]})]
    (is (= :roads (:selected-terrain-transition-id state)))))

(deftest terrain-workspace-keeps-selected-transition-when-valid
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains []}]
                :selected-terrain-transition-id :paths
                :terrain-transitions [{:id :roads
                                       :terrain-set :overworld}
                                      {:id :paths
                                       :terrain-set :overworld}]})]
    (is (= :paths (:selected-terrain-transition-id state)))))

(deftest terrain-transition-options-are-scoped-to-selected-terrain-set
  (is (= [{:value :roads
           :label "Roads"}]
         (model/transition-options
          {:terrain-sets [{:id :overworld}
                          {:id :caves}]
           :selected-terrain-set-index 0
           :terrain-transitions [{:id :roads
                                  :label "Roads"
                                  :terrain-set :overworld}
                                 {:id :cave-path
                                  :label "Cave Path"
                                  :terrain-set :caves}]}))))

(deftest mask-set-options-use-labels-and-ids
  (is (= [{:value :soft-edge
           :label "Soft Edge"}
          {:value :hard-edge
           :label "hard-edge"}]
         (model/mask-set-options [{:id :soft-edge
                                   :label "Soft Edge"}
                                  {:id :hard-edge}]))))

(deftest terrain-transition-mask-set-options-include-none
  (is (= [{:value :none
           :label "None"}
          {:value :soft-edge
           :label "Soft Edge"}]
         (model/terrain-transition-mask-set-options
          [{:id :soft-edge
            :label "Soft Edge"}]))))

(deftest selected-terrain-transition-mask-set-can-be-set
  (let [state (model/set-selected-terrain-transition-mask-set
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :mask-sets [{:id :soft-edge}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               :soft-edge)]
    (is (= :soft-edge
           (get-in state
                   [:terrain-sets 0 :terrains 0 :transition-mask-set])))
    (is (= 1
           (model/selected-terrain-transition-mask-set-option-index
            state)))))

(deftest terrain-mask-options-scope-to-selected-terrain-mask-set
  (is (= [{:value {:mask-set :soft-edge
                   :mask :north}
           :label "North"}]
         (model/terrain-mask-options-for-selected-terrain
          {:terrain-sets [{:id :overworld
                           :terrains [{:id :grass
                                       :transition-mask-set :soft-edge}]}]
           :mask-sets [{:id :soft-edge
                        :masks [{:id :north
                                 :label "North"}]}
                       {:id :hard-edge
                        :masks [{:id :south
                                 :label "South"}]}]
           :selected-terrain-set-index 0
           :selected-terrain-index 0}))))

(deftest terrain-workspace-selects-first-available-mask-set
  (let [state (model/derive-terrain-workspace-state
               {:mask-sets [{:id :soft-edge}
                            {:id :hard-edge}]})]
    (is (= 0 (:selected-mask-set-index state)))))

(deftest terrain-workspace-selects-first-available-mask
  (let [state (model/derive-terrain-workspace-state
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :n}
                                     {:id :s}]}]
                :selected-mask-set-index 0})]
    (is (= 0 (:selected-mask-index state)))))

(deftest mask-set-creation-adds-and-selects-new-set
  (let [state (model/add-mask-set {:mask-sets []})]
    (is (= :mask-set (get-in state [:mask-sets 0 :id])))
    (is (= "Mask set" (get-in state [:mask-sets 0 :label])))
    (is (= [] (get-in state [:mask-sets 0 :masks])))
    (is (= 0 (:selected-mask-set-index state)))))

(deftest mask-set-creation-can-use-confirmed-identity
  (let [state (model/add-mask-set-with-id
               {:mask-sets [{:id :soft-edge}]}
               "soft-edge"
               "Soft Edge Copy")]
    (is (= :soft-edge-2 (get-in state [:mask-sets 1 :id])))
    (is (= "Soft Edge Copy" (get-in state [:mask-sets 1 :label])))
    (is (= 1 (:selected-mask-set-index state)))))

(deftest mask-set-rename-updates-transition-references
  (let [state (model/set-selected-mask-set-label
               (model/set-selected-mask-set-id
                {:mask-sets [{:id :soft-edge
                              :label "Soft Edge"}]
                 :terrain-sets [{:id :overworld
                                  :terrains [{:id :grass
                                              :transition-mask-set :soft-edge}]}]
                 :terrain-transitions [{:id :shore
                                        :mask-set :soft-edge}]
                 :rulesets [{:id :rules
                              :rules [{:id :edge
                                       :output {:layers
                                                [{:transition-masks
                                                  [[{:mask-set :soft-edge
                                                     :mask :north}]]}]}}]}]
                 :selected-mask-set-index 0}
                "feathered-edge")
               "Feathered Edge")]
    (is (= :feathered-edge (get-in state [:mask-sets 0 :id])))
    (is (= "Feathered Edge" (get-in state [:mask-sets 0 :label])))
    (is (= :feathered-edge
           (get-in state [:terrain-transitions 0 :mask-set])))
    (is (= :feathered-edge
           (get-in state
                   [:terrain-sets 0 :terrains 0 :transition-mask-set])))
    (is (= :feathered-edge
           (get-in state
                   [:rulesets 0 :rules 0 :output :layers 0
                    :transition-masks 0 0 :mask-set])))))

(deftest mask-set-delete-clears-transition-references
  (let [state (model/delete-selected-mask-set
               {:mask-sets [{:id :soft-edge}
                            {:id :hard-edge}]
                :terrain-sets [{:id :overworld
                                 :terrains [{:id :grass
                                             :transition-mask-set :soft-edge}]}]
                :terrain-transitions [{:id :shore
                                       :mask-set :soft-edge}
                                      {:id :cliff
                                       :mask-set :hard-edge}]
                :rulesets [{:id :rules
                             :rules [{:id :edge
                                      :output {:layers
                                               [{:transition-masks
                                                 [[{:mask-set :soft-edge
                                                    :mask :north}]]}]}}]}]
                :selected-mask-set-index 0})]
    (is (= [:hard-edge] (map (:mask-sets state) :id)))
    (is (nil? (get-in state [:terrain-transitions 0 :mask-set])))
    (is (= :hard-edge (get-in state [:terrain-transitions 1 :mask-set])))
    (is (nil? (get-in state
                      [:terrain-sets 0 :terrains 0 :transition-mask-set])))
    (is (nil? (get-in state
                      [:rulesets 0 :rules 0 :output :layers 0
                       :transition-masks 0 0 :mask-set])))
    (is (= 0 (:selected-mask-set-index state)))))

(deftest mask-options-use-labels-and-ids
  (is (= [{:value 0
           :label "North"}
          {:value 1
           :label "s"}]
         (model/mask-options {:masks [{:id :n
                                       :label "North"}
                                      {:id :s}]}))))

(deftest mask-creation-adds-to-selected-mask-set
  (let [state (model/add-mask {:mask-sets [{:id :soft-edge
                                            :masks []}]
                               :selected-mask-set-index 0})]
    (is (= :mask (get-in state [:mask-sets 0 :masks 0 :id])))
    (is (= "Mask" (get-in state [:mask-sets 0 :masks 0 :label])))
    (is (= :tile-composition
           (get-in state [:mask-sets 0 :masks 0 :source :type])))
    (is (= [] (get-in state [:mask-sets 0 :masks 0 :source :tiles])))
    (is (= 0 (:selected-mask-index state)))))

(deftest mask-set-creation-defaults-to-one-tile-mask-size
  (let [state (model/add-mask-set {:mask-sets []})]
    (is (= {:w 16
            :h 16}
           (get-in state [:mask-sets 0 :mask-size])))
    (is (= {:w 16
            :h 16}
           (model/selected-mask-set-size state)))))

(deftest mask-set-size-update-changes-selected-mask-dimensions
  (let [state (-> {:mask-sets [{:id :soft-edge
                                :masks []}]
                   :selected-mask-set-index 0}
                  (model/set-selected-mask-set-size :w 32)
                  (model/set-selected-mask-set-size :h 24))]
    (is (= {:w 32
            :h 24}
           (get-in state [:mask-sets 0 :mask-size])))
    (is (= {:w 32
            :h 24}
           (model/selected-mask-set-size state)))))

(deftest mask-creation-can-use-confirmed-identity
  (let [state (model/add-mask-with-id
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :mask}]}]
                :selected-mask-set-index 0}
               "mask"
               "Mask Copy")]
    (is (= :mask-2 (get-in state [:mask-sets 0 :masks 1 :id])))
    (is (= "Mask Copy" (get-in state [:mask-sets 0 :masks 1 :label])))
    (is (= 1 (:selected-mask-index state)))))

(deftest mask-duplicate-inserts-copy-after-selected-mask
  (let [state (model/duplicate-selected-mask-with-id
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :north
                                      :label "North"
                                      :source {:type :tile-composition
                                               :tileset :terrain
                                               :tiles [{:tile :edge-n
                                                        :offset {:x 1
                                                                 :y -2}}]}}
                                     {:id :south
                                      :label "South"}]}]
                :selected-mask-set-index 0
                :selected-mask-index 0}
               "north-soft"
               "North Soft")
        masks (get-in state [:mask-sets 0 :masks])
        duplicate (nth masks 1)]
    (is (= [:north :north-soft :south]
           (map masks :id)))
    (is (= "North Soft" (:label duplicate)))
    (is (= {:type :tile-composition
            :tileset :terrain
            :tiles [{:tile :edge-n
                     :offset {:x 1
                              :y -2}}]}
           (:source duplicate)))
    (is (= 1 (:selected-mask-index state)))))

(deftest mask-duplicate-deduplicates-default-id-and-name
  (let [state (model/duplicate-selected-mask-with-id
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :north
                                      :label "North"}
                                     {:id :north-copy
                                      :label "North Copy"}]}]
                :selected-mask-set-index 0
                :selected-mask-index 0}
               nil
               nil)
        duplicate (nth (get-in state [:mask-sets 0 :masks]) 1)]
    (is (= :north-copy-2 (:id duplicate)))
    (is (= "North Copy 2" (:label duplicate)))))

(deftest mask-rename-updates-selected-mask
  (let [state (model/set-selected-mask-label
               (model/set-selected-mask-id
                {:mask-sets [{:id :soft-edge
                              :masks [{:id :n
                                       :label "North"}]}]
                 :selected-mask-set-index 0
                 :selected-mask-index 0}
                "north-edge")
               "North Edge")]
    (is (= :north-edge (get-in state [:mask-sets 0 :masks 0 :id])))
    (is (= "North Edge" (get-in state [:mask-sets 0 :masks 0 :label])))))

(deftest mask-source-edits-update-selected-tile-composition
  (let [base-state {:mask-sets [{:id :soft-edge
                                 :masks [(model/make-mask [])]}]
                    :selected-mask-set-index 0
                    :selected-mask-index 0}
        state (model/set-selected-mask-tile-item-offset
               (model/add-selected-mask-tile
                (model/set-selected-mask-source-tileset base-state :terrain)
                :edge-n)
               0
               :x
               -2)
        state (model/set-selected-mask-tile-item-offset state 0 :y 3)]
    (is (= :terrain
           (get-in state [:mask-sets 0 :masks 0 :source :tileset])))
    (is (= [{:tile :edge-n
             :offset {:x -2
                      :y 3}}]
           (get-in state [:mask-sets 0 :masks 0 :source :tiles])))))

(deftest mask-source-can-replace-selected-composed-tile
  (let [state (model/set-selected-mask-tile-item-tile
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :north
                                      :source {:type :tile-composition
                                               :tileset :terrain
                                               :tiles [{:tile :edge-n
                                                        :offset {:x 2
                                                                 :y 3}}
                                                       {:tile :edge-e
                                                        :offset {:x -1
                                                                 :y 4}}]}}]}]
                :selected-mask-set-index 0
                :selected-mask-index 0
                :selected-mask-tile-item-index 1}
               :edge-w)]
    (is (= [{:tile :edge-n
             :offset {:x 2
                      :y 3}}
            {:tile :edge-w
             :offset {:x -1
                      :y 4}}]
           (get-in state [:mask-sets 0 :masks 0 :source :tiles])))))

(deftest mask-source-can-delete-composed-tile
  (let [state (model/delete-selected-mask-tile-item
               (model/add-selected-mask-tile
                {:mask-sets [{:id :soft-edge
                              :masks [(model/make-mask [])]}]
                 :selected-mask-set-index 0
                 :selected-mask-index 0}
                :edge-n)
               0)]
    (is (= [] (get-in state [:mask-sets 0 :masks 0 :source :tiles])))))

(deftest mask-delete-selects-neighbor
  (let [state (model/delete-selected-mask
               {:mask-sets [{:id :soft-edge
                             :masks [{:id :n}
                                     {:id :s}]}]
                :selected-mask-set-index 0
                :selected-mask-index 0})]
    (is (= [:s] (map (get-in state [:mask-sets 0 :masks]) :id)))
    (is (= 0 (:selected-mask-index state)))))

(deftest terrain-set-creation-adds-and-selects-new-set
  (let [state (model/add-terrain-set {:terrain-sets []})]
    (is (= :terrain-set (get-in state [:terrain-sets 0 :id])))
    (is (= "Terrain set" (get-in state [:terrain-sets 0 :label])))
    (is (= [] (get-in state [:terrain-sets 0 :terrains])))
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))))

(deftest terrain-set-creation-deduplicates-ids
  (let [state (model/add-terrain-set
               {:terrain-sets [{:id :terrain-set
                                :label "Terrain set"}]})]
    (is (= :terrain-set-2 (get-in state [:terrain-sets 1 :id])))))

(deftest terrain-set-creation-defaults-preview-tileset
  (let [state (model/add-terrain-set
               {:terrain-sets []
                :tilesets [{:id :overworld
                            :label "Overworld"}]})]
    (is (= :overworld (get-in state [:terrain-sets 0 :tileset])))))

(deftest terrain-set-creation-can-use-confirmed-identity
  (let [state (model/add-terrain-set-with-id
               {:terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               "overworld"
               "World Terrain")]
    (is (= :overworld-2 (get-in state [:terrain-sets 1 :id])))
    (is (= "World Terrain" (get-in state [:terrain-sets 1 :label])))
    (is (= 1 (:selected-terrain-set-index state)))))

(deftest terrain-creation-adds-to-selected-set
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains []}]
                :selected-terrain-set-index 0})]
    (is (= :terrain (get-in state [:terrain-sets 0 :terrains 0 :id])))
    (is (= "Terrain" (get-in state [:terrain-sets 0 :terrains 0 :label])))
    (is (= 0 (:selected-terrain-index state)))))

(deftest terrain-creation-deduplicates-ids
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :terrain
                                            :label "Terrain"}]}]
                :selected-terrain-set-index 0})]
    (is (= :terrain-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))))

(deftest terrain-creation-defaults-preview-tile
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :tileset :overworld-tiles
                                :terrains []}]
                :tilesets [{:id :overworld-tiles
                            :tiles [{:id :grass
                                     :name "Grass"}]}]
                :selected-terrain-set-index 0})]
    (is (= :grass (get-in state [:terrain-sets 0 :terrains 0 :tile])))))

(deftest terrain-creation-can-use-confirmed-identity
  (let [state (model/add-terrain-with-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :terrain
                                            :label "Terrain"}]}]
                :selected-terrain-set-index 0}
               "terrain"
               "Grassland")]
    (is (= :terrain-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))
    (is (= "Grassland" (get-in state [:terrain-sets 0 :terrains 1 :label])))
    (is (= 1 (:selected-terrain-index state)))))

(deftest terrain-duplicate-inserts-copy-after-selected-terrain
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"
                                            :tile :grass-tile}
                                           {:id :water
                                            :label "Water"
                                            :tile :water-tile}]}]
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :edge
                                     :label "Edge"
                                     :terrain :grass
                                     :exclusive? true
                                     :match {:n :same
                                             :s {:terrain :grass}}
                                     :output {:anchor {:x 1 :y 1}}}
                                    {:id :shore
                                     :terrain :water}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Meadow")
        terrains (get-in state [:terrain-sets 0 :terrains])
        duplicate (nth terrains 1)
        rules (get-in state [:rulesets 0 :rules])
        duplicated-rule (nth rules 1)]
    (is (= [:grass :meadow :water]
           (map terrains :id)))
    (is (= [:edge :edge-copy :shore]
           (map rules :id)))
    (is (= 1 (:selected-terrain-index state)))
    (is (nil? (:selected-terrain-rule-id state)))
    (is (= "Meadow" (:label duplicate)))
    (is (= :grass-tile (:tile duplicate)))
    (is (= "Edge Copy" (:label duplicated-rule)))
    (is (= :meadow (:terrain duplicated-rule)))
    (is (= true (:exclusive? duplicated-rule)))
    (is (= {:n :same
            :s {:terrain :meadow}}
           (:match duplicated-rule)))
    (is (= {:anchor {:x 1 :y 1}} (:output duplicated-rule)))))

(deftest terrain-duplicate-deduplicates-name-and-id
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}
                                           {:id :grass-copy
                                            :label "Grass Copy"}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Grass Copy")
        duplicate (nth (get-in state [:terrain-sets 0 :terrains]) 1)]
    (is (= :grass-copy-2 (:id duplicate)))
    (is (= "Grass Copy 2" (:label duplicate)))))

(deftest terrain-duplicate-can-use-requested-id
  (let [state (model/duplicate-selected-terrain-with-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Meadow"
               "custom-meadow")
        duplicate (nth (get-in state [:terrain-sets 0 :terrains]) 1)]
    (is (= :custom-meadow (:id duplicate)))
    (is (= "Meadow" (:label duplicate)))))

(deftest terrain-detail-label-changes-update-selected-records
  (let [state {:terrain-sets [{:id :overworld
                               :label "Overworld"
                               :terrains [{:id :grass
                                           :label "Grass"}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}
        state (model/set-selected-terrain-set-label state "World")
        state (model/set-selected-terrain-label state "Meadow")]
    (is (= "World" (get-in state [:terrain-sets 0 :label])))
    (is (= "Meadow" (get-in state [:terrain-sets 0 :terrains 0 :label])))))

(deftest terrain-set-id-change-updates-project-references
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :overworld
                                :label "Overworld"
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :brushes [{:id :brush
                           :pattern {:layers [{:data-kind :terrain
                                               :terrain-set :overworld
                                               :tiles [[:grass]]}]}}]
                :rulesets [{:id :grass-marching
                            :terrain-set :overworld}]}
               "world")]
    (is (= :world (get-in state [:terrain-sets 0 :id])))
    (is (= :world (get-in state [:layers 0 :terrain-set])))
    (is (= :world (get-in state [:layer-profiles 0 :layers 0 :terrain-set])))
    (is (= :world (get-in state [:brushes 0 :pattern :layers 0 :terrain-set])))
    (is (= :world (get-in state [:rulesets 0 :terrain-set])))))

(deftest terrain-set-id-change-updates-references-in-all-project-maps
  (let [state (model/set-selected-terrain-set-id
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 1
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default :layers []}]
                :selected-layer-index 0
                :terrain-sets [{:id :overworld
                                :label "Overworld"
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/one
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :maps [{:id :map/one
                        :label "One"
                        :width 1
                        :height 1
                        :layers [{:id :scene/one
                                  :data-kind :terrain
                                  :terrain-set :overworld}]}
                       {:id :map/two
                        :label "Two"
                        :width 1
                        :height 1
                        :layers [{:id :scene/two
                                  :data-kind :terrain
                                  :terrain-set :overworld}]}]}
               "world")]
    (is (= :world (get-in state [:layers 0 :terrain-set])))
    (is (= :world (get-in state [:maps 0 :layers 0 :terrain-set])))
    (is (= :world (get-in state [:maps 1 :layers 0 :terrain-set])))))

(deftest terrain-set-id-change-deduplicates-ids
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :world}
                               {:id :overworld}]
                :selected-terrain-set-index 1}
               "world")]
