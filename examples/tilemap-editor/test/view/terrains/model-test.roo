(deftest terrain-rule-transform-rotates_match_without_changing_stamp
  (let [state (model/transform-selected-rule
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :terrain :grass
                                     :match {:n :same
                                             :e {:terrain :water}
                                             :s :none}
                                     :output {:anchor {:x 0 :y 1}
                                              :layers [{:tileset :terrain
                                                        :tiles [[:a :b :c]
                                                                [:d :e :f]
                                                                [:g :h :i]]
                                                        :terrain-signatures
                                                        [[{:center :a}
                                                          {:center :b}
                                                          {:center :c}]
                                                         [{:center :d}
                                                          {:center :e}
                                                          {:center :f}]
                                                         [{:center :g}
                                                          {:center :h}
                                                          {:center :i}]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               :rotate-right)]
    (is (= [[:a :b :c]
            [:d :e :f]
            [:g :h :i]]
           (get-in state
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[{:center :a} {:center :b} {:center :c}]
            [{:center :d} {:center :e} {:center :f}]
            [{:center :g} {:center :h} {:center :i}]]
           (get-in state
                   [:rulesets
                    0
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures])))
    (is (= {:x 0 :y 1}
           (get-in state [:rulesets 0 :rules 0 :output :anchor])))
    (is (= :same (get-in state [:rulesets 0 :rules 0 :match :e])))
    (is (= {:terrain :water}
           (get-in state [:rulesets 0 :rules 0 :match :s])))
    (is (= :none (get-in state [:rulesets 0 :rules 0 :match :w])))))

(deftest terrain-rule-stamp-selection-falls_back_when_tile_is_not_in_output_tileset
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :tilesets [{:id :terrain
                           :tiles [{:id :grass-fill}
                                   {:id :shore}]}]
               :terrain-rule-selected-tile :old-tile
               :rulesets [{:id :overworld-rules
                           :terrain-set :overworld
                           :rules [{:id :rule
                                    :terrain :grass
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[nil nil nil]
                                                               [nil :grass-fill nil]
                                                               [nil nil nil]]}]}}]}]
               :selected-terrain-ruleset-id :overworld-rules
               :selected-terrain-rule-id :rule}]
    (is (= :grass-fill (model/selected-rule-stamp-tile state)))))

(deftest terrain-standard-role-tile-creates_raw_stamp_rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :water-edge}]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/source
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default
                :selected-terrain-set-index 0
               :selected-terrain-index 0}
               :island-3x3
               :n
               :none
               :water-edge)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= :overworld-rules (get-in state [:rulesets 0 :id])))
    (is (= :terrain-stamp (get-in state [:rulesets 0 :kind])))
    (is (= :scene/source (get-in state [:rulesets 0 :source-layer])))
    (is (= :rule (:id rule)))
    (is (= "Island N - None" (:label rule)))
    (is (= :grass (:terrain rule)))
    (is (= (model/terrain-standard-role-match :n :none) (:match rule)))
    (is (= true (:exclusive? rule)))
    (is (= :scene/visuals (get-in rule [:output :layers 0 :target-layer])))
    (is (= :terrain (get-in rule [:output :layers 0 :tileset])))
    (is (= [[:water-edge]]
           (get-in rule [:output :layers 0 :tiles])))
    (is (= :rule (:selected-terrain-rule-id state)))))

(deftest terrain-standard-role-tile-inserts_created_rule_before_less_specific_rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}
                                           {:id :sand
                                            :tile :sand-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :water-edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :broad-edge
                                     :terrain :grass
                                     :exclusive? false
                                     :match (model/terrain-standard-role-match
                                             :n
                                             :any-other)}
                                    {:id :later-rule
                                     :terrain :grass
                                     :match {:s :same}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :water
               :water-edge)
        rules (get-in state [:rulesets 0 :rules])]
    (is (= [:rule :broad-edge :later-rule] (map rules :id)))
    (is (= true (:exclusive? (nth rules 0))))
    (is (= false (:exclusive? (nth rules 1))))
    (is (= {:terrain :water}
           (get-in rules [0 :match :n])))))

(deftest terrain-standard-rule-labels_include_semantic_setup_name
  (let [outer-state (model/set-terrain-standard-role-tile
                     {:terrain-sets [{:id :overworld
                                      :tileset :terrain
                                      :terrains [{:id :grass
                                                  :tile :grass-fill}]}]
                      :tilesets [{:id :terrain
                                  :tiles [{:id :grass-fill}
                                          {:id :edge}]}]
                      :selected-terrain-set-index 0
                      :selected-terrain-index 0}
                     :island-3x3
                     :nw
                     :none
                     :edge)
        inner-state (model/set-terrain-standard-role-tile
                     {:terrain-sets [{:id :overworld
                                      :tileset :terrain
                                      :terrains [{:id :grass
                                                  :tile :grass-fill}]}]
                      :tilesets [{:id :terrain
                                  :tiles [{:id :grass-fill}
                                          {:id :inner}]}]
                      :selected-terrain-set-index 0
                      :selected-terrain-index 0}
                     :inner-corners
                     :inner-nw
                     :none
                     :inner)]
    (is (= "Island NW - None"
           (get-in outer-state [:rulesets 0 :rules 0 :label])))
    (is (= "Inner corner NW - None"
           (get-in inner-state [:rulesets 0 :rules 0 :label])))))

(deftest terrain-standard-setup-visibility-defaults_to_all_groups
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}]
    (is (= [:island-3x3
            :inner-corners
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids state)))
    (is (= true (model/terrain-standard-setup-visible? state :island-3x3)))
    (is (= true (model/terrain-standard-setup-visible? state :inner-corners)))
    (is (= true (model/terrain-standard-setup-visible? state :isolated)))
    (is (= true (model/terrain-standard-setup-visible? state :ring)))
    (is (= true (model/terrain-standard-setup-visible? state :forks-cardinal)))
    (is (= true (model/terrain-standard-setup-visible? state :forks-diagonal)))
    (is (= true (model/terrain-standard-setup-visible? state :stumps)))))

(deftest terrain-standard-setup-visibility-is_stored_per_terrain
  (let [state (model/set-selected-terrain-standard-setup-visible
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               :inner-corners
               false)
        water-state (assoc state :selected-terrain-index 1)]
    (is (= [:island-3x3
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (get-in state
                   [:terrain-sets 0 :terrains 0
                    :visible-terrain-standard-setups])))
    (is (= [:island-3x3
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids state)))
    (is (= [:island-3x3
            :inner-corners
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids water-state)))))

(deftest terrain-standard-isolated_roles_match_direction_sets
  (is (= {:nw :none
          :n :none
          :ne :none
          :w :none
          :e :none
          :sw :none
          :s :none
          :se :none}
         (model/terrain-standard-role-match :isolated-all :none)))
  (is (= {:nw :ignore
          :n :other-terrain
          :ne :ignore
          :w :other-terrain
          :e :other-terrain
          :sw :ignore
          :s :other-terrain
          :se :ignore}
         (model/terrain-standard-role-match :isolated-cardinal :any-other)))
  (is (= {:nw {:terrain :water}
          :n :ignore
          :ne {:terrain :water}
          :w :ignore
          :e :ignore
          :sw {:terrain :water}
          :s :ignore
          :se {:terrain :water}}
         (model/terrain-standard-role-match :isolated-diagonal :water))))

(deftest terrain-standard-island_corner_roles_include_inward_diagonal
  (is (= {:nw :ignore
          :n :none
          :ne :ignore
          :w :none
          :e :same
          :sw :ignore
          :s :same
          :se :same}
         (model/terrain-standard-role-match :nw :none)))
  (is (= {:nw :same
          :n :same
          :ne :ignore
          :w :same
          :e {:terrain :water}
          :sw :ignore
          :s {:terrain :water}
          :se :ignore}
         (model/terrain-standard-role-match :se :water))))

(deftest terrain-standard-ring_roles_match_bends_and_straights
  (let [setup (model/terrain-standard-setup :ring)]
    (is (= [:ring-bend-se
            :ring-straight-h
            :ring-bend-sw
            :ring-straight-v
            :ring-bend-ne
            :ring-bend-nw]
           (map (:roles setup) :id)))
    (is (= [[:ring-bend-se :ring-straight-h :ring-bend-sw]
            [:ring-straight-v nil nil]
            [:ring-bend-ne nil :ring-bend-nw]]
           (:matrix setup))))
  (is (= {:nw :ignore
          :n :none
          :ne :ignore
          :w :same
          :e :same
          :sw :ignore
          :s :none
          :se :ignore}
         (model/terrain-standard-role-match :ring-straight-h :none)))
  (is (= {:nw {:terrain :water}
          :n {:terrain :water}
          :ne {:terrain :water}
          :w {:terrain :water}
          :e :same
          :sw {:terrain :water}
          :s :same
          :se {:terrain :water}}
         (model/terrain-standard-role-match :ring-bend-se :water)))
  (is (= {:nw {:terrain :water}
          :n :same
          :ne {:terrain :water}
          :w :same
          :e {:terrain :water}
          :sw {:terrain :water}
          :s {:terrain :water}
          :se {:terrain :water}}
         (model/terrain-standard-role-match :ring-bend-nw :water))))

(deftest terrain-standard_cardinal_fork_roles_ignore_diagonals
  (is (= {:nw :ignore
          :n :same
          :ne :ignore
          :w :none
          :e :same
          :sw :ignore
          :s :same
          :se :ignore}
         (model/terrain-standard-role-match :fork-nes :none)))
  (is (= {:nw :ignore
          :n :same
          :ne :ignore
          :w :same
          :e :same
          :sw :ignore
          :s :same
          :se :ignore}
         (model/terrain-standard-role-match :fork-nesw :any-other))))

(deftest terrain-standard_diagonal_fork_roles_include_between_arm_diagonals
  (is (= {:nw :ignore
          :n :same
          :ne :same
          :w :other-terrain
          :e :same
          :sw :ignore
          :s :same
          :se :same}
         (model/terrain-standard-role-match :fork-diagonal-nes :any-other)))
  (is (= {:nw :ignore
          :n :same
          :ne :ignore
          :w :same
          :e :same
          :sw :ignore
          :s :same
          :se :ignore}
         (model/terrain-standard-role-match :fork-diagonal-nesw :water))))

(deftest terrain-standard-stump_roles_match_exactly_one_neighbor
  (is (= {:nw :none
          :n :none
          :ne :none
          :w :none
          :e :none
          :sw :none
          :s :same
          :se :none}
         (model/terrain-standard-role-match :stump-n :none)))
  (is (= {:nw {:terrain :water}
          :n {:terrain :water}
          :ne {:terrain :water}
          :w :same
          :e {:terrain :water}
          :sw {:terrain :water}
          :s {:terrain :water}
          :se {:terrain :water}}
         (model/terrain-standard-role-match :stump-e :water)))
  (is (= {:nw :same
          :n {:terrain :water}
          :ne {:terrain :water}
          :w {:terrain :water}
          :e {:terrain :water}
          :sw {:terrain :water}
          :s {:terrain :water}
          :se {:terrain :water}}
         (model/terrain-standard-role-match :stump-se :water))))

(deftest terrain-standard-role-tile-inserts_created_rule_after_more_specific_rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :specific-corner
                                     :terrain :grass
                                     :match {:n :none
                                             :s :same
                                             :w :same}}
                                    {:id :broad-edge
                                     :terrain :grass
                                     :match {:n :none}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :none
               :edge)
        rules (get-in state [:rulesets 0 :rules])]
    (is (= [:specific-corner :rule :broad-edge] (map rules :id)))
    (is (= true (:exclusive? (nth rules 1))))))

(deftest terrain-standard-role-tile-updates_existing_rule_without_changing_exclusive_flag
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :old-edge}
                                    {:id :new-edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :edge-n
                                     :terrain :grass
                                     :exclusive? false
                                     :match (model/terrain-standard-role-match
                                             :n
                                             :none)
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[:old-edge]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :none
               :new-edge)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= :edge-n (:selected-terrain-rule-id state)))
    (is (= false (:exclusive? rule)))
    (is (= [[:new-edge]]
           (get-in rule [:output :layers 0 :tiles])))))

(deftest terrain-standard-inner-corner-role-uses_terrain_unit_output_cell
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrain-unit {:w 2 :h 2}
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :inner-corner}]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/source
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default
                :selected-terrain-set-index 0
               :selected-terrain-index 0}
               :inner-corners
               :inner-se
               :any-other
               :inner-corner)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= (model/terrain-standard-role-match :inner-se :any-other) (:match rule)))
    (is (= [[nil nil]
            [nil :inner-corner]]
           (get-in rule [:output :layers 0 :tiles])))
    (is (= :inner-corner
           (model/terrain-standard-role-tile-ref
            state
            :inner-corners
            :inner-se
            :any-other)))))

(deftest terrain-standard-role-recognizes_existing_rpg_edge_shapes
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :terrain
                               :terrains [{:id :grass
                                           :tile :grass-fill}
                                          {:id :water
                                           :tile :water-fill}]}]
               :tilesets [{:id :terrain
                           :tiles [{:id :edge-n}
                                   {:id :water-edge-n}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :rulesets [{:id :rules
                           :terrain-set :overworld
                           :rules [{:id :edge-n
                                    :terrain :grass
                                    :match {:nw :ignore
                                            :n :none
                                            :ne :ignore
                                            :w :ignore
                                            :e :ignore
                                            :sw :ignore
                                            :s :same
                                            :se :ignore}
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[:edge-n]]}]}}
                                   {:id :water-edge-n
                                    :terrain :grass
                                    :match {:nw :ignore
                                            :n {:terrain :water}
                                            :ne :ignore
                                            :w :ignore
                                            :e :ignore
                                            :sw :ignore
                                            :s :same
                                            :se :ignore}
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[:water-edge-n]]}]}}]}]
               :selected-terrain-ruleset-id :rules}]
    (is (= :edge-n
           (model/terrain-standard-role-rule-id state :island-3x3 :n :none)))
    (is (= :edge-n
           (model/terrain-standard-role-tile-ref state :island-3x3 :n :none)))
    (is (= :water-edge-n
           (model/terrain-standard-role-rule-id state :island-3x3 :n :water)))
    (is (= :water-edge-n
           (model/terrain-standard-role-tile-ref state
                                                 :island-3x3
                                                 :n
                                                 :water)))))
