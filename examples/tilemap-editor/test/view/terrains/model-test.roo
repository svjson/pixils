(ns tilemap-editor.view.terrains.model-test
  (:require proof.core
            [tilemap-editor.view.terrains.model :as model]))

(deftest terrain-workspace-selects_first_available_set_and_terrain
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (= 0 (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-workspace-keeps_detail_enabled_without_terrains
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains []}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-set-creation-adds_and_selects_new_set
  (let [state (model/add-terrain-set {:terrain-sets []})]
    (is (= :terrain-set (get-in state [:terrain-sets 0 :id])))
    (is (= "Terrain set" (get-in state [:terrain-sets 0 :label])))
    (is (= [] (get-in state [:terrain-sets 0 :terrains])))
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))))

(deftest terrain-set-creation-deduplicates_ids
  (let [state (model/add-terrain-set
               {:terrain-sets [{:id :terrain-set
                                :label "Terrain set"}]})]
    (is (= :terrain-set-2 (get-in state [:terrain-sets 1 :id])))))

(deftest terrain-set-creation-defaults_preview_tileset
  (let [state (model/add-terrain-set
               {:terrain-sets []
                :tilesets [{:id :overworld
                            :label "Overworld"}]})]
    (is (= :overworld (get-in state [:terrain-sets 0 :tileset])))))

(deftest terrain-set-creation-can_use_confirmed_identity
  (let [state (model/add-terrain-set-with-id
               {:terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               "overworld"
               "World Terrain")]
    (is (= :overworld-2 (get-in state [:terrain-sets 1 :id])))
    (is (= "World Terrain" (get-in state [:terrain-sets 1 :label])))
    (is (= 1 (:selected-terrain-set-index state)))))

(deftest terrain-creation-adds_to_selected_set
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains []}]
                :selected-terrain-set-index 0})]
    (is (= :terrain (get-in state [:terrain-sets 0 :terrains 0 :id])))
    (is (= "Terrain" (get-in state [:terrain-sets 0 :terrains 0 :label])))
    (is (= 0 (:selected-terrain-index state)))))

(deftest terrain-creation-deduplicates_ids
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :terrain
                                            :label "Terrain"}]}]
                :selected-terrain-set-index 0})]
    (is (= :terrain-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))))

(deftest terrain-creation-defaults_preview_tile
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :tileset :overworld-tiles
                                :terrains []}]
                :tilesets [{:id :overworld-tiles
                            :tiles [{:id :grass
                                     :name "Grass"}]}]
                :selected-terrain-set-index 0})]
    (is (= :grass (get-in state [:terrain-sets 0 :terrains 0 :tile])))))

(deftest terrain-creation-can_use_confirmed_identity
  (let [state (model/add-terrain-with-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :terrain
                                            :label "Terrain"}]}]
                :selected-terrain-set-index 0}
               "terrain"
               "Grassland")]
    (is (= :terrain-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))
    (is (= "Grassland" (get-in state [:terrain-sets 0 :terrains 1 :label])))
    (is (= 1 (:selected-terrain-index state)))))

(deftest terrain-duplicate-inserts_copy_after_selected_terrain
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"
                                            :tile :grass-tile}
                                           {:id :water
                                            :label "Water"
                                            :tile :water-tile}]}]
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :edge
                                     :label "Edge"
                                     :terrain :grass
                                     :exclusive? true
                                     :match {:n :same
                                             :s {:terrain :grass}}
                                     :output {:anchor {:x 1 :y 1}}}
                                    {:id :shore
                                     :terrain :water}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Meadow")
        terrains (get-in state [:terrain-sets 0 :terrains])
        duplicate (nth terrains 1)
        rules (get-in state [:rulesets 0 :rules])
        duplicated-rule (nth rules 1)]
    (is (= [:grass :meadow :water]
           (map terrains :id)))
    (is (= [:edge :edge-copy :shore]
           (map rules :id)))
    (is (= 1 (:selected-terrain-index state)))
    (is (nil? (:selected-terrain-rule-id state)))
    (is (= "Meadow" (:label duplicate)))
    (is (= :grass-tile (:tile duplicate)))
    (is (= "Edge Copy" (:label duplicated-rule)))
    (is (= :meadow (:terrain duplicated-rule)))
    (is (= true (:exclusive? duplicated-rule)))
    (is (= {:n :same
            :s {:terrain :meadow}}
           (:match duplicated-rule)))
    (is (= {:anchor {:x 1 :y 1}} (:output duplicated-rule)))))

(deftest terrain-duplicate-deduplicates_name_and_id
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}
                                           {:id :grass-copy
                                            :label "Grass Copy"}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Grass Copy")
        duplicate (nth (get-in state [:terrain-sets 0 :terrains]) 1)]
    (is (= :grass-copy-2 (:id duplicate)))
    (is (= "Grass Copy 2" (:label duplicate)))))

(deftest terrain-duplicate-can_use_requested_id
  (let [state (model/duplicate-selected-terrain-with-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Meadow"
               "custom-meadow")
        duplicate (nth (get-in state [:terrain-sets 0 :terrains]) 1)]
    (is (= :custom-meadow (:id duplicate)))
    (is (= "Meadow" (:label duplicate)))))

(deftest terrain-detail-label_changes_update_selected_records
  (let [state {:terrain-sets [{:id :overworld
                               :label "Overworld"
                               :terrains [{:id :grass
                                           :label "Grass"}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}
        state (model/set-selected-terrain-set-label state "World")
        state (model/set-selected-terrain-label state "Meadow")]
    (is (= "World" (get-in state [:terrain-sets 0 :label])))
    (is (= "Meadow" (get-in state [:terrain-sets 0 :terrains 0 :label])))))

(deftest terrain-set-id-change-updates_project_references
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :overworld
                                :label "Overworld"
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :brushes [{:id :brush
                           :pattern {:layers [{:data-kind :terrain
                                               :terrain-set :overworld
                                               :tiles [[:grass]]}]}}]
                :rulesets [{:id :grass-marching
                            :terrain-set :overworld}]}
               "world")]
    (is (= :world (get-in state [:terrain-sets 0 :id])))
    (is (= :world (get-in state [:layers 0 :terrain-set])))
    (is (= :world (get-in state [:layer-profiles 0 :layers 0 :terrain-set])))
    (is (= :world (get-in state [:brushes 0 :pattern :layers 0 :terrain-set])))
    (is (= :world (get-in state [:rulesets 0 :terrain-set])))))

(deftest terrain-set-id-change-updates_references_in_all_project_maps
  (let [state (model/set-selected-terrain-set-id
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 1
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default :layers []}]
                :selected-layer-index 0
                :terrain-sets [{:id :overworld
                                :label "Overworld"
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/one
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :maps [{:id :map/one
                        :label "One"
                        :width 1
                        :height 1
                        :layers [{:id :scene/one
                                  :data-kind :terrain
                                  :terrain-set :overworld}]}
                       {:id :map/two
                        :label "Two"
                        :width 1
                        :height 1
                        :layers [{:id :scene/two
                                  :data-kind :terrain
                                  :terrain-set :overworld}]}]}
               "world")]
    (is (= :world (get-in state [:layers 0 :terrain-set])))
    (is (= :world (get-in state [:maps 0 :layers 0 :terrain-set])))
    (is (= :world (get-in state [:maps 1 :layers 0 :terrain-set])))))

(deftest terrain-set-id-change-deduplicates_ids
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :world}
                               {:id :overworld}]
                :selected-terrain-set-index 1}
               "world")]
    (is (= :world-2 (get-in state [:terrain-sets 1 :id])))))

(deftest terrain-set-unit-change-updates_selected_set
  (let [state (model/set-selected-terrain-set-unit
               {:terrain-sets [{:id :mountains}]
                :selected-terrain-set-index 0}
               1)]
    (is (= {:w 2 :h 2}
           (get-in state [:terrain-sets 0 :terrain-unit])))))

(deftest terrain-set-unit-change-accepts_option_value
  (let [state (model/set-selected-terrain-set-unit
               {:terrain-sets [{:id :mountains}]
                :selected-terrain-set-index 0}
               :unit-2x2)]
    (is (= {:w 2 :h 2}
           (get-in state [:terrain-sets 0 :terrain-unit])))))

(deftest terrain-unit-option-index-matches_raw_unit
  (is (= 1 (model/terrain-unit-option-index {:w 2 :h 2}))))

(deftest terrain-id-change-updates_project_references
  (let [state (model/set-selected-terrain-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld
                          :tiles [[:grass nil]
                                  [:water :grass]]}
                         {:id :scene/other
                          :data-kind :terrain
                          :terrain-set :other
                          :tiles [[:grass]]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :brushes [{:id :brush
                           :pattern {:layers [{:data-kind :terrain
                                               :terrain-set :overworld
                                               :tiles [[:grass nil]]}
                                              {:data-kind :terrain
                                               :terrain-set :other
                                               :tiles [[:grass]]}]}}]
                :rulesets [{:id :grass-marching
                            :source-layer :scene/terrain
                            :terrain :grass}
                           {:id :source-less-rules
                            :terrain-set :overworld
                            :source-layer nil
                            :rules [{:id :edge
                                     :terrain :grass
                                     :match {:n {:terrain :grass}}
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[nil nil nil]
                                                                [nil :grass nil]
                                                                [nil nil nil]]
                                                        :terrain-signatures
                                                        [[nil nil nil]
                                                         [nil {:center :grass
                                                               :n :grass
                                                               :s :water} nil]
                                                         [nil nil nil]]}]}}]}
                           {:id :other-marching
                            :source-layer :scene/other
                            :terrain :grass}]}
               "meadow")]
    (is (= :meadow (get-in state [:terrain-sets 0 :terrains 0 :id])))
    (is (= [[:meadow nil]
            [:water :meadow]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[:grass]] (get-in state [:layers 1 :tiles])))
    (is (= [[:meadow nil]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= [[:grass]]
           (get-in state [:brushes 0 :pattern :layers 1 :tiles])))
    (is (= :meadow (get-in state [:rulesets 0 :terrain])))
    (is (= :meadow (get-in state [:rulesets 1 :rules 0 :terrain])))
    (is (= :meadow (get-in state
                           [:rulesets 1 :rules 0 :match :n :terrain])))
    (is (= :grass (get-in state
                          [:rulesets 1 :rules 0 :output :layers 0 :tiles 1 1])))
    (is (= {:center :meadow
            :n :meadow
            :s :water}
           (get-in state
                   [:rulesets
                    1
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures
                    1
                    1])))
    (is (= :grass (get-in state [:rulesets 2 :terrain])))))

(deftest terrain-id-change-updates_refs_in_all_project_maps
  (let [state (model/set-selected-terrain-id
               {:selected-map-id :map/one
                :selected-map-label "One"
                :map-width 1
                :map-height 1
                :selected-layer-profile-id :default
                :layer-profiles [{:id :default :layers []}]
                :selected-layer-index 0
                :terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :layers [{:id :scene/one
                          :data-kind :terrain
                          :terrain-set :overworld
                          :tiles [[:grass]]}]
                :maps [{:id :map/one
                        :label "One"
                        :width 1
                        :height 1
                        :layers [{:id :scene/one
                                  :data-kind :terrain
                                  :terrain-set :overworld
                                  :tiles [[:grass]]}]}
                       {:id :map/two
                        :label "Two"
                        :width 1
                        :height 1
                        :layers [{:id :scene/two
                                  :data-kind :terrain
                                  :terrain-set :overworld
                                  :tiles [[:grass]]}]}]
                :rulesets [{:id :inactive-source-rules
                            :source-layer :scene/two
                            :terrain :grass}]}
               "meadow")]
    (is (= :meadow (get-in state [:layers 0 :tiles 0 0])))
    (is (= :meadow (get-in state [:maps 0 :layers 0 :tiles 0 0])))
    (is (= :meadow (get-in state [:maps 1 :layers 0 :tiles 0 0])))
    (is (= :meadow (get-in state [:rulesets 0 :terrain])))))

(deftest terrain-id-change-deduplicates_ids
  (let [state (model/set-selected-terrain-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :meadow}
                                           {:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 1}
               "meadow")]
    (is (= :meadow-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))))

(deftest terrain-detail-preview_changes_update_selected_records
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :old
                               :terrains [{:id :grass
                                           :tile :missing}]}]
               :tilesets [{:id :old
                           :tiles [{:id :old-tile}]}
                          {:id :new
                           :tiles [{:id :new-tile}
                                   {:id :other-tile}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}
        state (model/set-selected-terrain-set-tileset state 1)
        state (model/set-selected-terrain-tile state :other-tile)]
    (is (= :new (get-in state [:terrain-sets 0 :tileset])))
    (is (= :other-tile (get-in state [:terrain-sets 0 :terrains 0 :tile])))))

(deftest terrain-ruleset-creation-adds_selected_terrain_stamp_ruleset
  (let [state (model/add-terrain-ruleset
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]})]
    (is (= :overworld-rules (get-in state [:rulesets 0 :id])))
    (is (= :terrain-stamp (get-in state [:rulesets 0 :kind])))
    (is (= :overworld (get-in state [:rulesets 0 :terrain-set])))
    (is (= :scene/terrain (get-in state [:rulesets 0 :source-layer])))
    (is (= :overworld-rules (:selected-terrain-ruleset-id state)))))

(deftest terrain-rule-creation-adds_brush_shaped_output_stamp
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules []}]
                :selected-terrain-ruleset-id :overworld-rules
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain-visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default})]
    (is (= :rule (get-in state [:rulesets 0 :rules 0 :id])))
    (is (= :grass (get-in state [:rulesets 0 :rules 0 :terrain])))
    (is (= :scene/terrain-visuals
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))
    (is (= [[:grass-fill]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= :rule (:selected-terrain-rule-id state)))))

(deftest terrain-rule-creation-uses_live_tile_layers_when_profile_is_stale
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules []}]
                :selected-terrain-ruleset-id :overworld-rules
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}
                         {:id :scene/visuals
                          :data-kind :tile-ref
                          :tileset :terrain}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :selected-layer-profile-id :default})]
    (is (= :scene/visuals
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))))

(deftest terrain-rule-creation-uses_terrain_set_tileset_not_unrelated_output_layer
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :roads
                                :tileset :roads
                                :terrains [{:id :road
                                            :tile :road-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :tilesets [{:id :water
                            :tiles [{:id :water-fill}]}
                           {:id :roads
                            :tiles [{:id :road-fill}]}]
                :rulesets [{:id :roads-rules
                            :kind :terrain-stamp
                            :terrain-set :roads
                            :rules []}]
                :selected-terrain-ruleset-id :roads-rules
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/roads-source
                                            :data-kind :terrain
                                            :terrain-set :roads}
                                           {:id :scene/water
                                            :data-kind :tile-ref
                                            :tileset :water}]}]
                :selected-layer-profile-id :default})]
    (is (= :roads
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tileset])))
    (is (nil? (get-in state
                      [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))
    (is (= :road-fill
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles 0 0])))))

(deftest terrain-rule-creation-uses_terrain_unit_output_footprint
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :mountains
                                :tileset :mountains
                                :terrain-unit {:w 2 :h 2}
                                :terrains [{:id :mountain
                                            :tile :mountain-a}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :tilesets [{:id :mountains
                            :tiles [{:id :mountain-a}
                                    {:id :mountain-b}]}]
                :rulesets [{:id :mountain-rules
                            :kind :terrain-stamp
                            :terrain-set :mountains
                            :rules []}]
                :selected-terrain-ruleset-id :mountain-rules})]
    (is (= {:x 0 :y 0}
           (get-in state [:rulesets 0 :rules 0 :output :anchor])))
    (is (= [[:mountain-a nil]
            [nil nil]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))))

(deftest terrain-rule-creation-targets_matching_tileset_output_layer
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :roads
                                :tileset :roads
                                :terrains [{:id :road
                                            :tile :road-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :tilesets [{:id :water
                            :tiles [{:id :water-fill}]}
                           {:id :roads
                            :tiles [{:id :road-fill}]}]
                :rulesets [{:id :roads-rules
