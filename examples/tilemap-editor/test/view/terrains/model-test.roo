(deftest terrain-standard-role-tile-inserts-created-rule-after-more-specific-rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :specific-corner
                                     :terrain :grass
                                     :match {:nw {:terrain :water}
                                             :n {:terrain :water}
                                             :ne {:terrain :water}
                                             :w :same
                                             :e :same
                                             :sw :same
                                             :s :same
                                             :se :same}}
                                    {:id :broad-edge
                                     :terrain :grass
                                     :match {:n :other-terrain}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :any-other
               :edge)
        rules (get-in state [:rulesets 0 :rules])]
    (is (= [:specific-corner :rule :broad-edge] (map rules :id)))
    (is (= true (:exclusive? (nth rules 1))))))

(deftest terrain-standard-role-tile-updates-existing-rule-without-changing-exclusive-flag
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :old-edge}
                                    {:id :new-edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :edge-n
                                     :terrain :grass
                                     :exclusive? false
                                     :match (model/terrain-standard-role-match
                                             :n
                                             :none)
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[:old-edge]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :none
               :new-edge)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= :edge-n (:selected-terrain-rule-id state)))
    (is (= false (:exclusive? rule)))
    (is (= [[:new-edge]]
           (get-in rule [:output :layers 0 :tiles])))))

(deftest terrain-standard-inner-corner-role-uses-terrain-unit-output-cell
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrain-unit {:w 2 :h 2}
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :inner-corner}]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/source
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default
                :selected-terrain-set-index 0
               :selected-terrain-index 0}
               :inner-corners
               :inner-se
               :any-other
               :inner-corner)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= (model/terrain-standard-role-match :inner-se :any-other) (:match rule)))
    (is (= [[nil nil]
            [nil :inner-corner]]
           (get-in rule [:output :layers 0 :tiles])))
    (is (= :inner-corner
           (model/terrain-standard-role-tile-ref
            state
            :inner-corners
            :inner-se
            :any-other)))))

(deftest terrain-standard-role-recognizes-existing-rpg-edge-shapes
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :terrain
