(deftest terrain-rule-transform-rotates-match-without-changing-stamp
  (let [state (model/transform-selected-rule
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :terrain :grass
                                     :match {:n :same
                                             :e {:terrain :water}
                                             :s :none}
                                     :output {:anchor {:x 0 :y 1}
                                              :layers [{:tileset :terrain
                                                        :tiles [[:a :b :c]
                                                                [:d :e :f]
                                                                [:g :h :i]]
                                                        :terrain-signatures
                                                        [[{:center :a}
                                                          {:center :b}
                                                          {:center :c}]
                                                         [{:center :d}
                                                          {:center :e}
                                                          {:center :f}]
                                                         [{:center :g}
                                                          {:center :h}
                                                          {:center :i}]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               :rotate-right)]
    (is (= [[:a :b :c]
            [:d :e :f]
            [:g :h :i]]
           (get-in state
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[{:center :a} {:center :b} {:center :c}]
            [{:center :d} {:center :e} {:center :f}]
            [{:center :g} {:center :h} {:center :i}]]
           (get-in state
                   [:rulesets
                    0
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures])))
    (is (= {:x 0 :y 1}
           (get-in state [:rulesets 0 :rules 0 :output :anchor])))
    (is (= :same (get-in state [:rulesets 0 :rules 0 :match :e])))
    (is (= {:terrain :water}
           (get-in state [:rulesets 0 :rules 0 :match :s])))
    (is (= :none (get-in state [:rulesets 0 :rules 0 :match :w])))))

