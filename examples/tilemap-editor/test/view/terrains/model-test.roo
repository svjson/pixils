(deftest terrain-standard-role-recognizes-existing-grouped-opposing-rule
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :terrain
                               :terrains [{:id :grass}
                                          {:id :water}
                                          {:id :sand}
                                          {:id :stone}]}]
               :tilesets [{:id :terrain
                           :tiles [{:id :soft-edge}
                                   {:id :water-edge}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :rulesets [{:id :rules
                           :terrain-set :overworld
                           :rules [{:id :grouped-edge-n
                                    :terrain :grass
                                    :match {:nw :ignore
                                            :n {:terrain-in [:water :sand]}
                                            :ne :ignore
                                            :w :ignore
                                            :e :ignore
                                            :sw :ignore
                                            :s :same
                                            :se :ignore}
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[:soft-edge]]}]}}
                                   {:id :water-edge-n
                                    :terrain :grass
                                    :match {:nw :ignore
                                            :n {:terrain :water}
                                            :ne :ignore
                                            :w :ignore
                                            :e :ignore
                                            :sw :ignore
                                            :s :same
                                            :se :ignore}
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[:water-edge]]}]}}]}]
               :selected-terrain-ruleset-id :rules}
        grouped {:terrain-in [:water :sand]}]
    (is (= :grouped-edge-n
