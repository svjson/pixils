           (get-in rule [:output :layers 0 :transition-masks])))))

(deftest terrain-standard-role-overlay-can-create-transition-overlay-rule
  (let [state (model/set-terrain-standard-role-overlay
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :mountain-nw-overlay}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               :island-3x3
               :n
               :water
               :mountain-nw-overlay)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= {:terrain :water} (get-in rule [:match :nw])))
    (is (= [[nil]] (get-in rule [:output :layers 0 :tiles])))
    (is (= [[nil]] (get-in rule [:output :layers 0 :transition-masks])))
    (is (= [[:mountain-nw-overlay]]
           (get-in rule [:output :layers 0 :transition-overlays])))))

(deftest terrain-standard-cardinal-fork-mask-keeps-broad-output-signature
  (let [mask-ref {:mask-set :soft-edge
                  :mask :fork-n-e-s
                  :polarity :solid-is-opposing}
        state (model/set-terrain-standard-role-mask
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}]}]
                :mask-sets [{:id :soft-edge
                             :masks [{:id :fork-n-e-s}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               :forks-cardinal
               :fork-nes
               :water
               mask-ref)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= {:terrain :water} (get-in rule [:match :w])))
    (is (= {:terrain :water} (get-in rule [:match :ne])))
    (is (= {:terrain :water} (get-in rule [:match :se])))
    (is (= {:center :grass
            :nw :grass
            :n :grass
            :ne :grass
            :e :grass
            :sw :grass
            :s :grass
            :se :grass}
           (get-in rule [:output :layers 0 :terrain-signatures 0 0])))))

(deftest terrain-rule-match-condition-implies-supports-terrain-in-sets
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain :water}
                                                      {:terrain-in [:water
                                                                    :sand]})))
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain-in [:water]}
                                                      {:terrain :water})))
  (is (= false
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain-in [:water
                                                                    :sand]}
                                                      {:terrain :water})))
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain-in [:water
                                                                    :sand]}
                                                      :other-terrain)))
  (is (= false
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain-in [:grass
                                                                    :water]}
                                                      :other-terrain))))

(deftest terrain-rule-condition-not_same_or_none-implication-preserves_existing_conditions
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      :none
                                                      :not-same-or-none)))
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      :other-terrain
                                                      :not-same-or-none)))
  (is (= true
         (model/terrain-rule-match-condition-implies? :grass
                                                      {:terrain :water}
                                                      :not-same-or-none)))
  (is (= false
         (model/terrain-rule-match-condition-implies? :grass
                                                      :not-same-or-none
                                                      :none)))
  (is (= false
         (model/terrain-rule-match-condition-implies? :grass
                                                      :not-same-or-none
                                                      :other-terrain)))
  (is (= false
         (model/terrain-rule-match-condition-implies? :grass
                                                      :same
                                                      :not-same-or-none))))

(deftest terrain-standard-rule-labels-include-semantic-setup-name
  (let [outer-state (model/set-terrain-standard-role-tile
                     {:terrain-sets [{:id :overworld
                                      :tileset :terrain
                                      :terrains [{:id :grass
                                                  :tile :grass-fill}]}]
                      :tilesets [{:id :terrain
                                  :tiles [{:id :grass-fill}
                                          {:id :edge}]}]
                      :selected-terrain-set-index 0
                      :selected-terrain-index 0}
                     :island-3x3
                     :nw
                     :none
                     :edge)
        inner-state (model/set-terrain-standard-role-tile
                     {:terrain-sets [{:id :overworld
                                      :tileset :terrain
                                      :terrains [{:id :grass
                                                  :tile :grass-fill}]}]
                      :tilesets [{:id :terrain
                                  :tiles [{:id :grass-fill}
                                          {:id :inner}]}]
                      :selected-terrain-set-index 0
                      :selected-terrain-index 0}
                     :inner-corners
                     :inner-nw
                     :none
                     :inner)]
    (is (= "Island NW - None"
           (get-in outer-state [:rulesets 0 :rules 0 :label])))
    (is (= "Inner corner NW - None"
           (get-in inner-state [:rulesets 0 :rules 0 :label])))))

(deftest terrain-standard-setup-visibility-defaults-to-all-groups
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}]
    (is (= [:island-3x3
            :inner-corners
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids state)))
    (is (= true (model/terrain-standard-setup-visible? state :island-3x3)))
    (is (= true (model/terrain-standard-setup-visible? state :inner-corners)))
    (is (= true (model/terrain-standard-setup-visible? state :isolated)))
    (is (= true (model/terrain-standard-setup-visible? state :ring)))
    (is (= true (model/terrain-standard-setup-visible? state :forks-cardinal)))
    (is (= true (model/terrain-standard-setup-visible? state :forks-diagonal)))
    (is (= true (model/terrain-standard-setup-visible? state :stumps)))))

(deftest terrain-standard-setup-visibility-is-stored-per-terrain
  (let [state (model/set-selected-terrain-standard-setup-visible
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               :inner-corners
               false)
        water-state (assoc state :selected-terrain-index 1)]
    (is (= [:island-3x3
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (get-in state
                   [:terrain-sets 0 :terrains 0
                    :visible-terrain-standard-setups])))
    (is (= [:island-3x3
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids state)))
    (is (= [:island-3x3
            :inner-corners
            :isolated
            :ring
            :forks-cardinal
            :forks-diagonal
            :stumps]
           (model/selected-terrain-standard-setup-ids water-state)))))

(deftest terrain-standard-isolated-roles-match-direction-sets
  (is (= {:nw :none
          :n :none
          :ne :none
          :w :none
          :e :none
          :sw :none
          :s :none
          :se :none}
         (model/terrain-standard-role-match :isolated-all :none)))
  (is (= {:nw :ignore
          :n :other-terrain
          :ne :ignore
          :w :other-terrain
          :e :other-terrain
          :sw :ignore
          :s :other-terrain
          :se :ignore}
         (model/terrain-standard-role-match :isolated-cardinal :any-other)))
  (is (= {:nw {:terrain :water}
          :n :ignore
          :ne {:terrain :water}
          :w :ignore
          :e :ignore
          :sw {:terrain :water}
          :s :ignore
          :se {:terrain :water}}
         (model/terrain-standard-role-match :isolated-diagonal :water))))

(deftest terrain-standard-island-corner-roles-include-inward-diagonal
  (is (= {:nw :ignore
          :n :none
          :ne :ignore
          :w :none
          :e :same
          :sw :ignore
          :s :same
          :se :same}
         (model/terrain-standard-role-match :nw :none)))
  (is (= {:nw :same
          :n :same
          :ne :ignore
          :w :same
          :e {:terrain :water}
          :sw :ignore
          :s {:terrain :water}
          :se :ignore}
         (model/terrain-standard-role-match :se :water))))

(deftest terrain-standard-island-edge-roles-require-broad-edge
  (is (= {:nw :none
          :n :none
          :ne :none
          :w :same
          :e :same
          :sw :same
          :s :same
          :se :same}
         (model/terrain-standard-role-match :n :none)))
  (is (= {:nw :same
          :n :same
          :ne {:terrain :water}
          :w :same
          :e {:terrain :water}
          :sw :same
          :s :same
          :se {:terrain :water}}
         (model/terrain-standard-role-match :e :water)))
  (is (= {:nw :same
          :n :same
          :ne :same
          :w :same
          :e :same
          :sw :other-terrain
          :s :other-terrain
          :se :other-terrain}
         (model/terrain-standard-role-match :s :any-other))))

(deftest terrain-standard-ring-roles-match-bends-and-straights
  (let [setup (model/terrain-standard-setup :ring)]
    (is (= [:ring-bend-se
            :ring-straight-h
            :ring-bend-sw
            :ring-straight-v
            :ring-bend-ne
            :ring-bend-nw]
           (map (:roles setup) :id)))
    (is (= [[:ring-bend-se :ring-straight-h :ring-bend-sw]
            [:ring-straight-v nil nil]
            [:ring-bend-ne nil :ring-bend-nw]]
           (:matrix setup))))
  (is (= {:nw :ignore
          :n :none
          :ne :ignore
          :w :same
          :e :same
          :sw :ignore
          :s :none
          :se :ignore}
         (model/terrain-standard-role-match :ring-straight-h :none)))
  (is (= {:nw :ignore
          :n {:terrain :water}
          :ne :ignore
          :w {:terrain :water}
          :e :same
          :sw :ignore
          :s :same
          :se :ignore}
         (model/terrain-standard-role-match :ring-bend-se :water)))
  (is (= {:nw :ignore
          :n :same
          :ne :ignore
          :w :same
          :e {:terrain :water}
          :sw :ignore
          :s {:terrain :water}
          :se :ignore}
         (model/terrain-standard-role-match :ring-bend-nw :water))))

(deftest terrain-standard-ring-roles-recognize-legacy-strict-bends
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :terrain
                               :terrains [{:id :cart-rail}
                                          {:id :water}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :rulesets [{:id :rules
                           :terrain-set :overworld
                           :rules [{:id :legacy-ring-se
                                    :terrain :cart-rail
                                    :match {:nw {:terrain :water}
                                            :n {:terrain :water}
                                            :ne {:terrain :water}
                                            :w {:terrain :water}
                                            :e :same
                                            :sw {:terrain :water}
                                            :s :same
                                            :se {:terrain :water}}
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[:rail-se]]}]}}]}]
               :selected-terrain-ruleset-id :rules}]
    (is (= :legacy-ring-se
           (model/terrain-standard-role-rule-id state
                                                :ring
                                                :ring-bend-se
                                                :water)))))

