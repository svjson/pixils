(deftest terrain-standard-role-tile-creates-raw-stamp-rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :water-edge}]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/source
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default
                :selected-terrain-set-index 0
               :selected-terrain-index 0}
               :island-3x3
               :n
               :none
               :water-edge)
        rule (get-in state [:rulesets 0 :rules 0])]
    (is (= :overworld-rules (get-in state [:rulesets 0 :id])))
    (is (= :terrain-stamp (get-in state [:rulesets 0 :kind])))
    (is (= :scene/source (get-in state [:rulesets 0 :source-layer])))
    (is (= :rule (:id rule)))
    (is (= "Island N - None" (:label rule)))
    (is (= :grass (:terrain rule)))
    (is (= (model/terrain-standard-role-match :n :none) (:match rule)))
    (is (= true (:exclusive? rule)))
    (is (= :scene/visuals (get-in rule [:output :layers 0 :target-layer])))
    (is (= :terrain (get-in rule [:output :layers 0 :tileset])))
    (is (= [[:water-edge]]
           (get-in rule [:output :layers 0 :tiles])))
    (is (= :rule (:selected-terrain-rule-id state)))))

(deftest terrain-standard-role-tile-inserts-created-rule-before-less-specific-rule
  (let [state (model/set-terrain-standard-role-tile
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}
                                           {:id :water
                                            :tile :water-fill}
                                           {:id :sand
                                            :tile :sand-fill}]}]
                :tilesets [{:id :terrain
                            :tiles [{:id :grass-fill}
                                    {:id :water-edge}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules [{:id :broad-edge
                                     :terrain :grass
                                     :exclusive? false
                                     :match (model/terrain-standard-role-match
                                             :n
                                             :any-other)}
                                    {:id :later-rule
                                     :terrain :grass
                                     :match {:s :same}}]}]
                :selected-terrain-ruleset-id :overworld-rules}
               :island-3x3
               :n
               :water
               :water-edge)
        rules (get-in state [:rulesets 0 :rules])]
    (is (= [:rule :broad-edge :later-rule] (map rules :id)))
    (is (= true (:exclusive? (nth rules 0))))
    (is (= false (:exclusive? (nth rules 1))))
    (is (= {:terrain :water}
           (get-in rules [0 :match :n])))))

(deftest terrain-standard-opposing-toggle-builds-grouped-terrain-selection
  (let [base-state {:terrain-sets [{:id :overworld
                                    :terrains [{:id :grass}
                                               {:id :water
                                                :label "Water"}
                                               {:id :sand
                                                :label "Sand"}
                                               {:id :stone}]}]
                    :selected-terrain-set-index 0
                    :selected-terrain-index 0}
        water-state (model/set-terrain-standard-opposing
                     base-state
                     (model/toggle-terrain-standard-opposing base-state :water))
        sand-state (model/set-terrain-standard-opposing
                    water-state
                    (model/toggle-terrain-standard-opposing water-state :sand))
        stone-first-state (model/set-terrain-standard-opposing
                           sand-state
                           {:terrain-in [:stone :sand :water]})
        sand-only-state (model/set-terrain-standard-opposing
                         sand-state
                         (model/toggle-terrain-standard-opposing sand-state :water))]
    (is (= :water (:terrain-standard-opposing water-state)))
    (is (= {:terrain-in [:water :sand]}
           (:terrain-standard-opposing sand-state)))
    (is (= {:terrain-in [:water :sand :stone]}
           (:terrain-standard-opposing stone-first-state)))
    (is (= :sand (:terrain-standard-opposing sand-only-state)))
    (is (= "Water, Sand"
           (model/terrain-standard-opposing-label
            sand-state
            (:terrain-standard-opposing sand-state))))))

