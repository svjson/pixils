(deftest terrain-delete-removes-terrain-data-and-rules
  (let [state (model/delete-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}
                                           {:id :water}]}
                               {:id :other
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :layers [{:id :terrain
                          :data-kind :terrain
                          :terrain-set :overworld
                          :tiles [[:grass :water]
                                  [:grass nil]]}]
                :brushes [{:id :brush
                           :layers [{:data-kind :terrain
                                     :terrain-set :overworld
                                     :tiles [[:grass :water]]}]}]
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :grass-a
                                     :terrain :grass}
                                    {:id :water-a
                                     :terrain :water
                                     :match {:n {:terrain :grass}}
                                     :output {:layers
                                              [{:terrain-signature
                                                {:n :grass
                                                 :center :water}}]}}]}
                           {:id :other-rules
                            :terrain-set :other
                            :rules [{:id :other-grass
                                     :terrain :grass}]}]})]
    (is (= [:water] (map (get-in state [:terrain-sets 0 :terrains]) :id)))
    (is (= [[nil :water]
            [nil nil]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[nil :water]]
           (get-in state [:brushes 0 :layers 0 :tiles])))
    (is (= [:water-a] (map (get-in state [:rulesets 0 :rules]) :id)))
    (is (= nil (get-in state [:rulesets 0 :rules 0 :match :n :terrain])))
    (is (= nil (get-in state
                       [:rulesets 0 :rules 0 :output :layers 0
                        :terrain-signature :n])))
    (is (= :water (get-in state [:rulesets 0 :rules 0 :terrain])))
    (is (= [:other-grass] (map (get-in state [:rulesets 1 :rules]) :id)))
    (is (= 0 (:selected-terrain-index state)))))

(deftest terrain-rule-duplicate-inserts-copy-after-selected-rule
  (let [state (model/duplicate-selected-terrain-rule
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule-a
                                     :label "North edge"
                                     :terrain :grass
                                     :exclusive? true
                                     :match {:n :same}
                                     :output {:anchor {:x 1 :y 1}}}
                                    {:id :rule-b
                                     :terrain :grass}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule-a})
        rules (get-in state [:rulesets 0 :rules])
        duplicate (nth rules 1)]
    (is (= [:rule-a :rule-a-copy :rule-b]
           (map rules :id)))
    (is (= :rule-a-copy (:selected-terrain-rule-id state)))
    (is (= "North edge Copy" (:label duplicate)))
    (is (= :grass (:terrain duplicate)))
    (is (= true (:exclusive? duplicate)))
    (is (= {:n :same} (:match duplicate)))
    (is (= {:anchor {:x 1 :y 1}} (:output duplicate)))))

(deftest terrain-rule-match-cycle-steps-visual-condition-options
  (let [base-state {:terrain-sets [{:id :overworld
                                    :terrains [{:id :grass}
                                               {:id :water}]}]
                    :selected-terrain-set-index 0
                    :selected-terrain-index 0
                    :rulesets [{:id :overworld-rules
                                :terrain-set :overworld
                                :rules [{:id :rule
                                         :terrain :grass
                                         :match {:n :ignore}}]}]
                    :selected-terrain-ruleset-id :overworld-rules
                    :selected-terrain-rule-id :rule}
        right-state (model/cycle-selected-rule-match-condition
                     base-state
                     :n
                     1)
        left-state (model/cycle-selected-rule-match-condition
                    base-state
                    :n
                    -1)
        other-state (model/cycle-selected-rule-match-condition
                     (assoc-in base-state
                               [:rulesets 0 :rules 0 :match :n]
                               :not-same)
                     :n
                     1)]
    (is (= :same (get-in right-state [:rulesets 0 :rules 0 :match :n])))
    (is (= {:terrain :water}
           (get-in left-state [:rulesets 0 :rules 0 :match :n])))
    (is (= {:terrain :water}
           (get-in other-state [:rulesets 0 :rules 0 :match :n])))))

