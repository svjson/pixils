(ns tilemap-editor.application-startup-test
  (:require proof.core
            [proof.syntax :as s]
            [roo.io :as io]
            [pixils.tilemap.project.model :as data]
            [pixils.test :as px]
            [pixils.test.list-box :as list-box]
            [pixils.test.menu-bar :as menu-bar]
            [tilemap-editor.io.project :as project-io]
            [tilemap-editor.model.tilemap :as tilemap]
            [tilemap-editor.fixture.view.tilemap.tilemap-tab :as tilemap-tab]
            [tilemap-editor.view.brushes.model :as brush-model]
            [tilemap-editor.view.resources.model :as resource-model]
            [tilemap-editor.view.terrains.model :as terrain-model]))

(def TERRAIN-PAINT-PATH "/tmp/pixils-tilemap-editor-terrain-rule-paint-project.edn")
(def BRUSH-PATH "/tmp/pixils-tilemap-editor-brush-project.edn")
(def RESOURCE-PATH "/tmp/pixils-tilemap-editor-resource-project.edn")
(def EXCLUSIVE-RULE-PATH "/tmp/pixils-tilemap-editor-exclusive-checkbox-project.edn")
(def MISSING-IMAGE-PATH "/tmp/pixils-tilemap-editor-missing-image-project.edn")
(def MISSING-IMAGE-HISTORY-PATH "/tmp/pixils-tilemap-editor-missing-image-history.edn")
(def DIRECT-LOAD-HISTORY-PATH "/tmp/pixils-tilemap-editor-direct-load-history.edn")

(defun remove-file-if-exists! [path]
  (when (io/exists? path)
    (io/remove-tree! path)))

(defun cleanup-application-startup-test-files! []
  (remove-file-if-exists! TERRAIN-PAINT-PATH)
  (remove-file-if-exists! BRUSH-PATH)
  (remove-file-if-exists! RESOURCE-PATH)
  (remove-file-if-exists! EXCLUSIVE-RULE-PATH)
  (remove-file-if-exists! MISSING-IMAGE-PATH)
  (remove-file-if-exists! MISSING-IMAGE-HISTORY-PATH)
  (remove-file-if-exists! DIRECT-LOAD-HISTORY-PATH))

(defun file-dialog-payload [mode path filename]
  {:type :confirm
   :mode mode
   :path path
   :directory "/tmp"
   :filename filename})

(defun paint-event [button x y]
  {:button button
   :position {:x (* x data/tile-size)
              :y (* y data/tile-size)}})

(defun open-project-state [path filename]
  (project-io/apply-project-file-dialog-result
   {:layers []
    :recent-projects []}
   (file-dialog-payload :file-dialog/open path filename)))

(defun make-startup-app []
  (px/make-app {:package-root "."
                     :buffer-width 800
                     :buffer-height 600}))

(defun example-map-open-payload []
  {:type :confirm
   :mode :file-dialog/open
   :path "example-maps/map1.edn"
   :directory "example-maps"
   :filename "map1.edn"})

(deftest loaded-project-terrain-paint-can-bake-stamp-rule
  (cleanup-application-startup-test-files!)
  (io/spit-edn! TERRAIN-PAINT-PATH
                {:format data/project-format
                 :version data/project-format-version
                 :resources {:bundles {}}
                 :tilesets [{:id :terrain
                             :label "Terrain"
                             :tile-size 16
                             :tiles [{:id :grass-fill
                                      :name "Grass Fill"
                                      :type :color
                                      :color {:r 0 :g 255 :b 0}}
                                     {:id :water-fill
                                      :name "Water Fill"
                                      :type :color
                                      :color {:r 0 :g 0 :b 255}}
                                     {:id :shore-n
                                      :name "Shore North"
                                      :type :color
                                      :color {:r 255 :g 255 :b 0}}]}]
                 :terrain-sets [{:id :overworld
                                 :label "Overworld"
                                 :tileset :terrain
                                 :terrains [{:id :grass
                                             :label "Grass"
                                             :tile :grass-fill}
                                            {:id :water
                                             :label "Water"
                                             :tile :water-fill}]}]
                 :rulesets [{:id :shore-rules
                             :kind :terrain-stamp
                             :terrain-set :overworld
                             :source-layer nil
                             :rules [{:id :grass-north-water
                                      :terrain :grass
                                      :match {:nw :ignore
                                              :n {:terrain :water}
                                              :ne :ignore
                                              :w :ignore
                                              :e :ignore
                                              :sw :ignore
                                              :s :ignore
                                              :se :ignore}
                                      :output {:anchor {:x 1 :y 1}
                                               :layers [{:id :layer
                                                         :target-layer nil
                                                         :tileset :terrain
                                                         :tiles [[nil :shore-n nil]
                                                                 [nil :grass-fill nil]
                                                                 [nil nil nil]]}]}}]}]
                 :layer-profiles [{:id :default
                                   :label "Default"
                                   :layers [{:id :scene/terrain
                                             :label "Terrain Source"
                                             :kind :tile
                                             :role :source
                                             :data-kind :terrain
                                             :terrain-set :overworld}]}]
                 :tilemap {:width 32
                           :height 32
                           :tile-size 16
                           :layer-profile :default
                           :layers [{:id :scene/terrain
                                     :label "Terrain Source"
                                     :kind :tile
                                     :role :source
                                     :data-kind :terrain
                                     :terrain-set :overworld
                                     :tiles [[nil :water nil]]}]}})
  (let [loaded (open-project-state TERRAIN-PAINT-PATH
                                   "terrain-rule-paint-project.edn")
        painted (tilemap/paint-map-at
                 (assoc loaded :terrain-rule-application :paint-baked)
                 (paint-event :left 1 1))]
    (is (= :grass (get-in painted [:layers 0 :tiles 1 1])))
    (is (= 1 (count (:layers painted))))
    (is (= [] (or (:terrain-stamp-replacements painted) [])))
    (is (= true (:render-map-dirty? painted))))
  (cleanup-application-startup-test-files!))

(deftest loaded-project-terrain-workspace-derives-rule-exclusive-flag
  (cleanup-application-startup-test-files!)
  (io/spit-edn! EXCLUSIVE-RULE-PATH
                {:format data/project-format
                 :version data/project-format-version
                 :resources {:bundles {}}
                 :tilesets [{:id :terrain
                             :label "Terrain"
                             :tile-size 16
                             :tiles [{:id :grass-fill
                                      :name "Grass Fill"
                                      :type :color
                                      :color {:r 0 :g 255 :b 0}}]}]
                 :terrain-sets [{:id :overworld
                                 :label "Overworld"
                                 :tileset :terrain
                                 :terrains [{:id :grass
                                             :label "Grass"
                                             :tile :grass-fill}]}]
                 :rulesets [{:id :overworld-rules
                             :kind :terrain-stamp
                             :terrain-set :overworld
                             :rules [{:id :edge
                                      :label "Edge"
                                      :terrain :grass
                                      :exclusive? true
                                      :output {:anchor {:x 1 :y 1}
                                               :layers [{:target-layer :scene/visuals
                                                         :tileset :terrain
                                                         :tiles [[nil nil nil]
                                                                 [nil :grass-fill nil]
                                                                 [nil nil nil]]}]}}]}]
                 :layer-profiles [{:id :default
                                   :label "Default"
                                   :layers [{:id :scene/terrain
                                             :label "Terrain Source"
                                             :kind :terrain
                                             :data-kind :terrain
                                             :terrain-set :overworld}
                                            {:id :scene/visuals
                                             :label "Terrain Visuals"
                                             :kind :tile
                                             :data-kind :tile-ref
                                             :tileset :terrain}]}]
                 :tilemap {:width 2
                           :height 2
                           :tile-size 16
                           :layer-profile :default
                           :layers []}})
  (let [loaded (open-project-state EXCLUSIVE-RULE-PATH
                                   "exclusive-checkbox-project.edn")
        workspace (terrain-model/derive-terrain-workspace-state loaded)]
    (is (= :overworld-rules (:selected-terrain-ruleset-id workspace)))
    (is (= :edge (:selected-terrain-rule-id workspace)))
    (is (= true (:selected-terrain-rule-exclusive? workspace))))
  (cleanup-application-startup-test-files!))

(deftest loaded-project-brush-workspace-requires-target-source-layers
  (cleanup-application-startup-test-files!)
  (io/spit-edn! BRUSH-PATH
                {:format data/project-format
                 :version data/project-format-version
                 :resources {:bundles {}}
                 :tilesets [{:id :loaded
                             :label "Loaded"
                             :tile-size 16
                             :tiles [{:id :grass
                                      :name "Grass"
                                      :char "g"
                                      :type :color
                                      :color {:r 0 :g 255 :b 0}}]}]
                 :brushes [{:id :brush
                            :label "Brush"
                            :kind :pattern
                            :pattern {:size {:w 3 :h 3}
                                      :anchor {:x 1 :y 1}
                                      :layers []}}]
                 :tilemap {:width 2
                           :height 2
                           :tile-size 16
                           :layers []}})
  (let [loaded (open-project-state BRUSH-PATH "brush-project.edn")
        workspace (brush-model/derive-brush-workspace-state loaded)
        brush (brush-model/selected-brush (:brushes workspace)
                                          (:selected-brush-index workspace))
        layer (brush-model/selected-pattern-layer
               brush
               (:selected-brush-layer-index workspace))
        source-options (brush-model/source-layer-options workspace)]
    (is (nil? layer))
    (is (= [] source-options)))
  (cleanup-application-startup-test-files!))

(deftest loaded-project-resources-feed-resource-and-tileset-state
  (cleanup-application-startup-test-files!)
  (io/spit-edn! RESOURCE-PATH
                {:format data/project-format
                 :version data/project-format-version
                 :resources {:bundles {:editor-assets
                                       {:images
                                        {:spritesheet
                                         {:file-name "assets/simples_pimples.png"}}}
                                       :project-assets
                                       {:images
                                        {:spritesheet
                                         {:file-name
                                          "examples/tilemap-editor/assets/simples_pimples.png"
                                          :name "Spritesheet"}}}}}
                 :tilesets [{:id :loaded
                             :label "Loaded"
                             :tile-size 16
                             :tiles [{:id :sprite
                                      :name "Sprite"
                                      :char "s"
                                      :type :sprite
                                      :image :project-assets/spritesheet
                                      :source {:x 0 :y 0 :w 16 :h 16}}]}]
                 :tilemap {:width 2
                           :height 2
                           :tile-size 16
                           :layers []}})
  (let [loaded (open-project-state RESOURCE-PATH "resource-project.edn")
        workspace (resource-model/derive-resource-workspace-state loaded)]
    (is (= [:project-assets]
           (map (resource-model/dynamic-project-bundle-entries
                 (:resources workspace))
                :id)))
    (is (= :project-assets (:selected-resource-bundle workspace)))
    (is (= :spritesheet (:selected-image-resource workspace)))
    (is (= :project-assets/spritesheet
           (get-in workspace [:tilesets 0 :tiles 0 :image]))))
  (cleanup-application-startup-test-files!))

(deftest current-example-main-mode-renders-and-switches-to-tilesets-tab
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/render! app)
    (is (= "main-mode" (px/active-mode-name app)))
    (let [tilesets-tab (px/find-view-containing app "ui/tab" ":tab-id :tilesets")]
      (is (some? tilesets-tab))
      (px/click! app tilesets-tab))
    (px/render! app)
    (is (= :tilesets (:workspace-tab (px/active-state app))))
    (is (some? (px/find-view app "tileset-definition-workspace")))))

(deftest menu-shortcuts-dispatch-from-main-mode-action-map
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (is (= true (:show-grid? (px/active-state app))))
    (is (= true (:show-terrain-rules? (px/active-state app))))
    (is (= :preview (:terrain-rule-application (px/active-state app))))

    (px/key-down! app :left-ctrl)
    (px/key-down! app :g)
    (px/update! app)
    (px/key-up! app :g)
    (is (= false (:show-grid? (px/active-state app))))

    (px/key-down! app :t)
    (px/update! app)
    (px/key-up! app :t)
    (is (= false (:show-terrain-rules? (px/active-state app))))

    (px/key-down! app :left-alt)
    (px/key-down! app :b)
    (px/update! app)
    (px/key-up! app :b)
    (is (= :paint-baked (:terrain-rule-application (px/active-state app))))

    (px/key-down! app :p)
    (px/update! app)
    (px/key-up! app :p)
    (px/key-up! app :left-alt)
    (px/key-up! app :left-ctrl)
    (px/update! app)
    (is (= :preview (:terrain-rule-application (px/active-state app))))))



;; edit-menu

(deftest edit-menu/enables-selection-commands-when-map-selection-exists
  (s/given
    (let [app (make-startup-app)]
      (px/push-mode! app 'main-mode)
      (px/update! app)
      (px/render! app)
      (px/set-active-state!
       app
       (assoc (px/active-state app)
              :workspace-tab :map
              :map-tool :select
              :map-width 4
              :map-height 4
              :tile-size 16
              :zoom 1
              :map-offset {:x 0 :y 0}
              :map-clipboard nil))
      (px/settle-layout! app)
      (px/render! app)
      app))

  (s/when [app]
    (tilemap-tab/select-map-region! app
                                    {:x 0 :y 0}
                                    {:x 1 :y 1})
    (px/settle-layout! app)
    (px/render! app)
    app)

  (s/then [app]
    (is (= {:anchor {:x 0 :y 0}
            :current {:x 1 :y 1}
            :rect {:x 0 :y 0 :w 2 :h 2}
            :active? false}
           (:map-selection (px/active-state app))))
    (is (= [true true true]
           (for [action [:edit/cut :edit/copy :edit/paste]]
             (menu-bar/command-enabled? app "Edit" action)))))

  (s/when [app]
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :map-clipboard {:type :tilemap/map-region}))
    (px/settle-layout! app)
    (px/render! app)
    app)

  (s/then [app]
    (is (= {:type :tilemap/map-region}
           (:map-clipboard (px/active-state app))))
    (is (= true
           (menu-bar/command-enabled? app "Edit" :edit/paste)))))

(deftest edit-menu/reflects-workbook-history-changes
  (s/given
    (make-startup-app))

  (s/when [app]
    (px/push-mode! app 'main-mode)
    (px/settle-layout! app)
    (px/render! app)
    app)

  (s/then [app]
    (is (= [{:text "Undo"
             :enabled? false}
            {:text "Redo"
             :enabled? false}]
           (for [action [:edit/undo :edit/redo]]
             {:text (menu-bar/command-text app "Edit" action)
              :enabled? (menu-bar/command-enabled? app "Edit" action)}))))

  (s/when [app]
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workbook-history {:undo [{:label "Rename layer"}]
                               :redo []}))
    (px/settle-layout! app)
    (px/render! app)
    app)

  (s/then [app]
    (is (= {:undo [{:label "Rename layer"}]
            :redo []}
           (:workbook-history (px/active-state app))))
    (is (= [{:text "Undo Rename layer"
             :enabled? true}
            {:text "Redo"
             :enabled? false}]
           (for [action [:edit/undo :edit/redo]]
             {:text (menu-bar/command-text app "Edit" action)
              :enabled? (menu-bar/command-enabled? app "Edit" action)})))))

(deftest direct-project-load-keeps-existing-palette-interactive
  (cleanup-application-startup-test-files!)
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/render! app)
    (px/set-active-state!
     app
     (project-io/apply-project-file-dialog-result
      (assoc (px/active-state app)
             :project-history-path DIRECT-LOAD-HISTORY-PATH
             :recent-projects [])
      (example-map-open-payload)))
    (px/update! app)
    (px/update! app)
    (px/render! app)
    (let [tile-select-grid (px/find-view-containing app
                                                         "tile-select-grid"
                                                         "Night Sky")]
      (is (some? tile-select-grid))
      (px/mouse-click-in! app tile-select-grid 21 5))
    (is (= :cave-depth (:selected-tile (px/active-state app))))
    (is (some? (px/find-view-containing app
                                             "tile-select-grid"
                                             "Cave Depth"))))
  (cleanup-application-startup-test-files!))

(deftest map-canvas-right-click-clears-active-tile-layer-cell
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :map
            :selected-map-id :map/test
            :selected-map-label "Test"
            :map-width 1
            :map-height 1
            :tile-size 16
            :zoom 1
            :map-offset {:x 0 :y 0}
            :map-tool :paint
            :map-palette-tab :tiles
            :selected-layer-index 1
            :selected-layer-label "Props"
            :selected-tile :crate
            :tilesets []
            :terrain-sets []
            :rulesets []
            :layer-profiles []
            :hidden-layer-indices []
            :maps [{:id :map/test
                    :label "Test"
                    :width 1
                    :height 1
                    :tile-size 16
                    :layers [{:id :terrain
                              :label "Terrain"
                              :role :source
                              :data-kind :terrain
                              :terrain-set :overworld
                              :tiles [[:grass]]}
                             {:id :props
                              :label "Props"
                              :role :source
                              :data-kind :tile-ref
                              :tileset :props
                              :tiles [[:crate]]}]}]
            :layers [{:id :terrain
                      :label "Terrain"
                      :role :source
                      :data-kind :terrain
                      :terrain-set :overworld
                      :tiles [[:grass]]}
                     {:id :props
                      :label "Props"
                      :role :source
                      :data-kind :tile-ref
                      :tileset :props
                      :tiles [[:crate]]}]))
    (px/update! app)
    (px/render! app)
    (let [canvas (px/find-view app "map-canvas")]
      (is (some? canvas))
      (px/mouse-click-in! app canvas 8 8 :right))
    (px/update! app)
    (is (nil? (get-in (px/active-state app)
                      [:layers 1 :tiles 0 0])))
    (is (nil? (get-in (px/active-state app)
                      [:maps 0 :layers 1 :tiles 0 0])))))

(deftest terrain-unit-combo-updates-selected-terrain-set
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :terrains
            :selected-terrain-set-index 0
            :terrain-sets [{:id :mountains
                            :label "Mountains"
                            :terrains []}]))
    (px/update! app)
    (px/render! app)
    (let [terrain-unit-combo (px/find-view-containing app
                                                           "ui/combo-box"
                                                           ":unit-2x2")]
      (is (some? terrain-unit-combo))
      (px/mouse-down-in! app terrain-unit-combo 5 5))
    (px/update! app)
    (is (= "ui/combo-box-popup" (px/active-mode-name app)))
    (px/pop-mode! app {:selected-indices [1]})
    (px/update! app)
    (px/update! app)
    (px/render! app)
    (is (= "main-mode" (px/active-mode-name app)))
    (is (= {:w 2 :h 2}
           (get-in (px/active-state app)
                   [:terrain-sets 0 :terrain-unit])))
    (let [terrain-unit-combo (px/find-view-containing app
                                                           "ui/combo-box"
                                                           ":unit-2x2")]
      (is (some? terrain-unit-combo))
      (is (= 1 (:selected-index (px/view-state terrain-unit-combo))))
      (is (= "2 x 2" (:selected-label (px/view-state terrain-unit-combo)))))))

(deftest masks-tab-renders-mask-sets-from-state
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :masks
            :mask-sets [{:id :soft-edge
                         :label "Soft Edge"}]))
    (px/update! app)
    (px/render! app)
    (is (some? (px/find-view app "mask-set-workspace")))
    (is (= [{:id :soft-edge
             :label "Soft Edge"}]
           (:mask-sets (px/view-state
                        (px/find-view app "mask-set-workspace")))))
    (list-box/has-visible-text? app "Soft Edge")))

(deftest masks-tab-renders-selected-mask-palette-and-canvas
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :masks
            :mask-detail-tab :mask
            :selected-mask-set-index 0
            :selected-mask-index 0
            :tilesets [{:id :terrain
                        :label "Terrain"
                        :tiles [{:id :edge-n
                                 :label "Edge N"}]}]
            :mask-sets [{:id :soft-edge
                         :label "Soft Edge"
                         :masks [{:id :north
                                  :label "North"
                                  :source {:type :tile-composition
                                           :tileset :terrain
                                           :tiles []}}]}]))
    (px/update! app)
    (px/render! app)
    (let [tileset-selector (px/find-view
                            app
                            "mask-workspace-source-tileset-selector")
          tile-palette (px/find-view app "mask-source-tile-palette")
          composition-canvas (px/find-view
                              app
                              "mask-composition-canvas")]
      (is (some? tileset-selector))
      (is (some? tile-palette))
      (is (some? composition-canvas))
      (is (= false (:disabled? (px/view-state tileset-selector))))
      (is (= false (:disabled? (px/view-state tile-palette))))
      (is (= [{:value 0
               :label "Terrain"}]
             (:tileset-options (px/view-state tileset-selector))))
      (is (= [{:value :edge-n
               :label nil}]
             (:tile-options (px/view-state tile-palette))))
      (is (= []
             (:selected-mask-tile-items
              (px/view-state composition-canvas)))))))

(deftest masks-tab-source-tileset-selection-stores-tileset-id
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :masks
            :mask-detail-tab :mask
            :selected-mask-set-index 0
            :selected-mask-index 0
            :tilesets [{:id :terrain
                        :label "Terrain"
                        :tiles [{:id :edge-n}]}
                       {:id :road
                        :label "Road"
                        :tiles [{:id :road-edge}]}]
            :mask-sets [{:id :soft-edge
                         :label "Soft Edge"
                         :masks [{:id :north
                                  :label "North"
                                  :source {:type :tile-composition
                                           :tileset :terrain
                                           :tiles []}}]}]))
    (px/update! app)
    (px/render! app)
    (let [tileset-selector (px/find-view
                            app
                            "mask-workspace-source-tileset-selector")]
      (is (some? tileset-selector))
      (is (= 0 (:selected-tileset-index
                (px/view-state tileset-selector))))
      (px/mouse-down-in! app tileset-selector 5 5))
    (px/update! app)
    (is (= "ui/combo-box-popup" (px/active-mode-name app)))
    (px/pop-mode! app {:selected-indices [1]})
    (px/update! app)
    (px/update! app)
    (px/render! app)
    (let [tileset-selector (px/find-view
                            app
                            "mask-workspace-source-tileset-selector")]
      (is (= :road
             (get-in (px/active-state app)
                     [:mask-sets 0 :masks 0 :source :tileset])))
      (is (= 1 (:selected-tileset-index
                (px/view-state tileset-selector)))))))

(deftest masks-tab-clicking-composed-tile-selects-it
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :masks
            :mask-detail-tab :mask
            :selected-mask-set-index 0
            :selected-mask-index 0
            :tilesets [{:id :terrain
                        :label "Terrain"
                        :tile-size 16
                        :tiles [{:id :edge-n}
                                {:id :edge-e}]}]
            :mask-sets [{:id :soft-edge
                         :label "Soft Edge"
                         :mask-size {:w 16
                                     :h 16}
                         :masks [{:id :north
                                  :label "North"
                                  :source {:type :tile-composition
                                           :tileset :terrain
                                           :tiles [{:tile :edge-n
                                                    :offset {:x 0
                                                             :y 0}}]}}]}]))
    (px/update! app)
    (px/render! app)
    (let [canvas (px/find-view app "mask-composition-canvas")]
      (is (some? canvas))
      (px/mouse-click-in! app canvas 10 10))
    (px/update! app)
    (px/render! app)
    (let [canvas (px/find-view app "mask-composition-canvas")]
      (is (= 0 (:selected-mask-tile-item-index
                (px/view-state canvas)))))))

(deftest masks-tab-context-menu-can-remove-composed-tile
  (let [app (make-startup-app)]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :workspace-tab :masks
            :mask-detail-tab :mask
            :selected-mask-set-index 0
            :selected-mask-index 0
            :tilesets [{:id :terrain
                        :label "Terrain"
                        :tile-size 16
                        :tiles [{:id :edge-n}]}]
            :mask-sets [{:id :soft-edge
                         :label "Soft Edge"
                         :mask-size {:w 16
                                     :h 16}
                         :masks [{:id :north
                                  :label "North"
                                  :source {:type :tile-composition
                                           :tileset :terrain
                                           :tiles [{:tile :edge-n
                                                    :offset {:x 0
                                                             :y 0}}]}}]}]))
    (px/update! app)
    (px/render! app)
    (let [canvas (px/find-view app "mask-composition-canvas")]
      (is (some? canvas))
      (px/mouse-click-in! app canvas 10 10 :right))
    (px/update! app)
    (is (= "ui/context-menu" (px/active-mode-name app)))
    (px/render! app)
    (let [remove-item (px/find-view-containing app
                                                    "ui/popup-menu-item"
                                                    ":command :remove")]
      (is (some? remove-item))
      (px/click! app remove-item))
    (px/update! app)
    (px/render! app)
    (is (= []
           (get-in (px/active-state app)
                   [:mask-sets 0 :masks 0 :source :tiles])))))

(deftest loaded-sprite-project-after-empty-tileset-tab-with-missing-image-renders-preview
  (cleanup-application-startup-test-files!)
  (io/spit-edn! MISSING-IMAGE-PATH
                {:format data/project-format
                 :version data/project-format-version
                 :resources {:bundles {:project-assets
                                       {:images {:missing
                                                 {:file-name "does-not-exist.png"
                                                  :name "Missing Spritesheet"}}}}}
                 :tilesets [{:id :sprites
                             :label "Sprites"
                             :tile-size 16
                             :tiles [{:id :sprite
                                      :name "Sprite"
                                      :char "s"
                                      :type :sprite
                                      :image :project-assets/missing
                                      :source {:x 0 :y 0 :w 16 :h 16}}]}]
                 :tilemap {:width 2
                           :height 2
                           :tile-size 16
                           :layers []}})
  (let [app (make-startup-app)
        open-payload (file-dialog-payload :file-dialog/open
                                          MISSING-IMAGE-PATH
                                          "sprite-project.edn")]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/set-active-state! app
                               (assoc (px/active-state app)
                                      :project-history-path MISSING-IMAGE-HISTORY-PATH
                                      :recent-projects []))
    (px/render! app)
    (let [tilesets-tab (px/find-view-containing app "ui/tab" ":tab-id :tilesets")]
      (is (some? tilesets-tab))
      (px/click! app tilesets-tab))
    (px/render! app)
    (px/push-mode-with-overrides!
     app
     'ui/tab-panel-empty
     nil
     {:origin {:view (px/active-mode app)
               :event :project/file-dialog-result}})
    (px/pop-mode! app open-payload)
    (px/update! app)
    (px/update! app)
    (px/render! app)
    (is (= "main-mode" (px/active-mode-name app)))
    (is (= :tilesets (:workspace-tab (px/active-state app))))
    (is (some? (px/find-view app "sprite-source-preview"))))
  (cleanup-application-startup-test-files!))
