(ns tilemap-editor.io.project-test
  (:require proof.core
            [tilemap-editor.io.project :as project-io]))

(deftest recent-project-history-promotes-existing-projects
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}
                  {:path "second.edn"
                   :filename "second.edn"}
                  {:path "third.edn"
                   :filename "third.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "second.edn"
                   :filename "second.edn"})]
    (is (= ["second.edn" "first.edn" "third.edn"]
           (map promoted :path)))))

(deftest recent-project-history-adds-new-projects-first
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "new.edn"
                   :filename "new.edn"})]
    (is (= ["new.edn" "first.edn"]
           (map promoted :path)))))

(deftest recent-projects-from-document-normalizes-blank-directories
  (is (= [{:path "/tmp/project/map.edn"
           :directory "/tmp/project"
           :filename "map.edn"}]
         (project-io/recent-projects-from-document
          {:projects [{:path "/tmp/project/map.edn"
                       :directory ""
                       :filename "map.edn"}]}))))
