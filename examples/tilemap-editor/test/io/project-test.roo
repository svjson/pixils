(ns tilemap-editor.io.project-test
  (:require proof.core
            [tilemap-editor.io.project :as project-io]))

(deftest project-tilesets-come-from-project-document
  (is (= [{:id :terrain}]
         (project-io/project-tilesets {:tilesets [{:id :terrain}]})))
  (is (= [] (project-io/project-tilesets {}))))

(deftest project-terrain-sets-come-from-project-document
  (is (= [{:id :overworld}]
         (project-io/project-terrain-sets
          {:terrain-sets [{:id :overworld}]})))
  (is (= [] (project-io/project-terrain-sets {}))))

(deftest project-rulesets-come-from-project-document
  (is (= [{:id :grass-marching}]
         (project-io/project-rulesets
          {:rulesets [{:id :grass-marching}]})))
  (is (= [] (project-io/project-rulesets {}))))

(deftest project-brushes-come-from-project-document
  (is (= [{:id :brush}]
         (project-io/project-brushes {:brushes [{:id :brush}]})))
  (is (= [] (project-io/project-brushes {}))))

(deftest recent-project-history-promotes-existing-projects
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}
                  {:path "second.edn"
                   :filename "second.edn"}
                  {:path "third.edn"
                   :filename "third.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "second.edn"
                   :filename "second.edn"})]
    (is (= ["second.edn" "first.edn" "third.edn"]
           (map promoted :path)))))

(deftest recent-project-history-adds-new-projects-first
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "new.edn"
                   :filename "new.edn"})]
    (is (= ["new.edn" "first.edn"]
           (map promoted :path)))))
