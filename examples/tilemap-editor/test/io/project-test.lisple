(ns tilemap-editor.io.project-test
  (:require proof.core
            [lisple.io :as io]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.io.project :as project-io]))

(def EXAMPLE-MAP-PATH "example-maps/map1.edn")
(def SAVE-PATH "/tmp/pixils-tilemap-editor-save-test.edn")
(def EXCLUSIVE-SAVE-PATH "/tmp/pixils-tilemap-editor-exclusive-rule-save-test.edn")
(def SAVE-HISTORY-PATH "/tmp/pixils-tilemap-editor-save-history-test.edn")
(def HISTORY-PATH "/tmp/pixils-tilemap-editor-history-test.edn")
(def OPEN-PATH "/tmp/pixils-tilemap-editor-open-test.edn")

(defun remove-file-if-exists! [path]
  (if (io/exists? path)
    (io/remove-tree! path)
    nil))

(defun cleanup-project-io-test-files! []
  (do
    (remove-file-if-exists! SAVE-PATH)
    (remove-file-if-exists! EXCLUSIVE-SAVE-PATH)
    (remove-file-if-exists! SAVE-HISTORY-PATH)
    (remove-file-if-exists! HISTORY-PATH)
    (remove-file-if-exists! OPEN-PATH)))

(defun file-dialog-payload [mode path filename]
  {:type :confirm
   :mode mode
   :path path
   :directory "/tmp"
   :filename filename})

(defun layer-tile-refs [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter row (fn [tile-ref]
                                  (not (nil? tile-ref))))))))

(defun invalid-tile-ref-entries [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter (for-indexed [x tile-ref row]
                              {:layer (:id layer)
                               :x x
                               :ref tile-ref
                               :type (type-of tile-ref)})
                            (fn [entry]
                              (and (not (nil? (:ref entry)))
                                   (not (keyword? (:ref entry)))
                                   (not (number? (:ref entry))))))))))

(defun unresolved-tile-refs [tilesets layer]
  (let [tileset (:tileset layer)]
    (filter (layer-tile-refs layer)
            (fn [tile-ref]
              (nil? (data/tile-in tilesets tileset tile-ref))))))

(defun sprite-tiles-without-source [tilesets layer]
  (let [tileset (:tileset layer)]
    (filter (map (layer-tile-refs layer)
                 (fn [tile-ref]
                   (data/tile-in tilesets tileset tile-ref)))
            (fn [tile]
              (and (= (:type tile) :sprite)
                   (nil? (:source tile)))))))

(defun tileset-image-refs [tilesets]
  (reduce (or tilesets [])
          []
          (fn [result tileset]
            (concat result
                    (map (filter (or (:tiles tileset) [])
                                 (fn [tile]
                                   (= (:type tile) :sprite)))
                         :image)))))

(defun project-open-state []
  (project-io/apply-project-file-dialog-result
   {:layers (data/make-layered-map)
    :selected-layer-index 0
    :hidden-layer-indices []}
   {:type :confirm
    :mode :file-dialog/open
    :path EXAMPLE-MAP-PATH
    :directory "example-maps"
    :filename "map1.edn"}))

(deftest project-tilesets-come-from-project-document
  (is (= [{:id :terrain}]
         (project-io/project-tilesets {:tilesets [{:id :terrain}]})))
  (is (= [] (project-io/project-tilesets {}))))

(deftest project-terrain-sets-come-from-project-document
  (is (= [{:id :overworld}]
         (project-io/project-terrain-sets
          {:terrain-sets [{:id :overworld}]})))
  (is (= [] (project-io/project-terrain-sets {}))))

(deftest project-rulesets-come-from-project-document
  (is (= [{:id :grass-marching}]
         (project-io/project-rulesets
          {:rulesets [{:id :grass-marching}]})))
  (is (= [] (project-io/project-rulesets {}))))

(deftest project-brushes-come-from-project-document
  (is (= [{:id :brush}]
         (project-io/project-brushes {:brushes [{:id :brush}]})))
  (is (= [] (project-io/project-brushes {}))))

(deftest project-layer-profiles-default_from_legacy_layers
  (let [profiles (project-io/project-layer-profiles
                  {:tilemap {:layers [{:id :scene/ground
                                       :label "Ground"
                                       :tileset :terrain
                                       :tiles [[:grass]]}]}})]
    (is (= data/default-layer-profile-id
           (:id (head profiles))))
    (is (= :scene/ground
           (get-in profiles [0 :layers 0 :id])))
    (is (= :source
           (get-in profiles [0 :layers 0 :role])))
    (is (= :tile-ref
           (get-in profiles [0 :layers 0 :data-kind])))))

(deftest project-selected-map-reads_selected_map_from_multi_map_document
  (let [project (data/normalize-project-document
                 {:format data/project-format
                  :selected-map :map/cave
                  :maps [{:id :map/overworld
                          :layers []}
                         {:id :map/cave
                          :width 18
                          :height 11
                          :layers [{:id :scene/cave
                                    :tiles [[:rock]]}]}]})
        selected (project-io/project-selected-map project)]
    (is (= :map/cave (:id selected)))
    (is (= 18 (:width selected)))
    (is (= :scene/cave (get-in selected [:layers 0 :id])))))

(deftest recent-project-history-promotes-existing-projects
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}
                  {:path "second.edn"
                   :filename "second.edn"}
                  {:path "third.edn"
                   :filename "third.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "second.edn"
                   :filename "second.edn"})]
    (is (= ["second.edn" "first.edn" "third.edn"]
           (map promoted :path)))))

(deftest recent-project-history-adds-new-projects-first
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "new.edn"
                   :filename "new.edn"})]
    (is (= ["new.edn" "first.edn"]
           (map promoted :path)))))

(deftest save-dialog-result-writes-project-edn
  (do
    (cleanup-project-io-test-files!)
    (project-io/apply-project-file-dialog-result
     {:layers (data/make-layered-map)}
     (file-dialog-payload :file-dialog/save SAVE-PATH "saved-project.edn"))
    (let [document (io/slurp-edn! SAVE-PATH)]
      (is (= data/project-format (:format document)))
      (is (= data/project-format-version (:version document)))
      (is (= {:bundles {}} (:resources document)))
      (is (= [] (:tilesets document)))
      (is (= data/default-map-id (:selected-map document)))
      (is (= [] (get-in document [:maps 0 :layers]))))
    (cleanup-project-io-test-files!)))

(deftest save-and-open-round-trips-terrain-rule-exclusive-flag
  (do
    (cleanup-project-io-test-files!)
    (project-io/apply-project-file-dialog-result
     {:layers []
      :rulesets [{:id :overworld-rules
                  :kind :terrain-stamp
                  :terrain-set :overworld
                  :rules [{:id :edge
                           :terrain :grass
                           :exclusive? true
                           :output {:layers []}}]}]}
     (file-dialog-payload :file-dialog/save
                          EXCLUSIVE-SAVE-PATH
                          "exclusive-rule-project.edn"))
    (let [document (io/slurp-edn! EXCLUSIVE-SAVE-PATH)
          state (project-io/apply-project-file-dialog-result
                 {:layers []
                  :selected-layer-index nil}
                 (file-dialog-payload :file-dialog/open
                                      EXCLUSIVE-SAVE-PATH
                                      "exclusive-rule-project.edn"))]
      (is (= true (get-in document [:rulesets 0 :rules 0 :exclusive?])))
      (is (= true (get-in state [:rulesets 0 :rules 0 :exclusive?]))))
    (cleanup-project-io-test-files!)))

(deftest save-dialog-result-updates-recent-projects
  (do
    (cleanup-project-io-test-files!)
    (let [payload (file-dialog-payload :file-dialog/save
                                       SAVE-HISTORY-PATH
                                       "saved-history-project.edn")
          entry {:path SAVE-HISTORY-PATH
                 :directory "/tmp"
                 :filename "saved-history-project.edn"}
          state (project-io/apply-project-file-dialog-result
                 {:layers []
                  :recent-projects []
                  :project-history-path HISTORY-PATH}
                 payload)
          history (io/slurp-edn! HISTORY-PATH)]
      (is (= [entry] (:recent-projects state)))
      (is (= [entry] (:projects history))))
    (cleanup-project-io-test-files!)))

(deftest open-dialog-result-loads-project-edn-layers
  (do
    (cleanup-project-io-test-files!)
    (io/spit-edn! OPEN-PATH
                  {:format data/project-format
                   :version data/project-format-version
                   :resources {:images {:editor-assets/spritesheet
                                        {:file-name "assets/simples_pimples.png"}}}
                   :tilesets []
                   :tilemap {:width 2
                             :height 2
                             :tile-size 16
                             :layers [{:id :scene/background
                                       :label "Loaded Background"
                                       :kind :tile
                                       :tileset :colors
                                       :order 0
                                       :tiles [[:night :void]
                                               [:void :night]]}]}})
    (let [payload (file-dialog-payload :file-dialog/open
                                       OPEN-PATH
                                       "loaded-project.edn")
          state (project-io/apply-project-file-dialog-result
                 {:layers (data/make-layered-map)
                  :selected-layer-index 2
                  :hidden-layer-indices [1 2]}
                 payload)]
      (is (= OPEN-PATH (:project-path state)))
      (is (= "Loaded Background" (get-in state [:layers 0 :label])))
      (is (= [] (:tilesets state)))
      (is (= 0 (:selected-layer-index state)))
      (is (= [] (:hidden-layer-indices state)))
      (is (= payload (:last-project-open-result state))))
    (cleanup-project-io-test-files!)))

(deftest example-map-loads-through-open-project-path
  (let [state (project-open-state)]
    (is (= 4 (count (:layers state))))
    (is (= 4 (count (:tilesets state))))
    (is (= data/default-layer-profile-id (:selected-layer-profile-id state)))
    (is (= 4 (count (get-in state [:layer-profiles 0 :layers]))))
    (is (= "Background" (:selected-layer-label state)))
    (is (= :colors (:tileset state)))
    (is (= :night (:selected-tile state)))))

(deftest example-map-owns-its-image-resource
  (let [state (project-open-state)
        image-refs (tileset-image-refs (:tilesets state))]
    (is (= "../assets/simples_pimples.png"
           (get-in state
                   [:resources
                    :bundles
                    :project-assets
                    :images
                    :simples-pimples
                    :file-name])))
    (is (= [] (filter image-refs
                      (fn [image]
                        (= image :editor-assets/spritesheet)))))
    (is (> (count image-refs) 0))
    (is (= [] (filter image-refs
                      (fn [image]
                        (not= image :project-assets/simples-pimples)))))))

(deftest example-map-layer-tile-references-resolve-to-renderable-tiles
  (let [state (project-open-state)]
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (invalid-tile-ref-entries layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (unresolved-tile-refs (:tilesets state) layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result
                             (sprite-tiles-without-source (:tilesets state) layer))))))))
