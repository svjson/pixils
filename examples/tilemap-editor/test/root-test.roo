(ns tilemap-editor.root-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.tilemap.project.model :as data]
            [pixils.test :as px]
            [tilemap-editor.model.workbook :as editor-workbook]
            tilemap-editor.root))

(defun map-layer [id tile]
  {:id id
   :label (str id)
   :role :source
   :data-kind :tile-ref
   :tileset :terrain
   :tiles [[tile]]})

(defun map-edit-state []
  {:maps [{:id :map/one
           :label "One"
           :width 1
           :height 1
           :tile-size data/tile-size
           :layer-profile :default
           :layers [(map-layer :scene/ground :grass)]}
          {:id :map/two
           :label "Two"
           :width 1
           :height 1
           :tile-size data/tile-size
           :layer-profile :default
           :layers [(map-layer :scene/ground :water)]}]
   :selected-map-id :map/one
   :selected-map-label "One"
   :map-width 1
   :map-height 1
   :tile-size data/tile-size
   :layer-profiles [{:id :default
                     :label "Default"
                     :layers [{:id :scene/ground
                               :role :source
                               :data-kind :tile-ref
                               :tileset :terrain}]}]
   :selected-layer-profile-id :default
   :selected-layer-index 0
   :selected-layer-label "Ground"
   :hidden-layer-indices []
   :map-offset {:x 0 :y 0}
   :layers [(map-layer :scene/ground :edited)]
   :show-terrain-rules? false})

(deftest root-registers-main-mode
  (is (not (nil? (get pixils/modes 'main-mode)))))

(deftest property-sets-tab-is-last-workspace-tab
  (let [app (px/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600})]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/render! app)
    (let [tabs (px/find-views app "ui/tab")]
      (is (= :map (:tab-id (px/view-state (nth tabs 0)))))
      (is (= :tilesets (:tab-id (px/view-state (nth tabs 1)))))
      (is (= :brushes (:tab-id (px/view-state (nth tabs 2)))))
      (is (= :resources (:tab-id (px/view-state (nth tabs 3)))))
      (is (= :masks (:tab-id (px/view-state (nth tabs 4)))))
      (is (= :terrains (:tab-id (px/view-state (nth tabs 5)))))
      (is (= :property-sets (:tab-id (px/view-state (nth tabs 6))))))))

(deftest status-bar-renders-at-root
  (let [app (px/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600})]
    (px/push-mode! app 'main-mode)
    (px/update! app)
    (px/render! app)
    (is (not (nil? (px/find-view app "status-bar"))))))

(deftest map-coordinate-status-formats-hover-cell
  (is (= "Cell -" (tilemap-editor.root/map-coordinate-status nil)))
  (is (= "Cell 3,4"
         (tilemap-editor.root/map-coordinate-status {:x 3 :y 4}))))

(deftest transition-mask-diagnostics-status-formats-counts
  (is (= "Transitions -"
         (tilemap-editor.root/transition-mask-diagnostics-status nil)))
  (is (= "Transitions m:2 g:1 f:1"
         (tilemap-editor.root/transition-mask-diagnostics-status
          {:has-transition-mask-rules? true
           :matched-transition-entries 2
           :generated-transition-entries 1
           :failed-transition-entries 1}))))

(deftest tileset-shortcut-request-switches-tab-before-dialog
  (let [state (tilemap-editor.root/request-tileset-shortcut-dialog
               {:workspace-tab :map
                :pending-tileset-shortcut-dialog? false})]
    (is (= :tilesets (:workspace-tab state)))
    (is (= true (:pending-tileset-shortcut-dialog? state)))))

(deftest workspace-tab-switch-remembers-and-restores-terrain-and-mask-view-state
  (let [state {:workspace-tab :terrains
               :selected-terrain-set-index 1
               :selected-terrain-index 2
               :terrain-detail-tab :terrain
               :terrain-rule-editor-tab :setups
               :terrain-standard-output-picker-tab :masks
               :terrain-standard-opposing [:road
                                           :water]
               :selected-mask-set-index 0
               :selected-mask-index 3
               :workspace-view-state {:masks {:selected-mask-set-index 4
                                              :selected-mask-index 5
                                              :selected-mask-source-tile :edge
                                              :selected-mask-tile-item-index 1
                                              :mask-detail-tab :mask}}}
        state (tilemap-editor.root/select-workspace-tab state :masks)
        state (assoc state
                     :selected-mask-set-index 6
                     :selected-mask-index 7
                     :selected-mask-source-tile :corner
                     :selected-mask-tile-item-index 2
                     :mask-detail-tab :mask-set)
        state (tilemap-editor.root/select-workspace-tab state :terrains)]
    (is (= :terrains (:workspace-tab state)))
    (is (= 1 (:selected-terrain-set-index state)))
    (is (= 2 (:selected-terrain-index state)))
    (is (= :terrain (:terrain-detail-tab state)))
    (is (= :setups (:terrain-rule-editor-tab state)))
    (is (= :masks (:terrain-standard-output-picker-tab state)))
    (is (= [:road :water] (:terrain-standard-opposing state)))
    (is (= 0 (:selected-mask-set-index state)))
    (is (= 3 (:selected-mask-index state)))
    (is (= {:selected-mask-set-index 6
            :selected-mask-index 7
            :selected-mask-source-tile :corner
            :selected-mask-tile-item-index 2
            :mask-detail-tab :mask-set}
           (get-in state [:workspace-view-state :masks])))))

(deftest tileset-shortcut-dialog-result-adds-tileset
  (let [state (tilemap-editor.root/apply-tileset-shortcut-dialog-result
               {:tilesets []
                :selected-tileset-definition-index nil}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 24})]
    (is (= :terrain (get-in state [:tilesets 0 :id])))
    (is (= "Terrain" (get-in state [:tilesets 0 :label])))
    (is (= {:w 24 :h 24} (get-in state [:tilesets 0 :tile-size])))
    (is (= 0 (:selected-tileset-definition-index state)))))

(deftest map-dialog-result-records-workbook-change
  (let [state (tilemap-editor.root/apply-map-dialog-result
               (map-edit-state)
               {:type :confirm
                :id "map/start"
                :name "Start"
                :context {:operation :rename
                          :map-id :map/one}})
        undone (editor-workbook/undo state)]
    (is (= :map/start (:selected-map-id state)))
    (is (= "Start" (:selected-map-label state)))
    (is (= "Rename map" (editor-workbook/undo-label state)))
    (is (= :map/one (:selected-map-id undone)))
    (is (= "One" (:selected-map-label undone)))
    (is (= :map/one (get-in undone [:maps 0 :id])))))

(deftest map-delete-result-records-workbook-change
  (let [state (tilemap-editor.root/apply-map-delete-dialog-result
               (map-edit-state)
               {:choice :dialog/ok
                :payload {:map-id :map/one}})
        undone (editor-workbook/undo state)]
    (is (= 1 (count (:maps state))))
    (is (= :map/two (:selected-map-id state)))
    (is (= "Delete map" (editor-workbook/undo-label state)))
    (is (= 2 (count (:maps undone))))
    (is (= :map/one (:selected-map-id undone)))))

(deftest map-dimensions-result-records-workbook-change
  (let [state (tilemap-editor.root/apply-map-dimensions-dialog-result
               (map-edit-state)
               {:type :confirm
                :width 3
                :height 2
                :tile-size 32})
        undone (editor-workbook/undo state)]
    (is (= 3 (:map-width state)))
    (is (= 2 (:map-height state)))
    (is (= {:w 32 :h 32} (:tile-size state)))
    (is (= "Change map dimensions" (editor-workbook/undo-label state)))
    (is (= 1 (:map-width undone)))
    (is (= 1 (:map-height undone)))
    (is (= data/tile-size (:tile-size undone)))))

(deftest apply-mutation/records-terrain-rule-changes-in-workbook-history
  (s/when []
    (let [changed
          (tilemap-editor.root/apply-mutation
           {:terrain-sets [{:id :overworld
                            :terrains [{:id :grass}]}]
            :selected-terrain-set-index 0
            :selected-terrain-index 0
            :rulesets [{:id :overworld-rules
                        :terrain-set :overworld
                        :rules [{:id :rule
                                 :label "Rule"
                                 :terrain :grass
                                 :exclusive? false}]}]
            :selected-terrain-ruleset-id :overworld-rules
            :selected-terrain-rule-id :rule}
           {:label "Change terrain rule options"
            :op :value/set
            :target {:path [:rulesets 0 :rules 0]}
            :args {:value {:id :rule
                           :label "Rule"
                           :terrain :grass
                           :exclusive? true}}})]
      {:changed changed
       :undone (editor-workbook/undo changed)}))

  (s/then [{:keys [changed undone]}]
    (is (= {:exclusive? true
            :undo-label "Change terrain rule options"
            :undone-exclusive? false}
           {:exclusive? (get-in changed
                                [:rulesets 0 :rules 0 :exclusive?])
            :undo-label (editor-workbook/undo-label changed)
            :undone-exclusive? (get-in undone
                                       [:rulesets 0 :rules 0 :exclusive?])}))))

(deftest theme-selection-updates-state-and-queues-runtime-theme-switch
  (let [message-index (count pixils/mode-stack-messages)
        state (tilemap-editor.root/apply-theme-selection!
               {:application-theme :pixils/windows-3}
               {:value :pixils/windows-95
                :theme 'pixils/windows-95})
        message (nth pixils/mode-stack-messages message-index)]
    (is (= :pixils/windows-95 (:application-theme state)))
    (is (= :theme (:type message)))
    (is (= 'pixils/windows-95 (:theme message)))))

(deftest theme-selection-passes-variant-to-runtime-theme-switch
  (let [message-index (count pixils/mode-stack-messages)
        state (tilemap-editor.root/apply-theme-selection!
               {:application-theme :pixils/windows-3}
               {:value :pixils/windows-3-dark
                :theme 'pixils/windows-3
                :variant :dark})
        message (nth pixils/mode-stack-messages message-index)]
    (is (= :pixils/windows-3-dark (:application-theme state)))
    (is (= :theme (:type message)))
    (is (= 'pixils/windows-3 (:theme message)))
    (is (= :dark (:theme-variant message)))))
