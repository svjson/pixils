(ns tilemap-editor.root-test
  (:require proof.core
            [pixils.test.runtime :as runtime]
            tilemap-editor.root))

(deftest root-registers-main-mode
  (is (not (nil? (get pixils/modes 'main-mode)))))

(deftest property-sets-tab-is_last_workspace_tab
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600})]
    (runtime/push-mode! app 'main-mode)
    (runtime/update! app)
    (runtime/render! app)
    (let [tabs (runtime/find-views app "ui/tab")]
      (is (= :map (:tab-id (runtime/view-state (nth tabs 0)))))
      (is (= :tilesets (:tab-id (runtime/view-state (nth tabs 1)))))
      (is (= :brushes (:tab-id (runtime/view-state (nth tabs 2)))))
      (is (= :resources (:tab-id (runtime/view-state (nth tabs 3)))))
      (is (= :masks (:tab-id (runtime/view-state (nth tabs 4)))))
      (is (= :terrains (:tab-id (runtime/view-state (nth tabs 5)))))
      (is (= :property-sets (:tab-id (runtime/view-state (nth tabs 6))))))))

(deftest status-bar-renders_at_root
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600})]
    (runtime/push-mode! app 'main-mode)
    (runtime/update! app)
    (runtime/render! app)
    (is (not (nil? (runtime/find-view app "status-bar"))))))

(deftest map-coordinate-status-formats_hover_cell
  (is (= "Cell -" (tilemap-editor.root/map-coordinate-status nil)))
  (is (= "Cell 3,4"
         (tilemap-editor.root/map-coordinate-status {:x 3 :y 4}))))

(deftest transition-mask-diagnostics-status-formats_counts
  (is (= "Transitions -"
         (tilemap-editor.root/transition-mask-diagnostics-status nil)))
  (is (= "Transitions m:2 g:1 f:1"
         (tilemap-editor.root/transition-mask-diagnostics-status
          {:has-transition-mask-rules? true
           :matched-transition-entries 2
           :generated-transition-entries 1
           :failed-transition-entries 1}))))

(deftest tileset-shortcut-request-switches_tab_before_dialog
  (let [state (tilemap-editor.root/request-tileset-shortcut-dialog
               {:workspace-tab :map
                :pending-tileset-shortcut-dialog? false})]
    (is (= :tilesets (:workspace-tab state)))
    (is (= true (:pending-tileset-shortcut-dialog? state)))))

(deftest workspace-tab-switch-remembers_and_restores_terrain_and_mask_view_state
  (let [state {:workspace-tab :terrains
               :selected-terrain-set-index 1
               :selected-terrain-index 2
               :terrain-detail-tab :terrain
               :terrain-rule-editor-tab :setups
               :terrain-standard-output-picker-tab :masks
               :terrain-standard-opposing [:road
                                           :water]
               :selected-mask-set-index 0
               :selected-mask-index 3
               :workspace-view-state {:masks {:selected-mask-set-index 4
                                              :selected-mask-index 5
                                              :selected-mask-source-tile :edge
                                              :selected-mask-tile-item-index 1
                                              :mask-detail-tab :mask}}}
        state (tilemap-editor.root/select-workspace-tab state :masks)
        state (assoc state
                     :selected-mask-set-index 6
                     :selected-mask-index 7
                     :selected-mask-source-tile :corner
                     :selected-mask-tile-item-index 2
                     :mask-detail-tab :mask-set)
        state (tilemap-editor.root/select-workspace-tab state :terrains)]
    (is (= :terrains (:workspace-tab state)))
    (is (= 1 (:selected-terrain-set-index state)))
    (is (= 2 (:selected-terrain-index state)))
    (is (= :terrain (:terrain-detail-tab state)))
    (is (= :setups (:terrain-rule-editor-tab state)))
    (is (= :masks (:terrain-standard-output-picker-tab state)))
    (is (= [:road :water] (:terrain-standard-opposing state)))
    (is (= 0 (:selected-mask-set-index state)))
    (is (= 3 (:selected-mask-index state)))
    (is (= {:selected-mask-set-index 6
            :selected-mask-index 7
            :selected-mask-source-tile :corner
            :selected-mask-tile-item-index 2
            :mask-detail-tab :mask-set}
           (get-in state [:workspace-view-state :masks])))))

(deftest tileset-shortcut-dialog-result-adds_tileset
  (let [state (tilemap-editor.root/apply-tileset-shortcut-dialog-result
               {:tilesets []
                :selected-tileset-definition-index nil}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 24})]
    (is (= :terrain (get-in state [:tilesets 0 :id])))
    (is (= "Terrain" (get-in state [:tilesets 0 :label])))
    (is (= {:w 24 :h 24} (get-in state [:tilesets 0 :tile-size])))
    (is (= 0 (:selected-tileset-definition-index state)))))

(deftest theme-selection-updates_state_and_queues_runtime_theme_switch
  (let [message-index (count pixils/mode-stack-messages)
        state (tilemap-editor.root/apply-theme-selection!
               {:application-theme :pixils/windows-3}
               {:value :pixils/windows-95
                :theme 'pixils/windows-95})
        message (nth pixils/mode-stack-messages message-index)]
    (is (= :pixils/windows-95 (:application-theme state)))
    (is (= :theme (:type message)))
    (is (= 'pixils/windows-95 (:theme message)))))

(deftest theme-selection-passes_variant_to_runtime_theme_switch
  (let [message-index (count pixils/mode-stack-messages)
        state (tilemap-editor.root/apply-theme-selection!
               {:application-theme :pixils/windows-3}
               {:value :pixils/windows-3-dark
                :theme 'pixils/windows-3
                :variant :dark})
        message (nth pixils/mode-stack-messages message-index)]
    (is (= :pixils/windows-3-dark (:application-theme state)))
    (is (= :theme (:type message)))
    (is (= 'pixils/windows-3 (:theme message)))
    (is (= :dark (:theme-variant message)))))
