(ns tilemap-editor.model.derivation-test
  (:require proof.core
            [tilemap-editor.model.data :as data]
            [tilemap-editor.model.derivation :as derivation]))

(defun terrain-row [values]
  (concat values (dotimes [x (- data/map-width (count values))] nil)))

(defun terrain-map [rows]
  (concat (map rows terrain-row)
          (dotimes [y (- data/map-height (count rows))]
            (data/make-empty-row))))

(defun terrain-layer [tiles]
  {:id :scene/terrain
   :label "Terrain"
   :role :source
   :data-kind :terrain
   :terrain-set :overworld
   :tiles tiles})

(def marching-ruleset
  {:id :grass-marching
   :kind :marching-4
   :source-layer :scene/terrain
   :terrain :grass
   :output-tileset :overworld
   :tiles-by-mask {0 :grass-0
                   1 :grass-n
                   2 :grass-e
                   3 :grass-ne
                   4 :grass-s
                   5 :grass-ns
                   6 :grass-es
                   7 :grass-nes
                   8 :grass-w
                   9 :grass-nw
                   10 :grass-ew
                   11 :grass-new
                   12 :grass-sw
                   13 :grass-nsw
                   14 :grass-esw
                   15 :grass-fill}})

(def derived-definition
  {:id :scene/terrain-visuals
   :label "Terrain Visuals"
   :role :derived
   :kind :marching-4
   :source-layers [:scene/terrain]
   :ruleset :grass-marching
   :persistence :ephemeral})

(deftest marching-4-mask-uses_cardinal_neighbor_bits
  (let [layer (terrain-layer (terrain-map [[nil :grass nil]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))]
    (is (= 15 (derivation/marching-4-mask layer :grass 1 1)))
    (is (= 4 (derivation/marching-4-mask layer :grass 1 0)))))

(deftest marching-4-derives_tile_refs_for_matching_terrain
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))
        tilemap {:layers [source]}
        layer-profile {:id :default
                       :layers [source derived-definition]}
        derived (derivation/derive-layer tilemap
                                         layer-profile
                                         [marching-ruleset]
                                         :scene/terrain-visuals)]
    (is (= :scene/terrain-visuals (:id derived)))
    (is (= :derived (:role derived)))
    (is (= :tile-ref (:data-kind derived)))
    (is (= :overworld (:tileset derived)))
    (is (= :grass-fill (get-in derived [:tiles 1 1])))
    (is (= :grass-s (get-in derived [:tiles 0 1])))
    (is (nil? (get-in derived [:tiles 0 0])))))

(deftest render-layers-projects_source_and_derived_profile_layers
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))
        tilemap {:layers [source]}
        layer-profile {:id :default
                       :layers [source derived-definition]}
        layers (derivation/render-layers tilemap
                                         layer-profile
                                         [marching-ruleset])]
    (is (= [:scene/terrain :scene/terrain-visuals]
           (map layers :id)))
    (is (= :terrain (get-in layers [0 :data-kind])))
    (is (= :tile-ref (get-in layers [1 :data-kind])))
    (is (= :grass-fill (get-in layers [1 :tiles 1 1])))))

(deftest render-layers-uses_materialized_derived_layer_when_declared
  (let [source (terrain-layer (terrain-map [[:grass]]))
        materialized {:id :scene/terrain-visuals
                      :role :derived
                      :data-kind :tile-ref
                      :tileset :overworld
                      :tiles (terrain-map [[:materialized]])}
        definition (assoc derived-definition :persistence :materialized)
        tilemap {:layers [source materialized]}
        layer-profile {:id :default
                       :layers [source definition]}
        layers (derivation/render-layers tilemap
                                         layer-profile
                                         [marching-ruleset])]
    (is (= :materialized
           (get-in layers [1 :tiles 0 0])))))

(def terrain-stamp-ruleset
  {:id :shore-rules
   :kind :terrain-stamp
   :terrain-set :overworld
   :source-layer :scene/terrain
   :rules [{:id :grass-north-water
            :terrain :grass
            :match {:n {:terrain :water}
                    :e :ignore
                    :s :same
                    :w :ignore}
            :output {:anchor {:x 1 :y 1}
                     :layers [{:target-layer :scene/terrain-visuals
                               :tileset :overworld
                               :tiles [[nil :shore-n nil]
                                       [nil :grass-fill :grass-edge-e]
                                       [nil nil nil]]}
                              {:target-layer :scene/decor
                               :tileset :decor
                               :tiles [[nil nil nil]
                                       [:foam nil nil]
                                       [nil nil nil]]}]}}]})

(deftest terrain-stamp-rules-match_8_neighbor_conditions
  (let [source (terrain-layer (terrain-map [[:water :water :water]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))
        rule (head (:rules terrain-stamp-ruleset))]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))
    (is (= false
           (derivation/terrain-stamp-rule-matches? source rule 0 1)))))

(deftest terrain-stamp-none_matches_empty_cells
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil nil nil]]))
        rule {:id :grass-edge-south
              :terrain :grass
              :match {:n :same
                      :s :none}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-not_same_rejects_empty_cells
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil nil nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :not-same}}]
    (is (= false
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-not_same_rejects_same_terrain
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil :grass nil]]))
        rule {:id :grass-edge-south
              :terrain :grass
              :match {:n :same
                      :s :not-same}}]
    (is (= false
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-not_same_matches_different_terrain
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil :water nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :not-same}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-any_terrain_matches_same_terrain
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil :grass nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :any-terrain}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-any_terrain_rejects_empty_cells
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil nil nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :any-terrain}}]
    (is (= false
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-other_terrain_rejects_empty_cells
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil nil nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :other-terrain}}]
    (is (= false
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-other_terrain_matches_different_terrain
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]
                                           [nil :water nil]]))
        rule {:id :grass-neighbor-south
              :terrain :grass
              :match {:n :same
                      :s :other-terrain}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-signature_source_matches_adjacent_tile_ownership
  (let [source {:id :scene/visuals
                :data-kind :terrain-signature
                :terrain-set :overworld
                :tiles (terrain-map [[nil :water-fill nil]
                                     [nil :grass-fill nil]])
                :terrain-signatures-by-tile
                {:grass-fill (derivation/solid-terrain-signature :grass)
                 :water-fill (derivation/solid-terrain-signature :water)}}
        rule {:id :grass-north-water
              :terrain :grass
              :match {:n {:terrain :water}}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-signature_source_uses_current_tile_edge_ownership
  (let [source {:id :scene/visuals
                :data-kind :terrain-signature
                :terrain-set :overworld
                :tiles (terrain-map [[nil nil nil]
                                     [nil :grass-edge-n nil]])
                :terrain-signatures-by-tile
                {:grass-edge-n (assoc (derivation/solid-terrain-signature :grass)
                                      :n
                                      :none)}}
        rule {:id :grass-north-empty
              :terrain :grass
              :match {:n :none}}]
    (is (= true
           (derivation/terrain-stamp-rule-matches? source rule 1 1)))))

(deftest terrain-stamp-derives_offset_outputs_for_target_layer
  (let [source (terrain-layer (terrain-map [[:water :water :water]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))
        tilemap {:layers [source]}
        layer-profile {:id :default
                       :layers [source
                                {:id :scene/terrain-visuals
                                 :label "Terrain Visuals"
                                 :role :derived
                                 :kind :terrain-stamp
                                 :data-kind :tile-ref
                                 :tileset :overworld
                                 :source-layers [:scene/terrain]
                                 :ruleset :shore-rules}
                                {:id :scene/decor
                                 :label "Decor"
                                 :role :derived
                                 :kind :terrain-stamp
                                 :data-kind :tile-ref
                                 :tileset :decor
                                 :source-layers [:scene/terrain]
                                 :ruleset :shore-rules}]}
        terrain-visuals (derivation/derive-layer tilemap
                                                 layer-profile
                                                 [terrain-stamp-ruleset]
                                                 :scene/terrain-visuals)
        decor (derivation/derive-layer tilemap
                                       layer-profile
                                       [terrain-stamp-ruleset]
                                       :scene/decor)]
    (is (= :shore-n (get-in terrain-visuals [:tiles 0 1])))
    (is (= :grass-fill (get-in terrain-visuals [:tiles 1 1])))
    (is (= :grass-edge-e (get-in terrain-visuals [:tiles 1 2])))
    (is (= :foam (get-in decor [:tiles 1 0])))))

(deftest terrain-stamp-apply_patches_include_target_and_auto_outputs
  (let [source (terrain-layer (terrain-map [[:water :water :water]
                                           [:grass :grass :grass]
                                           [nil :grass nil]]))
        rule (assoc (head (:rules terrain-stamp-ruleset))
                    :output {:anchor {:x 1 :y 1}
                             :layers [{:target-layer :scene/terrain-visuals
                                       :tileset :overworld
                                       :tiles [[nil nil nil]
                                               [nil :grass-fill nil]
                                               [nil nil nil]]}
                                      {:tileset :overworld
                                       :tiles [[nil :grass-cap nil]
                                               [nil nil nil]
                                               [nil nil nil]]}]})
        ruleset (assoc terrain-stamp-ruleset
                       :rules [rule])
        patches (derivation/terrain-stamp-apply-patches-at source
                                                           ruleset
                                                           1
                                                           1)
        signature (derivation/default-terrain-signature-for-rule rule)]
    (is (= [:scene/terrain-visuals :shore-rules/overworld]
           (map patches (fn [patch]
                          (-> patch :output-layer :id)))))
    (is (= [{:x 1
             :y 1
             :tile :grass-fill
             :terrain-signature signature}]
           (:cells (head patches))))
    (is (= [{:x 1
             :y 0
             :tile :grass-cap
             :terrain-signature signature}]
           (:cells (nth patches 1))))))

(deftest terrain-stamp-apply_patches_ignore_non_matching_rules
  (let [source (terrain-layer (terrain-map [[nil nil nil]
                                           [nil :grass nil]]))
        patches (derivation/terrain-stamp-apply-patches-at
                 source
                 terrain-stamp-ruleset
                 1
                 1)]
    (is (= [] patches))))

(deftest terrain-stamp-apply_patches_stop_after_exclusive_match
  (let [source (terrain-layer (terrain-map [[nil nil nil]
                                           [nil :grass nil]]))
        ruleset (assoc terrain-stamp-ruleset
                       :rules [{:id :first
                                :terrain :grass
                                :exclusive? true
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :first nil]
                                                           [nil nil nil]]}]}}
                               {:id :second
                                :terrain :grass
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :second nil]
                                                           [nil nil nil]]}]}}])
        patches (derivation/terrain-stamp-apply-patches-at source
                                                           ruleset
                                                           1
                                                           1)]
    (is (= [[:first]]
           (map patches (fn [patch]
                          (map (:cells patch)
                               (fn [cell] (:tile cell)))))))))

(deftest terrain-stamp-derivation_continues_after_non_exclusive_match
  (let [source (terrain-layer (terrain-map [[nil nil nil]
                                           [nil :grass nil]]))
        definition {:id :scene/terrain-visuals}
        ruleset (assoc terrain-stamp-ruleset
                       :rules [{:id :first
                                :terrain :grass
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :first nil]
                                                           [nil nil nil]]}]}}
                               {:id :second
                                :terrain :grass
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :second nil]
                                                           [nil nil nil]]}]}}])
        tiles (derivation/derive-terrain-stamp-tiles source
                                                     definition
                                                     ruleset)]
    (is (= :second (get-in tiles [1 1])))))

(deftest terrain-stamp-derivation_stops_after_exclusive_match
  (let [source (terrain-layer (terrain-map [[nil nil nil]
                                           [nil :grass nil]]))
        definition {:id :scene/terrain-visuals}
        ruleset (assoc terrain-stamp-ruleset
                       :rules [{:id :first
                                :terrain :grass
                                :exclusive? true
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :first nil]
                                                           [nil nil nil]]}]}}
                               {:id :second
                                :terrain :grass
                                :output {:anchor {:x 1 :y 1}
                                         :layers [{:target-layer
                                                   :scene/terrain-visuals
                                                   :tileset :overworld
                                                   :tiles [[nil nil nil]
                                                           [nil :second nil]
                                                           [nil nil nil]]}]}}])
        tiles (derivation/derive-terrain-stamp-tiles source
                                                     definition
                                                     ruleset)]
    (is (= :first (get-in tiles [1 1])))))

(deftest terrain-stamp-clear_patches_use_output_footprints
  (let [source (terrain-layer (terrain-map [[nil nil nil]
                                           [nil :grass nil]]))
        patches (derivation/terrain-stamp-clear-patches-at
                 source
                 terrain-stamp-ruleset
                 1
                 1)]
    (is (= [:scene/terrain-visuals :scene/decor]
           (map patches (fn [patch]
                          (-> patch :output-layer :id)))))
    (is (= [{:x 1 :y 0 :tile nil :terrain-signature nil}
            {:x 1 :y 1 :tile nil :terrain-signature nil}
            {:x 2 :y 1 :tile nil :terrain-signature nil}]
           (:cells (head patches))))
    (is (= [{:x 0 :y 1 :tile nil :terrain-signature nil}]
           (:cells (nth patches 1))))))

(deftest render-layers-does_not_derive_implicit_terrain_stamp_layer
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]]))
        ruleset {:id :grass-column
                 :kind :terrain-stamp
                 :terrain-set :overworld
                 :rules [{:id :same-north
                          :terrain :grass
                          :match {:n :same}
                          :output {:anchor {:x 1 :y 1}
                                   :layers [{:tileset :overworld
                                             :tiles [[nil nil nil]
                                                     [nil :column-fill nil]
                                                     [nil nil nil]]}]}}]}
        layers (derivation/render-layers {:layers [source]}
                                         {:id :default
                                          :layers [source]}
                                         [ruleset])]
    (is (= [:scene/terrain]
           (map layers :id)))
    (is (= :grass (get-in layers [0 :tiles 1 1])))))

(deftest render-layers-renders_painted_terrain_stamp_layer
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]]))
        stamp-layer {:id :grass-column/overworld
                     :label "Grass Column"
                     :kind :tile
                     :role :derived
                     :data-kind :tile-ref
                     :tileset :overworld
                     :source-layers [:scene/terrain]
                     :ruleset :grass-column
                     :replaces-source? true
                     :persistence :ephemeral
                     :tiles (terrain-map [[nil nil nil]
                                          [nil :column-fill nil]])}
        layers (derivation/render-layers {:layers [source]
                                          :terrain-stamp-layers [stamp-layer]}
                                         {:id :default
                                          :layers [source]}
                                         [])]
    (is (= [:scene/terrain :grass-column/overworld]
           (map layers :id)))
    (is (= :grass (get-in layers [0 :tiles 0 1])))
    (is (nil? (get-in layers [0 :tiles 1 1])))
    (is (= :column-fill (get-in layers [1 :tiles 1 1])))))

(deftest render-layers-can_hide_painted_terrain_stamp_preview
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]]))
        stamp-layer {:id :grass-column/overworld
                     :label "Grass Column"
                     :kind :tile
                     :role :derived
                     :data-kind :tile-ref
                     :tileset :overworld
                     :source-layers [:scene/terrain]
                     :ruleset :grass-column
                     :replaces-source? true
                     :persistence :ephemeral
                     :tiles (terrain-map [[nil nil nil]
                                          [nil :column-fill nil]])}
        layers (derivation/render-layers {:layers [source]
                                          :terrain-stamp-layers [stamp-layer]
                                          :show-terrain-rules? false}
                                         {:id :default
                                          :layers [source]}
                                         [])]
    (is (= [:scene/terrain]
           (map layers :id)))
    (is (= :grass (get-in layers [0 :tiles 1 1])))))

(deftest render-layers-masks_source_terrain_for_materialized_stamp_target
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]]))
        visuals {:id :scene/visuals
                 :label "Visuals"
                 :role :source
                 :data-kind :tile-ref
                 :tileset :overworld
                 :tiles (terrain-map [[nil nil nil]
                                      [nil :column-fill nil]])}
        ruleset {:id :grass-column
                 :kind :terrain-stamp
                 :terrain-set :overworld
                 :rules [{:id :same-north
                          :terrain :grass
                          :match {:n :same}
                          :output {:anchor {:x 1 :y 1}
                                   :layers [{:target-layer :scene/visuals
                                             :tileset :overworld
                                             :tiles [[nil nil nil]
                                                     [nil :column-fill nil]
                                                     [nil nil nil]]}]}}]}
        replacement {:id :scene/visuals
                     :source-layers [:scene/terrain]
                     :target-layer :scene/visuals
                     :replaces-source? true
                     :tiles (terrain-map [[nil nil nil]
                                          [nil true nil]])}
        layers (derivation/render-layers {:layers [source visuals]
                                          :terrain-stamp-replacements [replacement]}
                                         {:id :default
                                          :layers [source visuals]}
                                         [ruleset])]
    (is (= :grass (get-in layers [0 :tiles 0 1])))
    (is (nil? (get-in layers [0 :tiles 1 1])))
    (is (= :column-fill (get-in layers [1 :tiles 1 1])))))

(deftest render-layers-does_not_add_implicit_terrain_stamp_layer_for_real_target
  (let [source (terrain-layer (terrain-map [[nil :grass nil]
                                           [nil :grass nil]]))
        visuals {:id :scene/visuals
                 :label "Visuals"
                 :role :source
                 :data-kind :tile-ref
                 :tileset :overworld
                 :tiles (data/make-empty-map)}
        ruleset {:id :grass-column
                 :kind :terrain-stamp
                 :terrain-set :overworld
                 :rules [{:id :same-north
                          :terrain :grass
                          :match {:n :same}
                          :output {:anchor {:x 1 :y 1}
                                   :layers [{:target-layer :scene/visuals
                                             :tileset :overworld
                                             :tiles [[nil nil nil]
                                                     [nil :column-fill nil]
                                                     [nil nil nil]]}]}}]}
        layers (derivation/render-layers {:layers [source visuals]}
                                         {:id :default
                                          :layers [source visuals]}
                                         [ruleset])]
    (is (= [:scene/terrain :scene/visuals]
           (map layers :id)))))
