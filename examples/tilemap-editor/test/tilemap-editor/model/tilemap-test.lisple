(ns tilemap-editor.model.tilemap-test
  (:require proof.core
            [tilemap-editor.model.data :as data]
            [tilemap-editor.model.tilemap :as tilemap]))

(deftest tilemap-clamp-bounds-values
  (is (= 0 (tilemap/clamp -4 0 10)))
  (is (= 7 (tilemap/clamp 7 0 10)))
  (is (= 10 (tilemap/clamp 18 0 10))))

(defun pattern-brush []
  {:id :stamp
   :label "Stamp"
   :kind :pattern
   :pattern {:size {:w 3 :h 3}
             :anchor {:x 1 :y 1}
             :layers [{:id :terrain
                       :tileset :terrain
                       :tiles [[nil :grass nil]
                               [:water :grass nil]
                               [nil nil :rock]]}
                      {:id :props
                       :tileset :props
                       :tiles [[:crate nil nil]
                               [nil nil nil]
                               [nil nil nil]]}]}})

(defun brush-paint-state []
  {:selected-layer-index 0
   :map-palette-tab :brushes
   :selected-brush-index 0
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :ground
             :label "Ground"
             :tileset :terrain
             :tiles (data/make-empty-map)}]
   :brushes [(pattern-brush)]})

(defun targeted-brush-paint-state []
  {:selected-layer-index 1
   :map-palette-tab :brushes
   :selected-brush-index 0
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :scene/ground
             :label "Ground"
             :tileset :terrain
             :tiles (data/make-empty-map)}
            {:id :scene/props
             :label "Props"
             :tileset :props
             :tiles (data/make-empty-map)}]
   :brushes [{:id :stamp
              :label "Stamp"
              :kind :pattern
              :pattern {:size {:w 1 :h 1}
                        :anchor {:x 0 :y 0}
                        :layers [{:id :terrain
                                  :target-layer :scene/ground
                                  :tileset :terrain
                                  :tiles [[:grass]]}
                                 {:id :props
                                  :target-layer :scene/props
                                  :tileset :props
                                  :tiles [[:crate]]}]}}]})

(defun terrain-row [values]
  (concat values (dotimes [x (- data/map-width (count values))] nil)))

(defun terrain-map [rows]
  (concat (map rows terrain-row)
          (dotimes [y (- data/map-height (count rows))]
            (data/make-empty-row))))

(def terrain-stamp-rule
  {:id :grass-north-water
   :terrain :grass
   :match {:n {:terrain :water}
           :e :ignore
           :s :ignore
           :w :ignore}
   :output {:anchor {:x 1 :y 1}
            :layers [{:target-layer :scene/visuals
                      :tileset :overworld
                      :tiles [[nil :shore-n nil]
                              [nil :grass-fill nil]
                              [nil nil nil]]}]}})

(defun terrain-paint-state [terrain-tiles selected-tile]
  {:selected-layer-index 0
   :map-palette-tab :tiles
   :selected-tile selected-tile
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :scene/terrain
             :label "Terrain"
             :role :source
             :data-kind :terrain
             :terrain-set :overworld
             :tiles terrain-tiles}
            {:id :scene/visuals
             :label "Visuals"
             :role :source
             :data-kind :tile-ref
             :tileset :overworld
             :tiles (data/make-empty-map)}]
   :rulesets [{:id :shore-rules
               :kind :terrain-stamp
               :terrain-set :overworld
               :source-layer :scene/terrain
               :rules [terrain-stamp-rule]}]})

(defun paint-event [button x y]
  {:button button
   :position {:x (* x data/tile-size)
              :y (* y data/tile-size)}})

(deftest tilemap-paint-stamps_selected_pattern_brush
  (let [state (tilemap/paint-map-at (brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (= :grass (get-in state [:layers 0 :tiles 5 5])))
    (is (= :water (get-in state [:layers 0 :tiles 6 4])))
    (is (= :grass (get-in state [:layers 0 :tiles 6 5])))
    (is (= :rock (get-in state [:layers 0 :tiles 7 6])))
    (is (nil? (get-in state [:layers 0 :tiles 5 4])))))

(deftest tilemap-paint-stamps_targeted_pattern_layers_by_map_layer_id
  (let [state (tilemap/paint-map-at (targeted-brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (= :grass (get-in state [:layers 0 :tiles 6 5])))
    (is (= :crate (get-in state [:layers 1 :tiles 6 5])))))

(deftest tilemap-paint-ignores_brush_layers_for_other_tilesets
  (let [state (tilemap/paint-map-at (brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (nil? (get-in state [:layers 0 :tiles 5 4])))))

(deftest tilemap-right_paint-clears_pattern_footprint
  (let [state (assoc-in (brush-paint-state)
                        [:layers 0 :tiles 5 5]
                        :grass)
        state (assoc-in state [:layers 0 :tiles 6 4] :water)
        state (assoc-in state [:layers 0 :tiles 7 6] :rock)
        state (tilemap/paint-map-at state (paint-event :right 5 6))]
    (is (nil? (get-in state [:layers 0 :tiles 5 5])))
    (is (nil? (get-in state [:layers 0 :tiles 6 4])))
    (is (nil? (get-in state [:layers 0 :tiles 7 6])))))

(deftest tilemap-paint-terrain-previews_matching_stamp_rule_by_default
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil :water nil]])
                                    :grass)
               (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:layers 1 :tiles 0 1])))
    (is (nil? (get-in state [:layers 1 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-can_bake_matching_stamp_rule
  (let [state (assoc (terrain-paint-state (terrain-map [[nil :water nil]])
                                          :grass)
                     :terrain-rule-application
                     :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:layers 1 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:layers 1 :tiles 1 1])))
    (is (= true
           (get-in state [:terrain-stamp-replacements 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-ruleset_can_choose_baked_application
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :application]
                        :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :shore-n (get-in state [:layers 1 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:layers 1 :tiles 1 1])))
    (is (= [] (or (:terrain-stamp-layers state) [])))))

(deftest tilemap-paint-terrain-does_not_apply_matching_rules_across_whole_map
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil :water nil nil :water]
                                                  [nil nil nil nil :grass]])
                                    :grass)
               (paint-event :left 1 1))]
    (is (= :grass-fill (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:terrain-stamp-layers 0 :tiles 1 4])))))

(deftest tilemap-paint-terrain-uses_auto_stamp_layer_without_target_layer
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :rules 0 :output :layers 0 :target-layer]
                        nil)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-does_not_clear_manual_target_tiles
  (let [state (assoc (terrain-paint-state (terrain-map [[nil :water nil]
                                                       [nil :grass nil]])
                                          nil)
                     :terrain-rule-application
                     :paint-baked)
        state (assoc-in state
                        [:layers 1 :tiles 1 1]
                        :manual)
        state (tilemap/paint-map-at state (paint-event :right 1 1))]
    (is (nil? (get-in state [:layers 0 :tiles 1 1])))
    (is (= :manual (get-in state [:layers 1 :tiles 1 1])))))

(deftest tilemap-paint-terrain-refreshes_neighbor_stamp_rules
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil nil nil]
                                                  [nil :grass nil]])
                                    :water)
               (paint-event :left 1 0))
        cleared (tilemap/paint-map-at state (paint-event :right 1 0))]
    (is (= :water (get-in state [:layers 0 :tiles 0 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (nil? (get-in cleared [:layers 0 :tiles 0 1])))
    (is (nil? (get-in cleared [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (nil? (get-in cleared [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-ruleset_without_source_layer_uses_matching_terrain_set
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :source-layer]
                        nil)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))
