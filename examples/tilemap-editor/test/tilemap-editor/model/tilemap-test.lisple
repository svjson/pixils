(ns tilemap-editor.model.tilemap-test
  (:require proof.core
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.tilemap :as tilemap]))

(deftest tilemap-clamp-bounds-values
  (is (= 0 (tilemap/clamp -4 0 10)))
  (is (= 7 (tilemap/clamp 7 0 10)))
  (is (= 10 (tilemap/clamp 18 0 10))))

(defun pattern-brush []
  {:id :stamp
   :label "Stamp"
   :kind :pattern
   :pattern {:size {:w 3 :h 3}
             :anchor {:x 1 :y 1}
             :layers [{:id :terrain
                       :tileset :terrain
                       :tiles [[nil :grass nil]
                               [:water :grass nil]
                               [nil nil :rock]]}
                      {:id :props
                       :tileset :props
                       :tiles [[:crate nil nil]
                               [nil nil nil]
                               [nil nil nil]]}]}})

(defun brush-paint-state []
  {:selected-layer-index 0
   :map-palette-tab :brushes
   :selected-brush-index 0
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :ground
             :label "Ground"
             :tileset :terrain
             :tiles (data/make-empty-map)}]
   :brushes [(pattern-brush)]})

(defun targeted-brush-paint-state []
  {:selected-layer-index 1
   :map-palette-tab :brushes
   :selected-brush-index 0
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :scene/ground
             :label "Ground"
             :tileset :terrain
             :tiles (data/make-empty-map)}
            {:id :scene/props
             :label "Props"
             :tileset :props
             :tiles (data/make-empty-map)}]
   :brushes [{:id :stamp
              :label "Stamp"
              :kind :pattern
              :pattern {:size {:w 1 :h 1}
                        :anchor {:x 0 :y 0}
                        :layers [{:id :terrain
                                  :target-layer :scene/ground
                                  :tileset :terrain
                                  :tiles [[:grass]]}
                                 {:id :props
                                  :target-layer :scene/props
                                  :tileset :props
                                  :tiles [[:crate]]}]}}]})

(defun terrain-row [values]
  (concat values (dotimes [x (- data/map-width (count values))] nil)))

(defun terrain-map [rows]
  (concat (map rows terrain-row)
          (dotimes [y (- data/map-height (count rows))]
            (data/make-empty-row))))

(def terrain-stamp-rule
  {:id :grass-north-water
   :terrain :grass
   :match {:n {:terrain :water}
           :e :ignore
           :s :ignore
           :w :ignore}
   :output {:anchor {:x 1 :y 1}
            :layers [{:target-layer :scene/visuals
                      :tileset :overworld
                      :tiles [[nil nil nil]
                              [nil :shore-n nil]
                              [nil nil nil]]}]}})

(defun terrain-paint-state [terrain-tiles selected-tile]
  {:selected-layer-index 0
   :map-palette-tab :tiles
   :selected-tile selected-tile
   :zoom 1
   :offset {:x 0 :y 0}
   :layers [{:id :scene/terrain
             :label "Terrain"
             :role :source
             :data-kind :terrain
             :terrain-set :overworld
             :tiles terrain-tiles}
            {:id :scene/visuals
             :label "Visuals"
             :role :source
             :data-kind :tile-ref
             :tileset :overworld
             :tiles (data/make-empty-map)}]
   :rulesets [{:id :shore-rules
               :kind :terrain-stamp
               :terrain-set :overworld
               :source-layer :scene/terrain
               :rules [terrain-stamp-rule]}]})

(defun source-less-visual-paint-state [visual-tiles selected-tile]
  {:selected-layer-index 0
   :map-palette-tab :tiles
   :selected-tile selected-tile
   :zoom 1
   :offset {:x 0 :y 0}
   :terrain-sets [{:id :overworld
                   :tileset :overworld
                   :terrains [{:id :grass
                               :tile :grass-fill}
                              {:id :water
                               :tile :water-fill}]}]
   :layers [{:id :scene/visuals
             :label "Visuals"
             :role :source
             :data-kind :tile-ref
             :tileset :overworld
             :tiles visual-tiles}]
   :rulesets [{:id :shore-rules
               :kind :terrain-stamp
               :terrain-set :overworld
               :source-layer nil
               :rules [terrain-stamp-rule]}]})

(defun paint-event [button x y]
  {:button button
   :position {:x (* x data/tile-size)
              :y (* y data/tile-size)}})

(deftest tilemap-normalizes_rectangular_selection
  (is (= {:x 2 :y 3 :w 5 :h 4}
         (tilemap/normalize-selection-rect {:x 6 :y 6}
                                           {:x 2 :y 3}))))

(deftest tilemap-set-map-dimensions-resizes_layer_matrices
  (let [state {:map-width 2
               :map-height 2
               :show-terrain-rules? false
               :layers [{:id :ground
                         :tiles [[:a :b]
                                 [:c :d]]
                         :terrain-signatures [[{:center :a} nil]
                                              [nil {:center :d}]]}]}
        resized (tilemap/set-map-dimensions state 3 1)]
    (is (= 3 (:map-width resized)))
    (is (= 1 (:map-height resized)))
    (is (= [[:a :b nil]]
           (get-in resized [:layers 0 :tiles])))
    (is (= [[{:center :a} nil nil]]
           (get-in resized [:layers 0 :terrain-signatures])))))

(deftest tilemap-paint-uses_current_map_dimensions
  (let [state {:map-width 2
               :map-height 1
               :selected-layer-index 0
               :map-palette-tab :tiles
               :selected-tile :grass
               :zoom 1
               :offset {:x 0 :y 0}
               :layers [{:id :ground
                         :tiles [[nil nil]]}]}
        painted (tilemap/paint-map-at state (paint-event :left 1 0))
        skipped (tilemap/paint-map-at painted (paint-event :left 2 0))]
    (is (= :grass (get-in painted [:layers 0 :tiles 0 1])))
    (is (= painted skipped))))

(deftest tilemap-select-tool_tracks_dragged_rectangle
  (let [state {:map-tool :select
               :zoom 1
               :offset {:x 0 :y 0}}
        state (tilemap/map-canvas-mouse-down state (paint-event :left 5 6))
        state (tilemap/map-canvas-drag state (paint-event :left 7 4))
        state (tilemap/map-canvas-mouse-up state (paint-event :left 7 4))]
    (is (= {:x 5 :y 4 :w 3 :h 3}
           (-> state :map-selection :rect)))
    (is (= false (-> state :map-selection :active?)))))

(deftest tilemap-select-tool_does_not_paint_selected_layer
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil]])
                                          :grass)
                     :map-tool :select)
        state (tilemap/map-canvas-mouse-down state (paint-event :left 1 1))]
    (is (nil? (get-in state [:layers 0 :tiles 1 1])))
    (is (= {:x 1 :y 1 :w 1 :h 1}
           (-> state :map-selection :rect)))))

(deftest tilemap-paint-tool_skips_repeated_drag_samples
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil]
                                                       [nil :grass nil]])
                                         :water)
                     :terrain-stamp-layers [{:id :sentinel
                                             :tiles (terrain-map [[:keep]])}])
        state (tilemap/map-canvas-mouse-down state (paint-event :left 1 0))
        repeated (tilemap/map-canvas-drag state (paint-event :left 1 0))]
    (is (= state repeated))
    (is (= {:x 1
            :y 0
            :button :left
            :layer-index 0
            :palette-tab :tiles
            :selected-tile :water
            :selected-brush-index nil}
           (:last-map-paint-sample state)))))

(deftest tilemap-paint-tool_paints_when_drag_enters_new_tile
  (let [state (terrain-paint-state (terrain-map [[nil nil nil]])
                                   :water)
        state (tilemap/map-canvas-mouse-down state (paint-event :left 0 0))
        state (tilemap/map-canvas-drag state (paint-event :left 1 0))
        state (tilemap/map-canvas-mouse-up state (paint-event :left 1 0))]
    (is (= :water (get-in state [:layers 0 :tiles 0 0])))
    (is (= :water (get-in state [:layers 0 :tiles 0 1])))
    (is (nil? (:last-map-paint-sample state)))))

(deftest tilemap-line-tool_paints_line_on_mouse_up
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil nil]])
                                          :water)
                     :map-tool :line)
        state (tilemap/map-canvas-mouse-down state (paint-event :left 0 0))
        dragging (tilemap/map-canvas-drag state (paint-event :left 3 0))
        painted (tilemap/map-canvas-mouse-up dragging (paint-event :left 3 0))]
    (is (nil? (get-in dragging [:layers 0 :tiles 0 0])))
    (is (= :water (get-in painted [:layers 0 :tiles 0 0])))
    (is (= :water (get-in painted [:layers 0 :tiles 0 1])))
    (is (= :water (get-in painted [:layers 0 :tiles 0 2])))
    (is (= :water (get-in painted [:layers 0 :tiles 0 3])))
    (is (nil? (:map-line painted)))))

(deftest tilemap-fill-tool_paints_contiguous_region
  (let [state (assoc (terrain-paint-state
                      (terrain-map [[:grass :grass :water]
                                    [:grass :water :water]
                                    [nil :grass :grass]])
                      :desert)
                     :map-tool :fill)
        painted (tilemap/map-canvas-mouse-down state (paint-event :left 0 0))]
    (is (= :desert (get-in painted [:layers 0 :tiles 0 0])))
    (is (= :desert (get-in painted [:layers 0 :tiles 0 1])))
    (is (= :desert (get-in painted [:layers 0 :tiles 1 0])))
    (is (= :water (get-in painted [:layers 0 :tiles 1 1])))
    (is (= :grass (get-in painted [:layers 0 :tiles 2 1])))))

(deftest tilemap-clear-selection-clears_selected_region_on_selected_layer
  (let [state {:selected-layer-index 0
               :map-selection {:rect {:x 1 :y 1 :w 2 :h 2}
                               :active? false}
               :layers [{:id :ground
                         :tiles (data/make-empty-map)}
                        {:id :props
                         :tiles (data/make-empty-map)}]}
        state (assoc-in state [:layers 0 :tiles 1 1] :grass)
        state (assoc-in state [:layers 0 :tiles 1 2] :water)
        state (assoc-in state [:layers 0 :tiles 2 1] :rock)
        state (assoc-in state [:layers 0 :tiles 0 0] :keep)
        state (assoc-in state [:layers 1 :tiles 1 1] :crate)
        cleared (tilemap/clear-map-selection state)]
    (is (nil? (get-in cleared [:layers 0 :tiles 1 1])))
    (is (nil? (get-in cleared [:layers 0 :tiles 1 2])))
    (is (nil? (get-in cleared [:layers 0 :tiles 2 1])))
    (is (= :keep (get-in cleared [:layers 0 :tiles 0 0])))
    (is (= :crate (get-in cleared [:layers 1 :tiles 1 1])))))

(deftest tilemap-clear-selection-refreshes_terrain_rule_outputs
  (let [state (tilemap/rebuild-terrain-stamp-preview
               (terrain-paint-state (terrain-map [[nil :water nil]
                                                  [nil :grass nil]])
                                    nil))
        state (assoc state :map-selection {:rect {:x 1 :y 1 :w 1 :h 1}
                                           :active? false})
        cleared (tilemap/clear-map-selection state)]
    (is (nil? (get-in cleared [:layers 0 :tiles 1 1])))
    (is (nil? (get-in cleared [:terrain-stamp-layers 0 :tiles 0 1])))
    (is (nil? (get-in cleared [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-clear-selection-skips_rule_refresh_when_cells_are_unchanged
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil]
                                                       [nil nil nil]])
                                         nil)
                     :map-selection {:rect {:x 1 :y 1 :w 1 :h 1}
                                     :active? false}
                     :terrain-stamp-layers [{:id :scene/visuals
                                             :tiles (terrain-map [[nil nil nil]
                                                                  [nil :keep nil]])}])
        cleared (tilemap/clear-map-selection state)]
    (is (= state cleared))))

(deftest tilemap-paint-stamps_selected_pattern_brush
  (let [state (tilemap/paint-map-at (brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (= :grass (get-in state [:layers 0 :tiles 5 5])))
    (is (= :water (get-in state [:layers 0 :tiles 6 4])))
    (is (= :grass (get-in state [:layers 0 :tiles 6 5])))
    (is (= :rock (get-in state [:layers 0 :tiles 7 6])))
    (is (nil? (get-in state [:layers 0 :tiles 5 4])))))

(deftest tilemap-paint-stamps_targeted_pattern_layers_by_map_layer_id
  (let [state (tilemap/paint-map-at (targeted-brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (= :grass (get-in state [:layers 0 :tiles 6 5])))
    (is (= :crate (get-in state [:layers 1 :tiles 6 5])))))

(deftest tilemap-paint-ignores_brush_layers_for_other_tilesets
  (let [state (tilemap/paint-map-at (brush-paint-state)
                                    (paint-event :left 5 6))]
    (is (nil? (get-in state [:layers 0 :tiles 5 4])))))

(deftest tilemap-right_paint-clears_pattern_footprint
  (let [state (assoc-in (brush-paint-state)
                        [:layers 0 :tiles 5 5]
                        :grass)
        state (assoc-in state [:layers 0 :tiles 6 4] :water)
        state (assoc-in state [:layers 0 :tiles 7 6] :rock)
        state (tilemap/paint-map-at state (paint-event :right 5 6))]
    (is (nil? (get-in state [:layers 0 :tiles 5 5])))
    (is (nil? (get-in state [:layers 0 :tiles 6 4])))
    (is (nil? (get-in state [:layers 0 :tiles 7 6])))))

(deftest tilemap-paint-terrain-previews_matching_stamp_rule_by_default
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil :water nil]])
                                    :grass)
               (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:layers 1 :tiles 0 1])))
    (is (nil? (get-in state [:layers 1 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-stops_after_exclusive_stamp_rule
  (let [second-rule (assoc terrain-stamp-rule
                           :id :second
                           :output {:anchor {:x 1 :y 1}
                                    :layers [{:target-layer :scene/visuals
                                              :tileset :overworld
                                              :tiles [[nil nil nil]
                                                      [nil :second-fill nil]
                                                      [nil nil nil]]}]})
        state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :rules]
                        [(assoc terrain-stamp-rule :exclusive? true)
                         second-rule])
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-can_bake_matching_stamp_rule
  (let [state (assoc (terrain-paint-state (terrain-map [[nil :water nil]])
                                          :grass)
                     :terrain-rule-application
                     :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:layers 1 :tiles 1 1])))
    (is (= true
           (get-in state [:terrain-stamp-replacements 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-ruleset_can_choose_baked_application
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :application]
                        :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :shore-n (get-in state [:layers 1 :tiles 1 1])))
    (is (= [] (or (:terrain-stamp-layers state) [])))))

(deftest tilemap-paint-terrain-does_not_apply_matching_rules_across_whole_map
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil :water nil nil :water]
                                                  [nil nil nil nil :grass]])
                                    :grass)
               (paint-event :left 1 1))]
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:terrain-stamp-layers 0 :tiles 1 4])))))

(deftest tilemap-paint-terrain-uses_auto_stamp_layer_without_target_layer
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :rules 0 :output :layers 0 :target-layer]
                        nil)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-unit_paints_and_clears_whole_blocks
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil]
                                                       [nil nil nil]
                                                       [nil nil nil]])
                                         :mountain)
                     :terrain-sets [{:id :overworld
                                     :terrain-unit {:w 2 :h 2}}]
                     :rulesets [])
        painted (tilemap/paint-map-at state (paint-event :left 1 1))
        cleared (tilemap/paint-map-at (assoc painted :selected-tile nil)
                                      (paint-event :right 0 1))]
    (is (= :mountain (get-in painted [:layers 0 :tiles 0 0])))
    (is (= :mountain (get-in painted [:layers 0 :tiles 0 1])))
    (is (= :mountain (get-in painted [:layers 0 :tiles 1 0])))
    (is (= :mountain (get-in painted [:layers 0 :tiles 1 1])))
    (is (nil? (get-in painted [:layers 0 :tiles 2 2])))
    (is (nil? (get-in cleared [:layers 0 :tiles 0 0])))
    (is (nil? (get-in cleared [:layers 0 :tiles 0 1])))
    (is (nil? (get-in cleared [:layers 0 :tiles 1 0])))
    (is (nil? (get-in cleared [:layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-unit_baked_rules_mask_empty_stamp_cells
  (let [state {:selected-layer-index 0
               :map-palette-tab :tiles
               :selected-tile :mountain
               :zoom 1
               :offset {:x 0 :y 0}
               :terrain-rule-application :paint-baked
               :terrain-sets [{:id :mountains
                               :terrain-unit {:w 2 :h 2}}]
               :layers [{:id :scene/terrain
                         :label "Terrain"
                         :role :source
                         :data-kind :terrain
                         :terrain-set :mountains
                         :tiles (terrain-map [[nil nil]
                                              [nil nil]])}
                        {:id :scene/visuals
                         :label "Visuals"
                         :role :source
                         :data-kind :tile-ref
                         :tileset :mountains
                         :tiles (data/make-empty-map)}]
               :rulesets [{:id :mountain-rules
                           :kind :terrain-stamp
                           :terrain-set :mountains
                           :source-layer :scene/terrain
                           :rules [{:id :mountain-fill
                                    :terrain :mountain
                                    :match {}
                                    :output {:anchor {:x 0 :y 0}
                                             :layers [{:target-layer :scene/visuals
                                                       :tileset :mountains
                                                       :tiles [[:mountain-nw nil]
                                                               [nil nil]]}]}}]}]}
        state (tilemap/paint-map-at state (paint-event :left 0 0))]
    (is (= :mountain-nw (get-in state [:layers 1 :tiles 0 0])))
    (is (nil? (get-in state [:layers 1 :tiles 0 1])))
    (is (= true (get-in state [:terrain-stamp-replacements 0 :tiles 0 0])))
    (is (= true (get-in state [:terrain-stamp-replacements 0 :tiles 0 1])))
    (is (= true (get-in state [:terrain-stamp-replacements 0 :tiles 1 0])))
    (is (= true (get-in state [:terrain-stamp-replacements 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-bakes_to_materialized_layer_without_target_layer
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :rules 0 :output :layers 0 :target-layer]
                        nil)
        state (assoc state :terrain-rule-application :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= (keyword "scene/terrain/shore-rules/overworld")
           (get-in state [:layers 2 :id])))
    (is (= :tile-ref (get-in state [:layers 2 :data-kind])))
    (is (= :shore-n (get-in state [:layers 2 :tiles 1 1])))
    (is (= true (get-in state [:terrain-stamp-replacements 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-does_not_clear_manual_target_tiles
  (let [state (assoc (terrain-paint-state (terrain-map [[nil :water nil]
                                                       [nil :grass nil]])
                                          nil)
                     :terrain-rule-application
                     :paint-baked)
        state (assoc-in state
                        [:layers 1 :tiles 1 1]
                        :manual)
        state (tilemap/paint-map-at state (paint-event :right 1 1))]
    (is (nil? (get-in state [:layers 0 :tiles 1 1])))
    (is (= :manual (get-in state [:layers 1 :tiles 1 1])))))

(deftest tilemap-paint-terrain-refreshes_neighbor_stamp_rules
  (let [state (tilemap/paint-map-at
               (terrain-paint-state (terrain-map [[nil nil nil]
                                                  [nil :grass nil]])
                                    :water)
               (paint-event :left 1 0))
        cleared (tilemap/paint-map-at state (paint-event :right 1 0))]
    (is (= :water (get-in state [:layers 0 :tiles 0 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (nil? (get-in cleared [:layers 0 :tiles 0 1])))
    (is (nil? (get-in cleared [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-paint-terrain-skips_rule_refresh_when_cell_is_unchanged
  (let [state (assoc (terrain-paint-state (terrain-map [[nil nil nil]
                                                       [nil :grass nil]])
                                         :grass)
                     :terrain-stamp-layers [{:id :sentinel
                                             :tiles (terrain-map [[:keep]])}])
        painted (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= state painted))))

(deftest tilemap-paint-terrain-refreshes_second_order_signature_dependents
  (let [state {:selected-layer-index 0
               :map-palette-tab :tiles
               :selected-tile :desert
               :zoom 1
               :offset {:x 0 :y 0}
               :layers [{:id :scene/terrain
                         :label "Terrain"
                         :role :source
                         :data-kind :terrain
                         :terrain-set :overworld
                         :tiles (terrain-map [[nil nil nil nil]
                                              [:grass :desert :grass nil]])}
                        {:id :scene/visuals
                         :label "Visuals"
                         :role :source
                         :data-kind :tile-ref
                         :tileset :overworld
                         :tiles (data/make-empty-map)}]
               :rulesets [{:id :edge-rules
                           :kind :terrain-stamp
                           :terrain-set :overworld
                           :source-layer :scene/terrain
                           :rules [{:id :grass-needs-east-same
                                    :terrain :grass
                                    :match {:e :same}
                                    :output {:anchor {:x 1 :y 1}
                                             :layers [{:target-layer :scene/visuals
                                                       :tileset :overworld
                                                       :tiles [[nil nil nil]
                                                               [nil :grass-edge nil]
                                                               [nil nil nil]]}]}}
                                   {:id :desert-east-grass-advertises-west-grass
                                    :terrain :desert
                                    :match {:e {:terrain :grass}}
                                    :output {:anchor {:x 1 :y 1}
                                             :layers [{:target-layer :scene/visuals
                                                       :tileset :overworld
                                                       :tiles [[nil nil nil]
                                                               [nil :desert-edge nil]
                                                               [nil nil nil]]
                                                       :terrain-signatures
                                                       [[nil nil nil]
                                                        [nil {:center :desert
                                                              :w :grass}
                                                         nil]
                                                        [nil nil nil]]}]}}]}]}
        state (tilemap/rebuild-terrain-stamp-preview state)
        painted (tilemap/paint-map-at state (paint-event :left 2 1))]
    (is (= :grass-edge (get-in state [:terrain-stamp-layers 0 :tiles 1 0])))
    (is (nil? (get-in painted [:terrain-stamp-layers 0 :tiles 1 0])))))

(deftest tilemap-paint-terrain-ruleset_without_source_layer_uses_matching_terrain_set
  (let [state (assoc-in (terrain-paint-state (terrain-map [[nil :water nil]])
                                             :grass)
                        [:rulesets 0 :source-layer]
                        nil)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass (get-in state [:layers 0 :tiles 1 1])))
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-source_less_rules_reapply_other_matching_sources_after_clear
  (let [state (terrain-paint-state (terrain-map [[nil :water nil]
                                                 [nil :grass nil]])
                                   :terrain)
        ground-ruleset (assoc-in (head (:rulesets state))
                                 [:rules 0 :output :layers 0 :target-layer]
                                 nil)
        ground-ruleset (assoc-in ground-ruleset
                                 [:rules 0 :output :layers 0 :id]
                                 :layer)
        forest-ruleset {:id :forest-rules
                        :kind :terrain-stamp
                        :terrain-set :forest-set
                        :source-layer nil
                        :rules [{:id :forest-fill
                                 :terrain :terrain
                                 :match {}
                                 :output {:anchor {:x 1 :y 1}
                                          :layers [{:id :layer
                                                    :tileset :overworld
                                                    :tiles [[nil nil nil]
                                                            [nil :forest-fill nil]
                                                            [nil nil nil]]}]}}]}
        state (assoc state
                     :selected-layer-index 2
                     :terrain-sets [{:id :overworld}
                                    {:id :forest-set}]
                     :rulesets [(assoc ground-ruleset :source-layer nil)
                                forest-ruleset]
                     :layers (concat (:layers state)
                                     [{:id :scene/forest-mask
                                       :label "Forest Mask"
                                       :role :source
                                       :data-kind :terrain
                                       :terrain-set :forest-set
                                       :tiles (data/make-empty-map)}]))
        state (tilemap/rebuild-terrain-stamp-preview state)
        painted (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (= :terrain (get-in painted [:layers 2 :tiles 1 1])))
    (is (= :shore-n (get-in painted [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (= :forest-fill (get-in painted [:terrain-stamp-layers 1 :tiles 1 1])))))

(deftest tilemap-source_less_rules_do_not_use_visual_tiles_as_source
  (let [state (source-less-visual-paint-state
               (terrain-map [[nil :water-fill nil]])
               :grass-fill)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :grass-fill (get-in state [:layers 0 :tiles 1 1])))
    (is (= [] (or (:terrain-stamp-layers state) [])))))

(deftest tilemap-source_less_baked_rules_do_not_mutate_visual_sources
  (let [state (assoc (source-less-visual-paint-state
                      (terrain-map [[nil :water-fill nil]])
                      :grass-fill)
                     :terrain-rule-application
                     :paint-baked)
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :water-fill (get-in state [:layers 0 :tiles 0 1])))
    (is (= :grass-fill (get-in state [:layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:layers 0 :terrain-signatures])))))

(deftest tilemap-terrain_rules_ignore_non_center_output_tiles
  (let [state {:selected-layer-index 0
               :map-palette-tab :tiles
               :selected-tile :desert
               :zoom 1
               :offset {:x 0 :y 0}
               :layers [{:id :scene/terrain
                         :label "Terrain"
                         :role :source
                         :data-kind :terrain
                         :terrain-set :overworld
                         :tiles (terrain-map [[:grass nil nil]
                                              [nil nil nil]
                                              [nil nil nil]])}
                        {:id :scene/visuals
                         :label "Visuals"
                         :kind :tile
                         :data-kind :tile-ref
                         :tileset :overworld
                         :tiles (data/make-empty-map)}]
               :rulesets [{:id :desert-rules
                           :kind :terrain-stamp
                           :terrain-set :overworld
                           :source-layer :scene/terrain
                           :rules [{:id :desert-grass-nw-corner
                                    :terrain :desert
                                    :match {:nw {:terrain :grass}
                                            :n :ignore
                                            :ne :ignore
                                            :w :ignore
                                            :e :ignore
                                            :sw :ignore
                                            :s :ignore
                                            :se :ignore}
                                    :output {:anchor {:x 1 :y 1}
                                             :layers [{:target-layer :scene/visuals
                                                       :tileset :overworld
                                                       :tiles [[:grass-desert-se nil nil]
                                                               [nil :desert-fill nil]
                                                               [nil nil nil]]}]}}]}]}
        state (tilemap/paint-map-at state (paint-event :left 1 1))]
    (is (= :desert (get-in state [:layers 0 :tiles 1 1])))
    (is (nil? (get-in state [:terrain-stamp-layers 0 :tiles 0 0])))
    (is (= :desert-fill
           (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-rebuild-terrain-stamp-preview_builds_whole_map_cache
  (let [state (tilemap/rebuild-terrain-stamp-preview
               (terrain-paint-state (terrain-map [[nil :water nil]
                                                  [nil :grass nil]])
                                    :grass))]
    (is (= :shore-n (get-in state [:terrain-stamp-layers 0 :tiles 1 1])))))

(deftest tilemap-refresh-terrain-stamp-preview-for-ruleset-change_rebuilds_one_ruleset
  (let [state (tilemap/rebuild-terrain-stamp-preview
               (terrain-paint-state (terrain-map [[nil :water nil]
                                                  [nil :grass nil]])
                                    :grass))
        changed (assoc-in state
                          [:rulesets 0 :rules 0 :output :layers 0 :tiles 1 1]
                          :shore-updated)
        refreshed (tilemap/refresh-terrain-stamp-preview-for-ruleset-change
                   state
                   changed
                   :shore-rules)]
    (is (= :shore-updated
           (get-in refreshed [:terrain-stamp-layers 0 :tiles 1 1])))
    (is (nil? (get-in refreshed [:terrain-stamp-layers 0 :tiles 0 1])))))

(deftest tilemap-set-terrain-rule-application_rebuilds_or_clears_preview_cache
  (let [state (tilemap/rebuild-terrain-stamp-preview
               (terrain-paint-state (terrain-map [[nil :water nil]
                                                  [nil :grass nil]])
                                    :grass))
        baked (tilemap/set-terrain-rule-application state :paint-baked)
        preview (tilemap/set-terrain-rule-application baked :preview)]
    (is (= [] (:terrain-stamp-layers baked)))
    (is (= :shore-n (get-in preview [:terrain-stamp-layers 0 :tiles 1 1])))))
