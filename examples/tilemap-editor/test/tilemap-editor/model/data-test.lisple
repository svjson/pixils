(ns tilemap-editor.model.data-test
  (:require proof.core
            [tilemap-editor.model.data :as data]))

(deftest empty-project-document-does-not-invent-tilesets-or-layers
  (let [document (data/project-document {:tilesets []
                                         :brushes []
                                         :layers []})]
    (is (= [] (:tilesets document)))
    (is (= [] (:brushes document)))
    (is (= [] (-> document :tilemap :layers)))))

(deftest project-document-saves_only_project_owned_resources
  (let [document (data/project-document
                  {:resources {:bundles {:editor-assets
                                         {:images {:spritesheet
                                                   {:file-name "sprites.png"}}}
                                         :project-assets
                                         {:dynamic? true
                                          :images {:tiles
                                                   {:file-name "tiles.png"
                                                    :name "Tiles"}}}}}})]
    (is (= {:bundles {:project-assets
                      {:images {:tiles
                                {:file-name "tiles.png"
                                 :name "Tiles"}}}}}
           (:resources document)))))

(deftest normalize-project-resources-drops_app_static_bundles
  (is (= {:bundles {:terrain-assets {:images {}}}}
         (data/normalize-project-resources
          {:bundles {:editor-assets {:images {:spritesheet {}}}
                     :terrain-assets {:dynamic? true
                                      :images {}}}}))))

(deftest missing-tileset-has-no-tile-options
  (is (= [] (data/tile-options [] nil)))
  (is (nil? (data/tile-in [] nil 0)))
  (is (nil? (data/tile-id [] nil 0))))

(deftest tile-options-come-from-project-tilesets
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= [{:value :grass
             :label "Grass"}]
           (data/tile-options tilesets :terrain)))
    (is (= :grass
           (data/tile-id tilesets :terrain 0)))))

(deftest default-project-layered-map-is-empty
  (is (= [] (data/make-layered-map))))

(deftest empty-map-uses-project-dimensions
  (let [tilemap (data/make-empty-map)]
    (is (= data/map-height (count tilemap)))
    (is (= data/map-width (count (head tilemap))))
    (is (= nil (get-in tilemap [0 0])))))

(deftest normalize-project-document-normalizes_brush_pattern_layers
  (let [document (data/normalize-project-document
                  {:brushes [{:id :brush
                              :kind :pattern
                              :pattern {:layers [{:id :stamp
                                                   :tileset :terrain
                                                   :tiles [[:grass nil]]}]}}]
                   :tilemap {:layers []}})]
    (is (= [[:grass nil]]
           (get-in document
                   [:brushes 0 :pattern :layers 0 :tiles])))))
