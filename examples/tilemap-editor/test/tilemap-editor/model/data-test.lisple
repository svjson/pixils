(ns tilemap-editor.model.data-test
  (:require proof.core
            [tilemap-editor.model.data :as data]))

(deftest clamp-tile-index-stays-inside-tileset
  (is (= 0 (data/clamp-tile-index :platform-level -10)))
  (is (= 0 (data/clamp-tile-index :platform-level nil)))
  (is (= (dec (data/tile-count-for :platform-level))
         (data/clamp-tile-index :platform-level 999))))

(deftest string-map-to-tile-map-converts-characters-to-tile-ids
  (is (= [[:rock-top :rock-face]]
         (data/string-map-to-tile-map :platform-level ["^#"]))))

(deftest empty-project-document-does-not-invent-tilesets-or-layers
  (let [document (data/project-document {:tilesets []
                                         :layers []})]
    (is (= [] (:tilesets document)))
    (is (= [] (-> document :tilemap :layers)))))

(deftest project-document-saves_only_project_owned_resources
  (let [document (data/project-document
                  {:resources {:bundles {:editor-assets
                                         {:images {:spritesheet
                                                   {:file-name "sprites.png"}}}
                                         :project-assets
                                         {:dynamic? true
                                          :images {:tiles
                                                   {:file-name "tiles.png"
                                                    :name "Tiles"}}}}}})]
    (is (= {:bundles {:project-assets
                      {:images {:tiles
                                {:file-name "tiles.png"
                                 :name "Tiles"}}}}}
           (:resources document)))))

(deftest normalize-project-resources-drops_app_static_bundles
  (is (= {:bundles {:terrain-assets {:images {}}}}
         (data/normalize-project-resources
          {:bundles {:editor-assets {:images {:spritesheet {}}}
                     :terrain-assets {:dynamic? true
                                      :images {}}}}))))

(deftest missing-tileset-does-not-fall-back-to-sample-tiles
  (is (= [] (data/tile-options-for nil)))
  (is (nil? (data/tile-in nil 0)))
  (is (nil? (data/tile-id-in nil 0))))

(deftest tile-options-can-come-from-project-tileset-definitions
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= [{:value :grass
             :label "Grass"}]
           (data/tile-options-in tilesets :terrain)))
    (is (= :grass
           (data/tile-id-in-definitions tilesets :terrain 0)))))

(deftest built-in-project-tileset-definitions-are-available-for-layered-maps
  (is (= 4 (count (data/make-layered-map))))
  (is (= 4 (count (data/project-tileset-definitions))))
  (is (= 4 (count (data/project-tileset-definitions-for-layers
                   (data/make-layered-map))))))
