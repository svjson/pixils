(ns tilemap-editor.model.data-test
  (:require proof.core
            [tilemap-editor.model.data :as data]))

(deftest empty-project-document-does-not-invent-tilesets-or-layers
  (let [document (data/project-document {:tilesets []
                                         :brushes []
                                         :layers []})]
    (is (= [] (:tilesets document)))
    (is (= [] (:brushes document)))
    (is (= [] (:layer-profiles document)))
    (is (= [] (-> document :tilemap :layers)))))

(deftest project-document-saves_only_project_owned_resources
  (let [document (data/project-document
                  {:resources {:bundles {:editor-assets
                                         {:images {:spritesheet
                                                   {:file-name "sprites.png"}}}
                                         :project-assets
                                         {:dynamic? true
                                          :images {:tiles
                                                   {:file-name "tiles.png"
                                                    :name "Tiles"}}}}}})]
    (is (= {:bundles {:project-assets
                      {:images {:tiles
                                {:file-name "tiles.png"
                                 :name "Tiles"}}}}}
           (:resources document)))))

(deftest normalize-project-resources-drops_app_static_bundles
  (is (= {:bundles {:terrain-assets {:images {}}}}
         (data/normalize-project-resources
          {:bundles {:editor-assets {:images {:spritesheet {}}}
                     :terrain-assets {:dynamic? true
                                      :images {}}}}))))

(deftest missing-tileset-has-no-tile-options
  (is (= [] (data/tile-options [] nil)))
  (is (nil? (data/tile-in [] nil 0)))
  (is (nil? (data/tile-id [] nil 0))))

(deftest tile-options-come-from-project-tilesets
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= [{:value :grass
             :label "Grass"}]
           (data/tile-options tilesets :terrain)))
    (is (= :grass
           (data/tile-id tilesets :terrain 0)))))

(deftest terrain-options-come-from_project_terrain_sets
  (let [terrain-sets [{:id :overworld
                       :label "Overworld"
                       :tileset :terrain
                       :terrains [{:id :grass
                                   :label "Grass"
                                   :tile :grass}
                                  {:id :water
                                   :label "Water"
                                   :tile :water}]}]]
    (is (= [{:value :grass
             :label "Grass"}
            {:value :water
             :label "Water"}]
           (data/terrain-options terrain-sets :overworld)))
    (is (= :grass
           (data/terrain-id terrain-sets :overworld 0)))))

(deftest terrain-preview-resolves_to_tileset_tile
  (let [tilesets [{:id :terrain
                   :tiles [{:id :grass
                            :name "Grass"
                            :type :color}]}]
        terrain-sets [{:id :overworld
                       :tileset :terrain
                       :terrains [{:id :grass
                                   :label "Grass"
                                   :tile :grass}]}]]
    (is (= :grass
           (:id (data/terrain-tile-in tilesets
                                      terrain-sets
                                      :overworld
                                      :grass))))))

(deftest default-project-layered-map-is-empty
  (is (= [] (data/make-layered-map))))

(deftest empty-map-uses-project-dimensions
  (let [tilemap (data/make-empty-map)]
    (is (= data/map-height (count tilemap)))
    (is (= data/map-width (count (head tilemap))))
    (is (= nil (get-in tilemap [0 0])))))

(deftest normalize-layer-adds_source_tile_ref_defaults
  (let [layer (data/normalize-layer {:id :scene/ground
                                     :label "Ground"
                                     :tileset :terrain
                                     :tiles [[:grass nil]]})]
    (is (= :tile (:kind layer)))
    (is (= :source (:role layer)))
    (is (= :tile-ref (:data-kind layer)))
    (is (= [[:grass nil]] (:tiles layer)))))

(deftest project-document-creates_default_layer_profile_from_layers
  (let [document (data/project-document
                  {:tilesets []
                   :brushes []
                   :layers [{:id :scene/ground
                             :label "Ground"
                             :kind :tile
                             :tileset :terrain
                             :tiles [[:grass nil]]}]})]
    (is (= data/default-layer-profile-id
           (-> document :tilemap :layer-profile)))
    (is (= [{:id data/default-layer-profile-id
             :label data/default-layer-profile-label
             :layers [{:id :scene/ground
                       :label "Ground"
                       :kind :tile
                       :tileset :terrain
                       :role :source
                       :data-kind :tile-ref}]}]
           (:layer-profiles document)))))

(deftest project-document-saves_terrain_sets
  (let [document (data/project-document
                  {:terrain-sets [{:id :overworld
                                   :terrains [{:id :grass
                                               :tile :grass}]}]
                   :layers []})]
    (is (= [{:id :overworld
             :terrains [{:id :grass
                         :tile :grass}]}]
           (:terrain-sets document)))))

(deftest project-document-saves_rulesets
  (let [document (data/project-document
                  {:rulesets [{:id :grass-marching
                               :kind :marching-4}]
                   :layers []})]
    (is (= [{:id :grass-marching
             :kind :marching-4}]
           (:rulesets document)))))

(deftest selected-layer-profile-id-falls_back_to_existing_profile
  (is (= :overworld
         (data/selected-layer-profile-id [{:id :overworld}]
                                         :missing))))

(deftest normalize-project-document-defaults_legacy_layers_to_profile
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :tilemap {:layers [{:id :scene/ground
                                       :label "Ground"
                                       :tileset :terrain
                                       :tiles [[:grass nil]]}]}})]
    (is (= data/default-layer-profile-id
           (-> document :tilemap :layer-profile)))
    (is (= :source
           (get-in document [:tilemap :layers 0 :role])))
    (is (= :tile-ref
           (get-in document [:tilemap :layers 0 :data-kind])))
    (is (= :scene/ground
           (get-in document [:layer-profiles 0 :layers 0 :id])))))

(deftest normalize-project-document-normalizes_brush_pattern_layers
  (let [document (data/normalize-project-document
                  {:brushes [{:id :brush
                              :kind :pattern
                              :pattern {:layers [{:id :stamp
                                                   :tileset :terrain
                                                   :tiles [[:grass nil]]}]}}]
                   :layer-profiles [{:id :default
                                     :layers [{:id :scene/terrain
                                               :role :source
                                               :data-kind :tile-ref
                                               :tileset :terrain}]}]
                   :tilemap {:layers []}})]
    (is (= [[:grass nil]]
           (get-in document
                   [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= :scene/terrain
           (get-in document
                   [:brushes 0 :pattern :layers 0 :target-layer])))))
