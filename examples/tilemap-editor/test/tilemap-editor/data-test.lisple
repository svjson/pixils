(ns tilemap-editor.data-test
  (:require proof.core
            [tilemap-editor.controls :as controls]
            [tilemap-editor.data :as data]
            [tilemap-editor.tilemap :as tilemap]))

(def EXAMPLE-MAP-PATH "example-maps/map1.edn")

(defun layer-tile-refs [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter row (fn [tile-ref]
                                  (not (nil? tile-ref))))))))

(defun invalid-tile-ref-entries [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter (for-indexed [x tile-ref row]
                              {:layer (:id layer)
                               :x x
                               :ref tile-ref
                               :type (type-of tile-ref)})
                            (fn [entry]
                              (and (not (nil? (:ref entry)))
                                   (not (keyword? (:ref entry)))
                                   (not (number? (:ref entry))))))))))

(defun unresolved-tile-refs [layer]
  (let [tileset (:tileset layer)]
    (filter (layer-tile-refs layer)
            (fn [tile-ref]
              (nil? (data/tile-in tileset tile-ref))))))

(defun sprite-tiles-without-source [layer]
  (let [tileset (:tileset layer)]
    (filter (map (layer-tile-refs layer)
                 (fn [tile-ref]
                   (data/tile-in tileset tile-ref)))
            (fn [tile]
              (and (= (:type tile) :sprite)
                   (nil? (:source tile)))))))

(defun project-open-state []
  (controls/apply-project-file-dialog-result
   {:layers (data/make-layered-map)
    :selected-layer-index 0
    :hidden-layer-indices []}
   {:type :confirm
    :mode :file-dialog/open
    :path EXAMPLE-MAP-PATH
    :directory "example-maps"
    :filename "map1.edn"}))

(deftest clamp-tile-index-stays-inside-tileset
  (is (= 0 (data/clamp-tile-index :platform-level -10)))
  (is (= 0 (data/clamp-tile-index :platform-level nil)))
  (is (= (dec (data/tile-count-for :platform-level))
         (data/clamp-tile-index :platform-level 999))))

(deftest string-map-to-tile-map-converts-characters-to-tile-ids
  (is (= [[:rock-top :rock-face]]
         (data/string-map-to-tile-map :platform-level ["^#"]))))

(deftest tilemap-clamp-bounds-values
  (is (= 0 (tilemap/clamp -4 0 10)))
  (is (= 7 (tilemap/clamp 7 0 10)))
  (is (= 10 (tilemap/clamp 18 0 10))))

(deftest empty-project-document-does-not-invent-tilesets-or-layers
  (let [document (data/project-document {:tilesets []
                                         :layers []})]
    (is (= [] (:tilesets document)))
    (is (= [] (-> document :tilemap :layers)))))

(deftest missing-tileset-does-not-fall-back-to-sample-tiles
  (is (= [] (data/tile-options-for nil)))
  (is (nil? (data/tile-in nil 0)))
  (is (nil? (data/tile-id-in nil 0))))

(deftest example-map-loads-through-open-project-path
  (let [state (project-open-state)]
    (is (= 4 (count (:layers state))))
    (is (= 4 (count (:tilesets state))))
    (is (= "Background" (:selected-layer-label state)))
    (is (= :colors (:tileset state)))
    (is (= :night (:selected-tile state)))))

(deftest example-map-layer-tile-references-resolve-to-renderable-tiles
  (let [state (project-open-state)]
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (invalid-tile-ref-entries layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (unresolved-tile-refs layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (sprite-tiles-without-source layer))))))))
