(ns tilemap-editor.io.project-test
  (:require proof.core
            [tilemap-editor.model.data :as data]
            [tilemap-editor.io.project :as project-io]))

(def EXAMPLE-MAP-PATH "example-maps/map1.edn")

(defun layer-tile-refs [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter row (fn [tile-ref]
                                  (not (nil? tile-ref))))))))

(defun invalid-tile-ref-entries [layer]
  (reduce (:tiles layer)
          []
          (fn [result row]
            (concat result
                    (filter (for-indexed [x tile-ref row]
                              {:layer (:id layer)
                               :x x
                               :ref tile-ref
                               :type (type-of tile-ref)})
                            (fn [entry]
                              (and (not (nil? (:ref entry)))
                                   (not (keyword? (:ref entry)))
                                   (not (number? (:ref entry))))))))))

(defun unresolved-tile-refs [tilesets layer]
  (let [tileset (:tileset layer)]
    (filter (layer-tile-refs layer)
            (fn [tile-ref]
              (nil? (data/tile-in tilesets tileset tile-ref))))))

(defun sprite-tiles-without-source [tilesets layer]
  (let [tileset (:tileset layer)]
    (filter (map (layer-tile-refs layer)
                 (fn [tile-ref]
                   (data/tile-in tilesets tileset tile-ref)))
            (fn [tile]
              (and (= (:type tile) :sprite)
                   (nil? (:source tile)))))))

(defun tileset-image-refs [tilesets]
  (reduce (or tilesets [])
          []
          (fn [result tileset]
            (concat result
                    (map (filter (or (:tiles tileset) [])
                                 (fn [tile]
                                   (= (:type tile) :sprite)))
                         :image)))))

(defun project-open-state []
  (project-io/apply-project-file-dialog-result
   {:layers (data/make-layered-map)
    :selected-layer-index 0
    :hidden-layer-indices []}
   {:type :confirm
    :mode :file-dialog/open
    :path EXAMPLE-MAP-PATH
    :directory "example-maps"
    :filename "map1.edn"}))

(deftest project-tilesets-come-from-project-document
  (is (= [{:id :terrain}]
         (project-io/project-tilesets {:tilesets [{:id :terrain}]})))
  (is (= [] (project-io/project-tilesets {}))))

(deftest project-brushes-come-from-project-document
  (is (= [{:id :brush}]
         (project-io/project-brushes {:brushes [{:id :brush}]})))
  (is (= [] (project-io/project-brushes {}))))

(deftest project-layer-profiles-default_from_legacy_layers
  (let [profiles (project-io/project-layer-profiles
                  {:tilemap {:layers [{:id :scene/ground
                                       :label "Ground"
                                       :tileset :terrain
                                       :tiles [[:grass]]}]}})]
    (is (= data/default-layer-profile-id
           (:id (head profiles))))
    (is (= :scene/ground
           (get-in profiles [0 :layers 0 :id])))
    (is (= :source
           (get-in profiles [0 :layers 0 :role])))
    (is (= :tile-ref
           (get-in profiles [0 :layers 0 :data-kind])))))

(deftest recent-project-history-promotes-existing-projects
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}
                  {:path "second.edn"
                   :filename "second.edn"}
                  {:path "third.edn"
                   :filename "third.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "second.edn"
                   :filename "second.edn"})]
    (is (= ["second.edn" "first.edn" "third.edn"]
           (map promoted :path)))))

(deftest recent-project-history-adds-new-projects-first
  (let [projects [{:path "first.edn"
                   :filename "first.edn"}]
        promoted (project-io/promote-recent-project
                  projects
                  {:path "new.edn"
                   :filename "new.edn"})]
    (is (= ["new.edn" "first.edn"]
           (map promoted :path)))))

(deftest example-map-loads-through-open-project-path
  (let [state (project-open-state)]
    (is (= 4 (count (:layers state))))
    (is (= 4 (count (:tilesets state))))
    (is (= data/default-layer-profile-id (:selected-layer-profile-id state)))
    (is (= 4 (count (get-in state [:layer-profiles 0 :layers]))))
    (is (= "Background" (:selected-layer-label state)))
    (is (= :colors (:tileset state)))
    (is (= :night (:selected-tile state)))))

(deftest example-map-owns-its-image-resource
  (let [state (project-open-state)
        image-refs (tileset-image-refs (:tilesets state))]
    (is (= "../assets/simples_pimples.png"
           (get-in state
                   [:resources
                    :bundles
                    :project-assets
                    :images
                    :simples-pimples
                    :file-name])))
    (is (= [] (filter image-refs
                      (fn [image]
                        (= image :editor-assets/spritesheet)))))
    (is (> (count image-refs) 0))
    (is (= [] (filter image-refs
                      (fn [image]
                        (not= image :project-assets/simples-pimples)))))))

(deftest example-map-layer-tile-references-resolve-to-renderable-tiles
  (let [state (project-open-state)]
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (invalid-tile-ref-entries layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result (unresolved-tile-refs (:tilesets state) layer))))))
    (is (= []
           (reduce (:layers state)
                   []
                   (fn [result layer]
                     (concat result
                             (sprite-tiles-without-source (:tilesets state) layer))))))))
