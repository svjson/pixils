(ns tilemap-editor.view.tilemap.controls-test
  (:require proof.core
            [tilemap-editor.view.tilemap.controls :as controls]
            [tilemap-editor.view.tilemap.palette :as palette]
            [tilemap-editor.view.tileset.layout :as tileset-layout]
            [tilemap-editor.model.data :as data]))

(deftest empty-layer-list-keeps-minimum-height
  (is (= 78 (controls/layer-list-height [])))
  (is (= 78 (controls/layer-list-height [1 2])))
  (is (= 104 (controls/layer-list-height [1 2 3 4]))))

(deftest tileset-selector-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/tileset-combo-child [])))))
  (is (= true (:disabled? (:state (controls/tileset-combo-child nil)))))
  (is (= false (:disabled? (:state (controls/tileset-combo-child [{:id :terrain
                                                                    :label "Terrain"}]))))))

(deftest layer-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/layer-list-box-child [])))))
  (is (= true (:disabled? (:state (controls/layer-list-box-child nil)))))
  (is (not= true (:disabled? (:state (controls/layer-list-box-child [{:label "Ground"}]))))))

(deftest tile-palette-is-disabled-when-empty
  (is (= true (:disabled? (:state (palette/tile-palette-list-box-child [] nil)))))
  (is (not= true
            (:disabled? (:state (palette/tile-palette-list-box-child
                                 (data/project-tileset-definitions)
                                 :colors))))))

(deftest tileset-definition-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (tileset-layout/tileset-list-box-child [])))))
  (is (= true (:disabled? (:state (tileset-layout/tileset-list-box-child nil)))))
  (is (not= true
            (:disabled? (:state (tileset-layout/tileset-list-box-child
                                 [{:id :terrain
                                   :label "Terrain"}]))))))

(deftest tileset-workspace-disables_dependent_panels_without_selection
  (let [empty-state (tileset-layout/derive-tileset-workspace-state
                     {:selected-tileset-definition-index nil
                      :selected-tileset-tile-index nil})
        tileset-state (tileset-layout/derive-tileset-workspace-state
                       {:selected-tileset-definition-index 0
                        :selected-tileset-tile-index nil})
        tile-state (tileset-layout/derive-tileset-workspace-state
                    {:selected-tileset-definition-index 0
                     :selected-tileset-tile-index 0})]
    (is (= true (:tile-set-panel-disabled? empty-state)))
    (is (= true (:tile-definition-panel-disabled? empty-state)))
    (is (= false (:tile-set-panel-disabled? tileset-state)))
    (is (= true (:tile-definition-panel-disabled? tileset-state)))
    (is (= false (:tile-set-panel-disabled? tile-state)))
    (is (= false (:tile-definition-panel-disabled? tile-state)))))

(deftest tileset-list-panel-has_project_header_and_add_button
  (let [panel (tileset-layout/make-tileset-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Project Tile Sets" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))))

(deftest tileset-creation-adds_and_selects_new_tileset
  (let [state (tileset-layout/add-tileset-definition!
               {:tilesets []
                :selected-tileset-definition-index nil
                :selected-tileset-tile-index nil}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 32})]
    (is (= [{:id :terrain
             :label "Terrain"
             :tile-size 32
             :tiles []}]
           (:tilesets state)))
    (is (= 0 (:selected-tileset-definition-index state)))
    (is (= nil (:selected-tileset-tile-index state)))))

(deftest tileset-creation-deduplicates_ids
  (let [state (tileset-layout/add-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain Copy"
                :tile-size 16})]
    (is (= :terrain-2 (get-in state [:tilesets 1 :id])))))

(deftest tile-creation-adds_and_selects_new_tile
  (let [state (tileset-layout/add-tile-definition!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index nil
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 32
                            :tiles []}]}
               {:type :confirm
                :tile-id "grass"
                :tile-name "Grass"
                :tile-char "g"
                :tile-type :color})]
    (is (= {:id :grass
            :name "Grass"
            :char "g"
            :type :color
            :color {:r 0 :g 0 :b 0}}
           (get-in state [:tilesets 0 :tiles 0])))
    (is (= 0 (:selected-tileset-tile-index state)))))

(deftest sprite_tile_creation_uses_tileset_tile_size
  (let [state (tileset-layout/add-tile-definition!
               {:selected-tileset-definition-index 0
                :tilesets [{:id :actors
                            :label "Actors"
                            :tile-size 32
                            :tiles []}]}
               {:type :confirm
                :tile-id "hero"
                :tile-name "Hero"
                :tile-char "@"
                :tile-type :sprite})]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in state [:tilesets 0 :tiles 0 :source])))))

(deftest recent-project-menu-is-inert-when-empty
  (let [item (controls/recent-project-menu-item [])]
    (is (= "Recent Projects" (:label item)))
    (is (= true (:disabled? item)))
    (is (nil? (:items item)))))

(deftest recent-project-menu-opens-submenu-when-populated
  (let [item (controls/recent-project-menu-item [{:path "map.edn"
                                                  :filename "map.edn"}])]
    (is (= "Recent Projects ->" (:label item)))
    (is (= "map.edn" (get-in item [:items 0 :label])))
    (is (= :project/open-recent (get-in item [:items 0 :action])))))

(deftest selected-tileset-tile-comes-from-current-grid-selection
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 1
               :tilesets [{:tiles [{:id :first}
                                   {:id :second}]}]}]
    (is (= :second (:id (tileset-layout/selected-tileset-tile state))))))

(deftest tile-definition-type-change-adds-default_sprite_facts
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tiles [{:id :night
                                    :type :color
                                    :color {:r 1 :g 2 :b 3}}]}]}
        next (tileset-layout/set-selected-tile-type state :sprite)]
    (is (= :sprite (get-in next [:tilesets 0 :tiles 0 :type])))
    (is (= :editor-assets/spritesheet
           (get-in next [:tilesets 0 :tiles 0 :image])))
    (is (= {:x 0 :y 0 :w 16 :h 16}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tile-definition-type-change-uses-tileset-tile-size
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tile-size 32
                           :tiles [{:id :night
                                    :type :color}]}]}
        next (tileset-layout/set-selected-tile-type state :sprite)]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tile-definition-color-channel-change-updates-selected-tile
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tiles [{:id :night
                                    :type :color
                                    :color {:r 1 :g 2 :b 3}}]}]}
        next (tileset-layout/set-selected-tile-color-channel state :g 128)]
    (is (= {:r 1 :g 128 :b 3}
           (get-in next [:tilesets 0 :tiles 0 :color])))))

(deftest sprite-map-preview-source-rect-scales-from-full-asset
  (let [image-rect (tileset-layout/sprite-map-preview-image-rect {:w 800
                                                                  :h 1280})
        source-rect (tileset-layout/sprite-map-preview-source-rect
                     {:x 0 :y 96 :w 16 :h 16}
                     image-rect)]
    (is (= 20 (:x image-rect)))
    (is (= 0 (:y image-rect)))
    (is (= 0.25 (:scale image-rect)))
    (is (= {:x 20 :y 24 :w 4 :h 4}
           source-rect))))

(deftest sprite-map-preview-position-selects_tile_coordinates
  (let [image-rect (tileset-layout/sprite-map-preview-image-rect {:w 800
                                                                  :h 1280})]
    (is (= {:x 32 :y 96 :w 16 :h 16}
           (tileset-layout/source-position-from-preview-position
            {:x 28 :y 27}
            image-rect
            {:w 800 :h 1280}
            16)))))

(deftest sprite-map-preview-source-navigation-clamps_to_asset_bounds
  (is (= {:x 784 :y 1264 :w 16 :h 16}
         (tileset-layout/move-source-position {:x 784 :y 1264 :w 16 :h 16}
                                             16
                                             16
                                             16
                                             {:w 800 :h 1280})))
  (is (= {:x 0 :y 0 :w 16 :h 16}
         (tileset-layout/move-source-position {:x 0 :y 0 :w 16 :h 16}
                                             -16
                                             -16
                                             16
                                             {:w 800 :h 1280}))))

(deftest selected-sprite-source-update-uses_tileset_tile_size
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tile-size 32
                           :tiles [{:id :hero
                                    :type :sprite
                                    :source {:x 0 :y 0 :w 16 :h 16}}]}]}
        next (tileset-layout/set-selected-tile-source-position state
                                                               65
                                                               96
                                                               {:w 800 :h 1280})]
    (is (= {:x 64 :y 96 :w 32 :h 32}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tileset-tile-grid-position-and-key-movement
  (is (= 3 (tileset-layout/tile-grid-columns {:w 48 :h 80})))
  (is (= 0 (tileset-layout/tile-grid-index-at-position {:x 2 :y 2}
                                                       {:w 48 :h 80}
                                                       8)))
  (is (= 4 (tileset-layout/tile-grid-index-at-position {:x 18 :y 18}
                                                       {:w 48 :h 80}
                                                       8)))
  (is (= 2 (tileset-layout/tile-grid-index-at-position {:x 35 :y 2}
                                                       {:w 48 :h 80}
                                                       8)))
  (is (= 4 (tileset-layout/move-tile-grid-index 1 8 3 3)))
  (is (= 7 (tileset-layout/move-tile-grid-index 6 8 3 3)))
  (is (= 0 (tileset-layout/move-tile-grid-index 1 8 3 -3))))
