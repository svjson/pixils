(ns tilemap-editor.view.tileset.model-test
  (:require proof.core
            [tilemap-editor.view.tileset.model :as model]))

(deftest tileset-workspace-disables_dependent_panels_without_selection
  (let [empty-state (model/derive-tileset-workspace-state
                     {:selected-tileset-definition-index nil
                      :selected-tileset-tile-index nil})
        tileset-state (model/derive-tileset-workspace-state
                       {:selected-tileset-definition-index 0
                        :selected-tileset-tile-index nil})
        tile-state (model/derive-tileset-workspace-state
                    {:selected-tileset-definition-index 0
                     :selected-tileset-tile-index 0})]
    (is (= true (:tile-set-panel-disabled? empty-state)))
    (is (= true (:tile-definition-panel-disabled? empty-state)))
    (is (= false (:tile-set-panel-disabled? tileset-state)))
    (is (= true (:tile-definition-panel-disabled? tileset-state)))
    (is (= false (:tile-set-panel-disabled? tile-state)))
    (is (= false (:tile-definition-panel-disabled? tile-state)))))

(deftest tileset-workspace-knows_when_project_image_resources_exist
  (is (= false
         (:has-project-image-resources?
          (model/derive-tileset-workspace-state
           {:resources {:bundles {:editor-assets
                                  {:dynamic? false
                                   :images {:spritesheet
                                            {:file-name "sprites.png"}}}}}}))))
  (is (= true
         (:has-project-image-resources?
          (model/derive-tileset-workspace-state
           {:resources {:bundles {:project-assets
                                  {:images {:tiles
                                            {:file-name "tiles.png"}}}}}})))))

(deftest tileset-creation-adds_and_selects_new_tileset
  (let [state (model/add-tileset-definition!
               {:tilesets []
                :selected-tileset-definition-index nil
                :selected-tileset-tile-index nil}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 32})]
    (is (= [{:id :terrain
             :label "Terrain"
             :tile-size 32
             :tiles []}]
           (:tilesets state)))
    (is (= 0 (:selected-tileset-definition-index state)))
    (is (= nil (:selected-tileset-tile-index state)))))

(deftest tileset-creation-deduplicates_ids
  (let [state (model/add-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-id "terrain"
                :tileset-label "Terrain Copy"
                :tile-size 16})]
    (is (= :terrain-2 (get-in state [:tilesets 1 :id])))))

(deftest tileset-edit-updates-definition-and-references
  (let [state (model/edit-tileset-definition!
               {:tileset :terrain
                :selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :layers [{:id :ground
                          :tileset :terrain}
                         {:id :details
                          :tileset :decor}]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass
                                     :type :sprite
                                     :source {:x 8 :y 16 :w 16 :h 16}}
                                    {:id :water
                                     :type :color
                                     :color {:r 0 :g 0 :b 255}}]}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "world terrain"
                :tileset-label "World Terrain"
                :tile-size 32})]
    (is (= {:id :world-terrain
            :label "World Terrain"
            :tile-size 32
            :tiles [{:id :grass
                     :type :sprite
                     :source {:x 8 :y 16 :w 32 :h 32}}
                    {:id :water
                     :type :color
                     :color {:r 0 :g 0 :b 255}}]}
           (get-in state [:tilesets 0])))
    (is (= :world-terrain (:tileset state)))
    (is (= :world-terrain (get-in state [:layers 0 :tileset])))
    (is (= :decor (get-in state [:layers 1 :tileset])))
    (is (= 0 (:selected-tileset-definition-index state)))
    (is (= 1 (:selected-tileset-tile-index state)))))

(deftest tileset-edit-adds-source-dimensions-to-existing-sprite-tiles
  (let [state (model/edit-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass
                                     :type :sprite}]}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "terrain"
                :tileset-label "Terrain"
                :tile-size 32})]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in state [:tilesets 0 :tiles 0 :source])))))

(deftest tileset-edit-deduplicates-id-excluding-current-tileset
  (let [state (model/edit-tileset-definition!
               {:tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles []}
                           {:id :decor
                            :label "Decor"
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tileset-index 0
                :tileset-id "decor"
                :tileset-label "Decor Copy"
                :tile-size 16})]
    (is (= :decor-2 (get-in state [:tilesets 0 :id])))))

(deftest tile-creation-adds_and_selects_new_tile
  (let [state (model/add-tile-definition!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index nil
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 32
                            :tiles []}]}
               {:type :confirm
                :tile-id "grass"
                :tile-name "Grass"
                :tile-char "g"
                :tile-type :color})]
    (is (= {:id :grass
            :name "Grass"
            :char "g"
            :type :color
            :color {:r 0 :g 0 :b 0}}
           (get-in state [:tilesets 0 :tiles 0])))
    (is (= 0 (:selected-tileset-tile-index state)))))

(deftest tile-grid-selection-range-selects-rectangular_tiles
  (is (= [1 2 5 6]
         (model/tile-grid-selection-range 1 6 4 10))))

(deftest tileset-tile-delete-removes-selected-tiles-and-layer_refs
  (let [state (model/delete-tileset-tiles!
               {:selected-tileset-definition-index 0
                :selected-tileset-tile-index 1
                :selected-tileset-tile-indices [1 2]
                :tilesets [{:id :terrain
                            :label "Terrain"
                            :tile-size 16
                            :tiles [{:id :grass}
                                    {:id :water}
                                    {:id :lava}
                                    {:id :stone}]}
                           {:id :actors
                            :label "Actors"
                            :tile-size 16
                            :tiles [{:id :hero}]}]
                :layers [{:id :level
                          :tileset :terrain
                          :tiles [[:grass :water :lava :stone]
                                  [0 1 2 3]]}
                         {:id :actor
                          :tileset :actors
                          :tiles [[:hero :water]]}]}
               {:choice :dialog/ok
                :payload {:operation :delete-tiles
                          :tile-indices [1 2]}})]
    (is (= [{:id :grass}
            {:id :stone}]
           (get-in state [:tilesets 0 :tiles])))
    (is (= [[:grass nil nil :stone]
            [0 nil nil 1]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[:hero :water]]
           (get-in state [:layers 1 :tiles])))
    (is (= 1 (:selected-tileset-tile-index state)))
    (is (= [1] (:selected-tileset-tile-indices state)))))

(deftest sprite_tile_creation_uses_tileset_tile_size
  (let [state (model/add-tile-definition!
               {:selected-tileset-definition-index 0
                :tilesets [{:id :actors
                            :label "Actors"
                            :tile-size 32
                            :tiles []}]}
               {:type :confirm
                :tile-id "hero"
                :tile-name "Hero"
                :tile-char "@"
                :tile-type :sprite})]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in state [:tilesets 0 :tiles 0 :source])))))

(deftest image-resource-options-list_project_images
  (is (= [{:id :sprites
           :bundle-id :assets
           :key :assets/sprites
           :name "Sprites"
           :file-name "sprites.png"
           :value 0
           :label ":assets/sprites  Sprites"}]
         (model/image-resource-options
          {:bundles {:assets
                     {:images {:sprites {:name "Sprites"
                                         :file-name "sprites.png"}}}}}
          :assets))))

(deftest image-resource-options-ignore_static_editor_assets
  (is (= []
         (model/image-resource-entries
          {:bundles {:editor-assets
                     {:dynamic? false
                      :images {:spritesheet {:file-name "sprites.png"}}}}}))))

(deftest image-resource-options-ignore_static_editor_assets_without_dynamic_flag
  (is (= []
         (model/image-resource-entries
          {:bundles {:editor-assets
                     {:images {:spritesheet {:file-name "sprites.png"}}}}}))))

(deftest import-source-rects-can_select_all_tiles
  (let [state {:selected-tileset-definition-index 0
               :tilesets [{:tiles []}]
               :tile-size 16
               :select-all? true
               :exclude-same-tileset? false
               :exclude-project? false}]
    (is (= [{:x 0 :y 0 :w 16 :h 16}
            {:x 16 :y 0 :w 16 :h 16}
            {:x 0 :y 16 :w 16 :h 16}
            {:x 16 :y 16 :w 16 :h 16}]
           (model/import-source-rects state
                                      :assets/sprites
                                      {:w 32 :h 32})))))

(deftest import-source-rects-start_empty_without_select_all
  (let [state {:selected-tileset-definition-index 0
               :tilesets [{:tiles []}]
               :tile-size 16
               :select-all? false
               :selected-source-indices []
               :exclude-same-tileset? false
               :exclude-project? false}]
    (is (= []
           (model/import-source-rects state
                                      :assets/sprites
                                      {:w 32 :h 32})))))

(deftest import-source-rects-can_select_all_with_custom_interval
  (let [state {:selected-tileset-definition-index 0
               :tilesets [{:tiles []}]
               :tile-size 16
               :source-snap-interval 8
               :source-snap-interval-custom? true
               :select-all? true
               :exclude-same-tileset? false
               :exclude-project? false}]
    (is (= [{:x 0 :y 0 :w 16 :h 16}
            {:x 8 :y 0 :w 16 :h 16}
            {:x 16 :y 0 :w 16 :h 16}
            {:x 0 :y 8 :w 16 :h 16}
            {:x 8 :y 8 :w 16 :h 16}
            {:x 16 :y 8 :w 16 :h 16}
            {:x 0 :y 16 :w 16 :h 16}
            {:x 8 :y 16 :w 16 :h 16}
            {:x 16 :y 16 :w 16 :h 16}]
           (model/import-source-rects state
                                      :assets/sprites
                                      {:w 32 :h 32})))))

(deftest import-source-rects-can_use_explicit_sources
  (let [state {:selected-tileset-definition-index 0
               :tilesets [{:tiles []}]
               :tile-size 16
               :select-all? false
               :selected-sources [{:x 5 :y 7 :w 16 :h 16}]
               :exclude-same-tileset? false
               :exclude-project? false}]
    (is (= [{:x 5 :y 7 :w 16 :h 16}]
           (model/import-source-rects state
                                      :assets/sprites
                                      {:w 32 :h 32})))))

(deftest import-source-rects-excludes_existing_project_tiles
  (let [state {:selected-tileset-definition-index 0
               :tilesets [{:tiles [{:id :a
                                    :type :sprite
                                    :image :assets/sprites
                                    :source {:x 0 :y 0 :w 16 :h 16}}]}
                          {:tiles [{:id :b
                                    :type :sprite
                                    :image :assets/sprites
                                    :source {:x 16 :y 0 :w 16 :h 16}}]}]
               :tile-size 16
               :select-all? true
               :exclude-same-tileset? true
               :exclude-project? true}]
    (is (= [{:x 0 :y 16 :w 16 :h 16}
            {:x 16 :y 16 :w 16 :h 16}]
           (model/import-source-rects state
                                      :assets/sprites
                                      {:w 32 :h 32})))))

(deftest imported_sprite_tiles_get_default_names_and_unique_ids
  (let [state (model/add-imported-sprite-tiles!
               {:selected-tileset-definition-index 0
                :tilesets [{:id :terrain
                            :tile-size 16
                            :tiles [{:id :sprites-1}]}]}
               {:type :confirm
                :resource {:id :sprites
                           :key :assets/sprites
                           :name "Sprites"}
                :sources [{:x 0 :y 0 :w 16 :h 16}
                          {:x 16 :y 0 :w 16 :h 16}]})]
    (is (= [:sprites-1 :sprites-1-2 :sprites-2]
           (map (get-in state [:tilesets 0 :tiles])
                (fn [tile] (:id tile)))))
    (is (= "Sprites 1"
           (get-in state [:tilesets 0 :tiles 1 :name])))
    (is (= :assets/sprites
           (get-in state [:tilesets 0 :tiles 1 :image])))
    (is (= 1 (:selected-tileset-tile-index state)))))

(deftest imported_single_sprite_tiles_create_one_tile_per_resource
  (let [state (model/add-imported-single-sprite-tiles!
               {:selected-tileset-definition-index 0
                :last-imported-image-resources [{:key :project-assets/red-tile}]
                :tilesets [{:id :terrain
                            :tile-size 32
                            :tiles []}]}
               [{:id :red-tile
                 :key :project-assets/red-tile
                 :name "Red Tile"}
                {:id :blue-tile
                 :key :project-assets/blue-tile
                 :name "Blue Tile"}])]
    (is (= [{:id :red-tile
             :name "Red Tile"
             :char "r"
             :type :sprite
             :image :project-assets/red-tile
             :source {:x 0 :y 0 :w 32 :h 32}}
            {:id :blue-tile
             :name "Blue Tile"
             :char "b"
             :type :sprite
             :image :project-assets/blue-tile
             :source {:x 0 :y 0 :w 32 :h 32}}]
           (get-in state [:tilesets 0 :tiles])))
    (is (= nil (:last-imported-image-resources state)))))

(deftest color_range_creation_adds_numbered_color_tiles
  (let [state (model/add-color-tile-range!
               {:selected-tileset-definition-index 0
                :tilesets [{:id :colors
                            :tile-size 16
                            :tiles []}]}
               {:type :confirm
                :tile-id "swatch"
                :tile-name "Swatch"
                :count 3
                :from-color {:r 0 :g 0 :b 0}
                :to-color {:r 10 :g 20 :b 30}})]
    (is (= [:swatch-1 :swatch-2 :swatch-3]
           (map (get-in state [:tilesets 0 :tiles])
                (fn [tile] (:id tile)))))
    (is (= "Swatch 2"
           (get-in state [:tilesets 0 :tiles 1 :name])))
    (is (= [{:r 0 :g 0 :b 0}
            {:r 5 :g 10 :b 15}
            {:r 10 :g 20 :b 30}]
           (map (get-in state [:tilesets 0 :tiles])
                (fn [tile] (:color tile)))))
    (is (= 0 (:selected-tileset-tile-index state)))))

(deftest selected-tileset-tile-comes-from-current-grid-selection
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 1
               :tilesets [{:tiles [{:id :first}
                                   {:id :second}]}]}]
    (is (= :second (:id (model/selected-tileset-tile state))))))

(deftest tile-definition-type-change-adds-default_sprite_facts
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tiles [{:id :night
                                    :type :color
                                    :color {:r 1 :g 2 :b 3}}]}]}
        next (model/set-selected-tile-type state :sprite)]
    (is (= :sprite (get-in next [:tilesets 0 :tiles 0 :type])))
    (is (nil? (get-in next [:tilesets 0 :tiles 0 :image])))
    (is (= {:x 0 :y 0 :w 16 :h 16}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tile-definition-type-change-uses-tileset-tile-size
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tile-size 32
                           :tiles [{:id :night
                                    :type :color}]}]}
        next (model/set-selected-tile-type state :sprite)]
    (is (= {:x 0 :y 0 :w 32 :h 32}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tile-definition-color-channel-change-updates-selected-tile
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tiles [{:id :night
                                    :type :color
                                    :color {:r 1 :g 2 :b 3}}]}]}
        next (model/set-selected-tile-color-channel state :g 128)]
    (is (= {:r 1 :g 128 :b 3}
           (get-in next [:tilesets 0 :tiles 0 :color])))))

(deftest selected-sprite-source-update-uses_tileset_tile_size
  (let [state {:selected-tileset-definition-index 0
               :selected-tileset-tile-index 0
               :tilesets [{:tile-size 32
                           :tiles [{:id :hero
                                    :type :sprite
                                    :source {:x 0 :y 0 :w 16 :h 16}}]}]}
        next (model/set-selected-tile-source-position state
                                                      65
                                                      96
                                                      {:w 800 :h 1280})]
    (is (= {:x 64 :y 96 :w 32 :h 32}
           (get-in next [:tilesets 0 :tiles 0 :source])))))

(deftest tileset-tile-grid-position-and-key-movement
  (is (= 3 (model/tile-grid-columns {:w 48 :h 80})))
  (is (= 0 (model/tile-grid-index-at-position {:x 2 :y 2}
                                              {:w 48 :h 80}
                                              8)))
  (is (= 4 (model/tile-grid-index-at-position {:x 18 :y 18}
                                              {:w 48 :h 80}
                                              8)))
  (is (= 2 (model/tile-grid-index-at-position {:x 35 :y 2}
                                              {:w 48 :h 80}
                                              8)))
  (is (= 4 (model/move-tile-grid-index 1 8 3 3)))
  (is (= 7 (model/move-tile-grid-index 6 8 3 3)))
  (is (= 0 (model/move-tile-grid-index 1 8 3 -3))))
