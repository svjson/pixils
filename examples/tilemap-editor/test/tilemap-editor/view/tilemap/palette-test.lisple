(ns tilemap-editor.view.tilemap.palette-test
  (:require proof.core
            [tilemap-editor.view.tilemap.palette :as palette]
            [tilemap-editor.model.data :as data]))

(deftest tile-palette-is-disabled-when-empty
  (is (= true (:disabled? (:state (palette/tile-palette-list-box-child [] nil false)))))
  (is (= true
         (:disabled? (:state (palette/tile-palette-list-box-child
                              []
                              :colors
                              false))))))

(deftest tile-palette-is-disabled_without_layers
  (let [tilesets [{:id :colors
                   :label "Colors"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= true
           (:disabled? (:state (palette/tile-palette-list-box-child
                                tilesets
                                :colors
                                true)))))
    (is (not= true
              (:disabled? (:state (palette/tile-palette-list-box-child
                                   tilesets
                                   :colors
                                   false)))))))

(deftest terrain-palette-lists_terrain_values
  (let [child (palette/source-palette-list-box-child
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}]}]
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :selected-layer-index 0
                :selected-tile :grass}
               false)]
    (is (not= true (:disabled? (:state child))))
    (is (= [{:value :grass
             :label "Grass"}]
           (:options (:state child))))
    (is (= [0]
           (palette/selected-tile-indices
            {:terrain-sets [{:id :overworld
                             :terrains [{:id :grass
                                         :label "Grass"}]}]
             :layers [{:id :scene/terrain
                       :data-kind :terrain
                       :terrain-set :overworld}]
             :selected-layer-index 0
             :selected-tile :grass})))))

(deftest brush-palette-is-disabled-when-empty
  (is (= true
         (:disabled? (:state (palette/brush-palette-list-box-child
                              []
                              false
                              nil))))))

(deftest brush-palette-selects_first_available_brush
  (let [brushes [{:id :stamp
                  :label "Stamp"
                  :kind :pattern}]]
    (is (= [0]
           (:selected-indices
            (:state (palette/brush-palette-list-box-child brushes
                                                          false
                                                          nil)))))))
