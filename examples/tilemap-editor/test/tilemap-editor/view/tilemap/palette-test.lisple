(ns tilemap-editor.view.tilemap.palette-test
  (:require proof.core
            [tilemap-editor.view.tilemap.palette :as palette]))

(deftest tile-palette-is-disabled-when-empty
  (is (= true
         (:disabled? (palette/tile-select-grid-state
                      {:tilesets []
                       :layers [{:id :ground
                                 :data-kind :tile-ref
                                 :tileset :colors}]
                       :selected-layer-index 0})))))

(deftest tile-palette-is-disabled_without_layers
  (let [tilesets [{:id :colors
                   :label "Colors"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= true
           (:disabled? (palette/tile-select-grid-state
                        {:tilesets tilesets
                         :layers []
                         :selected-layer-index nil}))))
    (is (not= true
              (:disabled? (palette/tile-select-grid-state
                           {:tilesets tilesets
                            :layers [{:id :ground
                                      :data-kind :tile-ref
                                      :tileset :colors}]
                            :selected-layer-index 0}))))))

(deftest terrain-palette-grid-lists_terrain_values
  (let [grid-state (palette/tile-select-grid-state
                    {:terrain-sets [{:id :overworld
                                     :terrains [{:id :grass
                                                 :label "Grass"}]}]
                     :layers [{:id :scene/terrain
                               :data-kind :terrain
                               :terrain-set :overworld}]
                     :selected-layer-index 0
                     :selected-tile :grass})]
    (is (not= true (:disabled? grid-state)))
    (is (= [{:value :grass
             :label "Grass"}]
           (:options grid-state)))
    (is (= [0]
           (palette/selected-tile-indices
            {:terrain-sets [{:id :overworld
                             :terrains [{:id :grass
                                         :label "Grass"}]}]
             :layers [{:id :scene/terrain
                       :data-kind :terrain
                       :terrain-set :overworld}]
             :selected-layer-index 0
             :selected-tile :grass})))))

(deftest brush-palette-is-disabled-when-empty
  (is (= true
         (:disabled? (:state (palette/brush-palette-list-box-child
                              []
                              false
                              nil))))))

(deftest brush-palette-selects_first_available_brush
  (let [brushes [{:id :stamp
                  :label "Stamp"
                  :kind :pattern}]]
    (is (= [0]
           (:selected-indices
            (:state (palette/brush-palette-list-box-child brushes
                                                          false
                                                          nil)))))))
