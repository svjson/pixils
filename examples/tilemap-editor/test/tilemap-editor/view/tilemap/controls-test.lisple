(ns tilemap-editor.view.tilemap.controls-test
  (:require proof.core
            [tilemap-editor.model.data :as data]
            [tilemap-editor.view.tilemap.controls :as controls]))

(deftest empty-layer-list-keeps-minimum-height
  (is (= 78 (controls/layer-list-height [])))
  (is (= 78 (controls/layer-list-height [1 2])))
  (is (= 104 (controls/layer-list-height [1 2 3 4]))))

(deftest tileset-selector-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/tileset-combo-child [] false)))))
  (is (= true (:disabled? (:state (controls/tileset-combo-child nil false)))))
  (is (= false (:disabled? (:state (controls/tileset-combo-child [{:id :terrain
                                                                    :label "Terrain"}]
                                                                   false))))))

(deftest tileset-selector-is-disabled_without_layers
  (is (= true (:disabled? (:state (controls/tileset-combo-child [{:id :terrain
                                                                   :label "Terrain"}]
                                                                  true))))))

(deftest layer-list-is-disabled-when-empty
  (is (= true (:disabled? (:state (controls/layer-list-box-child [])))))
  (is (= true (:disabled? (:state (controls/layer-list-box-child nil)))))
  (is (not= true (:disabled? (:state (controls/layer-list-box-child [{:label "Ground"}]))))))

(deftest layer-controls-has_add_button
  (let [panel (controls/make-layer-controls)]
    (is (= "+" (get-in panel [:children 0 :children 1 :state :label])))))

(deftest layer-type-options-show_disabled_terrain_without_sets
  (let [options (controls/layer-data-kind-options-for [])]
    (is (= "Tile layer" (get-in options [0 :label])))
    (is (= "Terrain layer" (get-in options [1 :label])))
    (is (= true (get-in options [1 :disabled?])))))

(deftest append-layer-adds_blank_tile_layer_and_selects_it
  (let [state (controls/append-layer
               {:layers []
                :tilesets [{:id :terrain
                            :label "Terrain"}]}
               "Terrain")]
    (is (= 0 (:selected-layer-index state)))
    (is (= "Terrain" (:selected-layer-label state)))
    (is (= :scene/terrain (get-in state [:layers 0 :id])))
    (is (= :terrain (get-in state [:layers 0 :tileset])))
    (is (= :source (get-in state [:layers 0 :role])))
    (is (= :tile-ref (get-in state [:layers 0 :data-kind])))
    (is (= data/map-height (count (get-in state [:layers 0 :tiles]))))
    (is (= data/map-width (count (get-in state [:layers 0 :tiles 0]))))))

(deftest append-layer-adds_blank_terrain_layer_when_requested
  (let [state (controls/append-layer
               {:layers []
                :terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               {:name "Terrain"
                :data-kind :terrain
                :terrain-set-index 0})]
    (is (= 0 (:selected-layer-index state)))
    (is (= "Terrain" (:selected-layer-label state)))
    (is (= :scene/terrain (get-in state [:layers 0 :id])))
    (is (= :source (get-in state [:layers 0 :role])))
    (is (= :terrain (get-in state [:layers 0 :data-kind])))
    (is (= :overworld (get-in state [:layers 0 :terrain-set])))
    (is (nil? (get-in state [:layers 0 :tileset])))
    (is (= data/map-height (count (get-in state [:layers 0 :tiles]))))
    (is (= data/map-width (count (get-in state [:layers 0 :tiles 0]))))))

(deftest layer-add-dialog-result-appends_unique_layer
  (let [state (controls/apply-layer-name-dialog-result
               {:layers [{:id :scene/layer
                          :label "Layer"}]}
               {:type :confirm
                :operation :add
                :name "Layer"})]
    (is (= "Layer 2" (get-in state [:layers 1 :label])))
    (is (= :scene/layer-2 (get-in state [:layers 1 :id])))
    (is (= 1 (:selected-layer-index state)))))

(deftest layer-add-dialog-result-appends_terrain_layer
  (let [state (controls/apply-layer-name-dialog-result
               {:layers []
                :terrain-sets [{:id :overworld
                                :label "Overworld"}]}
               {:type :confirm
                :operation :add
                :name "Terrain"
                :data-kind :terrain
                :terrain-set-index 0})]
    (is (= :terrain (get-in state [:layers 0 :data-kind])))
    (is (= :overworld (get-in state [:layers 0 :terrain-set])))))

(deftest append-layer-deduplicates_layer_ids
  (let [state (controls/append-layer
               {:layers [{:id :scene/terrain
                          :label "Terrain"}]}
               "Terrain")]
    (is (= :scene/terrain-2 (get-in state [:layers 1 :id])))))

(deftest recent-project-menu-is-inert-when-empty
  (let [item (controls/recent-project-menu-item [])]
    (is (= "Recent Projects" (:label item)))
    (is (= true (:disabled? item)))
    (is (nil? (:items item)))))

(deftest recent-project-menu-opens-submenu-when-populated
  (let [item (controls/recent-project-menu-item [{:path "map.edn"
                                                  :filename "map.edn"}])]
    (is (= "Recent Projects ->" (:label item)))
    (is (= "map.edn" (get-in item [:items 0 :label])))
    (is (= :project/open-recent (get-in item [:items 0 :action])))))
