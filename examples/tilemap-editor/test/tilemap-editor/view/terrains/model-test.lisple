(ns tilemap-editor.view.terrains.model-test
  (:require proof.core
            [tilemap-editor.view.terrains.model :as model]))

(deftest terrain-workspace-selects_first_available_set_and_terrain
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (= 0 (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-workspace-keeps_detail_enabled_without_terrains
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains []}]})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))
    (is (= false (:terrain-list-panel-disabled? state)))
    (is (= false (:terrain-detail-panel-disabled? state)))))

(deftest terrain-set-creation-adds_and_selects_new_set
  (let [state (model/add-terrain-set {:terrain-sets []})]
    (is (= :terrain-set (get-in state [:terrain-sets 0 :id])))
    (is (= "Terrain set" (get-in state [:terrain-sets 0 :label])))
    (is (= [] (get-in state [:terrain-sets 0 :terrains])))
    (is (= 0 (:selected-terrain-set-index state)))
    (is (nil? (:selected-terrain-index state)))))

(deftest terrain-set-creation-deduplicates_ids
  (let [state (model/add-terrain-set
               {:terrain-sets [{:id :terrain-set
                                :label "Terrain set"}]})]
    (is (= :terrain-set-2 (get-in state [:terrain-sets 1 :id])))))

(deftest terrain-set-creation-defaults_preview_tileset
  (let [state (model/add-terrain-set
               {:terrain-sets []
                :tilesets [{:id :overworld
                            :label "Overworld"}]})]
    (is (= :overworld (get-in state [:terrain-sets 0 :tileset])))))

(deftest terrain-creation-adds_to_selected_set
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains []}]
                :selected-terrain-set-index 0})]
    (is (= :terrain (get-in state [:terrain-sets 0 :terrains 0 :id])))
    (is (= "Terrain" (get-in state [:terrain-sets 0 :terrains 0 :label])))
    (is (= 0 (:selected-terrain-index state)))))

(deftest terrain-creation-deduplicates_ids
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :terrain
                                            :label "Terrain"}]}]
                :selected-terrain-set-index 0})]
    (is (= :terrain-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))))

(deftest terrain-creation-defaults_preview_tile
  (let [state (model/add-terrain
               {:terrain-sets [{:id :overworld
                                :tileset :overworld-tiles
                                :terrains []}]
                :tilesets [{:id :overworld-tiles
                            :tiles [{:id :grass
                                     :name "Grass"}]}]
                :selected-terrain-set-index 0})]
    (is (= :grass (get-in state [:terrain-sets 0 :terrains 0 :tile])))))

(deftest terrain-duplicate-inserts_copy_after_selected_terrain
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"
                                            :tile :grass-tile}
                                           {:id :water
                                            :label "Water"
                                            :tile :water-tile}]}]
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :edge
                                     :label "Edge"
                                     :terrain :grass
                                     :exclusive? true
                                     :match {:n :same
                                             :s {:terrain :grass}}
                                     :output {:anchor {:x 1 :y 1}}}
                                    {:id :shore
                                     :terrain :water}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Meadow")
        terrains (get-in state [:terrain-sets 0 :terrains])
        duplicate (nth terrains 1)
        rules (get-in state [:rulesets 0 :rules])
        duplicated-rule (nth rules 1)]
    (is (= [:grass :meadow :water]
           (map terrains :id)))
    (is (= [:edge :edge-copy :shore]
           (map rules :id)))
    (is (= 1 (:selected-terrain-index state)))
    (is (nil? (:selected-terrain-rule-id state)))
    (is (= "Meadow" (:label duplicate)))
    (is (= :grass-tile (:tile duplicate)))
    (is (= "Edge Copy" (:label duplicated-rule)))
    (is (= :meadow (:terrain duplicated-rule)))
    (is (= true (:exclusive? duplicated-rule)))
    (is (= {:n :same
            :s {:terrain :meadow}}
           (:match duplicated-rule)))
    (is (= {:anchor {:x 1 :y 1}} (:output duplicated-rule)))))

(deftest terrain-duplicate-deduplicates_name_and_id
  (let [state (model/duplicate-selected-terrain
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass
                                            :label "Grass"}
                                           {:id :grass-copy
                                            :label "Grass Copy"}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0}
               "Grass Copy")
        duplicate (nth (get-in state [:terrain-sets 0 :terrains]) 1)]
    (is (= :grass-copy-2 (:id duplicate)))
    (is (= "Grass Copy 2" (:label duplicate)))))

(deftest terrain-detail-label_changes_update_selected_records
  (let [state {:terrain-sets [{:id :overworld
                               :label "Overworld"
                               :terrains [{:id :grass
                                           :label "Grass"}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}
        state (model/set-selected-terrain-set-label state "World")
        state (model/set-selected-terrain-label state "Meadow")]
    (is (= "World" (get-in state [:terrain-sets 0 :label])))
    (is (= "Meadow" (get-in state [:terrain-sets 0 :terrains 0 :label])))))

(deftest terrain-set-id-change-updates_project_references
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :overworld
                                :label "Overworld"
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :brushes [{:id :brush
                           :pattern {:layers [{:data-kind :terrain
                                               :terrain-set :overworld
                                               :tiles [[:grass]]}]}}]
                :rulesets [{:id :grass-marching
                            :terrain-set :overworld}]}
               "world")]
    (is (= :world (get-in state [:terrain-sets 0 :id])))
    (is (= :world (get-in state [:layers 0 :terrain-set])))
    (is (= :world (get-in state [:layer-profiles 0 :layers 0 :terrain-set])))
    (is (= :world (get-in state [:brushes 0 :pattern :layers 0 :terrain-set])))
    (is (= :world (get-in state [:rulesets 0 :terrain-set])))))

(deftest terrain-set-id-change-deduplicates_ids
  (let [state (model/set-selected-terrain-set-id
               {:terrain-sets [{:id :world}
                               {:id :overworld}]
                :selected-terrain-set-index 1}
               "world")]
    (is (= :world-2 (get-in state [:terrain-sets 1 :id])))))

(deftest terrain-id-change-updates_project_references
  (let [state (model/set-selected-terrain-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld
                          :tiles [[:grass nil]
                                  [:water :grass]]}
                         {:id :scene/other
                          :data-kind :terrain
                          :terrain-set :other
                          :tiles [[:grass]]}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :brushes [{:id :brush
                           :pattern {:layers [{:data-kind :terrain
                                               :terrain-set :overworld
                                               :tiles [[:grass nil]]}
                                              {:data-kind :terrain
                                               :terrain-set :other
                                               :tiles [[:grass]]}]}}]
                :rulesets [{:id :grass-marching
                            :source-layer :scene/terrain
                            :terrain :grass}
                           {:id :other-marching
                            :source-layer :scene/other
                            :terrain :grass}]}
               "meadow")]
    (is (= :meadow (get-in state [:terrain-sets 0 :terrains 0 :id])))
    (is (= [[:meadow nil]
            [:water :meadow]]
           (get-in state [:layers 0 :tiles])))
    (is (= [[:grass]] (get-in state [:layers 1 :tiles])))
    (is (= [[:meadow nil]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= [[:grass]]
           (get-in state [:brushes 0 :pattern :layers 1 :tiles])))
    (is (= :meadow (get-in state [:rulesets 0 :terrain])))
    (is (= :grass (get-in state [:rulesets 1 :terrain])))))

(deftest terrain-id-change-deduplicates_ids
  (let [state (model/set-selected-terrain-id
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :meadow}
                                           {:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 1}
               "meadow")]
    (is (= :meadow-2 (get-in state [:terrain-sets 0 :terrains 1 :id])))))

(deftest terrain-detail-preview_changes_update_selected_records
  (let [state {:terrain-sets [{:id :overworld
                               :tileset :old
                               :terrains [{:id :grass
                                           :tile :missing}]}]
               :tilesets [{:id :old
                           :tiles [{:id :old-tile}]}
                          {:id :new
                           :tiles [{:id :new-tile}
                                   {:id :other-tile}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0}
        state (model/set-selected-terrain-set-tileset state 1)
        state (model/set-selected-terrain-tile state :other-tile)]
    (is (= :new (get-in state [:terrain-sets 0 :tileset])))
    (is (= :other-tile (get-in state [:terrain-sets 0 :terrains 0 :tile])))))

(deftest terrain-ruleset-creation-adds_selected_terrain_stamp_ruleset
  (let [state (model/add-terrain-ruleset
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}]})]
    (is (= :overworld-rules (get-in state [:rulesets 0 :id])))
    (is (= :terrain-stamp (get-in state [:rulesets 0 :kind])))
    (is (= :overworld (get-in state [:rulesets 0 :terrain-set])))
    (is (= :scene/terrain (get-in state [:rulesets 0 :source-layer])))
    (is (= :overworld-rules (:selected-terrain-ruleset-id state)))))

(deftest terrain-rule-creation-adds_brush_shaped_output_stamp
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules []}]
                :selected-terrain-ruleset-id :overworld-rules
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain-visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default})]
    (is (= :rule (get-in state [:rulesets 0 :rules 0 :id])))
    (is (= :grass (get-in state [:rulesets 0 :rules 0 :terrain])))
    (is (= :scene/terrain-visuals
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))
    (is (= [[nil nil nil]
            [nil :grass-fill nil]
            [nil nil nil]]
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= :rule (:selected-terrain-rule-id state)))))

(deftest terrain-rule-creation-uses_live_tile_layers_when_profile_is_stale
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :kind :terrain-stamp
                            :terrain-set :overworld
                            :rules []}]
                :selected-terrain-ruleset-id :overworld-rules
                :layers [{:id :scene/terrain
                          :data-kind :terrain
                          :terrain-set :overworld}
                         {:id :scene/visuals
                          :data-kind :tile-ref
                          :tileset :terrain}]
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}]}]
                :selected-layer-profile-id :default})]
    (is (= :scene/visuals
           (get-in state [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))))

(deftest terrain-rule-creation-creates_ruleset_when_needed
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets []
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain-source
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/terrain-visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default})]
    (is (= :overworld-rules (get-in state [:rulesets 0 :id])))
    (is (= :rule (get-in state [:rulesets 0 :rules 0 :id])))
    (is (= :overworld-rules (:selected-terrain-ruleset-id state)))
    (is (= :rule (:selected-terrain-rule-id state)))))

(deftest terrain-rule-creation-derives_selection_when_needed
  (let [state (model/add-terrain-rule
               {:terrain-sets [{:id :overworld
                                :tileset :terrain
                                :terrains [{:id :grass
                                            :tile :grass-fill}]}]
                :rulesets []
                :layer-profiles [{:id :default
                                  :layers [{:id :scene/terrain
                                            :data-kind :terrain
                                            :terrain-set :overworld}
                                           {:id :scene/terrain-visuals
                                            :data-kind :tile-ref
                                            :tileset :terrain}]}]
                :selected-layer-profile-id :default})]
    (is (= 0 (:selected-terrain-set-index state)))
    (is (= 0 (:selected-terrain-index state)))
    (is (= :overworld-rules (:selected-terrain-ruleset-id state)))
    (is (= :rule (:selected-terrain-rule-id state)))
    (is (= :rule (get-in state [:rulesets 0 :rules 0 :id])))))

(deftest terrain-rule-match-change-stores_specific_terrain_condition
  (let [state (model/set-selected-rule-match-condition
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :selected-terrain-set-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :match {}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               :n
               :water)]
    (is (= {:terrain :water}
           (get-in state [:rulesets 0 :rules 0 :match :n])))))

(deftest terrain-rule-match-change-stores_other_terrain_condition
  (let [state (model/set-selected-rule-match-condition
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}
                                           {:id :water}]}]
                :selected-terrain-set-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :match {}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               :n
               :other-terrain)]
    (is (= :other-terrain
           (get-in state [:rulesets 0 :rules 0 :match :n])))))

(deftest terrain-rule-options-show_only_selected_terrain_rules
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}
                                          {:id :water}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :rulesets [{:id :overworld-rules
                           :terrain-set :overworld
                           :rules [{:id :grass-n
                                    :label "Grass N"
                                    :terrain :grass}
                                   {:id :water-n
                                    :label "Water N"
                                    :terrain :water}]}]
               :selected-terrain-ruleset-id :overworld-rules}]
    (is (= [{:value :grass-n
             :label "Grass N"}]
           (model/terrain-rule-options state)))))

(deftest terrain-rule-label-change-renames_selected_rule
  (let [state (model/set-selected-terrain-rule-label
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :label "Rule"
                                     :terrain :grass}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               "North edge")]
    (is (= "North edge" (get-in state [:rulesets 0 :rules 0 :label])))))

(deftest terrain-rule-exclusive-change-updates_selected_rule
  (let [state (model/set-selected-terrain-rule-exclusive
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :label "Rule"
                                     :terrain :grass}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               true)]
    (is (= true (get-in state [:rulesets 0 :rules 0 :exclusive?])))))

(deftest terrain-workspace-state-derives_selected_rule_exclusive_flag
  (let [state (model/derive-terrain-workspace-state
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :edge
                                     :terrain :grass
                                     :exclusive? true}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :edge})]
    (is (= true (:selected-terrain-rule-exclusive? state)))))

(deftest terrain-rule-move-reorders_visible_rules_only
  (let [base-state {:terrain-sets [{:id :overworld
                                    :terrains [{:id :grass}
                                               {:id :water}]}]
                    :selected-terrain-set-index 0
                    :selected-terrain-index 0
                    :rulesets [{:id :overworld-rules
                                :terrain-set :overworld
                                :rules [{:id :grass-a :terrain :grass}
                                        {:id :water-a :terrain :water}
                                        {:id :grass-b :terrain :grass}]}]
                    :selected-terrain-ruleset-id :overworld-rules
                    :selected-terrain-rule-id :grass-b}
        moved-up (model/move-selected-terrain-rule base-state :up)
        moved-down (model/move-selected-terrain-rule
                    (assoc base-state :selected-terrain-rule-id :grass-a)
                    :down)]
    (is (= [:grass-b :water-a :grass-a]
           (map (get-in moved-up [:rulesets 0 :rules]) :id)))
    (is (= [:grass-b :water-a :grass-a]
           (map (get-in moved-down [:rulesets 0 :rules]) :id)))))

(deftest terrain-rule-delete-removes_selected_rule_and_selects_neighbor
  (let [state (model/delete-selected-terrain-rule
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule-a :terrain :grass}
                                    {:id :rule-b :terrain :grass}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule-a})]
    (is (= [:rule-b]
           (map (get-in state [:rulesets 0 :rules]) :id)))
    (is (= :rule-b (:selected-terrain-rule-id state)))))

(deftest terrain-rule-duplicate-inserts_copy_after_selected_rule
  (let [state (model/duplicate-selected-terrain-rule
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule-a
                                     :label "North edge"
                                     :terrain :grass
                                     :exclusive? true
                                     :match {:n :same}
                                     :output {:anchor {:x 1 :y 1}}}
                                    {:id :rule-b
                                     :terrain :grass}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule-a})
        rules (get-in state [:rulesets 0 :rules])
        duplicate (nth rules 1)]
    (is (= [:rule-a :rule-a-copy :rule-b]
           (map rules :id)))
    (is (= :rule-a-copy (:selected-terrain-rule-id state)))
    (is (= "North edge Copy" (:label duplicate)))
    (is (= :grass (:terrain duplicate)))
    (is (= true (:exclusive? duplicate)))
    (is (= {:n :same} (:match duplicate)))
    (is (= {:anchor {:x 1 :y 1}} (:output duplicate)))))

(deftest terrain-rule-match-cycle-steps_visual_condition_options
  (let [base-state {:terrain-sets [{:id :overworld
                                    :terrains [{:id :grass}
                                               {:id :water}]}]
                    :selected-terrain-set-index 0
                    :selected-terrain-index 0
                    :rulesets [{:id :overworld-rules
                                :terrain-set :overworld
                                :rules [{:id :rule
                                         :terrain :grass
                                         :match {:n :ignore}}]}]
                    :selected-terrain-ruleset-id :overworld-rules
                    :selected-terrain-rule-id :rule}
        right-state (model/cycle-selected-rule-match-condition
                     base-state
                     :n
                     1)
        left-state (model/cycle-selected-rule-match-condition
                    base-state
                    :n
                    -1)
        other-state (model/cycle-selected-rule-match-condition
                     (assoc-in base-state
                               [:rulesets 0 :rules 0 :match :n]
                               :not-same)
                     :n
                     1)]
    (is (= :same (get-in right-state [:rulesets 0 :rules 0 :match :n])))
    (is (= {:terrain :water}
           (get-in left-state [:rulesets 0 :rules 0 :match :n])))
    (is (= :other-terrain
           (get-in other-state [:rulesets 0 :rules 0 :match :n])))))

(deftest terrain-rule-stamp-tile-edit-updates_selected_rule_stamp_grid
  (let [state (model/set-selected-rule-stamp-tile
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :terrain :grass
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[nil nil nil]
                                                                [nil :grass nil]
                                                                [nil nil nil]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               2
               1
               :shore)]
    (is (= [[nil nil nil]
            [nil :grass :shore]
            [nil nil nil]]
           (get-in state
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles])))))

(deftest terrain-rule-stamp-tile-edit-can_clear_cells
  (let [state (model/set-selected-rule-stamp-tile
               {:terrain-sets [{:id :overworld
                                :terrains [{:id :grass}]}]
                :selected-terrain-set-index 0
                :selected-terrain-index 0
                :rulesets [{:id :overworld-rules
                            :terrain-set :overworld
                            :rules [{:id :rule
                                     :terrain :grass
                                     :output {:layers [{:tileset :terrain
                                                        :tiles [[nil nil nil]
                                                                [nil :grass nil]
                                                                [nil nil nil]]}]}}]}]
                :selected-terrain-ruleset-id :overworld-rules
                :selected-terrain-rule-id :rule}
               1
               1
               nil)]
    (is (= [[nil nil nil]
            [nil nil nil]
            [nil nil nil]]
           (get-in state
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles])))))

(deftest terrain-rule-stamp-selection-falls_back_when_tile_is_not_in_output_tileset
  (let [state {:terrain-sets [{:id :overworld
                               :terrains [{:id :grass}]}]
               :selected-terrain-set-index 0
               :selected-terrain-index 0
               :tilesets [{:id :terrain
                           :tiles [{:id :grass-fill}
                                   {:id :shore}]}]
               :terrain-rule-selected-tile :old-tile
               :rulesets [{:id :overworld-rules
                           :terrain-set :overworld
                           :rules [{:id :rule
                                    :terrain :grass
                                    :output {:layers [{:tileset :terrain
                                                       :tiles [[nil nil nil]
                                                               [nil :grass-fill nil]
                                                               [nil nil nil]]}]}}]}]
               :selected-terrain-ruleset-id :overworld-rules
               :selected-terrain-rule-id :rule}]
    (is (= :grass-fill (model/selected-rule-stamp-tile state)))))
