(ns tilemap-editor.view.terrains.layout-test
  (:require proof.core
            [tilemap-editor.view.terrains.layout :as layout]))

(deftest terrain-set-list-panel-has_header_and_add_button
  (let [panel (layout/make-terrain-set-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrain Sets" (-> panel :state :title)))
    (is (= 'ui/button (:mode add-button)))
    (is (= :ui/toolbar-button (:class add-button)))
    (is (= "+" (-> add-button :state :label)))))

(deftest terrain-set-list-rows-have_context_menu
  (let [row (layout/terrain-row-child 0 {:value 0 :label "Terrain Set"})
        menu-item (head (:items layout/terrain-set-context-menu))]
    (is (= :terrain-set (-> row :state :context-kind)))
    (is (= "Rename Terrain Set" (:label menu-item)))
    (is (= :rename (-> menu-item :payload :command)))))

(deftest terrain-list-panel-has_disabled_bound_add_button
  (let [panel (layout/make-terrain-list-panel)
        header (head (:children panel))
        add-button (nth (:children header) 1)]
    (is (= "Terrains" (-> panel :state :title)))
    (is (= "+" (-> add-button :state :label)))
    (is (not (nil? (-> add-button :state :disabled?))))))

(deftest terrain-set-detail-editor-shows_identity_as_labels
  (let [children (layout/terrain-set-detail-editor-children)
        id-field (nth children 0)
        name-field (nth children 1)
        edit-button (nth children 2)]
    (is (= 'terrain-readonly-field (:mode id-field)))
    (is (= 'terrain-readonly-field (:mode name-field)))
    (is (= 'ui/button (:mode edit-button)))
    (is (= "Edit" (-> edit-button :state :label)))))

(deftest stamp-tile-picker-columns-tolerates_unlaid_out_bounds
  (is (= 1 (layout/terrain-stamp-tile-picker-columns nil)))
  (is (= {:x 0 :y 0 :w 32 :h 32}
         (layout/terrain-stamp-tile-picker-cell-rect 0 nil))))

(deftest stamp-tile-picker-content-height-grows_for_hidden_rows
  (is (= 32 (layout/terrain-stamp-tile-picker-content-height 7 7)))
  (is (= 66 (layout/terrain-stamp-tile-picker-content-height 8 7)))
  (is (> (layout/terrain-stamp-tile-picker-content-height 22 7)
         layout/terrain-stamp-tile-picker-height)))

(deftest terrain-rule-context-menu-includes_duplicate_command
  (let [items (:items layout/terrain-rule-context-menu)
        duplicate (nth items 1)]
    (is (= "Duplicate" (:label duplicate)))
    (is (= :duplicate (-> duplicate :payload :command)))))
