(ns tilemap-editor.view.brushes.model-test
  (:require proof.core
            [tilemap-editor.view.brushes.model :as model]))

(deftest brush-workspace-selects_first_available_brush
  (let [state (model/derive-brush-workspace-state
               {:brushes [{:id :brush
                           :label "Brush"}]
                :selected-brush-index nil})]
    (is (= 0 (:selected-brush-index state)))
    (is (= false (:brush-detail-panel-disabled? state)))))

(deftest brush-workspace-disables_detail_without_brushes
  (let [state (model/derive-brush-workspace-state
               {:brushes []
                :selected-brush-index 0})]
    (is (nil? (:selected-brush-index state)))
    (is (= true (:brush-detail-panel-disabled? state)))))

(deftest brush-workspace-adds_default_pattern_layer_when_tilesets_appear
  (let [state (model/derive-brush-workspace-state
               {:brushes [{:id :brush
                           :label "Brush"
                           :kind :pattern
                           :pattern {:size {:w 3 :h 3}
                                     :anchor {:x 1 :y 1}
                                     :layers []}}]
                :tilesets [{:id :terrain
                            :label "Terrain"}]
                :selected-brush-index 0
                :selected-brush-layer-index nil})]
    (is (= 0 (:selected-brush-layer-index state)))
    (is (= :terrain (get-in state [:brushes 0 :pattern :layers 0 :tileset])))))

(deftest brush-workspace-defaults_missing_layer_tileset
  (let [state (model/derive-brush-workspace-state
               {:brushes [{:id :brush
                           :label "Brush"
                           :kind :pattern
                           :pattern {:size {:w 3 :h 3}
                                     :anchor {:x 1 :y 1}
                                     :layers [{:id :layer
                                               :tiles [[nil nil nil]
                                                       [nil nil nil]
                                                       [nil nil nil]]}]}}]
                :tilesets [{:id :terrain
                            :label "Terrain"}]
                :selected-brush-index 0
                :selected-brush-layer-index 0})]
    (is (= :terrain (get-in state [:brushes 0 :pattern :layers 0 :tileset])))))

(deftest pattern-brush-creation-adds_selected_project_brush
  (let [state (model/add-pattern-brush! {:brushes []})]
    (is (= 0 (:selected-brush-index state)))
    (is (= :brush (get-in state [:brushes 0 :id])))
    (is (= "Brush" (get-in state [:brushes 0 :label])))
    (is (= :pattern (get-in state [:brushes 0 :kind])))
    (is (= {:w 3 :h 3} (get-in state [:brushes 0 :pattern :size])))
    (is (= {:x 1 :y 1} (get-in state [:brushes 0 :pattern :anchor])))
    (is (= [] (get-in state [:brushes 0 :pattern :layers])))))

(deftest pattern-brush-creation-adds_initial_layer_when_tileset_exists
  (let [state (model/add-pattern-brush!
               {:brushes []
                :tilesets [{:id :terrain}]})]
    (is (= 0 (:selected-brush-layer-index state)))
    (is (= :terrain (get-in state [:brushes 0 :pattern :layers 0 :tileset])))
    (is (= [[nil nil nil]
            [nil nil nil]
            [nil nil nil]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))))

(deftest pattern-brush-creation-deduplicates_ids
  (let [state (model/add-pattern-brush!
               {:brushes [{:id :brush
                           :label "Brush"}]})]
    (is (= :brush-2 (get-in state [:brushes 1 :id])))
    (is (= "Brush 2" (get-in state [:brushes 1 :label])))))

(deftest pattern-layer-add-requires_tileset
  (let [state (model/add-pattern-layer!
               {:selected-brush-index 0
                :brushes [{:id :brush
                           :kind :pattern
                           :pattern {:size {:w 3 :h 3}
                                     :anchor {:x 1 :y 1}
                                     :layers []}}]
                :tilesets []})]
    (is (= [] (get-in state [:brushes 0 :pattern :layers])))))

(deftest pattern-size-update-resizes_existing_layers
  (let [state (model/set-pattern-size!
               {:selected-brush-index 0
                :selected-brush-layer-index 0
                :brushes [{:id :brush
                           :kind :pattern
                           :pattern {:size {:w 3 :h 3}
                                     :anchor {:x 1 :y 1}
                                     :layers [{:id :layer
                                               :tileset :terrain
                                               :tiles [[:a :b :c]
                                                       [:d :e :f]
                                                       [:g :h :i]]}]}}]}
               :w
               2)]
    (is (= {:w 2 :h 3}
           (get-in state [:brushes 0 :pattern :size])))
    (is (= [[:a :b]
            [:d :e]
            [:g :h]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))))

(deftest pattern-grid-paint-updates_selected_layer
  (let [state (model/set-pattern-tile!
               {:selected-brush-index 0
                :selected-brush-layer-index 0
                :brushes [{:id :brush
                           :kind :pattern
                           :pattern {:size {:w 2 :h 2}
                                     :anchor {:x 0 :y 0}
                                     :layers [{:id :layer
                                               :tileset :terrain
                                               :tiles [[nil nil]
                                                       [nil nil]]}]}}]}
               1
               0
               :grass)]
    (is (= [[nil :grass]
            [nil nil]]
           (get-in state [:brushes 0 :pattern :layers 0 :tiles])))))
