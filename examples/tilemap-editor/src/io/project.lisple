(ns tilemap-editor.io.project
  (:require [lisple.io :as io]
            [pixils.ui.file-dialog :as file-dialog]
            [tilemap-editor.model.data :as data]
            [tilemap-editor.model.tilemap :as tilemap]))

(def project-file-filters
  [{:label "Pixils project files (*.edn)"
    :extensions [".edn"]}
   {:label "All files (*)"
    :extensions []}])

(def default-recent-projects-path "examples/tilemap-editor/.recent-projects.edn")
(def max-recent-projects 10)

(defun save-project-result? [payload]
  (and (= (:type payload) :confirm)
       (= (:mode payload) :file-dialog/save)
       (not (nil? (:path payload)))))

(defun open-project-result? [payload]
  (and (= (:type payload) :confirm)
       (= (:mode payload) :file-dialog/open)
       (not (nil? (:path payload)))))

(defun save-project! [state payload]
  (do
    (io/spit-edn! (:path payload) (data/project-document state))
    payload))

(defun recent-project-entry [payload]
  {:path (:path payload)
   :directory (:directory payload)
   :filename (or (:filename payload) (:path payload))})

(defun recent-project-document [projects]
  {:projects (or projects [])})

(defun recent-projects-from-document [document]
  (or (:projects document)
      document
      []))

(defun load-recent-projects [path]
  (if (and path (io/exists? path))
    (recent-projects-from-document (io/slurp-edn! path))
    []))

(defun first-recent-projects [projects max-count]
  (map (filter (for-indexed [index project (or projects [])]
                 {:index index
                  :project project})
               (fn [entry]
                 (< (:index entry) max-count)))
       :project))

(defun promote-recent-project [projects entry]
  (if (nil? (:path entry))
    (or projects [])
    (first-recent-projects
     (concat [entry]
             (filter (or projects [])
                     (fn [project]
                       (not= (:path project) (:path entry)))))
     max-recent-projects)))

(defun write-recent-projects! [path projects]
  (do
    (when path
      (io/spit-edn! path (recent-project-document projects)))
    projects))

(defun remember-project! [state payload]
  (let [projects (promote-recent-project (:recent-projects state)
                                         (recent-project-entry payload))]
    (do
      (write-recent-projects! (:project-history-path state) projects)
      (assoc state :recent-projects projects))))

(defun valid-project-document? [project]
  (= (:format project) data/project-format))

(defun project-maps [project]
  (if (:maps project)
    (:maps project)
    (:maps (data/normalize-project-document project))))

(defun project-selected-map [project]
  (data/selected-map-document (project-maps project) (:selected-map project)))

(defun project-layers [project]
  (:layers (project-selected-map project)))

(defun project-layer-profiles [project]
  (let [profiles (:layer-profiles project)]
    (if (empty? (or profiles []))
      (data/default-layer-profiles (project-layers project))
      (data/normalize-layer-profiles profiles))))

(defun project-tilesets [project]
  (or (:tilesets project) []))

(defun project-terrain-sets [project]
  (or (:terrain-sets project) data/project-terrain-sets))

(defun project-rulesets [project]
  (or (:rulesets project) data/project-rulesets))

(defun project-brushes [project]
  (or (:brushes project) data/project-brushes))

(defun first-layer-tileset [layers]
  (:tileset (head layers)))

(defun open-project! [state payload]
  (let [project (data/normalize-project-document (io/slurp-edn! (:path payload)))
        maps (project-maps project)
        selected-map (project-selected-map project)
        layers (:layers selected-map)
        layer-profiles (project-layer-profiles project)
        layer-profile-id (data/selected-layer-profile-id
                          layer-profiles
                          (:layer-profile selected-map))
        tileset (first-layer-tileset layers)
        tilesets (project-tilesets project)
        terrain-sets (project-terrain-sets project)
        rulesets (project-rulesets project)
        brushes (project-brushes project)]
    (if (valid-project-document? project)
      (remember-project!
       (tilemap/rebuild-terrain-stamp-preview
        (assoc state
               :tilesets tilesets
               :terrain-sets terrain-sets
               :rulesets rulesets
               :brushes brushes
               :maps maps
               :selected-map-id (:id selected-map)
               :selected-map-label (:label selected-map)
               :map-width (:width selected-map)
               :map-height (:height selected-map)
               :selected-brush-index (when (> (count brushes) 0) 0)
               :selected-brush-layer-index
               (when (> (count (or (-> (head brushes) :pattern :layers) [])) 0) 0)
               :brush-selected-tile nil
               :layer-profiles layer-profiles
               :selected-layer-profile-id layer-profile-id
               :layers layers
               :selected-layer-index (when (> (count layers) 0) 0)
               :selected-layer-label (or (:label (head layers)) "")
               :terrain-rule-application :preview
               :show-terrain-rules? true
               :terrain-stamp-layers []
               :terrain-stamp-replacements []
               :hidden-layer-indices []
               :tileset tileset
               :selected-tileset-index (when tileset
                                         (data/tileset-index tilesets
                                                             tileset))
               :selected-tileset-definition-index (when (> (count tilesets) 0) 0)
               :selected-tileset-tile-index (when (> (count (or (:tiles (head tilesets)) [])) 0) 0)
               :selected-tile (data/source-layer-value-id
                               tilesets
                               terrain-sets
                               (head layers)
                               0)
               :resources (data/normalize-project-resources
                           (or (:resources project) data/project-resources))
               :selected-resource-bundle nil
               :selected-image-resource nil
               :last-project-open-result payload
               :last-opened-project project))
       payload)
      (assoc state :last-project-open-error {:reason :invalid-format
                                             :path (:path payload)}))))

(defun open-recent-project! [state payload]
  (open-project! (assoc state
                        :project-path (:path payload)
                        :project-directory (:directory payload)
                        :project-filename (:filename payload)
                        :last-project-file-dialog-result payload)
                 (assoc payload
                        :type :confirm
                        :mode :file-dialog/open)))

(defun open-project-file-dialog! [state ctx mode title]
  (do
    (file-dialog/open-file-dialog!
     ctx
     {:title title
      :mode mode
      :path (or (:project-directory state) file-dialog/default-path)
      :filename (or (:project-filename state) "tilemap-project.edn")
      :filters project-file-filters
      :result-event :project/file-dialog-result})
    state))

(defun apply-project-file-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (let [next-state (assoc state
                            :project-path (:path payload)
                            :project-directory (:directory payload)
                            :project-filename (:filename payload)
                            :last-project-file-dialog-result payload)]
      (if (save-project-result? payload)
        (do
          (save-project! next-state payload)
          (remember-project! (assoc next-state :last-project-save-result payload)
                             payload))
        (if (open-project-result? payload)
          (open-project! next-state payload)
          next-state)))
    state))
