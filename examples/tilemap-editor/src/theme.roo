(ns tilemap-editor.theme
  (:require pixils))

(def editor-bg {:r 0x1d :g 0x23 :b 0x2a})
(def panel-bg {:r 0x2c :g 0x34 :b 0x3d})
(def panel-border {:r 0x5f :g 0x6f :b 0x7f})
(def content-bg {:r 0x15 :g 0x19 :b 0x1f})
(def text-main {:r 0xe6 :g 0xea :b 0xee})
(def text-muted {:r 0xa7 :g 0xb0 :b 0xb8})
(def accent {:r 0xff :g 0xcc :b 0x66})

(deftheme tilemap-editor/theme
  {:default-variant :dark
   :vars {:dark {:content-bg content-bg
                 :list-box-row-height 24}}
   :styles {:ui/app {:background editor-bg
                     :text {:color text-main}}

            :ui/panel {:background panel-bg
                       :border {:color panel-border
                                :thickness 1}
                       :text {:color text-main}}

            'ui/list-box {:width :fill}

            'ui/header-panel {:width :fill
                              :height :fill}


            'ui/header-panel-header
            {:layout {:direction :row
                      :align-items :center
                      :gap 4}}


            'ui/header-panel-body {:height :fill
                                   :padding 8}

            ['(ui/header-panel :tm/list-wrapper) 'ui/header-panel-body]
            {:padding 0}

            :tm/list-content {:height :fill}

            ['(pixils/form-layout-item-editor :tm/list-content)
             :pixils.form/field]
            {:height :fill}

            'pixils/form {:width :fill
                          :height :fill}

            :pixils.form/array-list {:width :fill}

            :terrain/selection-column
            {:width :fill
             :height :fill
             :layout {:direction :column
                      :gap 8}}

            :property-set/workspace {:width :fill
                                     :height :fill}

            :property-set/workspace-panels
            {:width :fill
             :height :fill}

            :ui/title {:text {:color accent}}

            :ui/muted {:text {:color text-muted}}

            :ui/accent {:text {:color accent}}

            :ui/content {:background content-bg
                         :border {:color panel-border
                                  :thickness 1}}

            :ui/canvas {:background content-bg
                        :border {:color panel-border
                                 :thickness 1}}

            'ui/scrollbar {:background {:r 0x24 :g 0x2b :b 0x33}
                           :border {:color panel-border
                                    :thickness 1}
                           :text {:color text-main}}

            'ui/scrollbar-corner {:background {:r 0x24 :g 0x2b :b 0x33}
                                  :border {:color panel-border
                                           :thickness 1}}}})
