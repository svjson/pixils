(ns tilemap-editor.common.dialog.identity-dialog
  (:require pixils
            [pixils.form :as form]
            [pixils.ui :as ui]
            [pixils.ui.window :as w]))

(defcomponent identity-dialog-body
  {:class :ui/content
   :style {:width 300
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :children [(form/make {:schema {:id {:type :keyword
                                        :required true
                                        :auto-focus? true}
                                   :name {:type :text
                                          :required true}}
                          :text {:id "Id"
                                 :name "Name"}
                          :layout [[:id :name]]
                          :style {:width :fill
                                  :height :shrink
                                  :layout {:direction :column
                                           :gap 8}}
                          :row-style {:width :fill
                                      :height :shrink
                                      :layout {:direction :row
                                               :align-items :start
                                               :gap 8}}
                          :field-style {:width :fill
                                        :height :shrink
                                        :layout {:direction :column
                                                 :gap 3}}
                          :value (ui/bind-state :identity)})
              {:mode 'identity-dialog-buttons
               :state {:identity (ui/bind-state :identity)}}]})

(defcomponent identity-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                             (ui/emit! (:view ctx) :identity-dialog/cancel)
                             state)}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "OK"
                       :identity (ui/bind-state :identity)}
               :on-click (fn [state event ctx]
                             (ui/emit! (:view ctx)
                                       :identity-dialog/confirm
                                       {:id (get-in state [:identity :id])
                                        :name (get-in state [:identity :name])})
                             state)}]})

(defmode identity-dialog-modal
  {:on {:form/draft-change
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (assoc state :identity (-> event :payload :form-value)))
        :identity-dialog/cancel
        (fn [state event ctx]
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel
                        :context (:context state)})
            state)
        :identity-dialog/confirm
        (fn [state event ctx]
            (ui/stop-propagation! event)
            (pop-mode! {:type :confirm
                        :id (-> event :payload :id)
                        :name (-> event :payload :name)
                        :context (:context state)})
            state)}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :identity (ui/bind-state :identity)
                               :context (ui/bind-state :context)}
                       :body [{:mode 'identity-dialog-body
                               :state {:identity
                                       (ui/bind-state :identity)}}]})]})

(defun open!
  "Opens a shared identity dialog and reports the result to opts :result-event.
  opts accepts :title, :id, :name, :context, and :result-event."
  [ctx opts]
  (push-mode! 'identity-dialog-modal
              {:title (:title opts)
               :identity {:id (or (:id opts) "")
                          :name (or (:name opts) "")}
               :context (:context opts)}
              {:origin {:view (:view ctx)
                        :event (:result-event opts)}}))
