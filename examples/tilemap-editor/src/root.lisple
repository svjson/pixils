(ns tilemap-editor.root
  (:require pixils
            [pixils.ui :as ui]
            [tilemap-editor.controls :as controls]
            [tilemap-editor.data :as data]
            tilemap-editor.workspace))



;; Root mode

(defmode main-mode
 {:class :ui/app
  :style {:layout {:direction :column
                   :gap 8}}
  :init (fn [state ctx]
          {:selected-tile nil
           :selected-tileset-index nil
           :tilesets []
           :tileset nil
           :selected-layer-index nil
           :selected-layer-label ""
           :layers []
           :hidden-layer-indices []
           :selected-label ""
           :project-path nil
           :project-directory nil
           :project-filename "tilemap-project.edn"
           :zoom 1
           :zoom-label "Zoom 1x"
           :show-grid? true
           :map-offset {:x 0 :y 0}})
  :update (fn [state ctx]
            (let [layers (or (:layers state) [])
                  layer-index (or (:selected-layer-index state) 0)
                  layer (when (> (count layers) 0)
                          (nth layers (min layer-index (dec (count layers)))))
                  tileset (:tileset layer)
                  selected-tile (data/tile-id-in tileset (:selected-tile state))
                  zoom (or (:zoom state) 1)]
              (assoc state
                     :tileset tileset
                     :selected-tileset-index (when tileset
                                               (data/tileset-index-in (:tilesets state)
                                                                      tileset))
                     :selected-tile selected-tile
                     :selected-label (data/tile-label-in tileset selected-tile)
                     :zoom-label (str "Zoom " zoom "x")
                     :selected-layer-label (or (:label layer) ""))))
  :children [{:mode 'toolbar}
             {:mode 'workspace
              :style {:padding {:l 8
                                :r 8
                                :b 8}}
              :state {:selected-tile (ui/bind-state :selected-tile)
                      :selected-label (ui/bind-state :selected-label)
                      :selected-tileset-index (ui/bind-state :selected-tileset-index)
                      :tilesets (ui/bind-state :tilesets)
                      :tileset (ui/bind-state :tileset)
                      :selected-layer-index (ui/bind-state :selected-layer-index)
                      :selected-layer-label (ui/bind-state :selected-layer-label)
                      :layers (ui/bind-state :layers)
                      :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                      :zoom (ui/bind-state :zoom)
                      :zoom-label (ui/bind-state :zoom-label)
                      :show-grid? (ui/bind-state :show-grid?)
                      :map-offset (ui/bind-state :map-offset)}}]
  :on {:palette/select (fn [state event ctx]
                         (assoc state :selected-tile (:payload event)))
       :layer/name-dialog-result (fn [state event ctx]
                                   (controls/apply-layer-name-dialog-result
                                    state
                                    (:payload event)))
       :layer/confirm-dialog-result (fn [state event ctx]
                                      (controls/apply-delete-layer-result
                                       state
                                       (:payload event)))
       :layer/context-command (fn [state event ctx]
                                (controls/apply-layer-move-command
                                 state
                                 (:payload event)))
       :project/open (fn [state event ctx]
                       (controls/open-project-file-dialog! state
                                                           ctx
                                                           :file-dialog/open
                                                           "Open Project"))
       :project/save-as (fn [state event ctx]
                          (controls/open-project-file-dialog! state
                                                              ctx
                                                              :file-dialog/save
                                                              "Save Project As"))
       :project/save (fn [state event ctx]
                       (if (:project-path state)
                         (controls/apply-project-file-dialog-result
                          state
                          {:type :confirm
                           :mode :file-dialog/save
                           :path (:project-path state)
                           :directory (:project-directory state)
                           :filename (:project-filename state)})
                         (controls/open-project-file-dialog! state
                                                             ctx
                                                             :file-dialog/save
                                                             "Save Project")))
       :project/file-dialog-result (fn [state event ctx]
                                     (controls/apply-project-file-dialog-result
                                      state
                                      (:payload event)))
       :app/quit (fn [state event ctx]
                   (quit!))}})
