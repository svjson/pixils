(ns tilemap-editor.model.data)

(def tile-size 16)
(def map-width 40)
(def map-height 28)

(def project-format :pixils.tilemap-editor/project)
(def project-format-version 1)

(def project-resources
  {:bundles {}})

(def app-static-bundle-ids [:editor-assets])

(defun app-static-bundle-id? [bundle-id]
  (contains? app-static-bundle-ids bundle-id))

(defun project-resource-bundle? [bundle-id]
  (not (app-static-bundle-id? bundle-id)))

(defun project-resource-bundle-document [bundle]
  (dissoc (or bundle {}) :dynamic?))

(defun normalize-project-resources [resources]
  {:bundles (reduce-kv (or (:bundles resources) {})
                       {}
                       (fn [result bundle-id bundle]
                         (if (project-resource-bundle? bundle-id)
                           (assoc result
                                  bundle-id
                                  (project-resource-bundle-document bundle))
                           result)))})

(defun tileset-options [tilesets]
  (for-indexed [index tileset (or tilesets [])]
    {:value index
     :label (:label tileset)}))

(defun tileset-key [tilesets index]
  (let [items (or tilesets [])]
    (when (> (count items) 0)
      (:id (nth items (or index 0))))))

(defun tileset-index [tilesets tileset]
  (let [match (find-index (or tilesets [])
                          (fn [item]
                            (= (:id item) tileset)))]
    (or match 0)))

(defun tileset-definition [tilesets tileset]
  (head (filter (or tilesets [])
                (fn [item]
                  (= (:id item) tileset)))))

(defun tileset-label [tilesets tileset]
  (let [items (or tilesets [])]
    (if (> (count items) 0)
      (or (:label (nth items (tileset-index tilesets tileset))) "")
      "")))

(defun tileset-tiles [tilesets tileset]
  (or (:tiles (tileset-definition tilesets tileset)) []))

(defun tile-count [tilesets tileset]
  (count (tileset-tiles tilesets tileset)))

(defun clamp-tile-index [tilesets tileset index]
  (let [count (tile-count tilesets tileset)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun tile-index [tilesets tileset tile-ref]
  (if (keyword? tile-ref)
    (let [match (find-index (tileset-tiles tilesets tileset)
                            (fn [tile]
                              (= (:id tile) tile-ref)))]
      (or match 0))
    (clamp-tile-index tilesets tileset tile-ref)))

(defun tile-id [tilesets tileset tile-ref]
  (let [tiles (tileset-tiles tilesets tileset)]
    (when (> (count tiles) 0)
      (:id (nth tiles (tile-index tilesets tileset tile-ref))))))

(defun tile-options [tilesets tileset]
  (for-indexed [index tile (tileset-tiles tilesets tileset)]
    {:value (:id tile)
     :label (:name tile)}))

(defun tile-in [tilesets tileset tile-ref]
  (let [tiles (tileset-tiles tilesets tileset)]
    (when (> (count tiles) 0)
      (nth tiles (tile-index tilesets tileset tile-ref)))))

(defun tile-label [tilesets tileset tile-ref]
  (let [tile (tile-in tilesets tileset tile-ref)]
    (if tile
      (str "Selected: " (:name tile) " (" (:type tile) ")")
      "")))

(defun make-layered-map []
  [])

(defun serialized-nil? [value]
  (and (= (type-of value) "symbol")
       (= (str value) "nil")))

(defun normalize-tile-ref [tile-ref]
  (if (serialized-nil? tile-ref)
    nil
    tile-ref))

(defun normalize-tile-row [row]
  (map row normalize-tile-ref))

(defun normalize-layer [layer]
  (update layer :tiles (fn [tiles]
                         (map (or tiles [])
                              normalize-tile-row))))

(defun normalize-layers [layers]
  (map (or layers []) normalize-layer))

(defun normalize-project-document [project]
  (assoc-in project
            [:tilemap :layers]
            (normalize-layers (-> project :tilemap :layers))))

(defun project-document [state]
  {:format project-format
   :version project-format-version
   :resources (normalize-project-resources (or (:resources state)
                                               project-resources))
   :tilesets (or (:tilesets state) [])
   :tilemap {:width map-width
             :height map-height
             :tile-size tile-size
             :layers (or (:layers state) [])}})
