(ns tilemap-editor.model.tilemap
  (:require [tilemap-editor.model.data :as data]
            [tilemap-editor.model.derivation :as derivation]))



;; Tilemap operations

(defun clamp [value low high]
  (max low (min high value)))

(defun scaled-tile-size [zoom]
  (* data/tile-size (or zoom 1)))

(defun max-scroll-x [state ctx]
  (max 0 (- (* data/map-width (scaled-tile-size (:zoom state)))
            (-> ctx :view :bounds :w))))

(defun max-scroll-y [state ctx]
  (max 0 (- (* data/map-height (scaled-tile-size (:zoom state)))
            (-> ctx :view :bounds :h))))

(defun pan-map [state ctx dx dy]
  (let [offset (or (:offset state) {:x 0 :y 0})]
    (assoc state :offset {:x (clamp (+ (:x offset) dx) 0 (max-scroll-x state ctx))
                          :y (clamp (+ (:y offset) dy) 0 (max-scroll-y state ctx))})))

(defun clamp-map-offset [state ctx]
  (let [offset (or (:offset state) {:x 0 :y 0})]
    (assoc state :offset {:x (clamp (:x offset) 0 (max-scroll-x state ctx))
                          :y (clamp (:y offset) 0 (max-scroll-y state ctx))})))

(defun selected-index [items index]
  (let [items (or items [])]
    (if (empty? items)
      nil
      (min (or index 0) (dec (count items))))))

(defun selected-brush [brushes index]
  (if-let [selected (selected-index brushes index)]
    (nth brushes selected)
    nil))

(defun selected-layer [layers index]
  (if-let [selected (selected-index layers index)]
    (nth layers selected)
    nil))

(defun layer-index-by-id [layers layer-id]
  (find-index (or layers [])
              (fn [layer]
                (= (:id layer) layer-id))))

(def terrain-refresh-offsets
  [{:dx -1 :dy -1}
   {:dx 0 :dy -1}
   {:dx 1 :dy -1}
   {:dx -1 :dy 0}
   {:dx 0 :dy 0}
   {:dx 1 :dy 0}
   {:dx -1 :dy 1}
   {:dx 0 :dy 1}
   {:dx 1 :dy 1}])

(defun all-map-positions []
  (apply concat
         (dotimes [y data/map-height]
           (dotimes [x data/map-width]
             {:x x
              :y y}))))

(defun pattern-width [brush]
  (or (-> brush :pattern :size :w) 1))

(defun pattern-height [brush]
  (or (-> brush :pattern :size :h) 1))

(defun pattern-anchor [brush]
  (let [anchor (or (-> brush :pattern :anchor) {:x 0 :y 0})
        width (pattern-width brush)
        height (pattern-height brush)]
    {:x (clamp (or (:x anchor) 0) 0 (dec width))
     :y (clamp (or (:y anchor) 0) 0 (dec height))}))

(defun in-map-bounds? [x y]
  (and (>= x 0)
       (< x data/map-width)
       (>= y 0)
       (< y data/map-height)))

(defun map-tile-position [state event]
  (let [offset (or (:offset state) {:x 0 :y 0})
        pos (:position event)
        size (scaled-tile-size (:zoom state))]
    {:x (int (/ (+ (:x pos) (:x offset)) size))
     :y (int (/ (+ (:y pos) (:y offset)) size))}))

(defun set-map-tile [state layer-index x y tile-ref]
  (if (in-map-bounds? x y)
    (assoc-in state [:layers layer-index :tiles y x] tile-ref)
    state))

(defun make-terrain-stamp-layer [source-layer ruleset output-layer]
  {:id (:id output-layer)
   :label (or (:label output-layer) (:label ruleset) (str (:id ruleset)))
   :kind :tile
   :role :derived
   :data-kind :tile-ref
   :tileset (or (:tileset output-layer) (:output-tileset ruleset))
   :source-layers [(:id source-layer)]
   :target-layer (:target-layer output-layer)
   :ruleset (:id ruleset)
   :replaces-source? true
   :persistence :ephemeral
   :tiles (data/make-empty-map)})

(defun terrain-stamp-patch-target-layer-id [output-layer]
  (or (:target-layer output-layer)
      (:id output-layer)))

(defun tile-ref-layer-index-by-id [layers layer-id]
  (let [index (layer-index-by-id layers layer-id)
        layer (when (not (nil? index))
                (nth layers index))]
    (if (= (:data-kind layer) :tile-ref)
      index
      nil)))

(defun make-terrain-stamp-target-layer [state source-layer ruleset output-layer]
  (let [layer-id (terrain-stamp-patch-target-layer-id output-layer)]
    {:id layer-id
     :label (or (:label output-layer) (:label ruleset) (str layer-id))
     :kind :tile
     :role :source
     :data-kind :tile-ref
     :tileset (or (:tileset output-layer) (:output-tileset ruleset))
     :order (* (count (or (:layers state) [])) 10)
     :tiles (data/make-empty-map)}))

(defun ensure-terrain-stamp-target-layer [state source-layer ruleset output-layer]
  (let [layer-id (terrain-stamp-patch-target-layer-id output-layer)]
    (if (or (nil? layer-id)
            (not (nil? (layer-index-by-id (:layers state) layer-id)))
            (not (nil? (tile-ref-layer-index-by-id (:layers state) layer-id))))
      state
      (assoc state
             :layers
             (concat (or (:layers state) [])
                     [(make-terrain-stamp-target-layer state
                                                       source-layer
                                                       ruleset
                                                       output-layer)])))))

(defun terrain-stamp-layer-index [state collection-key layer-id]
  (layer-index-by-id (or (get state collection-key) []) layer-id))

(defun terrain-stamp-layer [state collection-key layer-id]
  (let [index (terrain-stamp-layer-index state collection-key layer-id)]
    (if (nil? index)
      nil
      (nth (or (get state collection-key) []) index))))

(defun terrain-stamp-layer-cell [state collection-key layer-id x y]
  (derivation/cell-at (terrain-stamp-layer state collection-key layer-id) x y))

(defun merge-source-layer-id [layer source-layer-id]
  (let [source-layers (or (:source-layers layer) [])]
    (if (contains? source-layers source-layer-id)
      layer
      (assoc layer :source-layers (concat source-layers [source-layer-id])))))

(defun ensure-terrain-stamp-layer [state collection-key source-layer ruleset output-layer]
  (let [layer-id (:id output-layer)
        layer-index (terrain-stamp-layer-index state collection-key layer-id)]
    (if (nil? layer-index)
      (assoc state
             collection-key
             (concat (or (get state collection-key) [])
                     [(make-terrain-stamp-layer source-layer ruleset output-layer)]))
      (assoc-in state
                [collection-key layer-index]
                (merge-source-layer-id (nth (or (get state collection-key) [])
                                            layer-index)
                                       (:id source-layer))))))

(defun set-terrain-stamp-layer-tile [state collection-key layer-id x y tile-ref]
  (let [layer-index (terrain-stamp-layer-index state collection-key layer-id)]
    (if (and (not (nil? layer-index))
             (in-map-bounds? x y))
      (assoc-in state [collection-key layer-index :tiles y x] tile-ref)
      state)))

(defun terrain-rule-application [state ruleset]
  (or (:application ruleset)
      (:terrain-rule-application state)
      :preview))

(defun terrain-rule-preview? [state ruleset]
  (= (terrain-rule-application state ruleset) :preview))

(defun terrain-rule-baked? [state ruleset]
  (= (terrain-rule-application state ruleset) :paint-baked))

(defun terrain-source-layer? [layer]
  (= (:data-kind layer) :terrain))

(defun ruleset-applies-to-layer? [ruleset layer]
  (and (= (:kind ruleset) :terrain-stamp)
       (or (= (:source-layer ruleset) (:id layer))
           (contains? (or (:source-layers ruleset) []) (:id layer))
           (and (nil? (:source-layer ruleset))
                (empty? (or (:source-layers ruleset) []))
                (= (:data-kind layer) :terrain)
                (= (:terrain-set ruleset) (:terrain-set layer))))))

(defun terrain-stamp-rulesets-for-layer [state layer]
  (filter (or (:rulesets state) [])
          (fn [ruleset]
            (ruleset-applies-to-layer? ruleset layer))))

(defun terrain-preview-rulesets-for-layer [state layer]
  (filter (terrain-stamp-rulesets-for-layer state layer)
          (fn [ruleset]
            (terrain-rule-preview? state ruleset))))

(defun affected-terrain-positions [x y]
  (filter (map terrain-refresh-offsets
               (fn [offset]
                 {:x (+ x (:dx offset))
                  :y (+ y (:dy offset))}))
          (fn [pos]
            (in-map-bounds? (:x pos) (:y pos)))))

(defun clear-target-stamp-entry [state target-layer-index layer-id x y]
  (if (not (nil? (terrain-stamp-layer-cell state
                                           :terrain-stamp-replacements
                                           layer-id
                                           x
                                           y)))
    (set-terrain-stamp-layer-tile
     (set-map-tile state target-layer-index x y nil)
     :terrain-stamp-replacements
     layer-id
     x
     y
     nil)
    state))

(defun apply-target-patch-cell [state target-layer-index layer-id cell]
  (let [x (:x cell)
        y (:y cell)
        tile-ref (:tile cell)]
    (if tile-ref
      (set-terrain-stamp-layer-tile
       (set-map-tile state target-layer-index x y tile-ref)
       :terrain-stamp-replacements
       layer-id
       x
       y
       true)
      (clear-target-stamp-entry state target-layer-index layer-id x y))))

(defun apply-auto-patch-cell [state layer-id cell]
  (set-terrain-stamp-layer-tile state
                                :terrain-stamp-layers
                                layer-id
                                (:x cell)
                                (:y cell)
                                (:tile cell)))

(defun apply-terrain-stamp-patch-cell [state application target-layer-index layer-id cell]
  (if (and (= application :paint-baked)
           target-layer-index)
    (apply-target-patch-cell state target-layer-index layer-id cell)
    (apply-auto-patch-cell state layer-id cell)))

(defun apply-terrain-stamp-patch [state source-layer ruleset patch]
  (let [output-layer (:output-layer patch)
        application (terrain-rule-application state ruleset)
        state (if (= application :paint-baked)
                (ensure-terrain-stamp-target-layer state
                                                   source-layer
                                                   ruleset
                                                   output-layer)
                state)
        target-layer-index (tile-ref-layer-index-by-id
                            (:layers state)
                            (terrain-stamp-patch-target-layer-id output-layer))
        collection-key (if (and (= application :paint-baked)
                                target-layer-index)
                         :terrain-stamp-replacements
                         :terrain-stamp-layers)
        state (ensure-terrain-stamp-layer state
                                          collection-key
                                          source-layer
                                          ruleset
                                          output-layer)
        layer-id (:id output-layer)]
    (reduce (or (:cells patch) [])
            state
            (fn [out cell]
              (apply-terrain-stamp-patch-cell out
                                              application
                                              target-layer-index
                                              layer-id
                                              cell)))))

(defun apply-terrain-stamp-patches [state source-layer ruleset patches]
  (reduce patches
          state
          (fn [out patch]
            (apply-terrain-stamp-patch out source-layer ruleset patch))))

(defun clear-rule-output-at [state source-layer ruleset source-x source-y rule]
  (apply-terrain-stamp-patches
   state
   source-layer
   ruleset
   (derivation/terrain-stamp-rule-clear-patches source-layer
                                                ruleset
                                                rule
                                                source-x
                                                source-y)))

(defun refresh-terrain-stamp-rules-at [state source-layer positions rulesets apply-fn]
  (reduce positions
          state
          (fn [out pos]
            (reduce rulesets
                    out
                    (fn [ruleset-out ruleset]
                      (reduce (or (:rules ruleset) [])
                              ruleset-out
                              (fn [rule-out rule]
                                (apply-fn rule-out
                                          source-layer
                                          ruleset
                                          (:x pos)
                                          (:y pos)
                                          rule))))))))

(defun clear-terrain-stamp-rules [state source-layer positions rulesets]
  (refresh-terrain-stamp-rules-at state
                                  source-layer
                                  positions
                                  rulesets
                                  (fn [out source-layer ruleset x y rule]
                                    (clear-rule-output-at out
                                                          source-layer
                                                          ruleset
                                                          x
                                                          y
                                                          rule))))

(defun apply-terrain-stamp-rules [state source-layer positions rulesets]
  (reduce positions
          state
          (fn [out pos]
            (reduce rulesets
                    out
                    (fn [ruleset-out ruleset]
                      (apply-terrain-stamp-patches
                       ruleset-out
                       source-layer
                       ruleset
                       (derivation/terrain-stamp-apply-patches-at
                        source-layer
                        ruleset
                        (:x pos)
                        (:y pos))))))))

(defun rebuild-terrain-stamp-preview-for-layer [state layer]
  (let [rulesets (terrain-preview-rulesets-for-layer state layer)]
    (if (or (not (terrain-source-layer? layer))
            (empty? rulesets))
      state
      (apply-terrain-stamp-rules state
                                 layer
                                 (all-map-positions)
                                 rulesets))))

(defun rebuild-terrain-stamp-preview [state]
  (reduce (for-indexed [index layer (or (:layers state) [])]
            {:index index
             :layer layer})
          (assoc state :terrain-stamp-layers [])
          (fn [out entry]
            (rebuild-terrain-stamp-preview-for-layer out
                                                     (:layer entry)))))

(defun set-terrain-rule-application [state application]
  (let [state (assoc state :terrain-rule-application application)]
    (if (= application :preview)
      (rebuild-terrain-stamp-preview state)
      (assoc state :terrain-stamp-layers []))))

(defun refresh-terrain-stamp-rules-around [state layer-index tile-x tile-y]
  (let [source-layer (nth (:layers state) layer-index)
        rulesets (terrain-stamp-rulesets-for-layer state source-layer)]
    (if (or (not (terrain-source-layer? source-layer))
            (empty? rulesets))
      state
      (let [positions (affected-terrain-positions tile-x tile-y)
            cleared (clear-terrain-stamp-rules state
                                               source-layer
                                               positions
                                               rulesets)
            refreshed-source-layer (nth (:layers cleared) layer-index)]
        (apply-terrain-stamp-rules cleared
                                   refreshed-source-layer
                                   positions
                                   rulesets)))))

(defun stamp-pattern-cell [state layer-index target-x target-y anchor cell]
  (let [tile-ref (:tile-ref cell)
        map-x (+ (- target-x (:x anchor)) (:x cell))
        map-y (+ (- target-y (:y anchor)) (:y cell))]
    (if (and (not (nil? tile-ref))
             (in-map-bounds? map-x map-y))
      (set-map-tile state layer-index map-x map-y tile-ref)
      state)))

(defun stamp-pattern-row [state layer-index target-x target-y anchor row]
  (reduce (for-indexed [x tile-ref (or (:tiles row) [])]
            {:x x
             :y (:y row)
             :tile-ref tile-ref})
          state
          (fn [out cell]
            (stamp-pattern-cell out
                                layer-index
                                target-x
                                target-y
                                anchor
                                cell))))

(defun stamp-pattern-layer [state layer-index target-x target-y brush layer]
  (if (not (nil? layer-index))
    (let [anchor (pattern-anchor brush)]
      (reduce (for-indexed [y row (or (:tiles layer) [])]
                {:y y
                 :tiles row})
              state
              (fn [out row]
                (stamp-pattern-row out
                                   layer-index
                                   target-x
                                   target-y
                                   anchor
                                   row))))
    state))

(defun legacy-pattern-layer-target-index [state selected-layer-index pattern-layer]
  (let [layer (selected-layer (:layers state) selected-layer-index)]
    (if (= (:tileset pattern-layer) (:tileset layer))
      selected-layer-index
      nil)))

(defun pattern-layer-target-index [state selected-layer-index pattern-layer]
  (if (:target-layer pattern-layer)
    (layer-index-by-id (:layers state) (:target-layer pattern-layer))
    (legacy-pattern-layer-target-index state
                                       selected-layer-index
                                       pattern-layer)))

(defun stamp-pattern-brush [state layer-index target-x target-y brush]
  (if (and brush (= (:kind brush) :pattern))
    (reduce (or (-> brush :pattern :layers) [])
            state
            (fn [out pattern-layer]
              (stamp-pattern-layer out
                                   (pattern-layer-target-index state
                                                               layer-index
                                                               pattern-layer)
                                   target-x
                                   target-y
                                   brush
                                   pattern-layer)))
    state))

(defun clear-pattern-footprint-row [state layer-index target-x target-y anchor y width]
  (reduce (range 0 (dec width))
          state
          (fn [out x]
            (set-map-tile out
                          layer-index
                          (+ (- target-x (:x anchor)) x)
                          (+ (- target-y (:y anchor)) y)
                          nil))))

(defun clear-pattern-footprint [state layer-index target-x target-y brush]
  (if (and brush (= (:kind brush) :pattern))
    (let [anchor (pattern-anchor brush)
          width (pattern-width brush)
          height (pattern-height brush)]
      (reduce (or (-> brush :pattern :layers) [])
              state
              (fn [out pattern-layer]
                (let [target-layer-index (pattern-layer-target-index
                                          state
                                          layer-index
                                          pattern-layer)]
                  (if (nil? target-layer-index)
                    out
                    (reduce (range 0 (dec height))
                            out
                            (fn [row-out y]
                              (clear-pattern-footprint-row row-out
                                                           target-layer-index
                                                           target-x
                                                           target-y
                                                           anchor
                                                           y
                                                           width))))))))
    state))

(defun paint-tile-at [state layer-index tile-x tile-y event]
  (cond
    (= (:button event) :left)
    (refresh-terrain-stamp-rules-around
     (set-map-tile state layer-index tile-x tile-y (:selected-tile state))
     layer-index
     tile-x
     tile-y)

    (= (:button event) :right)
    (refresh-terrain-stamp-rules-around
     (set-map-tile state layer-index tile-x tile-y nil)
     layer-index
     tile-x
     tile-y)

    :default
    state))

(defun paint-brush-at [state layer-index tile-x tile-y event]
  (let [brush (selected-brush (:brushes state) (:selected-brush-index state))]
    (cond
      (= (:button event) :left)
      (stamp-pattern-brush state layer-index tile-x tile-y brush)

      (= (:button event) :right)
      (clear-pattern-footprint state layer-index tile-x tile-y brush)

      :default
      state)))

(defun paint-map-at [state event]
  (let [tile-pos (map-tile-position state event)
        tile-x (:x tile-pos)
        tile-y (:y tile-pos)
        layer-index (or (:selected-layer-index state) 0)
        layers (or (:layers state) [])]
    (if (and (>= tile-x 0)
             (< tile-x data/map-width)
             (>= tile-y 0)
             (< tile-y data/map-height)
             (> (count layers) 0)
             (< layer-index (count layers)))
      (if (= (:map-palette-tab state) :brushes)
        (paint-brush-at state layer-index tile-x tile-y event)
        (paint-tile-at state layer-index tile-x tile-y event))
      state)))
