(ns tilemap-editor.model.derivation
  (:require [tilemap-editor.model.data :as data]))

(def north-bit 1)
(def east-bit 2)
(def south-bit 4)
(def west-bit 8)

(def terrain-stamp-directions
  {:nw {:dx -1 :dy -1}
   :n {:dx 0 :dy -1}
   :ne {:dx 1 :dy -1}
   :w {:dx -1 :dy 0}
   :e {:dx 1 :dy 0}
   :sw {:dx -1 :dy 1}
   :s {:dx 0 :dy 1}
   :se {:dx 1 :dy 1}})

(def opposite-terrain-stamp-directions
  {:nw :se
   :n :s
   :ne :sw
   :w :e
   :e :w
   :sw :ne
   :s :n
   :se :nw})

(def terrain-signature-directions [:nw :n :ne :w :center :e :sw :s :se])
(def unknown-terrain-value :terrain/unknown)

(defun layer-by-id [layers layer-id]
  (head (filter (or layers [])
                (fn [layer]
                  (= (:id layer) layer-id)))))

(defun ruleset-by-id [rulesets ruleset-id]
  (head (filter (or rulesets [])
                (fn [ruleset]
                  (= (:id ruleset) ruleset-id)))))

(defun first-layer-by-ids [layers layer-ids]
  (head (filter (map (or layer-ids [])
                     (fn [layer-id]
                       (layer-by-id layers layer-id)))
                (fn [layer]
                  (not (nil? layer))))))

(defun terrain-source-layer-for-ruleset [layers ruleset]
  (or (layer-by-id layers (:source-layer ruleset))
      (first-layer-by-ids layers (:source-layers ruleset))
      (head (filter (or layers [])
                    (fn [layer]
                      (and (= (:data-kind layer) :terrain)
                           (= (:terrain-set layer) (:terrain-set ruleset))))))))

(defun cell-at [layer x y]
  (if (and layer
           (>= x 0)
           (< x data/map-width)
           (>= y 0)
           (< y data/map-height))
    (nth (nth (or (:tiles layer) []) y) x)
    nil))

(defun terrain-signature-source-layer? [layer]
  (= (:data-kind layer) :terrain-signature))

(defun terrain-signature-at [layer x y]
  (let [tile-ref (cell-at layer x y)
        cell-signature (nth (or (nth (or (:terrain-signatures layer) []) y) []) x)]
    (cond
      cell-signature cell-signature
      (nil? tile-ref) nil
      :default (or (get (:terrain-signatures-by-tile layer) tile-ref)
                   unknown-terrain-value))))

(defun terrain-signature-direction-value [signature direction]
  (cond
    (nil? signature) nil
    (= signature unknown-terrain-value) unknown-terrain-value
    (contains? signature direction)
    (let [value (get signature direction)]
      (if (= value :none)
        nil
        value))
    :default unknown-terrain-value))

(defun terrain-signature-neighbor-value-at [source-layer direction x y]
  (let [offset (get terrain-stamp-directions direction)
        neighbor-signature (terrain-signature-at source-layer
                                                 (+ x (:dx offset))
                                                 (+ y (:dy offset)))]
    (if (nil? neighbor-signature)
      nil
      (let [opposite-value (terrain-signature-direction-value
                            neighbor-signature
                            (get opposite-terrain-stamp-directions direction))]
        (if (= opposite-value unknown-terrain-value)
          (terrain-signature-direction-value neighbor-signature :center)
          opposite-value)))))

(defun terrain-signature-value-at [source-layer direction x y]
  (let [signature (terrain-signature-at source-layer x y)
        center-value (terrain-signature-direction-value signature :center)
        direction (or direction :center)
        direction-value (terrain-signature-direction-value signature direction)]
    (if (= direction :center)
      center-value
      (if (and (not= direction-value unknown-terrain-value)
               (not= direction-value center-value))
        direction-value
        (terrain-signature-neighbor-value-at source-layer direction x y)))))

(defun terrain-value-at [source-layer direction x y]
  (if (terrain-signature-source-layer? source-layer)
    (terrain-signature-value-at source-layer direction x y)
    (if-let [offset (get terrain-stamp-directions direction)]
      (cell-at source-layer (+ x (:dx offset)) (+ y (:dy offset)))
      (cell-at source-layer x y))))

(defun terrain-at? [layer terrain x y]
  (= (cell-at layer x y) terrain))

(defun marching-4-mask [layer terrain x y]
  (+ (if (terrain-at? layer terrain x (dec y)) north-bit 0)
     (if (terrain-at? layer terrain (inc x) y) east-bit 0)
     (if (terrain-at? layer terrain x (inc y)) south-bit 0)
     (if (terrain-at? layer terrain (dec x) y) west-bit 0)))

(defun marching-4-tile-for-mask [ruleset mask]
  (get (:tiles-by-mask ruleset) mask))

(defun derive-marching-4-row [source-layer ruleset y]
  (dotimes [x data/map-width]
    (if (terrain-at? source-layer (:terrain ruleset) x y)
      (marching-4-tile-for-mask ruleset
                                (marching-4-mask source-layer
                                                  (:terrain ruleset)
                                                  x
                                                  y))
      nil)))

(defun derive-marching-4-tiles [source-layer ruleset]
  (dotimes [y data/map-height]
    (derive-marching-4-row source-layer ruleset y)))

(defun derived-layer-base [definition ruleset]
  {:id (:id definition)
   :label (or (:label definition) (str (:id definition)))
   :kind :tile
   :role :derived
   :data-kind :tile-ref
   :tileset (or (:tileset definition) (:output-tileset ruleset))
   :source-layers (or (:source-layers definition)
                      [(:source-layer ruleset)])
   :ruleset (:id ruleset)
   :persistence (or (:persistence definition) :ephemeral)})

(defun derive-marching-4-layer [tilemap definition ruleset]
  (let [source-layer (layer-by-id (:layers tilemap)
                                  (or (:source-layer ruleset)
                                      (head (:source-layers definition))))]
    (if source-layer
      (assoc (derived-layer-base definition ruleset)
             :tiles (derive-marching-4-tiles source-layer ruleset))
      nil)))

(defun terrain-match-center [rule]
  (or (:terrain rule)
      (-> rule :match :center :terrain)))

(defun known-terrain-value? [value]
  (and (not (nil? value))
       (not= value unknown-terrain-value)))

(defun terrain-match-condition-value? [center-terrain condition value]
  (case condition
    :ignore true
    :same (= value center-terrain)
    :none (nil? value)
    :any-terrain (known-terrain-value? value)
    :not-same (and (known-terrain-value? value)
                   (not= value center-terrain))
    :other-terrain (and (known-terrain-value? value)
                        (not= value center-terrain))
    :default
    (if (= (type-of condition) "map")
      (= value (:terrain condition))
      true)))

(defun terrain-match-condition? [source-layer center-terrain direction condition x y]
  (terrain-match-condition-value? center-terrain
                                  condition
                                  (terrain-value-at source-layer direction x y)))

(defun terrain-stamp-rule-matches? [source-layer rule x y]
  (let [center-terrain (terrain-match-center rule)
        match (or (:match rule) {})]
    (and (= (terrain-value-at source-layer :center x y) center-terrain)
         (= 0
            (count (filter
                    (reduce-kv terrain-stamp-directions
                               []
                               (fn [checks direction offset]
                                 (let [condition (get match direction)]
                                   (if (or (nil? condition)
                                           (= condition :ignore))
                                     checks
                                     (concat checks
                                             [(terrain-match-condition?
                                               source-layer
                                               center-terrain
                                               direction
                                               condition
                                               x
                                               y)])))))
                    (fn [matched?]
                      (= matched? false))))))))

(defun empty-derived-tiles []
  (dotimes [y data/map-height]
    (data/make-empty-row)))

(defun in-map-bounds? [x y]
  (and (>= x 0)
       (< x data/map-width)
       (>= y 0)
       (< y data/map-height)))

(defun stamp-output-layer-matches? [definition output-layer]
  (= (:target-layer output-layer) (:id definition)))

(defun stamp-tile [tiles x y tile]
  (if (and tile (in-map-bounds? x y))
    (:tiles (assoc-in {:tiles tiles} [:tiles y x] tile))
    tiles))

(defun output-layer-tile-entries [output-layer]
  (apply concat
         (for-indexed [tile-y row (or (:tiles output-layer) [])]
           (for-indexed [tile-x tile (or row [])]
             {:x tile-x
              :y tile-y
              :tile tile}))))

(defun output-anchor [output]
  (or (:anchor output) {:x 0 :y 0}))

(defun output-layer-anchor-entry [output output-layer]
  (let [anchor (output-anchor output)]
    {:x (:x anchor)
     :y (:y anchor)
     :tile (nth (or (nth (or (:tiles output-layer) []) (:y anchor)) [])
                (:x anchor))}))

(defun apply-stamp-output-layer [tiles source-x source-y output output-layer]
  (let [entry (output-layer-anchor-entry output output-layer)]
    (stamp-tile tiles source-x source-y (:tile entry))))

(defun terrain-stamp-rule-exclusive? [rule]
  (= (:exclusive? rule) true))

(defun solid-terrain-signature [terrain-id]
  (reduce terrain-signature-directions
          {}
          (fn [result direction]
            (assoc result direction terrain-id))))

(defun match-condition-signature-value [center-terrain-id condition]
  (case condition
    :same center-terrain-id
    :none :none
    :default
    (if (= (type-of condition) "map")
      (:terrain condition)
      nil)))

(defun default-terrain-signature-for-rule [rule]
  (let [center-terrain-id (terrain-match-center rule)]
    (reduce-kv (or (:match rule) {})
               (solid-terrain-signature center-terrain-id)
               (fn [signature direction condition]
                 (if-let [value (match-condition-signature-value
                                  center-terrain-id
                                  condition)]
                   (assoc signature direction value)
                   (if (or (= condition :not-same)
                           (= condition :other-terrain)
                           (= condition :any-terrain))
                     (dissoc signature direction)
                     signature))))))

(defun apply-terrain-stamp-rule-output [tiles definition rule x y]
  (reduce (or (-> rule :output :layers) [])
          tiles
          (fn [next-tiles output-layer]
            (if (stamp-output-layer-matches? definition output-layer)
              (apply-stamp-output-layer next-tiles
                                        x
                                        y
                                        (:output rule)
                                        output-layer)
              next-tiles))))

(defun apply-terrain-stamp-rules-at-position [tiles definition source-layer rules x y]
  (:tiles
   (reduce (or rules [])
           {:tiles tiles
            :done? false}
           (fn [result rule]
             (if (:done? result)
               result
               (if (terrain-stamp-rule-matches? source-layer rule x y)
                 {:tiles (apply-terrain-stamp-rule-output (:tiles result)
                                                          definition
                                                          rule
                                                          x
                                                          y)
                  :done? (terrain-stamp-rule-exclusive? rule)}
                 result))))))

(defun derive-terrain-stamp-tiles [source-layer definition ruleset]
  (reduce (apply concat
                 (dotimes [y data/map-height]
                   (dotimes [x data/map-width]
                     {:x x
                      :y y})))
          (empty-derived-tiles)
          (fn [tiles pos]
            (apply-terrain-stamp-rules-at-position tiles
                                                   definition
                                                   source-layer
                                                   (:rules ruleset)
                                                   (:x pos)
                                                   (:y pos)))))

(defun terrain-stamp-output-layer [definition ruleset]
  (head (apply concat
               (map (or (:rules ruleset) [])
                    (fn [rule]
                      (filter (or (-> rule :output :layers) [])
                              (fn [output-layer]
                                (stamp-output-layer-matches?
                                 definition
                                 output-layer))))))))

(defun id-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun targetless-terrain-stamp-output-layer-key [ruleset output-layer]
  (keyword (str (id-label (:id ruleset))
                "/"
                (id-label (or (:tileset output-layer)
                              (:output-tileset ruleset)
                              "output")))))

(defun terrain-stamp-output-layer-key [ruleset output-layer]
  (or (:target-layer output-layer)
      (:id output-layer)
      (targetless-terrain-stamp-output-layer-key ruleset output-layer)))

(defun output-layer-terrain-signatures [output-layer]
  (or (:terrain-signatures output-layer)
      [[nil nil nil]
       [nil nil nil]
       [nil nil nil]]))

(defun output-layer-terrain-signature-at [output-layer x y]
  (nth (or (nth (output-layer-terrain-signatures output-layer) y) []) x))

(defun stamp-output-position [source-x source-y output entry]
  (let [anchor (output-anchor output)]
    {:x (+ source-x (:x entry) (- (:x anchor)))
     :y (+ source-y (:y entry) (- (:y anchor)))}))

(defun stamp-output-patch-cell [source-x source-y output entry tile terrain-signature]
  (let [pos (stamp-output-position source-x source-y output entry)]
    {:x (:x pos)
     :y (:y pos)
     :tile tile
     :terrain-signature terrain-signature}))

(defun stamp-output-patch-cells [source-x source-y output output-layer tile-fn signature-fn]
  (filter (map [(output-layer-anchor-entry output output-layer)]
               (fn [entry]
                 (when (:tile entry)
                   (stamp-output-patch-cell source-x
                                            source-y
                                            output
                                            entry
                                            (tile-fn entry)
                                            (signature-fn entry)))))
          (fn [cell]
            (and cell
                 (in-map-bounds? (:x cell) (:y cell))))))

(defun terrain-stamp-output-patch [source-layer ruleset rule source-x source-y output-layer tile-fn signature-fn]
  (let [cells (stamp-output-patch-cells source-x
                                        source-y
                                        (:output rule)
                                        output-layer
                                        tile-fn
                                        signature-fn)]
    (when (not (empty? cells))
      {:source-layer (:id source-layer)
       :source-position {:x source-x :y source-y}
       :ruleset (:id ruleset)
       :rule (:id rule)
       :output-layer (assoc (dissoc output-layer :tiles)
                            :id (terrain-stamp-output-layer-key ruleset
                                                                output-layer))
       :cells cells})))

(defun terrain-stamp-rule-patches-with [source-layer ruleset rule source-x source-y tile-fn]
  (filter (map (or (-> rule :output :layers) [])
               (fn [output-layer]
                 (terrain-stamp-output-patch source-layer
                                             ruleset
                                             rule
                                             source-x
                                             source-y
                                             output-layer
                                             tile-fn
                                             (fn [entry] nil))))
          (fn [patch]
            (not (nil? patch)))))

(defun terrain-stamp-matching-rule-apply-patches [source-layer ruleset rule source-x source-y]
  (filter (map (or (-> rule :output :layers) [])
               (fn [output-layer]
                 (terrain-stamp-output-patch
                  source-layer
                  ruleset
                  rule
                  source-x
                  source-y
                  output-layer
                  (fn [entry] (:tile entry))
                  (fn [entry]
                    (or (output-layer-terrain-signature-at output-layer
                                                           (:x entry)
                                                           (:y entry))
                        (default-terrain-signature-for-rule rule))))))
          (fn [patch]
            (not (nil? patch)))))

(defun terrain-stamp-rule-clear-patches [source-layer ruleset rule source-x source-y]
  (terrain-stamp-rule-patches-with source-layer
                                   ruleset
                                   rule
                                   source-x
                                   source-y
                                   (fn [entry] nil)))

(defun terrain-stamp-apply-patches-at [source-layer ruleset source-x source-y]
  (:patches
   (reduce (or (:rules ruleset) [])
           {:patches []
            :done? false}
           (fn [result rule]
             (if (:done? result)
               result
               (if (terrain-stamp-rule-matches? source-layer rule source-x source-y)
                 {:patches (concat (:patches result)
                                   (terrain-stamp-matching-rule-apply-patches
                                    source-layer
                                    ruleset
                                    rule
                                    source-x
                                    source-y))
                  :done? (terrain-stamp-rule-exclusive? rule)}
                 result))))))

(defun terrain-stamp-clear-patches-at [source-layer ruleset source-x source-y]
  (apply concat
         (map (or (:rules ruleset) [])
              (fn [rule]
                (terrain-stamp-rule-clear-patches source-layer
                                                  ruleset
                                                  rule
                                                  source-x
                                                  source-y)))))

(defun terrain-stamp-apply-patches-for-positions [source-layer ruleset positions]
  (apply concat
         (map (or positions [])
              (fn [pos]
                (terrain-stamp-apply-patches-at source-layer
                                                ruleset
                                                (:x pos)
                                                (:y pos))))))

(defun terrain-stamp-clear-patches-for-positions [source-layer ruleset positions]
  (apply concat
         (map (or positions [])
              (fn [pos]
                (terrain-stamp-clear-patches-at source-layer
                                                ruleset
                                                (:x pos)
                                                (:y pos))))))

(defun derive-terrain-stamp-layer [tilemap definition ruleset]
  (let [source-layer (or (layer-by-id (:layers tilemap)
                                      (or (:source-layer ruleset)
                                          (head (:source-layers definition))))
                         (terrain-source-layer-for-ruleset (:layers tilemap)
                                                           ruleset))
        output-layer (terrain-stamp-output-layer definition ruleset)]
    (if source-layer
      (assoc (derived-layer-base definition ruleset)
             :tileset (or (:tileset definition)
                          (:tileset output-layer)
                          (:output-tileset ruleset))
             :replaces-source? true
             :tiles (derive-terrain-stamp-tiles source-layer
                                                definition
                                                ruleset))
      nil)))

(defun derive-layer [tilemap layer-profile rulesets derived-layer-id]
  (let [definition (layer-by-id (:layers layer-profile) derived-layer-id)
        ruleset (ruleset-by-id rulesets (:ruleset definition))]
    (case (:kind definition)
      :marching-4 (derive-marching-4-layer tilemap definition ruleset)
      :terrain-stamp (derive-terrain-stamp-layer tilemap definition ruleset)
      :default nil)))

(defun layer-in-profile? [profile layer]
  (not (nil? (layer-by-id (:layers profile) (:id layer)))))

(defun profile-source-render-layer [tilemap definition]
  (layer-by-id (:layers tilemap) (:id definition)))

(defun profile-derived-render-layer [tilemap profile rulesets definition]
  (or (when (= (:persistence definition) :materialized)
        (layer-by-id (:layers tilemap) (:id definition)))
      (derive-layer tilemap profile rulesets (:id definition))))

(defun profile-render-layer [tilemap profile rulesets definition]
  (if (= (:role definition) :derived)
    (profile-derived-render-layer tilemap profile rulesets definition)
    (profile-source-render-layer tilemap definition)))

(defun render-layers-from-profile [tilemap profile rulesets]
  (filter (map (or (:layers profile) [])
               (fn [definition]
                 (profile-render-layer tilemap profile rulesets definition)))
          (fn [layer]
            (not (nil? layer)))))

(defun unprofiled-render-layers [tilemap profile]
  (filter (or (:layers tilemap) [])
          (fn [layer]
            (not (layer-in-profile? profile layer)))))

(defun replacement-layer-source-ids [layer]
  (or (:terrain-stamp-source-layers layer)
      (if (:replaces-source? layer)
        (:source-layers layer)
        [])))

(defun replacement-layer-for-source? [source-layer layer]
  (and (:replaces-source? layer)
       (contains? (or (replacement-layer-source-ids layer) [])
                  (:id source-layer))))

(defun replacement-cell? [source-layer replacement-layers x y]
  (> (count (filter replacement-layers
                    (fn [layer]
                      (and (replacement-layer-for-source? source-layer layer)
                           (not (nil? (cell-at layer x y)))))))
     0))

(defun mask-source-row-with-replacements [source-layer replacement-layers y row]
  (for-indexed [x tile-ref (or row [])]
    (if (replacement-cell? source-layer replacement-layers x y)
      nil
      tile-ref)))

(defun mask-source-layer-with-replacements [replacement-layers layer]
  (if (= (:data-kind layer) :terrain)
    (assoc layer
           :tiles (for-indexed [y row (or (:tiles layer) [])]
                    (mask-source-row-with-replacements layer
                                                       replacement-layers
                                                       y
                                                       row)))
    layer))

(defun mask-source-layers-with-replacements [layers replacement-layers]
  (map layers
       (fn [layer]
         (mask-source-layer-with-replacements replacement-layers layer))))

(defun render-layers [tilemap layer-profile rulesets]
  (let [profile (or layer-profile {:layers []})
        profile-layers (render-layers-from-profile tilemap profile rulesets)
        show-rules? (not= (:show-terrain-rules? tilemap) false)
        stamp-layers (if show-rules?
                       (or (:terrain-stamp-layers tilemap) [])
                       [])
        replacement-layers (if show-rules?
                             (concat (or (:terrain-stamp-replacements tilemap) [])
                                     stamp-layers)
                             [])
        layers (if (empty? profile-layers)
                 (concat (or (:layers tilemap) [])
                         stamp-layers)
                 (concat profile-layers
                         (unprofiled-render-layers tilemap profile)
                         stamp-layers))]
    (mask-source-layers-with-replacements
     layers
     replacement-layers)))
