(ns tilemap-editor.model.derivation
  (:require [tilemap-editor.model.data :as data]))

(def north-bit 1)
(def east-bit 2)
(def south-bit 4)
(def west-bit 8)

(def terrain-stamp-directions
  {:nw {:dx -1 :dy -1}
   :n {:dx 0 :dy -1}
   :ne {:dx 1 :dy -1}
   :w {:dx -1 :dy 0}
   :e {:dx 1 :dy 0}
   :sw {:dx -1 :dy 1}
   :s {:dx 0 :dy 1}
   :se {:dx 1 :dy 1}})

(def opposite-terrain-stamp-directions
  {:nw :se
   :n :s
   :ne :sw
   :w :e
   :e :w
   :sw :ne
   :s :n
   :se :nw})

(def terrain-signature-directions [:nw :n :ne :w :center :e :sw :s :se])
(def unknown-terrain-value :terrain/unknown)

(defun layer-by-id [layers layer-id]
  (head (filter (or layers [])
                (fn [layer]
                  (= (:id layer) layer-id)))))

(defun ruleset-by-id [rulesets ruleset-id]
  (head (filter (or rulesets [])
                (fn [ruleset]
                  (= (:id ruleset) ruleset-id)))))

(defun first-layer-by-ids [layers layer-ids]
  (head (filter (map (or layer-ids [])
                     (fn [layer-id]
                       (layer-by-id layers layer-id)))
                (fn [layer]
                  (not (nil? layer))))))

(defun terrain-source-layer-for-ruleset [layers ruleset]
  (or (layer-by-id layers (:source-layer ruleset))
      (first-layer-by-ids layers (:source-layers ruleset))
      (head (filter (or layers [])
                    (fn [layer]
                      (and (= (:data-kind layer) :terrain)
                           (= (:terrain-set layer) (:terrain-set ruleset))))))))

(defun cell-at [layer x y]
  (if (and layer
           (>= x 0)
           (< x data/map-width)
           (>= y 0)
           (< y data/map-height))
    (nth (nth (or (:tiles layer) []) y) x)
    nil))

(defun terrain-signature-source-layer? [layer]
  (= (:data-kind layer) :terrain-signature))

(defun terrain-signature-cell-at [layer x y]
  (or (get-in layer [:terrain-signatures-by-position y x])
      (nth (or (nth (or (:terrain-signatures layer) []) y) []) x)))

(defun terrain-signature-at [layer x y]
  (let [tile-ref (cell-at layer x y)
        cell-signature (terrain-signature-cell-at layer x y)]
    (cond
      cell-signature cell-signature
      (nil? tile-ref) nil
      :default (or (get (:terrain-signatures-by-tile layer) tile-ref)
                   (if (= (:terrain-signature-default layer) :terrain-id)
                     (solid-terrain-signature tile-ref)
                     nil)
                   unknown-terrain-value))))

(defun terrain-signature-direction-value [signature direction]
  (cond
    (nil? signature) nil
    (= signature unknown-terrain-value) unknown-terrain-value
    (contains? signature direction)
    (let [value (get signature direction)]
      (if (= value :none)
        nil
        value))
    :default unknown-terrain-value))

(defun terrain-signature-neighbor-value-at [source-layer direction x y]
  (let [offset (get terrain-stamp-directions direction)
        neighbor-signature (terrain-signature-at source-layer
                                                 (+ x (:dx offset))
                                                 (+ y (:dy offset)))]
    (if (nil? neighbor-signature)
      nil
      (let [opposite-value (terrain-signature-direction-value
                            neighbor-signature
                            (get opposite-terrain-stamp-directions direction))]
        (if (= opposite-value unknown-terrain-value)
          (terrain-signature-direction-value neighbor-signature :center)
          opposite-value)))))

(defun terrain-signature-value-at [source-layer direction x y]
  (let [signature (terrain-signature-at source-layer x y)
        center-value (terrain-signature-direction-value signature :center)
        direction (or direction :center)
        direction-value (terrain-signature-direction-value signature direction)]
    (if (= direction :center)
      center-value
      (if (and (not= direction-value unknown-terrain-value)
               (not= direction-value center-value))
        direction-value
        (terrain-signature-neighbor-value-at source-layer direction x y)))))

(defun terrain-value-at [source-layer direction x y]
  (if (terrain-signature-source-layer? source-layer)
    (terrain-signature-value-at source-layer direction x y)
    (if-let [offset (get terrain-stamp-directions direction)]
      (cell-at source-layer (+ x (:dx offset)) (+ y (:dy offset)))
      (cell-at source-layer x y))))

(defun terrain-unit-width [ruleset]
  (:w (data/terrain-unit ruleset)))

(defun terrain-unit-height [ruleset]
  (:h (data/terrain-unit ruleset)))

(defun terrain-unit-single-cell? [ruleset]
  (let [unit (data/terrain-unit ruleset)]
    (and (= (:w unit) 1)
         (= (:h unit) 1))))

(defun terrain-unit-anchor-x [unit x]
  (* (:w unit) (int (/ x (:w unit)))))

(defun terrain-unit-anchor-y [unit y]
  (* (:h unit) (int (/ y (:h unit)))))

(defun terrain-unit-anchor-position? [unit x y]
  (and (= x (terrain-unit-anchor-x unit x))
       (= y (terrain-unit-anchor-y unit y))))

(defun terrain-unit-direction-offset [unit direction]
  (let [offset (get terrain-stamp-directions direction)]
    (if offset
      {:dx (* (:dx offset) (:w unit))
       :dy (* (:dy offset) (:h unit))}
      {:dx 0 :dy 0})))

(defun terrain-unit-cell-positions [unit x y]
  (apply concat
         (dotimes [dy (:h unit)]
           (dotimes [dx (:w unit)]
             {:x (+ x dx)
              :y (+ y dy)}))))

(defun consistent-terrain-value [values]
  (let [state (reduce (or values [])
                      {:initialized? false
                       :value nil
                       :mixed? false}
                      (fn [state value]
                        (if (:mixed? state)
                          state
                          (if (:initialized? state)
                            (if (= value (:value state))
                              state
                              (assoc state :mixed? true))
                            {:initialized? true
                             :value value
                             :mixed? false}))))]
    (if (:mixed? state)
      unknown-terrain-value
      (:value state))))

(defun terrain-unit-cell-value-at [source-layer unit x y]
  (consistent-terrain-value
   (map (terrain-unit-cell-positions unit x y)
        (fn [pos]
          (cell-at source-layer (:x pos) (:y pos))))))

(defun terrain-unit-target-position [unit direction x y]
  (let [anchor-x (terrain-unit-anchor-x unit x)
        anchor-y (terrain-unit-anchor-y unit y)
        offset (terrain-unit-direction-offset unit direction)]
    {:x (+ anchor-x (:dx offset))
     :y (+ anchor-y (:dy offset))}))

(defun terrain-unit-plain-value-at [source-layer ruleset direction x y]
  (let [unit (data/terrain-unit ruleset)
        direction (or direction :center)]
    (if (and (= direction :center)
             (not (terrain-unit-anchor-position? unit x y)))
      nil
      (let [target (terrain-unit-target-position unit direction x y)]
        (terrain-unit-cell-value-at source-layer
                                    unit
                                    (:x target)
                                    (:y target))))))

(defun terrain-unit-signature-direction-value-at [source-layer direction x y]
  (let [signature (terrain-signature-at source-layer x y)]
    (cond
      (nil? signature) nil
      (= signature unknown-terrain-value) unknown-terrain-value
      :default (terrain-signature-direction-value signature direction))))

(defun terrain-unit-consistent-signature-value [source-layer unit direction x y]
  (consistent-terrain-value
   (map (terrain-unit-cell-positions unit x y)
        (fn [pos]
          (terrain-unit-signature-direction-value-at source-layer
                                                    direction
                                                    (:x pos)
                                                    (:y pos))))))

(defun terrain-unit-neighbor-signature-value-at [source-layer unit direction x y]
  (let [target (terrain-unit-target-position unit direction x y)
        opposite-direction (get opposite-terrain-stamp-directions direction)
        opposite-value (terrain-unit-consistent-signature-value
                        source-layer
                        unit
                        opposite-direction
                        (:x target)
                        (:y target))]
    (if (= opposite-value unknown-terrain-value)
      (terrain-unit-consistent-signature-value source-layer
                                              unit
                                              :center
                                              (:x target)
                                              (:y target))
      opposite-value)))

(defun terrain-unit-signature-value-at [source-layer ruleset direction x y]
  (let [unit (data/terrain-unit ruleset)
        direction (or direction :center)
        anchor-x (terrain-unit-anchor-x unit x)
        anchor-y (terrain-unit-anchor-y unit y)
        center-value (terrain-unit-consistent-signature-value source-layer
                                                             unit
                                                             :center
                                                             anchor-x
                                                             anchor-y)]
    (if (and (= direction :center)
             (not (terrain-unit-anchor-position? unit x y)))
      nil
      (if (= direction :center)
        center-value
        (let [direction-value (terrain-unit-consistent-signature-value
                               source-layer
                               unit
                               direction
                               anchor-x
                               anchor-y)]
          (if (and (known-terrain-value? direction-value)
                   (not= direction-value center-value))
            direction-value
            (terrain-unit-neighbor-signature-value-at source-layer
                                                     unit
                                                     direction
                                                     x
                                                     y)))))))

(defun terrain-value-at-for-ruleset [source-layer ruleset direction x y]
  (if (terrain-unit-single-cell? ruleset)
    (terrain-value-at source-layer direction x y)
    (if (terrain-signature-source-layer? source-layer)
      (terrain-unit-signature-value-at source-layer ruleset direction x y)
      (terrain-unit-plain-value-at source-layer ruleset direction x y))))

(defun terrain-at? [layer terrain x y]
  (= (cell-at layer x y) terrain))

(defun marching-4-mask [layer terrain x y]
  (+ (if (terrain-at? layer terrain x (dec y)) north-bit 0)
     (if (terrain-at? layer terrain (inc x) y) east-bit 0)
     (if (terrain-at? layer terrain x (inc y)) south-bit 0)
     (if (terrain-at? layer terrain (dec x) y) west-bit 0)))

(defun marching-4-tile-for-mask [ruleset mask]
  (get (:tiles-by-mask ruleset) mask))

(defun derive-marching-4-row [source-layer ruleset y]
  (dotimes [x data/map-width]
    (if (terrain-at? source-layer (:terrain ruleset) x y)
      (marching-4-tile-for-mask ruleset
                                (marching-4-mask source-layer
                                                  (:terrain ruleset)
                                                  x
                                                  y))
      nil)))

(defun derive-marching-4-tiles [source-layer ruleset]
  (dotimes [y data/map-height]
    (derive-marching-4-row source-layer ruleset y)))

(defun derived-layer-base [definition ruleset]
  {:id (:id definition)
   :label (or (:label definition) (str (:id definition)))
   :kind :tile
   :role :derived
   :data-kind :tile-ref
   :tileset (or (:tileset definition) (:output-tileset ruleset))
   :source-layers (or (:source-layers definition)
                      [(:source-layer ruleset)])
   :ruleset (:id ruleset)
   :persistence (or (:persistence definition) :ephemeral)})

(defun derive-marching-4-layer [tilemap definition ruleset]
  (let [source-layer (layer-by-id (:layers tilemap)
                                  (or (:source-layer ruleset)
                                      (head (:source-layers definition))))]
    (if source-layer
      (assoc (derived-layer-base definition ruleset)
             :tiles (derive-marching-4-tiles source-layer ruleset))
      nil)))

(defun terrain-match-center [rule]
  (or (:terrain rule)
      (-> rule :match :center :terrain)))

(defun known-terrain-value? [value]
  (and (not (nil? value))
       (not= value unknown-terrain-value)))

(defun terrain-match-condition-value? [center-terrain condition value]
  (case condition
    :ignore true
    :same (= value center-terrain)
    :none (nil? value)
    :any-terrain (known-terrain-value? value)
    :not-same (and (known-terrain-value? value)
                   (not= value center-terrain))
    :other-terrain (and (known-terrain-value? value)
                        (not= value center-terrain))
    :default
    (if (= (type-of condition) "map")
      (= value (:terrain condition))
      true)))

(defun terrain-match-condition? [source-layer ruleset center-terrain direction condition x y]
  (terrain-match-condition-value? center-terrain
                                  condition
                                  (terrain-value-at-for-ruleset
                                   source-layer
                                   ruleset
                                   direction
                                   x
                                   y)))

(defun terrain-stamp-rule-matches-for-ruleset? [source-layer ruleset rule x y]
  (let [center-terrain (terrain-match-center rule)
        match (or (:match rule) {})]
    (and (= (terrain-value-at-for-ruleset source-layer
                                          ruleset
                                          :center
                                          x
                                          y)
            center-terrain)
         (reduce-kv terrain-stamp-directions
                    true
                    (fn [matched? direction offset]
                      (if (not matched?)
                        false
                        (let [condition (get match direction)]
                          (if (or (nil? condition)
                                  (= condition :ignore))
                            true
                            (terrain-match-condition?
                             source-layer
                             ruleset
                             center-terrain
                             direction
                             condition
                             x
                             y)))))))))

(defun terrain-stamp-rule-matches? [source-layer rule x y]
  (terrain-stamp-rule-matches-for-ruleset? source-layer
                                           {}
                                           rule
                                           x
                                           y))

(defun terrain-stamp-rules-by-center [rules]
  (reduce (or rules [])
          {}
          (fn [result rule]
            (let [center (terrain-match-center rule)]
              (assoc result
                     center
                     (concat (or (get result center) []) [rule]))))))

(defun terrain-stamp-ruleset-rules-by-center [ruleset]
  (or (:rules-by-center ruleset)
      (terrain-stamp-rules-by-center (:rules ruleset))))

(defun terrain-stamp-index-ruleset [ruleset]
  (assoc ruleset
         :rules-by-center
         (terrain-stamp-ruleset-rules-by-center ruleset)))

(defun terrain-stamp-candidate-rules [source-layer ruleset x y]
  (or (get (terrain-stamp-ruleset-rules-by-center ruleset)
           (terrain-value-at-for-ruleset source-layer ruleset :center x y))
      []))

(defun empty-derived-tiles []
  (dotimes [y data/map-height]
    (data/make-empty-row)))

(defun all-map-positions []
  (apply concat
         (dotimes [y data/map-height]
           (dotimes [x data/map-width]
             {:x x
              :y y}))))

(defun in-map-bounds? [x y]
  (and (>= x 0)
       (< x data/map-width)
       (>= y 0)
       (< y data/map-height)))

(defun stamp-output-layer-matches? [definition output-layer]
  (= (:target-layer output-layer) (:id definition)))

(defun stamp-tile [tiles x y tile]
  (if (and tile (in-map-bounds? x y))
    (:tiles (assoc-in {:tiles tiles} [:tiles y x] tile))
    tiles))

(defun stamp-cell [cells x y value]
  (if (and (in-map-bounds? x y)
           (not (nil? value)))
    (:cells (assoc-in {:cells cells} [:cells y x] value))
    cells))

(defun output-layer-tile-entries [output-layer]
  (apply concat
         (for-indexed [tile-y row (or (:tiles output-layer) [])]
           (for-indexed [tile-x tile (or row [])]
             {:x tile-x
              :y tile-y
              :tile tile}))))

(defun output-anchor [output]
  (or (:anchor output) {:x 0 :y 0}))

(defun output-layer-anchor-entry [output output-layer]
  (let [anchor (output-anchor output)]
    {:x (:x anchor)
     :y (:y anchor)
     :tile (nth (or (nth (or (:tiles output-layer) []) (:y anchor)) [])
                (:x anchor))}))

(defun terrain-stamp-output-entries [ruleset output output-layer]
  (if (terrain-unit-single-cell? ruleset)
    [(output-layer-anchor-entry output output-layer)]
    (output-layer-tile-entries output-layer)))

(defun terrain-stamp-output-entry-occupies-source? [ruleset entry]
  (if (or (:tile entry)
          (not (terrain-unit-single-cell? ruleset)))
    true
    false))

(defun apply-stamp-output-entry [tiles source-x source-y output entry]
  (let [pos (stamp-output-position source-x source-y output entry)]
    (stamp-tile tiles (:x pos) (:y pos) (:tile entry))))

(defun apply-stamp-source-mask-entry [source-mask ruleset source-x source-y output entry]
  (let [pos (stamp-output-position source-x source-y output entry)]
    (stamp-cell source-mask
                (:x pos)
                (:y pos)
                (terrain-stamp-output-entry-occupies-source? ruleset entry))))

(defun apply-stamp-output-layer [tiles ruleset source-x source-y output output-layer]
  (reduce (terrain-stamp-output-entries ruleset output output-layer)
          tiles
          (fn [tiles entry]
            (apply-stamp-output-entry tiles source-x source-y output entry))))

(defun apply-stamp-source-mask-layer [source-mask ruleset source-x source-y output output-layer]
  (reduce (terrain-stamp-output-entries ruleset output output-layer)
          source-mask
          (fn [next-source-mask entry]
            (apply-stamp-source-mask-entry next-source-mask
                                           ruleset
                                           source-x
                                           source-y
                                           output
                                           entry))))

(defun terrain-stamp-rule-exclusive? [rule]
  (= (:exclusive? rule) true))

(defun solid-terrain-signature [terrain-id]
  (reduce terrain-signature-directions
          {}
          (fn [result direction]
            (assoc result direction terrain-id))))

(defun match-condition-signature-value [center-terrain-id condition]
  (case condition
    :same center-terrain-id
    :none :none
    :default
    (if (= (type-of condition) "map")
      (:terrain condition)
      nil)))

(defun default-terrain-signature-for-rule [rule]
  (let [center-terrain-id (terrain-match-center rule)]
    (reduce-kv (or (:match rule) {})
               (solid-terrain-signature center-terrain-id)
               (fn [signature direction condition]
                 (if-let [value (match-condition-signature-value
                                  center-terrain-id
                                  condition)]
                   (assoc signature direction value)
                   (if (or (= condition :not-same)
                           (= condition :other-terrain)
                           (= condition :any-terrain))
                     (dissoc signature direction)
                     signature))))))

(defun source-terrain-signature-row [source-layer y]
  (dotimes [x data/map-width]
    (let [terrain (cell-at source-layer x y)]
      (if terrain
        (solid-terrain-signature terrain)
        nil))))

(defun source-terrain-signatures [source-layer]
  (dotimes [y data/map-height]
    (source-terrain-signature-row source-layer y)))

(defun terrain-stamp-rule-output-signature [rule output-layer entry]
  (or (output-layer-terrain-signature-at output-layer
                                         (:x entry)
                                         (:y entry))
      (default-terrain-signature-for-rule rule)))

(defun terrain-stamp-signature-output-layer-matches? [definition output-layer]
  (if definition
    (stamp-output-layer-matches? definition output-layer)
    true))

(defun apply-terrain-stamp-rule-output-signature [signatures definition ruleset rule x y]
  (reduce (or (-> rule :output :layers) [])
          signatures
          (fn [next-signatures output-layer]
            (if (terrain-stamp-signature-output-layer-matches? definition
                                                               output-layer)
              (reduce (terrain-stamp-output-entries ruleset
                                                    (:output rule)
                                                    output-layer)
                      next-signatures
                      (fn [next-signatures entry]
                        (let [pos (stamp-output-position x y (:output rule) entry)]
                          (if (and (terrain-stamp-output-entry-occupies-source?
                                    ruleset
                                    entry)
                                   (in-map-bounds? (:x pos) (:y pos)))
                            (:terrain-signatures-by-position
                             (assoc-in
                              {:terrain-signatures-by-position next-signatures}
                              [:terrain-signatures-by-position (:y pos) (:x pos)]
                              (terrain-stamp-rule-output-signature rule
                                                                   output-layer
                                                                   entry)))
                            next-signatures))))
              next-signatures))))

(defun apply-terrain-stamp-rule-signatures-at-position
  [signatures definition source-layer ruleset x y]
  (let [rules (terrain-stamp-candidate-rules source-layer ruleset x y)]
    (:terrain-signatures
     (reduce rules
             {:terrain-signatures signatures
              :done? false}
             (fn [result rule]
               (if (:done? result)
                 result
                 (if (terrain-stamp-rule-matches-for-ruleset?
                      source-layer
                      ruleset
                      rule
                      x
                      y)
                   {:terrain-signatures
                    (apply-terrain-stamp-rule-output-signature
                     (:terrain-signatures result)
                     definition
                     ruleset
                     rule
                     x
                     y)
                    :done? (terrain-stamp-rule-exclusive? rule)}
                   result)))))))

(defun terrain-stamp-effective-source-layer-for-positions
  [source-layer definition ruleset positions]
  (assoc source-layer
         :data-kind :terrain-signature
         :terrain-signature-default :terrain-id
         :terrain-signatures-by-position
         (reduce (or positions [])
                 {}
                 (fn [signatures pos]
                   (apply-terrain-stamp-rule-signatures-at-position
                    signatures
                    definition
                    source-layer
                    ruleset
                    (:x pos)
                    (:y pos))))))

(defun terrain-stamp-effective-source-layer [source-layer definition ruleset]
  (terrain-stamp-effective-source-layer-for-positions source-layer
                                                      definition
                                                      ruleset
                                                      (all-map-positions)))

(defun apply-terrain-stamp-rule-output [tiles definition ruleset rule x y]
  (reduce (or (-> rule :output :layers) [])
          tiles
          (fn [next-tiles output-layer]
            (if (stamp-output-layer-matches? definition output-layer)
              (apply-stamp-output-layer next-tiles
                                        ruleset
                                        x
                                        y
                                        (:output rule)
                                        output-layer)
              next-tiles))))

(defun apply-terrain-stamp-rule-source-mask [source-mask definition ruleset rule x y]
  (reduce (or (-> rule :output :layers) [])
          source-mask
          (fn [next-source-mask output-layer]
            (if (stamp-output-layer-matches? definition output-layer)
              (apply-stamp-source-mask-layer next-source-mask
                                             ruleset
                                             x
                                             y
                                             (:output rule)
                                             output-layer)
              next-source-mask))))

(defun apply-terrain-stamp-rules-at-position
  [tiles definition source-layer ruleset x y]
  (let [rules (terrain-stamp-candidate-rules source-layer ruleset x y)]
    (:tiles
     (reduce rules
             {:tiles tiles
              :done? false}
             (fn [result rule]
               (if (:done? result)
                 result
                 (if (terrain-stamp-rule-matches-for-ruleset?
                      source-layer
                      ruleset
                      rule
                      x
                      y)
                   {:tiles (apply-terrain-stamp-rule-output (:tiles result)
                                                            definition
                                                            ruleset
                                                            rule
                                                            x
                                                            y)
                    :done? (terrain-stamp-rule-exclusive? rule)}
                   result)))))))

(defun apply-terrain-stamp-source-mask-at-position
  [source-mask definition source-layer ruleset x y]
  (let [rules (terrain-stamp-candidate-rules source-layer ruleset x y)]
    (:source-mask
     (reduce rules
             {:source-mask source-mask
              :done? false}
             (fn [result rule]
               (if (:done? result)
                 result
                 (if (terrain-stamp-rule-matches-for-ruleset?
                      source-layer
                      ruleset
                      rule
                      x
                      y)
                   {:source-mask
                    (apply-terrain-stamp-rule-source-mask (:source-mask result)
                                                          definition
                                                          ruleset
                                                          rule
                                                          x
                                                          y)
                    :done? (terrain-stamp-rule-exclusive? rule)}
                   result)))))))

(defun derive-terrain-stamp-tiles [source-layer definition ruleset]
  (let [ruleset (terrain-stamp-index-ruleset ruleset)
        positions (all-map-positions)
        effective-source-layer (terrain-stamp-effective-source-layer-for-positions
                                source-layer
                                definition
                                ruleset
                                positions)]
    (reduce positions
            (empty-derived-tiles)
            (fn [tiles pos]
              (apply-terrain-stamp-rules-at-position tiles
                                                     definition
                                                     effective-source-layer
                                                     ruleset
                                                     (:x pos)
                                                     (:y pos))))))

(defun derive-terrain-stamp-source-mask [source-layer definition ruleset]
  (let [ruleset (terrain-stamp-index-ruleset ruleset)
        positions (all-map-positions)
        effective-source-layer (terrain-stamp-effective-source-layer-for-positions
                                source-layer
                                definition
                                ruleset
                                positions)]
    (reduce positions
            (data/make-empty-map)
            (fn [source-mask pos]
              (apply-terrain-stamp-source-mask-at-position source-mask
                                                           definition
                                                           effective-source-layer
                                                           ruleset
                                                           (:x pos)
                                                           (:y pos))))))

(defun terrain-stamp-output-layer [definition ruleset]
  (head (apply concat
               (map (or (:rules ruleset) [])
                    (fn [rule]
                      (filter (or (-> rule :output :layers) [])
                              (fn [output-layer]
                                (stamp-output-layer-matches?
                                 definition
                                 output-layer))))))))

(defun id-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun targetless-terrain-stamp-output-layer-key [source-layer ruleset output-layer]
  (keyword (str (id-label (or (:id source-layer) source-layer))
                "/"
                (id-label (:id ruleset))
                "/"
                (id-label (or (:id output-layer)
                              (:tileset output-layer)
                              (:output-tileset ruleset)
                              "output")))))

(defun terrain-stamp-output-layer-key [source-layer ruleset output-layer]
  (or (:target-layer output-layer)
      (targetless-terrain-stamp-output-layer-key source-layer
                                                 ruleset
                                                 output-layer)))

(defun output-layer-terrain-signatures [output-layer]
  (or (:terrain-signatures output-layer)
      [[nil nil nil]
       [nil nil nil]
       [nil nil nil]]))

(defun output-layer-terrain-signature-at [output-layer x y]
  (nth (or (nth (output-layer-terrain-signatures output-layer) y) []) x))

(defun stamp-output-position [source-x source-y output entry]
  (let [anchor (output-anchor output)]
    {:x (+ source-x (:x entry) (- (:x anchor)))
     :y (+ source-y (:y entry) (- (:y anchor)))}))

(defun stamp-output-patch-cell
  [source-x source-y output entry tile terrain-signature source-mask?]
  (let [pos (stamp-output-position source-x source-y output entry)]
    {:x (:x pos)
     :y (:y pos)
     :tile tile
     :terrain-signature terrain-signature
     :source-mask? source-mask?}))

(defun stamp-output-patch-cells
  [source-x source-y ruleset output output-layer tile-fn signature-fn source-mask-fn]
  (filter (map (terrain-stamp-output-entries ruleset output output-layer)
               (fn [entry]
                 (when (terrain-stamp-output-entry-occupies-source? ruleset entry)
                   (stamp-output-patch-cell source-x
                                            source-y
                                            output
                                            entry
                                            (tile-fn entry)
                                            (signature-fn entry)
                                            (source-mask-fn entry)))))
          (fn [cell]
            (and cell
                 (in-map-bounds? (:x cell) (:y cell))))))

(defun terrain-stamp-output-patch
  [source-layer ruleset rule source-x source-y output-layer tile-fn signature-fn source-mask-fn]
  (let [cells (stamp-output-patch-cells source-x
                                        source-y
                                        ruleset
                                        (:output rule)
                                        output-layer
                                        tile-fn
                                        signature-fn
                                        source-mask-fn)]
    (when (not (empty? cells))
      {:source-layer (:id source-layer)
       :source-position {:x source-x :y source-y}
       :ruleset (:id ruleset)
       :rule (:id rule)
       :output-layer (assoc (dissoc output-layer :tiles)
                            :id (terrain-stamp-output-layer-key source-layer
                                                                ruleset
                                                                output-layer))
       :cells cells})))

(defun terrain-stamp-rule-patches-with [source-layer ruleset rule source-x source-y tile-fn]
  (filter (map (or (-> rule :output :layers) [])
               (fn [output-layer]
                 (terrain-stamp-output-patch source-layer
                                             ruleset
                                             rule
                                             source-x
                                             source-y
                                             output-layer
                                             tile-fn
                                             (fn [entry] nil)
                                             (fn [entry] false))))
          (fn [patch]
            (not (nil? patch)))))

(defun terrain-stamp-matching-rule-apply-patches [source-layer ruleset rule source-x source-y]
  (filter (map (or (-> rule :output :layers) [])
               (fn [output-layer]
                 (terrain-stamp-output-patch
                  source-layer
                  ruleset
                  rule
                  source-x
                  source-y
                  output-layer
                  (fn [entry] (:tile entry))
                  (fn [entry]
                    (or (output-layer-terrain-signature-at output-layer
                                                           (:x entry)
                                                           (:y entry))
                        (default-terrain-signature-for-rule rule)))
                  (fn [entry] true))))
          (fn [patch]
            (not (nil? patch)))))

(defun terrain-stamp-rule-clear-patches [source-layer ruleset rule source-x source-y]
  (terrain-stamp-rule-patches-with source-layer
                                   ruleset
                                   rule
                                   source-x
                                   source-y
                                   (fn [entry] nil)))

(defun terrain-stamp-apply-patches-at [source-layer ruleset source-x source-y]
  (let [rules (terrain-stamp-candidate-rules source-layer
                                             ruleset
                                             source-x
                                             source-y)]
    (:patches
     (reduce rules
             {:patches []
              :done? false}
             (fn [result rule]
               (if (:done? result)
                 result
                 (if (terrain-stamp-rule-matches-for-ruleset?
                      source-layer
                      ruleset
                      rule
                      source-x
                      source-y)
                   {:patches (concat (:patches result)
                                     (terrain-stamp-matching-rule-apply-patches
                                      source-layer
                                      ruleset
                                      rule
                                      source-x
                                      source-y))
                    :done? (terrain-stamp-rule-exclusive? rule)}
                   result)))))))

(defun terrain-stamp-clear-patches-at [source-layer ruleset source-x source-y]
  (let [unit (data/terrain-unit ruleset)]
    (if (terrain-unit-anchor-position? unit source-x source-y)
      (apply concat
             (map (or (:rules ruleset) [])
                  (fn [rule]
                    (terrain-stamp-rule-clear-patches source-layer
                                                      ruleset
                                                      rule
                                                      source-x
                                                      source-y))))
      [])))

(defun terrain-stamp-apply-patches-for-positions [source-layer ruleset positions]
  (apply concat
         (map (or positions [])
              (fn [pos]
                (terrain-stamp-apply-patches-at source-layer
                                                ruleset
                                                (:x pos)
                                                (:y pos))))))

(defun terrain-stamp-clear-patches-for-positions [source-layer ruleset positions]
  (apply concat
         (map (or positions [])
              (fn [pos]
                (terrain-stamp-clear-patches-at source-layer
                                                ruleset
                                                (:x pos)
                                                (:y pos))))))

(defun derive-terrain-stamp-layer [tilemap definition ruleset]
  (let [source-layer (or (layer-by-id (:layers tilemap)
                                      (or (:source-layer ruleset)
                                          (head (:source-layers definition))))
                         (terrain-source-layer-for-ruleset (:layers tilemap)
                                                           ruleset))
        ruleset (assoc ruleset
                       :terrain-unit
                       (data/terrain-unit-for-set
                        (:terrain-sets tilemap)
                        (or (:terrain-set source-layer)
                            (:terrain-set ruleset))))
        output-layer (terrain-stamp-output-layer definition ruleset)]
    (if source-layer
      (assoc (derived-layer-base definition ruleset)
             :tileset (or (:tileset definition)
                          (:tileset output-layer)
                          (:output-tileset ruleset))
             :replaces-source? true
             :tiles (derive-terrain-stamp-tiles source-layer
                                                definition
                                                ruleset)
             :source-mask (derive-terrain-stamp-source-mask source-layer
                                                            definition
                                                            ruleset))
      nil)))

(defun derive-layer [tilemap layer-profile rulesets derived-layer-id]
  (let [definition (layer-by-id (:layers layer-profile) derived-layer-id)
        ruleset (ruleset-by-id rulesets (:ruleset definition))]
    (case (:kind definition)
      :marching-4 (derive-marching-4-layer tilemap definition ruleset)
      :terrain-stamp (derive-terrain-stamp-layer tilemap definition ruleset)
      :default nil)))

(defun layer-in-profile? [profile layer]
  (not (nil? (layer-by-id (:layers profile) (:id layer)))))

(defun profile-source-render-layer [tilemap definition]
  (layer-by-id (:layers tilemap) (:id definition)))

(defun profile-derived-render-layer [tilemap profile rulesets definition]
  (or (when (= (:persistence definition) :materialized)
        (layer-by-id (:layers tilemap) (:id definition)))
      (derive-layer tilemap profile rulesets (:id definition))))

(defun profile-render-layer [tilemap profile rulesets definition]
  (if (= (:role definition) :derived)
    (profile-derived-render-layer tilemap profile rulesets definition)
    (profile-source-render-layer tilemap definition)))

(defun render-layers-from-profile [tilemap profile rulesets]
  (filter (map (or (:layers profile) [])
               (fn [definition]
                 (profile-render-layer tilemap profile rulesets definition)))
          (fn [layer]
            (not (nil? layer)))))

(defun unprofiled-render-layers [tilemap profile]
  (filter (or (:layers tilemap) [])
          (fn [layer]
            (not (layer-in-profile? profile layer)))))

(defun stamp-layer-applies-to-source? [stamp-layer source-layer]
  (contains? (or (:source-layers stamp-layer) [])
             (:id source-layer)))

(defun append-stamp-layers-after-source [state source-layer stamp-layers]
  (let [rendered-stamp-ids (or (:rendered-stamp-ids state) [])
        matching-stamp-layers
        (filter (or stamp-layers [])
                (fn [stamp-layer]
                  (and (stamp-layer-applies-to-source? stamp-layer source-layer)
                       (not (contains? rendered-stamp-ids
                                       (:id stamp-layer))))))]
    {:layers (concat (:layers state)
                     [source-layer]
                     matching-stamp-layers)
     :rendered-stamp-ids (concat rendered-stamp-ids
                                 (map matching-stamp-layers :id))}))

(defun interleave-stamp-layers-after-sources [layers stamp-layers]
  (let [state (reduce (or layers [])
                      {:layers []
                       :rendered-stamp-ids []}
                      (fn [state layer]
                        (append-stamp-layers-after-source state
                                                          layer
                                                          stamp-layers)))
        remaining-stamp-layers
        (filter (or stamp-layers [])
                (fn [stamp-layer]
                  (not (contains? (:rendered-stamp-ids state)
                                  (:id stamp-layer)))))]
    (concat (:layers state) remaining-stamp-layers)))

(defun replacement-layer-source-ids [layer]
  (or (:terrain-stamp-source-layers layer)
      (if (:replaces-source? layer)
        (:source-layers layer)
        [])))

(defun replacement-layer-for-source? [source-layer layer]
  (and (:replaces-source? layer)
       (contains? (or (replacement-layer-source-ids layer) [])
                  (:id source-layer))))

(defun replacement-cell? [source-layer replacement-layers x y]
  (> (count (filter replacement-layers
                    (fn [layer]
                      (and (replacement-layer-for-source? source-layer layer)
                           (or (not (nil? (cell-at layer x y)))
                               (not (nil? (get-in layer
                                                   [:source-mask y x]))))))))
     0))

(defun mask-source-row-with-replacements [source-layer replacement-layers y row]
  (for-indexed [x tile-ref (or row [])]
    (if (replacement-cell? source-layer replacement-layers x y)
      nil
      tile-ref)))

(defun mask-source-layer-with-replacements [replacement-layers layer]
  (if (= (:data-kind layer) :terrain)
    (assoc layer
           :tiles (for-indexed [y row (or (:tiles layer) [])]
                    (mask-source-row-with-replacements layer
                                                       replacement-layers
                                                       y
                                                       row)))
    layer))

(defun mask-source-layers-with-replacements [layers replacement-layers]
  (map layers
       (fn [layer]
         (mask-source-layer-with-replacements replacement-layers layer))))

(defun render-layers [tilemap layer-profile rulesets]
  (let [profile (or layer-profile {:layers []})
        profile-layers (render-layers-from-profile tilemap profile rulesets)
        show-rules? (not= (:show-terrain-rules? tilemap) false)
        stamp-layers (if show-rules?
                       (or (:terrain-stamp-layers tilemap) [])
                       [])
        replacement-layers (if show-rules?
                             (concat (or (:terrain-stamp-replacements tilemap) [])
                                     stamp-layers)
                             [])
        layers (interleave-stamp-layers-after-sources
                (if (empty? profile-layers)
                  (or (:layers tilemap) [])
                  (concat profile-layers
                          (unprofiled-render-layers tilemap profile)))
                stamp-layers)]
    (mask-source-layers-with-replacements
     layers
     replacement-layers)))
