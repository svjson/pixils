(ns tilemap-editor.view.resources.panels
  (:require pixils
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            tilemap-editor.view.resources.model))

(def resource-list-row-height 24)

(def image-preview-width 328)

(def image-preview-height 260)

(def resource-drag-preview-width 360)

(def bundle-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Edit"
            :action :resource/context-dummy
            :payload {:kind :bundle
                      :command :edit}}
           {:label "Delete"
            :action :resource/context-dummy
            :payload {:kind :bundle
                      :command :delete}}]})

(defun image-resource-context-menu [resource-ids]
  (let [edit-disabled? (not= (count (or resource-ids [])) 1)]
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Edit"
            :disabled? edit-disabled?
            :action :resource/context-dummy
            :payload {:kind :image
                      :resource-ids resource-ids
                      :command :edit}}
           {:label "Replace"
            :disabled? edit-disabled?
            :action :resource/context-dummy
            :payload {:kind :image
                      :resource-ids resource-ids
                      :command :replace}}
           {:label "Delete"
            :action :resource/context-dummy
            :payload {:kind :image
                      :resource-ids resource-ids
                      :command :delete}}]}))

(defun image-resource-context-resource-ids [state]
  (if (and (contains? (:selected-indices state) (:index state))
           (> (count (or (:selected-image-resources state) [])) 1))
    (:selected-image-resources state)
    [(:value state)]))

(defun image-resource-drag-size [ctx]
  (let [bounds (-> ctx :view :bounds)]
    {:width (or (:w bounds) resource-drag-preview-width)
     :height (or (:h bounds) resource-list-row-height)}))

(defun image-resource-drag-payload [state event ctx]
  {:kind :resource/image
   :bundle-id (:bundle-id state)
   :resource-id (:value state)
   :key-label (:key-label state)
   :name (:name state)
   :width (:width (image-resource-drag-size ctx))
   :height (:height (image-resource-drag-size ctx))
   :offset (:start-position event)})

(defun point-minus [position offset]
  (let [pos (or position {:x 0 :y 0})
        off (or offset {:x 0 :y 0})]
    {:x (- (:x pos) (:x off))
     :y (- (:y pos) (:y off))}))

(defun image-resource-drag-position [event payload]
  (point-minus (:global-position event) (:offset payload)))

(defun emit-image-resource-drag-start! [state event ctx]
  (let [payload (:payload event)]
    (do
      (ui/emit! (:view ctx)
                :resource/image-drag-start
                (assoc payload
                       :position (image-resource-drag-position event
                                                               payload)))
      state)))

(defun emit-image-resource-drag-move! [state event ctx]
  (let [payload (:payload event)]
    (do
      (ui/emit! (:view ctx)
                :resource/image-drag-move
                (assoc payload
                       :position (image-resource-drag-position event
                                                               payload)))
      state)))

(defun emit-image-resource-drag-end! [state event ctx]
  (do
    (ui/emit! (:view ctx) :resource/image-drag-end nil)
    state))

(defun image-resource-drop-payload [target-bundle-id payload]
  (when (= (:kind payload) :resource/image)
    {:source-bundle-id (:bundle-id payload)
     :resource-id (:resource-id payload)
     :target-bundle-id target-bundle-id}))

(defcomponent image-resource-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height resource-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :drag {:start {:mode :threshold
                  :distance 3}
          :payload (fn [state event ctx]
                     (image-resource-drag-payload state event ctx))}
   :on-drag-start emit-image-resource-drag-start!
   :on-drag emit-image-resource-drag-move!
   :on-drag-end emit-image-resource-drag-end!
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (if (= (:button event) :right)
                    (let [resource-ids
                          (image-resource-context-resource-ids state)]
                      (do
                        (ui/stop-propagation! event)
                        (menu/open-context-menu!
                         (image-resource-context-menu resource-ids)
                         (:global-position event)
                         state
                         ctx)
                        state))
                    state))
   :on-click (fn [state event ctx]
               (if (= (:button event) :right)
                 (do
                   (ui/stop-propagation! event)
                   state)
                 (do
                   (when (not (:disabled? state))
                     (ui/emit! (:view ctx)
                               :list-box/item-click
                               {:index (:index state)
                                :value (:value state)
                                :shift? (lb/held-shift? ctx)
                                :ctrl? (lb/held-ctrl? ctx)}))
                   state)))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :resource/context-command
                                       {:kind :image
                                        :bundle-id (:bundle-id state)
                                        :resource-id (:value state)
                                        :resource-ids
                                        (-> payload :payload :resource-ids)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :key-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value (ui/bind-state :name)}}]})

(defun image-resource-row-child [index option]
  {:mode 'image-resource-row
   :state {:index index
           :value (:value option)
           :bundle-id (:bundle-id option)
           :key-label (:key-label option)
           :name (:name option)
           :selected-indices (ui/bind-state :selected-indices)
           :selected-image-resources
           (ui/bind-state :selected-image-resources)}})

(defcomponent resource-bundle-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height resource-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-drop (fn [state event ctx]
              (let [payload (image-resource-drop-payload (:value state)
                                                         (:payload event))]
                (if payload
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :resource/move-image-to-bundle
                              payload)
                    state)
                  state)))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (menu/open-context-menu! bundle-context-menu
                                               (:global-position event)
                                               state
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :resource/context-command
                                       {:kind :bundle
                                        :bundle-id (:value state)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun resource-bundle-row-child [index option]
  {:mode 'resource-bundle-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun bundle-list-child [resources]
  (let [bundles (dynamic-project-bundle-entries resources)]
    (lb/make {:options (bundle-options resources)
              :style {:width :fill
                      :height :fill}
              :row-height resource-list-row-height
              :visible-rows (max 1 (count bundles))
              :content-width 180
              :disabled? (empty? bundles)
              :selected-indices (ui/bind-state :selected-indices)
              :force-selection? true
              :item-child resource-bundle-row-child})))

(defcomponent resource-bundle-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :bundles nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [resources (:resources state)
                   bundles (project-bundle-entries resources)
                   selected-indices (selected-bundle-indices
                                     resources
                                     (:selected-resource-bundle state))]
               (do
                 (when (not= bundles (:bundles state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (bundle-list-child resources))))
                 (assoc state
                        :bundles bundles
                        :selected-indices selected-indices))))
   :on {:list-box/change (fn [state event ctx]
                           (let [bundle-id (-> event :payload :value)]
                             (assoc state
                                    :selected-resource-bundle bundle-id
                                    :selected-image-resource
                                    (first-image-resource-id (:resources state)
                                                             bundle-id)
                                    :selected-image-resources
                                    (if-let [image-id
                                             (first-image-resource-id
                                              (:resources state)
                                              bundle-id)]
                                      [image-id]
                                      []))))}
   :children [(merge {:id "list-box"}
                     (bundle-list-child {}))]})

(defun image-preview-rect [dim]
  (let [scale (min (/ image-preview-width (:w dim))
                   (/ image-preview-height (:h dim)))
        width (* (:w dim) scale)
        height (* (:h dim) scale)]
    {:x (/ (- image-preview-width width) 2)
     :y (/ (- image-preview-height height) 2)
     :scale scale}))

(defun image-resource-list-child [resources]
  (let [resources (or resources [])]
    (lb/make {:options (image-resource-options resources)
              :style {:width :fill
                      :height :fill}
              :row-height resource-list-row-height
              :visible-rows (max 1 (count resources))
              :content-width 360
              :disabled? (empty? resources)
              :selected-indices (ui/bind-state :selected-indices)
              :multi-select? true
              :force-selection? true
              :state {:selected-image-resources (ui/bind-state
                                                 :selected-image-resources)}
              :item-state-keys [:selected-image-resources]
              :item-child image-resource-row-child})))

(defcomponent image-resource-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :image-resources nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [resources (project-image-resources (:resources state)
                                                      (:selected-resource-bundle state))
                   selected-indices (selected-resource-indices-by-ids
                                     resources
                                     (:selected-image-resources state))]
               (do
                 (when (not= resources (:image-resources state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (image-resource-list-child resources))))
                 (assoc state
                        :image-resources resources
                        :selected-indices selected-indices))))
   :on {:list-box/change (fn [state event ctx]
                           (let [selected (-> event
                                              :payload
                                              :selected-values)]
                             (assoc state
                                    :selected-image-resources selected
                                    :selected-image-resource
                                    (single-selected-image-resource-id
                                     selected))))}
   :children [(merge {:id "list-box"}
                     (image-resource-list-child []))]})

(defcomponent image-resource-drag-preview
  {:class [:ui/list-item :ui/list-box-item :ui/list-item-hover]
   :style {:position :absolute
           :width resource-drag-preview-width
           :height resource-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}
           :hit-test false
           :hidden true}
   :update (fn [state ctx]
             (let [preview (:drag-preview state)
                   position (:position preview)
                   visible? (not (nil? preview))]
               (do
                 (ui/style! (:view ctx)
                            (if visible?
                              {:hidden false
                               :left (:x position)
                               :top (:y position)
                               :width (or (:width preview)
                                          resource-drag-preview-width)
                               :height (or (:height preview)
                                           resource-list-row-height)}
                              {:hidden true}))
                 (assoc state
                        :selected true
                        :key-label (or (:key-label preview) "")
                        :name (or (:name preview) "")))))
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :key-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value (ui/bind-state :name)}}]})

(defcomponent image-resource-detail
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [resource (selected-resource (project-image-resources
                                                (:resources state)
                                                (:selected-resource-bundle state))
                                               (:selected-image-resource state))
                   project-directory (effective-project-directory state)]
               (assoc state
                      :resource resource
                      :edit-disabled? (nil? resource)
                      :key-label (if resource (str (:key resource)) "")
                      :name-label (or (:name resource) "")
                      :file-label (project-relative-file-label
                                   (:file-name resource)
                                   project-directory)
                      :transparency-color-label
                      (or (:transparency-color resource) ""))))
   :children [{:mode 'ui/button
               :class :ui/toolbar-button
               :style {:width :shrink
                       :height 20}
               :state {:label "Edit"
                       :disabled? (ui/bind-state :edit-disabled?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource/edit-image)
                             state))}
              {:mode 'ui/button
               :class :ui/toolbar-button
               :style {:width :shrink
                       :height 20}
               :state {:label "Replace"
                       :disabled? (ui/bind-state :edit-disabled?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource/replace-image)
                             state))}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Key"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :key-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Name"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :name-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "File"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :file-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Transparency color"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :transparency-color-label)}}
              {:mode 'image-resource-preview
               :state {:bundle-id (ui/bind-state :selected-resource-bundle)
                       :image-id (ui/bind-state :selected-image-resource)}}]})

(defcomponent image-resource-preview
  {:class :ui/content
   :style {:width image-preview-width
           :height image-preview-height}
   :render (fn [state ctx]
             (let [image (when (and (:bundle-id state) (:image-id state))
                           (image-resource-key (:bundle-id state) (:image-id state)))
                   dim (when image (img/size image))]
               (do
                 (r/rect! {:x 0 :y 0
                           :w image-preview-width
                           :h image-preview-height}
                          {:fill true
                           :color {:r 0x12 :g 0x15 :b 0x18}})
                 (when dim
                   (let [rect (image-preview-rect dim)]
                     (r/image! image
                               {:pos {:x (:x rect)
                                      :y (:y rect)}
                                :scale (:scale rect)})))
                         (r/rect! {:x 0 :y 0
                                   :w image-preview-width
                                   :h image-preview-height}
                                  {:color {:r 0x00 :g 0x00 :b 0x00}}))))})

(defun make-resource-bundle-list-panel []
  (hp/make {:title "Bundles"
            :style {:width 220
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :resource/add-bundle)
                                             state))}]
            :state {:resources (ui/bind-state :resources)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)}
            :children [{:mode 'resource-bundle-list
                        :state {:resources (ui/bind-state :resources)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)}}]}))

(defun make-image-resource-list-panel []
  (hp/make {:title "Images"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"
                                       :disabled? (ui/bind-state
                                                   :image-resource-add-disabled?)}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :resource/add-image)
                                             state))}
                              ]
            :state {:resources (ui/bind-state :resources)
                    :project-path (ui/bind-state :project-path)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)
                    :selected-image-resources
                    (ui/bind-state :selected-image-resources)
                    :disabled? (ui/bind-state :image-resource-panel-disabled?)
                    :image-resource-add-disabled? (ui/bind-state
                                                   :image-resource-add-disabled?)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)
                         :selected-image-resources
                         (ui/bind-state :selected-image-resources)}
            :children [{:mode 'image-resource-list
                        :state {:resources (ui/bind-state :resources)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)
                                :selected-image-resources
                                (ui/bind-state :selected-image-resources)}}]}))

(defun make-image-resource-detail-panel []
  (hp/make {:title "Resource"
            :style {:width 360
                    :height :fill}
            :state {:resources (ui/bind-state :resources)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)
                    :selected-image-resources
                    (ui/bind-state :selected-image-resources)
                    :disabled? (ui/bind-state :image-resource-detail-disabled?)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :project-path (ui/bind-state :project-path)
                         :project-directory (ui/bind-state :project-directory)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)
                         :selected-image-resources
                         (ui/bind-state :selected-image-resources)}
            :children [{:mode 'image-resource-detail
                        :state {:resources (ui/bind-state :resources)
                                :project-path
                                (ui/bind-state :project-path)
                                :project-directory
                                (ui/bind-state :project-directory)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)
                                :selected-image-resources
                                (ui/bind-state :selected-image-resources)}}]}))
