(ns tilemap-editor.view.resources.layout
  (:require pixils
            [lisple.io :as io]
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.ui :as ui]
            [pixils.ui.file-dialog :as file-dialog]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            pixils.ui.text-input
            [pixils.ui.window :as w]))

(def resource-list-row-height 24)
(def image-preview-width 328)
(def image-preview-height 260)

(def image-file-filters
  [{:label "Image files (*.png, *.jpg, *.jpeg, *.bmp)"
    :extensions [".png" ".jpg" ".jpeg" ".bmp"]}
   {:label "All files (*)"
    :extensions []}])

(defun file-stem [path]
  (let [name (io/basename path)
        extension (io/extension name)]
    (if (blank? extension)
      name
      (substr name 0 (- (count name) (count extension))))))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun image-resource-key [bundle-id resource-id]
  (keyword (str (keyword-label bundle-id)
                "/"
                (keyword-label resource-id))))

(defun project-bundle-entries [resources]
  (let [bundles (or (:bundles resources) {})]
    (map (keys bundles)
         (fn [bundle-id]
           {:id bundle-id
            :bundle (get bundles bundle-id)}))))

(defun dynamic-bundle-entry? [entry]
  (not= (-> entry :bundle :dynamic?) false))

(defun dynamic-project-bundle-entries [resources]
  (filter (project-bundle-entries resources) dynamic-bundle-entry?))

(defun bundle-options [resources]
  (map (dynamic-project-bundle-entries resources)
       (fn [entry]
         {:value (:id entry)
          :label (keyword-label (:id entry))})))

(defun selected-bundle-index [resources selected-id]
  (when selected-id
    (find-index (dynamic-project-bundle-entries resources)
                (fn [entry]
                  (= (:id entry) selected-id)))))

(defun selected-bundle-indices [resources selected-id]
  (if-let [index (selected-bundle-index resources selected-id)]
    [index]
    []))

(defun add-resource-bundle! [state payload]
  (let [bundle-id (keyword (:bundle-id payload))]
    (do
      (res/create-bundle! bundle-id)
      (assoc (assoc-in state
                       [:resources :bundles bundle-id]
                       (merge {:images {}}
                              (or (get-in state
                                          [:resources :bundles bundle-id])
                                  {})))
             :selected-resource-bundle bundle-id
             :selected-image-resource nil))))

(defun open-resource-bundle-dialog! [state ctx]
  (do
    (push-mode! 'resource-bundle-dialog-modal
                {:title "New Resource Bundle"
                 :bundle-id ""}
                {:origin {:view (:view ctx)
                          :event :resource/bundle-dialog-result}})
    state))

(defun bundle-images [resources bundle-id]
  (or (get-in resources [:bundles bundle-id :images]) {}))

(defun project-image-resource-entries [resources bundle-id]
  (let [images (bundle-images resources bundle-id)]
    (map (keys images)
         (fn [resource-id]
           {:id resource-id
            :bundle-id bundle-id
            :dependency (get images resource-id)}))))

(defun first-image-resource-id [resources bundle-id]
  (if-let [entry (head (project-image-resource-entries resources bundle-id))]
    (:id entry)
    nil))

(defun runtime-image-dependency [dependency]
  (select-keys (or dependency {}) [:file-name :transparency-color]))

(defun project-image-resources [resources bundle-id]
  (map (project-image-resource-entries resources bundle-id)
       (fn [entry]
         (let [id (:id entry)
               dependency (:dependency entry)]
           {:id id
            :bundle-id bundle-id
            :key (image-resource-key bundle-id id)
            :name (or (:name dependency)
                      (keyword-label id))
            :file-name (:file-name dependency)}))))

(defun runtime-bundle-dependencies [bundle]
  {:images (reduce-kv (or (:images bundle) {})
                      {}
                      (fn [result image-id dependency]
                        (assoc result image-id (runtime-image-dependency dependency))))})

(defun sync-project-resources! [resources]
  (do
    (for [entry (dynamic-project-bundle-entries resources)]
      (do
        (res/create-bundle! (:id entry))
        (for [resource (res/list-images (:id entry))]
          (res/remove-image! (:id resource)))
        (res/create-bundle! (:id entry)
                            (runtime-bundle-dependencies (:bundle entry)))))
    resources))

(defun image-resource-options [resources]
  (map (or resources [])
       (fn [resource]
         {:value (:id resource)
          :key-label (str (:key resource))
          :name (:name resource)
          :label (str (:key resource))})))

(defcomponent image-resource-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height resource-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    state))
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :key-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value (ui/bind-state :name)}}]})

(defun image-resource-row-child [index option]
  {:mode 'image-resource-row
   :state {:index index
           :value (:value option)
           :key-label (:key-label option)
           :name (:name option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun bundle-list-child [resources]
  (let [bundles (dynamic-project-bundle-entries resources)]
    (lb/make {:options (bundle-options resources)
              :style {:width :fill
                      :height :fill}
              :row-height resource-list-row-height
              :visible-rows (max 1 (count bundles))
              :content-width 180
              :disabled? (empty? bundles)
              :selected-indices (ui/bind-state :selected-indices)})))

(defcomponent resource-bundle-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :bundles nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [resources (:resources state)
                   bundles (project-bundle-entries resources)
                   selected-indices (selected-bundle-indices
                                     resources
                                     (:selected-resource-bundle state))]
               (do
                 (when (not= bundles (:bundles state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (bundle-list-child resources))))
                 (assoc state
                        :bundles bundles
                        :selected-indices selected-indices))))
   :on {:list-box/change (fn [state event ctx]
                           (let [bundle-id (-> event :payload :value)]
                             (assoc state
                                    :selected-resource-bundle bundle-id
                                    :selected-image-resource
                                    (first-image-resource-id (:resources state)
                                                             bundle-id))))}
   :children [(merge {:id "list-box"}
                     (bundle-list-child {}))]})

(defun selected-resource-index [resources selected-id]
  (when selected-id
    (find-index (or resources [])
                (fn [resource]
                  (= (:id resource) selected-id)))))

(defun selected-resource [resources selected-id]
  (if-let [index (selected-resource-index resources selected-id)]
    (nth resources index)
    nil))

(defun selected-resource-indices [resources selected-id]
  (if-let [index (selected-resource-index resources selected-id)]
    [index]
    []))

(defun selected-bundle-id [resources selected-id]
  (if (nil? (selected-bundle-index resources selected-id))
    nil
    selected-id))

(defun selected-image-resource-id [resources bundle-id selected-id]
  (if (nil? (selected-resource-index (project-image-resources resources bundle-id)
                                     selected-id))
    nil
    selected-id))

(defun derive-resource-workspace-state [state]
  (let [resources (:resources state)
        bundle-id (selected-bundle-id resources
                                      (:selected-resource-bundle state))
        image-id (selected-image-resource-id resources
                                             bundle-id
                                             (:selected-image-resource state))]
    (assoc state
           :selected-resource-bundle bundle-id
           :selected-image-resource image-id
           :image-resource-panel-disabled? (nil? bundle-id)
           :image-resource-add-disabled? (nil? bundle-id)
           :image-resource-remove-disabled? (nil? image-id)
           :image-resource-detail-disabled? (nil? image-id))))

(defun open-image-file-dialog! [state ctx]
  (do
    (file-dialog/open-file-dialog!
     ctx
     {:title "Add Image Resource"
      :mode :file-dialog/open
      :path (or (:project-directory state) file-dialog/default-path)
      :filters image-file-filters
      :result-event :resource/file-dialog-result})
    state))

(defun open-image-metadata-dialog! [state ctx operation opts]
  (do
    (push-mode! 'image-resource-metadata-dialog-modal
                {:operation operation
                 :title (if (= operation :edit)
                          "Edit Image Resource"
                          "Add Image Resource")
                 :button-label (if (= operation :edit) "Update" "Add")
                 :bundle-id (:bundle-id opts)
                 :previous-resource-id (:previous-resource-id opts)
                 :resource-id (:resource-id opts)
                 :resource-name (:resource-name opts)
                 :file-name (:file-name opts)}
                {:origin {:view (:view ctx)
                          :event :resource/metadata-dialog-result}})
    state))

(defun open-selected-image-metadata-dialog! [state ctx]
  (let [resource (selected-resource (project-image-resources
                                     (:resources state)
                                     (:selected-resource-bundle state))
                                    (:selected-image-resource state))]
    (if resource
      (open-image-metadata-dialog!
       state
       ctx
       :edit
       {:bundle-id (:selected-resource-bundle state)
        :previous-resource-id (:id resource)
        :resource-id (keyword-label (:id resource))
        :resource-name (:name resource)
        :file-name (:file-name resource)})
      state)))

(defun image-file-dialog-result? [payload]
  (and (= (:type payload) :confirm)
       (= (:mode payload) :file-dialog/open)
       (not (nil? (:path payload)))))

(defun resource-dependency [payload]
  {:file-name (:file-name payload)
   :name (:resource-name payload)})

(defun add-image-resource! [state payload]
  (let [bundle-id (:bundle-id payload)
        resource-id (keyword (:resource-id payload))]
    (if (and bundle-id
             (not (blank? (:resource-id payload)))
             (not (blank? (:file-name payload))))
      (do
        (res/add-image! (image-resource-key bundle-id resource-id)
                        (runtime-image-dependency (resource-dependency payload)))
        (assoc (assoc-in state
                         [:resources :bundles bundle-id :images resource-id]
                         (resource-dependency payload))
               :selected-image-resource resource-id))
      state)))

(defun edit-image-resource! [state payload]
  (let [bundle-id (:bundle-id payload)
        previous-id (:previous-resource-id payload)
        resource-id (keyword (:resource-id payload))
        dependency (resource-dependency payload)
        images (dissoc (bundle-images (:resources state) bundle-id) previous-id)]
    (if (and bundle-id
             previous-id
             (not (blank? (:resource-id payload)))
             (not (blank? (:file-name payload))))
      (do
        (when (not= previous-id resource-id)
          (res/remove-image! (image-resource-key bundle-id previous-id)))
        (res/add-image! (image-resource-key bundle-id resource-id)
                        (runtime-image-dependency dependency))
        (assoc (assoc-in state
                         [:resources :bundles bundle-id :images]
                         (assoc images resource-id dependency))
               :selected-image-resource resource-id))
      state)))

(defun apply-image-metadata-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (case (:operation payload)
      :add (add-image-resource! state payload)
      :edit (edit-image-resource! state payload)
      :default state)
    state))

(defun remove-image-resource! [state]
  (let [bundle-id (:selected-resource-bundle state)
        resource-id (:selected-image-resource state)]
    (if (and bundle-id resource-id)
      (do
        (res/remove-image! (image-resource-key bundle-id resource-id))
        (assoc (update-in state
                          [:resources :bundles bundle-id :images]
                          (fn [images]
                            (dissoc (or images {}) resource-id)))
               :selected-image-resource nil))
      state)))

(defun image-preview-rect [dim]
  (let [scale (min (/ image-preview-width (:w dim))
                   (/ image-preview-height (:h dim)))
        width (* (:w dim) scale)
        height (* (:h dim) scale)]
    {:x (/ (- image-preview-width width) 2)
     :y (/ (- image-preview-height height) 2)
     :scale scale}))

(defun image-resource-list-child [resources]
  (let [resources (or resources [])]
    (lb/make {:options (image-resource-options resources)
              :style {:width :fill
                      :height :fill}
              :row-height resource-list-row-height
              :visible-rows (max 1 (count resources))
              :content-width 360
              :disabled? (empty? resources)
              :selected-indices (ui/bind-state :selected-indices)
              :item-child image-resource-row-child})))

(defcomponent image-resource-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :image-resources nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [resources (project-image-resources (:resources state)
                                                      (:selected-resource-bundle state))
                   selected-indices (selected-resource-indices
                                     resources
                                     (:selected-image-resource state))]
               (do
                 (when (not= resources (:image-resources state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (image-resource-list-child resources))))
                 (assoc state
                        :image-resources resources
                        :selected-indices selected-indices))))
   :on {:list-box/change (fn [state event ctx]
                           (assoc state
                                  :selected-image-resource
                                  (-> event :payload :value)))}
   :children [(merge {:id "list-box"}
                     (image-resource-list-child []))]})

(defcomponent image-resource-detail
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [resource (selected-resource (project-image-resources
                                                (:resources state)
                                                (:selected-resource-bundle state))
                                               (:selected-image-resource state))]
               (assoc state
                      :resource resource
                      :edit-disabled? (nil? resource)
                      :key-label (if resource (str (:key resource)) "")
                      :name-label (or (:name resource) "")
                      :file-label (or (:file-name resource) ""))))
   :children [{:mode 'ui/button
               :class :ui/toolbar-button
               :style {:width :shrink
                       :height 20}
               :state {:label "Edit"
                       :disabled? (ui/bind-state :edit-disabled?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource/edit-image)
                             state))}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Key"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :key-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Name"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :name-label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "File"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :file-label)}}
              {:mode 'image-resource-preview
               :state {:bundle-id (ui/bind-state :selected-resource-bundle)
                       :image-id (ui/bind-state :selected-image-resource)}}]})

(defcomponent image-resource-preview
  {:class :ui/content
   :style {:width image-preview-width
           :height image-preview-height}
   :render (fn [state ctx]
             (let [image (when (and (:bundle-id state) (:image-id state))
                           (image-resource-key (:bundle-id state) (:image-id state)))
                   dim (when image (img/size image))]
               (do
                 (r/rect! {:x 0 :y 0
                           :w image-preview-width
                           :h image-preview-height}
                          {:fill true
                           :color {:r 0x12 :g 0x15 :b 0x18}})
                 (when dim
                   (let [rect (image-preview-rect dim)]
                     (r/image! image
                               {:pos {:x (:x rect)
                                      :y (:y rect)}
                                :scale (:scale rect)})))
                 (r/rect! {:x 0 :y 0
                           :w image-preview-width
                           :h image-preview-height}
                          {:color {:r 0x00 :g 0x00 :b 0x00}}))))})

(defcomponent resource-bundle-dialog-body
  {:class :ui/content
   :style {:width 260
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (assoc state :invalid? (blank? (:bundle-id state))))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Bundle id"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :bundle-id)
                       :auto-focus? true}}
              {:mode 'resource-bundle-dialog-buttons
               :state {:invalid? (ui/bind-state :invalid?)}}]})

(defcomponent resource-bundle-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-bundle-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Create"
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-bundle-dialog/confirm)
                             state))}]})

(defmode resource-bundle-dialog-modal
  {:on {:resource-bundle-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel})
            state))
        :resource-bundle-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (blank? (:bundle-id state))
              state
              (do
                (pop-mode! {:type :confirm
                            :bundle-id (:bundle-id state)})
                state))))}
   :compose {:render :pass}
   :children [(w/make {:position {:x 220 :y 140}
                       :title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :bundle-id (ui/bind-state :bundle-id)}
                       :body [{:mode 'resource-bundle-dialog-body
                               :state {:bundle-id (ui/bind-state :bundle-id)}}]})]})

(defcomponent image-resource-metadata-dialog-body
  {:class :ui/content
   :style {:width 300
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (assoc state
                    :invalid? (or (blank? (:resource-id state))
                                  (blank? (:resource-name state)))
                    :bundle-prefix (if (:bundle-id state)
                                     (str (:bundle-id state) "/")
                                     "")))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Id"}}
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 4}}
               :state {:bundle-prefix (ui/bind-state :bundle-prefix)
                       :resource-id (ui/bind-state :resource-id)}
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width :shrink}
                           :state {:value (ui/bind-state :bundle-prefix)}}
                          {:mode 'ui/text-input
                           :style {:width :fill
                                   :height 24}
                           :state {:value (ui/bind-state :resource-id)
                                   :auto-focus? true}}]}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Name"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :resource-name)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "File"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :file-name)}}
              {:mode 'image-resource-metadata-dialog-buttons
               :state {:invalid? (ui/bind-state :invalid?)
                       :button-label (ui/bind-state :button-label)}}]})

(defcomponent image-resource-metadata-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :image-resource-metadata-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label (ui/bind-state :button-label)
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :image-resource-metadata-dialog/confirm)
                             state))}]})

(defmode image-resource-metadata-dialog-modal
  {:on {:image-resource-metadata-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel
                        :operation (:operation state)})
            state))
        :image-resource-metadata-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (or (blank? (:resource-id state))
                    (blank? (:resource-name state)))
              state
              (do
                (pop-mode! {:type :confirm
                            :operation (:operation state)
                            :bundle-id (:bundle-id state)
                            :previous-resource-id (:previous-resource-id state)
                            :resource-id (:resource-id state)
                            :resource-name (:resource-name state)
                            :file-name (:file-name state)})
                state))))}
   :compose {:render :pass}
   :children [(w/make {:position {:x 220 :y 140}
                       :title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :operation (ui/bind-state :operation)
                               :bundle-id (ui/bind-state :bundle-id)
                               :previous-resource-id (ui/bind-state :previous-resource-id)
                               :resource-id (ui/bind-state :resource-id)
                               :resource-name (ui/bind-state :resource-name)
                               :file-name (ui/bind-state :file-name)
                               :button-label (ui/bind-state :button-label)}
                       :body [{:mode 'image-resource-metadata-dialog-body
                               :state {:resource-id (ui/bind-state :resource-id)
                                       :bundle-id (ui/bind-state :bundle-id)
                                       :resource-name (ui/bind-state :resource-name)
                                       :file-name (ui/bind-state :file-name)
                                       :button-label (ui/bind-state :button-label)}}]})]})

(defun make-resource-bundle-list-panel []
  (hp/make {:title "Bundles"
            :style {:width 220
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :resource/add-bundle)
                                             state))}]
            :state {:resources (ui/bind-state :resources)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)}
            :children [{:mode 'resource-bundle-list
                        :state {:resources (ui/bind-state :resources)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)}}]}))

(defun make-image-resource-list-panel []
  (hp/make {:title "Images"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"
                                       :disabled? (ui/bind-state
                                                   :image-resource-add-disabled?)}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :resource/add-image)
                                             state))}
                              {:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "-"
                                       :disabled? (ui/bind-state
                                                   :image-resource-remove-disabled?)}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :resource/remove-image)
                                             state))}]
            :state {:resources (ui/bind-state :resources)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)
                    :disabled? (ui/bind-state :image-resource-panel-disabled?)
                    :image-resource-add-disabled? (ui/bind-state
                                                   :image-resource-add-disabled?)
                    :image-resource-remove-disabled? (ui/bind-state
                                                      :image-resource-remove-disabled?)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)}
            :children [{:mode 'image-resource-list
                        :state {:resources (ui/bind-state :resources)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)}}]}))

(defun make-image-resource-detail-panel []
  (hp/make {:title "Resource"
            :style {:width 360
                    :height :fill}
            :state {:resources (ui/bind-state :resources)
                    :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                    :selected-image-resource (ui/bind-state :selected-image-resource)
                    :disabled? (ui/bind-state :image-resource-detail-disabled?)}
            :body-style {:padding 8
                         :height :fill}
            :body-state {:resources (ui/bind-state :resources)
                         :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                         :selected-image-resource (ui/bind-state :selected-image-resource)}
            :children [{:mode 'image-resource-detail
                        :state {:resources (ui/bind-state :resources)
                                :selected-resource-bundle
                                (ui/bind-state :selected-resource-bundle)
                                :selected-image-resource
                                (ui/bind-state :selected-image-resource)}}]}))

(defcomponent resource-explorer-workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row
                    :gap 8}}
   :update (fn [state ctx]
             (let [state (derive-resource-workspace-state state)]
               (if (not= (:resources state) (:synced-resources state))
                 (do
                   (sync-project-resources! (:resources state))
                   (assoc state :synced-resources (:resources state)))
                 state)))
   :on {:resource/add-bundle (fn [state event ctx]
                               (open-resource-bundle-dialog! state ctx))
        :resource/add-image (fn [state event ctx]
                              (if (:selected-resource-bundle state)
                                (open-image-file-dialog! state ctx)
                                state))
        :resource/edit-image (fn [state event ctx]
                               (open-selected-image-metadata-dialog! state ctx))
        :resource/remove-image (fn [state event ctx]
                                 (remove-image-resource! state))
        :resource/file-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (image-file-dialog-result? payload)
              (open-image-metadata-dialog!
               state
               ctx
               :add
               {:bundle-id (:selected-resource-bundle state)
                :resource-id (file-stem (:path payload))
                :resource-name (file-stem (:path payload))
                :file-name (:path payload)})
              state)))
        :resource/bundle-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (add-resource-bundle! state payload)
              state)))
        :resource/metadata-dialog-result
        (fn [state event ctx]
          (apply-image-metadata-dialog-result state (:payload event)))}
   :children [(make-resource-bundle-list-panel)
              (make-image-resource-list-panel)
              (make-image-resource-detail-panel)]})
