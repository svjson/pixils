(ns tilemap-editor.view.resources.dialogs
  (:require pixils
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.ui :as ui]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.file-dialog :as file-dialog]
            [pixils.ui.slider :as sl]
            [pixils.ui.window :as w]
            [tilemap-editor.view.image-panel :as ip]
            tilemap-editor.view.resources.model))

(def image-delete-action-options
  [{:value :resource-delete/delete-tiles
    :label "Also delete all tiles using it"}
   {:value :resource-delete/replace-resource
    :label "Select a replacement resource for all tiles using it"}])

(def image-file-filters
  [{:label "Image files (*.png, *.jpg, *.jpeg, *.bmp)"
    :extensions [".png" ".jpg" ".jpeg" ".bmp"]}
   {:label "All files (*)"
    :extensions []}])

(defun image-resources-delete-message [resource-count]
  (str "Delete " resource-count " image resources?"))

(defun image-file-dialog-path [state]
  (or (selected-image-resource-directory state)
      (:project-directory state)
      (:last-image-file-directory state)
      file-dialog/default-path))

(defun open-resource-bundle-dialog! [state ctx operation opts]
  (do
    (push-mode! 'resource-bundle-dialog-modal
                {:operation operation
                 :title (if (= operation :edit)
                          "Edit Resource Bundle"
                          "New Resource Bundle")
                 :button-label (if (= operation :edit) "Update" "Create")
                 :previous-bundle-id (:previous-bundle-id opts)
                 :bundle-id (:bundle-id opts)}
                {:origin {:view (:view ctx)
                          :event :resource/bundle-dialog-result}})
    state))

(defun open-image-file-dialog! [state ctx]
  (do
    (file-dialog/open-file-dialog!
     ctx
     {:title "Add Image Resource"
      :mode :file-dialog/open
      :path (image-file-dialog-path state)
      :filters image-file-filters
      :result-event :resource/file-dialog-result})
    state))

(defun open-image-replace-file-dialog! [state ctx]
  (do
    (file-dialog/open-file-dialog!
     ctx
     {:title "Replace Image Resource File"
      :mode :file-dialog/open
      :path (image-file-dialog-path state)
      :filters image-file-filters
      :result-event :resource/replace-file-dialog-result})
    state))

(defun open-image-metadata-dialog! [state ctx operation opts]
  (do
    (push-mode! 'image-resource-metadata-dialog-modal
                {:operation operation
                 :title (if (= operation :edit)
                          "Edit Image Resource"
                          "Add Image Resource")
                 :button-label (if (= operation :edit) "Update" "Add")
                 :bundle-id (:bundle-id opts)
                 :previous-resource-id (:previous-resource-id opts)
                 :resource-id (:resource-id opts)
                 :resource-name (:resource-name opts)
                 :file-name (:file-name opts)
                 :transparency-color (:transparency-color opts)}
                {:origin {:view (:view ctx)
                          :event :resource/metadata-dialog-result}})
    state))

(defun image-file-dialog-result? [payload]
  (and (= (:type payload) :confirm)
       (= (:mode payload) :file-dialog/open)
       (not (nil? (:path payload)))))

(defun open-selected-image-metadata-dialog! [state ctx]
  (let [resource (selected-resource (project-image-resources
                                     (:resources state)
                                     (:selected-resource-bundle state))
                                    (:selected-image-resource state))]
    (if resource
      (open-image-metadata-dialog!
       state
       ctx
       :edit
       {:bundle-id (:selected-resource-bundle state)
        :previous-resource-id (:id resource)
        :resource-id (keyword-label (:id resource))
        :resource-name (:name resource)
        :file-name (:file-name resource)
        :transparency-color (:transparency-color resource)})
      state)))

(defun open-selected-image-replace-file-dialog! [state ctx]
  (let [resource (selected-resource (project-image-resources
                                     (:resources state)
                                     (:selected-resource-bundle state))
                                    (:selected-image-resource state))]
    (if resource
      (open-image-replace-file-dialog! state ctx)
      state)))

(defun open-selected-bundle-dialog! [state ctx bundle-id]
  (if bundle-id
    (open-resource-bundle-dialog!
     state
     ctx
     :edit
     {:previous-bundle-id bundle-id
      :bundle-id (keyword-label bundle-id)})
    state))

(defun open-resource-confirm-dialog! [state ctx opts]
  (do
    (dialog/open-confirm!
     ctx
     {:title (:title opts)
      :body {:mode 'ui/text
             :style {:width :fill}
             :state {:value (:message opts)}}
      :buttons [:dialog/cancel
                {:type :dialog/ok
                 :label (or (:confirm-label opts) "Delete")}]
      :result-event :resource/confirm-dialog-result
      :payload (:payload opts)})
    state))

(defun delete-action-index [action]
  (or (find-index image-delete-action-options
                  (fn [option]
                    (= (:value option) action)))
      0))

(defun replacement-index [options key]
  (find-index (or options [])
              (fn [option]
                (= (:value option) key))))

(defun usage-row-child [usage]
  {:mode 'resource-delete-usage-row
   :state {:label (:label usage)
           :count (:count usage)}})

(defun resource-delete-dialog-body-child []
  {:mode 'resource-delete-dialog-body
   :state {:usage (ui/bind-state :usage)
           :delete-action (ui/bind-state :delete-action)
           :delete-action-index (ui/bind-state :delete-action-index)
           :replacement-options (ui/bind-state :replacement-options)
           :replacement-key (ui/bind-state :replacement-key)
           :replacement-index (ui/bind-state :replacement-index)
           :replacement-disabled? (ui/bind-state :replacement-disabled?)
           :invalid? (ui/bind-state :invalid?)}
   :children (concat
              [{:mode 'ui/text
                :class :ui/muted
                :state {:value "Tiles using this resource"}}
               {:mode 'resource-delete-usage-list
                :state {:usage (ui/bind-state :usage)}}
               {:mode 'ui/text
                :class :ui/muted
                :state {:value "Delete behavior"}}
               (cb/make {:options image-delete-action-options
                         :selected-index (ui/bind-state :delete-action-index)})
               {:mode 'ui/text
                :class :ui/muted
                :state {:value "Replacement resource"}}
               (cb/make {:options (ui/bind-state :replacement-options)
                         :selected-index (ui/bind-state :replacement-index)
                         :disabled? (ui/bind-state :replacement-disabled?)})]
              [{:mode 'resource-delete-dialog-buttons
                :state {:invalid? (ui/bind-state :invalid?)}}])})

(defun open-image-delete-resolution-dialog! [state ctx bundle-id resource-id usage]
  (let [resource-key (image-resource-key bundle-id resource-id)
        replacement-options (replacement-image-resource-options (:resources state)
                                                               resource-key)
        replacement-key (first-replacement-image-key (:resources state)
                                                    resource-key)]
    (do
      (push-mode! 'image-resource-delete-dialog-modal
                  {:title "Delete Image Resource"
                   :bundle-id bundle-id
                   :resource-id resource-id
                   :resource-key resource-key
                   :usage usage
                   :delete-action :resource-delete/delete-tiles
                   :delete-action-index 0
                   :replacement-options replacement-options
                   :replacement-key replacement-key
                   :replacement-index (or (replacement-index replacement-options
                                                             replacement-key)
                                          0)}
                  {:origin {:view (:view ctx)
                            :event :resource/delete-dialog-result}})
      state)))

(defun open-image-delete-confirm-dialog! [state ctx bundle-id resource-id]
  (if (and bundle-id resource-id)
    (let [usage (resource-usage-by-tileset
                 (:tilesets state)
                 (image-resource-key bundle-id resource-id))]
      (if (> (resource-usage-total usage) 0)
        (open-image-delete-resolution-dialog! state
                                              ctx
                                              bundle-id
                                              resource-id
                                              usage)
        (open-resource-confirm-dialog!
         state
         ctx
         {:title "Delete Image Resource"
          :message (str "Delete image resource "
                        (image-resource-key bundle-id resource-id)
                        "?")
          :confirm-label "Delete"
          :payload {:operation :delete-image
                    :bundle-id bundle-id
                    :resource-id resource-id
                    :delete-action :resource-delete/delete-tiles}})))
    state))

(defun open-image-resources-delete-confirm-dialog! [state ctx bundle-id resource-ids]
  (let [resource-ids (or resource-ids [])]
    (if (and bundle-id (not (empty? resource-ids)))
      (if (= (count resource-ids) 1)
        (open-image-delete-confirm-dialog! state ctx bundle-id (head resource-ids))
        (open-resource-confirm-dialog!
         state
         ctx
         {:title "Delete Image Resources"
          :message (image-resources-delete-message (count resource-ids))
          :confirm-label "Delete"
          :payload {:operation :delete-images
                    :bundle-id bundle-id
                    :resource-ids resource-ids
                    :delete-action :resource-delete/delete-tiles}}))
      state)))

(defun open-bundle-delete-confirm-dialog! [state ctx bundle-id]
  (if bundle-id
    (open-resource-confirm-dialog!
     state
     ctx
     {:title "Delete Resource Bundle"
      :message (str "Delete resource bundle " bundle-id "?")
      :confirm-label "Delete"
      :payload {:operation :delete-bundle
                :bundle-id bundle-id}})
    state))

(defun apply-resource-confirm-dialog-result [state payload]
  (if (= (:choice payload) :dialog/ok)
    (let [details (:payload payload)]
      (case (:operation details)
        :delete-image (remove-image-resource! state
                                              (:bundle-id details)
                                              (:resource-id details)
                                              (:delete-action details)
                                              (:replacement-key details))
        :delete-images (remove-image-resources! state
                                                (:bundle-id details)
                                                (:resource-ids details))
        :delete-bundle (remove-resource-bundle! state (:bundle-id details))
        :default state))
    state))

(defcomponent resource-delete-usage-row
  {:style {:width :fill
           :height 20
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text
               :class :ui/muted
               :style {:width 58
                       :text {:align :right}}
               :state {:value (ui/bind-state :count)}}]})

(defun resource-delete-usage-rows-child [usage]
  {:id "rows"
   :style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 2}}
   :children (map (or usage []) usage-row-child)})

(defcomponent resource-delete-usage-list
  {:style {:width :fill
           :height :shrink}
   :init (fn [state ctx]
           (assoc state :rendered-usage nil))
   :update (fn [state ctx]
             (let [usage (or (:usage state) [])]
               (do
                 (when (not= usage (:rendered-usage state))
                   (ui/replace-child! (:view ctx)
                                      "rows"
                                      (resource-delete-usage-rows-child usage)))
                 (assoc state :rendered-usage usage))))
   :children [(resource-delete-usage-rows-child [])]})

(defcomponent resource-delete-dialog-body
  {:class :ui/content
   :style {:width 430
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [replace? (= (:delete-action state)
                               :resource-delete/replace-resource)]
               (assoc state
                      :replacement-disabled? (not replace?)
                      :invalid? (and replace?
                                     (nil? (:replacement-key state))))))
   :on {:combo-box/change
        (fn [state event ctx]
          (let [payload (:payload event)
                value (:value payload)]
            (case value
              :resource-delete/delete-tiles
              (assoc state
                     :delete-action value
                     :delete-action-index (:selected-index payload))

              :resource-delete/replace-resource
              (assoc state
                     :delete-action value
                     :delete-action-index (:selected-index payload))

              :default
              (assoc state
                     :replacement-key value
                     :replacement-index (:selected-index payload)))))}})

(defcomponent resource-delete-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-delete-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Delete"
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-delete-dialog/confirm)
                             state))}]})

(defmode image-resource-delete-dialog-modal
  {:on {:resource-delete-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel})
            state))
        :resource-delete-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (:invalid? state)
              state
              (do
                (pop-mode! {:type :confirm
                            :operation :delete-image
                            :bundle-id (:bundle-id state)
                            :resource-id (:resource-id state)
                            :delete-action (:delete-action state)
                            :replacement-key (:replacement-key state)})
                state))))}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :bundle-id (ui/bind-state :bundle-id)
                               :resource-id (ui/bind-state :resource-id)
                               :delete-action (ui/bind-state :delete-action)
                                       :delete-action-index (ui/bind-state :delete-action-index)
                                       :usage (ui/bind-state :usage)
                                       :replacement-options (ui/bind-state :replacement-options)
                                       :replacement-key (ui/bind-state :replacement-key)
                                       :replacement-index (ui/bind-state :replacement-index)
                                       :replacement-disabled? (ui/bind-state :replacement-disabled?)
                                       :invalid? (ui/bind-state :invalid?)}
                               :body [(resource-delete-dialog-body-child)]})]})

(defcomponent resource-bundle-dialog-body
  {:class :ui/content
   :style {:width 260
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (assoc state :invalid? (blank? (:bundle-id state))))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Bundle id"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :bundle-id)
                       :auto-focus? true}}
             {:mode 'resource-bundle-dialog-buttons
               :state {:invalid? (ui/bind-state :invalid?)
                       :button-label (ui/bind-state :button-label)}}]})

(defcomponent resource-bundle-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-bundle-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label (ui/bind-state :button-label)
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource-bundle-dialog/confirm)
                             state))}]})

(defmode resource-bundle-dialog-modal
  {:on {:resource-bundle-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel})
            state))
        :resource-bundle-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (blank? (:bundle-id state))
              state
              (do
                (pop-mode! {:type :confirm
                            :operation (:operation state)
                            :previous-bundle-id (:previous-bundle-id state)
                            :bundle-id (:bundle-id state)})
                state))))}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :operation (ui/bind-state :operation)
                               :previous-bundle-id (ui/bind-state :previous-bundle-id)
                               :bundle-id (ui/bind-state :bundle-id)
                               :button-label (ui/bind-state :button-label)}
                       :body [{:mode 'resource-bundle-dialog-body
                               :state {:bundle-id (ui/bind-state :bundle-id)
                                       :button-label (ui/bind-state :button-label)}}]})]})

(def transparency-image-picker-width 360)
(def transparency-image-picker-height 260)
(def transparency-picker-bundle-id :tilemap-editor-transparency-picker)
(def transparency-picker-resource-id :source)

(defun popup-position [position fallback-x fallback-y]
  {:left (or (:x position) fallback-x)
   :top (or (:y position) fallback-y)})

(defun open-transparency-color-popup! [state ctx position]
  (let [position (popup-position position 260 190)
        color (transparency-color-or-default (:transparency-color state))]
    (do
      (push-mode!
       'image-resource-transparency-color-popup
       {}
       {:origin {:view (:view ctx)
                 :event :resource/transparency-color-popup-result}
        :children [{:mode 'image-resource-transparency-color-popup-panel
                    :class :ui/content
                    :style {:position :absolute
                            :left (:left position)
                            :top (:top position)
                            :width 300
                            :height :shrink}
                    :state {:r (:r color)
                            :g (:g color)
                            :b (:b color)}}]})
      state)))

(defun open-transparency-image-popup! [state ctx position]
  (let [position (popup-position position 300 210)
        file-name (:file-name state)
        image (if (:previous-resource-id state)
                (image-resource-key (:bundle-id state)
                                    (:previous-resource-id state))
                (when (not (blank? file-name))
                  (do
                    (res/create-bundle! transparency-picker-bundle-id)
                    (res/add-image!
                     (image-resource-key transparency-picker-bundle-id
                                         transparency-picker-resource-id)
                     {:file-name file-name})
                    (image-resource-key transparency-picker-bundle-id
                                        transparency-picker-resource-id))))
        panel (ip/make {:width transparency-image-picker-width
                        :height transparency-image-picker-height
                        :image image})]
    (do
      (push-mode!
       'image-resource-transparency-image-popup
       {:image image}
       {:origin {:view (:view ctx)
                 :event :resource/transparency-color-popup-result}
        :children [(assoc panel
                          :class :ui/content
                          :style (merge (:style panel)
                                        {:position :absolute
                                         :left (:left position)
                                         :top (:top position)}))]})
      state)))

(defcomponent image-resource-transparency-swatch
  {:class :ui/content
   :style {:width 28
           :height 22}
   :render (fn [state ctx]
             (let [color (or (:color state)
                             (transparency-color-or-default
                              (:transparency-color state)))
                   bounds (-> ctx :view :bounds)
                   rect {:x 0
                         :y 0
                         :w (:w bounds)
                         :h (:h bounds)}]
               (do
                 (r/rect! rect {:fill true
                                :color color})
                 (r/rect! rect {:color {:r 0 :g 0 :b 0}}))))})

(defcomponent image-resource-transparency-color-control
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (assoc state
                    :color-label (if (blank? (:transparency-color state))
                                   "None"
                                   (:transparency-color state))
                    :pick-disabled? (and (nil? (:previous-resource-id state))
                                         (blank? (:file-name state)))))
   :children [{:mode 'image-resource-transparency-swatch
               :state {:transparency-color (ui/bind-state :transparency-color)}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :color-label)}}
              {:mode 'ui/button
               :style {:width 56
                       :height 24}
               :state {:label "Dial"
                       :transparency-color (ui/bind-state :transparency-color)}
               :on-click (fn [state event ctx]
                           (open-transparency-color-popup!
                            state
                            ctx
                            (:global-position event)))}
              {:mode 'ui/button
               :style {:width 56
                       :height 24}
               :state {:label "Pick"
                       :disabled? (ui/bind-state :pick-disabled?)
                       :bundle-id (ui/bind-state :bundle-id)
                       :previous-resource-id (ui/bind-state
                                              :previous-resource-id)
                       :file-name (ui/bind-state :file-name)}
               :on-click (fn [state event ctx]
                           (if (:pick-disabled? state)
                             state
                             (open-transparency-image-popup!
                              state
                              ctx
                              (:global-position event))))}
              {:mode 'ui/button
               :style {:width 56
                       :height 24}
               :state {:label "Clear"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :resource/transparency-color-change
                                       {:transparency-color ""})
                             state))}]})

(defcomponent transparency-color-channel-editor
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 18}
               :state {:value (ui/bind-state :label)}}
              (sl/make {:value (ui/bind-state :value)
                        :min 0
                        :max 255
                        :step 1})
              {:mode 'ui/text
               :style {:width 28}
               :state {:value (ui/bind-state :value)}}]})

(defun transparency-color-channel-child [channel label value]
  {:mode 'transparency-color-channel-editor
   :state {:channel channel
           :label label
           :value value}})

(defcomponent image-resource-transparency-color-popup-panel
  {:style {:padding 8
           :layout {:direction :column
                    :gap 6}}
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :update (fn [state ctx]
             (let [color {:r (color-channel (:r state))
                          :g (color-channel (:g state))
                          :b (color-channel (:b state))}]
               (assoc state
                      :color color
                      :r (:r color)
                      :g (:g color)
                      :b (:b color)
                      :transparency-color (color-hex color)
                      :color-label (color-hex color))))
   :children [{:style {:width :fill
                       :height 46
                       :layout {:direction :row
                                :align-items :center
                                :gap 8}}
               :state {:color (ui/bind-state :color)
                       :color-label (ui/bind-state :color-label)}
               :children [{:mode 'image-resource-transparency-swatch
                           :style {:width 46
                                   :height 46}
                           :state {:color (ui/bind-state :color)}}
                          {:mode 'ui/text
                           :style {:width :fill}
                           :state {:value (ui/bind-state :color-label)}}]}
              (transparency-color-channel-child :r "R" (ui/bind-state :r))
              (transparency-color-channel-child :g "G" (ui/bind-state :g))
              (transparency-color-channel-child :b "B" (ui/bind-state :b))
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :gap :space-between}}
               :state {:transparency-color
                       (ui/bind-state :transparency-color)}
               :children [{:mode 'ui/button
                           :style {:width 78
                                   :height 24}
                           :state {:label "Clear"}
                           :on-click (fn [state event ctx]
                                       (do
                                         (ui/emit! (:view ctx)
                                                   :resource/transparency-clear
                                                   {:transparency-color ""})
                                         state))}
                          {:mode 'ui/button
                           :style {:width 78
                                   :height 24}
                           :state {:label "Done"
                                   :transparency-color
                                   (ui/bind-state :transparency-color)}
                           :on-click (fn [state event ctx]
                                       (do
                                         (ui/emit! (:view ctx)
                                                   :resource/transparency-commit
                                                   {:transparency-color
                                                    (:transparency-color state)})
                                         state))}]}]})

(defmode image-resource-transparency-color-popup
  {:on-mouse-down (fn [state event ctx]
                    (do
                      (pop-mode! {:type :dismiss})
                      state))
   :on {:resource/transparency-clear
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :confirm
                        :transparency-color
                        (-> event :payload :transparency-color)})
            state))
        :resource/transparency-commit
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :confirm
                        :transparency-color
                        (-> event :payload :transparency-color)})
            state))}
   :compose {:render :pass}})

(defmode image-resource-transparency-image-popup
  {:on-mouse-down (fn [state event ctx]
                    (do
                      (pop-mode! {:type :dismiss})
                      state))
   :on {:image-panel/source-click
        (fn [state event ctx]
          (let [source-pos (-> event :payload :source-position)
                color (when (and (:image state) source-pos)
                        (img/color-at (:image state)
                                      {:x (int (:x source-pos))
                                       :y (int (:y source-pos))}))]
            (do
              (ui/stop-propagation! event)
              (if color
                (pop-mode! {:type :confirm
                            :transparency-color (color-hex color)})
                state))))}
   :compose {:render :pass}})

(defcomponent image-resource-metadata-dialog-body
  {:class :ui/content
   :style {:width 300
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (assoc state
                    :invalid? (or (blank? (:resource-id state))
                                  (blank? (:resource-name state)))
                    :bundle-prefix (if (:bundle-id state)
                                     (str (:bundle-id state) "/")
                                     "")))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Id"}}
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 4}}
               :state {:bundle-prefix (ui/bind-state :bundle-prefix)
                       :resource-id (ui/bind-state :resource-id)}
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width :shrink}
                           :state {:value (ui/bind-state :bundle-prefix)}}
                          {:mode 'ui/text-input
                           :style {:width :fill
                                   :height 24}
                           :state {:value (ui/bind-state :resource-id)
                                   :auto-focus? true}}]}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Name"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :resource-name)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "File"}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :file-name)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Transparency color"}}
              {:mode 'image-resource-transparency-color-control
               :state {:bundle-id (ui/bind-state :bundle-id)
                       :previous-resource-id (ui/bind-state
                                              :previous-resource-id)
                       :resource-id (ui/bind-state :resource-id)
                       :file-name (ui/bind-state :file-name)
                       :transparency-color (ui/bind-state :transparency-color)}}
              {:mode 'image-resource-metadata-dialog-buttons
               :state {:invalid? (ui/bind-state :invalid?)
                       :button-label (ui/bind-state :button-label)}}]})

(defcomponent image-resource-metadata-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :image-resource-metadata-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label (ui/bind-state :button-label)
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :image-resource-metadata-dialog/confirm)
                             state))}]})

(defmode image-resource-metadata-dialog-modal
  {:on {:image-resource-metadata-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel
                        :operation (:operation state)})
            state))
        :image-resource-metadata-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (or (blank? (:resource-id state))
                    (blank? (:resource-name state)))
              state
              (do
                (pop-mode! {:type :confirm
                            :operation (:operation state)
                            :bundle-id (:bundle-id state)
                            :previous-resource-id (:previous-resource-id state)
                            :resource-id (:resource-id state)
                            :resource-name (:resource-name state)
                            :file-name (:file-name state)
                            :transparency-color (:transparency-color state)})
                state))))
        :resource/transparency-color-change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (assoc state
                   :transparency-color
                   (-> event :payload :transparency-color))))
        :resource/transparency-color-popup-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (assoc state :transparency-color (:transparency-color payload))
              state)))}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :operation (ui/bind-state :operation)
                               :bundle-id (ui/bind-state :bundle-id)
                               :previous-resource-id (ui/bind-state :previous-resource-id)
                               :resource-id (ui/bind-state :resource-id)
                               :resource-name (ui/bind-state :resource-name)
                               :file-name (ui/bind-state :file-name)
                               :transparency-color (ui/bind-state
                                                    :transparency-color)
                               :button-label (ui/bind-state :button-label)}
                       :body [{:mode 'image-resource-metadata-dialog-body
                               :state {:resource-id (ui/bind-state :resource-id)
                                       :bundle-id (ui/bind-state :bundle-id)
                                       :previous-resource-id
                                       (ui/bind-state :previous-resource-id)
                                       :resource-name (ui/bind-state :resource-name)
                                       :file-name (ui/bind-state :file-name)
                                       :transparency-color
                                       (ui/bind-state :transparency-color)
                                       :button-label (ui/bind-state :button-label)}}]})]})
