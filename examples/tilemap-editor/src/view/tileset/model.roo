(ns tilemap-editor.view.tileset.model
  (:require pixils
            [roo.io :as io]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.maps :as maps]))

(def tile-grid-cell-size data/tile-dim)

(def tile-grid-gap 0)

(def tile-type-options
  [{:value :color
    :label "Color"}
   {:value :sprite
    :label "Sprite"}])

(def default-tile-color {:r 0x00 :g 0x00 :b 0x00})

(def default-tile-image nil)

(def default-import-bundle :project-assets)

(defun clean-name-separators [value index out]
  (if (>= index (count value))
    (trim out)
    (let [ch (substr value index 1)]
      (clean-name-separators
       value
       (inc index)
       (str out
            (if (or (= ch "-") (= ch "_"))
              " "
              ch))))))

(defun label-from-id [id]
  (capitalize (clean-name-separators id 0 "")))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun item-id-exists? [items id]
  (> (count (filter (or items [])
                    (fn [item]
                      (= (:id item) (keyword id)))))
     0))

(defun item-id-exists-except? [items id exclude-index]
  (> (count (filter (for-indexed [index item (or items [])]
                      {:index index
                       :item item})
                    (fn [entry]
                      (and (= (:id (:item entry)) (keyword id))
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-id-from [items root suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)]
    (if (item-id-exists? items candidate)
      (unique-id-from items
                      root
                      (if suffix (inc suffix) 2))
      candidate)))

(defun unique-id-from-except [items root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)]
    (if (item-id-exists-except? items candidate exclude-index)
      (unique-id-from-except items
                             root
                             exclude-index
                             (if suffix (inc suffix) 2))
      candidate)))

(defun unique-tileset-id [tilesets]
  (unique-id-from (or tilesets []) "tile-set" nil))

(defun unique-tile-id [tiles]
  (unique-id-from (or tiles []) "tile" nil))

(defun unique-color-tile-id [tiles]
  (unique-id-from (or tiles []) "color" nil))

(defun tile-id-root [value]
  (kebab-case (or value "")))

(defun numbered-tile-id [root number]
  (str root "-" number))

(defun numbered-tile-name [root number]
  (str root " " number))

(defun default-tile-char [id]
  (if (> (count id) 0)
    (substr id 0 1)
    ""))

(defun file-stem [path]
  (let [name (io/basename path)
        extension (io/extension name)]
    (if (blank? extension)
      name
      (substr name 0 (- (count name) (count extension))))))

(defun file-directory [path]
  (when (not (blank? path))
    (let [directory (io/parent-path path)]
      (when (not (blank? directory))
        directory))))

(defun absolute-path? [path]
  (and (not (blank? path))
       (or (= (substr path 0 1) "/")
           (and (> (count path) 1)
                (= (substr path 1 1) ":")))))

(defun project-file-directory [path project-directory]
  (let [directory (file-directory path)]
    (when directory
      (if (and (not (blank? project-directory))
               (not (absolute-path? directory)))
        (io/join-path project-directory directory)
        directory))))

(defun default-resource-id [path]
  (kebab-case (file-stem path)))

(defun default-resource-name [path]
  (label-from-id (default-resource-id path)))

(defun image-resource-key [bundle-id resource-id]
  (keyword (str (keyword-label bundle-id)
                "/"
                (keyword-label resource-id))))

(defun project-bundle-entries [resources]
  (let [bundles (or (:bundles resources) {})]
    (map (keys bundles)
         (fn [bundle-id]
           {:id bundle-id
            :bundle (get bundles bundle-id)}))))

(defun static-project-bundle-id? [bundle-id]
  (= bundle-id :editor-assets))

(defun dynamic-bundle-entry? [entry]
  (not (static-project-bundle-id? (:id entry))))

(defun dynamic-project-bundle-entries [resources]
  (filter (project-bundle-entries resources) dynamic-bundle-entry?))

(defun first-dynamic-bundle-id [resources]
  (if-let [entry (head (dynamic-project-bundle-entries resources))]
    (:id entry)
    nil))

(defun bundle-options [resources]
  (for-indexed [index entry (dynamic-project-bundle-entries resources)]
    {:value (:id entry)
     :id (:id entry)
     :label (keyword-label (:id entry))}))

(defun bundle-index-by-id [options id]
  (find-index (or options [])
              (fn [option]
                (= (:id option) id))))

(defun bundle-id-at-index [options index]
  (when (and (not (nil? index))
             (< index (count (or options []))))
    (:id (nth options index))))

(defun image-resource-entries-for-bundle [resources bundle-id]
  (let [images (or (get-in resources [:bundles bundle-id :images]) {})]
    (map (keys images)
         (fn [resource-id]
           (let [dependency (get images resource-id)]
             {:id resource-id
              :bundle-id bundle-id
              :key (image-resource-key bundle-id resource-id)
              :name (or (:name dependency)
                        (keyword-label resource-id))
              :file-name (:file-name dependency)})))))

(defun image-resource-entries [resources]
  (reduce (dynamic-project-bundle-entries resources)
          []
          (fn [out entry]
            (concat out
                    (image-resource-entries-for-bundle resources (:id entry))))))

(defun image-resource-entry-by-key [resources key]
  (head (filter (image-resource-entries resources)
                (fn [resource]
                  (= (:key resource) key)))))

(defun has-project-image-resources? [resources]
  (not (empty? (image-resource-entries resources))))

(defun image-resource-options [resources bundle-id]
  (for-indexed [index resource (image-resource-entries-for-bundle resources
                                                                  bundle-id)]
    (merge resource
           {:value index
            :label (str (:key resource) "  " (:name resource))})))

(defun resource-index-by-key [options key]
  (find-index (or options [])
              (fn [option]
                (= (:key option) key))))

(defun selected-resource-option [state]
  (let [options (:resource-options state)
        index (:selected-resource-index state)]
    (when (and (not (nil? index))
               (< index (count (or options []))))
      (nth options index))))

(defun default-tile-source [tile-size]
  (let [tile-size (data/map-tile-dim tile-size)]
    {:x 0 :y 0 :w (:w tile-size) :h (:h tile-size)}))

(defun tile-grid-cell-size-for [tile-size]
  (data/map-tile-dim (or tile-size tile-grid-cell-size)))

(defun optional-tile-grid-size [value]
  (if (= (type-of value) "vector")
    (head value)
    value))

(defun tile-grid-stride [& tile-size-values]
  (let [size (tile-grid-cell-size-for (optional-tile-grid-size tile-size-values))]
    {:w (+ (:w size) tile-grid-gap)
     :h (+ (:h size) tile-grid-gap)}))

(defun clamp-index [index item-count]
  (if (<= item-count 0)
    nil
    (max 0 (min (or index 0) (dec item-count)))))

(defun tile-grid-columns [bounds & tile-size-values]
  (let [size (tile-grid-cell-size-for
              (optional-tile-grid-size tile-size-values))
        stride (tile-grid-stride size)]
  (max 1 (int (/ (+ (max 1 (or (:w bounds) 1)) tile-grid-gap)
	                   (:w stride))))))

(defun tile-grid-index-at-position [position bounds item-count & tile-size-values]
  (let [size (tile-grid-cell-size-for
              (optional-tile-grid-size tile-size-values))
        stride (tile-grid-stride size)
        col (int (/ (:x position) (:w stride)))
        row (int (/ (:y position) (:h stride)))
        index (+ col (* row (tile-grid-columns bounds size)))]
    (if (and (>= (:x position) 0)
             (>= (:y position) 0)
	             (< (mod (:x position) (:w stride)) (:w size))
	             (< (mod (:y position) (:h stride)) (:h size))
             (< index item-count))
      index
      nil)))

(defun move-tile-grid-index [index item-count columns delta]
  (clamp-index (+ (or index 0) delta) item-count))

(defun valid-tile-indices [indices item-count]
  (filter (or indices [])
          (fn [index]
            (and (number? index)
                 (>= index 0)
                 (< index item-count)))))

(defun selected-tileset-tile-selection [state]
  (let [tiles (selected-tileset-tiles state)
        selection (valid-tile-indices (:selected-tileset-tile-indices state)
                                      (count tiles))]
    (if (or (not (empty? selection))
            (nil? (:selected-tileset-tile-index state)))
      selection
      (valid-tile-indices [(:selected-tileset-tile-index state)]
                          (count tiles)))))

(defun tile-grid-selection-range [anchor index columns item-count]
  (let [columns (max 1 (or columns 1))
        start (min (or anchor index 0) (or index anchor 0))
        end (max (or anchor index 0) (or index anchor 0))
        start-col (mod start columns)
        start-row (int (/ start columns))
        end-col (mod end columns)
        end-row (int (/ end columns))
        left (min start-col end-col)
        right (max start-col end-col)
        top (min start-row end-row)
        bottom (max start-row end-row)]
    (reduce (range top bottom)
            []
            (fn [out row]
              (concat out
                      (filter (map (range left right)
                                   (fn [col]
                                     (+ col (* row columns))))
                              (fn [tile-index]
                                (< tile-index item-count))))))))

(defun select-tileset-tile-index [state index]
  (assoc state
         :selected-tileset-tile-index index
         :selected-tileset-tile-indices (if (nil? index) [] [index])
         :tile-grid-selection-anchor index))

(defun select-tileset-tile-range [state anchor index columns item-count]
  (let [selection (tile-grid-selection-range anchor index columns item-count)]
    (assoc state
           :selected-tileset-tile-index index
           :selected-tileset-tile-indices selection)))

(defun selected-tileset-definition [state]
  (let [tilesets (or (:tilesets state) [])]
    (when (> (count tilesets) 0)
      (nth tilesets
           (min (or (:selected-tileset-definition-index state) 0)
                (dec (count tilesets)))))))

(defun selected-tileset-tiles [state]
  (or (:tiles (selected-tileset-definition state)) []))

(defun selected-tileset-tile-size [state]
  (data/map-tile-dim (or (:tile-size (selected-tileset-definition state))
                         data/tile-dim)))

(defun selected-tileset-tile [state]
  (let [tiles (selected-tileset-tiles state)
        index (:selected-tileset-tile-index state)]
    (when (and (not (nil? index))
               (> (count tiles) 0))
      (nth tiles (min index (dec (count tiles)))))))

(defun selected-tile-image-resource [state]
  (let [tile (selected-tileset-tile state)]
    (when (= (:type tile) :sprite)
      (image-resource-entry-by-key (:resources state) (:image tile)))))

(defun selected-tile-image-resource-directory [state]
  (project-file-directory (:file-name (selected-tile-image-resource state))
                          (:project-directory state)))

(defun selected-tile-path [state]
  (let [tilesets (or (:tilesets state) [])
        tileset-index (:selected-tileset-definition-index state)
        tile-index (:selected-tileset-tile-index state)]
    (when (and (not (nil? tileset-index))
               (not (nil? tile-index))
               (< tileset-index (count tilesets))
               (< tile-index (count (or (:tiles (nth tilesets tileset-index)) []))))
      [:tilesets tileset-index :tiles tile-index])))

(defun update-selected-tile [state update-fn]
  (if-let [path (selected-tile-path state)]
    (assoc-in state path (update-fn (get-in state path)))
    state))

(defun selected-tileset-id [state]
  (:id (selected-tileset-definition state)))

(defun tile-substitution [tile]
  (let [substitution (or (:substitution tile)
                         {:seed 0
                          :choices []})]
    (assoc substitution
           :algorithm
           (or (:algorithm substitution)
               data/default-tile-substitution-algorithm))))

(defun first-selected-tileset-tile-id [state]
  (:id (head (selected-tileset-tiles state))))

(defun selected-tile-variant-tile-id [state source-tile-id]
  (or (head (filter (map (selected-tileset-tiles state) :id)
                    (fn [tile-id]
                      (not= tile-id source-tile-id))))
      source-tile-id))

(defun default-tile-substitution [state tile]
  (let [source-tile-id (:id tile)
        variant-tile-id (selected-tile-variant-tile-id state source-tile-id)]
    {:seed 0
     :algorithm data/default-tile-substitution-algorithm
     :choices [{:tile source-tile-id
                :weight 4}
               {:tile variant-tile-id
                :weight 1}]}))

(defun set-selected-tile-default-substitution [state]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile :substitution (default-tile-substitution state tile)))))

(defun set-selected-tile-substitution-seed [state seed]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile
            :substitution
            (assoc (tile-substitution tile) :seed (or seed 0))))))

(defun add-selected-tile-substitution-choice [state]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile
            :substitution
            (update (tile-substitution tile)
                    :choices
                    (fn [choices]
                      (concat (or choices [])
                              [{:tile (or (:id tile)
                                          (first-selected-tileset-tile-id state))
                                :weight 1}])))))))

(defun substitution-choice-by-tile [choices tile-id]
  (head (filter (or choices [])
                (fn [choice]
                  (= (:tile choice) tile-id)))))

(defun substitution-choices-for-tile-ids [choices tile-ids]
  (map (or tile-ids [])
       (fn [tile-id]
         (let [choice (substitution-choice-by-tile choices tile-id)]
           {:tile tile-id
            :weight (or (:weight choice) 1)}))))

(defun set-selected-tile-substitution-choice-tiles [state tile-ids]
  (update-selected-tile
   state
   (fn [tile]
     (let [substitution (tile-substitution tile)]
       (assoc tile
              :substitution
              (assoc substitution
                     :choices
                     (substitution-choices-for-tile-ids
                      (:choices substitution)
                      tile-ids)))))))

(defun update-substitution-choice-at [substitution choice-index update-fn]
  (assoc substitution
         :choices
         (map (for-indexed [index choice (or (:choices substitution) [])]
                {:index index :choice choice})
              (fn [entry]
                (if (= (:index entry) choice-index)
                  (apply update-fn [(:choice entry)])
                  (:choice entry))))))

(defun set-selected-tile-substitution-choice-tile [state choice-index tile-ref]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile
            :substitution
            (update-substitution-choice-at
             (tile-substitution tile)
             choice-index
             (fn [choice]
               (assoc choice :tile tile-ref)))))))

(defun set-selected-tile-substitution-choice-weight [state choice-index weight]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile
            :substitution
            (update-substitution-choice-at
             (tile-substitution tile)
             choice-index
             (fn [choice]
               (assoc choice :weight (max 0 (or weight 0)))))))))

(defun remove-selected-tile-substitution-choice [state choice-index]
  (update-selected-tile
   state
   (fn [tile]
     (assoc tile
            :substitution
            (assoc (tile-substitution tile)
                   :choices
                   (map (filter (for-indexed [index choice
                                               (or (-> tile
                                                       tile-substitution
                                                       :choices)
                                                   [])]
                                  {:index index :choice choice})
                                (fn [entry]
                                  (not= (:index entry) choice-index)))
                        :choice))))))

(defun tile-type-index [tile]
  (let [match (find-index tile-type-options
                          (fn [option]
                            (= (:value option) (:type tile))))]
    (or match 0)))

(defun tile-with-type [tile type tile-size]
  (let [tile-dim (data/map-tile-dim tile-size)]
    (case type
	    :color
	    (assoc tile
	           :type :color
	           :color (or (:color tile) default-tile-color))

	    :sprite
	    (assoc tile
	           :type :sprite
	           :image (or (:image tile) default-tile-image)
	           :source (assoc (merge (default-tile-source tile-dim)
	                                 (or (:source tile) {}))
	                          :w (:w tile-dim)
	                          :h (:h tile-dim)))

	    :default
	    (assoc tile :type type))))

(defun tile-with-size [tile tile-size]
  (let [tile-dim (data/map-tile-dim tile-size)]
    (if (or (= (:type tile) :sprite)
            (:source tile))
      (assoc tile
             :source (assoc (merge (default-tile-source tile-dim)
                                   (or (:source tile) {}))
                            :w (:w tile-dim)
                            :h (:h tile-dim)))
      tile)))

(defun tileset-with-tile-size [tileset tile-size]
  (let [tile-size (data/map-tile-dim tile-size)]
    (assoc (assoc tileset
                  :tile-size tile-size)
	         :tiles (map (or (:tiles tileset) [])
	                     (fn [tile]
	                       (tile-with-size tile tile-size))))))

(defun make-tileset-definition [id label tile-size]
  {:id (keyword id)
   :label label
   :tile-size (data/map-tile-dim tile-size)
   :tiles []})

(defun tileset-label [tileset]
  (or (:label tileset)
      (:name tileset)
      (when (:id tileset)
        (label-from-id (:id tileset)))
      "Tile Set"))

(defun tileset-label-exists? [tilesets label exclude-index]
  (> (count (filter (for-indexed [index tileset (or tilesets [])]
                      {:index index
                       :label (tileset-label tileset)})
                    (fn [entry]
                      (and (= (:label entry) label)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-tileset-label-from [tilesets root-label exclude-index suffix]
  (let [candidate (if suffix
                    (str root-label " " suffix)
                    root-label)]
    (if (tileset-label-exists? tilesets candidate exclude-index)
      (unique-tileset-label-from tilesets
                                 root-label
                                 exclude-index
                                 (if suffix (inc suffix) 2))
      candidate)))

(defun duplicate-tileset-label [tilesets tileset]
  (unique-tileset-label-from tilesets
                             (str (tileset-label tileset) " Copy")
                             nil
                             nil))

(defun insert-tileset-after [tilesets tileset-index duplicate]
  (apply concat
         (for-indexed [index tileset (or tilesets [])]
           (if (= index tileset-index)
             [tileset duplicate]
             [tileset]))))

(defun make-tile-definition [id name ch type tile-size]
  (tile-with-type {:id (keyword id)
                   :name name
                   :char ch}
                  type
                  tile-size))

(defun make-color-tile-definition [id name ch color]
  {:id (keyword id)
   :name name
   :char ch
   :type :color
   :color color})

(defun lerp-channel [from to index steps]
  (if (<= steps 0)
    from
    (int (+ from
            (/ (* (- to from) index)
               steps)))))

(defun lerp-color [from to index count]
  (let [steps (dec count)]
    {:r (lerp-channel (:r from) (:r to) index steps)
     :g (lerp-channel (:g from) (:g to) index steps)
     :b (lerp-channel (:b from) (:b to) index steps)}))

(defun add-tileset-definition! [state payload]
  (if (and (= (:type payload) :confirm)
           (not (blank? (:tileset-id payload)))
           (not (blank? (:tileset-label payload))))
    (let [tilesets (or (:tilesets state) [])
          id (unique-id-from tilesets (kebab-case (:tileset-id payload)) nil)
          index (count tilesets)
	          tileset (make-tileset-definition id
	                                           (:tileset-label payload)
	                                           (or (:tile-size payload)
	                                               data/tile-dim))]
      (assoc state
             :tilesets (concat tilesets [tileset])
             :selected-tileset-definition-index index
             :selected-tileset-tile-index nil
             :selected-tileset-tile-indices []))
    state))

(defun duplicate-tileset-definition! [state payload]
  (let [tilesets (or (:tilesets state) [])
        index (:source-tileset-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? index))
             (>= index 0)
             (< index (count tilesets))
             (not (blank? (:tileset-id payload)))
             (not (blank? (:tileset-label payload))))
      (let [source (nth tilesets index)
	            tile-size (or (:tile-size payload)
	                          (:tile-size source)
	                          data/tile-dim)
            id (keyword (unique-id-from tilesets
                                        (kebab-case (:tileset-id payload))
                                        nil))
            duplicate (assoc (tileset-with-tile-size source tile-size)
                             :id id
                             :label (:tileset-label payload))
            duplicate-index (inc index)
            tiles (or (:tiles duplicate) [])]
        (assoc state
               :tilesets (insert-tileset-after tilesets index duplicate)
               :selected-tileset-definition-index duplicate-index
               :selected-tileset-tile-index (if (empty? tiles) nil 0)
               :selected-tileset-tile-indices (if (empty? tiles) [] [0])))
      state)))

(defun rename-tileset-in-brush-value [value old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (rename-tileset-in-brush-value item old-id new-id)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (rename-tileset-in-brush-value
                               (if (and (= key :tileset)
                                        (= item old-id))
                                 new-id
                                 item)
                               old-id
                               new-id))))
    :default value))

(defun rename-tileset-in-brushes [brushes old-id new-id]
  (rename-tileset-in-brush-value (or brushes []) old-id new-id))

(defun rename-tileset-in-layer [layer old-id new-id]
  (if (= (:tileset layer) old-id)
    (assoc layer :tileset new-id)
    layer))

(defun rename-tileset-in-layers [layers old-id new-id]
  (map (or layers [])
       (fn [layer]
         (rename-tileset-in-layer layer old-id new-id))))

(defun rename-tileset-references [state old-id new-id]
  (maps/update-all-map-layers
   (assoc state
          :layer-profiles (map (or (:layer-profiles state) [])
                               (fn [profile]
                                 (assoc profile
                                        :layers
                                        (rename-tileset-in-layers
                                         (:layers profile)
                                         old-id
                                         new-id))))
          :brushes (rename-tileset-in-brushes (:brushes state) old-id new-id)
          :tileset (if (= (:tileset state) old-id)
                     new-id
                     (:tileset state)))
   (fn [layers]
     (rename-tileset-in-layers layers old-id new-id))))

(defun edit-tileset-definition! [state payload]
  (let [tilesets (or (:tilesets state) [])
        index (:tileset-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? index))
             (< index (count tilesets))
             (not (blank? (:tileset-id payload)))
             (not (blank? (:tileset-label payload))))
      (let [old-tileset (nth tilesets index)
            old-id (:id old-tileset)
	            tile-size (or (:tile-size payload)
	                          data/tile-dim)
            new-id (keyword (unique-id-from-except
                             tilesets
                             (kebab-case (:tileset-id payload))
                             index
                             nil))
            next-state (assoc-in
                        state
                        [:tilesets index]
                        (assoc (tileset-with-tile-size old-tileset tile-size)
                               :id new-id
                               :label (:tileset-label payload)))]
        (assoc (rename-tileset-references next-state old-id new-id)
	               :selected-tileset-definition-index index))
	      state)))

(defun apply-tileset-properties! [state payload]
  (let [tilesets (or (:tilesets state) [])
        index (:tileset-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? index))
             (< index (count tilesets)))
      (let [property-values (:properties payload)
            next-tileset (assoc (nth tilesets index)
                                :property-sets
                                (or (:property-sets payload) []))
            next-tileset (if (empty? (or property-values {}))
                           (dissoc next-tileset :properties)
                           (assoc next-tileset
                                  :properties
                                  property-values))]
        (assoc (assoc-in state [:tilesets index] next-tileset)
               :selected-tileset-definition-index index))
      state)))

(defun tile-ids-at-indices [tiles indices]
  (map (filter (for-indexed [index tile (or tiles [])]
                 {:index index
                  :tile tile})
               (fn [entry]
                 (contains? indices (:index entry))))
       (fn [entry]
         (:id (:tile entry)))))

(defun deleted-index-count-before [indices index]
  (count (filter (or indices [])
                 (fn [deleted-index]
                   (< deleted-index index)))))

(defun remove-deleted-tile-ref [tile-ref deleted-ids deleted-indices]
  (cond
    (nil? tile-ref)
    nil

    (keyword? tile-ref)
    (if (contains? deleted-ids tile-ref)
      nil
      tile-ref)

    (number? tile-ref)
    (cond
      (contains? deleted-indices tile-ref) nil
      :default (- tile-ref
                  (deleted-index-count-before deleted-indices tile-ref)))

    :default
    tile-ref))

(defun profile-layer-tileset [profile layer]
  (:tileset (data/layer-profile-layer-by-id profile (:id layer))))

(defun layer-effective-tileset [layer profile]
  (or (:tileset layer)
      (profile-layer-tileset profile layer)))

(defun layer-uses-tileset? [layer profile tileset-id]
  (= (layer-effective-tileset layer profile) tileset-id))

(defun remove-deleted-tile-refs-in-layer-with-profile
  [layer profile tileset-id deleted-ids deleted-indices]
  (if (layer-uses-tileset? layer profile tileset-id)
    (update layer :tiles
            (fn [rows]
              (map (or rows [])
                   (fn [row]
                     (map (or row [])
                          (fn [tile-ref]
                            (remove-deleted-tile-ref tile-ref
                                                     deleted-ids
                                                     deleted-indices)))))))
    layer))

(defun remove-deleted-tile-refs-in-layer [layer tileset-id deleted-ids deleted-indices]
  (remove-deleted-tile-refs-in-layer-with-profile layer
                                                  nil
                                                  tileset-id
                                                  deleted-ids
                                                  deleted-indices))

(defun remove-deleted-tile-refs-in-layers-with-profile
  [layers profile tileset-id deleted-ids deleted-indices]
  (map (or layers [])
       (fn [layer]
         (remove-deleted-tile-refs-in-layer-with-profile layer
                                                         profile
                                                         tileset-id
                                                         deleted-ids
                                                         deleted-indices))))

(defun remove-deleted-tile-refs-in-layers [layers tileset-id deleted-ids deleted-indices]
  (map (or layers [])
       (fn [layer]
         (remove-deleted-tile-refs-in-layer layer
                                            tileset-id
                                            deleted-ids
                                            deleted-indices))))

(defun remove-deleted-tile-refs-in-brush-value [value tileset-id deleted-ids deleted-indices]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (remove-deleted-tile-refs-in-brush-value item
                                                             tileset-id
                                                             deleted-ids
                                                             deleted-indices)))
    "map" (let [layer (if (and (:tiles value)
                               (:tileset value))
                        (remove-deleted-tile-refs-in-layer value
                                                           tileset-id
                                                           deleted-ids
                                                           deleted-indices)
                        value)]
            (reduce-kv layer
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (remove-deleted-tile-refs-in-brush-value
                                 item
                                 tileset-id
                                 deleted-ids
                                 deleted-indices)))))
    :default value))

(defun remove-deleted-tile-refs-in-brushes [brushes tileset-id deleted-ids deleted-indices]
  (remove-deleted-tile-refs-in-brush-value (or brushes [])
                                           tileset-id
                                           deleted-ids
                                           deleted-indices))

(defun remove-deleted-tile-ref-key [terrain key deleted-ids deleted-indices]
  (if (contains? terrain key)
    (assoc terrain
           key
           (remove-deleted-tile-ref (get terrain key)
                                    deleted-ids
                                    deleted-indices))
    terrain))

(defun remove-deleted-tile-refs-in-terrain [terrain terrain-set-tileset tileset-id deleted-ids deleted-indices]
  (if (= (or (:tileset terrain) terrain-set-tileset) tileset-id)
    (reduce [:tile :preview-tile :preview]
            terrain
            (fn [out key]
              (remove-deleted-tile-ref-key out
                                           key
                                           deleted-ids
                                           deleted-indices)))
    terrain))

(defun remove-deleted-tile-refs-in-terrain-set [terrain-set tileset-id deleted-ids deleted-indices]
  (assoc terrain-set
         :terrains
         (map (or (:terrains terrain-set) [])
              (fn [terrain]
                (remove-deleted-tile-refs-in-terrain terrain
                                                     (:tileset terrain-set)
                                                     tileset-id
                                                     deleted-ids
                                                     deleted-indices)))))

(defun remove-deleted-tile-refs-in-terrain-sets [terrain-sets tileset-id deleted-ids deleted-indices]
  (map (or terrain-sets [])
       (fn [terrain-set]
         (remove-deleted-tile-refs-in-terrain-set terrain-set
                                                  tileset-id
                                                  deleted-ids
                                                  deleted-indices))))

(defun remove-deleted-tile-refs-in-rulesets [rulesets tileset-id deleted-ids deleted-indices]
  (remove-deleted-tile-refs-in-brush-value (or rulesets [])
                                           tileset-id
                                           deleted-ids
                                           deleted-indices))

(defun remove-deleted-tile-refs-in-substitution-choice
  [choice deleted-ids deleted-indices]
  (let [tile-ref (remove-deleted-tile-ref (:tile choice)
                                          deleted-ids
                                          deleted-indices)]
    (when (not (data/absent-tile-ref? tile-ref))
      (assoc choice :tile tile-ref))))

(defun remove-deleted-tile-refs-in-tile-substitution
  [substitution deleted-ids deleted-indices]
  (if substitution
    (assoc substitution
           :choices
           (filter (map (or (:choices substitution) [])
                        (fn [choice]
                          (remove-deleted-tile-refs-in-substitution-choice
                           choice
                           deleted-ids
                           deleted-indices)))
                   (fn [choice]
                     (not (nil? choice)))))
    substitution))

(defun remove-deleted-tile-refs-in-tile-substitutions
  [tiles deleted-ids deleted-indices]
  (map (or tiles [])
       (fn [tile]
         (if (:substitution tile)
           (assoc tile
                  :substitution
                  (remove-deleted-tile-refs-in-tile-substitution
                   (:substitution tile)
                   deleted-ids
                   deleted-indices))
           tile))))

(defun rename-tile-ref [tile-ref old-id new-id]
  (if (= tile-ref old-id)
    new-id
    tile-ref))

(defun rename-tile-refs-in-layer-with-profile [layer profile tileset-id old-id new-id]
  (if (layer-uses-tileset? layer profile tileset-id)
    (update layer :tiles
            (fn [rows]
              (map (or rows [])
                   (fn [row]
                     (map (or row [])
                          (fn [tile-ref]
                            (rename-tile-ref tile-ref old-id new-id)))))))
    layer))

(defun rename-tile-refs-in-layer [layer tileset-id old-id new-id]
  (rename-tile-refs-in-layer-with-profile layer
                                          nil
                                          tileset-id
                                          old-id
                                          new-id))

(defun rename-tile-refs-in-layers-with-profile [layers profile tileset-id old-id new-id]
  (map (or layers [])
       (fn [layer]
         (rename-tile-refs-in-layer-with-profile layer
                                                 profile
                                                 tileset-id
                                                 old-id
                                                 new-id))))

(defun rename-tile-refs-in-layers [layers tileset-id old-id new-id]
  (map (or layers [])
       (fn [layer]
         (rename-tile-refs-in-layer layer tileset-id old-id new-id))))

(defun rename-tile-refs-in-brush-value [value tileset-id old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (rename-tile-refs-in-brush-value item
                                                     tileset-id
                                                     old-id
                                                     new-id)))
    "map" (let [layer (if (and (:tiles value)
                               (:tileset value))
                        (rename-tile-refs-in-layer value
                                                   tileset-id
                                                   old-id
                                                   new-id)
                        value)]
            (reduce-kv layer
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (rename-tile-refs-in-brush-value item
                                                                 tileset-id
                                                                 old-id
                                                                 new-id)))))
    :default value))

(defun rename-tile-refs-in-brushes [brushes tileset-id old-id new-id]
  (rename-tile-refs-in-brush-value (or brushes []) tileset-id old-id new-id))

(defun rename-tile-ref-key [terrain key old-id new-id]
  (if (contains? terrain key)
    (assoc terrain key (rename-tile-ref (get terrain key) old-id new-id))
    terrain))

(defun rename-tile-refs-in-terrain [terrain terrain-set-tileset tileset-id old-id new-id]
  (if (= (or (:tileset terrain) terrain-set-tileset) tileset-id)
    (reduce [:tile :preview-tile :preview]
            terrain
            (fn [out key]
              (rename-tile-ref-key out key old-id new-id)))
    terrain))

(defun rename-tile-refs-in-terrain-set [terrain-set tileset-id old-id new-id]
  (assoc terrain-set
         :terrains
         (map (or (:terrains terrain-set) [])
              (fn [terrain]
                (rename-tile-refs-in-terrain terrain
                                             (:tileset terrain-set)
                                             tileset-id
                                             old-id
                                             new-id)))))

(defun rename-tile-refs-in-terrain-sets [terrain-sets tileset-id old-id new-id]
  (map (or terrain-sets [])
       (fn [terrain-set]
         (rename-tile-refs-in-terrain-set terrain-set
                                          tileset-id
                                          old-id
                                          new-id))))

(defun rename-tile-refs-in-rulesets [rulesets tileset-id old-id new-id]
  (rename-tile-refs-in-brush-value (or rulesets []) tileset-id old-id new-id))

(defun rename-tile-refs-in-substitution-choice [choice old-id new-id]
  (assoc choice :tile (rename-tile-ref (:tile choice) old-id new-id)))

(defun rename-tile-refs-in-tile-substitution [substitution old-id new-id]
  (if substitution
    (assoc substitution
           :choices
           (map (or (:choices substitution) [])
                (fn [choice]
                  (rename-tile-refs-in-substitution-choice choice
                                                           old-id
                                                           new-id))))
    substitution))

(defun rename-tile-refs-in-tile-substitutions [tiles old-id new-id]
  (map (or tiles [])
       (fn [tile]
         (if (:substitution tile)
           (assoc tile
                  :substitution
                  (rename-tile-refs-in-tile-substitution (:substitution tile)
                                                         old-id
                                                         new-id))
           tile))))

(defun rename-tile-refs-in-layers-for-pairs [layers tileset-id pairs]
  (reduce (or pairs [])
          layers
          (fn [out pair]
            (rename-tile-refs-in-layers out
                                        tileset-id
                                        (:old-id pair)
                                        (:new-id pair)))))

(defun rename-tile-refs-in-layers-for-pairs-with-profile
  [layers profile tileset-id pairs]
  (reduce (or pairs [])
          layers
          (fn [out pair]
            (rename-tile-refs-in-layers-with-profile out
                                                     profile
                                                     tileset-id
                                                     (:old-id pair)
                                                     (:new-id pair)))))

(defun rename-tile-refs-in-brushes-for-pairs [brushes tileset-id pairs]
  (reduce (or pairs [])
          brushes
          (fn [out pair]
            (rename-tile-refs-in-brushes out
                                         tileset-id
                                         (:old-id pair)
                                         (:new-id pair)))))

(defun rename-tile-refs-in-terrain-sets-for-pairs [terrain-sets tileset-id pairs]
  (reduce (or pairs [])
          terrain-sets
          (fn [out pair]
            (rename-tile-refs-in-terrain-sets out
                                              tileset-id
                                              (:old-id pair)
                                              (:new-id pair)))))

(defun rename-tile-refs-in-rulesets-for-pairs [rulesets tileset-id pairs]
  (reduce (or pairs [])
          rulesets
          (fn [out pair]
            (rename-tile-refs-in-rulesets out
                                          tileset-id
                                          (:old-id pair)
                                          (:new-id pair)))))

(defun rename-tile-refs-in-tile-substitutions-for-pairs [tiles pairs]
  (reduce (or pairs [])
          tiles
          (fn [out pair]
            (rename-tile-refs-in-tile-substitutions out
                                                    (:old-id pair)
                                                    (:new-id pair)))))

(defun replace-tile-at-index [tiles index replacement]
  (map (for-indexed [tile-index tile (or tiles [])]
         {:index tile-index
          :tile tile})
       (fn [entry]
         (if (= (:index entry) index)
           replacement
           (:tile entry)))))

(defun remove-tiles-at-indices [tiles indices]
  (map (filter (for-indexed [index tile (or tiles [])]
                 {:index index
                  :tile tile})
               (fn [entry]
                 (not (contains? indices (:index entry)))))
       (fn [entry]
         (:tile entry))))

(defun selected-tile-index-after-delete [selection remaining-count]
  (if (<= remaining-count 0)
    nil
    (min (or (head selection) 0)
         (dec remaining-count))))

(defun delete-tileset-tiles! [state payload]
  (let [tilesets (or (:tilesets state) [])
        tileset-index (:selected-tileset-definition-index state)]
    (if (and (= (:choice payload) :dialog/ok)
             (= (-> payload :payload :operation) :delete-tiles)
             (not (nil? tileset-index))
             (< tileset-index (count tilesets)))
      (let [tileset (nth tilesets tileset-index)
            tiles (or (:tiles tileset) [])
            selection (valid-tile-indices (-> payload :payload :tile-indices)
                                          (count tiles))]
        (if (empty? selection)
          state
          (let [deleted-ids (tile-ids-at-indices tiles selection)
                remaining (remove-deleted-tile-refs-in-tile-substitutions
                           (remove-tiles-at-indices tiles selection)
                           deleted-ids
                           selection)
                next-index (selected-tile-index-after-delete selection
                                                             (count remaining))
                next-selection (if (nil? next-index) [] [next-index])]
            (maps/update-all-map-layers-with-profile
             (assoc (assoc-in state
                              [:tilesets tileset-index :tiles]
                              remaining)
                    :layer-profiles (map (or (:layer-profiles state) [])
                                         (fn [profile]
                                           (assoc profile
                                                  :layers
                                                  (remove-deleted-tile-refs-in-layers
                                                   (:layers profile)
                                                   (:id tileset)
                                                   deleted-ids
                                                   selection))))
                    :brushes (remove-deleted-tile-refs-in-brushes
                              (:brushes state)
                              (:id tileset)
                              deleted-ids
                              selection)
                    :terrain-sets (remove-deleted-tile-refs-in-terrain-sets
                                   (:terrain-sets state)
                                   (:id tileset)
                                   deleted-ids
                                   selection)
                    :rulesets (remove-deleted-tile-refs-in-rulesets
                               (:rulesets state)
                               (:id tileset)
                               deleted-ids
                               selection)
                    :selected-tileset-tile-index next-index
                    :selected-tileset-tile-indices next-selection)
             (fn [layers profile]
               (remove-deleted-tile-refs-in-layers-with-profile
                layers
                profile
                (:id tileset)
                deleted-ids
                selection))))))
      state)))

(defun update-tileset-tiles-at [tilesets index tiles]
  (map (for-indexed [tileset-index tileset (or tilesets [])]
         {:index tileset-index
          :tileset tileset})
       (fn [entry]
         (if (= (:index entry) index)
           (assoc (:tileset entry) :tiles tiles)
           (:tileset entry)))))

(defun move-tileset-tile! [state payload]
  (let [tilesets (or (:tilesets state) [])
        source-index (:source-tileset-index payload)
        target-index (:target-tileset-index payload)
        tile-index (:tile-index payload)]
    (if (or (nil? source-index)
            (nil? target-index)
            (nil? tile-index)
            (= source-index target-index)
            (>= source-index (count tilesets))
            (>= target-index (count tilesets)))
      state
      (let [source-tileset (nth tilesets source-index)
            target-tileset (nth tilesets target-index)
            source-tiles (or (:tiles source-tileset) [])
            target-tiles (or (:tiles target-tileset) [])]
        (if (or (< tile-index 0)
                (>= tile-index (count source-tiles)))
          state
          (let [tile (nth source-tiles tile-index)
                deleted-ids [(:id tile)]
                deleted-indices [tile-index]
                remaining-source
                (remove-deleted-tile-refs-in-tile-substitutions
                 (remove-tiles-at-indices source-tiles deleted-indices)
                 deleted-ids
                 deleted-indices)
                moved-id (keyword (unique-id-from target-tiles
                                                  (keyword-label (:id tile))
                                                  nil))
                moved-tile (dissoc (assoc tile :id moved-id) :substitution)
                target-tile-index (count target-tiles)
                next-tilesets (update-tileset-tiles-at
                               (update-tileset-tiles-at tilesets
                                                        source-index
                                                        remaining-source)
                               target-index
                               (concat target-tiles [moved-tile]))]
            (maps/update-all-map-layers-with-profile
             (assoc state
                    :tilesets next-tilesets
                    :layer-profiles (map (or (:layer-profiles state) [])
                                         (fn [profile]
                                           (assoc profile
                                                  :layers
                                                  (remove-deleted-tile-refs-in-layers
                                                   (:layers profile)
                                                   (:id source-tileset)
                                                   deleted-ids
                                                   deleted-indices))))
                    :brushes (remove-deleted-tile-refs-in-brushes
                              (:brushes state)
                              (:id source-tileset)
                              deleted-ids
                              deleted-indices)
                    :terrain-sets (remove-deleted-tile-refs-in-terrain-sets
                                   (:terrain-sets state)
                                   (:id source-tileset)
                                   deleted-ids
                                   deleted-indices)
                    :rulesets (remove-deleted-tile-refs-in-rulesets
                               (:rulesets state)
                               (:id source-tileset)
                               deleted-ids
                               deleted-indices)
                    :selected-tileset-definition-index target-index
                    :selected-tileset-tile-index target-tile-index
                    :selected-tileset-tile-indices [target-tile-index])
             (fn [layers profile]
               (remove-deleted-tile-refs-in-layers-with-profile
                layers
                profile
                (:id source-tileset)
                deleted-ids
                deleted-indices)))))))))

(defun add-tile-definition! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [tiles (or (:tiles tileset) [])
            id (unique-id-from tiles (kebab-case (:tile-id payload)) nil)
            index (count tiles)
            tile (make-tile-definition id
                                       (:tile-name payload)
                                       (or (:tile-char payload) "")
	                                       (or (:tile-type payload) :color)
	                                       (or (:tile-size tileset)
	                                           data/tile-dim))]
        (assoc-in (assoc state
                         :selected-tileset-tile-index index
                         :selected-tileset-tile-indices [index])
                  [:tilesets tileset-index :tiles]
                  (concat tiles [tile])))
      state)))

(defun rename-tile-definition! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        index (:tile-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (nil? index))
             (< index (count (or (:tiles tileset) [])))
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [tiles (or (:tiles tileset) [])
            old-tile (nth tiles index)
            old-id (:id old-tile)
            new-id (keyword (unique-id-from-except
                             tiles
                             (kebab-case (:tile-id payload))
                             index
                             nil))
            next-tiles
            (rename-tile-refs-in-tile-substitutions
             (replace-tile-at-index
              tiles
              index
              (assoc old-tile
                     :id new-id
                     :name (:tile-name payload)
                     :char (or (:tile-char payload) "")))
             old-id
             new-id)
            next-state (assoc-in state
                                 [:tilesets tileset-index :tiles]
                                 next-tiles)]
        (maps/update-all-map-layers-with-profile
         (assoc next-state
                :layer-profiles (map (or (:layer-profiles next-state) [])
                                     (fn [profile]
                                       (assoc profile
                                              :layers
                                              (rename-tile-refs-in-layers
                                               (:layers profile)
                                               (:id tileset)
                                               old-id
                                               new-id))))
                :brushes (rename-tile-refs-in-brushes (:brushes next-state)
                                                      (:id tileset)
                                                      old-id
                                                      new-id)
                :terrain-sets (rename-tile-refs-in-terrain-sets
                               (:terrain-sets next-state)
                               (:id tileset)
                               old-id
                               new-id)
                :rulesets (rename-tile-refs-in-rulesets (:rulesets next-state)
                                                        (:id tileset)
                                                        old-id
                                                        new-id)
                :selected-tileset-tile-index index
                :selected-tileset-tile-indices [index])
         (fn [layers profile]
           (rename-tile-refs-in-layers-with-profile layers
                                                    profile
                                                    (:id tileset)
                                                    old-id
                                                    new-id))))
      state)))

(defun duplicate-tile-definition! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        index (:tile-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (nil? index))
             (< index (count (or (:tiles tileset) [])))
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [tiles (or (:tiles tileset) [])
            source (nth tiles index)
            old-id (:id source)
            new-id (keyword (unique-id-from tiles
                                            (kebab-case (:tile-id payload))
                                            nil))
            duplicate (assoc source
                             :id new-id
                             :name (:tile-name payload))
            duplicate (if (:substitution duplicate)
                        (assoc duplicate
                               :substitution
                               (rename-tile-refs-in-tile-substitution
                                (:substitution duplicate)
                                old-id
                                new-id))
                        duplicate)
            duplicate-index (inc index)]
        (assoc-in (assoc state
                         :selected-tileset-tile-index duplicate-index
                         :selected-tileset-tile-indices [duplicate-index])
                  [:tilesets tileset-index :tiles]
                  (apply concat
                         (for-indexed [tile-index tile tiles]
                           (if (= tile-index index)
                             [tile duplicate]
                             [tile])))))
      state)))

(defun batch-tile-rename-tile-name [payload ordinal]
  (let [root (or (:tile-name-root payload) "")]
    (if (= (:numbered? payload) false)
      root
      (numbered-tile-name root (+ (or (:start-number payload) 1) ordinal)))))

(defun unique-numbered-tile-id-from [tiles root exclude-index number]
  (let [candidate (numbered-tile-id root number)]
    (if (item-id-exists-except? tiles candidate exclude-index)
      (unique-numbered-tile-id-from tiles root exclude-index (inc number))
      candidate)))

(defun batch-tile-rename-new-id [tiles payload index ordinal]
  (let [root (tile-id-root (:tile-id-root payload))]
    (keyword
     (if (= (:numbered? payload) false)
       (unique-id-from-except tiles root index nil)
       (unique-numbered-tile-id-from tiles
                                    root
                                    index
                                    (+ (or (:start-number payload) 1)
                                       ordinal))))))

(defun batch-tile-rename-pairs-step [tiles entries payload planned ordinal]
  (if (empty? entries)
    planned
    (let [entry (head entries)
          index (:index entry)
          tile (:tile entry)
          new-id (batch-tile-rename-new-id tiles payload index ordinal)
          name (batch-tile-rename-tile-name payload ordinal)]
      (batch-tile-rename-pairs-step
       (map (for-indexed [tile-index next-tile tiles]
              {:index tile-index
               :tile next-tile})
            (fn [next-entry]
              (if (= (:index next-entry) index)
                (assoc (:tile next-entry) :id new-id)
                (:tile next-entry))))
       (tail entries)
       payload
       (concat planned [{:index index
                         :old-id (:id tile)
                         :new-id new-id
                         :name name}])
       (inc ordinal)))))

(defun batch-tile-rename-pairs [tiles indices payload]
  (batch-tile-rename-pairs-step
   (or tiles [])
   (filter (for-indexed [index tile (or tiles [])]
             {:index index
              :tile tile})
           (fn [entry]
             (contains? indices (:index entry))))
   payload
   []
   0))

(defun apply-batch-tile-rename-to-tiles [tiles pairs char]
  (map (for-indexed [index tile (or tiles [])]
         {:index index
          :tile tile})
       (fn [entry]
         (if-let [pair (head (filter (or pairs [])
                                     (fn [pair]
                                       (= (:index pair) (:index entry)))))]
           (assoc (:tile entry)
                  :id (:new-id pair)
                  :name (:name pair)
                  :char (or char ""))
           (:tile entry)))))

(defun rename-tile-definitions! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (blank? (:tile-id-root payload)))
             (not (blank? (:tile-name-root payload))))
      (let [tiles (or (:tiles tileset) [])
            selection (valid-tile-indices (:tile-indices payload)
                                          (count tiles))]
        (if (empty? selection)
          state
          (let [pairs (batch-tile-rename-pairs tiles selection payload)
                next-state (assoc-in
                            state
                            [:tilesets tileset-index :tiles]
                            (rename-tile-refs-in-tile-substitutions-for-pairs
                             (apply-batch-tile-rename-to-tiles
                              tiles
                              pairs
                              (:tile-char payload))
                             pairs))]
            (maps/update-all-map-layers-with-profile
             (assoc next-state
                    :layer-profiles (map (or (:layer-profiles next-state) [])
                                         (fn [profile]
                                           (assoc profile
                                                  :layers
                                                  (rename-tile-refs-in-layers-for-pairs
                                                   (:layers profile)
                                                   (:id tileset)
                                                   pairs))))
                    :brushes (rename-tile-refs-in-brushes-for-pairs
                              (:brushes next-state)
                              (:id tileset)
                              pairs)
                    :terrain-sets (rename-tile-refs-in-terrain-sets-for-pairs
                                   (:terrain-sets next-state)
                                   (:id tileset)
                                   pairs)
                    :rulesets (rename-tile-refs-in-rulesets-for-pairs
                               (:rulesets next-state)
                               (:id tileset)
                               pairs)
                    :selected-tileset-tile-index (head selection)
                    :selected-tileset-tile-indices selection)
             (fn [layers profile]
               (rename-tile-refs-in-layers-for-pairs-with-profile
                layers
                profile
                (:id tileset)
                pairs))))))
      state)))

(defun add-imported-sprite-tiles! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        resource (:resource payload)
        sources (or (:sources payload) [])]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             resource
             (not (empty? sources)))
      (let [existing (or (:tiles tileset) [])
            root (tile-id-root-for-resource resource)
            name-root (tile-name-root-for-resource resource)
            added (reduce (for-indexed [index source sources]
                            {:index (inc index)
                             :source source})
                          []
                          (fn [out entry]
                            (let [id (unique-id-from (concat existing out)
                                                     (str root "-" (:index entry))
                                                     nil)]
                              (concat out
                                      [(make-imported-sprite-tile
                                        resource
                                        (:source entry)
                                        id
                                        (str name-root " " (:index entry)))]))))
            first-index (count existing)]
        (assoc-in (assoc state
                         :selected-tileset-tile-index first-index
                         :selected-tileset-tile-indices [first-index])
                  [:tilesets tileset-index :tiles]
                  (concat existing added)))
      state)))

(defun add-imported-single-sprite-tiles! [state resources]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)]
    (if (and (not (nil? tileset-index))
             tileset
             (not (empty? (or resources []))))
      (let [existing (or (:tiles tileset) [])
	            tile-size (or (:tile-size tileset) data/tile-dim)
            added (reduce (or resources [])
                          []
                          (fn [out resource]
                            (let [root (tile-id-root-for-resource resource)
                                  name-root (tile-name-root-for-resource resource)
                                  id (unique-id-from (concat existing out)
                                                     root
                                                     nil)]
                              (concat out
                                      [(make-imported-sprite-tile
                                        resource
                                        (default-tile-source tile-size)
                                        id
                                        name-root)]))))
            first-index (count existing)]
        (dissoc
         (assoc-in (assoc state
                          :selected-tileset-tile-index first-index
                          :selected-tileset-tile-indices [first-index])
                   [:tilesets tileset-index :tiles]
                   (concat existing added))
         :last-imported-image-resources))
      state)))

(defun add-color-tile-range! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        count (or (:count payload) 8)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [existing (or (:tiles tileset) [])
            root (kebab-case (:tile-id payload))
            name-root (:tile-name payload)
            from-color (or (:from-color payload) default-tile-color)
            to-color (or (:to-color payload) default-tile-color)
            added (reduce (range 0 (dec count))
                          []
                          (fn [out index]
                            (let [id (unique-id-from (concat existing out)
                                                     (str root "-" (inc index))
                                                     nil)]
                              (concat out
                                      [(make-color-tile-definition
                                        id
                                        (str name-root " " (inc index))
                                        (default-tile-char id)
                                        (lerp-color from-color
                                                    to-color
                                                    index
                                                    count))]))))
            first-index (count existing)]
        (assoc-in (assoc state
                         :selected-tileset-tile-index first-index
                         :selected-tileset-tile-indices [first-index])
                  [:tilesets tileset-index :tiles]
                  (concat existing added)))
      state)))

(defun set-selected-tile-type [state type]
  (update-selected-tile state
                        (fn [tile]
                          (tile-with-type tile
                                          type
                                          (selected-tileset-tile-size state)))))

(defun set-selected-tile-color-channel [state channel value]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile (tile-with-type tile
                                                     :color
                                                     (selected-tileset-tile-size state))]
                            (assoc tile
                                   :color (assoc (or (:color tile)
                                                     default-tile-color)
                                                 channel
                                                 value))))))

(defun source-snap-interval [tile-size value]
  (let [tile-size (data/map-tile-dim tile-size)]
    (if (= (type-of value) "map")
      (:w (data/map-tile-dim value))
      (max 1 (or value (:w tile-size))))))

(defun source-snap-dim [tile-size value]
  (let [tile-size (data/map-tile-dim tile-size)]
    (cond
      (= (type-of value) "map")
      (data/map-tile-dim value)

      (nil? value)
      tile-size

      :default
      (let [interval (source-snap-interval tile-size value)]
        {:w interval :h interval}))))

(defun clamp-source-coordinate [value max-value tile-size snap-to-grid? snap-interval]
  (let [max-coordinate (max 0 (- max-value tile-size))
        clamped (max 0 (min value max-coordinate))]
    (if snap-to-grid?
      (* snap-interval (int (/ clamped snap-interval)))
      (int clamped))))

(defun source-with-position [source x y tile-size dim snap-to-grid? snap-interval]
  (let [tile-size (data/map-tile-dim tile-size)
        snap-dim (source-snap-dim tile-size snap-interval)]
    {:x (clamp-source-coordinate x
                                 (:w dim)
                                 (:w tile-size)
                                 snap-to-grid?
                                 (:w snap-dim))
     :y (clamp-source-coordinate y
                                 (:h dim)
                                 (:h tile-size)
                                 snap-to-grid?
                                 (:h snap-dim))
     :w (:w tile-size)
     :h (:h tile-size)}))

(defun source-grid-columns [dim tile-size]
  (max 1 (int (/ (:w dim) (:w (data/map-tile-dim tile-size))))))

(defun source-grid-rows [dim tile-size]
  (max 1 (int (/ (:h dim) (:h (data/map-tile-dim tile-size))))))

(defun source-grid-count [dim tile-size]
  (* (source-grid-columns dim tile-size)
     (source-grid-rows dim tile-size)))

(defun source-index-rect [index dim tile-size]
  (let [tile-size (data/map-tile-dim tile-size)
        columns (source-grid-columns dim tile-size)]
    {:x (* (mod index columns) (:w tile-size))
     :y (* (int (/ index columns)) (:h tile-size))
     :w (:w tile-size)
     :h (:h tile-size)}))

(defun source-grid-columns-for-interval [dim tile-size interval]
  (let [tile-size (data/map-tile-dim tile-size)
        interval (source-snap-dim tile-size interval)]
    (max 1 (inc (int (/ (max 0 (- (:w dim) (:w tile-size)))
                        (:w interval)))))))

(defun source-grid-rows-for-interval [dim tile-size interval]
  (let [tile-size (data/map-tile-dim tile-size)
        interval (source-snap-dim tile-size interval)]
    (max 1 (inc (int (/ (max 0 (- (:h dim) (:h tile-size)))
                        (:h interval)))))))

(defun source-grid-count-for-interval [dim tile-size interval]
  (* (source-grid-columns-for-interval dim tile-size interval)
     (source-grid-rows-for-interval dim tile-size interval)))

(defun source-index-rect-for-interval [index dim tile-size interval]
  (let [tile-size (data/map-tile-dim tile-size)
        interval (source-snap-dim tile-size interval)
        columns (source-grid-columns-for-interval dim tile-size interval)]
    {:x (* (mod index columns) (:w interval))
     :y (* (int (/ index columns)) (:h interval))
     :w (:w tile-size)
     :h (:h tile-size)}))

(defun same-source? [a b]
  (and (= (:x a) (:x b))
       (= (:y a) (:y b))
       (= (:w a) (:w b))
       (= (:h a) (:h b))))

(defun sprite-tile-uses-source? [tile image source]
  (and (= (:type tile) :sprite)
       (= (:image tile) image)
       (same-source? (:source tile) source)))

(defun tileset-uses-source? [tileset image source]
  (> (count (filter (or (:tiles tileset) [])
                    (fn [tile]
                      (sprite-tile-uses-source? tile image source))))
     0))

(defun project-uses-source? [tilesets image source]
  (> (count (filter (or tilesets [])
                    (fn [tileset]
                      (tileset-uses-source? tileset image source))))
     0))

(defun import-source-snap-interval [state]
  (let [tile-size (data/map-tile-dim (:tile-size state))]
    (if (:source-snap-interval-custom? state)
      (source-snap-interval tile-size (:source-snap-interval state))
      tile-size)))

(defun selected-source-indices [state dim]
  (let [tile-size (data/map-tile-dim (:tile-size state))
        interval (import-source-snap-interval state)]
    (if (:select-all? state)
      (range 0 (dec (source-grid-count-for-interval dim tile-size interval)))
      (or (:selected-source-indices state) []))))

(defun selected-source-rects [state dim]
  (let [tile-size (data/map-tile-dim (:tile-size state))
        interval (import-source-snap-interval state)]
    (if (:select-all? state)
      (map (selected-source-indices state dim)
           (fn [index]
             (source-index-rect-for-interval index dim tile-size interval)))
      (if (:selected-sources state)
        (or (:selected-sources state) [])
        (map (selected-source-indices state dim)
             (fn [index]
               (source-index-rect-for-interval index dim tile-size interval)))))))

(defun import-source-included? [state image source]
  (let [tileset (selected-tileset-definition state)
        same? (tileset-uses-source? tileset image source)
        project? (project-uses-source? (:tilesets state) image source)]
    (not (or (and (:exclude-same-tileset? state) same?)
             (and (:exclude-project? state) project?)))))

(defun import-source-rects [state image dim]
  (filter (selected-source-rects state dim)
          (fn [source]
            (import-source-included? state image source))))

(defun tile-id-root-for-resource [resource]
  (kebab-case (or (:name resource)
                  (keyword-label (:id resource))
                  "tile")))

(defun tile-name-root-for-resource [resource]
  (label-from-id (tile-id-root-for-resource resource)))

(defun make-imported-sprite-tile [resource source id name]
  {:id (keyword id)
   :name name
   :char (default-tile-char id)
   :type :sprite
   :image (:key resource)
   :source source})

(defun set-selected-tile-source-position [state x y dim]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile-size (selected-tileset-tile-size state)
                                tile (tile-with-type tile :sprite tile-size)]
                            (assoc tile
                                   :source (source-with-position (:source tile)
                                                                 x
                                                                 y
                                                                 tile-size
                                                                 dim
                                                                 true
                                                                 tile-size))))))

(defun set-selected-tile-source [state source]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile-size (selected-tileset-tile-size state)
                                tile (tile-with-type tile :sprite tile-size)]
                            (assoc tile
                                   :source (assoc (merge (default-tile-source
                                                          tile-size)
                                                         source)
                                                  :w (:w tile-size)
                                                  :h (:h tile-size)))))))

(defun set-selected-tile-sprite [state payload]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile-size (selected-tileset-tile-size state)
                                tile (tile-with-type tile :sprite tile-size)
                                source (:source payload)]
                            (assoc tile
                                   :image (:image payload)
                                   :source (assoc (merge (default-tile-source
                                                          tile-size)
                                                         source)
                                                  :w (:w tile-size)
                                                  :h (:h tile-size)))))))

(defun selected-tileset-definition-indices [state]
  (if (nil? (:selected-tileset-definition-index state))
    []
    [(:selected-tileset-definition-index state)]))

(defun derive-tileset-workspace-state [state]
  (assoc state
         :tile-set-panel-disabled? (nil? (:selected-tileset-definition-index state))
         :has-project-image-resources? (has-project-image-resources?
                                        (:resources state))
         :tile-definition-panel-disabled? (or (nil? (:selected-tileset-definition-index state))
                                              (nil? (:selected-tileset-tile-index state)))))
