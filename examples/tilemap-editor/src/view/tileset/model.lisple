(ns tilemap-editor.view.tileset.model
  (:require pixils
            [lisple.io :as io]
            [tilemap-editor.model.data :as data]))

(def tile-grid-cell-size data/tile-size)

(def tile-grid-gap 0)

(def tile-type-options
  [{:value :color
    :label "Color"}
   {:value :sprite
    :label "Sprite"}])

(def default-tile-color {:r 0x00 :g 0x00 :b 0x00})

(def default-tile-image nil)

(def default-import-bundle :project-assets)

(defun clean-name-separators [value index out]
  (if (>= index (count value))
    (trim out)
    (let [ch (substr value index 1)]
      (clean-name-separators
       value
       (inc index)
       (str out
            (if (or (= ch "-") (= ch "_"))
              " "
              ch))))))

(defun label-from-id [id]
  (capitalize (clean-name-separators id 0 "")))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun item-id-exists? [items id]
  (> (count (filter (or items [])
                    (fn [item]
                      (= (:id item) (keyword id)))))
     0))

(defun item-id-exists-except? [items id exclude-index]
  (> (count (filter (for-indexed [index item (or items [])]
                      {:index index
                       :item item})
                    (fn [entry]
                      (and (= (:id (:item entry)) (keyword id))
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-id-from [items root suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)]
    (if (item-id-exists? items candidate)
      (unique-id-from items
                      root
                      (if suffix (inc suffix) 2))
      candidate)))

(defun unique-id-from-except [items root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)]
    (if (item-id-exists-except? items candidate exclude-index)
      (unique-id-from-except items
                             root
                             exclude-index
                             (if suffix (inc suffix) 2))
      candidate)))

(defun unique-tileset-id [tilesets]
  (unique-id-from (or tilesets []) "tile-set" nil))

(defun unique-tile-id [tiles]
  (unique-id-from (or tiles []) "tile" nil))

(defun unique-color-tile-id [tiles]
  (unique-id-from (or tiles []) "color" nil))

(defun default-tile-char [id]
  (if (> (count id) 0)
    (substr id 0 1)
    ""))

(defun file-stem [path]
  (let [name (io/basename path)
        extension (io/extension name)]
    (if (blank? extension)
      name
      (substr name 0 (- (count name) (count extension))))))

(defun default-resource-id [path]
  (kebab-case (file-stem path)))

(defun default-resource-name [path]
  (label-from-id (default-resource-id path)))

(defun image-resource-key [bundle-id resource-id]
  (keyword (str (keyword-label bundle-id)
                "/"
                (keyword-label resource-id))))

(defun project-bundle-entries [resources]
  (let [bundles (or (:bundles resources) {})]
    (map (keys bundles)
         (fn [bundle-id]
           {:id bundle-id
            :bundle (get bundles bundle-id)}))))

(defun static-project-bundle-id? [bundle-id]
  (= bundle-id :editor-assets))

(defun dynamic-bundle-entry? [entry]
  (not (static-project-bundle-id? (:id entry))))

(defun dynamic-project-bundle-entries [resources]
  (filter (project-bundle-entries resources) dynamic-bundle-entry?))

(defun first-dynamic-bundle-id [resources]
  (if-let [entry (head (dynamic-project-bundle-entries resources))]
    (:id entry)
    nil))

(defun bundle-options [resources]
  (for-indexed [index entry (dynamic-project-bundle-entries resources)]
    {:value (:id entry)
     :id (:id entry)
     :label (keyword-label (:id entry))}))

(defun bundle-index-by-id [options id]
  (find-index (or options [])
              (fn [option]
                (= (:id option) id))))

(defun bundle-id-at-index [options index]
  (when (and (not (nil? index))
             (< index (count (or options []))))
    (:id (nth options index))))

(defun image-resource-entries-for-bundle [resources bundle-id]
  (let [images (or (get-in resources [:bundles bundle-id :images]) {})]
    (map (keys images)
         (fn [resource-id]
           (let [dependency (get images resource-id)]
             {:id resource-id
              :bundle-id bundle-id
              :key (image-resource-key bundle-id resource-id)
              :name (or (:name dependency)
                        (keyword-label resource-id))
              :file-name (:file-name dependency)})))))

(defun image-resource-entries [resources]
  (reduce (dynamic-project-bundle-entries resources)
          []
          (fn [out entry]
            (concat out
                    (image-resource-entries-for-bundle resources (:id entry))))))

(defun has-project-image-resources? [resources]
  (not (empty? (image-resource-entries resources))))

(defun image-resource-options [resources bundle-id]
  (for-indexed [index resource (image-resource-entries-for-bundle resources
                                                                  bundle-id)]
    (merge resource
           {:value index
            :label (str (:key resource) "  " (:name resource))})))

(defun resource-index-by-key [options key]
  (find-index (or options [])
              (fn [option]
                (= (:key option) key))))

(defun selected-resource-option [state]
  (let [options (:resource-options state)
        index (:selected-resource-index state)]
    (when (and (not (nil? index))
               (< index (count (or options []))))
      (nth options index))))

(defun default-tile-source [tile-size]
  {:x 0 :y 0 :w tile-size :h tile-size})

(defun tile-grid-stride []
  (+ tile-grid-cell-size tile-grid-gap))

(defun clamp-index [index item-count]
  (if (<= item-count 0)
    nil
    (max 0 (min (or index 0) (dec item-count)))))

(defun tile-grid-columns [bounds]
  (max 1 (int (/ (+ (max 1 (:w bounds)) tile-grid-gap)
                 (tile-grid-stride)))))

(defun tile-grid-index-at-position [position bounds item-count]
  (let [stride (tile-grid-stride)
        col (int (/ (:x position) stride))
        row (int (/ (:y position) stride))
        index (+ col (* row (tile-grid-columns bounds)))]
    (if (and (>= (:x position) 0)
             (>= (:y position) 0)
             (< (mod (:x position) stride) tile-grid-cell-size)
             (< (mod (:y position) stride) tile-grid-cell-size)
             (< index item-count))
      index
      nil)))

(defun move-tile-grid-index [index item-count columns delta]
  (clamp-index (+ (or index 0) delta) item-count))

(defun valid-tile-indices [indices item-count]
  (filter (or indices [])
          (fn [index]
            (and (number? index)
                 (>= index 0)
                 (< index item-count)))))

(defun selected-tileset-tile-selection [state]
  (let [tiles (selected-tileset-tiles state)
        selection (valid-tile-indices (:selected-tileset-tile-indices state)
                                      (count tiles))]
    (if (or (not (empty? selection))
            (nil? (:selected-tileset-tile-index state)))
      selection
      (valid-tile-indices [(:selected-tileset-tile-index state)]
                          (count tiles)))))

(defun tile-grid-selection-range [anchor index columns item-count]
  (let [columns (max 1 (or columns 1))
        start (min (or anchor index 0) (or index anchor 0))
        end (max (or anchor index 0) (or index anchor 0))
        start-col (mod start columns)
        start-row (int (/ start columns))
        end-col (mod end columns)
        end-row (int (/ end columns))
        left (min start-col end-col)
        right (max start-col end-col)
        top (min start-row end-row)
        bottom (max start-row end-row)]
    (reduce (range top bottom)
            []
            (fn [out row]
              (concat out
                      (filter (map (range left right)
                                   (fn [col]
                                     (+ col (* row columns))))
                              (fn [tile-index]
                                (< tile-index item-count))))))))

(defun select-tileset-tile-index [state index]
  (assoc state
         :selected-tileset-tile-index index
         :selected-tileset-tile-indices (if (nil? index) [] [index])
         :tile-grid-selection-anchor index))

(defun select-tileset-tile-range [state anchor index columns item-count]
  (let [selection (tile-grid-selection-range anchor index columns item-count)]
    (assoc state
           :selected-tileset-tile-index index
           :selected-tileset-tile-indices selection)))

(defun selected-tileset-definition [state]
  (let [tilesets (or (:tilesets state) [])]
    (when (> (count tilesets) 0)
      (nth tilesets
           (min (or (:selected-tileset-definition-index state) 0)
                (dec (count tilesets)))))))

(defun selected-tileset-tiles [state]
  (or (:tiles (selected-tileset-definition state)) []))

(defun selected-tileset-tile-size [state]
  (or (:tile-size (selected-tileset-definition state))
      data/tile-size))

(defun selected-tileset-tile [state]
  (let [tiles (selected-tileset-tiles state)
        index (:selected-tileset-tile-index state)]
    (when (and (not (nil? index))
               (> (count tiles) 0))
      (nth tiles (min index (dec (count tiles)))))))

(defun selected-tile-path [state]
  (let [tilesets (or (:tilesets state) [])
        tileset-index (:selected-tileset-definition-index state)
        tile-index (:selected-tileset-tile-index state)]
    (when (and (not (nil? tileset-index))
               (not (nil? tile-index))
               (< tileset-index (count tilesets))
               (< tile-index (count (or (:tiles (nth tilesets tileset-index)) []))))
      [:tilesets tileset-index :tiles tile-index])))

(defun update-selected-tile [state update-fn]
  (if-let [path (selected-tile-path state)]
    (assoc-in state path (update-fn (get-in state path)))
    state))

(defun tile-type-index [tile]
  (let [match (find-index tile-type-options
                          (fn [option]
                            (= (:value option) (:type tile))))]
    (or match 0)))

(defun tile-with-type [tile type tile-size]
  (case type
    :color
    (assoc tile
           :type :color
           :color (or (:color tile) default-tile-color))

    :sprite
    (assoc tile
           :type :sprite
           :image (or (:image tile) default-tile-image)
           :source (assoc (merge (default-tile-source tile-size)
                                 (or (:source tile) {}))
                          :w tile-size
                          :h tile-size))

    :default
    (assoc tile :type type)))

(defun tile-with-size [tile tile-size]
  (if (or (= (:type tile) :sprite)
          (:source tile))
    (assoc tile
           :source (assoc (merge (default-tile-source tile-size)
                                 (or (:source tile) {}))
                          :w tile-size
                          :h tile-size))
    tile))

(defun tileset-with-tile-size [tileset tile-size]
  (assoc (assoc tileset
                :tile-size tile-size)
         :tiles (map (or (:tiles tileset) [])
                     (fn [tile]
                       (tile-with-size tile tile-size)))))

(defun make-tileset-definition [id label tile-size]
  {:id (keyword id)
   :label label
   :tile-size tile-size
   :tiles []})

(defun make-tile-definition [id name ch type tile-size]
  (tile-with-type {:id (keyword id)
                   :name name
                   :char ch}
                  type
                  tile-size))

(defun make-color-tile-definition [id name ch color]
  {:id (keyword id)
   :name name
   :char ch
   :type :color
   :color color})

(defun lerp-channel [from to index steps]
  (if (<= steps 0)
    from
    (int (+ from
            (/ (* (- to from) index)
               steps)))))

(defun lerp-color [from to index count]
  (let [steps (dec count)]
    {:r (lerp-channel (:r from) (:r to) index steps)
     :g (lerp-channel (:g from) (:g to) index steps)
     :b (lerp-channel (:b from) (:b to) index steps)}))

(defun add-tileset-definition! [state payload]
  (if (and (= (:type payload) :confirm)
           (not (blank? (:tileset-id payload)))
           (not (blank? (:tileset-label payload))))
    (let [tilesets (or (:tilesets state) [])
          id (unique-id-from tilesets (kebab-case (:tileset-id payload)) nil)
          index (count tilesets)
          tileset (make-tileset-definition id
                                           (:tileset-label payload)
                                           (or (:tile-size payload)
                                               data/tile-size))]
      (assoc state
             :tilesets (concat tilesets [tileset])
             :selected-tileset-definition-index index
             :selected-tileset-tile-index nil
             :selected-tileset-tile-indices []))
    state))

(defun rename-tileset-in-brush-value [value old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (rename-tileset-in-brush-value item old-id new-id)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (rename-tileset-in-brush-value
                               (if (and (= key :tileset)
                                        (= item old-id))
                                 new-id
                                 item)
                               old-id
                               new-id))))
    :default value))

(defun rename-tileset-in-brushes [brushes old-id new-id]
  (rename-tileset-in-brush-value (or brushes []) old-id new-id))

(defun rename-tileset-references [state old-id new-id]
  (assoc
   (assoc (assoc state
                 :layers (map (or (:layers state) [])
                              (fn [layer]
                                (if (= (:tileset layer) old-id)
                                  (assoc layer :tileset new-id)
                                  layer))))
          :brushes (rename-tileset-in-brushes (:brushes state) old-id new-id))
   :tileset (if (= (:tileset state) old-id)
              new-id
              (:tileset state))))

(defun edit-tileset-definition! [state payload]
  (let [tilesets (or (:tilesets state) [])
        index (:tileset-index payload)]
    (if (and (= (:type payload) :confirm)
             (not (nil? index))
             (< index (count tilesets))
             (not (blank? (:tileset-id payload)))
             (not (blank? (:tileset-label payload))))
      (let [old-tileset (nth tilesets index)
            old-id (:id old-tileset)
            tile-size (or (:tile-size payload)
                          data/tile-size)
            new-id (keyword (unique-id-from-except
                             tilesets
                             (kebab-case (:tileset-id payload))
                             index
                             nil))
            next-state (assoc-in
                        state
                        [:tilesets index]
                        (assoc (tileset-with-tile-size old-tileset tile-size)
                               :id new-id
                               :label (:tileset-label payload)))]
        (assoc (rename-tileset-references next-state old-id new-id)
               :selected-tileset-definition-index index))
      state)))

(defun tile-ids-at-indices [tiles indices]
  (map (filter (for-indexed [index tile (or tiles [])]
                 {:index index
                  :tile tile})
               (fn [entry]
                 (contains? indices (:index entry))))
       (fn [entry]
         (:id (:tile entry)))))

(defun deleted-index-count-before [indices index]
  (count (filter (or indices [])
                 (fn [deleted-index]
                   (< deleted-index index)))))

(defun remove-deleted-tile-ref [tile-ref deleted-ids deleted-indices]
  (cond
    (nil? tile-ref)
    nil

    (keyword? tile-ref)
    (if (contains? deleted-ids tile-ref)
      nil
      tile-ref)

    (number? tile-ref)
    (cond
      (contains? deleted-indices tile-ref) nil
      :default (- tile-ref
                  (deleted-index-count-before deleted-indices tile-ref)))

    :default
    tile-ref))

(defun remove-deleted-tile-refs-in-layer [layer tileset-id deleted-ids deleted-indices]
  (if (= (:tileset layer) tileset-id)
    (update layer :tiles
            (fn [rows]
              (map (or rows [])
                   (fn [row]
                     (map (or row [])
                          (fn [tile-ref]
                            (remove-deleted-tile-ref tile-ref
                                                     deleted-ids
                                                     deleted-indices)))))))
    layer))

(defun remove-deleted-tile-refs-in-layers [layers tileset-id deleted-ids deleted-indices]
  (map (or layers [])
       (fn [layer]
         (remove-deleted-tile-refs-in-layer layer
                                            tileset-id
                                            deleted-ids
                                            deleted-indices))))

(defun remove-deleted-tile-refs-in-brush-value [value tileset-id deleted-ids deleted-indices]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (remove-deleted-tile-refs-in-brush-value item
                                                             tileset-id
                                                             deleted-ids
                                                             deleted-indices)))
    "map" (let [layer (if (and (:tiles value)
                               (:tileset value))
                        (remove-deleted-tile-refs-in-layer value
                                                           tileset-id
                                                           deleted-ids
                                                           deleted-indices)
                        value)]
            (reduce-kv layer
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (remove-deleted-tile-refs-in-brush-value
                                 item
                                 tileset-id
                                 deleted-ids
                                 deleted-indices)))))
    :default value))

(defun remove-deleted-tile-refs-in-brushes [brushes tileset-id deleted-ids deleted-indices]
  (remove-deleted-tile-refs-in-brush-value (or brushes [])
                                           tileset-id
                                           deleted-ids
                                           deleted-indices))

(defun remove-tiles-at-indices [tiles indices]
  (map (filter (for-indexed [index tile (or tiles [])]
                 {:index index
                  :tile tile})
               (fn [entry]
                 (not (contains? indices (:index entry)))))
       (fn [entry]
         (:tile entry))))

(defun selected-tile-index-after-delete [selection remaining-count]
  (if (<= remaining-count 0)
    nil
    (min (or (head selection) 0)
         (dec remaining-count))))

(defun delete-tileset-tiles! [state payload]
  (let [tilesets (or (:tilesets state) [])
        tileset-index (:selected-tileset-definition-index state)]
    (if (and (= (:choice payload) :dialog/ok)
             (= (-> payload :payload :operation) :delete-tiles)
             (not (nil? tileset-index))
             (< tileset-index (count tilesets)))
      (let [tileset (nth tilesets tileset-index)
            tiles (or (:tiles tileset) [])
            selection (valid-tile-indices (-> payload :payload :tile-indices)
                                          (count tiles))]
        (if (empty? selection)
          state
          (let [deleted-ids (tile-ids-at-indices tiles selection)
                remaining (remove-tiles-at-indices tiles selection)
                next-index (selected-tile-index-after-delete selection
                                                             (count remaining))
                next-selection (if (nil? next-index) [] [next-index])]
            (assoc (assoc-in state
                             [:tilesets tileset-index :tiles]
                             remaining)
                   :layers (remove-deleted-tile-refs-in-layers
                            (:layers state)
                            (:id tileset)
                            deleted-ids
                            selection)
                   :brushes (remove-deleted-tile-refs-in-brushes
                             (:brushes state)
                             (:id tileset)
                             deleted-ids
                             selection)
                   :selected-tileset-tile-index next-index
                   :selected-tileset-tile-indices next-selection))))
      state)))

(defun add-tile-definition! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [tiles (or (:tiles tileset) [])
            id (unique-id-from tiles (kebab-case (:tile-id payload)) nil)
            index (count tiles)
            tile (make-tile-definition id
                                       (:tile-name payload)
                                       (or (:tile-char payload) "")
                                       (or (:tile-type payload) :color)
                                       (or (:tile-size tileset)
                                           data/tile-size))]
        (assoc-in (assoc state
                         :selected-tileset-tile-index index
                         :selected-tileset-tile-indices [index])
                  [:tilesets tileset-index :tiles]
                  (concat tiles [tile])))
      state)))

(defun add-imported-sprite-tiles! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        resource (:resource payload)
        sources (or (:sources payload) [])]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             resource
             (not (empty? sources)))
      (let [existing (or (:tiles tileset) [])
            root (tile-id-root-for-resource resource)
            name-root (tile-name-root-for-resource resource)
            added (reduce (for-indexed [index source sources]
                            {:index (inc index)
                             :source source})
                          []
                          (fn [out entry]
                            (let [id (unique-id-from (concat existing out)
                                                     (str root "-" (:index entry))
                                                     nil)]
                              (concat out
                                      [(make-imported-sprite-tile
                                        resource
                                        (:source entry)
                                        id
                                        (str name-root " " (:index entry)))]))))
            first-index (count existing)]
        (assoc-in (assoc state
                         :selected-tileset-tile-index first-index
                         :selected-tileset-tile-indices [first-index])
                  [:tilesets tileset-index :tiles]
                  (concat existing added)))
      state)))

(defun add-imported-single-sprite-tiles! [state resources]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)]
    (if (and (not (nil? tileset-index))
             tileset
             (not (empty? (or resources []))))
      (let [existing (or (:tiles tileset) [])
            tile-size (or (:tile-size tileset) data/tile-size)
            added (reduce (or resources [])
                          []
                          (fn [out resource]
                            (let [root (tile-id-root-for-resource resource)
                                  name-root (tile-name-root-for-resource resource)
                                  id (unique-id-from (concat existing out)
                                                     root
                                                     nil)]
                              (concat out
                                      [(make-imported-sprite-tile
                                        resource
                                        (default-tile-source tile-size)
                                        id
                                        name-root)]))))
            first-index (count existing)]
        (dissoc
         (assoc-in (assoc state
                          :selected-tileset-tile-index first-index
                          :selected-tileset-tile-indices [first-index])
                   [:tilesets tileset-index :tiles]
                   (concat existing added))
         :last-imported-image-resources))
      state)))

(defun add-color-tile-range! [state payload]
  (let [tileset-index (:selected-tileset-definition-index state)
        tileset (selected-tileset-definition state)
        count (or (:count payload) 8)]
    (if (and (= (:type payload) :confirm)
             (not (nil? tileset-index))
             tileset
             (not (blank? (:tile-id payload)))
             (not (blank? (:tile-name payload))))
      (let [existing (or (:tiles tileset) [])
            root (kebab-case (:tile-id payload))
            name-root (:tile-name payload)
            from-color (or (:from-color payload) default-tile-color)
            to-color (or (:to-color payload) default-tile-color)
            added (reduce (range 0 (dec count))
                          []
                          (fn [out index]
                            (let [id (unique-id-from (concat existing out)
                                                     (str root "-" (inc index))
                                                     nil)]
                              (concat out
                                      [(make-color-tile-definition
                                        id
                                        (str name-root " " (inc index))
                                        (default-tile-char id)
                                        (lerp-color from-color
                                                    to-color
                                                    index
                                                    count))]))))
            first-index (count existing)]
        (assoc-in (assoc state
                         :selected-tileset-tile-index first-index
                         :selected-tileset-tile-indices [first-index])
                  [:tilesets tileset-index :tiles]
                  (concat existing added)))
      state)))

(defun set-selected-tile-type [state type]
  (update-selected-tile state
                        (fn [tile]
                          (tile-with-type tile
                                          type
                                          (selected-tileset-tile-size state)))))

(defun set-selected-tile-color-channel [state channel value]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile (tile-with-type tile
                                                     :color
                                                     (selected-tileset-tile-size state))]
                            (assoc tile
                                   :color (assoc (or (:color tile)
                                                     default-tile-color)
                                                 channel
                                                 value))))))

(defun source-snap-interval [tile-size value]
  (max 1 (or value tile-size)))

(defun clamp-source-coordinate [value max-value tile-size snap-to-grid? snap-interval]
  (let [max-coordinate (max 0 (- max-value tile-size))
        clamped (max 0 (min value max-coordinate))]
    (if snap-to-grid?
      (* snap-interval (int (/ clamped snap-interval)))
      (int clamped))))

(defun source-with-position [source x y tile-size dim snap-to-grid? snap-interval]
  (let [snap-interval (source-snap-interval tile-size snap-interval)]
    {:x (clamp-source-coordinate x
                                 (:w dim)
                                 tile-size
                                 snap-to-grid?
                                 snap-interval)
     :y (clamp-source-coordinate y
                                 (:h dim)
                                 tile-size
                                 snap-to-grid?
                                 snap-interval)
     :w tile-size
     :h tile-size}))

(defun source-grid-columns [dim tile-size]
  (max 1 (int (/ (:w dim) tile-size))))

(defun source-grid-rows [dim tile-size]
  (max 1 (int (/ (:h dim) tile-size))))

(defun source-grid-count [dim tile-size]
  (* (source-grid-columns dim tile-size)
     (source-grid-rows dim tile-size)))

(defun source-index-rect [index dim tile-size]
  (let [columns (source-grid-columns dim tile-size)]
    {:x (* (mod index columns) tile-size)
     :y (* (int (/ index columns)) tile-size)
     :w tile-size
     :h tile-size}))

(defun source-grid-columns-for-interval [dim tile-size interval]
  (max 1 (inc (int (/ (max 0 (- (:w dim) tile-size))
                      interval)))))

(defun source-grid-rows-for-interval [dim tile-size interval]
  (max 1 (inc (int (/ (max 0 (- (:h dim) tile-size))
                      interval)))))

(defun source-grid-count-for-interval [dim tile-size interval]
  (* (source-grid-columns-for-interval dim tile-size interval)
     (source-grid-rows-for-interval dim tile-size interval)))

(defun source-index-rect-for-interval [index dim tile-size interval]
  (let [columns (source-grid-columns-for-interval dim tile-size interval)]
    {:x (* (mod index columns) interval)
     :y (* (int (/ index columns)) interval)
     :w tile-size
     :h tile-size}))

(defun same-source? [a b]
  (and (= (:x a) (:x b))
       (= (:y a) (:y b))
       (= (:w a) (:w b))
       (= (:h a) (:h b))))

(defun sprite-tile-uses-source? [tile image source]
  (and (= (:type tile) :sprite)
       (= (:image tile) image)
       (same-source? (:source tile) source)))

(defun tileset-uses-source? [tileset image source]
  (> (count (filter (or (:tiles tileset) [])
                    (fn [tile]
                      (sprite-tile-uses-source? tile image source))))
     0))

(defun project-uses-source? [tilesets image source]
  (> (count (filter (or tilesets [])
                    (fn [tileset]
                      (tileset-uses-source? tileset image source))))
     0))

(defun import-source-snap-interval [state]
  (let [tile-size (:tile-size state)]
    (if (:source-snap-interval-custom? state)
      (source-snap-interval tile-size (:source-snap-interval state))
      tile-size)))

(defun selected-source-indices [state dim]
  (let [tile-size (:tile-size state)
        interval (import-source-snap-interval state)]
    (if (:select-all? state)
      (range 0 (dec (source-grid-count-for-interval dim tile-size interval)))
      (or (:selected-source-indices state) []))))

(defun selected-source-rects [state dim]
  (let [tile-size (:tile-size state)
        interval (import-source-snap-interval state)]
    (if (:select-all? state)
      (map (selected-source-indices state dim)
           (fn [index]
             (source-index-rect-for-interval index dim tile-size interval)))
      (if (:selected-sources state)
        (or (:selected-sources state) [])
        (map (selected-source-indices state dim)
             (fn [index]
               (source-index-rect-for-interval index dim tile-size interval)))))))

(defun import-source-included? [state image source]
  (let [tileset (selected-tileset-definition state)
        same? (tileset-uses-source? tileset image source)
        project? (project-uses-source? (:tilesets state) image source)]
    (not (or (and (:exclude-same-tileset? state) same?)
             (and (:exclude-project? state) project?)))))

(defun import-source-rects [state image dim]
  (filter (selected-source-rects state dim)
          (fn [source]
            (import-source-included? state image source))))

(defun tile-id-root-for-resource [resource]
  (kebab-case (or (:name resource)
                  (keyword-label (:id resource))
                  "tile")))

(defun tile-name-root-for-resource [resource]
  (label-from-id (tile-id-root-for-resource resource)))

(defun make-imported-sprite-tile [resource source id name]
  {:id (keyword id)
   :name name
   :char (default-tile-char id)
   :type :sprite
   :image (:key resource)
   :source source})

(defun set-selected-tile-source-position [state x y dim]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile-size (selected-tileset-tile-size state)
                                tile (tile-with-type tile :sprite tile-size)]
                            (assoc tile
                                   :source (source-with-position (:source tile)
                                                                 x
                                                                 y
                                                                 tile-size
                                                                 dim
                                                                 true
                                                                 tile-size))))))

(defun set-selected-tile-source [state source]
  (update-selected-tile state
                        (fn [tile]
                          (let [tile-size (selected-tileset-tile-size state)
                                tile (tile-with-type tile :sprite tile-size)]
                            (assoc tile
                                   :source (assoc source
                                                  :w tile-size
                                                  :h tile-size))))))

(defun selected-tileset-definition-indices [state]
  (if (nil? (:selected-tileset-definition-index state))
    []
    [(:selected-tileset-definition-index state)]))

(defun derive-tileset-workspace-state [state]
  (assoc state
         :tile-set-panel-disabled? (nil? (:selected-tileset-definition-index state))
         :has-project-image-resources? (has-project-image-resources?
                                        (:resources state))
         :tile-definition-panel-disabled? (or (nil? (:selected-tileset-definition-index state))
                                              (nil? (:selected-tileset-tile-index state)))))
