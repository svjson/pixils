(ns tilemap-editor.view.tileset.panels
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [pixils.ui.slider :as sl]
            [pixils.ui.tab-panel :as tabs]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.view.property-sets.model :as property-model]
            tilemap-editor.view.property-sets.layout
            [tilemap-editor.view.tileset.sprite-source-editor :as sse]
            [tilemap-editor.view.tilemap.renderer :as tr]
            tilemap-editor.view.tileset.model))

(def tileset-list-row-height 24)

(def tileset-context-menu
  {:settings {:mnemonics {:enabled false}}
	   :items [{:label "Edit"
	            :action :tileset/context-dummy
	            :payload {:command :edit}}
	           {:label "Properties"
	            :action :tileset/context-dummy
	            :payload {:command :properties}}
	           {:label "Duplicate"
	            :action :tileset/context-dummy
	            :payload {:command :duplicate}}]})

(def tile-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename"
            :action :tile/context-dummy
            :payload {:command :rename}}
           {:label "Delete"
            :action :tile/context-dummy
            :payload {:command :delete}}]})

(defun point-minus [position offset]
  (let [pos (or position {:x 0 :y 0})
        off (or offset {:x 0 :y 0})]
    {:x (- (:x pos) (:x off))
     :y (- (:y pos) (:y off))}))

(defun tile-drag-position [event payload]
  (point-minus (:global-position event) (:offset payload)))

(defun tile-grid-drag-payload [state event ctx]
  (let [tiles (selected-tileset-tiles state)
        tile-size (selected-tileset-tile-size state)
        index (tile-grid-index-at-position (:start-position event)
                                           (-> ctx :view :bounds)
                                           (count tiles)
                                           tile-size)
        tile (when (not (nil? index)) (nth tiles index))]
    (if (or (nil? index)
            (lb/held-shift? ctx))
      {:kind :tileset/tile-selection}
      {:kind :tileset/tile
       :source-tileset-index (:selected-tileset-definition-index state)
       :tile-index index
       :tile tile
       :tile-size tile-size
       :width tile-size
       :height tile-size
       :offset (:start-position event)})))

(defun emit-tile-drag-start! [state event ctx]
  (let [payload (:payload event)]
    (if (= (:kind payload) :tileset/tile)
      (do
        (ui/emit! (:view ctx)
                  :tile/drag-start
                  (assoc payload
                         :position (tile-drag-position event payload)))
        state)
      (select-tile-grid-drag-range state event ctx))))

(defun emit-tile-drag-move! [state event ctx]
  (let [payload (:payload event)]
    (if (= (:kind payload) :tileset/tile)
      (do
        (ui/emit! (:view ctx)
                  :tile/drag-move
                  (assoc payload
                         :position (tile-drag-position event payload)))
        state)
      (select-tile-grid-drag-range state event ctx))))

(defun emit-tile-drag-end! [state event ctx]
  (do
    (when (= (-> event :payload :kind) :tileset/tile)
      (ui/emit! (:view ctx) :tile/drag-end nil))
    (assoc state
           :tile-grid-selecting? false
           :tile-grid-dragging? false)))

(defun tile-drop-payload [target-tileset-index payload]
  (when (and (= (:kind payload) :tileset/tile)
             (not= (:source-tileset-index payload) target-tileset-index))
    {:source-tileset-index (:source-tileset-index payload)
     :target-tileset-index target-tileset-index
     :tile-index (:tile-index payload)}))

(defcomponent tileset-definition-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height tileset-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-drop (fn [state event ctx]
              (let [payload (tile-drop-payload (:value state) (:payload event))]
                (if payload
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :tile/move-to-tileset
                              payload)
                    state)
                  state)))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (menu/open-context-menu! tileset-context-menu
                                               (:global-position event)
                                               state
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :tileset/context-command
                                       {:tileset-index (:value state)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun tileset-definition-row-child [index option]
  {:mode 'tileset-definition-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun tileset-list-box-child [tilesets]
  (let [tilesets (or tilesets [])]
    (lb/make {:options (data/tileset-options tilesets)
              :style {:width :shrink
                      :height :fill}
              :row-height tileset-list-row-height
              :visible-rows (count tilesets)
              :content-width 220
              :disabled? (empty? tilesets)
              :selected-indices (ui/bind-state :selected-indices)
              :force-selection? true
              :item-child tileset-definition-row-child})))

(defcomponent tileset-definition-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :tilesets-list nil
                  :selected-indices (selected-tileset-definition-indices state)))
   :update (fn [state ctx]
             (let [tilesets (or (:tilesets state) [])]
               (do
                 (when (not= tilesets (:tilesets-list state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (tileset-list-box-child tilesets))))
                 (assoc state
                        :tilesets-list tilesets
                        :selected-indices (selected-tileset-definition-indices state)))))
   :on {:list-box/change (fn [state event ctx]
                           (assoc state
                                  :selected-tileset-definition-index
                                  (-> event :payload :value)
                                  :selected-tileset-tile-index
                                  0
                                  :selected-tileset-tile-indices
                                  [0]))}
   :children [(merge {:id "list-box"}
                     (tileset-list-box-child []))]})

(defcomponent tileset-definition-summary
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :update (fn [state ctx]
             (let [tileset (selected-tileset-definition state)
                   tiles (or (:tiles tileset) [])
                   tile-count (count tiles)]
               (assoc state
                      :label (or (:label tileset) "")
                      :tile-count-label (if tileset
                                          (str tile-count
                                               (if (= tile-count 1)
                                                 " Tile"
                                                 " Tiles"))
                                          "No tile definition set selected"))))
   :children [{:mode 'ui/text
               :class :ui/title
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text
               :class :ui/muted
               :style {:width :shrink}
               :state {:value (ui/bind-state :tile-count-label)}}]})

(defun tile-cell-rect [index columns tile-size]
  (let [columns (max 1 (or columns 1))
        tile-size (tile-grid-cell-size-for tile-size)
        stride (tile-grid-stride tile-size)]
    {:x (* (mod index columns) stride)
     :y (* (int (/ index columns)) stride)
     :w tile-size
     :h tile-size}))

(defun selected-tile-border-rect [rect]
  {:x (+ (:x rect) 1)
   :y (+ (:y rect) 1)
   :w (- (:w rect) 2)
   :h (- (:h rect) 2)})

(defun draw-tile-cell! [tile index columns tile-size]
  (when tile
    (tr/draw-tile! tile (tile-cell-rect index columns tile-size))))

(defun draw-selected-tile-cell! [index columns tile-size]
  (when (not (nil? index))
    (r/rect! (selected-tile-border-rect (tile-cell-rect index
                                                        columns
                                                        tile-size))
             {:color {:r 0xff :g 0xcc :b 0x66}})))

(defun draw-selected-tile-cells! [indices columns tile-size]
  (for [index (or indices [])]
    (draw-selected-tile-cell! index columns tile-size)))

(defun select-tile-grid-drag-range [state event ctx]
  (let [tiles (selected-tileset-tiles state)
        tile-size (selected-tileset-tile-size state)
        item-count (count tiles)
        index (tile-grid-index-at-position (:position event)
                                           (-> ctx :view :bounds)
                                           item-count
                                           tile-size)]
    (if (and (:tile-grid-selecting? state)
             (not (nil? index)))
      (do
        (ui/stop-propagation! event)
        (select-tileset-tile-range state
                                   (:tile-grid-selection-anchor state)
                                   index
                                   (tile-grid-columns (-> ctx :view :bounds)
                                                      tile-size)
                                   item-count))
      state)))

(defcomponent tileset-tile-grid
  {:focusable true
   :class :ui/content
   :style {:width :fill
           :height :fill
           :clip true}
   :drag {:start {:mode :threshold
                  :distance 3}
          :payload (fn [state event ctx]
                     (tile-grid-drag-payload state event ctx))}
   :update (fn [state ctx]
             (let [item-count (count (selected-tileset-tiles state))
                   selected-index (clamp-index (:selected-tileset-tile-index state)
                                               item-count)
                   selection (selected-tileset-tile-selection
                              (assoc state
                                     :selected-tileset-tile-index
                                     selected-index))]
               (assoc state
                      :selected-tileset-tile-index selected-index
                      :selected-tileset-tile-indices selection)))
   :on-mouse-down (fn [state event ctx]
                    (let [tiles (selected-tileset-tiles state)
                          tile-size (selected-tileset-tile-size state)
                          index (tile-grid-index-at-position (:position event)
                                                             (-> ctx :view :bounds)
                                                             (count tiles)
                                                             tile-size)]
                      (do
                        (ui/stop-propagation! event)
                        (ui/focus! ctx)
                        (cond
                          (nil? index)
                          state

                          (= (:button event) :right)
                          (if (contains? (selected-tileset-tile-selection state)
                                         index)
                            state
                            (select-tileset-tile-index state index))

                          :default
                          (if (lb/held-shift? ctx)
                            (assoc (select-tileset-tile-index state index)
                                   :tile-grid-selecting? true)
                            (assoc (select-tileset-tile-index state index)
                                   :tile-grid-dragging? true))))))
   :on-drag-start emit-tile-drag-start!
   :on-drag emit-tile-drag-move!
   :on-drag-end emit-tile-drag-end!
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (when (and (= (:button event) :right)
                               (not (empty? (selected-tileset-tile-selection state))))
                      (menu/open-context-menu! tile-context-menu
                                               (:global-position event)
                                               state
                                               ctx))
                    (assoc state :tile-grid-selecting? false)))
   :on-key-down (fn [state event ctx]
                  (let [tiles (selected-tileset-tiles state)
                        tile-size (selected-tileset-tile-size state)
                        item-count (count tiles)
                        columns (tile-grid-columns (-> ctx :view :bounds)
                                                   tile-size)
                        current (or (:selected-tileset-tile-index state) 0)
                        delta (case (:key event)
                                :key/left -1
                                :key/right 1
                                :key/up (* -1 columns)
                                :key/down columns
                                :key/delete :delete
                                :default nil)]
                    (if (nil? delta)
                      state
                      (do
                        (ui/stop-propagation! event)
                        (if (= delta :delete)
                          (do
                            (when (not (empty? (selected-tileset-tile-selection state)))
                              (ui/emit! (:view ctx)
                                        :tile/context-command
                                        {:command :delete
                                         :tile-indices
                                         (selected-tileset-tile-selection state)}))
                            state)
                          (let [index (move-tile-grid-index current
                                                            item-count
                                                            columns
                                                            delta)]
                            (select-tileset-tile-index state index)))))))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :tile/context-command
                                       {:command (-> payload :payload :command)
                                        :tile-indices
                                        (selected-tileset-tile-selection state)}))))
                       state)}
   :render (fn [state ctx]
             (let [tiles (selected-tileset-tiles state)
                   tile-size (selected-tileset-tile-size state)
                   selection (selected-tileset-tile-selection state)
                   columns (tile-grid-columns (-> ctx :view :bounds)
                                              tile-size)]
               (do
                 (for-indexed [index tile tiles]
                   (draw-tile-cell! tile index columns tile-size))
                 (draw-selected-tile-cells! selection columns tile-size))))})

(def default-tile-grid-scrollbar-size 14)

(defun tile-grid-row-count [item-count columns]
  (let [columns (max 1 (or columns 1))
        item-count (max 0 (or item-count 0))]
    (if (= item-count 0)
      0
      (int (/ (+ item-count (dec columns)) columns)))))

(defun tile-grid-content-height [item-count columns tile-size]
  (let [rows (tile-grid-row-count item-count columns)]
    (if (= rows 0)
      0
      (+ (* (dec rows) (tile-grid-stride tile-size))
         (tile-grid-cell-size-for tile-size)))))

(defun tile-grid-scroll-content-size [state ctx]
  (let [tiles (selected-tileset-tiles state)
        tile-size (selected-tileset-tile-size state)
        bounds (-> ctx :view :bounds)
        scrollbar-size (ui/theme-var ctx
                                     :scrollbar-size
                                     default-tile-grid-scrollbar-size)
        content-width (max 1 (- (or (:w bounds) 1) scrollbar-size))
        columns (tile-grid-columns {:w content-width}
                                   tile-size)]
    {:h (tile-grid-content-height (count tiles) columns tile-size)}))

(defun tileset-tile-grid-content-child []
  {:mode 'tileset-tile-grid
   :style {:width :fill
           :height :fill}
   :state {:selected-tileset-definition-index
           (ui/bind-state :selected-tileset-definition-index)
           :selected-tileset-tile-index
           (ui/bind-state :selected-tileset-tile-index)
           :selected-tileset-tile-indices
           (ui/bind-state :selected-tileset-tile-indices)
           :tilesets (ui/bind-state :tilesets)}})

(defun tileset-tile-grid-scroll-content-style [state]
  {:position :absolute
   :left 0
   :top (* -1 (or (:offset state) 0))
   :width :fill
   :height (or (:content-height state) 0)})

(defcomponent tileset-tile-grid-scroll-viewport
  {:style {:width :fill
           :height :fill
           :clip true}
   :update (fn [state ctx]
             (let [children (ui/children ctx)]
               (do
                 (when (> (count children) 0)
                   (ui/style! (nth children 0)
                              (tileset-tile-grid-scroll-content-style
                               state)))
                 state)))
   :children [(tileset-tile-grid-content-child)]})

(defcomponent tileset-tile-grid-scroll-pane
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :init (fn [state ctx]
           (assoc state
                  :offset 0
                  :content-height 0))
   :update (fn [state ctx]
             (let [content-size (tile-grid-scroll-content-size state ctx)]
               (assoc state
                      :content-height (:h content-size)
                      :step
                      (tile-grid-stride (selected-tileset-tile-size state)))))
   :children [{:mode 'tileset-tile-grid-scroll-viewport
               :state {:offset (ui/bind-state :offset)
                       :content-height (ui/bind-state :content-height)
                       :selected-tileset-definition-index
                       (ui/bind-state :selected-tileset-definition-index)
                       :selected-tileset-tile-index
                       (ui/bind-state :selected-tileset-tile-index)
                       :selected-tileset-tile-indices
                       (ui/bind-state :selected-tileset-tile-indices)
                       :tilesets (ui/bind-state :tilesets)}}
              {:mode 'ui/scrollbar
               :class :scrollbar/v
               :style {:height :fill}
               :state {:axis :y
                       :value (ui/bind-state :offset)
                       :step (ui/bind-state :step)
                       :content-size (ui/bind-state :content-height)}}]})

(defcomponent tileset-tile-drag-preview
  {:class :ui/content
   :style {:position :absolute
           :width tile-grid-cell-size
           :height tile-grid-cell-size
           :hit-test false
           :hidden true}
   :update (fn [state ctx]
             (let [preview (:drag-preview state)
                   position (:position preview)
                   tile-size (or (:tile-size preview) tile-grid-cell-size)
                   visible? (not (nil? preview))]
               (do
                 (ui/style! (:view ctx)
                            (if visible?
                              {:hidden false
                               :left (:x position)
                               :top (:y position)
                               :width tile-size
                               :height tile-size}
                              {:hidden true}))
                 (assoc state
                        :tile (:tile preview)
                        :tile-size tile-size))))
   :render (fn [state ctx]
             (let [tile (:tile state)
                   tile-size (or (:tile-size state) tile-grid-cell-size)]
               (when tile
                 (tr/draw-tile! tile {:x 0
                                      :y 0
                                      :w tile-size
                                      :h tile-size}))))})

(defcomponent tile-preview
  {:class :ui/content
   :style {:width 48
           :height 48}
   :render (fn [state ctx]
             (let [tile (:tile state)]
               (do
                 (r/rect! {:x 0 :y 0 :w 48 :h 48}
                          {:fill true
                           :color {:r 0x12 :g 0x15 :b 0x18}})
                 (when tile
                   (tr/draw-tile! tile {:x 8 :y 8 :w 32 :h 32}))
                 (r/rect! {:x 0 :y 0 :w 48 :h 48}
                          {:color {:r 0x00 :g 0x00 :b 0x00}}))))})

(defcomponent tile-definition-row {})

(defcomponent tile-definition-column {})

(defcomponent tile-detail-field
  {:style {:width :fill
           :height 22
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 58}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :value)}}]})

(defun tile-detail-field-child [label value]
  {:mode 'tile-detail-field
   :state {:label label
           :value value}})

(defcomponent tile-type-selector
  {:style {:width :fill
           :height 22}
   :update (fn [state ctx]
             (assoc state
                    :selected-index
                    (tile-type-index (:tile state))
                    :disabled? (nil? (:tile state))))
   :on {:combo-box/change (fn [state event ctx]
                            (do
                              (ui/emit! (:view ctx)
                                        :tile-definition/type-change
                                        (-> event :payload :value))
                              state))}
   :children [(cb/make {:options tile-type-options
                        :selected-index (ui/bind-state :selected-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent color-channel-editor
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :on {:slider/change (fn [state event ctx]
                         (do
                           (ui/emit! (:view ctx)
                                     :tile-definition/color-channel-change
                                     {:channel (:channel state)
                                      :value (:payload event)})
                           state))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 18}
               :state {:value (ui/bind-state :label)}}
              (sl/make {:value (ui/bind-state :value)
                        :min 0
                        :max 255
                        :step 1})
              {:mode 'ui/text
               :style {:width 28}
               :state {:value (ui/bind-state :value)}}]})

(defun color-channel-child [channel label value]
  {:mode 'color-channel-editor
   :state {:channel channel
           :label label
           :value value}})

(defcomponent tile-color-editor
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 6}}
   :update (fn [state ctx]
             (let [color (or (:color (:tile state)) default-tile-color)]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if (= (:type (:tile state)) :color) :visible :none))
                 (assoc state
                        :color color
                        :r (:r color)
                        :g (:g color)
                        :b (:b color)))))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "RGB"}}
              (color-channel-child :r "R" (ui/bind-state :r))
              (color-channel-child :g "G" (ui/bind-state :g))
              (color-channel-child :b "B" (ui/bind-state :b))]})

(defun tile-sprite-editor-placeholder-child []
  {:id "sprite-source-editor-child"
   :style {:width 0
           :height 0}
   :state (ui/bind-state)
   :children []})

(defun tile-sprite-editor-child []
  {:id "sprite-source-editor-child"
   :mode 'sprite-source-editor
   :state {:resources (ui/bind-state :resources)
           :tile (ui/bind-state :tile)
           :tile-size (ui/bind-state :tile-size)
           :source-snap-to-grid? (ui/bind-state
                                  :source-snap-to-grid?)
           :source-snap-interval (ui/bind-state
                                  :source-snap-interval)
           :source-snap-interval-custom?
           (ui/bind-state :source-snap-interval-custom?)}})

(defun tile-sprite-editor-children []
  [(tile-sprite-editor-child)])

(defcomponent tile-sprite-editor
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 4}}
   :init (fn [state ctx]
           (let [tile-size (or (:tile-size state) data/tile-size)]
             (assoc state
                    :source-snap-to-grid?
                    (sse/source-position-snap-enabled? state)
                    :source-snap-interval
                    (sse/source-position-snap-interval
                     (assoc state :tile-size tile-size)))))
   :update (fn [state ctx]
             (let [tile (:tile state)
                   source (:source tile)
                   tile-size (or (:tile-size state) data/tile-size)
                   sprite? (= (:type tile) :sprite)
                   snap-to-grid? (sse/source-position-snap-enabled? state)
                   snap-interval (sse/source-position-snap-interval state)]
               (do
                 (when (not= sprite? (:sprite-editor-visible? state))
                   (ui/replace-child! (:view ctx)
                                      "sprite-source-editor-child"
                                      (if sprite?
                                        (tile-sprite-editor-child)
                                        (tile-sprite-editor-placeholder-child))))
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if sprite? :visible :none))
                 (assoc state
                        :sprite-editor-visible? sprite?
                        :tile-size tile-size
                        :source-snap-to-grid? snap-to-grid?
                        :source-snap-interval snap-interval
                        :source-snap-interval-label (str snap-interval)))))
   :on {:checkbox/change (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :tile-definition/source-snap-change
                                       (-> event :payload :checked?))
                             state))
        :slider/change (fn [state event ctx]
                         (do
                           (ui/emit! (:view ctx)
                                      :tile-definition/source-snap-interval-change
                                     (:payload event))
                           state))
        :sprite-source-editor/change
        (fn [state event ctx]
          (do
            (ui/emit! (:view ctx)
                      :tile-definition/sprite-source-change
                      (:payload event))
            state))}
   :children [(tile-sprite-editor-placeholder-child)]})

(defun tile-definition-tile-tab-children []
  [{:mode 'tile-definition-row
    :style {:width :fill
            :height 22
            :layout {:direction :row
                     :align-items :center
                     :gap 8}}
    :state {:tile (ui/bind-state :tile)}
    :children [{:mode 'ui/text
                :class :ui/muted
                :style {:width 58}
                :state {:value "Type"}}
               {:mode 'tile-type-selector
                :style {:width 160
                        :height 22}
                :state {:tile (ui/bind-state :tile)}}]}
   {:mode 'tile-sprite-editor
    :state {:tile (ui/bind-state :tile)
            :resources (ui/bind-state :resources)
            :tile-size (ui/bind-state :tile-size)
            :source-snap-to-grid? (ui/bind-state
                                   :source-snap-to-grid?)
            :source-snap-interval (ui/bind-state
                                   :source-snap-interval)
            :source-snap-interval-custom?
            (ui/bind-state :source-snap-interval-custom?)}}
   {:mode 'tile-color-editor
    :state {:tile (ui/bind-state :tile)}}])

(defcomponent tile-definition-tile-tab
  {:style {:width :fill
           :height :fill
           :padding 8
           :layout {:direction :column
                    :gap 8}}
   :children (tile-definition-tile-tab-children)})

(defun tile-definition-properties-tab-children []
  [{:mode 'property-value-list
    :state {:title "Tile Properties"
            :kind :tile
            :property-sets (ui/bind-state :property-sets)
            :property-set-ids
            (ui/bind-state :property-set-ids)
            :default-values
            (ui/bind-state :property-default-values)
            :override-values
            (ui/bind-state :property-override-values)
            :disabled? (ui/bind-state :tile-definition-panel-disabled?)}}])

(defcomponent tile-definition-properties-tab
  {:style {:width :fill
           :height :fill
           :padding 8
           :layout {:direction :column
                    :gap 8}}
   :children (tile-definition-properties-tab-children)})

(defun tile-definition-detail-tabs-child []
  (tabs/make
   {:selected-tab (ui/bind-state :tile-definition-detail-tab)
    :style {:width :fill
            :height 580}
    :state {:tile (ui/bind-state :tile)
            :resources (ui/bind-state :resources)
            :property-sets (ui/bind-state :property-sets)
            :property-set-ids (ui/bind-state :property-set-ids)
            :assigned-property-set-ids
            (ui/bind-state :assigned-property-set-ids)
            :property-default-values
            (ui/bind-state :property-default-values)
            :property-override-values
            (ui/bind-state :property-override-values)
            :tile-size (ui/bind-state :tile-size)
            :source-snap-to-grid?
            (ui/bind-state :source-snap-to-grid?)
            :source-snap-interval
            (ui/bind-state :source-snap-interval)
            :source-snap-interval-custom?
            (ui/bind-state :source-snap-interval-custom?)
            :tile-set-panel-disabled?
            (ui/bind-state :tile-set-panel-disabled?)
            :tile-definition-panel-disabled?
            (ui/bind-state :tile-definition-panel-disabled?)
            :tile-definition-detail-tab
            (ui/bind-state :tile-definition-detail-tab)}
    :tabs [{:id :tile
            :label "Tile"
            :child {:mode 'tile-definition-tile-tab
                    :state (ui/bind-state)}}
           {:id :properties
            :label "Properties"
            :child {:mode 'tile-definition-properties-tab
                    :state (ui/bind-state)}}]}))

(defcomponent tile-definition-panel
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 8}}
   :init (fn [state ctx]
           (let [tile-size (selected-tileset-tile-size state)
                 source-state (assoc state :tile-size tile-size)]
             (assoc state
                    :source-snap-to-grid?
                    (sse/source-position-snap-enabled? source-state)
                    :source-snap-interval
                    (sse/source-position-snap-interval source-state)
                    :tile-definition-detail-tab :tile)))
   :update (fn [state ctx]
             (let [tile (selected-tileset-tile state)
                   tileset (selected-tileset-definition state)
                   tile-size (selected-tileset-tile-size state)
                   source-state (assoc state :tile-size tile-size)]
               (assoc state
                      :tile tile
                      :property-set-ids (:property-sets tileset)
                      :assigned-property-set-ids (:property-sets tileset)
                      :property-default-values (:properties tileset)
                      :property-override-values (:properties tile)
                      :tile-set-panel-disabled? (nil? tileset)
                      :tile-size tile-size
                      :source-snap-to-grid?
                      (sse/source-position-snap-enabled? source-state)
                      :source-snap-interval
                      (sse/source-position-snap-interval source-state)
                      :tile-id (if tile (str (:id tile)) "")
                      :tile-name (or (:name tile) "")
                      :tile-char (or (:char tile) ""))))
   :on {:tile-definition/type-change (fn [state event ctx]
                                       (set-selected-tile-type state
                                                               (:payload event)))
        :tile-definition/color-channel-change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (set-selected-tile-color-channel state
                                             (:channel payload)
                                             (:value payload))))
        :tile-definition/source-position-change
        (fn [state event ctx]
          (set-selected-tile-source state (:payload event)))
        :tile-definition/sprite-source-change
        (fn [state event ctx]
          (set-selected-tile-sprite state (:payload event)))
        :tile-definition/source-snap-change
        (fn [state event ctx]
          (assoc state :source-snap-to-grid? (:payload event)))
        :tile-definition/source-snap-interval-change
        (fn [state event ctx]
          (assoc state
                 :source-snap-interval (:payload event)
                 :source-snap-interval-custom? true))
        :tab-panel/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (assoc state
                   :tile-definition-detail-tab
                   (-> event :payload :tab))))
        :property-value/change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (do
              (ui/stop-propagation! event)
              (case (:kind payload)
                :tile
                (property-model/set-selected-tile-property-value
                 state
                 (:property-id payload)
                 (:value payload))

                :default state))))}
   :children [{:mode 'tile-definition-row
               :style {:width :fill
                       :height 76
                       :layout {:direction :row
                                :gap 10}}
               :state {:tile (ui/bind-state :tile)
                       :tile-size (ui/bind-state :tile-size)
                       :tile-id (ui/bind-state :tile-id)
                       :tile-name (ui/bind-state :tile-name)
                       :tile-char (ui/bind-state :tile-char)}
               :children [{:mode 'tile-preview
                           :state {:tile (ui/bind-state :tile)}}
                          {:mode 'tile-definition-column
                           :style {:width 220
                                   :height :shrink
                                   :layout {:direction :column
                                            :gap 4}}
                           :state {:tile-id (ui/bind-state :tile-id)
                                   :tile-name (ui/bind-state :tile-name)
                                   :tile-char (ui/bind-state :tile-char)}
                           :children [(tile-detail-field-child "Id/Key" (ui/bind-state :tile-id))
                                      (tile-detail-field-child "Name" (ui/bind-state :tile-name))
                                      (tile-detail-field-child "Char" (ui/bind-state :tile-char))]}]}
              (tile-definition-detail-tabs-child)]})

(def tile-definition-panel-content-height 680)

(def tile-definition-panel-scroll-width 320)

(defun tile-definition-panel-content-child []
  {:mode 'tile-definition-panel
   :state {:selected-tileset-definition-index
           (ui/bind-state :selected-tileset-definition-index)
           :selected-tileset-tile-index
           (ui/bind-state :selected-tileset-tile-index)
           :selected-tileset-tile-indices
           (ui/bind-state :selected-tileset-tile-indices)
           :resources (ui/bind-state :resources)
           :property-sets (ui/bind-state :property-sets)
           :tilesets (ui/bind-state :tilesets)}})

(defun tile-definition-panel-scroll-content-style [state]
  {:position :absolute
   :left 0
   :top (* -1 (or (:offset state) 0))
   :width :fill
   :height tile-definition-panel-content-height})

(defcomponent tile-definition-panel-scroll-viewport
  {:style {:width :fill
           :height :fill
           :clip true}
   :update (fn [state ctx]
             (let [children (ui/children ctx)]
               (do
                 (when (> (count children) 0)
                   (ui/style! (nth children 0)
                              (tile-definition-panel-scroll-content-style
                               state)))
                 state)))
   :children [(tile-definition-panel-content-child)]})

(defcomponent tile-definition-panel-scroll-row
  {:style {:width tile-definition-panel-scroll-width
           :height :fill
           :layout {:direction :row}}
   :init (fn [state ctx]
           (assoc state
                  :offset 0
                  :content-height tile-definition-panel-content-height))
   :children [{:mode 'tile-definition-panel-scroll-viewport
               :state {:offset (ui/bind-state :offset)
                       :selected-tileset-definition-index
                       (ui/bind-state :selected-tileset-definition-index)
                       :selected-tileset-tile-index
                       (ui/bind-state :selected-tileset-tile-index)
                       :selected-tileset-tile-indices
                       (ui/bind-state :selected-tileset-tile-indices)
                       :resources (ui/bind-state :resources)
                       :property-sets (ui/bind-state :property-sets)
                       :tilesets (ui/bind-state :tilesets)}}
              {:mode 'ui/scrollbar
               :class :scrollbar/v
               :style {:height :fill}
               :state {:axis :y
                       :value (ui/bind-state :offset)
                       :step 48
                       :content-size (ui/bind-state :content-height)}}]})
