(ns tilemap-editor.view.terrains.selection-column.list
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [tilemap-editor.view.terrains.model :as model]))

(def terrain-list-row-height 24)

(def terrain-set-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Terrain Set"
            :action :terrain/set-context-dummy
            :payload {:command :rename}}
           {:label "Delete"
            :action :terrain/set-context-dummy
            :payload {:command :delete}}]})

(def terrain-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Terrain"
            :action :terrain/context-dummy
            :payload {:command :rename}}
           {:label "Duplicate"
            :action :terrain/context-dummy
            :payload {:command :duplicate}}
           {:label "Delete"
            :action :terrain/context-dummy
            :payload {:command :delete}}]})

(defcomponent terrain-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height terrain-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    state)
   :on-mouse-up (fn [state event ctx]
                  (ui/stop-propagation! event)
                  (ui/emit! (:view ctx)
                            :list-box/item-click
                            {:index (:index state)
                             :value (:value state)
                             :shift? false
                             :ctrl? false})
                  (when (= (:button event) :right)
                    (case (:context-kind state)
                      :terrain-set
                      (menu/open-context-menu! terrain-set-context-menu
                                               (:global-position event)
                                               state
                                               ctx)

                      :terrain
                      (menu/open-context-menu! terrain-context-menu
                                               (:global-position event)
                                               state
                                               ctx)

                      :default
                      nil))
                  state)
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]

                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (case (:context-kind state)
                               :terrain-set
                               (ui/emit! (:view ctx)
                                         :terrain-set/context-command
                                         {:terrain-set-index (:index state)
                                          :command
                                          (-> payload :payload :command)})

                               :terrain
                               (ui/emit! (:view ctx)
                                         :terrain/context-command
                                         {:terrain-index (:index state)
                                          :command
                                          (-> payload :payload :command)})

                               :default
                               nil)))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun terrain-row-child-with-context [context-kind index option]
  {:mode 'terrain-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :context-kind context-kind
           :selected-indices (ui/bind-state :selected-indices)}})

(defun terrain-row-child [index option]
  (terrain-row-child-with-context :terrain-set index option))

(defun terrain-context-row-child [index option]
  (terrain-row-child-with-context :terrain index option))

(defun terrain-set-list-child [terrain-sets selected-index]
  (let [terrain-sets (or terrain-sets [])
        options (model/terrain-set-options terrain-sets)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (empty? options)
              :selected-indices (model/selected-terrain-set-indices
                                 terrain-sets
                                 selected-index)
              :force-selection? true
              :item-child terrain-row-child})))

(defcomponent terrain-set-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-sets nil
                  :rendered-selected-index nil))
   :update (fn [state ctx]
             (let [terrain-sets (or (:terrain-sets state) [])
                   selected-index (:selected-terrain-set-index state)]
               (when (or (not= terrain-sets (:rendered-terrain-sets state))
                         (not= selected-index (:rendered-selected-index state)))
                 (ui/replace-child! (:view ctx)
                                    "terrain-set-list-box"
                                    (merge {:id "terrain-set-list-box"}
                                           (terrain-set-list-child
                                            terrain-sets
                                            selected-index))))
               (assoc state
                      :rendered-terrain-sets terrain-sets
                      :rendered-selected-index selected-index)))
   :on {:list-box/selection-change (fn [state event ctx]
                           (ui/stop-propagation! event)
                           (ui/emit! (:view ctx)
                                     :terrain/set-select
                                     (-> event :payload :value))
                           state)}
   :children [(merge {:id "terrain-set-list-box"}
                     (terrain-set-list-child [] nil))]})

(defun terrain-list-child [terrain-set selected-index disabled?]
  (let [options (model/terrain-options terrain-set)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (if (or disabled? (empty? options)) true false)
              :selected-indices (if disabled?
                                  []
                                  (model/selected-terrain-indices terrain-set
                                                                  selected-index))
              :force-selection? true
              :item-child terrain-context-row-child})))

(defcomponent terrain-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-set nil
                  :rendered-selected-index nil
                  :rendered-disabled? nil))
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   selected-index (:selected-terrain-index state)
                   disabled? (:terrain-list-panel-disabled? state)]
               (when (or (not= terrain-set (:rendered-terrain-set state))
                         (not= selected-index (:rendered-selected-index state))
                         (not= disabled? (:rendered-disabled? state)))
                 (ui/replace-child! (:view ctx)
                                    "terrain-list-box"
                                    (merge {:id "terrain-list-box"}
                                           (terrain-list-child terrain-set
                                                               selected-index
                                                               disabled?))))
               (assoc state
                      :rendered-terrain-set terrain-set
                      :rendered-selected-index selected-index
                      :rendered-disabled? disabled?)))
   :on {:list-box/selection-change (fn [state event ctx]
                           (ui/stop-propagation! event)
                           (ui/emit! (:view ctx)
                                     :terrain/select
                                     (-> event :payload :value))
                           state)}
   :children [(merge {:id "terrain-list-box"}
                     (terrain-list-child nil nil true))]})

