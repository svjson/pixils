                        (ui/bind-state :selected-terrain-rule-id)
                        :tilesets (ui/bind-state :tilesets)
                        :terrain-sets (ui/bind-state :terrain-sets)
                        :selected-terrain-set-index
                        (ui/bind-state :selected-terrain-set-index)
                        :selected-terrain-index
                        (ui/bind-state :selected-terrain-index)
                        :layer-profiles (ui/bind-state :layer-profiles)
                        :selected-layer-profile-id
                        (ui/bind-state :selected-layer-profile-id)
                        :layers (ui/bind-state :layers)}})]})

(defun terrain-rule-active-editor-child []
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :align-items :start
                    :gap 8}}
   :state (ui/bind-state)
   :children [{:style {:width :shrink
                       :height :shrink
                       :layout {:direction :column
                                :gap 8}}
               :state (ui/bind-state)
               :children [{:style {:width :shrink
                                   :height :shrink
                                   :layout {:direction :row
                                            :align-items :center
                                            :gap 10}}
                           :state (ui/bind-state)
