                                               :selected-terrain-set-index
                                               (ui/bind-state
                                                :selected-terrain-set-index)
                                               :selected-terrain-index
                                               (ui/bind-state
                                                :selected-terrain-index)
                                               :rulesets
                                               (ui/bind-state :rulesets)
                                               :selected-terrain-ruleset-id
                                               (ui/bind-state
                                                :selected-terrain-ruleset-id)
                                               :selected-terrain-rule-id
                                               (ui/bind-state
                                                :selected-terrain-rule-id)
                                               :selected-terrain-rule-match-direction
                                               (ui/bind-state
                                                :selected-terrain-rule-match-direction)
                                               :tilesets
                                               (ui/bind-state :tilesets)}}
                                      {:mode 'terrain-rule-arrow}
                                      {:style {:width :shrink
                                               :height :shrink
                                               :layout {:direction :column
                                                        :gap 6}}
                                       :state (ui/bind-state)
                                       :children [{:mode 'terrain-stamp-grid-preview
                                                   :state {:rulesets
                                                           (ui/bind-state
                                                            :rulesets)
                                                           :selected-terrain-ruleset-id
                                                           (ui/bind-state
                                                            :selected-terrain-ruleset-id)
                                                           :selected-terrain-rule-id
                                                           (ui/bind-state
                                                            :selected-terrain-rule-id)
                                                           :selected-terrain-rule-output-position
                                                           (ui/bind-state
                                                            :selected-terrain-rule-output-position)
                                                           :terrain-rule-selected-tile
                                                           (ui/bind-state
                                                            :terrain-rule-selected-tile)
                                                           :terrain-sets
                                                           (ui/bind-state
                                                            :terrain-sets)
                                                           :selected-terrain-set-index
                                                           (ui/bind-state
                                                            :selected-terrain-set-index)
                                                           :selected-terrain-index
                                                           (ui/bind-state
                                                            :selected-terrain-index)
                                                           :tilesets
                                                           (ui/bind-state
                                                            :tilesets)}}
                                                  {:mode 'ui/text
                                                   :class :ui/muted
                                                   :state {:value "Ownership"}}
                                                  {:mode 'terrain-signature-grid-preview
                                                   :state {:terrain-sets
                                                           (ui/bind-state
                                                            :terrain-sets)
                                                           :selected-terrain-set-index
                                                           (ui/bind-state
                                                            :selected-terrain-set-index)
                                                           :selected-terrain-index
                                                           (ui/bind-state
                                                            :selected-terrain-index)
                                                           :rulesets
                                                           (ui/bind-state
                                                            :rulesets)
                                                           :selected-terrain-ruleset-id
                                                           (ui/bind-state
                                                            :selected-terrain-ruleset-id)
                                                           :selected-terrain-rule-id
                                                           (ui/bind-state
                                                            :selected-terrain-rule-id)
                                                           :selected-terrain-rule-output-position
                                                           (ui/bind-state
                                                            :selected-terrain-rule-output-position)
                                                           :tilesets
                                                           (ui/bind-state
                                                            :tilesets)}}]}]}
                          {:mode 'terrain-rule-output-settings
                           :state {:rulesets (ui/bind-state :rulesets)
                                   :selected-terrain-ruleset-id
                                   (ui/bind-state
                                    :selected-terrain-ruleset-id)
                                   :selected-terrain-rule-id
                                   (ui/bind-state :selected-terrain-rule-id)
                                   :tilesets (ui/bind-state :tilesets)
                                   :terrain-sets (ui/bind-state :terrain-sets)
                                   :selected-terrain-set-index
                                   (ui/bind-state
                                    :selected-terrain-set-index)
                                   :selected-terrain-index
                                   (ui/bind-state :selected-terrain-index)
                                   :layer-profiles
                                   (ui/bind-state :layer-profiles)
                                   :selected-layer-profile-id
                                   (ui/bind-state
                                    :selected-layer-profile-id)
                                   :layers (ui/bind-state :layers)}}
                          (terrain-rule-application-options-child)]}
              {:mode 'terrain-stamp-tile-picker-scroll-pane
               :state {:rulesets (ui/bind-state :rulesets)
                       :selected-terrain-ruleset-id
                       (ui/bind-state :selected-terrain-ruleset-id)
                       :selected-terrain-rule-id
                       (ui/bind-state :selected-terrain-rule-id)
                       :selected-terrain-rule-match-direction
                       (ui/bind-state
                        :selected-terrain-rule-match-direction)
                       :terrain-rule-selected-tile
                       (ui/bind-state :terrain-rule-selected-tile)
                       :terrain-rule-selected-mask
                       (ui/bind-state :terrain-rule-selected-mask)
                       :terrain-rule-mask-polarity
                       (ui/bind-state :terrain-rule-mask-polarity)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :selected-terrain-index
                       (ui/bind-state :selected-terrain-index)
                       :tilesets (ui/bind-state :tilesets)}}]})

(defun terrain-rule-empty-editor-child []
  {:mode 'terrain-rule-empty-editor
   :state {:rule-add-disabled? (ui/bind-state :rule-add-disabled?)}})

(defun terrain-rule-visual-editor-child [state]
  (merge {:id "terrain-rule-visual-editor-content"
          :state (ui/bind-state)}
         (if (model/selected-terrain-rule state)
           (terrain-rule-active-editor-child)
           (terrain-rule-empty-editor-child))))

(defcomponent terrain-rule-visual-editor
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :gap 8}}
   :update (fn [state ctx]
             (let [has-rule? (not (nil? (model/selected-terrain-rule state)))
                   rule-add-disabled? (= (:rule-add-disabled? state) true)]
               (do
                 (when (or (not= has-rule? (:rendered-has-rule? state))
                           (not= rule-add-disabled?
                                 (:rendered-rule-add-disabled? state)))
                   (ui/replace-child!
                    (:view ctx)
                    "terrain-rule-visual-editor-content"
                    (terrain-rule-visual-editor-child
                     (assoc state
                            :rule-add-disabled?
                            rule-add-disabled?))))
                 (assoc state
                        :rendered-has-rule? has-rule?
                        :rendered-rule-add-disabled? rule-add-disabled?
                        :rule-add-disabled? rule-add-disabled?))))
   :children [(terrain-rule-visual-editor-child {})]})

(def terrain-standard-slot-tile-size 40)
(def terrain-standard-slot-marker-size (int (/ terrain-standard-slot-tile-size
                                               3)))
(def terrain-standard-slot-size terrain-standard-slot-tile-size)
(def terrain-standard-slot-surround-size (+ terrain-standard-slot-tile-size
                                            (* terrain-standard-slot-marker-size
                                               2)))
(def terrain-standard-slot-gap 4)
(def terrain-standard-slot-border-color theme/panel-border)
(def terrain-standard-slot-marker-color terrain-standard-slot-border-color)
(def terrain-standard-slot-surround-tile-origin terrain-standard-slot-marker-size)
(def terrain-standard-setup-panel-column-gap 20)
(def terrain-standard-setup-panel-row-gap 16)
(def terrain-standard-setup-panel-content-height 560)

(defun terrain-standard-setup-uses-surround-markers? [setup-id]
  (= setup-id :isolated))

(defun terrain-standard-role-uses-surround-markers? [state]
  (terrain-standard-setup-uses-surround-markers? (:setup-id state)))

(defun terrain-standard-role-slot-size [setup-id]
  (if (terrain-standard-setup-uses-surround-markers? setup-id)
    terrain-standard-slot-surround-size
    terrain-standard-slot-size))

(defun terrain-standard-role-tile-origin [setup-id]
  (if (terrain-standard-setup-uses-surround-markers? setup-id)
    terrain-standard-slot-surround-tile-origin
    0))

(defun terrain-standard-role-tile-rect [state]
  (let [origin (terrain-standard-role-tile-origin (:setup-id state))]
    {:x origin
     :y origin
     :w terrain-standard-slot-tile-size
     :h terrain-standard-slot-tile-size}))

(defun terrain-standard-role-slot-cache-entry [state]
  (let [slots (or (:terrain-standard-role-slots state) {})]
    (get slots (:role-id state))))

(defun terrain-standard-role-slot-tile [state]
  (if-let [entry (terrain-standard-role-slot-cache-entry state)]
    (:tile entry)
    nil))

(defun terrain-standard-role-slot-mask-ref [state]
  (if-let [entry (terrain-standard-role-slot-cache-entry state)]
    (:mask-ref entry)
    nil))

(defun terrain-standard-role-slot-overlay-ref [state]
  (if-let [entry (terrain-standard-role-slot-cache-entry state)]
    (:overlay-ref entry)
    nil))

(defun terrain-standard-role-slot-overlay-tile [state]
  (if-let [entry (terrain-standard-role-slot-cache-entry state)]
    (:overlay-tile entry)
    nil))

(defun terrain-standard-role-slot-rule-id [state]
  (if-let [entry (terrain-standard-role-slot-cache-entry state)]
    (:rule-id entry)
    nil))

(defun terrain-standard-output-tab [state]
  (or (:terrain-standard-output-picker-tab state) :tiles))

(defun terrain-standard-marker-condition? [condition]
  (and (not (= condition :ignore))
       (not (= condition :same))))

(defun terrain-standard-role-marker-directions [role-id]
  (let [match (model/terrain-standard-role-match role-id :none)]
    (filter model/neighbor-directions
            (fn [direction]
              (terrain-standard-marker-condition? (get match direction))))))

(defun terrain-standard-role-marker-rect [direction]
  (let [third terrain-standard-slot-marker-size
        tile terrain-standard-slot-tile-size
        tile-origin terrain-standard-slot-surround-tile-origin
        end (+ tile-origin tile)]
    (case direction
      :nw {:x 0 :y 0 :w third :h third}
      :n {:x tile-origin :y 0 :w tile :h third}
      :ne {:x end :y 0 :w third :h third}
      :w {:x 0 :y tile-origin :w third :h tile}
      :e {:x end :y tile-origin :w third :h tile}
      :sw {:x 0 :y end :w third :h third}
      :s {:x tile-origin :y end :w tile :h third}
      :se {:x end :y end :w third :h third}
      :default nil)))

(defun draw-terrain-standard-role-markers! [state]
  (reduce (if (terrain-standard-role-uses-surround-markers? state)
            (terrain-standard-role-marker-directions (:role-id state))
            [])
          nil
          (fn [result direction]
            (do
              (if-let [rect (terrain-standard-role-marker-rect direction)]
                (r/rect! rect {:color terrain-standard-slot-marker-color})
                nil)
              result))))

(defun terrain-standard-preview-opposing-terrain [state]
  (let [opposing (or (:terrain-standard-role-cache-opposing state)
                     (model/selected-terrain-standard-opposing state))
        selected (model/terrain-standard-opposing-terrain-list state opposing)]
    (or (head selected)
        (head (model/terrain-standard-opposing-terrain-values state)))))

(defun terrain-standard-preview-mask-ref [state mask-ref]
  (when mask-ref
    (if (contains? mask-ref :polarity)
      mask-ref
      (model/mask-ref-with-polarity mask-ref
                                    (:terrain-rule-mask-polarity state)))))

(defun terrain-standard-transition-preview-tile [state mask-ref]
  (let [center-terrain (model/selected-terrain-id state)
        opposing-terrain (terrain-standard-preview-opposing-terrain state)
        terrain-set-id (model/selected-terrain-set-id state)
        mask-ref (terrain-standard-preview-mask-ref state mask-ref)]
    (when (and center-terrain opposing-terrain terrain-set-id mask-ref)
      (materialize/transition-tile-definition
       {:tile-size data/tile-size
        :tilesets (:tilesets state)
        :terrain-sets (:terrain-sets state)
        :mask-sets (:mask-sets state)}
       nil
       {:terrain-set terrain-set-id}
       {:terrain center-terrain
        :match {:n {:terrain opposing-terrain}}}
       mask-ref
       0
       0))))

(defun draw-terrain-standard-mask-fallback! [rect]
  (do
    (r/rect! {:x (+ (:x rect) 7)
              :y (+ (:y rect) 7)
              :w (- (:w rect) 14)
              :h (- (:h rect) 14)}
             {:color {:r 0x5d :g 0xc9 :b 0x9a}})
    (r/text! "M"
             {:x (+ (:x rect) 15)
              :y (+ (:y rect) 13)}
             {:color {:r 0x5d :g 0xc9 :b 0x9a}})))

(defun terrain-standard-transition-preview-size [tile]
  (or (-> tile :mask-source :size)
      (:size tile)))

(defun terrain-standard-transition-preview-image-id [tile size]
  (keyword (str "pixils-transition-cache/preview-"
                (model/keyword-label (or (:id tile)
                                         :transition))
                "-"
                (:w size)
                "x"
                (:h size))))

(defun terrain-standard-transition-preview-draw-tile [tile]
  (let [size (terrain-standard-transition-preview-size tile)]
    (if (and (= (:type tile) :transition-mask) size)
      (assoc (assoc tile :size size)
             :image (terrain-standard-transition-preview-image-id tile size))
      tile)))

(defun draw-terrain-standard-transition-preview-tile! [tile rect]
  (let [preview-tile (terrain-standard-transition-preview-draw-tile tile)
        size (:size preview-tile)
        base (-> preview-tile :base :tile-definition)
        image (when (and (= (:type preview-tile) :transition-mask) size)
                (tilemap-renderer/ensure-transition-overlay-image!
                 preview-tile
                 size))]
    (do
      (when base
        (tilemap-renderer/draw-tile! base rect nil 1))
      (if (and image
               (tilemap-renderer/transition-image-exists? image))
        (r/image! image {:target rect})
        (tilemap-renderer/draw-tile! preview-tile rect nil 1)))))

(defun draw-terrain-standard-transition-preview! [state mask-ref rect]
  (if-let [tile (terrain-standard-transition-preview-tile state mask-ref)]
    (draw-terrain-standard-transition-preview-tile! tile rect)
    (draw-terrain-standard-mask-fallback! rect)))

(defun draw-terrain-standard-role-slot! [state ctx]
  (let [tile (:tile state)
        mask-ref (:mask-ref state)
        overlay-ref (:overlay-ref state)
        overlay-tile (:overlay-tile state)
        label (:label state)
        tile-rect (terrain-standard-role-tile-rect state)]
    (do
      (r/rect! tile-rect
               {:fill true
                :color {:r 0x0b :g 0x0d :b 0x10}})
      (when tile
        (tr/draw-tile! tile
                       {:x (+ (:x tile-rect) 4)
                        :y (+ (:y tile-rect) 4)
                        :w (- (:w tile-rect) 8)
                        :h (- (:h tile-rect) 8)}))
      (when (and (not tile)
                 (not mask-ref)
                 (not overlay-ref)
                 (not (terrain-standard-role-uses-surround-markers? state)))
        (r/text! label
                 {:x (+ (:x tile-rect) 8)
                  :y (+ (:y tile-rect) 13)}
                 {:color {:r 0x86 :g 0x91 :b 0x9b}}))
      (when (and (not tile) overlay-tile)
        (tr/draw-tile! overlay-tile
                       {:x (+ (:x tile-rect) 4)
                        :y (+ (:y tile-rect) 4)
                        :w (- (:w tile-rect) 8)
                        :h (- (:h tile-rect) 8)}))
      (when (and (not tile) mask-ref)
        (draw-terrain-standard-transition-preview!
         state
         mask-ref
         {:x (+ (:x tile-rect) 4)
          :y (+ (:y tile-rect) 4)
          :w (- (:w tile-rect) 8)
          :h (- (:h tile-rect) 8)}))
      (draw-terrain-standard-role-markers! state)
      (r/rect! tile-rect
               {:color (if (:selected? state)
                         {:r 0x5a :g 0x9d :b 0xff}
                         terrain-standard-slot-border-color)}))))

(defcomponent terrain-standard-role-slot
  {:focusable true
   :style {:width terrain-standard-slot-size
           :height terrain-standard-slot-size
           :cursor :pointer}
   :update (fn [state ctx]
             (let [rule-id (terrain-standard-role-slot-rule-id state)
                   slot-size (terrain-standard-role-slot-size (:setup-id state))]
               (do
                 (assoc-in! ctx [:view :style :width] slot-size)
                 (assoc-in! ctx [:view :style :height] slot-size)
                 (assoc state
                        :rule-id rule-id
                        :tile (terrain-standard-role-slot-tile state)
                        :mask-ref (terrain-standard-role-slot-mask-ref state)
                        :overlay-ref (terrain-standard-role-slot-overlay-ref state)
                        :overlay-tile (terrain-standard-role-slot-overlay-tile state)
                        :selected? (and rule-id
                                        (= rule-id
                                           (:selected-terrain-rule-id
                                            state)))))))
   :on-mouse-down
   (fn [state event ctx]
     (do
       (ui/stop-propagation! event)
       (if (secondary-mouse-button? event)
         (case (terrain-standard-output-tab state)
           :masks
           (ui/emit! (:view ctx)
                     :terrain/standard-role-mask-change
                     {:setup-id (:setup-id state)
                      :role-id (:role-id state)
                      :opposing (:terrain-standard-role-cache-opposing state)
                      :mask nil})

           :overlays
           (ui/emit! (:view ctx)
                     :terrain/standard-role-overlay-change
                     {:setup-id (:setup-id state)
                      :role-id (:role-id state)
                      :opposing (:terrain-standard-role-cache-opposing state)
                      :overlay nil})

           :default
           (ui/emit! (:view ctx)
                     :terrain/standard-role-tile-change
                     {:setup-id (:setup-id state)
                      :role-id (:role-id state)
                      :opposing (:terrain-standard-role-cache-opposing state)
                      :tile nil}))
         (case (terrain-standard-output-tab state)
           :masks
           (if-let [mask-ref (:terrain-rule-selected-mask state)]
             (ui/emit! (:view ctx)
                       :terrain/standard-role-mask-change
                       {:setup-id (:setup-id state)
                        :role-id (:role-id state)
                        :opposing (:terrain-standard-role-cache-opposing state)
                        :mask (model/mask-ref-with-polarity
                               mask-ref
                               (:terrain-rule-mask-polarity state))})
             (when (:rule-id state)
               (ui/emit! (:view ctx)
                         :terrain/rule-select
                         (:rule-id state))))

           :overlays
           (if-let [tile-ref (:terrain-rule-selected-tile state)]
             (ui/emit! (:view ctx)
                       :terrain/standard-role-overlay-change
                       {:setup-id (:setup-id state)
                        :role-id (:role-id state)
                        :opposing (:terrain-standard-role-cache-opposing state)
                        :overlay tile-ref})
             (when (:rule-id state)
               (ui/emit! (:view ctx)
                         :terrain/rule-select
                         (:rule-id state))))

           :default
           (if-let [tile-ref (:terrain-rule-selected-tile state)]
             (ui/emit! (:view ctx)
                       :terrain/standard-role-tile-change
                       {:setup-id (:setup-id state)
                        :role-id (:role-id state)
                        :opposing (:terrain-standard-role-cache-opposing state)
                        :tile tile-ref})
             (when (:rule-id state)
               (ui/emit! (:view ctx)
                         :terrain/rule-select
                         (:rule-id state))))))
       state))
   :on-drop
   (fn [state event ctx]
     (let [payload (:payload event)]
       (case (:kind payload)
         :terrain-rule/mask-output
         (do
           (ui/stop-propagation! event)
           (ui/emit! (:view ctx)
                     :terrain/standard-role-mask-change
                     {:setup-id (:setup-id state)
                      :role-id (:role-id state)
                      :opposing (:terrain-standard-role-cache-opposing state)
                      :mask (:mask payload)})
           state)

         :default
         (if (terrain-stamp-tile-drag-payload? payload)
           (do
             (ui/stop-propagation! event)
             (case (terrain-standard-output-tab state)
               :overlays
               (ui/emit! (:view ctx)
                         :terrain/standard-role-overlay-change
                         {:setup-id (:setup-id state)
                          :role-id (:role-id state)
                          :opposing (:terrain-standard-role-cache-opposing state)
                          :overlay (:tile payload)})

               :tiles
               (ui/emit! (:view ctx)
                         :terrain/standard-role-tile-change
                         {:setup-id (:setup-id state)
                          :role-id (:role-id state)
                          :opposing (:terrain-standard-role-cache-opposing state)
                          :tile (:tile payload)})

               :default
               nil)
             state)
           state))))
   :render draw-terrain-standard-role-slot!})

(defun terrain-standard-role-slot-child [setup-id role-id label]
  {:mode 'terrain-standard-role-slot
   :state {:setup-id setup-id
           :role-id role-id
           :label label
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :terrain-rule-selected-tile
           (ui/bind-state :terrain-rule-selected-tile)
           :terrain-rule-selected-mask
           (ui/bind-state :terrain-rule-selected-mask)
           :terrain-rule-mask-polarity
           (ui/bind-state :terrain-rule-mask-polarity)
           :terrain-standard-output-picker-tab
           (ui/bind-state :terrain-standard-output-picker-tab)
           :tilesets (ui/bind-state :tilesets)
           :mask-sets (ui/bind-state :mask-sets)
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :terrain-standard-role-cache-opposing
           (ui/bind-state :terrain-standard-role-cache-opposing)
           :terrain-standard-role-slots
           (ui/bind-state :terrain-standard-role-slots)}})

(defun terrain-standard-role-placeholder-child [setup-id]
  (let [slot-size (terrain-standard-role-slot-size setup-id)]
    {:style {:width slot-size
             :height slot-size}}))

(defun terrain-standard-role-cell-child [setup role-id]
  (if role-id
    (terrain-standard-role-slot-child (:id setup)
                                      role-id
                                      (model/terrain-standard-role-label
                                       (:id setup)
                                       role-id))
    (terrain-standard-role-placeholder-child (:id setup))))

(defun terrain-standard-setup-row-child [setup row]
  (let [slot-size (terrain-standard-role-slot-size (:id setup))]
    {:style {:width :shrink
             :height slot-size
             :layout {:direction :row
                      :gap terrain-standard-slot-gap}}
     :state (ui/bind-state)
     :children (map row
                    (fn [role-id]
                      (terrain-standard-role-cell-child setup role-id)))}))

(defun terrain-standard-setup-menu-items []
  (map model/terrain-standard-setup-definitions
       (fn [setup]
         {:label (:label setup)
          :type :toggle
          :action :terrain/standard-setup-visibility-toggle
          :payload (:id setup)
          :selected-path [:option-state (:id setup)]})))

(def terrain-standard-setup-menu
  {:settings {:mnemonics {:enabled false}}
   :items (terrain-standard-setup-menu-items)})

(defun terrain-standard-setup-menu-option-state [state]
  (reduce model/terrain-standard-setup-definitions
          {}
          (fn [options setup]
            (assoc options
                   (:id setup)
                   (model/terrain-standard-setup-visible?
                    state
                    (:id setup))))))

(defcomponent terrain-standard-setup-menu-button
  {:extend 'ui/button
   :style {:width 86
           :height 22}
   :on-mouse-up
   (fn [state event ctx]
     (do
       (ui/stop-propagation! event)
       (when (and (= (:button event) :left)
                  (not (:disabled? state)))
         (menu/open-context-menu!
          terrain-standard-setup-menu
          (:global-position event)
          (assoc state
                 :option-state
                 (terrain-standard-setup-menu-option-state state))
          ctx))
       state))
   :on {:menu/select
        (fn [state event ctx]
          (let [payload (:payload event)
                setup-id (-> payload :payload)]
            (do
              (ui/stop-propagation! event)
              (when (= (:type payload) :action)
                (ui/emit! (:view ctx)
                          :terrain/standard-setup-visibility-change
                          {:setup-id setup-id
                           :visible? (not (model/terrain-standard-setup-visible?
                                           state
                                           setup-id))}))
              state)))}})

(defcomponent terrain-standard-setup-panel
  {:style {:width :shrink
           :height :shrink
           :layout {:direction :column
                    :gap 6}}
   :update (fn [state ctx]
             (let [visible? (model/terrain-standard-setup-visible?
                             state
                             (:setup-id state))]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if visible? :visible :none))
                 (assoc-in! ctx
                            [:view :style :width]
                            (if visible? :shrink 0))
                 (assoc-in! ctx
                            [:view :style :height]
                            (if visible? :shrink 0))
                 state)))})

(defun terrain-standard-setup-panel-state [setup]
  {:setup-id (:id setup)
   :terrain-sets (ui/bind-state :terrain-sets)
   :tilesets (ui/bind-state :tilesets)
   :mask-sets (ui/bind-state :mask-sets)
   :selected-terrain-set-index
   (ui/bind-state :selected-terrain-set-index)
   :selected-terrain-index
   (ui/bind-state :selected-terrain-index)
   :selected-terrain-rule-id
   (ui/bind-state :selected-terrain-rule-id)
   :terrain-rule-selected-tile
   (ui/bind-state :terrain-rule-selected-tile)
   :terrain-rule-selected-mask
   (ui/bind-state :terrain-rule-selected-mask)
   :terrain-rule-mask-polarity
   (ui/bind-state :terrain-rule-mask-polarity)
   :terrain-standard-role-cache-opposing
   (ui/bind-state :terrain-standard-role-cache-opposing)
   :terrain-standard-role-slots
   (ui/bind-state :terrain-standard-role-slots)})

(defun terrain-standard-setup-panel-child [setup]
  {:mode 'terrain-standard-setup-panel
   :state (terrain-standard-setup-panel-state setup)
   :children (concat [{:mode 'ui/text
                       :class :ui/title
                       :state {:value (:label setup)}}]
                     (map (:matrix setup)
                          (fn [row]
                            (terrain-standard-setup-row-child setup row))))})

(defun terrain-standard-setup-panel-groups-content-child []
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :wrap :line
                    :align-items :start
                    :gap terrain-standard-setup-panel-column-gap
                    :line-gap terrain-standard-setup-panel-row-gap}}
   :state (ui/bind-state)
   :children (map model/terrain-standard-setup-definitions
                  terrain-standard-setup-panel-child)})

(defun terrain-standard-setup-panel-scroll-content-style [state]
  {:position :absolute
   :left 0
   :top (* -1 (or (:offset state) 0))
   :width :fill
   :height terrain-standard-setup-panel-content-height})

(defcomponent terrain-standard-setup-panel-scroll-viewport
  {:style {:width :fill
           :height :fill
           :clip true}
   :update (fn [state ctx]
             (let [children (ui/children ctx)]
               (do
                 (when (> (count children) 0)
                   (ui/style! (nth children 0)
                              (terrain-standard-setup-panel-scroll-content-style
                               state)))
                 state)))
   :children [(terrain-standard-setup-panel-groups-content-child)]})

(defcomponent terrain-standard-setup-panel-scroll-row
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :init (fn [state ctx]
           (assoc state
                  :offset 0
                  :content-height terrain-standard-setup-panel-content-height))
   :children [{:mode 'terrain-standard-setup-panel-scroll-viewport
               :state {:offset (ui/bind-state :offset)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :tilesets (ui/bind-state :tilesets)
                       :mask-sets (ui/bind-state :mask-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :selected-terrain-index
                       (ui/bind-state :selected-terrain-index)
                       :selected-terrain-rule-id
                       (ui/bind-state :selected-terrain-rule-id)
                       :terrain-rule-selected-tile
                       (ui/bind-state :terrain-rule-selected-tile)
                       :terrain-rule-selected-mask
                       (ui/bind-state :terrain-rule-selected-mask)
                       :terrain-rule-mask-polarity
                       (ui/bind-state :terrain-rule-mask-polarity)
                       :terrain-standard-role-cache-opposing
                       (ui/bind-state :terrain-standard-role-cache-opposing)
                       :terrain-standard-role-slots
                       (ui/bind-state :terrain-standard-role-slots)}}
              {:mode 'ui/scrollbar
               :class :scrollbar/v
               :style {:height :fill}
               :state {:axis :y
                       :value (ui/bind-state :offset)
                       :step 48
                       :content-size (ui/bind-state :content-height)}}]})

(defun terrain-standard-setup-panel-groups-child []
  {:mode 'terrain-standard-setup-panel-scroll-row
   :state {:terrain-sets (ui/bind-state :terrain-sets)
           :tilesets (ui/bind-state :tilesets)
           :mask-sets (ui/bind-state :mask-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :terrain-rule-selected-tile
           (ui/bind-state :terrain-rule-selected-tile)
           :terrain-rule-selected-mask
           (ui/bind-state :terrain-rule-selected-mask)
           :terrain-rule-mask-polarity
           (ui/bind-state :terrain-rule-mask-polarity)
           :terrain-standard-role-cache-opposing
           (ui/bind-state :terrain-standard-role-cache-opposing)
           :terrain-standard-role-slots
           (ui/bind-state :terrain-standard-role-slots)}})

(defun terrain-standard-opposing-terrain-menu-item [terrain]
  {:label (model/terrain-standard-opposing-terrain-label terrain)
   :type :toggle
   :action :terrain/standard-opposing-menu
   :payload {:action :toggle-terrain
             :terrain-id (:id terrain)}
   :selected-path [:option-state (:id terrain)]})

(defun terrain-standard-opposing-menu-items [state]
  (let [terrain-set (model/selected-terrain-set (:terrain-sets state)
                                                (:selected-terrain-set-index
                                                 state))
        center-terrain-id (model/selected-terrain-id state)]
    (concat [{:label "None"
              :type :action
              :action :terrain/standard-opposing-menu
              :payload {:action :set-opposing
                        :opposing :none}}
             {:label "Any other"
              :type :action
              :action :terrain/standard-opposing-menu
              :payload {:action :set-opposing
                        :opposing :any-other}}]
            (map (filter (or (:terrains terrain-set) [])
                         (fn [terrain]
                           (not= (:id terrain) center-terrain-id)))
                 terrain-standard-opposing-terrain-menu-item))))

(defun terrain-standard-opposing-menu [state]
  {:settings {:mnemonics {:enabled false}}
   :items (terrain-standard-opposing-menu-items state)})

(defun terrain-standard-opposing-menu-option-state [state]
  (reduce (model/terrain-standard-opposing-terrain-values state)
          {}
          (fn [options terrain-id]
            (assoc options
                   terrain-id
                   (model/terrain-standard-opposing-selected?
                    state
                    terrain-id)))))

(defcomponent terrain-standard-opposing-selector
  {:extend 'ui/button
   :style {:width 180
           :height 22}
   :update (fn [state ctx]
             (assoc state
                    :label (model/terrain-standard-opposing-label
                            state
                            (model/selected-terrain-standard-opposing state))
                    :disabled? (nil? (model/selected-terrain-id state))))
   :on-mouse-up
   (fn [state event ctx]
     (do
       (ui/stop-propagation! event)
       (when (and (= (:button event) :left)
                  (not (:disabled? state)))
         (menu/open-context-menu!
          (terrain-standard-opposing-menu state)
          (:global-position event)
          (assoc state
                 :option-state
                 (terrain-standard-opposing-menu-option-state state))
          ctx))
       state))
   :on {:menu/select
        (fn [state event ctx]
          (let [payload (:payload event)
                action-payload (-> payload :payload)
                action (:action action-payload)]
            (do
              (ui/stop-propagation! event)
              (when (= (:type payload) :action)
                (ui/emit! (:view ctx)
                          :terrain/standard-opposing-change
                          (case action
                            :set-opposing (:opposing action-payload)
                            :toggle-terrain
                            (model/toggle-terrain-standard-opposing
                             state
                             (:terrain-id action-payload))
                            :default
                            (model/selected-terrain-standard-opposing
                             state))))
              state)))}})

(defun terrain-standard-mask-drag-payload? [payload]
  (= (:kind payload) :terrain-rule/mask-output))

(defun terrain-standard-mask-options [state]
  (model/terrain-mask-options-for-selected-terrain state))

(defun terrain-standard-mask-picker-content-height [state]
  (let [options (terrain-standard-mask-options state)
        columns (terrain-stamp-tile-picker-columns
                 {:w terrain-stamp-tile-picker-width})]
    (terrain-stamp-tile-picker-content-height (count options) columns)))

(defun terrain-standard-mask-picker-content-size [state]
  {:w terrain-stamp-tile-picker-width
   :h (terrain-standard-mask-picker-content-height state)})

(defun terrain-standard-mask-picker-content-state [state]
  {:terrain-sets (:terrain-sets state)
   :selected-terrain-set-index (:selected-terrain-set-index state)
   :selected-terrain-index (:selected-terrain-index state)
   :terrain-standard-opposing (:terrain-standard-opposing state)
   :terrain-rule-selected-mask (:terrain-rule-selected-mask state)
   :terrain-rule-mask-polarity (:terrain-rule-mask-polarity state)
   :tilesets (:tilesets state)
   :mask-sets (:mask-sets state)})

(defun terrain-standard-mask-at-picker-index [state index]
  (when (not (nil? index))
    (nth (terrain-standard-mask-options state) index)))

(defun terrain-standard-mask-option-from-drag [state event ctx]
  (if (contains? state :value)
    {:value (:value state)
     :label (:label state)}
    (let [index (terrain-stamp-tile-picker-index-at-position
                 (:start-position event)
                 (-> ctx :view :bounds)
                 (count (terrain-standard-mask-options state)))]
      (terrain-standard-mask-at-picker-index state index))))

(defun terrain-standard-mask-drag-payload [state event ctx]
  (when-let [option (terrain-standard-mask-option-from-drag state event ctx)]
    {:kind :terrain-rule/mask-output
     :mask (model/mask-ref-with-polarity
            (:value option)
            (:terrain-rule-mask-polarity state))
     :label (:label option)}))

(defun select-terrain-standard-mask-at-event! [state event ctx]
  (let [index (terrain-stamp-tile-picker-index-at-position
               (:position event)
               (-> ctx :view :bounds)
               (count (terrain-standard-mask-options state)))
        option (terrain-standard-mask-at-picker-index state index)]
    (do
      (ui/stop-propagation! event)
      (ui/focus! ctx)
      (when option
        (ui/emit! (:view ctx)
                  :terrain/rule-stamp-mask-select
                  (:value option)))
      state)))

(defun draw-terrain-standard-mask-picker-cell! [state option index columns]
  (let [rect (terrain-stamp-tile-picker-cell-rect index columns)
        mask-ref (model/mask-ref-with-polarity
                  (:value option)
                  (:terrain-rule-mask-polarity state))]
    (do
      (r/rect! rect {:fill true
                     :color {:r 0x12 :g 0x15 :b 0x18}})
      (draw-terrain-standard-transition-preview!
       state
       mask-ref
       {:x (+ (:x rect) 4)
        :y (+ (:y rect) 4)
        :w (- (:w rect) 8)
        :h (- (:h rect) 8)})
      (r/rect! rect {:color {:r 0x1f :g 0x26 :b 0x2d}})
      (when (contains? (:selected-indices state) index)
        (r/rect! (terrain-stamp-tile-picker-selected-rect rect)
                 {:color {:r 0xff :g 0xcc :b 0x66}})))))

(defcomponent terrain-standard-mask-picker-grid
  {:focusable true
   :class :ui/content
   :style {:width :fill
           :height :fill
           :clip true
           :cursor :pointer}
   :drag {:start {:mode :threshold
                  :distance 3}
          :payload terrain-standard-mask-drag-payload}
   :on-drag-start emit-terrain-stamp-tile-drag-start!
   :on-drag emit-terrain-stamp-tile-drag-move!
   :on-drag-end emit-terrain-stamp-tile-drag-end!
   :update (fn [state ctx]
             (assoc state
                    :selected-indices
                    (model/terrain-rule-selected-mask-indices state)))
   :on-mouse-down select-terrain-standard-mask-at-event!
   :render (fn [state ctx]
             (let [options (terrain-standard-mask-options state)
                   columns (terrain-stamp-tile-picker-columns
                            (-> ctx :view :bounds))]
               (for-indexed [index option options]
                 (draw-terrain-standard-mask-picker-cell!
                  state
                  option
                  index
                  columns))))})

(defcomponent terrain-standard-mask-picker-scroll-pane
  {:style {:width terrain-stamp-tile-picker-width
           :height :fill}
   :update (fn [state ctx]
             (assoc state
                    :content-size
                    (terrain-standard-mask-picker-content-size state)
                    :picker-state
                    (terrain-standard-mask-picker-content-state state)))
   :children [(sp/make {:style {:width :fill
                                :height :fill}
                        :content-size {:w terrain-stamp-tile-picker-width
                                       :h terrain-stamp-tile-picker-height}
                        :state {:content-size (ui/bind-state :content-size)
                                :content-state (ui/bind-state :picker-state)}
                        :scroll-x? false
                        :scroll-y? :auto
                        :step (terrain-stamp-tile-picker-stride)
                        :children [{:mode 'terrain-standard-mask-picker-grid
                                    :style {:width :fill
                                            :height :fill}
                                    :state (ui/bind-state)}]})]})

(defcomponent terrain-standard-mask-polarity-selector
  {:style {:width :fill
           :height 22}
   :update (fn [state ctx]
             (assoc state
                    :mask-polarity-options
                    model/terrain-rule-mask-polarity-options
                    :selected-mask-polarity-index
                    (model/terrain-rule-mask-polarity-index state)))
   :on {:combo-box/change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/rule-stamp-mask-polarity-change
                      (:value payload))
            (assoc state
                   :terrain-rule-mask-polarity (:value payload)
                   :selected-mask-polarity-index
                   (:selected-index payload))))}
   :children [(cb/make {:options (ui/bind-state :mask-polarity-options)
                        :selected-index
                        (ui/bind-state :selected-mask-polarity-index)})]})

(defcomponent terrain-standard-mask-picker
  {:style {:width terrain-stamp-tile-picker-width
           :height terrain-stamp-tile-picker-height
           :layout {:direction :column
                    :gap 6}}
   :children [{:mode 'ui/text
               :class :ui/title
               :state {:value "Masks"}}
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 6}}
               :state (ui/bind-state)
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width 56}
                           :state {:value "Polarity"}}
                          {:mode 'terrain-standard-mask-polarity-selector
                          :state {:terrain-rule-mask-polarity
                                   (ui/bind-state
                                    :terrain-rule-mask-polarity)}}]}
              {:mode 'terrain-standard-mask-picker-scroll-pane
               :state (ui/bind-state)}]})

(defun terrain-standard-output-picker-state []
  {:rulesets (ui/bind-state :rulesets)
   :selected-terrain-ruleset-id
   (ui/bind-state :selected-terrain-ruleset-id)
   :selected-terrain-rule-id
   (ui/bind-state :selected-terrain-rule-id)
   :selected-terrain-rule-match-direction
   (ui/bind-state :selected-terrain-rule-match-direction)
   :terrain-rule-selected-tile
   (ui/bind-state :terrain-rule-selected-tile)
   :terrain-rule-selected-mask
   (ui/bind-state :terrain-rule-selected-mask)
   :terrain-rule-mask-polarity
   (ui/bind-state :terrain-rule-mask-polarity)
   :terrain-standard-opposing
   (ui/bind-state :terrain-standard-opposing)
   :terrain-sets (ui/bind-state :terrain-sets)
   :selected-terrain-set-index
   (ui/bind-state :selected-terrain-set-index)
   :selected-terrain-index
   (ui/bind-state :selected-terrain-index)
   :tilesets (ui/bind-state :tilesets)
   :mask-sets (ui/bind-state :mask-sets)
   :layers (ui/bind-state :layers)
   :layer-profiles (ui/bind-state :layer-profiles)
   :selected-layer-profile-id
   (ui/bind-state :selected-layer-profile-id)})

(defun terrain-standard-output-picker-tabs-panel []
  (tabs/make
   {:selected-tab (ui/bind-state :terrain-standard-output-picker-tab)
    :style {:width terrain-stamp-tile-picker-width
            :height :fill}
    :state (terrain-standard-output-picker-state)
    :tabs [{:id :tiles
            :label "Tiles"
            :child {:mode 'terrain-stamp-tile-picker-scroll-pane
                    :state (ui/bind-state)}}
           {:id :overlays
            :label "Overlays"
            :child {:mode 'terrain-stamp-tile-picker-scroll-pane
                    :state (ui/bind-state)}}
           {:id :masks
            :label "Masks"
            :child {:mode 'terrain-standard-mask-picker
                    :state (ui/bind-state)}}]}))

(defcomponent terrain-standard-output-picker-tabs
  {:style {:width terrain-stamp-tile-picker-width
           :height :fill}
   :on {:tab-panel/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (assoc state
                   :terrain-standard-output-picker-tab
                   (-> event :payload :tab))))}
   :children [(terrain-standard-output-picker-tabs-panel)]})

(defcomponent terrain-standard-setup-editor
  {:style {:width :fill
           :height :fill
           :padding [10 12]
           :layout {:direction :row
                    :gap 12}}
   :children [{:style {:width :fill
                       :height :fill
                       :layout {:direction :column
                                :gap 10}}
               :state (ui/bind-state)
               :children [{:style {:width :fill
                                   :height 24
                                   :layout {:direction :row
                                            :align-items :center
                                            :gap 8}}
                           :state (ui/bind-state)
                           :children [{:mode 'ui/text
                                       :state {:value "Opposing"}}
                                      {:mode 'terrain-standard-opposing-selector
                                       :state (ui/bind-state)}
                                      {:mode 'terrain-standard-setup-menu-button
                                       :state {:label "Groups"
                                               :terrain-sets
                                               (ui/bind-state :terrain-sets)
                                               :selected-terrain-set-index
                                               (ui/bind-state
                                                :selected-terrain-set-index)
                                               :selected-terrain-index
                                               (ui/bind-state
                                                :selected-terrain-index)}}]}
                          {:style {:width :fill
                                   :height :fill}
                           :state (ui/bind-state)
                           :children [(terrain-standard-setup-panel-groups-child)]}]}
              {:style {:width terrain-stamp-tile-picker-width
                       :height :fill
                       :layout {:direction :column
                                :gap 8}}
               :state (ui/bind-state)
               :children [{:mode 'terrain-standard-output-picker-tabs
                           :state (terrain-standard-output-picker-state)}]}]})

(defcomponent terrain-rule-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height terrain-rule-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (menu/open-context-menu! terrain-rule-context-menu
                                               (:global-position event)
                                               state
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :terrain/rule-context-command
                                       {:rule-id (:value state)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun terrain-rule-row-child [index option]
  {:mode 'terrain-rule-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun terrain-rule-list-child [state]
  (let [options (model/terrain-rule-options state)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-rule-list-row-height
              :visible-rows 5
              :content-width 180
              :disabled? (empty? options)
              :state {:offset (ui/bind-state :terrain-rule-list-offset)}
              :selected-indices (ui/bind-state :selected-indices)
              :reorderable? true
              :force-selection? true
              :item-child terrain-rule-row-child})))

(defcomponent terrain-rule-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-rulesets nil
                  :rendered-terrain-set-index nil
                  :rendered-terrain-index nil
                  :rendered-ruleset-id nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [rulesets (or (:rulesets state) [])
                   terrain-set-index (:selected-terrain-set-index state)
                   terrain-index (:selected-terrain-index state)
                   ruleset-id (model/selected-terrain-ruleset-id state)
                   selected-indices (if-let [index (model/selected-terrain-rule-index
                                                    state)]
                                      [index]
                                      [])]
               (do
                 (when (or (not= rulesets (:rendered-rulesets state))
                           (not= terrain-set-index
                                 (:rendered-terrain-set-index state))
                           (not= terrain-index (:rendered-terrain-index state))
                           (not= ruleset-id (:rendered-ruleset-id state)))
                   (ui/replace-child! (:view ctx)
                                      "terrain-rule-list-box"
                                      (merge {:id "terrain-rule-list-box"}
                                             (terrain-rule-list-child
                                              state))))
                 (assoc state
                        :rendered-rulesets rulesets
                        :rendered-terrain-set-index terrain-set-index
                        :rendered-terrain-index terrain-index
                        :rendered-ruleset-id ruleset-id
                        :selected-indices selected-indices))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :terrain/rule-select
                                       (-> event :payload :value))
                             state))
        :list-box/reorder (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (ui/emit! (:view ctx)
                                        :terrain/rule-reorder
                                        (:payload event))
                             state))}
   :children [(merge {:id "terrain-rule-list-box"}
                     (terrain-rule-list-child {}))]})

(defun terrain-id-by-index [state terrain-index]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))
        terrain (when (and terrain-set
                           (not (nil? terrain-index))
                           (< terrain-index (count (or (:terrains terrain-set) []))))
                  (nth (:terrains terrain-set) terrain-index))]
    (if terrain
      (model/keyword-label (:id terrain))
      "")))

(defun open-terrain-name-dialog! [state ctx operation terrain-index title name id]
  (do
    (id-name-dialog/open! ctx
                          {:title title
                           :id id
                           :name name
                           :result-event :terrain/name-dialog-result
                           :context {:operation operation
                                     :terrain-index terrain-index}})
    state))

(defun open-terrain-set-add-dialog! [state ctx]
  (let [terrain-set (model/make-terrain-set (:terrain-sets state)
                                            (:tilesets state))]
    (do
      (id-name-dialog/open! ctx
                            {:title "Add Terrain Set"
                             :id (model/keyword-label (:id terrain-set))
                             :name (or (:label terrain-set) "")
                             :result-event :terrain/set-add-dialog-result})
      state)))

(defun open-terrain-add-dialog! [state ctx]
  (if-let [set-index (model/selected-terrain-set-index
                      (:terrain-sets state)
                      (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrain (model/make-terrain terrain-set (:tilesets state))]
      (do
        (id-name-dialog/open! ctx
                              {:title "Add Terrain"
                               :id (model/keyword-label (:id terrain))
                               :name (or (:label terrain) "")
                               :result-event :terrain/name-dialog-result
                               :context {:operation :add
                                         :terrain-set-index set-index}})
        state))
    state))

(defun open-terrain-set-edit-dialog! [state ctx]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))]
    (if terrain-set
      (do
        (id-name-dialog/open! ctx
                              {:title "Rename Terrain Set"
                               :id (model/keyword-label (:id terrain-set))
                               :name (or (:label terrain-set) "")
                               :result-event :terrain/set-edit-dialog-result})
        state)
      state)))

(defun open-terrain-set-delete-confirm-dialog! [state ctx terrain-set-index name]
  (do
    (dialog/open-confirm!
     ctx
     {:title "Delete Terrain Set"
      :body {:mode 'ui/text
             :style {:width :fill}
             :state {:value (str "Delete terrain set \"" name "\"?")}}
      :buttons [:dialog/cancel
                {:type :dialog/ok
                 :label "Delete"}]
      :result-event :terrain/set-delete-confirm-result
      :payload {:terrain-set-index terrain-set-index}})
    state))

(defun open-mask-set-add-dialog! [state ctx]
  (let [mask-set (model/make-mask-set (:mask-sets state))]
    (do
      (id-name-dialog/open! ctx
                            {:title "Add Mask Set"
                             :id (model/keyword-label (:id mask-set))
                             :name (or (:label mask-set) "")
                             :result-event :terrain/mask-set-add-dialog-result})
      state)))

(defun open-mask-set-edit-dialog! [state ctx]
  (let [mask-set (model/selected-mask-set (:mask-sets state)
                                          (:selected-mask-set-index state))]
    (if mask-set
      (do
        (id-name-dialog/open! ctx
                              {:title "Rename Mask Set"
                               :id (model/keyword-label (:id mask-set))
                               :name (or (:label mask-set) "")
                               :result-event
                               :terrain/mask-set-edit-dialog-result})
        state)
      state)))

(defun open-mask-set-delete-confirm-dialog! [state ctx]
  (let [mask-set (model/selected-mask-set (:mask-sets state)
                                          (:selected-mask-set-index state))]
    (if mask-set
      (do
        (dialog/open-confirm!
         ctx
         {:title "Delete Mask Set"
          :body {:mode 'ui/text
                 :style {:width :fill}
                 :state {:value (str "Delete mask set \""
                                     (model/mask-set-label mask-set)
                                     "\"?")}}
          :buttons [:dialog/cancel
                    {:type :dialog/ok
                     :label "Delete"}]
          :result-event :terrain/mask-set-delete-confirm-result
          :payload {:mask-set-index (:selected-mask-set-index state)}})
        state)
      state)))

(defun open-mask-add-dialog! [state ctx]
  (let [mask-set (model/selected-mask-set (:mask-sets state)
                                          (:selected-mask-set-index state))]
    (if mask-set
      (let [mask (model/make-mask (:masks mask-set))]
        (do
          (id-name-dialog/open! ctx
                                {:title "Add Mask"
                                 :id (model/keyword-label (:id mask))
                                 :name (or (:label mask) "")
                                 :result-event :terrain/mask-add-dialog-result})
          state))
      state)))

(defun open-mask-edit-dialog! [state ctx]
  (let [mask-set (model/selected-mask-set (:mask-sets state)
                                          (:selected-mask-set-index state))
        mask (model/selected-mask mask-set (:selected-mask-index state))]
    (if mask
      (do
        (id-name-dialog/open! ctx
                              {:title "Rename Mask"
                               :id (model/keyword-label (:id mask))
                               :name (or (:label mask) "")
                               :result-event :terrain/mask-edit-dialog-result})
        state)
      state)))

(defun open-mask-delete-confirm-dialog! [state ctx]
  (let [mask-set (model/selected-mask-set (:mask-sets state)
                                          (:selected-mask-set-index state))
        mask (model/selected-mask mask-set (:selected-mask-index state))]
    (if mask
      (do
        (dialog/open-confirm!
         ctx
         {:title "Delete Mask"
          :body {:mode 'ui/text
                 :style {:width :fill}
                 :state {:value (str "Delete mask \""
                                     (model/mask-label mask)
                                     "\"?")}}
          :buttons [:dialog/cancel
                    {:type :dialog/ok
                     :label "Delete"}]
          :result-event :terrain/mask-delete-confirm-result
          :payload {:mask-index (:selected-mask-index state)}})
        state)
      state)))

(defun open-terrain-delete-confirm-dialog! [state ctx terrain-index name]
  (do
    (dialog/open-confirm!
     ctx
     {:title "Delete Terrain"
      :body {:mode 'ui/text
             :style {:width :fill}
             :state {:value (str "Delete terrain \"" name "\"?")}}
      :buttons [:dialog/cancel
                {:type :dialog/ok
                 :label "Delete"}]
      :result-event :terrain/delete-confirm-result
      :payload {:terrain-index terrain-index}})
    state))

(defun open-terrain-rule-name-dialog! [state ctx rule-id name]
  (do
    (push-mode! 'terrain-rule-name-dialog-modal
                {:rule-id rule-id
                 :name name}
                {:origin {:view (:view ctx)
                          :event :terrain/rule-name-dialog-result}})
    state))

(defun open-terrain-rule-delete-confirm-dialog! [state ctx rule-id name]
  (do
    (dialog/open-confirm!
     ctx
     {:title "Delete Terrain Rule"
      :body {:mode 'ui/text
             :style {:width :fill}
             :state {:value (str "Delete terrain rule \"" name "\"?")}}
      :buttons [:dialog/cancel
                {:type :dialog/ok
                 :label "Delete"}]
      :result-event :terrain/rule-delete-confirm-result
      :payload {:rule-id rule-id}})
    state))

(defcomponent terrain-rule-name-dialog-body
  {:class :ui/content
   :style {:width 260
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :children [{:mode 'ui/text
               :state {:value "Rule name:"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :name)
                       :auto-focus? true}}
              {:mode 'terrain-rule-name-dialog-buttons
               :state {:name (ui/bind-state :name)}}]})

(defcomponent terrain-rule-name-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :terrain-rule-name-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "OK"
                       :name (ui/bind-state :name)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :terrain-rule-name-dialog/confirm
                                       {:name (:name state)})
                             state))}]})

(defmode terrain-rule-name-dialog-modal
  {:on {:terrain-rule-name-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel
                        :rule-id (:rule-id state)})
            state))
        :terrain-rule-name-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :confirm
                        :rule-id (:rule-id state)
                        :name (-> event :payload :name)})
            state))}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title "Rename Terrain Rule"}
                       :state {:rule-id (ui/bind-state :rule-id)
                               :name (ui/bind-state :name)}
                       :body [{:mode 'terrain-rule-name-dialog-body
                               :state {:name (ui/bind-state :name)}}]})]})

(defcomponent terrain-rule-manual-editor
  {:style {:width :fill
           :height :fill
           :padding [10 12]
           :layout {:direction :row
                    :gap 12}}
   :children [{:style {:width 196
                       :height :fill
                       :layout {:direction :column
                                :gap 6}}
               :state (ui/bind-state)
               :children [{:style {:width :fill
                                   :height 24
                                   :layout {:direction :row
                                            :align-items :center
                                            :gap 6}}
                           :children [{:mode 'ui/text
                                       :style {:width :fill}
                                       :state {:value "Terrain rules"}}
                                      (terrain-rule-add-button-child
                                       "+"
                                       :ui/toolbar-button)]}
                          {:mode 'terrain-rule-list
                           :state {:terrain-sets
                                   (ui/bind-state :terrain-sets)
                                   :selected-terrain-set-index
                                   (ui/bind-state
                                    :selected-terrain-set-index)
                                   :selected-terrain-index
                                   (ui/bind-state
                                    :selected-terrain-index)
                                   :rulesets
                                   (ui/bind-state :rulesets)
                                   :selected-terrain-ruleset-id
                                   (ui/bind-state
                                    :selected-terrain-ruleset-id)
                                   :selected-terrain-rule-id
                                   (ui/bind-state
                                    :selected-terrain-rule-id)
                                   :terrain-rule-list-offset
                                   (ui/bind-state
                                    :terrain-rule-list-offset)}}]}
              {:style {:width :fill
                       :height :fill
                       :layout {:direction :column
                                :gap 6}}
               :state (ui/bind-state)
               :children [{:mode 'terrain-rule-visual-editor
                           :state {:terrain-sets
                                   (ui/bind-state :terrain-sets)
                                   :selected-terrain-set-index
                                   (ui/bind-state
                                    :selected-terrain-set-index)
                                   :selected-terrain-index
                                   (ui/bind-state
                                    :selected-terrain-index)
                                   :rulesets
                                   (ui/bind-state :rulesets)
                                   :selected-terrain-ruleset-id
                                   (ui/bind-state
                                    :selected-terrain-ruleset-id)
                                   :selected-terrain-rule-id
                                   (ui/bind-state
                                    :selected-terrain-rule-id)
                                   :selected-terrain-rule-exclusive?
                                   (ui/bind-state
                                    :selected-terrain-rule-exclusive?)
                                   :selected-terrain-rule-match-direction
                                   (ui/bind-state
                                    :selected-terrain-rule-match-direction)
                                   :selected-terrain-rule-output-position
                                   (ui/bind-state
                                    :selected-terrain-rule-output-position)
                                   :terrain-rule-selected-tile
                                   (ui/bind-state
                                    :terrain-rule-selected-tile)
                                   :rule-add-disabled?
                                   (ui/bind-state
                                    :rule-add-disabled?)
                                   :tilesets
                                   (ui/bind-state :tilesets)}}]}]})

(defun terrain-rule-editor-tabs-panel []
  (tabs/make
   {:selected-tab (ui/bind-state :terrain-rule-editor-tab)
    :style {:width :fill
            :height :fill}
    :state {:terrain-sets (ui/bind-state :terrain-sets)
            :tilesets (ui/bind-state :tilesets)
            :mask-sets (ui/bind-state :mask-sets)
            :property-sets (ui/bind-state :property-sets)
            :rulesets (ui/bind-state :rulesets)
            :layers (ui/bind-state :layers)
            :layer-profiles (ui/bind-state :layer-profiles)
            :selected-layer-profile-id
            (ui/bind-state :selected-layer-profile-id)
            :selected-terrain-set-index
            (ui/bind-state :selected-terrain-set-index)
            :selected-terrain-index
            (ui/bind-state :selected-terrain-index)
            :selected-terrain-ruleset-id
            (ui/bind-state :selected-terrain-ruleset-id)
            :selected-terrain-rule-id
            (ui/bind-state :selected-terrain-rule-id)
            :selected-terrain-rule-exclusive?
            (ui/bind-state :selected-terrain-rule-exclusive?)
            :selected-terrain-rule-match-direction
            (ui/bind-state :selected-terrain-rule-match-direction)
            :selected-terrain-rule-output-position
            (ui/bind-state :selected-terrain-rule-output-position)
            :terrain-rule-selected-tile
            (ui/bind-state :terrain-rule-selected-tile)
            :terrain-rule-selected-mask
            (ui/bind-state :terrain-rule-selected-mask)
            :terrain-rule-mask-polarity
            (ui/bind-state :terrain-rule-mask-polarity)
            :terrain-rule-list-offset
            (ui/bind-state :terrain-rule-list-offset)
            :terrain-rule-editor-tab
            (ui/bind-state :terrain-rule-editor-tab)
            :terrain-standard-opposing
            (ui/bind-state :terrain-standard-opposing)
            :terrain-standard-role-cache-opposing
            (ui/bind-state :terrain-standard-role-cache-opposing)
            :terrain-standard-role-slots
            (ui/bind-state :terrain-standard-role-slots)
            :rule-add-disabled?
            (ui/bind-state :rule-add-disabled?)}
    :tabs [{:id :rules
            :label "Rule Editor"
            :child {:mode 'terrain-rule-manual-editor
                    :state (ui/bind-state)}}
           {:id :setups
            :label "Semantic Roles"
            :child {:mode 'terrain-standard-setup-editor
                    :state (ui/bind-state)}}]}))

(defcomponent terrain-rule-editor-tabs
  {:style {:width :fill
           :height :fill}
   :on {:tab-panel/change (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (assoc state
                                     :terrain-rule-editor-tab
                                     (-> event :payload :tab))))}
   :children [(terrain-rule-editor-tabs-panel)]})

(defcomponent terrain-value-detail-editor
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   terrain (model/selected-terrain terrain-set
                                                   (:selected-terrain-index
                                                    state))]
               (assoc state
                      :property-set-ids (:property-sets terrain-set)
                      :property-default-values (:properties terrain-set)
                      :property-override-values (:properties terrain)
                      :rule-add-disabled?
                      (= (:terrain-disabled? state) true)
                      :selected-rule? (not (nil? (model/selected-terrain-rule
                                                  state))))))
   :on {:property-value/change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (do
              (ui/stop-propagation! event)
              (property-model/set-selected-terrain-property-value
               state
               (:property-id payload)
               (:value payload)))))}
   :children [(terrain-value-detail-header-child)
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 8}}
               :state (ui/bind-state)
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width 92}
                           :state {:value "Mask set"}}
                          {:mode 'terrain-transition-mask-set-selector
                           :state {:terrain-sets
                                   (ui/bind-state :terrain-sets)
                                   :selected-terrain-set-index
                                   (ui/bind-state
                                    :selected-terrain-set-index)
                                   :selected-terrain-index
                                   (ui/bind-state
                                    :selected-terrain-index)
                                   :mask-sets (ui/bind-state :mask-sets)
                                   :terrain-disabled?
                                   (ui/bind-state :terrain-disabled?)}}]}
              {:mode 'property-value-list
	               :state {:title "Terrain Properties"
	                       :kind :terrain
                       :property-sets (ui/bind-state :property-sets)
                       :property-set-ids
                       (ui/bind-state :property-set-ids)
                       :default-values
                       (ui/bind-state :property-default-values)
                       :override-values
                       (ui/bind-state :property-override-values)
                       :disabled? (ui/bind-state :terrain-disabled?)}}
              {:mode 'terrain-rule-editor-tabs
               :state (ui/bind-state)}]})

(defun terrain-transition-summary-field [label value]
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 92}
               :state {:value label}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value value}}]})

(defun terrain-transition-control-field [label child]
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :state (ui/bind-state)
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 92}
               :state {:value label}}
              child]})

(defun selected-mask-state-bindings []
  {:mask-sets (ui/bind-state :mask-sets)
   :selected-mask-set-index (ui/bind-state :selected-mask-set-index)
   :selected-mask-index (ui/bind-state :selected-mask-index)})

(defun mask-source-tileset-id-from-combo-payload [tilesets payload]
  (let [value (:value payload)]
    (if (number? value)
      (data/tileset-key tilesets value)
      (or value
          (data/tileset-key tilesets (:selected-index payload))))))

(defcomponent mask-source-type-selector
  {:style {:width 180
           :height 22}
   :update (fn [state ctx]
             (let [mask-set (model/selected-mask-set
                             (:mask-sets state)
                             (:selected-mask-set-index state))
                   mask (model/selected-mask mask-set
                                             (:selected-mask-index state))]
               (assoc state
                      :source-type-options model/mask-source-type-options
                      :selected-source-type-index
                      (model/mask-source-type-index mask)
                      :disabled? (nil? mask))))
   :on {:combo-box/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-source-type-change
                      (-> event :payload :value))
            state))}
   :children [(cb/make {:options (ui/bind-state :source-type-options)
                        :selected-index
                        (ui/bind-state :selected-source-type-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent mask-source-tileset-selector
  {:style {:width 180
           :height 22}
   :update (fn [state ctx]
             (let [tileset-id (model/selected-mask-source-tileset state)]
               (assoc state
                      :tileset-options (data/tileset-options (:tilesets state))
                      :selected-tileset-index
                      (data/tileset-index (:tilesets state) tileset-id)
                      :disabled? (or (:mask-editor-disabled? state)
                                     (empty? (:tilesets state))))))
   :on {:combo-box/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-source-tileset-change
                      (mask-source-tileset-id-from-combo-payload
                       (:tilesets state)
                       (:payload event)))
            state))}
   :children [(cb/make {:options (ui/bind-state :tileset-options)
                        :selected-index
                        (ui/bind-state :selected-tileset-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent mask-source-tile-selector
  {:style {:width 180
           :height 22}
   :update (fn [state ctx]
             (let [tileset-id (model/selected-mask-source-tileset state)
                   options (data/tile-options (:tilesets state) tileset-id)
                   selected-tile (:selected-mask-source-tile state)
                   selected-index (or (find-index options
                                                  (fn [option]
                                                    (= (:value option)
                                                       selected-tile)))
                                      0)
                   selected-value (:value (when (> (count options) 0)
                                            (nth options selected-index)))]
               (assoc state
                      :tile-options options
                      :selected-tile-index selected-index
                      :selected-tile selected-value
                      :disabled? (or (:mask-editor-disabled? state)
                                     (empty? options)))))
   :on {:combo-box/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-source-tile-select
                      (-> event :payload :value))
            state))}
   :children [(cb/make {:options (ui/bind-state :tile-options)
                        :selected-index
                        (ui/bind-state :selected-tile-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defun mask-add-tile-button-child []
  {:mode 'ui/button
   :style {:width 76
           :height 22}
   :state {:label "Add"
           :disabled? (ui/bind-state :mask-tile-add-disabled?)}
   :on-click (fn [state event ctx]
               (do
                 (when (not (:disabled? state))
                   (ui/emit! (:view ctx) :terrain/mask-tile-item-add))
                 state))})

(defcomponent mask-tile-offset-input
  {:style {:width 54
           :height 22}
   :on {:number-input/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-tile-item-offset-change
                      {:index (:index state)
                       :axis (:axis state)
                       :value (-> event :payload :value)})
            state))}
   :children [(ni/make {:value (ui/bind-state :value)
                        :step 1
                        :allow-negative? true
                        :style {:width 54
                                :height 22}})]})

(defun mask-tile-offset-input-child [index axis value]
  {:mode 'mask-tile-offset-input
   :state {:index index
           :axis axis
           :value value}})

(defun mask-tile-item-row-child [index item]
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :children [{:mode 'ui/text
               :style {:width 120}
               :state {:value (model/transition-id-label (:tile item))}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "X"}}
              (mask-tile-offset-input-child
               index
               :x
               (or (-> item :offset :x) 0))
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Y"}}
              (mask-tile-offset-input-child
               index
               :y
               (or (-> item :offset :y) 0))
              {:mode 'ui/button
               :style {:width 72
                       :height 22}
               :state {:label "Remove"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :terrain/mask-tile-item-delete
                                       index)
                             state))}]})

(defun mask-tile-item-list-children [items]
  (if (empty? items)
    [{:mode 'ui/text
      :class :ui/muted
      :state {:value "No tiles in this mask."}}]
    (for-indexed [index item items]
      (mask-tile-item-row-child index item))))

(defcomponent mask-tile-item-list
  {:style {:width :fill
           :height :shrink}
   :init (fn [state ctx]
           (assoc state :rendered-items nil))
   :update (fn [state ctx]
             (let [items (or (:items state) [])]
               (do
                 (when (not= items (:rendered-items state))
                   (ui/replace-child!
                    (:view ctx)
                    "mask-tile-item-list-content"
                    {:id "mask-tile-item-list-content"
                     :style {:width :fill
                             :height :shrink
                             :layout {:direction :column
                                      :gap 4}}
                     :children (mask-tile-item-list-children items)}))
                 (assoc state :rendered-items items))))
   :children [{:id "mask-tile-item-list-content"
               :style {:width :fill
                       :height :shrink
                       :layout {:direction :column
                                :gap 4}}
               :children (mask-tile-item-list-children [])}]})

(defun mask-definition-editor-children []
  [{:mode 'ui/text
    :class :ui/title
    :state {:value "Mask"}}
   (terrain-transition-summary-field
    "Name"
    (ui/bind-state :selected-mask-label))
   (terrain-transition-summary-field
    "Id"
    (ui/bind-state :selected-mask-id))
   (terrain-transition-control-field
    "Source"
    {:mode 'mask-source-type-selector
     :state (selected-mask-state-bindings)})
   (terrain-transition-control-field
    "Tileset"
    {:mode 'mask-source-tileset-selector
     :state {:mask-sets (ui/bind-state :mask-sets)
             :selected-mask-set-index
             (ui/bind-state :selected-mask-set-index)
             :selected-mask-index (ui/bind-state :selected-mask-index)
             :terrain-sets (ui/bind-state :terrain-sets)
             :selected-terrain-set-index
             (ui/bind-state :selected-terrain-set-index)
             :tilesets (ui/bind-state :tilesets)
             :mask-editor-disabled?
             (ui/bind-state :mask-editor-disabled?)}})
   (terrain-transition-control-field
    "Tile"
    {:style {:width :fill
             :height 24
             :layout {:direction :row
                      :align-items :center
                      :gap 6}}
     :state (ui/bind-state)
     :children [{:mode 'mask-source-tile-selector
                 :state {:mask-sets (ui/bind-state :mask-sets)
                         :selected-mask-set-index
                         (ui/bind-state :selected-mask-set-index)
                         :selected-mask-index
                         (ui/bind-state :selected-mask-index)
                         :terrain-sets (ui/bind-state :terrain-sets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)
                         :tilesets (ui/bind-state :tilesets)
                         :selected-mask-source-tile
                         (ui/bind-state :selected-mask-source-tile)
                         :mask-editor-disabled?
                         (ui/bind-state :mask-editor-disabled?)}}
                (mask-add-tile-button-child)]})
   {:mode 'ui/text
    :class :ui/muted
    :state {:value "Tiles"}}
   {:mode 'mask-tile-item-list
    :state {:items (ui/bind-state :selected-mask-tile-items)}}])

(defun mask-set-list-child [mask-sets selected-index]
  (let [mask-sets (or mask-sets [])
        options (model/mask-set-options mask-sets)]
    (lb/make {:options options
              :selected-indices (model/selected-mask-set-indices
                                 mask-sets
                                 selected-index)
              :force-selection? true
              :item-child mask-set-row-child
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 180
              :disabled? (empty? options)})))

(defcomponent mask-set-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-mask-sets nil
                  :rendered-selected-mask-set-index nil))
   :update (fn [state ctx]
             (let [mask-sets (or (:mask-sets state) [])
                   selected-index (:selected-mask-set-index state)]
               (do
                 (when (or (not= mask-sets (:rendered-mask-sets state))
                           (not= selected-index
                                  (:rendered-selected-mask-set-index state)))
                   (ui/replace-child!
                    (:view ctx)
                    "mask-set-list-box"
                    (merge {:id "mask-set-list-box"}
                           (mask-set-list-child mask-sets selected-index))))
                 (assoc state
                        :rendered-mask-sets mask-sets
                        :rendered-selected-mask-set-index selected-index))))
   :on {:list-box/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-set-select
                      (head (-> event :payload :selected-indices)))
            state))}
   :children [(merge {:id "mask-set-list-box"}
                     (mask-set-list-child [] nil))]})

(defun mask-list-child [mask-set selected-index]
  (let [options (model/mask-options mask-set)]
    (lb/make {:options options
              :selected-indices (model/selected-mask-indices
                                 mask-set
                                 selected-index)
              :force-selection? true
              :item-child mask-row-child
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 180
              :disabled? (empty? options)})))

(defcomponent mask-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-mask-set nil
                  :rendered-selected-mask-index nil))
   :update (fn [state ctx]
             (let [mask-set (model/selected-mask-set
                             (:mask-sets state)
                             (:selected-mask-set-index state))
                   selected-index (:selected-mask-index state)]
               (do
                 (when (or (not= mask-set (:rendered-mask-set state))
                           (not= selected-index
                                  (:rendered-selected-mask-index state)))
                   (ui/replace-child!
                    (:view ctx)
                    "mask-list-box"
                    (merge {:id "mask-list-box"}
                           (mask-list-child mask-set selected-index))))
                 (assoc state
                        :rendered-mask-set mask-set
                        :rendered-selected-mask-index selected-index))))
   :on {:list-box/change
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx)
                      :terrain/mask-select
                      (head (-> event :payload :selected-indices)))
            state))}
   :children [(merge {:id "mask-list-box"}
                     (mask-list-child nil nil))]})

(defun mask-set-toolbar-button [label event disabled?]
  {:mode 'ui/button
   :class :ui/toolbar-button
   :state {:label label
           :disabled? disabled?}
   :on-click (fn [state event-ctx ctx]
               (do
                 (when (not (:disabled? state))
                   (ui/emit! (:view ctx) event))
                 state))})

(defcomponent terrain-transition-editor
  {:style {:width :fill
           :height :fill
           :padding 8
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [options (model/transition-options state)
                   transition (model/selected-transition state)
                   transition-mask-set (model/selected-transition-mask-set
                                        state)]
               (assoc state
                      :transition-count (str (count options))
                      :transition-label (if transition
                                          (model/transition-label transition)
                                          "")
                      :transition-id (if transition
                                       (model/transition-id-label
                                        (:id transition))
                                       "")
                      :transition-base
                      (if transition
                        (model/transition-id-label (:base-terrain transition))
                        "")
                      :transition-overlay
                      (if transition
                        (model/transition-id-label
                         (:overlay-terrain transition))
                        "")
                      :transition-mask-set (if transition-mask-set
                                             (model/mask-set-label
                                              transition-mask-set)
                                             "")
                      :empty-message
                      (if (empty? options)
                        "No transition recipes for this terrain set yet."
                        ""))))
   :children [{:class :ui/panel
               :style {:width :fill
                       :height :shrink
                       :layout {:direction :column
                                :gap 8}}
               :children [{:mode 'ui/text
                           :class :ui/title
                           :state {:value "Transitions"}}
                          (terrain-transition-summary-field
                           "Recipes"
                           (ui/bind-state :transition-count))
                          (terrain-transition-summary-field
                           "Selected"
                           (ui/bind-state :transition-label))
                          (terrain-transition-summary-field
                           "Id"
                           (ui/bind-state :transition-id))
                          (terrain-transition-summary-field
                           "Base"
                           (ui/bind-state :transition-base))
                          (terrain-transition-summary-field
                           "Overlay"
                           (ui/bind-state :transition-overlay))
                          (terrain-transition-summary-field
                           "Mask set"
                           (ui/bind-state :transition-mask-set))
                          {:mode 'ui/text
                           :class :ui/muted
                           :state {:value (ui/bind-state
                                           :empty-message)}}]}]})

(defcomponent terrain-detail-empty
  {:style {:width :fill
           :height :fill}})

