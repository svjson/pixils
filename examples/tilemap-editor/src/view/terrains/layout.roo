(defun refresh-selected-ruleset-preview-after [previous-state state]
  (tilemap/refresh-terrain-stamp-preview-for-ruleset-change
   previous-state
   state
   (or (model/selected-terrain-ruleset-id previous-state)
       (model/selected-terrain-ruleset-id state))))

(defun update-selected-ruleset-preview [state update-fn]
  (refresh-selected-ruleset-preview-after state (update-fn state)))

(defcomponent terrain-definition-workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row
                    :gap 8}}
   :init (fn [state ctx]
           (model/derive-terrain-workspace-state state))
   :update (fn [state ctx]
             (model/derive-terrain-workspace-state state))
   :on {:terrain/add-set (fn [state event ctx]
                           (open-terrain-set-add-dialog! state ctx))
        :terrain/set-select (fn [state event ctx]
                              (assoc state
                                     :selected-terrain-set-index (:payload event)
                                     :selected-terrain-index nil))
        :terrain/add (fn [state event ctx]
                       (open-terrain-add-dialog! state ctx))
        :terrain/select (fn [state event ctx]
                          (assoc state :selected-terrain-index (:payload event)))
        :terrain-set/context-command
        (fn [state event ctx]
          (let [payload (:payload event)
                terrain-set-index (:terrain-set-index payload)
                command (:command payload)
                state (assoc state
                             :selected-terrain-set-index terrain-set-index
                             :selected-terrain-index nil)]
            (case command
              :rename
              (open-terrain-set-edit-dialog! state ctx)

              :delete
              (open-terrain-set-delete-confirm-dialog!
               state
               ctx
               terrain-set-index
               (model/terrain-set-label-by-index state terrain-set-index))

              :default
              state)))
        :terrain/edit
        (fn [state event ctx]
          (let [terrain-index (:selected-terrain-index state)]
            (if (nil? terrain-index)
              state
              (open-terrain-name-dialog! state
                                         ctx
                                         :rename
                                         terrain-index
                                         "Rename Terrain"
                                         (model/terrain-label-by-index
                                          state
                                          terrain-index)
                                         (terrain-id-by-index
                                          state
                                          terrain-index)))))
        :terrain/context-command
        (fn [state event ctx]
          (let [payload (:payload event)
                terrain-index (:terrain-index payload)
                command (:command payload)
                state (assoc state :selected-terrain-index terrain-index)
                terrain-set (model/selected-terrain-set
                             (:terrain-sets state)
                             (:selected-terrain-set-index state))
                terrains (or (:terrains terrain-set) [])
                name (model/terrain-label-by-index state terrain-index)]
            (case command
              :rename
              (open-terrain-name-dialog! state
                                         ctx
                                         :rename
                                         terrain-index
                                         "Rename Terrain"
                                         name
                                         (terrain-id-by-index
                                          state
                                          terrain-index))

              :duplicate
              (let [duplicate-name (model/unique-terrain-name-from
                                    terrains
                                    (str name " Copy")
                                    nil
                                    nil)]
                (open-terrain-name-dialog! state
                                           ctx
                                           :duplicate
                                           terrain-index
                                           "Duplicate Terrain"
                                           duplicate-name
                                           (kebab-case duplicate-name)))

              :delete
              (open-terrain-delete-confirm-dialog!
               state
               ctx
               terrain-index
               name)

              :default
              state)))
        :terrain/name-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)
                context (:context payload)]
            (if (= (:type payload) :confirm)
              (let [terrain-index (:terrain-index context)
                    state (assoc state :selected-terrain-index terrain-index)]
                (case (:operation context)
                  :add
                  (let [state (assoc state
                                     :selected-terrain-set-index
                                     (:terrain-set-index context))]
                    (tilemap/rebuild-terrain-stamp-preview
                     (model/add-terrain-with-id state
                                                (:id payload)
                                                (:name payload))))

                  :rename
                  (tilemap/rebuild-terrain-stamp-preview
                   (model/set-selected-terrain-label
                    (model/set-selected-terrain-id state (:id payload))
                    (:name payload)))

                  :duplicate
                  (tilemap/rebuild-terrain-stamp-preview
                   (model/duplicate-selected-terrain-with-id
                    state
                    (:name payload)
                    (:id payload)))

                  :default
                  state))
              state)))
        :terrain/delete-confirm-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (and (= (:choice payload) :dialog/ok)
                     (not (nil? (-> payload :payload :terrain-index))))
              (tilemap/rebuild-terrain-stamp-preview
               (model/delete-selected-terrain
                (assoc state
                       :selected-terrain-index
                       (-> payload :payload :terrain-index))))
              state)))
        :terrain/set-edit (fn [state event ctx]
                            (open-terrain-set-edit-dialog! state ctx))
        :terrain/set-add-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (tilemap/rebuild-terrain-stamp-preview
               (model/add-terrain-set-with-id state
                                              (:id payload)
                                              (:name payload)))
              state)))
        :terrain/set-edit-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (tilemap/rebuild-terrain-stamp-preview
               (model/set-selected-terrain-set-label
                (model/set-selected-terrain-set-id state (:id payload))
                (:name payload)))
              state)))
        :terrain/set-delete-confirm-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (and (= (:choice payload) :dialog/ok)
                     (not (nil? (-> payload :payload :terrain-set-index))))
              (tilemap/rebuild-terrain-stamp-preview
               (model/delete-selected-terrain-set
                (assoc state
                       :selected-terrain-set-index
                       (-> payload :payload :terrain-set-index)
                       :selected-terrain-index
                       nil)))
              state)))
        :terrain/edit-field-change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (case (:field payload)
              :default
              state)))
        :terrain/tileset-change (fn [state event ctx]
                                  (tilemap/rebuild-terrain-stamp-preview
                                   (model/set-selected-terrain-set-tileset
                                    state
                                    (:payload event))))
        :terrain/unit-change (fn [state event ctx]
                               (tilemap/rebuild-terrain-stamp-preview
                                (model/set-selected-terrain-set-unit
                                 state
                                 (:payload event))))
        :terrain/tile-change (fn [state event ctx]
                               (model/set-selected-terrain-tile
                                state
                                (:payload event)))
        :terrain/base-tile-open
        (fn [state event ctx]
          (open-terrain-base-tile-popup! state
                                         ctx
                                         (-> event :payload :position)))
        :terrain/base-tile-popup-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (model/set-selected-terrain-tile state (:tile payload))
              state)))
        :terrain/ruleset-add (fn [state event ctx]
                               (tilemap/rebuild-terrain-stamp-preview
                                (model/add-terrain-ruleset state)))
        :terrain/ruleset-select
        (fn [state event ctx]
          (assoc state
                 :selected-terrain-ruleset-id (:payload event)
                 :selected-terrain-rule-id nil))
        :terrain/rule-add (fn [state event ctx]
                            (update-selected-ruleset-preview
                             state
                             model/add-terrain-rule))
        :terrain/rule-select
        (fn [state event ctx]
          (assoc state :selected-terrain-rule-id (:payload event)))
        :terrain/rule-reorder
        (fn [state event ctx]
          (let [payload (:payload event)]
            (update-selected-ruleset-preview
             state
             (fn [state]
               (model/reorder-selected-terrain-rules state
                                                     (:from-index payload)
                                                     (:to-index payload)
                                                     (:value payload))))))
        :terrain/rule-context-command
        (fn [state event ctx]
          (let [payload (:payload event)
                rule-id (:rule-id payload)
                command (:command payload)
                state (assoc state :selected-terrain-rule-id rule-id)
                name (model/terrain-rule-label-by-id state rule-id)]
            (case command
              :rename
              (open-terrain-rule-name-dialog! state ctx rule-id name)

              :duplicate
              (update-selected-ruleset-preview
               state
               model/duplicate-selected-terrain-rule)

              :move-up
              (update-selected-ruleset-preview
               state
               (fn [state]
                 (model/move-selected-terrain-rule state :up)))

              :move-down
              (update-selected-ruleset-preview
               state
               (fn [state]
                 (model/move-selected-terrain-rule state :down)))

              :delete
              (open-terrain-rule-delete-confirm-dialog! state ctx rule-id name)

              :default
              state)))
        :terrain/rule-name-dialog-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:type payload) :confirm)
              (model/set-selected-terrain-rule-label
               (assoc state :selected-terrain-rule-id (:rule-id payload))
               (:name payload))
              state)))
        :terrain/rule-delete-confirm-result
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (and (= (:choice payload) :dialog/ok)
                     (-> payload :payload :rule-id))
              (update-selected-ruleset-preview
               (assoc state
                      :selected-terrain-rule-id
                      (-> payload :payload :rule-id))
               model/delete-selected-terrain-rule)
              state)))
        :terrain/rule-terrain-change
        (fn [state event ctx]
          (update-selected-ruleset-preview
           state
           (fn [state]
             (model/set-selected-rule-terrain state (:payload event)))))
        :terrain/rule-match-change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (update-selected-ruleset-preview
             state
             (fn [state]
               (assoc (model/set-selected-rule-match-condition
                       state
                       (:direction payload)
                       (:value payload))
                      :selected-terrain-rule-match-direction
                      (:direction payload))))))
        :terrain/rule-match-cycle
        (fn [state event ctx]
          (let [payload (:payload event)]
            (update-selected-ruleset-preview
             state
             (fn [state]
               (assoc (model/cycle-selected-rule-match-condition
                       state
                       (:direction payload)
                       (:step payload))
                      :selected-terrain-rule-match-direction
                      (:direction payload))))))
        :terrain/rule-output-signature-cycle
        (fn [state event ctx]
          (let [payload (:payload event)]
            (update-selected-ruleset-preview
             state
             (fn [state]
               (model/cycle-selected-rule-output-terrain-signature
                state
                (:direction payload)
                (:step payload))))))
        :terrain/rule-output-tileset-change
        (fn [state event ctx]
          (update-selected-ruleset-preview
           state
           (fn [state]
             (model/set-selected-rule-output-tileset state (:payload event)))))
        :terrain/rule-output-target-layer-change
        (fn [state event ctx]
          (update-selected-ruleset-preview
           state
           (fn [state]
             (model/set-selected-rule-output-target-layer state
                                                          (:payload event)))))
        :terrain/rule-transform
        (fn [state event ctx]
          (update-selected-ruleset-preview
           state
           (fn [state]
             (model/transform-selected-rule state (:payload event)))))
        :checkbox/change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (if (= (:value payload) :terrain-rule-exclusive)
              (do
                (ui/stop-propagation! event)
                (update-selected-ruleset-preview
                 state
                 (fn [state]
                   (model/set-selected-terrain-rule-exclusive
                    state
                    (:checked? payload)))))
              state)))
        :terrain/rule-stamp-tile-select
        (fn [state event ctx]
          (assoc state :terrain-rule-selected-tile (:payload event)))
        :terrain/rule-stamp-paint
        (fn [state event ctx]
          (let [payload (:payload event)]
            (update-selected-ruleset-preview
             state
             (fn [state]
               (model/set-selected-rule-stamp-tile
                (assoc state
                       :selected-terrain-rule-output-position
                       {:x (:x payload)
                        :y (:y payload)})
                (:x payload)
                (:y payload)
                (:tile payload))))))}
   :children (terrain-definition-workspace-children)})
