(ns tilemap-editor.view.terrains.layout
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.checkbox :as chk]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [pixils.ui.scroll-pane :as sp]
            [pixils.ui.split-pane :as split]
            [pixils.ui.tab-panel :as tabs]
            pixils.ui.text-input
            [pixils.ui.window :as w]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.tilemap :as tilemap]
            [tilemap-editor.view.id-name-dialog :as id-name-dialog]
            [tilemap-editor.view.tilemap.renderer :as tr]
            [tilemap-editor.view.terrains.model :as model]))

(def terrain-list-row-height 24)

(def terrain-set-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Terrain Set"
            :action :terrain/set-context-dummy
            :payload {:command :rename}}
           {:label "Delete"
            :action :terrain/set-context-dummy
            :payload {:command :delete}}]})

(def terrain-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Terrain"
            :action :terrain/context-dummy
            :payload {:command :rename}}
           {:label "Duplicate"
            :action :terrain/context-dummy
            :payload {:command :duplicate}}
           {:label "Delete"
            :action :terrain/context-dummy
            :payload {:command :delete}}]})

(defcomponent terrain-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height terrain-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (case (:context-kind state)
                        :terrain-set
                        (menu/open-context-menu! terrain-set-context-menu
                                                 (:global-position event)
                                                 state
                                                 ctx)

                        :terrain
                        (menu/open-context-menu! terrain-context-menu
                                                 (:global-position event)
                                                 state
                                                 ctx)

                        :default
                        nil))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (case (:context-kind state)
                               :terrain-set
                               (ui/emit! (:view ctx)
                                         :terrain-set/context-command
                                         {:terrain-set-index (:index state)
                                          :command
                                          (-> payload :payload :command)})

                               :terrain
                               (ui/emit! (:view ctx)
                                         :terrain/context-command
                                         {:terrain-index (:index state)
                                          :command
                                          (-> payload :payload :command)})

                               :default
                               nil))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun terrain-row-child-with-context [context-kind index option]
  {:mode 'terrain-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :context-kind context-kind
           :selected-indices (ui/bind-state :selected-indices)}})

(defun terrain-row-child [index option]
  (terrain-row-child-with-context :terrain-set index option))

(defun terrain-context-row-child [index option]
  (terrain-row-child-with-context :terrain index option))

(defun terrain-set-list-child [terrain-sets selected-index]
  (let [terrain-sets (or terrain-sets [])
        options (model/terrain-set-options terrain-sets)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (empty? options)
              :selected-indices (model/selected-terrain-set-indices
                                 terrain-sets
                                 selected-index)
              :force-selection? true
              :item-child terrain-row-child})))

(defcomponent terrain-set-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-sets nil
                  :rendered-selected-index nil))
   :update (fn [state ctx]
             (let [terrain-sets (or (:terrain-sets state) [])
                   selected-index (:selected-terrain-set-index state)]
               (do
                 (when (or (not= terrain-sets (:rendered-terrain-sets state))
                           (not= selected-index (:rendered-selected-index state)))
                   (ui/replace-child! (:view ctx)
                                      "terrain-set-list-box"
                                      (merge {:id "terrain-set-list-box"}
                                             (terrain-set-list-child
                                              terrain-sets
                                              selected-index))))
                 (assoc state
                        :rendered-terrain-sets terrain-sets
                        :rendered-selected-index selected-index))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :terrain/set-select
                                       (-> event :payload :value))
                             state))}
   :children [(merge {:id "terrain-set-list-box"}
                     (terrain-set-list-child [] nil))]})

(defun terrain-list-child [terrain-set selected-index disabled?]
  (let [options (model/terrain-options terrain-set)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (if (or disabled? (empty? options)) true false)
              :selected-indices (if disabled?
                                  []
                                  (model/selected-terrain-indices terrain-set
                                                                  selected-index))
              :force-selection? true
              :item-child terrain-context-row-child})))

(defcomponent terrain-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-set nil
                  :rendered-selected-index nil
                  :rendered-disabled? nil))
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   selected-index (:selected-terrain-index state)
                   disabled? (:terrain-list-panel-disabled? state)]
               (do
                 (when (or (not= terrain-set (:rendered-terrain-set state))
                           (not= selected-index (:rendered-selected-index state))
                           (not= disabled? (:rendered-disabled? state)))
                   (ui/replace-child! (:view ctx)
                                      "terrain-list-box"
                                      (merge {:id "terrain-list-box"}
                                             (terrain-list-child terrain-set
                                                                 selected-index
                                                                 disabled?))))
                 (assoc state
                        :rendered-terrain-set terrain-set
                        :rendered-selected-index selected-index
                        :rendered-disabled? disabled?))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :terrain/select
                                       (-> event :payload :value))
                             state))}
   :children [(merge {:id "terrain-list-box"}
                     (terrain-list-child nil nil true))]})

(defun make-terrain-set-list-panel []
  (hp/make {:title "Terrain Sets"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :terrain/add-set)
                                             state))}]
            :body-style {:padding 8
                         :height :fill}
            :state {:terrain-sets (ui/bind-state :terrain-sets)
                    :selected-terrain-set-index
                    (ui/bind-state :selected-terrain-set-index)}
            :body-state {:terrain-sets (ui/bind-state :terrain-sets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)}
            :children [{:mode 'terrain-set-list
                        :state {:terrain-sets (ui/bind-state :terrain-sets)
                                :selected-terrain-set-index
                                (ui/bind-state :selected-terrain-set-index)}}]}))

(defun make-terrain-list-panel []
  (hp/make {:title "Terrains"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"
                                       :disabled?
                                       (ui/bind-state
                                        :terrain-list-panel-disabled?)}
                               :on-click (fn [state event ctx]
                                           (do
                                             (when (not (:disabled? state))
                                               (ui/emit! (:view ctx)
                                                         :terrain/add))
                                             state))}]
            :body-style {:padding 8
                         :height :fill}
            :state {:terrain-sets (ui/bind-state :terrain-sets)
                    :selected-terrain-set-index
                    (ui/bind-state :selected-terrain-set-index)
                    :selected-terrain-index
                    (ui/bind-state :selected-terrain-index)
                    :terrain-list-panel-disabled?
                    (ui/bind-state :terrain-list-panel-disabled?)}
            :body-state {:terrain-sets (ui/bind-state :terrain-sets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)
                         :selected-terrain-index
                         (ui/bind-state :selected-terrain-index)
                         :terrain-list-panel-disabled?
                         (ui/bind-state :terrain-list-panel-disabled?)}
            :children [{:mode 'terrain-list
                        :state {:terrain-sets (ui/bind-state :terrain-sets)
                                :selected-terrain-set-index
                                (ui/bind-state :selected-terrain-set-index)
                                :selected-terrain-index
                                (ui/bind-state :selected-terrain-index)
                                :terrain-list-panel-disabled?
                                (ui/bind-state
                                 :terrain-list-panel-disabled?)}}]}))

(defcomponent terrain-edit-field
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :on {:text-input/change (fn [state event ctx]
                             (do
                               (ui/emit! (:view ctx)
                                         :terrain/edit-field-change
                                         {:field (:field state)
                                          :value (-> event :payload :value)})
                               state))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 72}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text-input
               :style {:width 220
                       :height 22}
               :state {:value (ui/bind-state :value)
                       :disabled? (ui/bind-state :disabled?)}}]})

(defun terrain-edit-field-child [field label value disabled?]
  {:mode 'terrain-edit-field
   :state {:field field
           :label label
           :value value
           :disabled? disabled?}})

(defcomponent terrain-readonly-field
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 72}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text
               :style {:width 220}
               :state {:value (ui/bind-state :value)}}]})

(defun terrain-readonly-field-child [label value]
  {:mode 'terrain-readonly-field
   :state {:label label
           :value value}})

(defun terrain-preview-tile [tilesets terrain-set terrain]
  (data/tile-in tilesets
                (:tileset terrain-set)
                (data/terrain-preview-tile terrain)))

(defcomponent terrain-preview
  {:class :ui/content
   :style {:width 48
           :height 48
           :cursor :pointer}
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (when (not (:disabled? state))
                      (ui/emit! (:view ctx)
                                :terrain/base-tile-open
                                {:position (:global-position event)}))
                    state))
   :render (fn [state ctx]
             (do
               (r/rect! {:x 0 :y 0 :w 48 :h 48}
                        {:fill true
                         :color {:r 0x12 :g 0x15 :b 0x18}})
               (when (:tile state)
                 (tr/draw-tile! (:tile state) {:x 8 :y 8 :w 32 :h 32}))
               (r/rect! {:x 0 :y 0 :w 48 :h 48}
                        {:color {:r 0x00 :g 0x00 :b 0x00}})))})

(defcomponent terrain-preview-tileset-selector
  {:style {:width 220
           :height 22}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   tilesets (or (:tilesets state) [])]
               (assoc state
                      :tileset-options (data/tileset-options tilesets)
                      :selected-preview-tileset-index
                      (data/tileset-index tilesets (:tileset terrain-set))
                      :disabled? (or (nil? terrain-set)
                                     (empty? tilesets)))))
   :on {:combo-box/change (fn [state event ctx]
                            (do
                              (ui/emit! (:view ctx)
                                        :terrain/tileset-change
                                        (-> event :payload :selected-index))
                              state))}
   :children [(cb/make {:options (ui/bind-state :tileset-options)
                        :selected-index
                        (ui/bind-state :selected-preview-tileset-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent terrain-unit-selector
  {:style {:width 110
           :height 22}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))]
               (assoc state
                      :terrain-unit-options model/terrain-unit-options
                      :selected-terrain-unit-index
                      (model/terrain-unit-option-index
                       (data/terrain-unit terrain-set))
                      :disabled? (nil? terrain-set))))
   :on {:combo-box/change (fn [state event ctx]
                            (let [payload (:payload event)]
                              (ui/emit! (:view ctx)
                                        :terrain/unit-change
                                        (:value payload))
                              (assoc state
                                     :selected-terrain-unit-index
                                     (:selected-index payload))))}
   :children [(cb/make {:options (ui/bind-state :terrain-unit-options)
                        :selected-index
                        (ui/bind-state :selected-terrain-unit-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defun terrain-identity-row-children []
  [(terrain-readonly-field-child "Name"
                                 (ui/bind-state :terrain-label))])

(defcomponent terrain-identity-row
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 12}}
   :children (terrain-identity-row-children)})

(defun terrain-identity-summary-field [label value]
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 44}
               :state {:value label}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value value}}]})

(defun terrain-value-detail-header-child []
  {:style {:width :fill
           :height 48
           :layout {:direction :row
                    :align-items :start
                    :gap 12}}
   :state (ui/bind-state)
   :children [{:mode 'terrain-preview
               :state {:tile (ui/bind-state :preview-tile)
                       :disabled?
                       (ui/bind-state :terrain-disabled?)}}
              {:style {:width :fill
                       :height 48
                       :layout {:direction :column
                                :gap 0}}
               :children [{:style {:width :fill
                                    :height 24
                                    :layout {:direction :row
                                             :align-items :center
                                             :gap 8}}
                           :children [{:mode 'ui/text
                                       :class :ui/muted
                                       :style {:width 44}
                                       :state {:value "Id"}}
                                      {:mode 'ui/text
                                       :style {:width :fill}
                                       :state {:value (ui/bind-state :terrain-id)}}
                                      {:mode 'ui/button
                                       :style {:width 78
                                               :height 24}
                                       :state {:label "Edit"
                                               :disabled?
                                               (ui/bind-state :terrain-disabled?)}
                                       :on-click (fn [state event ctx]
                                                   (do
                                                     (ui/emit! (:view ctx)
                                                               :terrain/edit)
                                                     state))}]}
                          (terrain-identity-summary-field
                           "Name"
                           (ui/bind-state :terrain-label))]}]})

(defun terrain-set-detail-editor-children []
  [(terrain-readonly-field-child "Id" (ui/bind-state :set-id))
   (terrain-readonly-field-child "Name" (ui/bind-state :set-label))
   {:mode 'ui/button
    :style {:width 78
            :height 24}
    :state {:label "Edit"
            :disabled? (ui/bind-state :set-disabled?)}
    :on-click (fn [state event ctx]
                (do
                  (ui/emit! (:view ctx) :terrain/set-edit)
                  state))}
   {:mode 'ui/text
    :class :ui/muted
    :state {:value "Preview tileset"}}
   {:mode 'terrain-preview-tileset-selector
    :state {:terrain-sets (ui/bind-state :terrain-sets)
            :selected-terrain-set-index
            (ui/bind-state :selected-terrain-set-index)
            :tilesets (ui/bind-state :tilesets)}}
   {:mode 'ui/text
    :class :ui/muted
    :state {:value "Terrain unit"}}
   {:mode 'terrain-unit-selector
    :state {:terrain-sets (ui/bind-state :terrain-sets)
            :selected-terrain-set-index
            (ui/bind-state :selected-terrain-set-index)}}])

(defcomponent terrain-set-detail-editor
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children (terrain-set-detail-editor-children)})

(def terrain-rule-list-row-height 24)

(def terrain-rule-context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Rule"
            :action :terrain/rule-context-dummy
            :payload {:command :rename}}
           {:label "Duplicate"
            :action :terrain/rule-context-dummy
            :payload {:command :duplicate}}
           :separator
           {:label "Move Up"
            :action :terrain/rule-context-dummy
            :payload {:command :move-up}}
           {:label "Move Down"
            :action :terrain/rule-context-dummy
            :payload {:command :move-down}}
           :separator
           {:label "Delete Rule"
            :action :terrain/rule-context-dummy
            :payload {:command :delete}}]})

(def terrain-rule-transform-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Flip Horizontally"
            :action :terrain/rule-transform-menu
            :payload {:command :flip-horizontal}}
           {:label "Flip Vertically"
            :action :terrain/rule-transform-menu
            :payload {:command :flip-vertical}}
           :separator
           {:label "Rotate Left"
            :action :terrain/rule-transform-menu
            :payload {:command :rotate-left}}
           {:label "Rotate Right"
            :action :terrain/rule-transform-menu
            :payload {:command :rotate-right}}]})

(def terrain-rule-grid-cell-size 32)
(def terrain-rule-grid-gap 2)
(def terrain-rule-grid-size (+ (* terrain-rule-grid-cell-size 3)
                               (* terrain-rule-grid-gap 2)))
(def terrain-stamp-tile-picker-width 116)
(def terrain-stamp-tile-picker-cell-size 32)
(def terrain-stamp-tile-picker-gap 2)
(def terrain-stamp-tile-picker-height 232)

(defun terrain-unit-grid-size [cell-count]
  (+ (* terrain-rule-grid-cell-size cell-count)
     (* terrain-rule-grid-gap (max 0 (dec cell-count)))))

(defun terrain-stamp-grid-size-for-unit [unit]
  {:w (terrain-unit-grid-size (:w unit))
   :h (terrain-unit-grid-size (:h unit))})

(defun terrain-rule-center-terrain-id [rule fallback]
  (or (model/terrain-rule-center rule) fallback))

(defun terrain-rule-terrain-tile [state terrain-id]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))]
    (data/terrain-tile-in (:tilesets state)
                          (:terrain-sets state)
                          (:id terrain-set)
                          terrain-id)))

(defun terrain-rule-center-tile [state]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))
        terrain (model/selected-terrain terrain-set
                                        (:selected-terrain-index state))]
    (terrain-rule-terrain-tile state
                               (terrain-rule-center-terrain-id
                                (model/selected-terrain-rule state)
                                (:id terrain)))))

(defun terrain-rule-main-tile [state]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))
        terrain (model/selected-terrain terrain-set
                                        (:selected-terrain-index state))]
    (terrain-rule-terrain-tile state (:id terrain))))

(defun match-cell-condition [rule direction]
  (or (get (or (:match rule) {}) direction) :ignore))

(defun condition-terrain-id [condition]
  (if (= (type-of condition) "map")
    (:terrain condition)
    nil))

(defun match-cell-tile [state condition]
  (case condition
    :ignore nil
    :same (terrain-rule-center-tile state)
    :not-same nil
    :other-terrain nil
    :default (if-let [terrain-id (condition-terrain-id condition)]
               (terrain-rule-terrain-tile state terrain-id)
               nil)))

(defun draw-rule-grid-cell-background! []
  (r/rect! {:x 0
            :y 0
            :w terrain-rule-grid-cell-size
            :h terrain-rule-grid-cell-size}
           {:fill true
            :color {:r 0x0b :g 0x0d :b 0x10}}))

(defun draw-rule-grid-cell-border! [color]
  (r/rect! {:x 0
            :y 0
            :w terrain-rule-grid-cell-size
            :h terrain-rule-grid-cell-size}
           {:color color}))

(defun draw-rule-grid-cell-cross! [color]
  (do
    (r/line! {:x 5 :y 5}
             {:x (- terrain-rule-grid-cell-size 6)
              :y (- terrain-rule-grid-cell-size 6)}
             color)
    (r/line! {:x (- terrain-rule-grid-cell-size 6) :y 5}
             {:x 5 :y (- terrain-rule-grid-cell-size 6)}
             color)))

(defun draw-match-any-other! []
  (let [color {:r 0x5d :g 0xc9 :b 0x9a}
        center (/ terrain-rule-grid-cell-size 2)]
    (do
      (r/rect! {:x 9 :y 9 :w 14 :h 14} {:color color})
      (r/line! {:x center :y 4} {:x center :y 9} color)
      (r/line! {:x center :y 23} {:x center :y 28} color)
      (r/line! {:x 4 :y center} {:x 9 :y center} color)
      (r/line! {:x 23 :y center} {:x 28 :y center} color)
      (r/text! "?" {:x 12 :y 9} {:color color}))))

(defun draw-match-none! []
  (let [color {:r 0xe0 :g 0x66 :b 0x66}]
    (do
      (r/line! {:x 8 :y 24} {:x 24 :y 8} color)
      (r/rect! {:x 8 :y 8 :w 16 :h 16} {:color color}))))

(defun draw-match-any-terrain! []
  (let [color {:r 0x5d :g 0xc9 :b 0x9a}]
    (do
      (r/rect! {:x 8 :y 8 :w 16 :h 16} {:color color})
      (r/text! "A" {:x 12 :y 9} {:color color}))))

(defun draw-match-different-terrain! []
  (let [color {:r 0xf0 :g 0xb4 :b 0x4f}]
    (do
      (r/rect! {:x 8 :y 8 :w 16 :h 16} {:color color})
      (r/text! "!=" {:x 9 :y 9} {:color color}))))

(defun draw-match-cell! [state ctx]
  (let [condition (:condition state)
        tile (:tile state)]
    (do
      (draw-rule-grid-cell-background!)
      (when tile
        (tr/draw-tile! tile
                       {:x 4
                        :y 4
                        :w (- terrain-rule-grid-cell-size 8)
                        :h (- terrain-rule-grid-cell-size 8)}))
      (when (= condition :ignore)
        (draw-rule-grid-cell-cross! {:r 0x86 :g 0x91 :b 0x9b}))
      (when (= condition :none)
        (draw-match-none!))
      (when (= condition :any-terrain)
        (draw-match-any-terrain!))
      (when (= condition :not-same)
        (draw-match-different-terrain!))
      (when (= condition :other-terrain)
        (draw-match-different-terrain!))
      (draw-rule-grid-cell-border! (cond
                                     (:center? state)
                                     {:r 0xff :g 0xcc :b 0x66}

                                     (:selected? state)
                                     {:r 0x5a :g 0x9d :b 0xff}

                                     :default
                                     {:r 0x1f :g 0x26 :b 0x2d})))))

(defcomponent terrain-match-tile-cell
  {:class :ui/canvas
   :style {:width terrain-rule-grid-cell-size
           :height terrain-rule-grid-cell-size
           :cursor :pointer}
   :update (fn [state ctx]
             (let [rule (model/selected-terrain-rule state)
                   condition (if (:center? state)
                               :same
                               (match-cell-condition rule (:direction state)))]
               (assoc state
                      :condition condition
                      :selected? (and (not (:center? state))
                                      (= (:direction state)
                                         (:selected-terrain-rule-match-direction
                                          state)))
                      :tile (if (:center? state)
                              (terrain-rule-main-tile state)
                              (match-cell-tile state condition)))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (when (and (:center? state)
                                 (secondary-mouse-button? event))
                        (menu/open-context-menu! terrain-rule-transform-menu
                                                 (:global-position event)
                                                 state
                                                 ctx))
                      (when (and (not (:center? state))
                                 (:direction state))
                        (ui/emit! (:view ctx)
                                  :terrain/rule-match-cycle
                                  {:direction (:direction state)
                                   :step (if (= (:button event) :right)
                                           1
                                           -1)}))
                      state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :terrain/rule-transform
                                       (-> payload :payload :command)))))
                       state)}
   :render draw-match-cell!})

(defun terrain-match-tile-cell-child [direction]
  {:mode 'terrain-match-tile-cell
   :state {:direction direction
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :rulesets (ui/bind-state :rulesets)
           :selected-terrain-ruleset-id
           (ui/bind-state :selected-terrain-ruleset-id)
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :selected-terrain-rule-match-direction
           (ui/bind-state :selected-terrain-rule-match-direction)
           :tilesets (ui/bind-state :tilesets)}})

(defun terrain-match-center-cell-child []
  {:mode 'terrain-match-tile-cell
   :state {:center? true
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :rulesets (ui/bind-state :rulesets)
           :selected-terrain-ruleset-id
           (ui/bind-state :selected-terrain-ruleset-id)
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :selected-terrain-rule-match-direction
           (ui/bind-state :selected-terrain-rule-match-direction)
           :tilesets (ui/bind-state :tilesets)}})

(defun terrain-rule-grid-row [left center right]
  {:style {:width terrain-rule-grid-size
           :height terrain-rule-grid-cell-size
           :layout {:direction :row
                    :gap terrain-rule-grid-gap}}
   :state (ui/bind-state)
   :children [left center right]})

(defcomponent visual-terrain-match-grid
  {:style {:width :shrink
           :height :shrink
           :layout {:direction :column
                    :gap terrain-rule-grid-gap}}
   :children [(terrain-rule-grid-row (terrain-match-tile-cell-child :nw)
                                     (terrain-match-tile-cell-child :n)
                                     (terrain-match-tile-cell-child :ne))
              (terrain-rule-grid-row (terrain-match-tile-cell-child :w)
                                     (terrain-match-center-cell-child)
                                     (terrain-match-tile-cell-child :e))
              (terrain-rule-grid-row (terrain-match-tile-cell-child :sw)
                                     (terrain-match-tile-cell-child :s)
                                     (terrain-match-tile-cell-child :se))]})

(defun stamp-layer-for-selected-rule [state]
  (model/selected-rule-stamp-layer state))

(defun stamp-grid-anchor [state]
  (or (-> (model/selected-terrain-rule state) :output :anchor) {:x 1 :y 1}))

(defun stamp-grid-tile [state tile-ref]
  (when (not (nil? tile-ref))
    (let [layer (stamp-layer-for-selected-rule state)]
      (data/tile-in (:tilesets state) (:tileset layer) tile-ref))))

(defun secondary-mouse-button? [event]
  (= (:button event) :right))

(defun terrain-stamp-tile-drag-payload? [payload]
  (= (:kind payload) :terrain-rule-stamp-tile))

(defun stamp-grid-cell-selected? [state x y]
  (let [pos (model/selected-rule-output-position state)]
    (and (= x (:x pos))
         (= y (:y pos)))))

(defun emit-stamp-grid-cell-paint! [state event ctx]
  (let [tile-ref (if (secondary-mouse-button? event)
                   nil
                   (model/selected-rule-stamp-tile state))]
    (if (:visible? state)
      (do
        (ui/stop-propagation! event)
        (ui/emit! (:view ctx)
                  :terrain/rule-stamp-paint
                  {:x (:stamp-x state)
                   :y (:stamp-y state)
                   :tile tile-ref})
        state)
      state)))

(defun emit-stamp-grid-cell-drop! [state event ctx]
  (let [payload (:payload event)]
    (if (and (:visible? state)
             (terrain-stamp-tile-drag-payload? payload))
      (do
        (ui/stop-propagation! event)
        (model/set-selected-rule-stamp-tile state
                                            (:stamp-x state)
                                            (:stamp-y state)
                                            (:tile payload)))
      state)))

(defun draw-terrain-stamp-grid-cell! [state ctx]
  (when (:visible? state)
    (let [layer (stamp-layer-for-selected-rule state)
          rows (or (:tiles layer) [])
          anchor (stamp-grid-anchor state)
          x (:stamp-x state)
          y (:stamp-y state)
          tile-ref (nth (or (nth rows y) []) x)
          tile (stamp-grid-tile state tile-ref)]
      (do
        (r/rect! {:x 0
                  :y 0
                  :w terrain-rule-grid-cell-size
                  :h terrain-rule-grid-cell-size}
                 {:fill true
                  :color {:r 0x0b :g 0x0d :b 0x10}})
        (when tile
          (tr/draw-tile! tile
                         {:x 4
                          :y 4
                          :w (- terrain-rule-grid-cell-size 8)
                          :h (- terrain-rule-grid-cell-size 8)}))
        (r/rect! {:x 0
                  :y 0
                  :w terrain-rule-grid-cell-size
                  :h terrain-rule-grid-cell-size}
                 {:color (if (and (= x (:x anchor))
                                  (= y (:y anchor)))
                           {:r 0xff :g 0xcc :b 0x66}
                           (if (stamp-grid-cell-selected? state x y)
                             {:r 0x5a :g 0x9d :b 0xff}
                             {:r 0x1f :g 0x26 :b 0x2d}))})))))

(defcomponent terrain-stamp-grid-cell
  {:focusable true
   :class :ui/canvas
   :style {:width terrain-rule-grid-cell-size
           :height terrain-rule-grid-cell-size
           :cursor :crosshair}
   :update (fn [state ctx]
             (let [unit (model/selected-terrain-unit state)
                   anchor (stamp-grid-anchor state)
                   local-x (or (:stamp-local-x state) 0)
                   local-y (or (:stamp-local-y state) 0)
                   visible? (and (< local-x (:w unit))
                                 (< local-y (:h unit)))]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if visible? :visible :none))
                 (assoc-in! ctx
                            [:view :style :width]
                            (if visible? terrain-rule-grid-cell-size 0))
                 (assoc-in! ctx
                            [:view :style :height]
                            (if visible? terrain-rule-grid-cell-size 0))
                 (assoc state
                        :stamp-x (+ (:x anchor) local-x)
                        :stamp-y (+ (:y anchor) local-y)
                        :visible? visible?))))
   :on-mouse-down emit-stamp-grid-cell-paint!
   :on-click emit-stamp-grid-cell-paint!
   :on-drag emit-stamp-grid-cell-paint!
   :on-drop emit-stamp-grid-cell-drop!
   :render draw-terrain-stamp-grid-cell!})

(defun terrain-stamp-grid-cell-child [local-x local-y]
  {:mode 'terrain-stamp-grid-cell
   :state {:stamp-local-x local-x
           :stamp-local-y local-y
           :rulesets (ui/bind-state :rulesets)
           :selected-terrain-ruleset-id
           (ui/bind-state :selected-terrain-ruleset-id)
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :selected-terrain-rule-output-position
           (ui/bind-state :selected-terrain-rule-output-position)
           :terrain-rule-selected-tile
           (ui/bind-state :terrain-rule-selected-tile)
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :tilesets (ui/bind-state :tilesets)}})

(defun terrain-stamp-grid-row [local-y]
  {:style {:width (terrain-unit-grid-size 2)
           :height terrain-rule-grid-cell-size
           :layout {:direction :row
                    :gap terrain-rule-grid-gap}}
   :update (fn [state ctx]
             (let [unit (model/selected-terrain-unit state)
                   visible? (< local-y (:h unit))
                   size (terrain-stamp-grid-size-for-unit unit)]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if visible? :visible :none))
                 (assoc-in! ctx [:view :style :width] (:w size))
                 (assoc-in! ctx
                            [:view :style :height]
                            (if visible? terrain-rule-grid-cell-size 0))
                 state)))
   :state (ui/bind-state)
   :children [(terrain-stamp-grid-cell-child 0 local-y)
              (terrain-stamp-grid-cell-child 1 local-y)]})

(defcomponent terrain-stamp-grid-preview
  {:style {:width (terrain-unit-grid-size 2)
           :height (terrain-unit-grid-size 2)
           :layout {:direction :column
                    :gap terrain-rule-grid-gap}}
   :update (fn [state ctx]
             (let [size (terrain-stamp-grid-size-for-unit
                         (model/selected-terrain-unit state))]
               (do
                 (assoc-in! ctx [:view :style :width] (:w size))
                 (assoc-in! ctx [:view :style :height] (:h size))
                 state)))
   :children [(terrain-stamp-grid-row 0)
              (terrain-stamp-grid-row 1)]})

(defun terrain-signature-value [state direction]
  (get (or (model/selected-rule-output-terrain-signature state) {})
       direction))

(defun terrain-signature-tile [state value]
  (if (and value (not= value :none))
    (terrain-rule-terrain-tile state value)
    nil))

(defun draw-terrain-signature-none! []
  (draw-match-none!))

(defun draw-terrain-signature-unknown! []
  (let [color {:r 0x86 :g 0x91 :b 0x9b}]
    (do
      (draw-rule-grid-cell-cross! color)
      (r/text! "?" {:x 12 :y 9} {:color color}))))

(defun draw-terrain-signature-cell! [state ctx]
  (let [value (:signature-value state)
        tile (:signature-tile state)]
    (do
      (draw-rule-grid-cell-background!)
      (when tile
        (tr/draw-tile! tile
                       {:x 4
                        :y 4
                        :w (- terrain-rule-grid-cell-size 8)
                        :h (- terrain-rule-grid-cell-size 8)}))
      (when (= value :none)
        (draw-terrain-signature-none!))
      (when (nil? value)
        (draw-terrain-signature-unknown!))
      (draw-rule-grid-cell-border!
       (if (:center? state)
         {:r 0xff :g 0xcc :b 0x66}
         {:r 0x1f :g 0x26 :b 0x2d})))))

(defcomponent terrain-signature-cell
  {:class :ui/canvas
   :style {:width terrain-rule-grid-cell-size
           :height terrain-rule-grid-cell-size
           :cursor :pointer}
   :update (fn [state ctx]
             (let [value (terrain-signature-value state (:direction state))]
               (assoc state
                      :signature-value value
                      :signature-tile (terrain-signature-tile state value))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (when (:direction state)
                        (ui/emit! (:view ctx)
                                  :terrain/rule-output-signature-cycle
                                  {:direction (:direction state)
                                   :step (if (= (:button event) :right)
                                           -1
                                           1)}))
                      state))
   :render draw-terrain-signature-cell!})

(defun terrain-signature-cell-child [direction]
  {:mode 'terrain-signature-cell
   :state {:direction direction
           :center? (= direction :center)
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-terrain-set-index
           (ui/bind-state :selected-terrain-set-index)
           :selected-terrain-index
           (ui/bind-state :selected-terrain-index)
           :rulesets (ui/bind-state :rulesets)
           :selected-terrain-ruleset-id
           (ui/bind-state :selected-terrain-ruleset-id)
           :selected-terrain-rule-id
           (ui/bind-state :selected-terrain-rule-id)
           :selected-terrain-rule-output-position
           (ui/bind-state :selected-terrain-rule-output-position)
           :tilesets (ui/bind-state :tilesets)}})

(defun terrain-signature-grid-row [left center right]
  {:style {:width terrain-rule-grid-size
           :height terrain-rule-grid-cell-size
           :layout {:direction :row
                    :gap terrain-rule-grid-gap}}
   :state (ui/bind-state)
   :children [left center right]})

(defcomponent terrain-signature-grid-preview
  {:style {:width terrain-rule-grid-size
           :height terrain-rule-grid-size
           :layout {:direction :column
                    :gap terrain-rule-grid-gap}}
   :children [(terrain-signature-grid-row
               (terrain-signature-cell-child :nw)
               (terrain-signature-cell-child :n)
               (terrain-signature-cell-child :ne))
              (terrain-signature-grid-row
               (terrain-signature-cell-child :w)
               (terrain-signature-cell-child :center)
               (terrain-signature-cell-child :e))
              (terrain-signature-grid-row
               (terrain-signature-cell-child :sw)
               (terrain-signature-cell-child :s)
               (terrain-signature-cell-child :se))]})

(defun terrain-stamp-tile-picker-stride []
  (+ terrain-stamp-tile-picker-cell-size terrain-stamp-tile-picker-gap))

(defun terrain-stamp-tile-picker-columns [bounds]
  (max 1 (int (/ (+ (max 1 (or (:w bounds) 1)) terrain-stamp-tile-picker-gap)
                 (terrain-stamp-tile-picker-stride)))))

(defun terrain-stamp-tile-picker-index-at-position [position bounds item-count]
  (let [stride (terrain-stamp-tile-picker-stride)
        col (int (/ (:x position) stride))
        row (int (/ (:y position) stride))
        index (+ col (* row (terrain-stamp-tile-picker-columns bounds)))]
    (if (and (>= (:x position) 0)
             (>= (:y position) 0)
             (< (mod (:x position) stride)
                terrain-stamp-tile-picker-cell-size)
             (< (mod (:y position) stride)
                terrain-stamp-tile-picker-cell-size)
             (< index item-count))
      index
      nil)))

(defun terrain-stamp-tile-picker-cell-rect [index columns]
  (let [columns (max 1 (or columns 1))
        stride (terrain-stamp-tile-picker-stride)]
    {:x (* (mod index columns) stride)
     :y (* (int (/ index columns)) stride)
     :w terrain-stamp-tile-picker-cell-size
     :h terrain-stamp-tile-picker-cell-size}))

(defun terrain-stamp-tile-picker-content-height [item-count columns]
  (let [columns (max 1 (or columns 1))
        rows (max 1 (int (/ (+ (max 0 (or item-count 0))
                               (dec columns))
                            columns)))]
    (+ (* rows terrain-stamp-tile-picker-cell-size)
       (* (dec rows) terrain-stamp-tile-picker-gap))))

(defun terrain-stamp-tile-picker-content-size [state]
  (let [options (terrain-stamp-tile-options state)
        columns (terrain-stamp-tile-picker-columns
                 {:w terrain-stamp-tile-picker-width})]
    {:w terrain-stamp-tile-picker-width
     :h (terrain-stamp-tile-picker-content-height (count options)
                                                  columns)}))

(defun terrain-stamp-tile-picker-content-state [state]
  {:rulesets (:rulesets state)
   :selected-terrain-ruleset-id (:selected-terrain-ruleset-id state)
   :selected-terrain-rule-id (:selected-terrain-rule-id state)
   :selected-terrain-rule-match-direction
   (:selected-terrain-rule-match-direction state)
   :terrain-rule-selected-tile (:terrain-rule-selected-tile state)
   :terrain-sets (:terrain-sets state)
   :selected-terrain-set-index (:selected-terrain-set-index state)
   :selected-terrain-index (:selected-terrain-index state)
   :tilesets (:tilesets state)})

(defun terrain-stamp-tile-picker-selected-rect [rect]
  {:x (+ (:x rect) 1)
   :y (+ (:y rect) 1)
   :w (- (:w rect) 2)
   :h (- (:h rect) 2)})

(defun terrain-stamp-tile-options [state]
  (let [tileset (model/selected-rule-stamp-tileset state)]
    (concat [{:value nil
              :label "No tile"}]
            (data/tile-options (:tilesets state) tileset))))

(defun terrain-stamp-tile-picker-selected-indices [state]
  (let [tile-ref (model/selected-rule-stamp-tile state)
        options (terrain-stamp-tile-options state)
        index (find-index options
                          (fn [option]
                            (= (:value option) tile-ref)))]
    (if (nil? index) [] [index])))

(defun terrain-stamp-tile-at-picker-index [state index]
  (when (not (nil? index))
    (nth (terrain-stamp-tile-options state) index)))

(defun terrain-stamp-tile-drag-payload [state event ctx]
  (let [options (terrain-stamp-tile-options state)
        index (terrain-stamp-tile-picker-index-at-position
               (:start-position event)
               (-> ctx :view :bounds)
               (count options))
        option (terrain-stamp-tile-at-picker-index state index)]
    (if option
      {:kind :terrain-rule-stamp-tile
       :tileset (model/selected-rule-stamp-tileset state)
       :tile (:value option)}
      nil)))

(defun select-terrain-stamp-tile-at-event! [state event ctx]
  (let [options (terrain-stamp-tile-options state)
        index (terrain-stamp-tile-picker-index-at-position
               (:position event)
               (-> ctx :view :bounds)
               (count options))
        option (terrain-stamp-tile-at-picker-index state index)]
    (do
      (ui/stop-propagation! event)
      (ui/focus! ctx)
      (when (not (nil? index))
        (ui/emit! (:view ctx)
                  :terrain/rule-stamp-tile-select
                  (:value option)))
      state)))

(defun draw-no-tile-picker-mark! [rect]
  (let [color {:r 0x86 :g 0x91 :b 0x9b}
        inset 7]
    (do
      (r/line! {:x (+ (:x rect) inset)
                :y (+ (:y rect) inset)}
               {:x (- (+ (:x rect) (:w rect)) inset)
                :y (- (+ (:y rect) (:h rect)) inset)}
               color)
      (r/line! {:x (- (+ (:x rect) (:w rect)) inset)
                :y (+ (:y rect) inset)}
               {:x (+ (:x rect) inset)
                :y (- (+ (:y rect) (:h rect)) inset)}
               color))))

(defun draw-terrain-stamp-tile-picker-cell! [state option index columns]
  (let [rect (terrain-stamp-tile-picker-cell-rect index columns)
        tile (when (not (nil? (:value option)))
               (data/tile-in (:tilesets state)
                             (model/selected-rule-stamp-tileset state)
                             (:value option)))]
    (do
      (r/rect! rect {:fill true
                     :color {:r 0x12 :g 0x15 :b 0x18}})
      (when tile
        (tr/draw-tile! tile
                       {:x (+ (:x rect) 4)
                        :y (+ (:y rect) 4)
                        :w (- (:w rect) 8)
                        :h (- (:h rect) 8)}))
      (when (nil? (:value option))
        (draw-no-tile-picker-mark! rect))
      (r/rect! rect {:color {:r 0x1f :g 0x26 :b 0x2d}})
      (when (contains? (:selected-indices state) index)
        (r/rect! (terrain-stamp-tile-picker-selected-rect rect)
                 {:color {:r 0xff :g 0xcc :b 0x66}})))))

(defcomponent terrain-stamp-tile-picker
  {:focusable true
   :class :ui/content
   :style {:width :fill
           :height :fill
           :clip true
           :cursor :pointer}
   :drag {:start {:mode :threshold
                  :distance 3}
          :payload terrain-stamp-tile-drag-payload}
   :update (fn [state ctx]
             (let [tileset (model/selected-rule-stamp-tileset state)
                   selected-tile (model/selected-rule-stamp-tile state)
                   selected-indices (terrain-stamp-tile-picker-selected-indices
                                     state)
                   disabled? (nil? (model/selected-terrain-rule state))]
               (assoc state
                      :tileset tileset
                      :disabled? disabled?
                      :selected-tile selected-tile
                      :selected-indices selected-indices)))
   :on-mouse-down select-terrain-stamp-tile-at-event!
   :render (fn [state ctx]
             (let [options (terrain-stamp-tile-options state)
                   columns (terrain-stamp-tile-picker-columns
                            (-> ctx :view :bounds))]
               (for-indexed [index option options]
                 (draw-terrain-stamp-tile-picker-cell!
                  state
                  option
                  index
                  columns))))})

(defcomponent terrain-stamp-tile-picker-scroll-pane
  {:style {:width terrain-stamp-tile-picker-width
           :height terrain-stamp-tile-picker-height}
   :update (fn [state ctx]
             (assoc state
                    :content-size
                    (terrain-stamp-tile-picker-content-size state)
                    :picker-state
                    (terrain-stamp-tile-picker-content-state state)))
   :children [(sp/make {:style {:width :fill
                                :height :fill}
                        :content-size {:w terrain-stamp-tile-picker-width
                                       :h terrain-stamp-tile-picker-height}
                        :state {:content-size (ui/bind-state :content-size)
                                :content-state (ui/bind-state :picker-state)}
                        :scroll-x? false
                        :scroll-y? :auto
                        :step (terrain-stamp-tile-picker-stride)
                        :children [{:mode 'terrain-stamp-tile-picker
                                    :style {:width :fill
                                            :height :fill}
                                    :state (ui/bind-state)}]})]})

(def terrain-base-tile-picker-width 260)
(def terrain-base-tile-picker-height 232)

(defun terrain-base-tile-options [state]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))]
    (data/tile-options (:tilesets state) (:tileset terrain-set))))

(defun terrain-base-tile-picker-content-size [state]
  (let [options (terrain-base-tile-options state)
        columns (terrain-stamp-tile-picker-columns
                 {:w terrain-base-tile-picker-width})]
    {:w terrain-base-tile-picker-width
     :h (terrain-stamp-tile-picker-content-height (count options)
                                                  columns)}))

(defun terrain-base-tile-picker-content-state [state]
  {:terrain-sets (:terrain-sets state)
   :selected-terrain-set-index (:selected-terrain-set-index state)
   :selected-terrain-index (:selected-terrain-index state)
   :tilesets (:tilesets state)})

(defun terrain-base-tile-picker-selected-indices [state]
  (let [terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))
        terrain (model/selected-terrain terrain-set
                                        (:selected-terrain-index state))
        options (terrain-base-tile-options state)
        index (find-index options
                          (fn [option]
                            (= (:value option) (:tile terrain))))]
    (if (nil? index) [] [index])))

(defun terrain-base-tile-at-picker-index [state index]
  (when (not (nil? index))
    (nth (terrain-base-tile-options state) index)))

(defun select-terrain-base-tile-at-event! [state event ctx]
  (let [options (terrain-base-tile-options state)
        index (terrain-stamp-tile-picker-index-at-position
               (:position event)
               (-> ctx :view :bounds)
               (count options))
        option (terrain-base-tile-at-picker-index state index)]
    (do
      (ui/stop-propagation! event)
      (ui/focus! ctx)
      (when option
        (ui/emit! (:view ctx)
                  :terrain/base-tile-select
                  (:value option)))
      state)))

(defun draw-terrain-base-tile-picker-cell! [state option index columns]
  (let [rect (terrain-stamp-tile-picker-cell-rect index columns)
        terrain-set (model/selected-terrain-set
                     (:terrain-sets state)
                     (:selected-terrain-set-index state))
        tile (data/tile-in (:tilesets state)
                           (:tileset terrain-set)
                           (:value option))]
    (do
      (r/rect! rect {:fill true
                     :color {:r 0x12 :g 0x15 :b 0x18}})
      (when tile
        (tr/draw-tile! tile
                       {:x (+ (:x rect) 4)
                        :y (+ (:y rect) 4)
                        :w (- (:w rect) 8)
                        :h (- (:h rect) 8)}))
      (r/rect! rect {:color {:r 0x1f :g 0x26 :b 0x2d}})
      (when (contains? (:selected-indices state) index)
        (r/rect! (terrain-stamp-tile-picker-selected-rect rect)
                 {:color {:r 0xff :g 0xcc :b 0x66}})))))

(defcomponent terrain-base-tile-picker
  {:focusable true
   :class :ui/content
   :style {:width :fill
           :height :fill
           :clip true
           :cursor :pointer}
   :update (fn [state ctx]
             (assoc state
                    :selected-indices
                    (terrain-base-tile-picker-selected-indices state)))
   :on-mouse-down select-terrain-base-tile-at-event!
   :render (fn [state ctx]
             (let [options (terrain-base-tile-options state)
                   columns (terrain-stamp-tile-picker-columns
                            (-> ctx :view :bounds))]
               (for-indexed [index option options]
                 (draw-terrain-base-tile-picker-cell!
                  state
                  option
                  index
                  columns))))})

(defcomponent terrain-base-tile-picker-scroll-pane
  {:style {:width terrain-base-tile-picker-width
           :height terrain-base-tile-picker-height}
   :update (fn [state ctx]
             (assoc state
                    :content-size
                    (terrain-base-tile-picker-content-size state)
                    :picker-state
                    (terrain-base-tile-picker-content-state state)))
   :children [(sp/make {:style {:width :fill
                                :height :fill}
                        :content-size {:w terrain-base-tile-picker-width
                                       :h terrain-base-tile-picker-height}
                        :state {:content-size (ui/bind-state :content-size)
                                :content-state (ui/bind-state :picker-state)}
                        :scroll-x? false
                        :scroll-y? :auto
                        :step (terrain-stamp-tile-picker-stride)
                        :children [{:mode 'terrain-base-tile-picker
                                    :style {:width :fill
                                            :height :fill}
                                    :state (ui/bind-state)}]})]})

(defun terrain-base-tile-popup-position [position]
  {:left (or (:x position) 240)
   :top (or (:y position) 150)})

(defun terrain-base-tile-popup-children [position]
  (let [position (terrain-base-tile-popup-position position)]
    [{:mode 'terrain-base-tile-picker-scroll-pane
      :class :ui/content
      :style {:position :absolute
              :left (:left position)
              :top (:top position)}
      :state {:terrain-sets (ui/bind-state :terrain-sets)
              :selected-terrain-set-index
              (ui/bind-state :selected-terrain-set-index)
              :selected-terrain-index
              (ui/bind-state :selected-terrain-index)
              :tilesets (ui/bind-state :tilesets)}}]))

(defmode terrain-base-tile-popup
  {:on-mouse-down (fn [state event ctx]
                    (do
                      (pop-mode! {:type :dismiss})
                      state))
   :on {:terrain/base-tile-select
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :confirm
                        :tile (:payload event)})
            state))}
   :compose {:render :pass}})

(defun open-terrain-base-tile-popup! [state ctx position]
  (do
    (push-mode! 'terrain-base-tile-popup
                {:terrain-sets (:terrain-sets state)
                 :selected-terrain-set-index (:selected-terrain-set-index state)
                 :selected-terrain-index (:selected-terrain-index state)
                 :tilesets (:tilesets state)}
                {:origin {:view (:view ctx)
                          :event :terrain/base-tile-popup-result}
                 :children (terrain-base-tile-popup-children position)})
    state))

(defcomponent terrain-rule-arrow
  {:class :ui/canvas
   :style {:width 36
           :height (* terrain-rule-grid-cell-size 3)}
   :render (fn [state ctx]
             (let [color {:r 0xe6 :g 0xea :b 0xee}
                   y (/ (* terrain-rule-grid-cell-size 3) 2)]
               (do
                 (r/line! {:x 5 :y y} {:x 30 :y y} color)
                 (r/line! {:x 23 :y (- y 7)} {:x 30 :y y} color)
                 (r/line! {:x 23 :y (+ y 7)} {:x 30 :y y} color))))})

(defun terrain-rule-application-options-child []
  (chk/make {:label "Exclusive"
             :value :terrain-rule-exclusive
             :checked? (ui/bind-state :selected-terrain-rule-exclusive?)
             :style {:width :fill
                     :height 24}}))

(defun terrain-rule-add-button-child [label class]
  (merge {:mode 'ui/button
          :state {:label label}
          :on-click (fn [state event ctx]
                      (ui/emit! (:view ctx) :terrain/rule-add)
                      state)}
         (if class {:class class} {})))

