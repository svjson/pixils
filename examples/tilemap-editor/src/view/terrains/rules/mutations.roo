(ns tilemap-editor.view.terrains.rules.mutations
  (:require [tilemap-editor.model.mutation :as mutation]
            [tilemap-editor.model.tilemap :as tilemap]
            [tilemap-editor.view.terrains.model :as model]))

(defun terrain-rule-target-path
  "Resolves semantic terrain-rule `target` identity against editor `state`.
  `target` may identify `:ruleset-id`, `:rule-id`, and a relative `:path`.
  Returns the concrete editor-state path, or nil when either identity cannot
  be resolved."
  [state target]
  (let [ruleset-id (or (:ruleset-id target)
                       (model/selected-terrain-ruleset-id state))
        ruleset-index (find-index (:rulesets state)
                                  (fn [ruleset]
                                    (= (:id ruleset) ruleset-id)))
        ruleset (when-let [index ruleset-index]
                  (nth (:rulesets state) index))
        rule-id (or (:rule-id target)
                    (:selected-terrain-rule-id state)
                    (model/selected-terrain-rule-id state))
        rule-index (find-index (:rules ruleset)
                               (fn [rule]
                                 (= (:id rule) rule-id)))]
    (when (and (some? ruleset-index)
               (some? rule-index))
      (concat [:rulesets ruleset-index :rules rule-index]
              (:path target)))))

(defun apply
  "Applies one terrain-rule mutation to editor `state`. `action` uses the
  `:label`, `:op`, `:target`, and `:args` mutation envelope; the label is
  consumed by the receiving persistence boundary. Returns updated editor
  state with affected previews and standard-role caches refreshed."
  [state action]
  (let [target (:target action)
        args (:args action)
        state (cond-> state
                (:ruleset-id target)
                (assoc :selected-terrain-ruleset-id (:ruleset-id target))
                (:rule-id target)
                (assoc :selected-terrain-rule-id (:rule-id target)))
        next-state
        (case (:op action)
          :value/set
          (case (:kind target)
            :terrain-rule
            (if-let [path (terrain-rule-target-path state target)]
              (mutation/apply state
                              (assoc action :target {:path path}))
              state)

            :terrain-rule-match
            (model/set-selected-rule-match-condition state
                                                     (:direction target)
                                                     (:value args))

            :terrain-rule-output
            (case (:path target)
              [:tileset]
              (model/set-selected-rule-output-tileset state (:value args))

              [:target-layer]
              (model/set-selected-rule-output-target-layer state (:value args))

              :default state)

            :terrain-rule-stamp-cell
            (let [x (:x target)
                  y (:y target)
                  state (assoc state
                               :selected-terrain-rule-output-position
                               {:x x :y y})]
              (case (:path target)
                [:mask]
                (model/set-selected-rule-stamp-mask state
                                                    x
                                                    y
                                                    (:value args))

                [:tile]
                (model/set-selected-rule-stamp-tile state
                                                    x
                                                    y
                                                    (:value args))

                :default state))

            :terrain-standard-setup
            (model/set-selected-terrain-standard-setup-visible
             state
             (:setup-id target)
             (:value args))

            :terrain-standard-role
            (case (:path target)
              [:tile]
              (model/set-terrain-standard-role-tile state
                                                    (:setup-id target)
                                                    (:role-id target)
                                                    (:opposing target)
                                                    (:value args))

              [:mask]
              (model/set-terrain-standard-role-mask state
                                                    (:setup-id target)
                                                    (:role-id target)
                                                    (:opposing target)
                                                    (:value args))

              [:overlay]
              (model/set-terrain-standard-role-overlay state
                                                       (:setup-id target)
                                                       (:role-id target)
                                                       (:opposing target)
                                                       (:value args))

              :default state)

            :default
            (mutation/apply state action))

          :terrain-rule/add
          (model/add-terrain-rule state)

          :terrain-rule/duplicate
          (model/duplicate-selected-terrain-rule state)

          :terrain-rule/move
          (model/move-selected-terrain-rule state (:direction args))

          :terrain-rule/reorder
          (model/reorder-selected-terrain-rules state
                                                (:from args)
                                                (:to args)
                                                (:value args))

          :terrain-rule/remove
          (model/delete-selected-terrain-rule state)

          :terrain-rule/cycle-match
          (assoc (model/cycle-selected-rule-match-condition
                  state
                  (:direction target)
                  (:step args))
                 :selected-terrain-rule-match-direction
                 (:direction target))

          :terrain-rule/cycle-output-signature
          (model/cycle-selected-rule-output-terrain-signature
           state
           (:direction target)
           (:step args))

          :terrain-rule/transform
          (model/transform-selected-rule state (:command args))

          :default state)]
    (if (not= (:rulesets state) (:rulesets next-state))
      (model/clear-terrain-standard-role-slot-cache
       (tilemap/refresh-terrain-stamp-preview-for-ruleset-change
        state
        next-state
        (or (model/selected-terrain-ruleset-id state)
            (model/selected-terrain-ruleset-id next-state))))
      next-state)))
