(ns tilemap-editor.view.terrains.rules.dialogs
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.window :as w]))

(defun open-name!
  "Opens the terrain-rule rename mode. `state` is returned unchanged, `ctx` supplies the originating view, and `rule-id` and `name` initialize the dialog result."
  [state ctx rule-id name]
  (push-mode! 'terrain-rule-name-dialog-modal
              {:rule-id rule-id
               :name name}
              {:origin {:view (:view ctx)
                        :event :terrain/rule-name-dialog-result}})
  state)

(defun open-delete-confirmation!
  "Opens confirmation for deleting a terrain rule. `state` is returned unchanged, `ctx` owns the dialog, and `rule-id` and `name` identify the rule in the emitted result."
  [state ctx rule-id name]
  (dialog/open-confirm!
   ctx
   {:title "Delete Terrain Rule"
    :body {:mode 'ui/text
           :style {:width :fill}
           :state {:value (str "Delete terrain rule \"" name "\"?")}}
    :buttons [:dialog/cancel
              {:type :dialog/ok
               :label "Delete"}]
    :result-event :terrain/rule-delete-confirm-result
    :payload {:rule-id rule-id}})
  state)

(defcomponent terrain-rule-name-dialog-body
  {:class :ui/content
   :style {:width 260
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :children [{:mode 'ui/text
               :state {:value "Rule name:"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :name)
                       :auto-focus? true}}
              {:mode 'terrain-rule-name-dialog-buttons
               :state {:name (ui/bind-state :name)}}]})

(defcomponent terrain-rule-name-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (ui/emit! (:view ctx)
                                     :terrain-rule-name-dialog/cancel)
                           state)}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "OK"
                       :name (ui/bind-state :name)}
               :on-click (fn [state event ctx]
                           (ui/emit! (:view ctx)
                                     :terrain-rule-name-dialog/confirm
                                     {:name (:name state)})
                           state)}]})

(defmode terrain-rule-name-dialog-modal
  {:on {:terrain-rule-name-dialog/cancel
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (pop-mode! {:type :cancel
                      :rule-id (:rule-id state)})
          state)
        :terrain-rule-name-dialog/confirm
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (pop-mode! {:type :confirm
                      :rule-id (:rule-id state)
                      :name (-> event :payload :name)})
          state)}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title "Rename Terrain Rule"}
                       :state {:rule-id (ui/bind-state :rule-id)
                               :name (ui/bind-state :name)}
                       :body [{:mode 'terrain-rule-name-dialog-body
                               :state {:name (ui/bind-state :name)}}]})]})
