(ns tilemap-editor.view.terrains.model
  (:require [tilemap-editor.model.data :as data]))

(defun terrain-set-options [terrain-sets]
  (for-indexed [index terrain-set (or terrain-sets [])]
    {:value index
     :label (or (:label terrain-set) (:name terrain-set) (str (:id terrain-set)))}))

(defun terrain-options [terrain-set]
  (for-indexed [index terrain (or (:terrains terrain-set) [])]
    {:value index
     :label (or (:label terrain) (:name terrain) (str (:id terrain)))}))

(defun selected-terrain-set-index [terrain-sets index]
  (let [terrain-sets (or terrain-sets [])]
    (when (> (count terrain-sets) 0)
      (min (max (or index 0) 0)
           (dec (count terrain-sets))))))

(defun selected-terrain-set [terrain-sets index]
  (if-let [index (selected-terrain-set-index terrain-sets index)]
    (nth terrain-sets index)
    nil))

(defun selected-terrain-index [terrain-set index]
  (let [terrains (or (:terrains terrain-set) [])]
    (when (> (count terrains) 0)
      (min (max (or index 0) 0)
           (dec (count terrains))))))

(defun selected-terrain [terrain-set index]
  (if-let [index (selected-terrain-index terrain-set index)]
    (nth (or (:terrains terrain-set) []) index)
    nil))

(defun selected-terrain-set-indices [terrain-sets index]
  (if-let [index (selected-terrain-set-index terrain-sets index)]
    [index]
    []))

(defun selected-terrain-indices [terrain-set index]
  (if-let [index (selected-terrain-index terrain-set index)]
    [index]
    []))

(defun id-exists? [items id]
  (> (count (filter (or items [])
                    (fn [item]
                      (= (:id item) id))))
     0))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun unique-id-from [items root suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword candidate)]
    (if (id-exists? items id)
      (unique-id-from items
                      root
                      (if suffix (inc suffix) 2))
      id)))

(defun unique-id-from-except [items root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword candidate)
        exists? (> (count (filter (for-indexed [index item (or items [])]
                                    {:index index
                                     :id (:id item)})
                                  (fn [entry]
                                    (and (= (:id entry) id)
                                         (not= (:index entry)
                                               exclude-index)))))
                   0)]
    (if exists?
      (unique-id-from-except items
                             root
                             exclude-index
                             (if suffix (inc suffix) 2))
      id)))

(defun id-from-input [items value exclude-index]
  (when (not (blank? value))
    (unique-id-from-except items (kebab-case value) exclude-index nil)))

(defun unique-terrain-set-id [terrain-sets]
  (unique-id-from terrain-sets "terrain-set" nil))

(defun unique-terrain-id [terrains]
  (unique-id-from terrains "terrain" nil))

(defun terrain-name-exists? [terrains name exclude-index]
  (> (count (filter (for-indexed [index terrain (or terrains [])]
                      {:index index
                       :label (:label terrain)})
                    (fn [entry]
                      (and (= (:label entry) name)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-terrain-name-from [terrains root-name exclude-index suffix]
  (let [candidate (if suffix
                    (str root-name " " suffix)
                    root-name)]
    (if (terrain-name-exists? terrains candidate exclude-index)
      (unique-terrain-name-from terrains
                                root-name
                                exclude-index
                                (if suffix (inc suffix) 2))
      candidate)))

(defun unique-ruleset-id [rulesets terrain-set-id]
  (unique-id-from rulesets (str (keyword-label terrain-set-id) "-rules") nil))

(defun unique-rule-id [rules]
  (unique-id-from rules "rule" nil))

(defun make-terrain-set [terrain-sets tilesets]
  (let [id (unique-terrain-set-id terrain-sets)]
    (merge {:id id
            :label "Terrain set"
            :terrains []}
           (if-let [tileset (data/tileset-key tilesets 0)]
             {:tileset tileset}
             {}))))

(defun make-terrain [terrain-set tilesets]
  (let [id (unique-terrain-id (:terrains terrain-set))]
    (merge {:id id
            :label "Terrain"}
           (if-let [tile (data/tile-id tilesets (:tileset terrain-set) 0)]
             {:tile tile}
             {}))))

(defun terrain-set-from-input [terrain-sets tilesets id label]
  (let [terrain-set (make-terrain-set terrain-sets tilesets)
        requested-id (if (blank? id)
                       (keyword-label (:id terrain-set))
                       id)
        requested-label (if (blank? label)
                          (:label terrain-set)
                          label)]
    (assoc terrain-set
           :id (id-from-input terrain-sets requested-id nil)
           :label requested-label)))

(defun add-terrain-set [state]
  (let [terrain-sets (or (:terrain-sets state) [])
        terrain-set (make-terrain-set terrain-sets (:tilesets state))
        index (count terrain-sets)]
    (assoc state
           :terrain-sets (concat terrain-sets [terrain-set])
           :selected-terrain-set-index index
           :selected-terrain-index nil)))

(defun add-terrain-set-with-id [state id label]
  (let [terrain-sets (or (:terrain-sets state) [])
        terrain-set (terrain-set-from-input terrain-sets
                                            (:tilesets state)
                                            id
                                            label)
        index (count terrain-sets)]
    (assoc state
           :terrain-sets (concat terrain-sets [terrain-set])
           :selected-terrain-set-index index
           :selected-terrain-index nil)))

(defun update-terrain-set-at [terrain-sets index update-fn]
  (for-indexed [terrain-set-index terrain-set (or terrain-sets [])]
    (if (= terrain-set-index index)
      (update-fn terrain-set)
      terrain-set)))

(defun terrain-from-input [terrain-set tilesets id label]
  (let [terrain (make-terrain terrain-set tilesets)
        requested-id (if (blank? id)
                       (keyword-label (:id terrain))
                       id)
        requested-label (if (blank? label)
                          (:label terrain)
                          label)]
    (assoc terrain
           :id (id-from-input (:terrains terrain-set) requested-id nil)
           :label requested-label)))

(defun add-terrain [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrains (or (:terrains terrain-set) [])
          terrain (make-terrain terrain-set (:tilesets state))
          terrain-index (count terrains)]
      (assoc state
             :terrain-sets (update-terrain-set-at
                            (:terrain-sets state)
                            set-index
                            (fn [terrain-set]
                              (assoc terrain-set
                                     :terrains (concat terrains [terrain]))))
             :selected-terrain-set-index set-index
             :selected-terrain-index terrain-index))
    state))

(defun add-terrain-with-id [state id label]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrains (or (:terrains terrain-set) [])
          terrain (terrain-from-input terrain-set (:tilesets state) id label)
          terrain-index (count terrains)]
      (assoc state
             :terrain-sets (update-terrain-set-at
                            (:terrain-sets state)
                            set-index
                            (fn [terrain-set]
                              (assoc terrain-set
                                     :terrains (concat terrains [terrain]))))
             :selected-terrain-set-index set-index
             :selected-terrain-index terrain-index))
    state))

(defun terrain-label [terrain]
  (or (:label terrain)
      (:name terrain)
      (keyword-label (:id terrain))
      "Terrain"))

(defun duplicate-terrain-name [terrains terrain]
  (unique-terrain-name-from terrains
                            (str (terrain-label terrain) " Copy")
                            nil
                            nil))

(defun duplicate-terrain-with-id [terrains terrain name id]
  (let [requested-name (if (blank? name)
                         (duplicate-terrain-name terrains terrain)
                         name)
        label (unique-terrain-name-from terrains
                                        requested-name
                                        nil
                                        nil)
        requested-id (if (blank? id)
                       (kebab-case label)
                       id)]
    (assoc (assoc terrain
                  :id (id-from-input terrains requested-id nil))
           :label label)))

(defun duplicate-terrain [terrains terrain name]
  (duplicate-terrain-with-id terrains terrain name nil))

(defun insert-terrain-after [terrains terrain-index duplicate]
  (apply concat
         (for-indexed [index terrain (or terrains [])]
           (if (= index terrain-index)
             [terrain duplicate]
             [terrain]))))

(defun duplicate-selected-terrain [state name]
  (duplicate-selected-terrain-with-id state name nil))

(defun duplicate-selected-terrain-with-id [state name id]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrain-index (selected-terrain-index terrain-set
                                                (:selected-terrain-index state))
          terrains (or (:terrains terrain-set) [])
          terrain (when (not (nil? terrain-index))
                    (nth terrains terrain-index))
          duplicate (when terrain
                      (duplicate-terrain-with-id terrains terrain name id))]
      (if duplicate
        (assoc state
               :terrain-sets (update-terrain-set-at
                              (:terrain-sets state)
                              set-index
                              (fn [terrain-set]
                                (assoc terrain-set
                                       :terrains (insert-terrain-after
                                                  terrains
                                                  terrain-index
                                                  duplicate))))
               :rulesets (duplicate-terrain-rulesets
                          (:rulesets state)
                          (:id terrain-set)
                          (:id terrain)
                          (:id duplicate))
               :selected-terrain-set-index set-index
               :selected-terrain-index (inc terrain-index)
               :selected-terrain-rule-id nil)
        state))
    state))

(defun terrain-label-by-index [state terrain-index]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (when (and terrain-set
                           (not (nil? terrain-index))
                           (< terrain-index (count (or (:terrains terrain-set) []))))
                  (nth (:terrains terrain-set) terrain-index))]
    (terrain-label terrain)))

(defun selected-terrain-set-path [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    [:terrain-sets set-index]
    nil))

(defun selected-terrain-path [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)]
      (if-let [terrain-index (selected-terrain-index terrain-set
                                                     (:selected-terrain-index state))]
        [:terrain-sets set-index :terrains terrain-index]
        nil))
    nil))

(defun set-selected-terrain-set-label [state label]
  (if-let [path (selected-terrain-set-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun set-selected-terrain-label [state label]
  (if-let [path (selected-terrain-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun replace-terrain-set-reference [value old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-set-reference item old-id new-id)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (replace-terrain-set-reference
                               (if (and (= key :terrain-set)
                                        (= item old-id))
                                 new-id
                                 item)
                               old-id
                               new-id))))
    :default value))

(defun rename-terrain-set-references [state old-id new-id]
  (assoc state
         :layers (replace-terrain-set-reference (:layers state) old-id new-id)
         :layer-profiles (replace-terrain-set-reference (:layer-profiles state)
                                                        old-id
                                                        new-id)
         :brushes (replace-terrain-set-reference (:brushes state) old-id new-id)
         :rulesets (replace-terrain-set-reference (:rulesets state)
                                                  old-id
                                                  new-id)))

(defun set-selected-terrain-set-id [state value]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-sets (or (:terrain-sets state) [])
          old-id (get-in state [:terrain-sets set-index :id])]
      (if-let [new-id (id-from-input terrain-sets value set-index)]
        (let [next-state (assoc-in state [:terrain-sets set-index :id] new-id)]
          (rename-terrain-set-references next-state old-id new-id))
        state))
    state))

(defun replace-terrain-ref [value old-id new-id]
  (if (= value old-id) new-id value))

(defun replace-terrain-refs-in-tiles [tiles old-id new-id]
  (map (or tiles [])
       (fn [row]
         (map (or row [])
              (fn [cell]
                (replace-terrain-ref cell old-id new-id))))))

(defun replace-terrain-refs-in-layer [layer terrain-set old-id new-id]
  (if (and (= (:data-kind layer) :terrain)
           (= (:terrain-set layer) terrain-set))
    (assoc layer :tiles (replace-terrain-refs-in-tiles (:tiles layer)
                                                       old-id
                                                       new-id))
    layer))

(defun replace-terrain-refs-in-layers [layers terrain-set old-id new-id]
  (map (or layers [])
       (fn [layer]
         (replace-terrain-refs-in-layer layer terrain-set old-id new-id))))

(defun replace-terrain-refs-in-brush-value [value terrain-set old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-refs-in-brush-value item
                                                         terrain-set
                                                         old-id
                                                         new-id)))
    "map" (let [value (if (and (= (:data-kind value) :terrain)
                               (= (:terrain-set value) terrain-set)
                               (:tiles value))
                        (assoc value :tiles (replace-terrain-refs-in-tiles
                                             (:tiles value)
                                             old-id
                                             new-id))
                        value)]
            (reduce-kv value
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (replace-terrain-refs-in-brush-value item
                                                                     terrain-set
                                                                     old-id
                                                                     new-id)))))
    :default value))

(defun terrain-source-layer-id? [layer terrain-set]
  (and (= (:data-kind layer) :terrain)
       (= (:terrain-set layer) terrain-set)
       (:id layer)))

(defun terrain-source-layer-ids-in [layers terrain-set]
  (map (filter (or layers [])
               (fn [layer]
                 (terrain-source-layer-id? layer terrain-set)))
       :id))

(defun terrain-source-layer-ids [state terrain-set]
  (concat (terrain-source-layer-ids-in (:layers state) terrain-set)
          (apply concat
                 (map (or (:layer-profiles state) [])
                      (fn [profile]
                        (terrain-source-layer-ids-in (:layers profile)
                                                     terrain-set))))))

(defun ruleset-source-layer-matches? [ruleset source-layer-ids]
  (or (contains? source-layer-ids (:source-layer ruleset))
      (> (count (filter (or (:source-layers ruleset) [])
                        (fn [source-layer]
                          (contains? source-layer-ids source-layer))))
         0)))

(defun replace-terrain-rule-reference* [value old-id new-id signature?]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-rule-reference*
                     item
                     old-id
                     new-id
                     signature?)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (let [next-signature? (or signature?
                                                 (= key :terrain-signature)
                                                 (= key :terrain-signatures))
                             item (if (or signature? (= key :terrain))
                                    (replace-terrain-ref item old-id new-id)
                                    item)]
                         (assoc result
                                key
                                (replace-terrain-rule-reference*
                                 item
                                 old-id
                                 new-id
                                 next-signature?)))))
    :default (if signature?
               (replace-terrain-ref value old-id new-id)
               value)))

(defun replace-terrain-rule-reference [value old-id new-id]
  (replace-terrain-rule-reference* value old-id new-id false))

(defun duplicate-terrain-rule [rules rule old-id new-id]
  (let [duplicate (replace-terrain-rule-reference rule old-id new-id)]
    (assoc (assoc duplicate
                  :id (unique-id-from rules
                                      (str (keyword-label (:id rule)) "-copy")
                                      nil))
           :label (duplicate-rule-label rule))))

(defun duplicate-rules-for-terrain [rules old-id new-id]
  (reduce (or rules [])
          []
          (fn [result rule]
            (let [result-with-rule (concat result [rule])]
              (if (= (terrain-rule-center rule) old-id)
                (concat result-with-rule
                        [(duplicate-terrain-rule
                          (concat result-with-rule (or rules []))
                          rule
                          old-id
                          new-id)])
                result-with-rule)))))

(defun duplicate-terrain-rulesets [rulesets terrain-set-id old-id new-id]
  (map (or rulesets [])
       (fn [ruleset]
         (if (= (:terrain-set ruleset) terrain-set-id)
           (assoc ruleset
                  :rules (duplicate-rules-for-terrain
                          (:rules ruleset)
                          old-id
                          new-id))
           ruleset))))

(defun replace-terrain-refs-in-rulesets [rulesets terrain-set source-layer-ids old-id new-id]
  (map (or rulesets [])
       (fn [ruleset]
         (if (or (= (:terrain-set ruleset) terrain-set)
                 (ruleset-source-layer-matches? ruleset source-layer-ids))
           (replace-terrain-rule-reference ruleset old-id new-id)
           ruleset))))

(defun rename-terrain-references [state terrain-set old-id new-id]
  (let [source-layer-ids (terrain-source-layer-ids state terrain-set)]
    (assoc state
           :layers (replace-terrain-refs-in-layers (:layers state)
                                                   terrain-set
                                                   old-id
                                                   new-id)
           :brushes (replace-terrain-refs-in-brush-value (:brushes state)
                                                         terrain-set
                                                         old-id
                                                         new-id)
           :rulesets (replace-terrain-refs-in-rulesets (:rulesets state)
                                                       terrain-set
                                                       source-layer-ids
                                                       old-id
                                                       new-id))))

(defun set-selected-terrain-id [state value]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)]
      (if-let [terrain-index (selected-terrain-index
                              terrain-set
                              (:selected-terrain-index state))]
        (let [terrains (or (:terrains terrain-set) [])
              old-id (get-in state [:terrain-sets set-index :terrains terrain-index :id])
              terrain-set-id (:id terrain-set)]
          (if-let [new-id (id-from-input terrains value terrain-index)]
            (let [next-state (assoc-in state
                                       [:terrain-sets set-index :terrains terrain-index :id]
                                       new-id)]
              (rename-terrain-references next-state terrain-set-id old-id new-id))
            state))
        state))
    state))

(defun terrain-tile-valid? [tilesets tileset tile]
  (and tile
       (= tile (data/tile-id tilesets tileset tile))))

(defun first-tile-for [tilesets tileset]
  (data/tile-id tilesets tileset 0))

(defun set-selected-terrain-set-tileset [state tileset-index]
  (if-let [set-path (selected-terrain-set-path state)]
    (let [tileset (data/tileset-key (:tilesets state) tileset-index)
          state (assoc-in state (concat set-path [:tileset]) tileset)]
      (if-let [terrain-path (selected-terrain-path state)]
        (let [tile (get-in state (concat terrain-path [:tile]))]
          (if (terrain-tile-valid? (:tilesets state) tileset tile)
            state
            (assoc-in state (concat terrain-path [:tile])
                      (first-tile-for (:tilesets state) tileset))))
        state))
    state))

(defun set-selected-terrain-tile [state tile]
  (if-let [path (selected-terrain-path state)]
    (assoc-in state (concat path [:tile]) tile)
    state))

(def neighbor-directions [:nw :n :ne :w :e :sw :s :se])
(def terrain-signature-directions [:nw :n :ne :w :center :e :sw :s :se])

(def default-rule-match
  {:nw :ignore
   :n :ignore
   :ne :ignore
   :w :ignore
   :e :ignore
   :sw :ignore
   :s :ignore
   :se :ignore})

(defun output-grid-position [x y]
  {:x (max 0 (min 2 (or x 1)))
   :y (max 0 (min 2 (or y 1)))})

(defun selected-rule-output-position [state]
  (output-grid-position 1 1))

(defun empty-terrain-signature-row []
  [nil nil nil])

(defun empty-terrain-signature-grid []
  [(empty-terrain-signature-row)
   (empty-terrain-signature-row)
   (empty-terrain-signature-row)])

(defun output-layer-terrain-signatures [output-layer]
  (or (:terrain-signatures output-layer)
      (empty-terrain-signature-grid)))

(defun solid-terrain-signature [terrain-id]
  (reduce terrain-signature-directions
          {}
          (fn [result direction]
            (assoc result direction terrain-id))))

(defun match-condition-signature-value [center-terrain-id condition]
  (case condition
    :same center-terrain-id
    :none :none
    :default
    (if (= (type-of condition) "map")
      (:terrain condition)
      nil)))

(defun default-terrain-signature-for-rule [rule]
  (let [center-terrain-id (terrain-rule-center rule)]
    (reduce-kv (or (:match rule) {})
               (solid-terrain-signature center-terrain-id)
               (fn [signature direction condition]
                 (if-let [value (match-condition-signature-value
                                  center-terrain-id
                                  condition)]
                   (assoc signature direction value)
                   (if (or (= condition :not-same)
                           (= condition :other-terrain)
                           (= condition :any-terrain))
                     (dissoc signature direction)
                     signature))))))

(defun output-layer-terrain-signature-at [output-layer x y]
  (nth (or (nth (output-layer-terrain-signatures output-layer) y) []) x))

(defun rule-output-terrain-signature-at [rule x y]
  (or (output-layer-terrain-signature-at (head (or (-> rule :output :layers)
                                                   []))
                                         x
                                         y)
      (default-terrain-signature-for-rule rule)))

(defun selected-rule-output-terrain-signature [state]
  (let [rule (selected-terrain-rule state)
        pos (selected-rule-output-position state)]
    (if rule
      (rule-output-terrain-signature-at rule (:x pos) (:y pos))
      {})))

(defun selected-terrain-set-id [state]
  (:id (selected-terrain-set (:terrain-sets state)
                             (:selected-terrain-set-index state))))

(defun selected-terrain-id [state]
  (:id (selected-terrain
        (selected-terrain-set (:terrain-sets state)
                              (:selected-terrain-set-index state))
        (:selected-terrain-index state))))

(defun active-layer-profile [state]
  (let [profiles (if (empty? (or (:layers state) []))
                   (:layer-profiles state)
                   (data/sync-layer-profiles (:layer-profiles state)
                                             (:selected-layer-profile-id state)
                                             (:layers state)))]
    (data/layer-profile-by-id profiles
                              (:selected-layer-profile-id state))))

(defun profile-layers [state]
  (let [profile (active-layer-profile state)]
    (if profile
      (:layers profile)
      (:layers state))))

(defun profile-layer-by-id [state layer-id]
  (head (filter (profile-layers state)
                (fn [layer]
                  (= (:id layer) layer-id)))))

(defun terrain-source-layer? [layer terrain-set-id]
  (and (= (:data-kind layer) :terrain)
       (= (:terrain-set layer) terrain-set-id)))

(defun terrain-source-layers [state terrain-set-id]
  (filter (profile-layers state)
          (fn [layer]
            (terrain-source-layer? layer terrain-set-id))))

(defun indexed-profile-layers [state]
  (for-indexed [index layer (profile-layers state)]
    {:index index
     :layer layer}))

(defun first-terrain-source-layer-index [state terrain-set-id]
  (:index (head (filter (indexed-profile-layers state)
                        (fn [entry]
                          (terrain-source-layer? (:layer entry)
                                                 terrain-set-id))))))

(defun tile-output-layer? [layer]
  (and (= (:data-kind layer) :tile-ref)
       (:tileset layer)))

(defun terrain-rule-output-layer? [source-index entry]
  (and (tile-output-layer? (:layer entry))
       (or (nil? source-index)
           (> (:index entry) source-index))))

(defun tile-output-layers [state terrain-set-id]
  (let [source-index (first-terrain-source-layer-index state terrain-set-id)]
    (map (filter (indexed-profile-layers state)
                 (fn [entry]
                   (terrain-rule-output-layer? source-index entry)))
         :layer)))

(defun first-source-layer-id [state terrain-set-id]
  (:id (head (terrain-source-layers state terrain-set-id))))

(defun first-output-layer [state terrain-set-id]
  (head (tile-output-layers state terrain-set-id)))

(defun first-output-layer-for-tileset [state terrain-set-id tileset]
  (head (filter (tile-output-layers state terrain-set-id)
                (fn [layer]
                  (= (:tileset layer) tileset)))))

(defun default-output-layer-for-terrain-set [state terrain-set]
  (let [tileset (:tileset terrain-set)]
    (or (when tileset
          (first-output-layer-for-tileset state (:id terrain-set) tileset))
        (when (nil? tileset)
          (first-output-layer state (:id terrain-set))))))

(defun center-stamp-tiles [tile]
  [[nil nil nil]
   [nil tile nil]
   [nil nil nil]])

(defun default-output-stamp-layer [state terrain-set terrain]
  (let [output-layer (default-output-layer-for-terrain-set state terrain-set)
        tileset (or (:tileset terrain-set) (:tileset output-layer))
        tile (or (:tile terrain)
                 (first-tile-for (:tilesets state) tileset))]
    {:id :layer
     :data-kind :tile-ref
     :target-layer (:id output-layer)
     :tileset tileset
     :tiles (center-stamp-tiles tile)}))

(defun default-rule-output [state terrain-set terrain]
  {:anchor {:x 1 :y 1}
   :layers [(default-output-stamp-layer state terrain-set terrain)]})

(defun make-terrain-ruleset [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain-set-id (:id terrain-set)
        id (unique-ruleset-id (:rulesets state) terrain-set-id)]
    {:id id
     :label "Terrain rules"
     :kind :terrain-stamp
     :terrain-set terrain-set-id
     :source-layer (first-source-layer-id state terrain-set-id)
     :rules []}))

(defun make-terrain-rule [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set
                                  (:selected-terrain-index state))
        ruleset (selected-terrain-ruleset state)
        id (unique-rule-id (:rules ruleset))]
    {:id id
     :label "Rule"
     :terrain (:id terrain)
     :match default-rule-match
     :output (default-rule-output state terrain-set terrain)}))

(defun ruleset-for-terrain-set? [ruleset terrain-set-id]
  (= (:terrain-set ruleset) terrain-set-id))

(defun terrain-rulesets [state]
  (let [terrain-set-id (selected-terrain-set-id state)]
    (filter (or (:rulesets state) [])
            (fn [ruleset]
              (ruleset-for-terrain-set? ruleset terrain-set-id)))))

(defun selected-terrain-ruleset-id [state]
  (let [rulesets (terrain-rulesets state)
        requested (:selected-terrain-ruleset-id state)
        match (head (filter rulesets
                            (fn [ruleset]
                              (= (:id ruleset) requested))))]
    (or (:id match)
        (:id (head rulesets)))))

(defun selected-terrain-ruleset [state]
  (let [selected-id (selected-terrain-ruleset-id state)]
    (head (filter (or (:rulesets state) [])
                  (fn [ruleset]
                    (= (:id ruleset) selected-id))))))

(defun terrain-ruleset-options [state]
  (for-indexed [index ruleset (terrain-rulesets state)]
    {:value (:id ruleset)
     :label (or (:label ruleset) (str (:id ruleset)))}))

(defun selected-terrain-ruleset-index [state]
  (let [selected-id (selected-terrain-ruleset-id state)]
    (find-index (terrain-rulesets state)
                (fn [ruleset]
                  (= (:id ruleset) selected-id)))))

(defun terrain-rule-center [rule]
  (or (:terrain rule)
      (-> rule :match :center :terrain)))

(defun terrain-rules-for-selected-terrain [state]
  (let [terrain-id (selected-terrain-id state)]
    (filter (or (:rules (selected-terrain-ruleset state)) [])
            (fn [rule]
              (= (terrain-rule-center rule) terrain-id)))))

(defun selected-terrain-rule-id [state]
  (let [ruleset (selected-terrain-ruleset state)
        rules (terrain-rules-for-selected-terrain state)
        requested (:selected-terrain-rule-id state)
        match (head (filter rules
                            (fn [rule]
                              (= (:id rule) requested))))]
    (or (:id match)
        (:id (head rules)))))

(defun selected-terrain-rule [state]
  (let [rule-id (selected-terrain-rule-id state)]
    (head (filter (terrain-rules-for-selected-terrain state)
                  (fn [rule]
                    (= (:id rule) rule-id))))))

(defun selected-rule-stamp-layer [state]
  (head (or (-> (selected-terrain-rule state) :output :layers) [])))

(defun selected-rule-stamp-tileset [state]
  (:tileset (selected-rule-stamp-layer state)))

(defun selected-rule-output-tileset-index [state]
  (data/tileset-index (:tilesets state)
                      (selected-rule-stamp-tileset state)))

(def target-layer-none-value :none)

(defun selected-rule-output-target-layer [state]
  (:target-layer (selected-rule-stamp-layer state)))

(defun terrain-rule-output-target-layer-option [layer]
  {:value (:id layer)
   :label (str (or (:label layer) (keyword-label (:id layer)))
               " ("
               (keyword-label (:tileset layer))
               ")")})

(defun terrain-rule-output-target-layer-options [state]
  (concat [{:value target-layer-none-value
            :label "No target layer"}]
          (map (tile-output-layers state (selected-terrain-set-id state))
               terrain-rule-output-target-layer-option)))

(defun selected-rule-output-target-layer-index [state]
  (let [value (or (selected-rule-output-target-layer state)
                  target-layer-none-value)
        index (find-index (terrain-rule-output-target-layer-options state)
                          (fn [option]
                            (= (:value option) value)))]
    (or index 0)))

(defun first-rule-stamp-tile [state]
  (data/tile-id (:tilesets state)
                (selected-rule-stamp-tileset state)
                0))

(defun rule-stamp-tile-exists? [state tile-ref]
  (not (nil? (head (filter (data/tile-options
                            (:tilesets state)
                            (selected-rule-stamp-tileset state))
                           (fn [option]
                             (= (:value option) tile-ref)))))))

(defun selected-rule-stamp-tile [state]
  (let [requested (:terrain-rule-selected-tile state)]
    (if (nil? requested)
      nil
      (or (when (rule-stamp-tile-exists? state requested)
            requested)
          (first-rule-stamp-tile state)))))

(defun selected-rule-stamp-tile-indices [state]
  (let [tile-ref (selected-rule-stamp-tile state)
        tileset (selected-rule-stamp-tileset state)]
    (if (and tile-ref tileset)
      [(data/tile-index (:tilesets state) tileset tile-ref)]
      [])))

(defun terrain-rule-options [state]
  (for-indexed [index rule (terrain-rules-for-selected-terrain state)]
    {:value (:id rule)
     :label (or (:label rule) (str (:id rule)))}))

(defun selected-terrain-rule-index [state]
  (let [rule-id (selected-terrain-rule-id state)]
    (find-index (terrain-rules-for-selected-terrain state)
                (fn [rule]
                  (= (:id rule) rule-id)))))

(defun add-terrain-ruleset [state]
  (if (selected-terrain-set-id state)
    (let [ruleset (make-terrain-ruleset state)]
      (assoc state
             :rulesets (concat (or (:rulesets state) []) [ruleset])
             :selected-terrain-ruleset-id (:id ruleset)
             :selected-terrain-rule-id nil))
    state))

(defun update-ruleset [rulesets ruleset-id update-fn]
  (map (or rulesets [])
       (fn [ruleset]
         (if (= (:id ruleset) ruleset-id)
           (update-fn ruleset)
           ruleset))))

(defun update-rule [rules rule-id update-fn]
  (map (or rules [])
       (fn [rule]
         (if (= (:id rule) rule-id)
           (update-fn rule)
           rule))))

(defun rule-index-by-id [rules rule-id]
  (find-index (or rules [])
              (fn [rule]
                (= (:id rule) rule-id))))

(defun rule-by-id [rules rule-id]
  (head (filter (or rules [])
                (fn [rule]
                  (= (:id rule) rule-id)))))

(defun terrain-rule-label-by-id [state rule-id]
  (or (:label (rule-by-id (or (:rules (selected-terrain-ruleset state)) [])
                          rule-id))
      (str rule-id)))

(defun remove-rule-by-id [rules rule-id]
  (filter (or rules [])
          (fn [rule]
            (not= (:id rule) rule-id))))

(defun duplicate-rule-label [rule]
  (str (or (:label rule)
           (keyword-label (:id rule))
           "Rule")
       " Copy"))

(defun duplicate-rule [rules rule]
  (assoc (assoc rule
                :id (unique-id-from rules
                                    (str (keyword-label (:id rule)) "-copy")
                                    nil))
         :label (duplicate-rule-label rule)))

(defun insert-rule-after [rules rule-id duplicate]
  (apply concat
         (map (or rules [])
              (fn [rule]
                (if (= (:id rule) rule-id)
                  [rule duplicate]
                  [rule])))))

(defun swap-rules-by-id [rules a-id b-id]
  (let [a-index (rule-index-by-id rules a-id)
        b-index (rule-index-by-id rules b-id)]
    (if (and (not (nil? a-index))
             (not (nil? b-index)))
      (for-indexed [index rule (or rules [])]
        (cond
          (= index a-index) (nth rules b-index)
          (= index b-index) (nth rules a-index)
          :default rule))
      rules)))

(defun ensure-terrain-ruleset [state]
  (if (selected-terrain-ruleset-id state)
    state
    (add-terrain-ruleset state)))

(defun add-terrain-rule [state]
  (let [state (derive-terrain-workspace-state state)
        state-with-ruleset (ensure-terrain-ruleset state)]
    (let [ruleset-id (selected-terrain-ruleset-id state-with-ruleset)]
      (if (and ruleset-id (selected-terrain-id state-with-ruleset))
        (let [rule (make-terrain-rule state-with-ruleset)]
          (assoc state-with-ruleset
                 :rulesets (update-ruleset
                            (:rulesets state-with-ruleset)
                            ruleset-id
                            (fn [ruleset]
                              (assoc ruleset
                                     :rules
                                     (concat (or (:rules ruleset) []) [rule]))))
                 :selected-terrain-ruleset-id ruleset-id
                 :selected-terrain-rule-id (:id rule)))
        state-with-ruleset))))

(defun set-selected-terrain-rule-label [state label]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule :label label)))))))
      state)))

(defun set-selected-terrain-rule-exclusive [state exclusive?]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc (assoc state :selected-terrain-rule-exclusive? exclusive?)
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule
                                                       :exclusive?
                                                       exclusive?)))))))
      state)))

(defun duplicate-selected-terrain-rule [state]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        ruleset (selected-terrain-ruleset state)
        rule (rule-by-id (:rules ruleset) rule-id)
        duplicate (when rule (duplicate-rule (:rules ruleset) rule))]
    (if (and ruleset-id rule-id duplicate)
      (assoc state
             :selected-terrain-rule-id (:id duplicate)
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (insert-rule-after (:rules ruleset)
                                                    rule-id
                                                    duplicate)))))
      state)))

(defun terrain-rule-move-target-id [state rule-id direction]
  (let [rules (terrain-rules-for-selected-terrain state)
        index (rule-index-by-id rules rule-id)
        target-index (case direction
                       :up (when (and index (> index 0))
                             (dec index))
                       :down (when (and index (< index (dec (count rules))))
                               (inc index))
                       :default nil)]
    (:id (when (not (nil? target-index))
           (nth rules target-index)))))

(defun move-selected-terrain-rule [state direction]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        target-id (terrain-rule-move-target-id state rule-id direction)]
    (if (and ruleset-id rule-id target-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (swap-rules-by-id (:rules ruleset)
                                                   rule-id
                                                   target-id)))))
      state)))

(defun delete-selected-terrain-rule [state]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        rules (terrain-rules-for-selected-terrain state)
        index (rule-index-by-id rules rule-id)
        remaining (remove-rule-by-id rules rule-id)
        next-index (when (> (count remaining) 0)
                     (min (or index 0) (dec (count remaining))))
        next-rule-id (:id (when (not (nil? next-index))
                            (nth remaining next-index)))]
    (if (and ruleset-id rule-id)
      (assoc (assoc state
                    :rulesets (update-ruleset
                               (:rulesets state)
                               ruleset-id
                               (fn [ruleset]
                                 (assoc ruleset
                                        :rules
                                        (remove-rule-by-id (:rules ruleset)
                                                           rule-id)))))
             :selected-terrain-rule-id next-rule-id)
      state)))

(defun set-selected-rule-terrain [state terrain-id]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule
                                                       :terrain
                                                       terrain-id)))))))
      state)))

(defun terrain-signature-option-value [value]
  (if (= value :unknown)
    nil
    value))

(defun set-terrain-signature-value [signature direction value]
  (let [value (terrain-signature-option-value value)]
    (if (nil? value)
      (dissoc (or signature {}) direction)
      (assoc (or signature {}) direction value))))

(defun set-selected-rule-output-terrain-signature [state direction value]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        pos (selected-rule-output-position state)]
    (if (and ruleset-id
             rule-id
             (contains? terrain-signature-directions direction))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (let [output-layer
                                          (head (or (-> rule
                                                        :output
                                                        :layers)
                                                    []))
                                          signature
                                          (rule-output-terrain-signature-at
                                           rule
                                           (:x pos)
                                           (:y pos))
                                          next-signature
                                          (set-terrain-signature-value
                                           signature
                                           direction
                                           value)
                                          signatures
                                          (output-layer-terrain-signatures
                                           output-layer)]
                                      (assoc-in
                                       (assoc-in rule
                                                 [:output
                                                  :layers
                                                  0
                                                  :terrain-signatures]
                                                 signatures)
                                       [:output
                                        :layers
                                        0
                                        :terrain-signatures
                                        (:y pos)
                                        (:x pos)]
                                       next-signature))))))))
      state)))

(defun match-condition-from-option [value]
  (case value
    :ignore :ignore
    :same :same
    :none :none
    :any-terrain :any-terrain
    :not-same :not-same
    :other-terrain :other-terrain
    :default
    {:terrain value}))

(defun match-condition-option-value [condition]
  (case condition
    :ignore :ignore
    :same :same
    :none :none
    :any-terrain :any-terrain
    :not-same :not-same
    :other-terrain :not-same
    :default
    (if (= (type-of condition) "map")
      (:terrain condition)
      :ignore)))

(defun set-selected-rule-match-condition [state direction value]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        condition (match-condition-from-option value)]
    (if (and ruleset-id rule-id (contains? neighbor-directions direction))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc-in rule
                                                         [:match direction]
                                                         condition)))))))
      state)))

(defun rule-with-output-layers [rule layers]
  (assoc rule
         :output
         (assoc (or (:output rule) {}) :layers layers)))

(defun replace-first-output-layer [rule output-layer]
  (let [layers (or (-> rule :output :layers) [])]
    (rule-with-output-layers
     rule
     (if (> (count layers) 0)
       (concat [output-layer] (tail layers))
       [output-layer]))))

(defun update-selected-rule-output-layer [state update-fn]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set
                                  (:selected-terrain-index state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (let [fallback-layer
                                          (default-output-stamp-layer state
                                                                      terrain-set
                                                                      terrain)
                                          output-layer
                                          (or (head (or (-> rule
                                                            :output
                                                            :layers)
                                                        []))
                                              fallback-layer)]
                                      (replace-first-output-layer
                                       rule
                                       (update-fn output-layer)))))))))
      state)))

(defun output-layer-with-tileset [state terrain-set output-layer tileset]
  (let [target-layer (profile-layer-by-id state (:target-layer output-layer))
        matching-target (first-output-layer-for-tileset state
                                                       (:id terrain-set)
                                                       tileset)
        target-layer-id (if (= (:tileset target-layer) tileset)
                          (:id target-layer)
                          (:id matching-target))]
    (if target-layer-id
      (assoc (assoc output-layer :tileset tileset) :target-layer target-layer-id)
      (dissoc (assoc output-layer :tileset tileset) :target-layer))))

(defun set-selected-rule-output-tileset [state tileset]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))]
    (if tileset
      (assoc (update-selected-rule-output-layer
              state
              (fn [output-layer]
                (output-layer-with-tileset state
                                           terrain-set
                                           output-layer
                                           tileset)))
             :terrain-rule-selected-tile nil)
      state)))

(defun set-selected-rule-output-target-layer [state target-layer-id]
  (let [target-layer-id (if (= target-layer-id target-layer-none-value)
                          nil
                          target-layer-id)]
    (assoc (update-selected-rule-output-layer
            state
            (fn [output-layer]
              (if target-layer-id
                (let [target-layer (profile-layer-by-id state target-layer-id)]
                  (assoc (assoc output-layer :target-layer target-layer-id)
                         :tileset
                         (or (:tileset target-layer)
                             (:tileset output-layer))))
                (dissoc output-layer :target-layer))))
           :terrain-rule-selected-tile nil)))

(defun matrix-width [matrix]
  (count (or (head (or matrix [])) [])))

(defun transform-matrix-cell [matrix transform-fn x y]
  (let [pos (transform-fn x y)]
    (nth (or (nth (or matrix []) (:y pos)) []) (:x pos))))

(defun transform-matrix [matrix transform-fn]
  (let [matrix (or matrix [])
        height (count matrix)
        width (matrix-width matrix)]
    (dotimes [y height]
      (dotimes [x width]
        (transform-matrix-cell matrix transform-fn x y)))))

(defun output-layer-transform [output-layer command]
  (let [tiles (or (:tiles output-layer) [])
        width (matrix-width tiles)
        height (count tiles)]
    (case command
      :flip-horizontal
      (fn [x y] {:x (- (dec width) x) :y y})

      :flip-vertical
      (fn [x y] {:x x :y (- (dec height) y)})

      :rotate-left
      (fn [x y] {:x (- (dec width) y) :y x})

      :rotate-right
      (fn [x y] {:x y :y (- (dec height) x)})

      :default
      (fn [x y] {:x x :y y}))))

(defun transform-output-anchor [anchor command width height]
  (let [anchor (or anchor {:x 0 :y 0})
        x (:x anchor)
        y (:y anchor)]
    (case command
      :flip-horizontal {:x (- (dec width) x) :y y}
      :flip-vertical {:x x :y (- (dec height) y)}
      :rotate-left {:x y :y (- (dec width) x)}
      :rotate-right {:x (- (dec height) y) :y x}
      :default anchor)))

(def direction-positions
  {:nw {:x 0 :y 0}
   :n {:x 1 :y 0}
   :ne {:x 2 :y 0}
   :w {:x 0 :y 1}
   :e {:x 2 :y 1}
   :sw {:x 0 :y 2}
   :s {:x 1 :y 2}
   :se {:x 2 :y 2}})

(def position-directions
  {[0 0] :nw
   [1 0] :n
   [2 0] :ne
   [0 1] :w
   [2 1] :e
   [0 2] :sw
   [1 2] :s
   [2 2] :se})

(defun transform-rule-match-source-direction [direction transform-fn]
  (let [pos (get direction-positions direction)
        source-pos (transform-fn (:x pos) (:y pos))]
    (get position-directions [(:x source-pos) (:y source-pos)])))

(defun transform-rule-match [match command]
  (let [transform-fn (output-layer-transform {:tiles [[nil nil nil]
                                                   [nil nil nil]
                                                   [nil nil nil]]}
                                             command)
        match (or match {})]
    (reduce neighbor-directions
            {}
            (fn [result direction]
              (assoc result
                     direction
                     (or (get match
                              (transform-rule-match-source-direction
                               direction
                               transform-fn))
                         :ignore))))))

(defun transform-rule-output [rule command]
  (let [output (or (:output rule) {})
        layers (or (:layers output) [])
        first-layer (head layers)]
    (if first-layer
      (let [width (matrix-width (:tiles first-layer))
            height (count (or (:tiles first-layer) []))
            transform-fn (output-layer-transform first-layer command)
            transformed-layer
            (assoc (assoc first-layer
                          :tiles
                          (transform-matrix (:tiles first-layer)
                                            transform-fn))
                   :terrain-signatures
                   (transform-matrix (output-layer-terrain-signatures
                                      first-layer)
                                     transform-fn))]
        (assoc rule
               :output
               (assoc (assoc output
                             :layers
                             (concat [transformed-layer] (tail layers)))
                      :anchor
                      (transform-output-anchor (:anchor output)
                                               command
                                               width
                                               height))))
      rule)))

(defun transform-rule [rule command]
  (assoc (transform-rule-output rule command)
         :match
         (transform-rule-match (:match rule) command)))

(defun transform-selected-rule [state command]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (transform-rule
                                                 rule
                                                 command)))))))
      state)))

(defun set-selected-rule-stamp-tile [state x y tile-ref]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        pos (selected-rule-output-position state)]
    (if (and ruleset-id
             rule-id
             (= x (:x pos))
             (= y (:y pos)))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (if (> (count (or (-> rule
                                                          :output
                                                          :layers)
                                                      []))
                                           0)
                                      (let [output-layer
                                            (head (or (-> rule
                                                          :output
                                                          :layers)
                                                      []))
                                            signatures
                                            (output-layer-terrain-signatures
                                             output-layer)
                                            existing-signature
                                            (output-layer-terrain-signature-at
                                             output-layer
                                             x
                                             y)
                                            signature
                                            (when tile-ref
                                              (or existing-signature
                                                  (default-terrain-signature-for-rule
                                                   rule)))]
                                        (assoc-in
                                         (assoc-in
                                          (assoc-in rule
                                                    [:output
                                                     :layers
                                                     0
                                                     :tiles
                                                     y
                                                     x]
                                                    tile-ref)
                                          [:output
                                           :layers
                                           0
                                           :terrain-signatures]
                                          signatures)
                                         [:output
                                          :layers
                                          0
                                          :terrain-signatures
                                          y
                                          x]
                                         signature))
                                      rule)))))))
      state)))

(defun terrain-condition-option [terrain]
  {:value (:id terrain)
   :label (str "Terrain: "
               (or (:label terrain)
                   (:name terrain)
                   (str (:id terrain))))})

(defun match-condition-options [terrain-set center-terrain-id]
  (concat [{:value :ignore
            :label "Ignore"}
           {:value :same
            :label "Same"}
           {:value :none
            :label "Empty"}
           {:value :any-terrain
            :label "Any terrain"}
           {:value :not-same
            :label "Different terrain"}]
          (map (filter (or (:terrains terrain-set) [])
                       (fn [terrain]
                         (not= (:id terrain) center-terrain-id)))
               terrain-condition-option)))

(defun terrain-signature-condition-option [terrain]
  {:value (:id terrain)
   :label (or (:label terrain)
              (:name terrain)
              (str (:id terrain)))})

(defun terrain-signature-options [terrain-set]
  (concat [{:value :unknown
            :label "Unknown"}
           {:value :none
            :label "None"}]
          (map (or (:terrains terrain-set) [])
               terrain-signature-condition-option)))

(defun terrain-signature-option-index [terrain-set value]
  (let [value (or value :unknown)
        match (find-index (terrain-signature-options terrain-set)
                          (fn [option]
                            (= (:value option) value)))]
    (or match 0)))

(defun step-terrain-signature-value [terrain-set value step]
  (let [options (terrain-signature-options terrain-set)
        index (terrain-signature-option-index terrain-set value)
        next-index (if (empty? options)
                     0
                     (mod (+ index step (count options))
                          (count options)))]
    (:value (nth options next-index))))

(defun cycle-selected-rule-output-terrain-signature [state direction step]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        signature (selected-rule-output-terrain-signature state)
        value (get (or signature {}) direction)
        next-value (step-terrain-signature-value terrain-set value step)]
    (set-selected-rule-output-terrain-signature state direction next-value)))

(defun match-condition-index [terrain-set center-terrain-id condition]
  (let [value (match-condition-option-value condition)
        match (find-index (match-condition-options terrain-set
                                                   center-terrain-id)
                          (fn [option]
                            (= (:value option) value)))]
    (or match 0)))

(defun step-match-condition-value [terrain-set center-terrain-id condition step]
  (let [options (match-condition-options terrain-set center-terrain-id)
        index (match-condition-index terrain-set
                                     center-terrain-id
                                     condition)
        next-index (if (empty? options)
                     0
                     (mod (+ index step (count options))
                          (count options)))]
    (:value (nth options next-index))))

(defun cycle-selected-rule-match-condition [state direction step]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        rule (selected-terrain-rule state)
        center-terrain-id (terrain-rule-center rule)
        condition (get (or (:match rule) {}) direction)
        next-value (step-match-condition-value terrain-set
                                               center-terrain-id
                                               condition
                                               step)]
    (set-selected-rule-match-condition state direction next-value)))

(defun terrain-rule-output-summary [rule]
  (let [layers (or (-> rule :output :layers) [])]
    (str (count layers) " output layers")))

(defun derive-terrain-workspace-state [state]
  (let [terrain-sets (or (:terrain-sets state) [])
        set-index (selected-terrain-set-index terrain-sets
                                              (:selected-terrain-set-index state))
        terrain-set (selected-terrain-set terrain-sets set-index)
        terrain-index (selected-terrain-index terrain-set
                                              (:selected-terrain-index state))
        state (assoc state
                     :selected-terrain-set-index set-index
                     :selected-terrain-index terrain-index)
        ruleset-id (selected-terrain-ruleset-id state)
        rule-id (selected-terrain-rule-id
                 (assoc state :selected-terrain-ruleset-id ruleset-id))
        selected-rule (selected-terrain-rule
                       (assoc state
                              :selected-terrain-ruleset-id ruleset-id
                              :selected-terrain-rule-id rule-id))]
    (assoc state
           :selected-terrain-ruleset-id ruleset-id
           :selected-terrain-rule-id rule-id
           :selected-terrain-rule-exclusive? (= (:exclusive? selected-rule)
                                                true)
           :selected-terrain-rule-output-position
           (selected-rule-output-position
            (assoc state
                   :selected-terrain-ruleset-id ruleset-id
                   :selected-terrain-rule-id rule-id))
           :terrain-list-panel-disabled? (nil? set-index)
           :terrain-detail-panel-disabled? (nil? set-index))))
