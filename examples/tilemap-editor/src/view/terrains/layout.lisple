(ns tilemap-editor.view.terrains.layout
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.tab-panel :as tabs]
            pixils.ui.text-input
            [tilemap-editor.model.data :as data]
            [tilemap-editor.view.tilemap.renderer :as tr]
            [tilemap-editor.view.terrains.model :as model]))

(def terrain-list-row-height 24)

(defcomponent terrain-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height terrain-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    state))
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun terrain-row-child [index option]
  {:mode 'terrain-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun terrain-set-list-child [terrain-sets selected-index]
  (let [terrain-sets (or terrain-sets [])
        options (model/terrain-set-options terrain-sets)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (empty? options)
              :selected-indices (model/selected-terrain-set-indices
                                 terrain-sets
                                 selected-index)
              :force-selection? true
              :item-child terrain-row-child})))

(defcomponent terrain-set-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-sets nil
                  :rendered-selected-index nil))
   :update (fn [state ctx]
             (let [terrain-sets (or (:terrain-sets state) [])
                   selected-index (:selected-terrain-set-index state)]
               (do
                 (when (or (not= terrain-sets (:rendered-terrain-sets state))
                           (not= selected-index (:rendered-selected-index state)))
                   (ui/replace-child! (:view ctx)
                                      "terrain-set-list-box"
                                      (merge {:id "terrain-set-list-box"}
                                             (terrain-set-list-child
                                              terrain-sets
                                              selected-index))))
                 (assoc state
                        :rendered-terrain-sets terrain-sets
                        :rendered-selected-index selected-index))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :terrain/set-select
                                       (-> event :payload :value))
                             state))}
   :children [(merge {:id "terrain-set-list-box"}
                     (terrain-set-list-child [] nil))]})

(defun terrain-list-child [terrain-set selected-index disabled?]
  (let [options (model/terrain-options terrain-set)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height terrain-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (if (or disabled? (empty? options)) true false)
              :selected-indices (if disabled?
                                  []
                                  (model/selected-terrain-indices terrain-set
                                                                  selected-index))
              :force-selection? true
              :item-child terrain-row-child})))

(defcomponent terrain-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-terrain-set nil
                  :rendered-selected-index nil
                  :rendered-disabled? nil))
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   selected-index (:selected-terrain-index state)
                   disabled? (:terrain-list-panel-disabled? state)]
               (do
                 (when (or (not= terrain-set (:rendered-terrain-set state))
                           (not= selected-index (:rendered-selected-index state))
                           (not= disabled? (:rendered-disabled? state)))
                   (ui/replace-child! (:view ctx)
                                      "terrain-list-box"
                                      (merge {:id "terrain-list-box"}
                                             (terrain-list-child terrain-set
                                                                 selected-index
                                                                 disabled?))))
                 (assoc state
                        :rendered-terrain-set terrain-set
                        :rendered-selected-index selected-index
                        :rendered-disabled? disabled?))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :terrain/select
                                       (-> event :payload :value))
                             state))}
   :children [(merge {:id "terrain-list-box"}
                     (terrain-list-child nil nil true))]})

(defun make-terrain-set-list-panel []
  (hp/make {:title "Terrain Sets"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :terrain/add-set)
                                             state))}]
            :body-style {:padding 8
                         :height :fill}
            :state {:terrain-sets (ui/bind-state :terrain-sets)
                    :selected-terrain-set-index
                    (ui/bind-state :selected-terrain-set-index)}
            :body-state {:terrain-sets (ui/bind-state :terrain-sets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)}
            :children [{:mode 'terrain-set-list
                        :state {:terrain-sets (ui/bind-state :terrain-sets)
                                :selected-terrain-set-index
                                (ui/bind-state :selected-terrain-set-index)}}]}))

(defun make-terrain-list-panel []
  (hp/make {:title "Terrains"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"
                                       :disabled?
                                       (ui/bind-state
                                        :terrain-list-panel-disabled?)}
                               :on-click (fn [state event ctx]
                                           (do
                                             (when (not (:disabled? state))
                                               (ui/emit! (:view ctx)
                                                         :terrain/add))
                                             state))}]
            :body-style {:padding 8
                         :height :fill}
            :state {:terrain-sets (ui/bind-state :terrain-sets)
                    :selected-terrain-set-index
                    (ui/bind-state :selected-terrain-set-index)
                    :selected-terrain-index
                    (ui/bind-state :selected-terrain-index)
                    :terrain-list-panel-disabled?
                    (ui/bind-state :terrain-list-panel-disabled?)}
            :body-state {:terrain-sets (ui/bind-state :terrain-sets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)
                         :selected-terrain-index
                         (ui/bind-state :selected-terrain-index)
                         :terrain-list-panel-disabled?
                         (ui/bind-state :terrain-list-panel-disabled?)}
            :children [{:mode 'terrain-list
                        :state {:terrain-sets (ui/bind-state :terrain-sets)
                                :selected-terrain-set-index
                                (ui/bind-state :selected-terrain-set-index)
                                :selected-terrain-index
                                (ui/bind-state :selected-terrain-index)
                                :terrain-list-panel-disabled?
                                (ui/bind-state
                                 :terrain-list-panel-disabled?)}}]}))

(defcomponent terrain-edit-field
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 8}}
   :on {:text-input/change (fn [state event ctx]
                             (do
                               (ui/emit! (:view ctx)
                                         :terrain/edit-field-change
                                         {:field (:field state)
                                          :value (-> event :payload :value)})
                               state))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 72}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text-input
               :style {:width 220
                       :height 22}
               :state {:value (ui/bind-state :value)
                       :disabled? (ui/bind-state :disabled?)}}]})

(defun terrain-edit-field-child [field label value disabled?]
  {:mode 'terrain-edit-field
   :state {:field field
           :label label
           :value value
           :disabled? disabled?}})

(defun terrain-preview-tile [tilesets terrain-set terrain]
  (data/tile-in tilesets
                (:tileset terrain-set)
                (data/terrain-preview-tile terrain)))

(defcomponent terrain-preview
  {:class :ui/content
   :style {:width 48
           :height 48}
   :render (fn [state ctx]
             (do
               (r/rect! {:x 0 :y 0 :w 48 :h 48}
                        {:fill true
                         :color {:r 0x12 :g 0x15 :b 0x18}})
               (when (:tile state)
                 (tr/draw-tile! (:tile state) {:x 8 :y 8 :w 32 :h 32}))
               (r/rect! {:x 0 :y 0 :w 48 :h 48}
                        {:color {:r 0x00 :g 0x00 :b 0x00}})))})

(defcomponent terrain-preview-tileset-selector
  {:style {:width 220
           :height 22}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   tilesets (or (:tilesets state) [])]
               (assoc state
                      :tileset-options (data/tileset-options tilesets)
                      :selected-preview-tileset-index
                      (data/tileset-index tilesets (:tileset terrain-set))
                      :disabled? (or (nil? terrain-set)
                                     (empty? tilesets)))))
   :on {:combo-box/change (fn [state event ctx]
                            (do
                              (ui/emit! (:view ctx)
                                        :terrain/tileset-change
                                        (-> event :payload :selected-index))
                              state))}
   :children [(cb/make {:options (ui/bind-state :tileset-options)
                        :selected-index
                        (ui/bind-state :selected-preview-tileset-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent terrain-preview-tile-selector
  {:style {:width 220
           :height 22}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   terrain (model/selected-terrain terrain-set
                                                   (:selected-terrain-index state))
                   tileset (:tileset terrain-set)
                   options (data/tile-options (:tilesets state) tileset)]
               (assoc state
                      :tile-options options
                      :selected-preview-tile-index
                      (data/tile-index (:tilesets state) tileset (:tile terrain))
                      :disabled? (or (nil? terrain)
                                     (empty? options)))))
   :on {:combo-box/change (fn [state event ctx]
                            (do
                              (ui/emit! (:view ctx)
                                        :terrain/tile-change
                                        (-> event :payload :value))
                              state))}
   :children [(cb/make {:options (ui/bind-state :tile-options)
                        :selected-index
                        (ui/bind-state :selected-preview-tile-index)
                        :disabled? (ui/bind-state :disabled?)})]})

(defcomponent terrain-set-detail-editor
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children [(terrain-edit-field-child :set-id
                                        "Id"
                                        (ui/bind-state :set-id)
                                        (ui/bind-state :set-disabled?))
              (terrain-edit-field-child :set-label
                                        "Name"
                                        (ui/bind-state :set-label)
                                        (ui/bind-state :set-disabled?))
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Preview tileset"}}
              {:mode 'terrain-preview-tileset-selector
               :state {:terrain-sets (ui/bind-state :terrain-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :tilesets (ui/bind-state :tilesets)}}]})

(defcomponent terrain-value-detail-editor
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children [{:mode 'terrain-preview
               :state {:tile (ui/bind-state :preview-tile)}}
              (terrain-edit-field-child :terrain-id
                                        "Id"
                                        (ui/bind-state :terrain-id)
                                        (ui/bind-state :terrain-disabled?))
              (terrain-edit-field-child :terrain-label
                                        "Name"
                                        (ui/bind-state :terrain-label)
                                        (ui/bind-state :terrain-disabled?))
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Preview tile"}}
              {:mode 'terrain-preview-tile-selector
               :state {:terrain-sets (ui/bind-state :terrain-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :selected-terrain-index
                       (ui/bind-state :selected-terrain-index)
                       :tilesets (ui/bind-state :tilesets)}}]})

(defcomponent terrain-detail-editor
  {:style {:width :fill
           :height :fill}
   :update (fn [state ctx]
             (let [terrain-set (model/selected-terrain-set
                                (:terrain-sets state)
                                (:selected-terrain-set-index state))
                   terrain (model/selected-terrain terrain-set
                                                   (:selected-terrain-index state))]
               (assoc state
                      :terrain-set terrain-set
                      :terrain terrain
                      :set-disabled? (nil? terrain-set)
                      :terrain-disabled? (nil? terrain)
                      :set-id (if terrain-set
                                (model/keyword-label (:id terrain-set))
                                "")
                      :set-label (or (:label terrain-set) "")
                      :terrain-id (if terrain
                                    (model/keyword-label (:id terrain))
                                    "")
                      :terrain-label (or (:label terrain) (:name terrain) "")
                      :preview-tile (terrain-preview-tile (:tilesets state)
                                                          terrain-set
                                                          terrain))))
   :on {:tab-panel/change (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (assoc state
                                     :terrain-detail-tab
                                     (-> event :payload :tab))))}
   :children [(tabs/make
               {:selected-tab (ui/bind-state :terrain-detail-tab)
                :style {:width :fill
                        :height :fill}
                :state {:terrain-sets (ui/bind-state :terrain-sets)
                        :tilesets (ui/bind-state :tilesets)
                        :selected-terrain-set-index
                        (ui/bind-state :selected-terrain-set-index)
                        :selected-terrain-index
                        (ui/bind-state :selected-terrain-index)
                        :set-id (ui/bind-state :set-id)
                        :set-label (ui/bind-state :set-label)
                        :set-disabled? (ui/bind-state :set-disabled?)
                        :terrain-id (ui/bind-state :terrain-id)
                        :terrain-label (ui/bind-state :terrain-label)
                        :terrain-disabled? (ui/bind-state :terrain-disabled?)
                        :preview-tile (ui/bind-state :preview-tile)}
                :tabs [{:id :terrain-set
                        :label "Terrain Set"
                        :child {:mode 'terrain-set-detail-editor
                                :style {:padding 8}
                                :state {:terrain-sets
                                        (ui/bind-state :terrain-sets)
                                        :tilesets (ui/bind-state :tilesets)
                                        :selected-terrain-set-index
                                        (ui/bind-state
                                         :selected-terrain-set-index)
                                        :set-id (ui/bind-state :set-id)
                                        :set-label (ui/bind-state :set-label)
                                        :set-disabled?
                                        (ui/bind-state :set-disabled?)}}}
                       {:id :terrain
                        :label "Terrain"
                        :child {:mode 'terrain-value-detail-editor
                                :style {:padding 8}
                                :state {:terrain-sets
                                        (ui/bind-state :terrain-sets)
                                        :tilesets (ui/bind-state :tilesets)
                                        :selected-terrain-set-index
                                        (ui/bind-state
                                         :selected-terrain-set-index)
                                        :selected-terrain-index
                                        (ui/bind-state
                                         :selected-terrain-index)
                                        :terrain-id
                                        (ui/bind-state :terrain-id)
                                        :terrain-label
                                        (ui/bind-state :terrain-label)
                                        :terrain-disabled?
                                        (ui/bind-state :terrain-disabled?)
                                        :preview-tile
                                        (ui/bind-state :preview-tile)}}}]})]})

(defun make-terrain-detail-panel []
  (hp/make {:title "Terrain Definition"
            :style {:width :fill
                    :height :fill}
            :body-style {:padding 8
                         :height :fill}
            :state {:terrain-sets (ui/bind-state :terrain-sets)
                    :tilesets (ui/bind-state :tilesets)
                    :selected-terrain-set-index
                    (ui/bind-state :selected-terrain-set-index)
                    :selected-terrain-index
                    (ui/bind-state :selected-terrain-index)
                    :disabled? (ui/bind-state :terrain-detail-panel-disabled?)}
            :body-state {:terrain-sets (ui/bind-state :terrain-sets)
                         :tilesets (ui/bind-state :tilesets)
                         :selected-terrain-set-index
                         (ui/bind-state :selected-terrain-set-index)
                         :selected-terrain-index
                         (ui/bind-state :selected-terrain-index)}
            :children [{:mode 'terrain-detail-editor
                        :state {:terrain-sets (ui/bind-state :terrain-sets)
                                :tilesets (ui/bind-state :tilesets)
                                :selected-terrain-set-index
                                (ui/bind-state :selected-terrain-set-index)
                                :selected-terrain-index
                                (ui/bind-state :selected-terrain-index)}}]}))

(defcomponent terrain-definition-selector-column
  {:style {:width 300
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children [(make-terrain-set-list-panel)
              (make-terrain-list-panel)]})

(defcomponent terrain-definition-workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row
                    :gap 8}}
   :init (fn [state ctx]
           (model/derive-terrain-workspace-state state))
   :update (fn [state ctx]
             (model/derive-terrain-workspace-state state))
   :on {:terrain/add-set (fn [state event ctx]
                           (model/add-terrain-set state))
        :terrain/set-select (fn [state event ctx]
                              (assoc state
                                     :selected-terrain-set-index (:payload event)
                                     :selected-terrain-index nil))
        :terrain/add (fn [state event ctx]
                       (model/add-terrain state))
        :terrain/select (fn [state event ctx]
                          (assoc state :selected-terrain-index (:payload event)))
        :terrain/edit-field-change
        (fn [state event ctx]
          (let [payload (:payload event)]
            (case (:field payload)
              :set-id
              (model/set-selected-terrain-set-id state (:value payload))

              :set-label
              (model/set-selected-terrain-set-label state (:value payload))

              :terrain-id
              (model/set-selected-terrain-id state (:value payload))

              :terrain-label
              (model/set-selected-terrain-label state (:value payload))

              :default
              state)))
        :terrain/tileset-change (fn [state event ctx]
                                  (model/set-selected-terrain-set-tileset
                                   state
                                   (:payload event)))
        :terrain/tile-change (fn [state event ctx]
                               (model/set-selected-terrain-tile
                                state
                                (:payload event)))}
   :children [{:mode 'terrain-definition-selector-column
               :state {:terrain-sets (ui/bind-state :terrain-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :selected-terrain-index
                       (ui/bind-state :selected-terrain-index)
                       :terrain-list-panel-disabled?
                       (ui/bind-state :terrain-list-panel-disabled?)}}
              (make-terrain-detail-panel)]})
