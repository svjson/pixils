(ns tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [tilemap-editor.view.terrains.model :as model]
            [tilemap-editor.view.terrains.rules.dialogs :as rule-dialogs]))

(def row-height
  "Defines the rendered height, in pixels, of one terrain-rule list row."
  24)

(def context-menu
  "Defines the commands available from a terrain-rule row context menu."
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Rule"
            :action :terrain/rule-context-dummy
            :payload {:command :rename}}
           {:label "Duplicate"
            :action :terrain/rule-context-dummy
            :payload {:command :duplicate}}
           :separator
           {:label "Move Up"
            :action :terrain/rule-context-dummy
            :payload {:command :move-up}}
           {:label "Move Down"
            :action :terrain/rule-context-dummy
            :payload {:command :move-down}}
           :separator
           {:label "Delete Rule"
            :action :terrain/rule-context-dummy
            :payload {:command :delete}}]})

(defcomponent terrain-rule-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center}}
   :on-mouse-up (fn [state event ctx]
                  (ui/stop-propagation! event)
                  (when (= (:button event) :right)
                    (menu/open-context-menu! context-menu
                                             (:global-position event)
                                             state
                                             ctx))
                  state)
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (ui/stop-propagation! event)
                         (when (= (:type payload) :action)
                           (ui/emit! (:view ctx)
                                     :terrain/rule-context-command
                                     {:rule-id (:value state)
                                      :command (-> payload :payload :command)})))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defun make-row
  "Constructs a terrain-rule row child bound to the list selection.

  Args:
  - `index`: Position of the rule in the list.
  - `option`: Rule option containing `:value` and `:label`.

  Returns:
  A terrain-rule row child map."
  [index option]
  {:mode 'terrain-rule-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun make-list-box
  "Constructs the terrain-rule list box for editor `state`.

  Args:
  - `state`: Terrain-rule editor state used to derive the rule options.

  Returns:
  A reorderable, force-selected list-box child map."
  [state]
  (let [options (model/terrain-rule-options state)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height row-height
              :visible-rows 5
              :content-width 180
              :disabled? (empty? options)
              :state {:offset (ui/bind-state :terrain-rule-list-offset)}
              :selected-indices (ui/bind-state :selected-indices)
              :reorderable? true
              :force-selection? true
              :item-child make-row})))

(defcomponent terrain-rule-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-rulesets nil
                  :rendered-terrain-set-index nil
                  :rendered-terrain-index nil
                  :rendered-ruleset-id nil
                  :selected-indices []))
   :update (fn [state ctx]
             (let [rulesets (or (:rulesets state) [])
                   terrain-set-index (:selected-terrain-set-index state)
                   terrain-index (:selected-terrain-index state)
                   ruleset-id (model/selected-terrain-ruleset-id state)
                   selected-indices (if-let [index (model/selected-terrain-rule-index
                                                    state)]
                                      [index]
                                      [])]
               (when (or (not= rulesets (:rendered-rulesets state))
                         (not= terrain-set-index
                               (:rendered-terrain-set-index state))
                         (not= terrain-index (:rendered-terrain-index state))
                         (not= ruleset-id (:rendered-ruleset-id state)))
                 (ui/replace-child! (:view ctx)
                                    "terrain-rule-list-box"
                                    (merge {:id "terrain-rule-list-box"}
                                           (make-list-box state))))
               (assoc state
                      :rendered-rulesets rulesets
                      :rendered-terrain-set-index terrain-set-index
                      :rendered-terrain-index terrain-index
                      :rendered-ruleset-id ruleset-id
                      :selected-indices selected-indices)))
   :on {:list-box/selection-change (fn [state event ctx]
                           (ui/stop-propagation! event)
                           (ui/emit! (:view ctx)
                                     :terrain/rule-select
                                     (-> event :payload :value))
                           state)
        :terrain/rule-context-command
        (fn [state {:keys [payload] :as event} ctx]
          (let [rule-id (:rule-id payload)
                selected-state (assoc state
                                      :selected-terrain-rule-id
                                      rule-id)
                name (model/terrain-rule-label-by-id selected-state rule-id)]
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx) :terrain/rule-select rule-id)
            (case (:command payload)
              :rename
              (rule-dialogs/open-name! state ctx rule-id name)

              :duplicate
              (let [next-state
                    (model/duplicate-selected-terrain-rule selected-state)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Duplicate terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}})
                (ui/emit! (:view ctx)
                          :terrain/rule-select
                          (:selected-terrain-rule-id next-state)))

              :move-up
              (let [next-state
                    (model/move-selected-terrain-rule selected-state :up)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Move terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}}))

              :move-down
              (let [next-state
                    (model/move-selected-terrain-rule selected-state :down)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Move terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}}))

              :delete
              (rule-dialogs/open-delete-confirmation!
               state
               ctx
               rule-id
               name)

              :default
              nil)
            state))
        :terrain/rule-name-dialog-result
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (when (= (:type payload) :confirm)
            (let [ruleset (model/selected-terrain-ruleset state)
                  rule-index (model/rule-index-by-id (:rules ruleset)
                                                     (:rule-id payload))
                  rule (nth (:rules ruleset) rule-index)]
              (ui/emit!
               (:view ctx)
               :action/mutate!
               {:label "Rename terrain rule"
                :op :value/set
                :target {:path [rule-index]}
                :args {:value (assoc rule :label (:name payload))}})))
          state)
        :terrain/rule-delete-confirm-result
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (when (and (= (:choice payload) :dialog/ok)
                     (-> payload :payload :rule-id))
            (let [next-state
                  (model/delete-selected-terrain-rule
                   (assoc state
                          :selected-terrain-rule-id
                          (-> payload :payload :rule-id)))]
              (ui/emit!
               (:view ctx)
               :action/mutate!
               {:label "Delete terrain rule"
                :op :value/set
                :target {:path []}
                :args
                {:value
                 (:rules (model/selected-terrain-ruleset next-state))}})
              (ui/emit! (:view ctx)
                        :terrain/rule-select
                        (:selected-terrain-rule-id next-state))))
          state)
        :list-box/reorder (fn [state event ctx]
                            (let [next-state
                                  (model/reorder-selected-terrain-rules
                                   state
                                   (-> event :payload :from-index)
                                   (-> event :payload :to-index)
                                   (-> event :payload :value))]
                              (ui/stop-propagation! event)
                              (ui/emit!
                               (:view ctx)
                               :action/mutate!
                               {:label "Move terrain rule"
                                :op :value/set
                                :target {:path []}
                                :args
                                {:value
                                 (:rules
                                  (model/selected-terrain-ruleset
                                   next-state))}})
                              (ui/emit!
                               (:view ctx)
                               :terrain/rule-select
                               (:selected-terrain-rule-id next-state)))
                            state)}
   :children [(merge {:id "terrain-rule-list-box"}
                     (make-list-box {}))]})
