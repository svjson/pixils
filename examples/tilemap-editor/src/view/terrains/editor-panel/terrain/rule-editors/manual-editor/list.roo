(ns tilemap-editor.view.terrains.editor-panel.terrain.rule-editors.manual-editor.list
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.list-box :as lb]
            [tilemap-editor.view.terrains.model :as model]
            [tilemap-editor.view.terrains.rules.dialogs :as rule-dialogs]))

(def row-height
  "Defines the rendered height, in pixels, of one terrain-rule list row."
  24)

(def context-menu
  "Defines the commands available from a terrain-rule row context menu."
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Rule"
            :action :rename}
           {:label "Duplicate"
            :action :duplicate}
           :separator
           {:label "Move Up"
            :action :move-up}
           {:label "Move Down"
            :action :move-down}
           :separator
           {:label "Delete Rule"
            :action :delete}]})

(defcomponent terrain-rule-list
  {:style {:width :fill
           :height :fill}
   :on {:list-box/selection-change (fn [state event ctx]
                           (ui/stop-propagation! event)
                           (ui/emit! (:view ctx)
                                     :terrain/rule-select
                                     (head (-> event
                                               :payload
                                               :selected-values)))
                           state)
        :list-box/context-action
        (fn [state {:keys [payload] :as event} ctx]
          (let [rule-id (:value payload)
                selected-state (assoc state
                                      :selected-terrain-rule-id
                                      rule-id)
                name (model/terrain-rule-label-by-id selected-state rule-id)]
            (ui/stop-propagation! event)
            (ui/emit! (:view ctx) :terrain/rule-select rule-id)
            (case (:action payload)
              :rename
              (rule-dialogs/open-name! state ctx rule-id name)

              :duplicate
              (let [next-state
                    (model/duplicate-selected-terrain-rule selected-state)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Duplicate terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}})
                (ui/emit! (:view ctx)
                          :terrain/rule-select
                          (:selected-terrain-rule-id next-state)))

              :move-up
              (let [next-state
                    (model/move-selected-terrain-rule selected-state :up)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Move terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}}))

              :move-down
              (let [next-state
                    (model/move-selected-terrain-rule selected-state :down)]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Move terrain rule"
                  :op :value/set
                  :target {:path []}
                  :args
                  {:value
                   (:rules (model/selected-terrain-ruleset next-state))}}))

              :delete
              (rule-dialogs/open-delete-confirmation!
               state
               ctx
               rule-id
               name)

              :default
              nil)
            state))
        :terrain/rule-name-dialog-result
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (when (= (:type payload) :confirm)
            (let [ruleset (model/selected-terrain-ruleset state)
                  rule-index (model/rule-index-by-id (:rules ruleset)
                                                     (:rule-id payload))
                  rule (nth (:rules ruleset) rule-index)]
              (ui/emit!
               (:view ctx)
               :action/mutate!
               {:label "Rename terrain rule"
                :op :value/set
                :target {:path [rule-index]}
                :args {:value (assoc rule :label (:name payload))}})))
          state)
        :terrain/rule-delete-confirm-result
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (when (and (= (:choice payload) :dialog/ok)
                     (-> payload :payload :rule-id))
            (let [next-state
                  (model/delete-selected-terrain-rule
                   (assoc state
                          :selected-terrain-rule-id
                          (-> payload :payload :rule-id)))]
              (ui/emit!
               (:view ctx)
               :action/mutate!
               {:label "Delete terrain rule"
                :op :value/set
                :target {:path []}
                :args
                {:value
                 (:rules (model/selected-terrain-ruleset next-state))}})
              (ui/emit! (:view ctx)
                        :terrain/rule-select
                        (:selected-terrain-rule-id next-state))))
          state)
        :list-box/reorder (fn [state event ctx]
                            (let [next-state
                                  (model/reorder-selected-terrain-rules
                                   state
                                   (-> event :payload :from-index)
                                   (-> event :payload :to-index)
                                   (-> event :payload :value))]
                              (ui/stop-propagation! event)
                              (ui/emit!
                               (:view ctx)
                               :action/mutate!
                               {:label "Move terrain rule"
                                :op :value/set
                                :target {:path []}
                                :args
                                {:value
                                 (:rules
                                  (model/selected-terrain-ruleset
                                   next-state))}})
                              (ui/emit!
                               (:view ctx)
                               :terrain/rule-select
                               (:selected-terrain-rule-id next-state)))
                            state)}
   :children
   [(lb/make {:options (ui/project-state :rule-options)
              :style {:width :fill
                      :height :fill}
              :row-height row-height
              :visible-rows 5
              :disabled? (ui/project-state :rule-list-disabled?)
              :state {:offset (ui/bind-state :terrain-rule-list-offset)}
              :selected-index (ui/project-state :selected-rule-index)
              :reorderable? true
              :force-selection? true
              :item-context-menu context-menu})]})
