                                                                               :terrain-sets)
                                               :selected-terrain-set-index (ui/project-state :workspace
                                                                                             :selection
                                                                                             :terrain-set-index)
                                               :selected-terrain-index (ui/project-state :workspace
                                                                                         :selection
                                                                                         :terrain-index)
                                               :rulesets (ui/project-state :subject
                                                                           :rulesets)
                                               :selected-terrain-ruleset-id (ui/project-state :workspace
                                                                                              :selection
                                                                                              :ruleset-id)
                                               :selected-terrain-rule-id (ui/project-state :workspace
                                                                                           :selection
                                                                                           :rule-id)
                                               :selected-terrain-rule-match-direction (ui/project-state :workspace
                                                                                                        :rule-editor
                                                                                                        :match-direction)
                                               :tilesets (ui/project-state :reference-data
                                                                           :tilesets)}}
                                      {:mode 'terrain-rule-arrow}
                                      {:style {:width :shrink
                                               :height :shrink
                                               :layout {:direction :column
                                                        :gap 6}}
                                       :state {:subject (ui/project-state :subject)
                                               :reference-data (ui/project-state :reference-data)
                                               :workspace (ui/bind-state :workspace)
                                               :interaction (ui/project-state :interaction)}
                                       :children [{:mode 'terrain-stamp-grid-preview
                                                   :state {:rulesets (ui/project-state :subject
                                                                                       :rulesets)
                                                           :selected-terrain-ruleset-id (ui/project-state :workspace
                                                                                                          :selection
                                                                                                          :ruleset-id)
                                                           :selected-terrain-rule-id (ui/project-state :workspace
                                                                                                       :selection
                                                                                                       :rule-id)
                                                           :selected-terrain-rule-output-position (ui/project-state :workspace
                                                                                                                    :rule-editor
                                                                                                                    :output-position)
                                                           :terrain-rule-selected-tile (ui/project-state :interaction
                                                                                                         :rule-editor
                                                                                                         :selected-tile)
                                                           :terrain-sets (ui/project-state :subject
                                                                                           :terrain-sets)
                                                           :selected-terrain-set-index (ui/project-state :workspace
                                                                                                         :selection
                                                                                                         :terrain-set-index)
                                                           :selected-terrain-index (ui/project-state :workspace
                                                                                                     :selection
                                                                                                     :terrain-index)
                                                           :tilesets (ui/project-state :reference-data
                                                                                       :tilesets)}}
                                                  {:mode 'ui/text
                                                   :class :ui/muted
                                                   :state {:value "Ownership"}}
                                                  {:mode 'terrain-signature-grid-preview
                                                   :state {:terrain-sets (ui/project-state :subject
                                                                                           :terrain-sets)
                                                           :selected-terrain-set-index (ui/project-state :workspace
                                                                                                         :selection
                                                                                                         :terrain-set-index)
                                                           :selected-terrain-index (ui/project-state :workspace
                                                                                                     :selection
                                                                                                     :terrain-index)
                                                           :rulesets (ui/project-state :subject
                                                                                       :rulesets)
                                                           :selected-terrain-ruleset-id (ui/project-state :workspace
                                                                                                          :selection
                                                                                                          :ruleset-id)
                                                           :selected-terrain-rule-id (ui/project-state :workspace
                                                                                                       :selection
                                                                                                       :rule-id)
                                                           :selected-terrain-rule-output-position (ui/project-state :workspace
                                                                                                                    :rule-editor
                                                                                                                    :output-position)
                                                           :tilesets (ui/project-state :reference-data
                                                                                       :tilesets)}}]}]}
                          {:mode 'terrain-rule-output-settings
                           :state {:subject (ui/project-state :subject)
                                   :reference-data (ui/project-state :reference-data)
                                   :editor-context (ui/project-state :editor-context)
                                   :workspace (ui/project-state :workspace)}}
                          (rule-options/make)]}
              {:mode 'terrain-stamp-tile-picker-scroll-pane
               :state {:rulesets (ui/project-state :subject :rulesets)
                       :selected-terrain-ruleset-id (ui/project-state :workspace
                                                                      :selection
                                                                      :ruleset-id)
                       :selected-terrain-rule-id (ui/project-state :workspace
                                                                   :selection
                                                                   :rule-id)
                       :selected-terrain-rule-match-direction (ui/project-state :workspace
                                                                                :rule-editor
                                                                                :match-direction)
                       :terrain-rule-selected-tile (ui/project-state :interaction
                                                                     :rule-editor
                                                                     :selected-tile)
                       :terrain-rule-selected-mask (ui/project-state :interaction
                                                                     :rule-editor
                                                                     :selected-mask)
                       :terrain-rule-mask-polarity (ui/project-state :interaction
                                                                     :rule-editor
                                                                     :mask-polarity)
                       :terrain-sets (ui/project-state :subject :terrain-sets)
                       :selected-terrain-set-index (ui/project-state :workspace
                                                                     :selection
                                                                     :terrain-set-index)
                       :selected-terrain-index (ui/project-state :workspace
                                                                 :selection
                                                                 :terrain-index)
                       :tilesets (ui/project-state :reference-data :tilesets)}}]})

(defun terrain-rule-visual-editor-child [state]
  (if (-> state :derived :terrain :selected-rule)
    (let [child (terrain-rule-active-editor-child)]
      (assoc child
             :id "terrain-rule-visual-editor-content"
             :on {:action/mutate!
                  (fn [state {:keys [payload] :as event} ctx]
                    (let [editor-state
                          {:terrain-sets (-> state :subject :terrain-sets)
                           :selected-terrain-set-index
                           (-> state
                               :workspace
                               :selection
                               :terrain-set-index)
                           :selected-terrain-index
                           (-> state :workspace :selection :terrain-index)
                           :rulesets (-> state :subject :rulesets)
                           :selected-terrain-ruleset-id
                           (-> state :workspace :selection :ruleset-id)
                           :selected-terrain-rule-id
                           (-> state :workspace :selection :rule-id)}
                          ruleset (model/selected-terrain-ruleset editor-state)
                          rule-id (model/selected-terrain-rule-id editor-state)
                          ruleset-index
                          (find-index (-> state :subject :rulesets)
                                      (fn [candidate]
                                        (= (:id candidate) (:id ruleset))))
                          rule-index
                          (model/rule-index-by-id (:rules ruleset) rule-id)]
                      (ui/stop-propagation! event)
                      (ui/emit!
                       (:view ctx)
                       :action/mutate!
                       (assoc-in
                        payload
                        [:target :path]
                        (concat [ruleset-index :rules rule-index]
                                (-> payload :target :path)))))
                    state)}))
    {:id "terrain-rule-visual-editor-content"
     :mode 'terrain-rule-empty-editor
     :state {:subject (ui/project-state :subject)
             :reference-data (ui/project-state :reference-data)
             :editor-context (ui/project-state :editor-context)
             :workspace (ui/bind-state :workspace)
             :interaction (ui/project-state :interaction)
             :derived (ui/project-state :derived)}}))

(defcomponent terrain-rule-visual-editor
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :gap 8}}
   :update (fn [state ctx]
             (let [selected-rule
                   (model/selected-terrain-rule
                    {:terrain-sets (-> state :subject :terrain-sets)
                     :selected-terrain-set-index
                     (-> state :workspace :selection :terrain-set-index)
                     :selected-terrain-index
                     (-> state :workspace :selection :terrain-index)
                     :rulesets (-> state :subject :rulesets)
                     :selected-terrain-ruleset-id
                     (-> state :workspace :selection :ruleset-id)
                     :selected-terrain-rule-id
                     (-> state :workspace :selection :rule-id)})
                   has-rule? (some? selected-rule)
                   rule-add-disabled?
                   (= (-> state
                          :derived
                          :terrain
                          :rule-add-disabled?)
                      true)
                   next-state
                   (assoc-in state
                             [:derived :terrain :selected-rule]
                             selected-rule)]
               (when (or (not= has-rule? (:rendered-has-rule? state))
                         (not= rule-add-disabled?
                               (:rendered-rule-add-disabled? state)))
                 (ui/replace-child!
                  (:view ctx)
                  "terrain-rule-visual-editor-content"
                  (terrain-rule-visual-editor-child next-state)))
               (assoc next-state
                      :rendered-has-rule? has-rule?
                      :rendered-rule-add-disabled? rule-add-disabled?)))
   :children [(terrain-rule-visual-editor-child {})]})
