(ns tilemap-editor.view.terrains.model
  (:require [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.maps :as maps]))

(defun terrain-set-options [terrain-sets]
  (for-indexed [index terrain-set (or terrain-sets [])]
    {:value index
     :label (or (:label terrain-set) (:name terrain-set) (str (:id terrain-set)))}))

(defun terrain-options [terrain-set]
  (for-indexed [index terrain (or (:terrains terrain-set) [])]
    {:value index
     :label (or (:label terrain) (:name terrain) (str (:id terrain)))}))

(defun selected-terrain-set-index [terrain-sets index]
  (let [terrain-sets (or terrain-sets [])]
    (when (> (count terrain-sets) 0)
      (min (max (or index 0) 0)
           (dec (count terrain-sets))))))

(defun selected-terrain-set [terrain-sets index]
  (if-let [index (selected-terrain-set-index terrain-sets index)]
    (nth terrain-sets index)
    nil))

(defun selected-terrain-index [terrain-set index]
  (let [terrains (or (:terrains terrain-set) [])]
    (when (> (count terrains) 0)
      (min (max (or index 0) 0)
           (dec (count terrains))))))

(defun selected-terrain [terrain-set index]
  (if-let [index (selected-terrain-index terrain-set index)]
    (nth (or (:terrains terrain-set) []) index)
    nil))

(defun transition-terrain-set [transition]
  (:terrain-set transition))

(defun transition-id-label [value]
  (when (not (nil? value))
    (let [text (str value)]
      (if (= ":" (substr text 0 1))
        (substr text 1)
        text))))

(defun transitions-for-terrain-set [transitions terrain-set-id]
  (filter (or transitions [])
          (fn [transition]
            (= (transition-terrain-set transition) terrain-set-id))))

(defun transition-label [transition]
  (or (:label transition)
      (:name transition)
      (transition-id-label (:id transition))
      "Transition"))

(defun selected-transition-id [state]
  (let [terrain-set-id (:id (selected-terrain-set
                             (:terrain-sets state)
                             (:selected-terrain-set-index state)))
        transitions (transitions-for-terrain-set (:terrain-transitions state)
                                                 terrain-set-id)
        requested (:selected-terrain-transition-id state)
        match (head (filter transitions
                            (fn [transition]
                              (= (:id transition) requested))))]
    (or (:id match)
        (:id (head transitions)))))

(defun selected-transition [state]
  (let [transition-id (selected-transition-id state)]
    (head (filter (or (:terrain-transitions state) [])
                  (fn [transition]
                    (= (:id transition) transition-id))))))

(defun transition-options [state]
  (let [terrain-set-id (selected-terrain-set-id state)]
    (for-indexed [index transition
                  (transitions-for-terrain-set (:terrain-transitions state)
                                               terrain-set-id)]
      {:value (:id transition)
       :label (transition-label transition)})))

(defun mask-set-label [mask-set]
  (or (:label mask-set)
      (:name mask-set)
      (transition-id-label (:id mask-set))
      "Mask Set"))

(defun mask-set-options [mask-sets]
  (for-indexed [index mask-set (or mask-sets [])]
    {:value (:id mask-set)
     :label (mask-set-label mask-set)}))

(defun terrain-transition-mask-set-options [mask-sets]
  (concat [{:value :none
            :label "None"}]
          (mask-set-options mask-sets)))

(defun mask-set-by-id [mask-sets mask-set-id]
  (head (filter (or mask-sets [])
                (fn [mask-set]
                  (= (:id mask-set) mask-set-id)))))

(defun selected-transition-mask-set [state]
  (mask-set-by-id (:mask-sets state) (:mask-set (selected-transition state))))

(defun selected-mask-set-index [mask-sets index]
  (let [mask-sets (or mask-sets [])]
    (when (> (count mask-sets) 0)
      (min (max (or index 0) 0)
           (dec (count mask-sets))))))

(defun selected-mask-set [mask-sets index]
  (if-let [index (selected-mask-set-index mask-sets index)]
    (nth mask-sets index)
    nil))

(defun selected-mask-set-id [state]
  (:id (selected-mask-set (:mask-sets state)
                          (:selected-mask-set-index state))))

(defun selected-mask-set-indices [mask-sets index]
  (if-let [index (selected-mask-set-index mask-sets index)]
    [index]
    []))

(defun mask-label [mask]
  (or (:label mask)
      (:name mask)
      (transition-id-label (:id mask))
      "Mask"))

(defun mask-options [mask-set]
  (for-indexed [index mask (or (:masks mask-set) [])]
    {:value index
     :label (mask-label mask)}))

(defun terrain-mask-options [mask-sets]
  (reduce (or mask-sets [])
          []
          (fn [options mask-set]
            (concat options
                    (map (or (:masks mask-set) [])
                         (fn [mask]
                           {:value {:mask-set (:id mask-set)
                                    :mask (:id mask)}
                            :label (str (mask-set-label mask-set)
                                        " / "
                                        (mask-label mask))}))))))

(def default-terrain-rule-mask-polarity :solid-is-current)

(def terrain-rule-mask-polarity-options
  [{:value :solid-is-current
    :label "Base"}
   {:value :solid-is-opposing
    :label "Opposing"}])

(defun terrain-rule-mask-polarity [polarity]
  (if (or (= polarity :solid-is-current)
          (= polarity :solid-is-opposing))
    polarity
    default-terrain-rule-mask-polarity))

(defun terrain-rule-mask-polarity-index [state]
  (or (option-index-by-value terrain-rule-mask-polarity-options
                             (terrain-rule-mask-polarity
                              (:terrain-rule-mask-polarity state)))
      0))

(defun mask-ref-with-polarity [mask-ref polarity]
  (when mask-ref
    (assoc mask-ref :polarity (terrain-rule-mask-polarity polarity))))

(defun mask-options-for-ref [mask-set]
  (map (or (:masks mask-set) [])
       (fn [mask]
         {:value {:mask-set (:id mask-set)
                  :mask (:id mask)}
          :label (mask-label mask)})))

(defun terrain-rule-selected-mask-indices [state]
  (let [mask-ref (:terrain-rule-selected-mask state)
        index (find-index (terrain-mask-options-for-selected-terrain state)
                          (fn [option]
                            (= (:value option) mask-ref)))]
    (if (nil? index) [] [index])))

(defun selected-mask-index [mask-set index]
  (let [masks (or (:masks mask-set) [])]
    (when (> (count masks) 0)
      (min (max (or index 0) 0)
           (dec (count masks))))))

(defun selected-mask [mask-set index]
  (if-let [index (selected-mask-index mask-set index)]
    (nth (or (:masks mask-set) []) index)
    nil))

(defun selected-mask-indices [mask-set index]
  (if-let [index (selected-mask-index mask-set index)]
    [index]
    []))

(def mask-source-type-options
  [{:value :tile-composition
    :label "Tiles"}])

(defun option-index-by-value [options value]
  (let [match (head (filter (for-indexed [index option options]
                              {:index index
                               :value (:value option)})
                            (fn [entry]
                              (= (:value entry) value))))]
    (:index match)))

(defun mask-source-type-index [mask]
  (or (option-index-by-value mask-source-type-options
                             (-> mask :source :type))
      0))

(defun mask-source-direction-index [mask]
  0)

(defun mask-source-type-label [mask]
  (case (-> mask :source :type)
    :tile-composition "Tiles"
    :procedural-gradient "Procedural gradient"
    :image-alpha "Image alpha"
    :default "Unspecified"))

(defun selected-mask-reference [state]
  (let [mask-set (selected-mask-set (:mask-sets state)
                                    (:selected-mask-set-index state))
        mask (selected-mask mask-set (:selected-mask-index state))]
    (when (and mask-set mask)
      {:mask-set (:id mask-set)
       :mask (:id mask)})))

(defun mask-ref-set [mask-ref]
  (:mask-set mask-ref))

(defun mask-ref-mask [mask-ref]
  (:mask mask-ref))

(defun mask-by-ref [mask-sets mask-ref]
  (let [mask-set (mask-set-by-id mask-sets (mask-ref-set mask-ref))]
    (head (filter (or (:masks mask-set) [])
                  (fn [mask]
                    (= (:id mask) (mask-ref-mask mask-ref)))))))

(defun mask-ref-label [mask-sets mask-ref]
  (if-let [mask (mask-by-ref mask-sets mask-ref)]
    (mask-label mask)
    (if (mask-ref-mask mask-ref)
      (transition-id-label (mask-ref-mask mask-ref))
      "")))

(defun selected-terrain-set-indices [terrain-sets index]
  (if-let [index (selected-terrain-set-index terrain-sets index)]
    [index]
    []))

(defun selected-terrain-indices [terrain-set index]
  (if-let [index (selected-terrain-index terrain-set index)]
    [index]
    []))

(defun id-exists? [items id]
  (> (count (filter (or items [])
                    (fn [item]
                      (= (:id item) id))))
     0))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun unique-id-from [items root suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword candidate)]
    (if (id-exists? items id)
      (unique-id-from items
                      root
                      (if suffix (inc suffix) 2))
      id)))

(defun unique-id-from-except [items root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword candidate)
        exists? (> (count (filter (for-indexed [index item (or items [])]
                                    {:index index
                                     :id (:id item)})
                                  (fn [entry]
                                    (and (= (:id entry) id)
                                         (not= (:index entry)
                                               exclude-index)))))
                   0)]
    (if exists?
      (unique-id-from-except items
                             root
                             exclude-index
                             (if suffix (inc suffix) 2))
      id)))

(defun id-from-input [items value exclude-index]
  (when (not (blank? value))
    (unique-id-from-except items (kebab-case value) exclude-index nil)))

(defun unique-terrain-set-id [terrain-sets]
  (unique-id-from terrain-sets "terrain-set" nil))

(defun unique-terrain-id [terrains]
  (unique-id-from terrains "terrain" nil))

(defun terrain-name-exists? [terrains name exclude-index]
  (> (count (filter (for-indexed [index terrain (or terrains [])]
                      {:index index
                       :label (:label terrain)})
                    (fn [entry]
                      (and (= (:label entry) name)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-terrain-name-from [terrains root-name exclude-index suffix]
  (let [candidate (if suffix
                    (str root-name " " suffix)
                    root-name)]
    (if (terrain-name-exists? terrains candidate exclude-index)
      (unique-terrain-name-from terrains
                                root-name
                                exclude-index
                                (if suffix (inc suffix) 2))
      candidate)))

(defun mask-name-exists? [masks name exclude-index]
  (> (count (filter (for-indexed [index mask (or masks [])]
                      {:index index
                       :label (:label mask)})
                    (fn [entry]
                      (and (= (:label entry) name)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-mask-name-from [masks root-name exclude-index suffix]
  (let [candidate (if suffix
                    (str root-name " " suffix)
                    root-name)]
    (if (mask-name-exists? masks candidate exclude-index)
      (unique-mask-name-from masks
                             root-name
                             exclude-index
                             (if suffix (inc suffix) 2))
      candidate)))

(defun unique-ruleset-id [rulesets terrain-set-id]
  (unique-id-from rulesets (str (keyword-label terrain-set-id) "-rules") nil))

(defun unique-rule-id [rules]
  (unique-id-from rules "rule" nil))

(defun unique-mask-set-id [mask-sets]
  (unique-id-from mask-sets "mask-set" nil))

(defun unique-mask-id [masks]
  (unique-id-from masks "mask" nil))

(defun mask-set-size [mask-set]
  (data/map-tile-dim (or (:mask-size mask-set)
                         (:size mask-set)
                         data/tile-dim)))

(defun make-mask-set [mask-sets]
  {:id (unique-mask-set-id mask-sets)
   :label "Mask set"
   :mask-size data/tile-dim
   :masks []})

(defun make-mask [masks]
  {:id (unique-mask-id masks)
   :label "Mask"
   :source {:type :tile-composition
            :tileset nil
            :tiles []}})

(defun mask-set-from-input [mask-sets id label]
  (let [mask-set (make-mask-set mask-sets)
        requested-id (if (blank? id)
                       (keyword-label (:id mask-set))
                       id)
        requested-label (if (blank? label)
                          (:label mask-set)
                          label)]
    (assoc mask-set
           :id (id-from-input mask-sets requested-id nil)
           :label requested-label)))

(defun add-mask-set [state]
  (let [mask-sets (or (:mask-sets state) [])
        mask-set (make-mask-set mask-sets)
        index (count mask-sets)]
    (assoc state
           :mask-sets (concat mask-sets [mask-set])
           :selected-mask-set-index index
           :selected-mask-index nil)))

(defun add-mask-set-with-id [state id label]
  (let [mask-sets (or (:mask-sets state) [])
        mask-set (mask-set-from-input mask-sets id label)
        index (count mask-sets)]
    (assoc state
           :mask-sets (concat mask-sets [mask-set])
           :selected-mask-set-index index
           :selected-mask-index nil)))

(defun update-mask-set-at [mask-sets index update-fn]
  (for-indexed [mask-set-index mask-set (or mask-sets [])]
    (if (= mask-set-index index)
      (update-fn mask-set)
      mask-set)))

(defun selected-mask-set-path [state]
  (if-let [mask-set-index (selected-mask-set-index (:mask-sets state)
                                                   (:selected-mask-set-index state))]
    [:mask-sets mask-set-index]
    nil))

(defun set-selected-mask-set-label [state label]
  (if-let [path (selected-mask-set-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun replace-mask-set-reference [value old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-mask-set-reference item old-id new-id)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (replace-mask-set-reference
                               (if (and (= key :mask-set)
                                        (= item old-id))
                                 new-id
                                 item)
                               old-id
                               new-id))))
    :default value))

(defun replace-terrain-transition-mask-set-reference [terrain-sets old-id new-id]
  (map (or terrain-sets [])
       (fn [terrain-set]
         (assoc terrain-set
                :terrains
                (map (or (:terrains terrain-set) [])
                     (fn [terrain]
                       (if (= (:transition-mask-set terrain) old-id)
                         (assoc terrain :transition-mask-set new-id)
                         terrain)))))))

(defun set-selected-mask-set-id [state value]
  (if-let [mask-set-index (selected-mask-set-index (:mask-sets state)
                                                   (:selected-mask-set-index state))]
    (let [mask-sets (or (:mask-sets state) [])
          old-id (get-in state [:mask-sets mask-set-index :id])]
      (if-let [new-id (id-from-input mask-sets value mask-set-index)]
        (let [state (assoc-in state
                              [:mask-sets mask-set-index :id]
                              new-id)]
          (if (= old-id new-id)
            state
            (assoc state
                   :terrain-sets
                   (replace-terrain-transition-mask-set-reference
                    (:terrain-sets state)
                    old-id
                    new-id)
                   :terrain-transitions
                   (map (or (:terrain-transitions state) [])
                        (fn [transition]
                          (if (= (:mask-set transition) old-id)
                            (assoc transition :mask-set new-id)
                            transition)))
                   :rulesets
                   (replace-mask-set-reference (:rulesets state)
                                               old-id
                                               new-id))))
        state))
    state))

(defun selected-mask-set-size [state]
  (mask-set-size (selected-mask-set (:mask-sets state)
                                    (:selected-mask-set-index state))))

(defun set-selected-mask-set-size [state axis value]
  (if-let [path (selected-mask-set-path state)]
    (if (contains? [:w :h] axis)
      (let [current-size (selected-mask-set-size state)
            default-value (get current-size axis)
            next-value (data/bounded-dimension value default-value)]
        (assoc-in state
                  (concat path [:mask-size axis])
                  next-value))
      state)
    state))

(defun delete-selected-mask-set [state]
  (if-let [mask-set-index (selected-mask-set-index (:mask-sets state)
                                                   (:selected-mask-set-index state))]
    (let [mask-sets (or (:mask-sets state) [])
          mask-set (nth mask-sets mask-set-index)
          mask-set-id (:id mask-set)
          next-mask-sets (remove-item-at-index mask-sets mask-set-index)
          next-mask-set-index (selected-index-after-delete
                               (:selected-mask-set-index state)
                               mask-set-index
                               (count next-mask-sets))]
      (assoc state
             :mask-sets next-mask-sets
             :terrain-sets
             (replace-terrain-transition-mask-set-reference
              (:terrain-sets state)
              mask-set-id
              nil)
             :terrain-transitions
             (map (or (:terrain-transitions state) [])
                  (fn [transition]
                    (if (= (:mask-set transition) mask-set-id)
                      (assoc transition :mask-set nil)
                      transition)))
             :rulesets
             (replace-mask-set-reference (:rulesets state)
                                         mask-set-id
                                         nil)
             :selected-mask-set-index next-mask-set-index
             :selected-mask-index nil))
    state))

(defun selected-mask-path [state]
  (if-let [mask-set-index (selected-mask-set-index (:mask-sets state)
                                                   (:selected-mask-set-index state))]
    (let [mask-set (nth (:mask-sets state) mask-set-index)]
      (if-let [mask-index (selected-mask-index
                           mask-set
                           (:selected-mask-index state))]
        [:mask-sets mask-set-index :masks mask-index]
        nil))
    nil))

(defun mask-from-input [masks id label]
  (let [mask (make-mask masks)
        requested-id (if (blank? id)
                       (keyword-label (:id mask))
                       id)
        requested-label (if (blank? label)
                          (:label mask)
                          label)]
    (assoc mask
           :id (id-from-input masks requested-id nil)
           :label requested-label)))

(defun duplicate-mask-name [masks mask]
  (unique-mask-name-from masks
                         (str (mask-label mask) " Copy")
                         nil
                         nil))

(defun duplicate-mask-with-id [masks mask id label]
  (let [requested-label (if (blank? label)
                          (duplicate-mask-name masks mask)
                          label)
        requested-id (if (blank? id)
                       (kebab-case requested-label)
                       id)]
    (assoc (assoc mask
                  :id (id-from-input masks requested-id nil))
           :label requested-label)))

(defun insert-mask-after [masks mask-index duplicate]
  (apply concat
         (for-indexed [index mask (or masks [])]
           (if (= index mask-index)
             [mask duplicate]
             [mask]))))

(defun duplicate-selected-mask-with-id [state id label]
  (if-let [mask-set-index (selected-mask-set-index
                           (:mask-sets state)
                           (:selected-mask-set-index state))]
    (let [mask-set (nth (:mask-sets state) mask-set-index)
          mask-index (selected-mask-index mask-set
                                          (:selected-mask-index state))
          masks (or (:masks mask-set) [])
          mask (when (not (nil? mask-index))
                 (nth masks mask-index))
          duplicate (when mask
                      (duplicate-mask-with-id masks mask id label))]
      (if duplicate
        (assoc (assoc-in state
                         [:mask-sets mask-set-index :masks]
                         (insert-mask-after masks mask-index duplicate))
               :selected-mask-index (inc mask-index))
        state))
    state))

(defun add-mask [state]
  (if-let [path (selected-mask-set-path state)]
    (let [masks (or (get-in state (concat path [:masks])) [])
          mask (make-mask masks)
          index (count masks)]
      (assoc (assoc-in state
                       (concat path [:masks])
                       (concat masks [mask]))
             :selected-mask-index index))
    state))

(defun add-mask-with-id [state id label]
  (if-let [path (selected-mask-set-path state)]
    (let [masks (or (get-in state (concat path [:masks])) [])
          mask (mask-from-input masks id label)
          index (count masks)]
      (assoc (assoc-in state
                       (concat path [:masks])
                       (concat masks [mask]))
             :selected-mask-index index))
    state))

(defun set-selected-mask-label [state label]
  (if-let [path (selected-mask-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun set-selected-mask-id [state value]
  (if-let [mask-set-index (selected-mask-set-index
                           (:mask-sets state)
                           (:selected-mask-set-index state))]
    (let [mask-set (nth (:mask-sets state) mask-set-index)
          mask-index (selected-mask-index mask-set
                                          (:selected-mask-index state))]
      (if (nil? mask-index)
        state
        (if-let [id (id-from-input (:masks mask-set) value mask-index)]
          (assoc-in state
                    [:mask-sets mask-set-index :masks mask-index :id]
                    id)
          state)))
    state))

(defun selected-mask-source-path [state]
  (if-let [path (selected-mask-path state)]
    (concat path [:source])
    nil))

(defun default-tile-composition-mask-source []
  {:type :tile-composition
   :tileset nil
   :tiles []})

(defun set-selected-mask-source-type [state source-type]
  (if-let [path (selected-mask-source-path state)]
    (case source-type
      :tile-composition
      (assoc-in state path (default-tile-composition-mask-source))

      :default
      state)
    state))

(defun ensure-selected-mask-tile-source [state]
  (if-let [path (selected-mask-source-path state)]
    (let [source (get-in state path)]
      (if (= (:type source) :tile-composition)
        state
        (assoc-in state path (default-tile-composition-mask-source))))
    state))

(defun selected-mask-source-tileset [state]
  (let [mask-set (selected-mask-set (:mask-sets state)
                                    (:selected-mask-set-index state))
        mask (selected-mask mask-set (:selected-mask-index state))
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))]
    (or (-> mask :source :tileset)
        (:tileset terrain-set)
        (:id (head (or (:tilesets state) []))))))

(defun set-selected-mask-source-tileset [state tileset-id]
  (if-let [path (selected-mask-source-path state)]
    (assoc-in (ensure-selected-mask-tile-source state)
              (concat path [:tileset])
              tileset-id)
    state))

(defun selected-mask-tile-items [state]
  (let [mask-set (selected-mask-set (:mask-sets state)
                                    (:selected-mask-set-index state))
        mask (selected-mask mask-set (:selected-mask-index state))]
    (or (-> mask :source :tiles) [])))

(defun make-mask-tile-item [tile-ref]
  {:tile tile-ref
   :offset {:x 0 :y 0}})

(defun add-selected-mask-tile [state tile-ref]
  (if-let [path (selected-mask-path state)]
    (let [state (ensure-selected-mask-tile-source state)
          tiles (or (get-in state (concat path [:source :tiles])) [])]
      (assoc-in state
                (concat path [:source :tiles])
                (concat tiles [(make-mask-tile-item tile-ref)])))
    state))

(defun set-selected-mask-tile-item-offset [state item-index axis value]
  (if-let [path (selected-mask-path state)]
    (let [items (selected-mask-tile-items state)]
      (if (and (not (nil? item-index))
               (>= item-index 0)
               (< item-index (count items))
               (contains? [:x :y] axis))
        (assoc-in (ensure-selected-mask-tile-source state)
                  (concat path [:source :tiles item-index :offset axis])
                  (or value 0))
        state))
    state))

(defun set-selected-mask-tile-item-tile [state tile-ref]
  (if-let [path (selected-mask-path state)]
    (let [items (selected-mask-tile-items state)
          item-index (:selected-mask-tile-item-index state)]
      (if (and (not (nil? tile-ref))
               (not (nil? item-index))
               (>= item-index 0)
               (< item-index (count items)))
        (assoc-in (ensure-selected-mask-tile-source state)
                  (concat path [:source :tiles item-index :tile])
                  tile-ref)
        state))
    state))

(defun delete-selected-mask-tile-item [state item-index]
  (if-let [path (selected-mask-path state)]
    (let [items (selected-mask-tile-items state)]
      (if (and (not (nil? item-index))
               (>= item-index 0)
               (< item-index (count items)))
        (assoc-in state
                  (concat path [:source :tiles])
                  (remove-item-at-index items item-index))
        state))
    state))

(defun delete-selected-mask [state]
  (if-let [mask-set-index (selected-mask-set-index
                           (:mask-sets state)
                           (:selected-mask-set-index state))]
    (let [mask-set (nth (:mask-sets state) mask-set-index)
          mask-index (selected-mask-index mask-set
                                          (:selected-mask-index state))]
      (if (nil? mask-index)
        state
        (let [masks (or (:masks mask-set) [])
              next-masks (remove-item-at-index masks mask-index)
              next-mask-index (selected-index-after-delete
                               (:selected-mask-index state)
                               mask-index
                               (count next-masks))]
          (assoc (assoc-in state
                           [:mask-sets mask-set-index :masks]
                           next-masks)
                 :selected-mask-index next-mask-index))))
    state))

(defun make-terrain-set [terrain-sets tilesets]
  (let [id (unique-terrain-set-id terrain-sets)]
    (merge {:id id
            :label "Terrain set"
            :terrains []}
           (if-let [tileset (data/tileset-key tilesets 0)]
             {:tileset tileset}
             {}))))

(defun make-terrain [terrain-set tilesets]
  (let [id (unique-terrain-id (:terrains terrain-set))]
    (merge {:id id
            :label "Terrain"}
           (if-let [tile (data/tile-id tilesets (:tileset terrain-set) 0)]
             {:tile tile}
             {}))))

(def terrain-unit-options
  [{:value :unit-1x1
    :label "1 x 1"
    :unit {:w 1 :h 1}}
   {:value :unit-2x2
    :label "2 x 2"
    :unit {:w 2 :h 2}}])

(defun terrain-unit-equals? [a b]
  (let [a (data/terrain-unit a)
        b (data/terrain-unit b)]
    (and (= (:w a) (:w b))
         (= (:h a) (:h b)))))

(defun terrain-unit-option-index [unit]
  (or (find-index terrain-unit-options
                  (fn [option]
                    (terrain-unit-equals? (:unit option) unit)))
      0))

(defun terrain-unit-label [unit]
  (:label (nth terrain-unit-options (terrain-unit-option-index unit))))

(defun terrain-unit-option-by-value [value]
  (head (filter terrain-unit-options
                (fn [option]
                  (= (:value option) value)))))

(defun terrain-unit-option-for-selection [selection]
  (or (terrain-unit-option-by-value selection)
      (nth terrain-unit-options (or selection 0))))

(defun set-selected-terrain-set-unit [state unit-selection]
  (if-let [path (selected-terrain-set-path state)]
    (let [option (terrain-unit-option-for-selection unit-selection)]
      (assoc-in state (concat path [:terrain-unit]) (:unit option)))
    state))

(defun terrain-set-from-input [terrain-sets tilesets id label]
  (let [terrain-set (make-terrain-set terrain-sets tilesets)
        requested-id (if (blank? id)
                       (keyword-label (:id terrain-set))
                       id)
        requested-label (if (blank? label)
                          (:label terrain-set)
                          label)]
    (assoc terrain-set
           :id (id-from-input terrain-sets requested-id nil)
           :label requested-label)))

(defun add-terrain-set [state]
  (let [terrain-sets (or (:terrain-sets state) [])
        terrain-set (make-terrain-set terrain-sets (:tilesets state))
        index (count terrain-sets)]
    (assoc state
           :terrain-sets (concat terrain-sets [terrain-set])
           :selected-terrain-set-index index
           :selected-terrain-index nil)))

(defun add-terrain-set-with-id [state id label]
  (let [terrain-sets (or (:terrain-sets state) [])
        terrain-set (terrain-set-from-input terrain-sets
                                            (:tilesets state)
                                            id
                                            label)
        index (count terrain-sets)]
    (assoc state
           :terrain-sets (concat terrain-sets [terrain-set])
           :selected-terrain-set-index index
           :selected-terrain-index nil)))

(defun update-terrain-set-at [terrain-sets index update-fn]
  (for-indexed [terrain-set-index terrain-set (or terrain-sets [])]
    (if (= terrain-set-index index)
      (update-fn terrain-set)
      terrain-set)))

(defun terrain-from-input [terrain-set tilesets id label]
  (let [terrain (make-terrain terrain-set tilesets)
        requested-id (if (blank? id)
                       (keyword-label (:id terrain))
                       id)
        requested-label (if (blank? label)
                          (:label terrain)
                          label)]
    (assoc terrain
           :id (id-from-input (:terrains terrain-set) requested-id nil)
           :label requested-label)))

(defun add-terrain [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrains (or (:terrains terrain-set) [])
          terrain (make-terrain terrain-set (:tilesets state))
          terrain-index (count terrains)]
      (assoc state
             :terrain-sets (update-terrain-set-at
                            (:terrain-sets state)
                            set-index
                            (fn [terrain-set]
                              (assoc terrain-set
                                     :terrains (concat terrains [terrain]))))
             :selected-terrain-set-index set-index
             :selected-terrain-index terrain-index))
    state))

(defun add-terrain-with-id [state id label]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrains (or (:terrains terrain-set) [])
          terrain (terrain-from-input terrain-set (:tilesets state) id label)
          terrain-index (count terrains)]
      (assoc state
             :terrain-sets (update-terrain-set-at
                            (:terrain-sets state)
                            set-index
                            (fn [terrain-set]
                              (assoc terrain-set
                                     :terrains (concat terrains [terrain]))))
             :selected-terrain-set-index set-index
             :selected-terrain-index terrain-index))
    state))

(defun terrain-label [terrain]
  (or (:label terrain)
      (:name terrain)
      (keyword-label (:id terrain))
      "Terrain"))

(defun terrain-set-label [terrain-set]
  (or (:label terrain-set)
      (:name terrain-set)
      (keyword-label (:id terrain-set))
      "Terrain Set"))

(defun duplicate-terrain-name [terrains terrain]
  (unique-terrain-name-from terrains
                            (str (terrain-label terrain) " Copy")
                            nil
                            nil))

(defun duplicate-terrain-with-id [terrains terrain name id]
  (let [requested-name (if (blank? name)
                         (duplicate-terrain-name terrains terrain)
                         name)
        label (unique-terrain-name-from terrains
                                        requested-name
                                        nil
                                        nil)
        requested-id (if (blank? id)
                       (kebab-case label)
                       id)]
    (assoc (assoc terrain
                  :id (id-from-input terrains requested-id nil))
           :label label)))

(defun duplicate-terrain [terrains terrain name]
  (duplicate-terrain-with-id terrains terrain name nil))

(defun insert-terrain-after [terrains terrain-index duplicate]
  (apply concat
         (for-indexed [index terrain (or terrains [])]
           (if (= index terrain-index)
             [terrain duplicate]
             [terrain]))))

(defun duplicate-selected-terrain [state name]
  (duplicate-selected-terrain-with-id state name nil))

(defun duplicate-selected-terrain-with-id [state name id]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrain-index (selected-terrain-index terrain-set
                                                (:selected-terrain-index state))
          terrains (or (:terrains terrain-set) [])
          terrain (when (not (nil? terrain-index))
                    (nth terrains terrain-index))
          duplicate (when terrain
                      (duplicate-terrain-with-id terrains terrain name id))]
      (if duplicate
        (assoc state
               :terrain-sets (update-terrain-set-at
                              (:terrain-sets state)
                              set-index
                              (fn [terrain-set]
                                (assoc terrain-set
                                       :terrains (insert-terrain-after
                                                  terrains
                                                  terrain-index
                                                  duplicate))))
               :rulesets (duplicate-terrain-rulesets
                          (:rulesets state)
                          (:id terrain-set)
                          (:id terrain)
                          (:id duplicate))
               :selected-terrain-set-index set-index
               :selected-terrain-index (inc terrain-index)
               :selected-terrain-rule-id nil)
        state))
    state))

(defun terrain-label-by-index [state terrain-index]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (when (and terrain-set
                           (not (nil? terrain-index))
                           (< terrain-index (count (or (:terrains terrain-set) []))))
                  (nth (:terrains terrain-set) terrain-index))]
    (terrain-label terrain)))

(defun terrain-set-label-by-index [state terrain-set-index]
  (let [terrain-set (when (and (not (nil? terrain-set-index))
                               (< terrain-set-index
                                  (count (or (:terrain-sets state) []))))
                      (nth (:terrain-sets state) terrain-set-index))]
    (terrain-set-label terrain-set)))

(defun selected-terrain-set-path [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    [:terrain-sets set-index]
    nil))

(defun selected-terrain-path [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)]
      (if-let [terrain-index (selected-terrain-index terrain-set
                                                     (:selected-terrain-index state))]
        [:terrain-sets set-index :terrains terrain-index]
        nil))
    nil))

(defun selected-terrain-transition-mask-set [state]
  (if-let [path (selected-terrain-path state)]
    (get-in state (concat path [:transition-mask-set]))
    nil))

(defun selected-terrain-transition-mask-set-option-index [state]
  (or (option-index-by-value
       (terrain-transition-mask-set-options (:mask-sets state))
       (or (selected-terrain-transition-mask-set state) :none))
      0))

(defun set-selected-terrain-transition-mask-set [state mask-set-id]
  (if-let [path (selected-terrain-path state)]
    (let [mask-set-id (if (= mask-set-id :none) nil mask-set-id)]
      (assoc-in state (concat path [:transition-mask-set]) mask-set-id))
    state))

(defun terrain-mask-options-for-selected-terrain [state]
  (let [mask-set-id (selected-terrain-transition-mask-set state)
        mask-set (mask-set-by-id (:mask-sets state) mask-set-id)]
    (if mask-set
      (mask-options-for-ref mask-set)
      (terrain-mask-options (:mask-sets state)))))

(defun set-selected-terrain-set-label [state label]
  (if-let [path (selected-terrain-set-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun set-selected-terrain-label [state label]
  (if-let [path (selected-terrain-path state)]
    (assoc-in state (concat path [:label]) label)
    state))

(defun replace-terrain-set-reference [value old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-set-reference item old-id new-id)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (replace-terrain-set-reference
                               (if (and (= key :terrain-set)
                                        (= item old-id))
                                 new-id
                                 item)
                               old-id
                               new-id))))
    :default value))

(defun rename-terrain-set-references [state old-id new-id]
  (maps/update-all-map-layers
   (assoc state
          :layer-profiles (replace-terrain-set-reference (:layer-profiles state)
                                                         old-id
                                                         new-id)
          :brushes (replace-terrain-set-reference (:brushes state) old-id new-id)
          :rulesets (replace-terrain-set-reference (:rulesets state)
                                                   old-id
                                                   new-id))
   (fn [layers]
     (replace-terrain-set-reference layers old-id new-id))))

(defun set-selected-terrain-set-id [state value]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-sets (or (:terrain-sets state) [])
          old-id (get-in state [:terrain-sets set-index :id])]
      (if-let [new-id (id-from-input terrain-sets value set-index)]
        (let [next-state (assoc-in state [:terrain-sets set-index :id] new-id)]
          (rename-terrain-set-references next-state old-id new-id))
        state))
    state))

(defun replace-terrain-ref [value old-id new-id]
  (if (= value old-id) new-id value))

(defun replace-terrain-refs-in-tiles [tiles old-id new-id]
  (map (or tiles [])
       (fn [row]
         (map (or row [])
              (fn [cell]
                (replace-terrain-ref cell old-id new-id))))))

(defun replace-terrain-refs-in-layer [layer terrain-set old-id new-id]
  (if (and (= (:data-kind layer) :terrain)
           (= (:terrain-set layer) terrain-set))
    (assoc layer :tiles (replace-terrain-refs-in-tiles (:tiles layer)
                                                       old-id
                                                       new-id))
    layer))

(defun replace-terrain-refs-in-layers [layers terrain-set old-id new-id]
  (map (or layers [])
       (fn [layer]
         (replace-terrain-refs-in-layer layer terrain-set old-id new-id))))

(defun replace-terrain-refs-in-brush-value [value terrain-set old-id new-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-refs-in-brush-value item
                                                         terrain-set
                                                         old-id
                                                         new-id)))
    "map" (let [value (if (and (= (:data-kind value) :terrain)
                               (= (:terrain-set value) terrain-set)
                               (:tiles value))
                        (assoc value :tiles (replace-terrain-refs-in-tiles
                                             (:tiles value)
                                             old-id
                                             new-id))
                        value)]
            (reduce-kv value
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (replace-terrain-refs-in-brush-value item
                                                                     terrain-set
                                                                     old-id
                                                                     new-id)))))
    :default value))

(defun terrain-source-layer-id? [layer terrain-set]
  (and (= (:data-kind layer) :terrain)
       (= (:terrain-set layer) terrain-set)
       (:id layer)))

(defun terrain-source-layer-ids-in [layers terrain-set]
  (map (filter (or layers [])
               (fn [layer]
                 (terrain-source-layer-id? layer terrain-set)))
       :id))

(defun terrain-source-layer-ids [state terrain-set]
  (concat (terrain-source-layer-ids-in (:layers state) terrain-set)
          (apply concat
                 (map (or (:maps state) [])
                      (fn [map-document]
                        (terrain-source-layer-ids-in (:layers map-document)
                                                     terrain-set))))
          (apply concat
                 (map (or (:layer-profiles state) [])
                      (fn [profile]
                        (terrain-source-layer-ids-in (:layers profile)
                                                     terrain-set))))))

(defun ruleset-source-layer-matches? [ruleset source-layer-ids]
  (or (contains? source-layer-ids (:source-layer ruleset))
      (> (count (filter (or (:source-layers ruleset) [])
                        (fn [source-layer]
                          (contains? source-layer-ids source-layer))))
         0)))

(defun replace-terrain-rule-reference* [value old-id new-id signature?]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (replace-terrain-rule-reference*
                     item
                     old-id
                     new-id
                     signature?)))
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (let [next-signature? (or signature?
                                                 (= key :terrain-signature)
                                                 (= key :terrain-signatures))
                             item (if (or signature? (= key :terrain))
                                    (replace-terrain-ref item old-id new-id)
                                    item)]
                         (assoc result
                                key
                                (replace-terrain-rule-reference*
                                 item
                                 old-id
                                 new-id
                                 next-signature?)))))
    :default (if signature?
               (replace-terrain-ref value old-id new-id)
               value)))

(defun replace-terrain-rule-reference [value old-id new-id]
  (replace-terrain-rule-reference* value old-id new-id false))

(defun duplicate-terrain-rule [rules rule old-id new-id]
  (let [duplicate (replace-terrain-rule-reference rule old-id new-id)]
    (assoc (assoc duplicate
                  :id (unique-id-from rules
                                      (str (keyword-label (:id rule)) "-copy")
                                      nil))
           :label (duplicate-rule-label rule))))

(defun duplicate-rules-for-terrain [rules old-id new-id]
  (reduce (or rules [])
          []
          (fn [result rule]
            (let [result-with-rule (concat result [rule])]
              (if (= (terrain-rule-center rule) old-id)
                (concat result-with-rule
                        [(duplicate-terrain-rule
                          (concat result-with-rule (or rules []))
                          rule
                          old-id
                          new-id)])
                result-with-rule)))))

(defun duplicate-terrain-rulesets [rulesets terrain-set-id old-id new-id]
  (map (or rulesets [])
       (fn [ruleset]
         (if (= (:terrain-set ruleset) terrain-set-id)
           (assoc ruleset
                  :rules (duplicate-rules-for-terrain
                          (:rules ruleset)
                          old-id
                          new-id))
           ruleset))))

(defun replace-terrain-refs-in-rulesets [rulesets terrain-set source-layer-ids old-id new-id]
  (map (or rulesets [])
       (fn [ruleset]
         (if (or (= (:terrain-set ruleset) terrain-set)
                 (ruleset-source-layer-matches? ruleset source-layer-ids))
           (replace-terrain-rule-reference ruleset old-id new-id)
           ruleset))))

(defun rename-terrain-references [state terrain-set old-id new-id]
  (let [source-layer-ids (terrain-source-layer-ids state terrain-set)]
    (maps/update-all-map-layers
     (assoc state
            :layer-profiles (map (or (:layer-profiles state) [])
                                 (fn [profile]
                                   (assoc profile
                                          :layers
                                          (replace-terrain-refs-in-layers
                                           (:layers profile)
                                           terrain-set
                                           old-id
                                           new-id))))
            :brushes (replace-terrain-refs-in-brush-value (:brushes state)
                                                          terrain-set
                                                          old-id
                                                          new-id)
            :rulesets (replace-terrain-refs-in-rulesets (:rulesets state)
                                                        terrain-set
                                                        source-layer-ids
                                                        old-id
                                                        new-id))
     (fn [layers]
       (replace-terrain-refs-in-layers layers
                                       terrain-set
                                       old-id
                                       new-id)))))

(defun set-selected-terrain-id [state value]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)]
      (if-let [terrain-index (selected-terrain-index
                              terrain-set
                              (:selected-terrain-index state))]
        (let [terrains (or (:terrains terrain-set) [])
              old-id (get-in state [:terrain-sets set-index :terrains terrain-index :id])
              terrain-set-id (:id terrain-set)]
          (if-let [new-id (id-from-input terrains value terrain-index)]
            (let [next-state (assoc-in state
                                       [:terrain-sets set-index :terrains terrain-index :id]
                                       new-id)]
              (rename-terrain-references next-state terrain-set-id old-id new-id))
            state))
        state))
    state))

(defun terrain-tile-valid? [tilesets tileset tile]
  (and tile
       (= tile (data/tile-id tilesets tileset tile))))

(defun first-tile-for [tilesets tileset]
  (data/tile-id tilesets tileset 0))

(defun set-selected-terrain-set-tileset [state tileset-index]
  (if-let [set-path (selected-terrain-set-path state)]
    (let [tileset (data/tileset-key (:tilesets state) tileset-index)
          state (assoc-in state (concat set-path [:tileset]) tileset)]
      (if-let [terrain-path (selected-terrain-path state)]
        (let [tile (get-in state (concat terrain-path [:tile]))]
          (if (terrain-tile-valid? (:tilesets state) tileset tile)
            state
            (assoc-in state (concat terrain-path [:tile])
                      (first-tile-for (:tilesets state) tileset))))
        state))
    state))

(defun set-selected-terrain-tile [state tile]
  (if-let [path (selected-terrain-path state)]
    (assoc-in state (concat path [:tile]) tile)
    state))

(def neighbor-directions [:nw :n :ne :w :e :sw :s :se])
(def terrain-signature-directions [:nw :n :ne :w :center :e :sw :s :se])

(def default-rule-match
  {:nw :ignore
   :n :ignore
   :ne :ignore
   :w :ignore
   :e :ignore
   :sw :ignore
   :s :ignore
   :se :ignore})

(defun output-grid-position [x y]
  {:x (max 0 (min 2 (or x 1)))
   :y (max 0 (min 2 (or y 1)))})

(defun selected-rule-output-position [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        anchor (or (-> (selected-terrain-rule state) :output :anchor)
                   (terrain-unit-output-anchor terrain-set))]
    (output-grid-position (:x anchor) (:y anchor))))

(defun selected-terrain-unit [state]
  (data/terrain-unit (selected-terrain-set (:terrain-sets state)
                                           (:selected-terrain-set-index state))))

(defun selected-rule-stamp-cell-editable? [state x y]
  (let [unit (selected-terrain-unit state)
        anchor (or (-> (selected-terrain-rule state) :output :anchor)
                   (terrain-unit-output-anchor
                    (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))))]
    (and (>= x (:x anchor))
         (< x (+ (:x anchor) (:w unit)))
         (>= y (:y anchor))
         (< y (+ (:y anchor) (:h unit))))))

(defun empty-terrain-signature-row []
  [nil nil nil])

(defun empty-terrain-signature-grid []
  [(empty-terrain-signature-row)
   (empty-terrain-signature-row)
   (empty-terrain-signature-row)])

(defun output-layer-terrain-signatures [output-layer]
  (or (:terrain-signatures output-layer)
      (empty-terrain-signature-grid)))

(defun solid-terrain-signature [terrain-id]
  (reduce terrain-signature-directions
          {}
          (fn [result direction]
            (assoc result direction terrain-id))))

(defun match-condition-signature-value [center-terrain-id condition]
  (case condition
    :same center-terrain-id
    :none :none
    :default
    (if (= (type-of condition) "map")
      (if (contains? condition :terrain-in)
        nil
        (:terrain condition))
      nil)))

(defun default-terrain-signature-for-rule [rule]
  (let [center-terrain-id (terrain-rule-center rule)]
    (reduce-kv (or (:match rule) {})
               (solid-terrain-signature center-terrain-id)
               (fn [signature direction condition]
                 (if-let [value (match-condition-signature-value
                                  center-terrain-id
                                  condition)]
                   (assoc signature direction value)
                   (if (or (= condition :not-same)
                           (= condition :other-terrain)
                           (= condition :any-terrain)
                           (and (= (type-of condition) "map")
                                (contains? condition :terrain-in)))
                     (dissoc signature direction)
                     signature))))))

(defun output-layer-terrain-signature-at [output-layer x y]
  (nth (or (nth (output-layer-terrain-signatures output-layer) y) []) x))

(defun output-layer-transition-masks [output-layer]
  (or (:transition-masks output-layer)
      (empty-terrain-signature-grid)))

(defun rule-output-terrain-signature-at [rule x y]
  (or (output-layer-terrain-signature-at (head (or (-> rule :output :layers)
                                                   []))
                                         x
                                         y)
      (default-terrain-signature-for-rule rule)))

(defun selected-rule-output-terrain-signature [state]
  (let [rule (selected-terrain-rule state)
        pos (selected-rule-output-position state)]
    (if rule
      (rule-output-terrain-signature-at rule (:x pos) (:y pos))
      {})))

(defun selected-terrain-set-id [state]
  (:id (selected-terrain-set (:terrain-sets state)
                             (:selected-terrain-set-index state))))

(defun selected-terrain-id [state]
  (:id (selected-terrain
        (selected-terrain-set (:terrain-sets state)
                              (:selected-terrain-set-index state))
        (:selected-terrain-index state))))

(defun active-layer-profile [state]
  (let [profiles (if (empty? (or (:layers state) []))
                   (:layer-profiles state)
                   (data/sync-layer-profiles (:layer-profiles state)
                                             (:selected-layer-profile-id state)
                                             (:layers state)))]
    (data/layer-profile-by-id profiles
                              (:selected-layer-profile-id state))))

(defun profile-layers [state]
  (let [profile (active-layer-profile state)]
    (if profile
      (:layers profile)
      (:layers state))))

(defun profile-layer-by-id [state layer-id]
  (head (filter (profile-layers state)
                (fn [layer]
                  (= (:id layer) layer-id)))))

(defun terrain-source-layer? [layer terrain-set-id]
  (and (= (:data-kind layer) :terrain)
       (= (:terrain-set layer) terrain-set-id)))

(defun terrain-source-layers [state terrain-set-id]
  (filter (profile-layers state)
          (fn [layer]
            (terrain-source-layer? layer terrain-set-id))))

(defun indexed-profile-layers [state]
  (for-indexed [index layer (profile-layers state)]
    {:index index
     :layer layer}))

(defun first-terrain-source-layer-index [state terrain-set-id]
  (:index (head (filter (indexed-profile-layers state)
                        (fn [entry]
                          (terrain-source-layer? (:layer entry)
                                                 terrain-set-id))))))

(defun tile-output-layer? [layer]
  (and (= (:data-kind layer) :tile-ref)
       (:tileset layer)))

(defun terrain-rule-output-layer? [source-index entry]
  (and (tile-output-layer? (:layer entry))
       (or (nil? source-index)
           (> (:index entry) source-index))))

(defun tile-output-layers [state terrain-set-id]
  (let [source-index (first-terrain-source-layer-index state terrain-set-id)]
    (map (filter (indexed-profile-layers state)
                 (fn [entry]
                   (terrain-rule-output-layer? source-index entry)))
         :layer)))

(defun first-source-layer-id [state terrain-set-id]
  (:id (head (terrain-source-layers state terrain-set-id))))

(defun first-output-layer [state terrain-set-id]
  (head (tile-output-layers state terrain-set-id)))

(defun first-output-layer-for-tileset [state terrain-set-id tileset]
  (head (filter (tile-output-layers state terrain-set-id)
                (fn [layer]
                  (= (:tileset layer) tileset)))))

(defun default-output-layer-for-terrain-set [state terrain-set]
  (let [tileset (:tileset terrain-set)]
    (or (when tileset
          (first-output-layer-for-tileset state (:id terrain-set) tileset))
        (when (nil? tileset)
          (first-output-layer state (:id terrain-set))))))

(defun center-stamp-tiles [tile]
  [[tile]])

(defun terrain-unit-stamp-tiles [terrain-set tile]
  (let [unit (data/terrain-unit terrain-set)]
    (if (and (= (:w unit) 1)
             (= (:h unit) 1))
      (center-stamp-tiles tile)
      (dotimes [y (:h unit)]
        (dotimes [x (:w unit)]
          (if (and (= x 0) (= y 0))
            tile
            nil))))))

(defun terrain-unit-output-anchor [terrain-set]
  {:x 0 :y 0})

(defun default-output-stamp-layer [state terrain-set terrain]
  (let [output-layer (default-output-layer-for-terrain-set state terrain-set)
        tileset (or (:tileset terrain-set) (:tileset output-layer))
        tile (or (:tile terrain)
                 (first-tile-for (:tilesets state) tileset))]
    {:id :layer
     :data-kind :tile-ref
     :target-layer (:id output-layer)
     :tileset tileset
     :tiles (terrain-unit-stamp-tiles terrain-set tile)}))

(defun default-rule-output [state terrain-set terrain]
  {:anchor (terrain-unit-output-anchor terrain-set)
   :layers [(default-output-stamp-layer state terrain-set terrain)]})

(defun make-terrain-ruleset [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain-set-id (:id terrain-set)
        id (unique-ruleset-id (:rulesets state) terrain-set-id)]
    {:id id
     :label "Terrain rules"
     :kind :terrain-stamp
     :terrain-set terrain-set-id
     :source-layer (first-source-layer-id state terrain-set-id)
     :rules []}))

(defun make-terrain-rule [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set
                                  (:selected-terrain-index state))
        ruleset (selected-terrain-ruleset state)
        id (unique-rule-id (:rules ruleset))]
    {:id id
     :label "Rule"
     :terrain (:id terrain)
     :match default-rule-match
     :output (default-rule-output state terrain-set terrain)}))

(defun ruleset-for-terrain-set? [ruleset terrain-set-id]
  (= (:terrain-set ruleset) terrain-set-id))

(defun terrain-rulesets [state]
  (let [terrain-set-id (selected-terrain-set-id state)]
    (filter (or (:rulesets state) [])
            (fn [ruleset]
              (ruleset-for-terrain-set? ruleset terrain-set-id)))))

(defun selected-terrain-ruleset-id [state]
  (let [rulesets (terrain-rulesets state)
        requested (:selected-terrain-ruleset-id state)
        match (head (filter rulesets
                            (fn [ruleset]
                              (= (:id ruleset) requested))))]
    (or (:id match)
        (:id (head rulesets)))))

(defun selected-terrain-ruleset [state]
  (let [selected-id (selected-terrain-ruleset-id state)]
    (head (filter (or (:rulesets state) [])
                  (fn [ruleset]
                    (= (:id ruleset) selected-id))))))

(defun terrain-ruleset-options [state]
  (for-indexed [index ruleset (terrain-rulesets state)]
    {:value (:id ruleset)
     :label (or (:label ruleset) (str (:id ruleset)))}))

(defun selected-terrain-ruleset-index [state]
  (let [selected-id (selected-terrain-ruleset-id state)]
    (find-index (terrain-rulesets state)
                (fn [ruleset]
                  (= (:id ruleset) selected-id)))))

(defun terrain-rule-center [rule]
  (or (:terrain rule)
      (-> rule :match :center :terrain)))

(defun terrain-rules-for-selected-terrain [state]
  (let [terrain-id (selected-terrain-id state)]
    (filter (or (:rules (selected-terrain-ruleset state)) [])
            (fn [rule]
              (= (terrain-rule-center rule) terrain-id)))))

(defun selected-terrain-rule-id [state]
  (let [ruleset (selected-terrain-ruleset state)
        rules (terrain-rules-for-selected-terrain state)
        requested (:selected-terrain-rule-id state)
        match (head (filter rules
                            (fn [rule]
                              (= (:id rule) requested))))]
    (or (:id match)
        (:id (head rules)))))

(defun selected-terrain-rule [state]
  (let [rule-id (selected-terrain-rule-id state)]
    (head (filter (terrain-rules-for-selected-terrain state)
                  (fn [rule]
                    (= (:id rule) rule-id))))))

(defun selected-rule-stamp-layer [state]
  (head (or (-> (selected-terrain-rule state) :output :layers) [])))

(defun selected-rule-stamp-tileset [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))]
    (or (:tileset (selected-rule-stamp-layer state))
        (:tileset terrain-set)
        (:tileset (default-output-layer-for-terrain-set state terrain-set)))))

(defun selected-rule-output-tileset-index [state]
  (data/tileset-index (:tilesets state)
                      (selected-rule-stamp-tileset state)))

(def target-layer-none-value :none)

(defun selected-rule-output-target-layer [state]
  (:target-layer (selected-rule-stamp-layer state)))

(defun terrain-rule-output-target-layer-option [layer]
  {:value (:id layer)
   :label (str (or (:label layer) (keyword-label (:id layer)))
               " ("
               (keyword-label (:tileset layer))
               ")")})

(defun terrain-rule-output-target-layer-options [state]
  (concat [{:value target-layer-none-value
            :label "No target layer"}]
          (map (tile-output-layers state (selected-terrain-set-id state))
               terrain-rule-output-target-layer-option)))

(defun selected-rule-output-target-layer-index [state]
  (let [value (or (selected-rule-output-target-layer state)
                  target-layer-none-value)
        index (find-index (terrain-rule-output-target-layer-options state)
                          (fn [option]
                            (= (:value option) value)))]
    (or index 0)))

(defun first-rule-stamp-tile [state]
  (data/tile-id (:tilesets state)
                (selected-rule-stamp-tileset state)
                0))

(defun rule-stamp-tile-exists? [state tile-ref]
  (not (nil? (head (filter (data/tile-options
                            (:tilesets state)
                            (selected-rule-stamp-tileset state))
                           (fn [option]
                             (= (:value option) tile-ref)))))))

(defun selected-rule-stamp-tile [state]
  (let [requested (:terrain-rule-selected-tile state)]
    (if (nil? requested)
      nil
      (or (when (rule-stamp-tile-exists? state requested)
            requested)
          (first-rule-stamp-tile state)))))

(defun selected-rule-stamp-tile-indices [state]
  (let [tile-ref (selected-rule-stamp-tile state)
        tileset (selected-rule-stamp-tileset state)]
    (if (and tile-ref tileset)
      [(data/tile-index (:tilesets state) tileset tile-ref)]
      [])))

(defun terrain-rule-options [state]
  (for-indexed [index rule (terrain-rules-for-selected-terrain state)]
    {:value (:id rule)
     :label (or (:label rule) (str (:id rule)))}))

(defun selected-terrain-rule-index [state]
  (let [rule-id (selected-terrain-rule-id state)]
    (find-index (terrain-rules-for-selected-terrain state)
                (fn [rule]
                  (= (:id rule) rule-id)))))

(defun add-terrain-ruleset [state]
  (if (selected-terrain-set-id state)
    (let [ruleset (make-terrain-ruleset state)]
      (assoc state
             :rulesets (concat (or (:rulesets state) []) [ruleset])
             :selected-terrain-ruleset-id (:id ruleset)
             :selected-terrain-rule-id nil))
    state))

(defun update-ruleset [rulesets ruleset-id update-fn]
  (map (or rulesets [])
       (fn [ruleset]
         (if (= (:id ruleset) ruleset-id)
           (update-fn ruleset)
           ruleset))))

(defun update-rule [rules rule-id update-fn]
  (map (or rules [])
       (fn [rule]
         (if (= (:id rule) rule-id)
           (update-fn rule)
           rule))))

(defun rule-index-by-id [rules rule-id]
  (find-index (or rules [])
              (fn [rule]
                (= (:id rule) rule-id))))

(defun rule-by-id [rules rule-id]
  (head (filter (or rules [])
                (fn [rule]
                  (= (:id rule) rule-id)))))

(defun terrain-rule-label-by-id [state rule-id]
  (or (:label (rule-by-id (or (:rules (selected-terrain-ruleset state)) [])
                          rule-id))
      (str rule-id)))

(defun remove-rule-by-id [rules rule-id]
  (filter (or rules [])
          (fn [rule]
            (not= (:id rule) rule-id))))

(defun remove-item-at-index [items remove-index]
  (map (filter (for-indexed [index item (or items [])]
                 {:index index
                  :item item})
               (fn [entry]
                 (not= (:index entry) remove-index)))
       :item))

(defun selected-index-after-delete [selected-index remove-index remaining-count]
  (when (> remaining-count 0)
    (let [selected-index (or selected-index remove-index 0)
          remove-index (or remove-index 0)]
      (cond
        (< selected-index remove-index) selected-index
        (> selected-index remove-index) (dec selected-index)
        :default (min remove-index (dec remaining-count))))))

(defun remove-rulesets-for-terrain-set [rulesets terrain-set-id source-layer-ids]
  (filter (or rulesets [])
          (fn [ruleset]
            (and (not= (:terrain-set ruleset) terrain-set-id)
                 (not (ruleset-source-layer-matches? ruleset
                                                     source-layer-ids))))))

(defun clear-terrain-set-reference [value terrain-set-id]
  (case (type-of value)
    "vector" (map value
                  (fn [item]
                    (clear-terrain-set-reference item terrain-set-id)))
    "map" (reduce-kv (if (= (:terrain-set value) terrain-set-id)
                       (assoc value :terrain-set nil)
                       value)
                     {}
                     (fn [result key item]
                       (assoc result
                              key
                              (clear-terrain-set-reference item
                                                           terrain-set-id))))
    :default value))

(defun delete-selected-terrain-set [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-sets (or (:terrain-sets state) [])
          terrain-set (nth terrain-sets set-index)
          terrain-set-id (:id terrain-set)
          source-layer-ids (terrain-source-layer-ids state terrain-set-id)
          next-terrain-sets (remove-item-at-index terrain-sets set-index)
          next-set-index (selected-index-after-delete
                          (:selected-terrain-set-index state)
                          set-index
                          (count next-terrain-sets))
          next-terrain-set (selected-terrain-set next-terrain-sets
                                                 next-set-index)
          next-terrain-index (selected-terrain-index next-terrain-set
                                                     (:selected-terrain-index
                                                      state))]
      (maps/update-all-map-layers
       (assoc state
              :terrain-sets next-terrain-sets
              :layer-profiles (clear-terrain-set-reference
                               (:layer-profiles state)
                               terrain-set-id)
              :brushes (clear-terrain-set-reference (:brushes state)
                                                    terrain-set-id)
              :rulesets (remove-rulesets-for-terrain-set
                         (:rulesets state)
                         terrain-set-id
                         source-layer-ids)
              :selected-terrain-set-index next-set-index
              :selected-terrain-index next-terrain-index
              :selected-terrain-ruleset-id nil
              :selected-terrain-rule-id nil)
       (fn [layers]
         (clear-terrain-set-reference layers terrain-set-id))))
    state))

(defun remove-rules-for-terrain [rules terrain-id]
  (filter (or rules [])
          (fn [rule]
            (not= (terrain-rule-center rule) terrain-id))))

(defun remove-terrain-from-ruleset [ruleset terrain-set-id source-layer-ids terrain-id]
  (if (or (= (:terrain-set ruleset) terrain-set-id)
          (ruleset-source-layer-matches? ruleset source-layer-ids))
    (replace-terrain-rule-reference
     (assoc ruleset :rules (remove-rules-for-terrain (:rules ruleset)
                                                     terrain-id))
     terrain-id
     nil)
    ruleset))

(defun remove-terrain-from-rulesets [rulesets terrain-set-id source-layer-ids terrain-id]
  (map (filter (or rulesets [])
               (fn [ruleset]
                 (not (and (= (:terrain-set ruleset) terrain-set-id)
                           (= (:terrain ruleset) terrain-id)))))
       (fn [ruleset]
         (remove-terrain-from-ruleset ruleset
                                      terrain-set-id
                                      source-layer-ids
                                      terrain-id))))

(defun delete-selected-terrain [state]
  (if-let [set-index (selected-terrain-set-index (:terrain-sets state)
                                                 (:selected-terrain-set-index state))]
    (let [terrain-set (nth (:terrain-sets state) set-index)
          terrain-index (selected-terrain-index terrain-set
                                                (:selected-terrain-index state))
          terrains (or (:terrains terrain-set) [])
          terrain (when (not (nil? terrain-index))
                    (nth terrains terrain-index))]
      (if terrain
        (let [terrain-set-id (:id terrain-set)
              terrain-id (:id terrain)
              source-layer-ids (terrain-source-layer-ids state terrain-set-id)
              next-terrains (remove-item-at-index terrains terrain-index)
              next-terrain-index (selected-index-after-delete
                                  (:selected-terrain-index state)
                                  terrain-index
                                  (count next-terrains))]
          (maps/update-all-map-layers
           (assoc state
                  :terrain-sets (update-terrain-set-at
                                 (:terrain-sets state)
                                 set-index
                                 (fn [terrain-set]
                                   (assoc terrain-set
                                          :terrains next-terrains)))
                  :layer-profiles (map (or (:layer-profiles state) [])
                                       (fn [profile]
                                         (assoc profile
                                                :layers
                                                (replace-terrain-refs-in-layers
                                                 (:layers profile)
                                                 terrain-set-id
                                                 terrain-id
                                                 nil))))
                  :brushes (replace-terrain-refs-in-brush-value
                            (:brushes state)
                            terrain-set-id
                            terrain-id
                            nil)
                  :rulesets (remove-terrain-from-rulesets
                             (:rulesets state)
                             terrain-set-id
                             source-layer-ids
                             terrain-id)
                  :selected-terrain-set-index set-index
                  :selected-terrain-index next-terrain-index
                  :selected-terrain-ruleset-id nil
                  :selected-terrain-rule-id nil)
           (fn [layers]
             (replace-terrain-refs-in-layers layers
                                             terrain-set-id
                                             terrain-id
                                             nil))))
        state))
    state))

(defun insert-item-at-index [items insert-index item]
  (let [items (or items [])]
    (if (>= insert-index (count items))
      (concat items [item])
      (apply concat
             (for-indexed [index existing items]
               (if (= index insert-index)
                 [item existing]
                 [existing]))))))

(defun reorder-items [items from-index to-index]
  (let [items (or items [])]
    (if (and (not (nil? from-index))
             (not (nil? to-index))
             (>= from-index 0)
             (< from-index (count items))
             (>= to-index 0)
             (< to-index (count items)))
      (insert-item-at-index (remove-item-at-index items from-index)
                            to-index
                            (nth items from-index))
      items)))

(defun replace-rules-for-terrain [rules terrain-id replacement-rules]
  (let [state {:remaining (or replacement-rules [])
               :rules []}]
    (:rules (reduce (or rules [])
                    state
                    (fn [state rule]
                      (if (= (terrain-rule-center rule) terrain-id)
                        (let [replacement (head (:remaining state))]
                          (assoc state
                                 :remaining (tail (:remaining state))
                                 :rules (concat (:rules state)
                                                [replacement])))
                        (assoc state
                               :rules (concat (:rules state) [rule]))))))))

(defun duplicate-rule-label [rule]
  (str (or (:label rule)
           (keyword-label (:id rule))
           "Rule")
       " Copy"))

(defun duplicate-rule [rules rule]
  (assoc (assoc rule
                :id (unique-id-from rules
                                    (str (keyword-label (:id rule)) "-copy")
                                    nil))
         :label (duplicate-rule-label rule)))

(defun insert-rule-after [rules rule-id duplicate]
  (apply concat
         (map (or rules [])
              (fn [rule]
                (if (= (:id rule) rule-id)
                  [rule duplicate]
                  [rule])))))

(defun swap-rules-by-id [rules a-id b-id]
  (let [a-index (rule-index-by-id rules a-id)
        b-index (rule-index-by-id rules b-id)]
    (if (and (not (nil? a-index))
             (not (nil? b-index)))
      (for-indexed [index rule (or rules [])]
        (cond
          (= index a-index) (nth rules b-index)
          (= index b-index) (nth rules a-index)
          :default rule))
      rules)))

(defun ensure-terrain-ruleset [state]
  (if (selected-terrain-ruleset-id state)
    state
    (add-terrain-ruleset state)))

(defun add-terrain-rule [state]
  (let [state (derive-terrain-workspace-state state)
        state-with-ruleset (ensure-terrain-ruleset state)]
    (let [ruleset-id (selected-terrain-ruleset-id state-with-ruleset)]
      (if (and ruleset-id (selected-terrain-id state-with-ruleset))
        (let [rule (make-terrain-rule state-with-ruleset)]
          (assoc state-with-ruleset
                 :rulesets (update-ruleset
                            (:rulesets state-with-ruleset)
                            ruleset-id
                            (fn [ruleset]
                              (assoc ruleset
                                     :rules
                                     (concat (or (:rules ruleset) []) [rule]))))
                 :selected-terrain-ruleset-id ruleset-id
                 :selected-terrain-rule-id (:id rule)))
        state-with-ruleset))))

(defun set-selected-terrain-rule-label [state label]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule :label label)))))))
      state)))

(defun set-selected-terrain-rule-exclusive [state exclusive?]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc (assoc state :selected-terrain-rule-exclusive? exclusive?)
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule
                                                       :exclusive?
                                                       exclusive?)))))))
      state)))

(defun duplicate-selected-terrain-rule [state]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        ruleset (selected-terrain-ruleset state)
        rule (rule-by-id (:rules ruleset) rule-id)
        duplicate (when rule (duplicate-rule (:rules ruleset) rule))]
    (if (and ruleset-id rule-id duplicate)
      (assoc state
             :selected-terrain-rule-id (:id duplicate)
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (insert-rule-after (:rules ruleset)
                                                    rule-id
                                                    duplicate)))))
      state)))

(defun terrain-rule-move-target-id [state rule-id direction]
  (let [rules (terrain-rules-for-selected-terrain state)
        index (rule-index-by-id rules rule-id)
        target-index (case direction
                       :up (when (and index (> index 0))
                             (dec index))
                       :down (when (and index (< index (dec (count rules))))
                               (inc index))
                       :default nil)]
    (:id (when (not (nil? target-index))
           (nth rules target-index)))))

(defun move-selected-terrain-rule [state direction]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        target-id (terrain-rule-move-target-id state rule-id direction)]
    (if (and ruleset-id rule-id target-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (swap-rules-by-id (:rules ruleset)
                                                   rule-id
                                                   target-id)))))
      state)))

(defun reorder-selected-terrain-rules [state from-index to-index rule-id]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        terrain-id (selected-terrain-id state)
        rules (terrain-rules-for-selected-terrain state)]
    (if (and ruleset-id
             terrain-id
             (not (nil? from-index))
             (not (nil? to-index))
             (>= from-index 0)
             (< from-index (count rules))
             (>= to-index 0)
             (< to-index (count rules)))
      (let [selected-rule-id (or rule-id
                                 (:id (nth rules from-index))
                                 (:selected-terrain-rule-id state)
                                 (selected-terrain-rule-id state))]
        (assoc state
               :selected-terrain-rule-id selected-rule-id
               :rulesets (update-ruleset
                          (:rulesets state)
                          ruleset-id
                          (fn [ruleset]
                            (assoc ruleset
                                   :rules
                                   (replace-rules-for-terrain
                                    (:rules ruleset)
                                    terrain-id
                                    (reorder-items rules
                                                   from-index
                                                   to-index)))))))
      state)))

(defun delete-selected-terrain-rule [state]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        rules (terrain-rules-for-selected-terrain state)
        index (rule-index-by-id rules rule-id)
        remaining (remove-rule-by-id rules rule-id)
        next-index (when (> (count remaining) 0)
                     (min (or index 0) (dec (count remaining))))
        next-rule-id (:id (when (not (nil? next-index))
                            (nth remaining next-index)))]
    (if (and ruleset-id rule-id)
      (assoc (assoc state
                    :rulesets (update-ruleset
                               (:rulesets state)
                               ruleset-id
                               (fn [ruleset]
                                 (assoc ruleset
                                        :rules
                                        (remove-rule-by-id (:rules ruleset)
                                                           rule-id)))))
             :selected-terrain-rule-id next-rule-id)
      state)))

(defun set-selected-rule-terrain [state terrain-id]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc rule
                                                       :terrain
                                                       terrain-id)))))))
      state)))

(defun terrain-signature-option-value [value]
  (if (= value :unknown)
    nil
    value))

(defun set-terrain-signature-value [signature direction value]
  (let [value (terrain-signature-option-value value)]
    (if (nil? value)
      (dissoc (or signature {}) direction)
      (assoc (or signature {}) direction value))))

(defun set-selected-rule-output-terrain-signature [state direction value]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        pos (selected-rule-output-position state)]
    (if (and ruleset-id
             rule-id
             (contains? terrain-signature-directions direction))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (let [output-layer
                                          (head (or (-> rule
                                                        :output
                                                        :layers)
                                                    []))
                                          signature
                                          (rule-output-terrain-signature-at
                                           rule
                                           (:x pos)
                                           (:y pos))
                                          next-signature
                                          (set-terrain-signature-value
                                           signature
                                           direction
                                           value)
                                          signatures
                                          (output-layer-terrain-signatures
                                           output-layer)]
                                      (assoc-in
                                       (assoc-in rule
                                                 [:output
                                                  :layers
                                                  0
                                                  :terrain-signatures]
                                                 signatures)
                                       [:output
                                        :layers
                                        0
                                        :terrain-signatures
                                        (:y pos)
                                        (:x pos)]
                                       next-signature))))))))
      state)))

(defun match-condition-from-option [value]
  (case value
    :ignore :ignore
    :same :same
    :none :none
    :any-terrain :any-terrain
    :not-same :not-same
    :other-terrain :other-terrain
    :default
    {:terrain value}))

(defun match-condition-option-value [condition]
  (case condition
    :ignore :ignore
    :same :same
    :none :none
    :any-terrain :any-terrain
    :not-same :not-same
    :other-terrain :not-same
    :default
    (if (= (type-of condition) "map")
      (:terrain condition)
      :ignore)))

(defun set-selected-rule-match-condition [state direction value]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        condition (match-condition-from-option value)]
    (if (and ruleset-id rule-id (contains? neighbor-directions direction))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (assoc-in rule
                                                         [:match direction]
                                                         condition)))))))
      state)))

(defun rule-with-output-layers [rule layers]
  (assoc rule
         :output
         (assoc (or (:output rule) {}) :layers layers)))

(defun replace-first-output-layer [rule output-layer]
  (let [layers (or (-> rule :output :layers) [])]
    (rule-with-output-layers
     rule
     (if (> (count layers) 0)
       (concat [output-layer] (tail layers))
       [output-layer]))))

(defun update-selected-rule-output-layer [state update-fn]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set
                                  (:selected-terrain-index state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (let [fallback-layer
                                          (default-output-stamp-layer state
                                                                      terrain-set
                                                                      terrain)
                                          output-layer
                                          (or (head (or (-> rule
                                                            :output
                                                            :layers)
                                                        []))
                                              fallback-layer)]
                                      (replace-first-output-layer
                                       rule
                                       (update-fn output-layer)))))))))
      state)))

(defun output-layer-with-tileset [state terrain-set output-layer tileset]
  (let [target-layer (profile-layer-by-id state (:target-layer output-layer))
        matching-target (first-output-layer-for-tileset state
                                                       (:id terrain-set)
                                                       tileset)
        target-layer-id (if (= (:tileset target-layer) tileset)
                          (:id target-layer)
                          (:id matching-target))]
    (if target-layer-id
      (assoc (assoc output-layer :tileset tileset) :target-layer target-layer-id)
      (dissoc (assoc output-layer :tileset tileset) :target-layer))))

(defun set-selected-rule-output-tileset [state tileset]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))]
    (if tileset
      (assoc (update-selected-rule-output-layer
              state
              (fn [output-layer]
                (output-layer-with-tileset state
                                           terrain-set
                                           output-layer
                                           tileset)))
             :terrain-rule-selected-tile nil)
      state)))

(defun set-selected-rule-output-target-layer [state target-layer-id]
  (let [target-layer-id (if (= target-layer-id target-layer-none-value)
                          nil
                          target-layer-id)]
    (assoc (update-selected-rule-output-layer
            state
            (fn [output-layer]
              (if target-layer-id
                (let [target-layer (profile-layer-by-id state target-layer-id)]
                  (assoc (assoc output-layer :target-layer target-layer-id)
                         :tileset
                         (or (:tileset target-layer)
                             (:tileset output-layer))))
                (dissoc output-layer :target-layer))))
           :terrain-rule-selected-tile nil)))

(defun matrix-width [matrix]
  (count (or (head (or matrix [])) [])))

(defun transform-matrix-cell [matrix transform-fn x y]
  (let [pos (transform-fn x y)]
    (nth (or (nth (or matrix []) (:y pos)) []) (:x pos))))

(defun transform-matrix [matrix transform-fn]
  (let [matrix (or matrix [])
        height (count matrix)
        width (matrix-width matrix)]
    (dotimes [y height]
      (dotimes [x width]
        (transform-matrix-cell matrix transform-fn x y)))))

(defun output-layer-transform [output-layer command]
  (let [tiles (or (:tiles output-layer) [])
        width (matrix-width tiles)
        height (count tiles)]
    (case command
      :flip-horizontal
      (fn [x y] {:x (- (dec width) x) :y y})

      :flip-vertical
      (fn [x y] {:x x :y (- (dec height) y)})

      :rotate-left
      (fn [x y] {:x (- (dec width) y) :y x})

      :rotate-right
      (fn [x y] {:x y :y (- (dec height) x)})

      :default
      (fn [x y] {:x x :y y}))))

(defun transform-output-anchor [anchor command width height]
  (let [anchor (or anchor {:x 0 :y 0})
        x (:x anchor)
        y (:y anchor)]
    (case command
      :flip-horizontal {:x (- (dec width) x) :y y}
      :flip-vertical {:x x :y (- (dec height) y)}
      :rotate-left {:x y :y (- (dec width) x)}
      :rotate-right {:x (- (dec height) y) :y x}
      :default anchor)))

(def direction-positions
  {:nw {:x 0 :y 0}
   :n {:x 1 :y 0}
   :ne {:x 2 :y 0}
   :w {:x 0 :y 1}
   :e {:x 2 :y 1}
   :sw {:x 0 :y 2}
   :s {:x 1 :y 2}
   :se {:x 2 :y 2}})

(def position-directions
  {[0 0] :nw
   [1 0] :n
   [2 0] :ne
   [0 1] :w
   [2 1] :e
   [0 2] :sw
   [1 2] :s
   [2 2] :se})

(defun transform-rule-match-source-direction [direction transform-fn]
  (let [pos (get direction-positions direction)
        source-pos (transform-fn (:x pos) (:y pos))]
    (get position-directions [(:x source-pos) (:y source-pos)])))

(defun transform-rule-match [match command]
  (let [transform-fn (output-layer-transform {:tiles [[nil nil nil]
                                                   [nil nil nil]
                                                   [nil nil nil]]}
                                             command)
        match (or match {})]
    (reduce neighbor-directions
            {}
            (fn [result direction]
              (assoc result
                     direction
                     (or (get match
                              (transform-rule-match-source-direction
                               direction
                               transform-fn))
                         :ignore))))))

(defun transform-rule-output [rule command]
  (let [output (or (:output rule) {})
        layers (or (:layers output) [])
        first-layer (head layers)]
    (if first-layer
      (let [width (matrix-width (:tiles first-layer))
            height (count (or (:tiles first-layer) []))
            transform-fn (output-layer-transform first-layer command)
            transformed-layer
            (assoc (assoc first-layer
                          :tiles
                          (transform-matrix (:tiles first-layer)
                                            transform-fn))
                   :terrain-signatures
                   (transform-matrix (output-layer-terrain-signatures
                                      first-layer)
                                     transform-fn))]
        (assoc rule
               :output
               (assoc (assoc output
                             :layers
                             (concat [transformed-layer] (tail layers)))
                      :anchor
                      (transform-output-anchor (:anchor output)
                                               command
                                               width
                                               height))))
      rule)))

(defun transform-rule [rule command]
  (assoc rule
         :match
         (transform-rule-match (:match rule) command)))

(defun transform-selected-rule [state command]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id rule-id)
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule (:rules ruleset)
                                              rule-id
                                              (fn [rule]
                                                (transform-rule
                                                 rule
                                                 command)))))))
      state)))

(defun rule-with-stamp-output [rule output-layer x y tile-ref mask-ref]
  (let [signatures (output-layer-terrain-signatures output-layer)
        transition-masks (output-layer-transition-masks output-layer)
        existing-signature (output-layer-terrain-signature-at output-layer x y)
        signature (when (or tile-ref mask-ref)
                    (or existing-signature
                        (default-terrain-signature-for-rule rule)))]
    (assoc-in
     (assoc-in
      (assoc-in
       (assoc-in
        (assoc-in rule
                  [:output :layers 0 :tiles y x]
                  tile-ref)
        [:output :layers 0 :transition-masks]
        transition-masks)
       [:output :layers 0 :transition-masks y x]
       mask-ref)
      [:output :layers 0 :terrain-signatures]
      signatures)
     [:output :layers 0 :terrain-signatures y x]
     signature)))

(defun set-selected-rule-stamp-output [state x y tile-ref mask-ref]
  (let [ruleset-id (selected-terrain-ruleset-id state)
        rule-id (or (:selected-terrain-rule-id state)
                    (selected-terrain-rule-id state))]
    (if (and ruleset-id
             rule-id
             (selected-rule-stamp-cell-editable? state x y))
      (assoc state
             :rulesets (update-ruleset
                        (:rulesets state)
                        ruleset-id
                        (fn [ruleset]
                          (assoc ruleset
                                 :rules
                                 (update-rule
                                  (:rules ruleset)
                                  rule-id
                                  (fn [rule]
                                    (if-let [output-layer (head (or (-> rule
                                                                        :output
                                                                        :layers)
                                                                    []))]
                                      (rule-with-stamp-output rule
                                                              output-layer
                                                              x
                                                              y
                                                              tile-ref
                                                              mask-ref)
                                      rule)))))))
      state)))

(defun set-selected-rule-stamp-tile [state x y tile-ref]
  (set-selected-rule-stamp-output state x y tile-ref nil))

(defun set-selected-rule-stamp-mask [state x y mask-ref]
  (set-selected-rule-stamp-output state x y nil mask-ref))

(def terrain-standard-setup-definitions
  [{:id :island-3x3
    :label "Island"
    :roles [{:id :nw :label "NW"}
            {:id :n :label "N"}
            {:id :ne :label "NE"}
            {:id :w :label "W"}
            {:id :center :label "C"}
            {:id :e :label "E"}
            {:id :sw :label "SW"}
            {:id :s :label "S"}
            {:id :se :label "SE"}]
    :matrix [[:nw :n :ne]
             [:w :center :e]
             [:sw :s :se]]}
   {:id :inner-corners
    :label "Inner corners"
    :roles [{:id :inner-nw :label "NW"}
            {:id :inner-ne :label "NE"}
            {:id :inner-sw :label "SW"}
            {:id :inner-se :label "SE"}]
    :matrix [[:inner-nw nil :inner-ne]
             [nil nil nil]
             [:inner-sw nil :inner-se]]}
   {:id :isolated
    :label "Isolated"
    :roles [{:id :isolated-all :label "All 8"}
            {:id :isolated-cardinal :label "N/E/S/W"}
            {:id :isolated-diagonal :label "Diagonals"}]
    :matrix [[:isolated-all :isolated-cardinal :isolated-diagonal]]}
   {:id :ring
    :label "Ring"
    :roles [{:id :ring-bend-se :label "SE"}
            {:id :ring-straight-h :label "H"}
            {:id :ring-bend-sw :label "SW"}
            {:id :ring-straight-v :label "V"}
            {:id :ring-bend-ne :label "NE"}
            {:id :ring-bend-nw :label "NW"}]
    :matrix [[:ring-bend-se :ring-straight-h :ring-bend-sw]
             [:ring-straight-v nil nil]
             [:ring-bend-ne nil :ring-bend-nw]]}
   {:id :forks-cardinal
    :label "Forks"
    :roles [{:id :fork-new :label "N/E/W"}
            {:id :fork-nsw :label "N/S/W"}
            {:id :fork-nesw :label "N/E/S/W"}
            {:id :fork-nes :label "N/E/S"}
            {:id :fork-esw :label "E/S/W"}]
    :matrix [[nil :fork-new nil]
             [:fork-nsw :fork-nesw :fork-nes]
             [nil :fork-esw nil]]}
   {:id :forks-diagonal
    :label "Forks + diagonals"
    :roles [{:id :fork-diagonal-new :label "N/E/W"}
            {:id :fork-diagonal-nsw :label "N/S/W"}
            {:id :fork-diagonal-nesw :label "N/E/S/W"}
            {:id :fork-diagonal-nes :label "N/E/S"}
            {:id :fork-diagonal-esw :label "E/S/W"}]
    :matrix [[nil :fork-diagonal-new nil]
             [:fork-diagonal-nsw :fork-diagonal-nesw :fork-diagonal-nes]
             [nil :fork-diagonal-esw nil]]}
   {:id :stumps
    :label "Stumps"
    :roles [{:id :stump-nw :label "NW"}
            {:id :stump-n :label "N"}
            {:id :stump-ne :label "NE"}
            {:id :stump-w :label "W"}
            {:id :stump-e :label "E"}
            {:id :stump-sw :label "SW"}
            {:id :stump-s :label "S"}
            {:id :stump-se :label "SE"}]
    :matrix [[:stump-nw :stump-n :stump-ne]
             [:stump-w nil :stump-e]
             [:stump-sw :stump-s :stump-se]]}])

(defun terrain-standard-setup [setup-id]
  (head (filter terrain-standard-setup-definitions
                (fn [setup]
                  (= (:id setup) setup-id)))))

(defun terrain-standard-setup-role [setup role-id]
  (head (filter (or (:roles setup) [])
                (fn [role]
                  (= (:id role) role-id)))))

(defun terrain-standard-setup-ids []
  (map terrain-standard-setup-definitions :id))

(defun terrain-standard-role-ids []
  (reduce terrain-standard-setup-definitions
          []
          (fn [role-ids setup]
            (concat role-ids (map (or (:roles setup) []) :id)))))

(defun terrain-standard-role-label [setup-id role-id]
  (or (:label (terrain-standard-setup-role
               (terrain-standard-setup setup-id)
               role-id))
      (keyword-label role-id)))

(defun terrain-standard-rule-setup-label [setup-id]
  (case setup-id
    :inner-corners "Inner corner"
    :forks-cardinal "Fork"
    :forks-diagonal "Fork diagonals"
    :stumps "Stump"
    :default
    (or (:label (terrain-standard-setup setup-id))
        (keyword-label setup-id))))

(defun terrain-standard-rule-label [state setup-id role-id opposing]
  (str (terrain-standard-rule-setup-label setup-id)
       " "
       (terrain-standard-role-label setup-id role-id)
       " - "
       (terrain-standard-opposing-label state opposing)))

(defun selected-terrain-standard-setup-ids [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set (:selected-terrain-index state))
        setup-ids (terrain-standard-setup-ids)
        visible-ids (:visible-terrain-standard-setups terrain)]
    (if (nil? visible-ids)
      setup-ids
      (filter setup-ids
              (fn [setup-id]
                (contains? visible-ids setup-id))))))

(defun terrain-standard-setup-visible? [state setup-id]
  (contains? (selected-terrain-standard-setup-ids state) setup-id))

(defun selected-terrain-standard-setup-options [state]
  (map terrain-standard-setup-definitions
       (fn [setup]
         {:value (:id setup)
          :label (:label setup)
          :checked? (terrain-standard-setup-visible? state (:id setup))})))

(defun set-selected-terrain-standard-setup-visible [state setup-id visible?]
  (if-let [path (selected-terrain-path state)]
    (let [setup-ids (terrain-standard-setup-ids)
          current (selected-terrain-standard-setup-ids state)
          requested (if visible?
                      (concat current [setup-id])
                      (filter current
                              (fn [id]
                                (not= id setup-id))))
          next-visible (filter setup-ids
                               (fn [id]
                                 (contains? requested id)))]
      (assoc-in state
                (concat path [:visible-terrain-standard-setups])
                next-visible))
    state))

(def terrain-standard-opposing-none :none)
(def terrain-standard-opposing-any-other :any-other)

(defun terrain-standard-opposing-terrain-in? [opposing]
  (and (= (type-of opposing) "map")
       (contains? opposing :terrain-in)))

(defun terrain-standard-opposing-terrain-values [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        center-terrain-id (selected-terrain-id state)]
    (map (filter (or (:terrains terrain-set) [])
                 (fn [terrain]
                   (not= (:id terrain) center-terrain-id)))
         :id)))

(defun normalize-terrain-standard-opposing [state opposing]
  (let [terrain-values (terrain-standard-opposing-terrain-values state)
        terrain-value? (fn [value]
                         (contains? terrain-values value))]
    (cond
      (nil? opposing) terrain-standard-opposing-none
      (= opposing terrain-standard-opposing-none) terrain-standard-opposing-none
      (= opposing terrain-standard-opposing-any-other)
      terrain-standard-opposing-any-other
      (terrain-standard-opposing-terrain-in? opposing)
      (let [requested (or (:terrain-in opposing) [])
            values (filter terrain-values
                           (fn [value]
                             (contains? requested value)))]
        (case (count values)
          0 terrain-standard-opposing-none
          1 (head values)
          :default
          {:terrain-in values}))
      (terrain-value? opposing) opposing
      :default terrain-standard-opposing-none)))

(defun terrain-standard-opposing-terrain-list [state opposing]
  (let [opposing (normalize-terrain-standard-opposing state opposing)]
    (cond
      (terrain-standard-opposing-terrain-in? opposing)
      (or (:terrain-in opposing) [])
      (or (= opposing terrain-standard-opposing-none)
          (= opposing terrain-standard-opposing-any-other))
      []
      :default [opposing])))

(defun terrain-standard-opposing-selected? [state terrain-id]
  (contains? (terrain-standard-opposing-terrain-list
              state
              (:terrain-standard-opposing state))
             terrain-id))

(defun terrain-standard-opposing-value-from-terrains [terrain-ids]
  (case (count terrain-ids)
    0 terrain-standard-opposing-none
    1 (head terrain-ids)
    :default
    {:terrain-in terrain-ids}))

(defun toggle-terrain-standard-opposing [state terrain-id]
  (let [terrain-values (terrain-standard-opposing-terrain-values state)
        current (terrain-standard-opposing-terrain-list
                 state
                 (:terrain-standard-opposing state))
        requested (if (contains? current terrain-id)
                    (filter current
                            (fn [value]
                              (not= value terrain-id)))
                    (concat current [terrain-id]))
        next-values (filter terrain-values
                            (fn [value]
                              (contains? requested value)))]
    (terrain-standard-opposing-value-from-terrains next-values)))

(defun set-terrain-standard-opposing [state opposing]
  (assoc state
         :terrain-standard-opposing
         (normalize-terrain-standard-opposing state opposing)))

(defun terrain-standard-opposing-condition [opposing]
  (cond
    (= opposing :none) :none
    (= opposing :any-other) :other-terrain
    (terrain-standard-opposing-terrain-in? opposing)
    {:terrain-in (or (:terrain-in opposing) [])}
    :default {:terrain opposing}))

(defun same-terrain-values? [a b]
  (and (= (count a) (count b))
       (= 0
          (count (filter a
                         (fn [value]
                           (not (contains? b value))))))))

(defun terrain-standard-opposing-condition? [condition opposing]
  (cond
    (= opposing :none) (= condition :none)
    (= opposing :any-other) (or (= condition :other-terrain)
                                (= condition :not-same))
    (terrain-standard-opposing-terrain-in? opposing)
    (and (= (type-of condition) "map")
         (contains? condition :terrain-in)
         (same-terrain-values? (or (:terrain-in condition) [])
                               (or (:terrain-in opposing) [])))
    :default (and (= (type-of condition) "map")
                  (= (:terrain condition) opposing))))

(defun terrain-standard-opposing-option [value label]
  {:value value
   :label label})

(defun terrain-standard-opposing-terrain-label [terrain]
  (or (:label terrain)
      (:name terrain)
      (transition-id-label (:id terrain))
      (str (:id terrain))))

(defun terrain-standard-opposing-options [state]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        center-terrain-id (selected-terrain-id state)]
    (concat [(terrain-standard-opposing-option terrain-standard-opposing-none
                                               "None")
             (terrain-standard-opposing-option
              terrain-standard-opposing-any-other
              "Any other")]
            (map (filter (or (:terrains terrain-set) [])
                         (fn [terrain]
                           (not= (:id terrain) center-terrain-id)))
                 (fn [terrain]
                   (terrain-standard-opposing-option
                    (:id terrain)
                    (terrain-standard-opposing-terrain-label terrain)))))))

(defun terrain-standard-opposing-valid? [state opposing]
  (= (normalize-terrain-standard-opposing state opposing) opposing))

(defun selected-terrain-standard-opposing [state]
  (let [requested (or (:terrain-standard-opposing state)
                      terrain-standard-opposing-none)]
    (normalize-terrain-standard-opposing state requested)))

(defun terrain-standard-opposing-option-index [state]
  (let [opposing (selected-terrain-standard-opposing state)
        index (find-index (terrain-standard-opposing-options state)
                          (fn [option]
                            (= (:value option) opposing)))]
    (or index 0)))

(defun comma-join [values]
  (reduce (or values [])
          ""
          (fn [result value]
            (if (empty? result)
              value
              (str result ", " value)))))

(defun terrain-standard-opposing-label [state opposing]
  (let [opposing (normalize-terrain-standard-opposing state opposing)
        options (terrain-standard-opposing-options state)
        option-label (:label (head (filter options
                                           (fn [option]
                                             (= (:value option) opposing)))))]
    (or option-label
        (when (terrain-standard-opposing-terrain-in? opposing)
          (comma-join
           (map (:terrain-in opposing)
                (fn [terrain-id]
                  (or (:label (head (filter options
                                            (fn [option]
                                              (= (:value option)
                                                 terrain-id)))))
                      (keyword-label terrain-id))))))
        (keyword-label opposing))))

(def terrain-standard-role-opposing-directions
  {:n [:n]
   :s [:s]
   :w [:w]
   :e [:e]
   :nw [:n :w]
   :ne [:n :e]
   :sw [:s :w]
   :se [:s :e]
   :inner-nw [:nw]
   :inner-ne [:ne]
   :inner-sw [:sw]
   :inner-se [:se]
   :isolated-all [:nw :n :ne :w :e :sw :s :se]
   :isolated-cardinal [:n :w :e :s]
   :isolated-diagonal [:nw :ne :sw :se]
   :ring-bend-nw [:nw :ne :e :sw :s :se]
   :ring-bend-ne [:nw :ne :w :sw :s :se]
   :ring-bend-sw [:nw :n :ne :e :sw :se]
   :ring-bend-se [:nw :n :ne :w :sw :se]
   :ring-straight-h [:n :s]
   :ring-straight-v [:w :e]
   :fork-new [:s]
   :fork-nsw [:e]
   :fork-nes [:w]
   :fork-esw [:n]
   :fork-diagonal-new [:s]
   :fork-diagonal-nsw [:e]
   :fork-diagonal-nes [:w]
   :fork-diagonal-esw [:n]
   :stump-nw [:nw :n :ne :w :e :sw :s]
   :stump-n [:nw :n :ne :w :e :sw :se]
   :stump-ne [:nw :n :ne :w :e :s :se]
   :stump-w [:nw :n :ne :w :sw :s :se]
   :stump-e [:nw :n :ne :e :sw :s :se]
   :stump-sw [:nw :n :w :e :sw :s :se]
   :stump-s [:nw :ne :w :e :sw :s :se]
   :stump-se [:n :ne :w :e :sw :s :se]})

(def terrain-standard-role-same-directions
  {:center [:n :w :e :s]
   :n [:s]
   :s [:n]
   :w [:e]
   :e [:w]
   :nw [:s :e :se]
   :ne [:s :w :sw]
   :sw [:n :e :ne]
   :se [:n :w :nw]
   :inner-nw [:n :w :e :s]
   :inner-ne [:n :w :e :s]
   :inner-sw [:n :w :e :s]
   :inner-se [:n :w :e :s]
   :ring-bend-nw [:n :w]
   :ring-bend-ne [:n :e]
   :ring-bend-sw [:s :w]
   :ring-bend-se [:s :e]
   :ring-straight-h [:w :e]
   :ring-straight-v [:n :s]
   :fork-new [:n :e :w]
   :fork-nsw [:n :s :w]
   :fork-nesw [:n :w :e :s]
   :fork-nes [:n :e :s]
   :fork-esw [:e :s :w]
   :fork-diagonal-new [:nw :n :ne :w :e]
   :fork-diagonal-nsw [:nw :n :w :sw :s]
   :fork-diagonal-nesw [:n :w :e :s]
   :fork-diagonal-nes [:n :ne :e :se :s]
   :fork-diagonal-esw [:e :se :s :sw :w]
   :stump-nw [:se]
   :stump-n [:s]
   :stump-ne [:sw]
   :stump-w [:e]
   :stump-e [:w]
   :stump-sw [:ne]
   :stump-s [:n]
   :stump-se [:nw]})

(defun terrain-standard-role-match-value [role-id opposing direction]
  (cond
    (contains? (or (get terrain-standard-role-opposing-directions role-id) [])
               direction)
    (terrain-standard-opposing-condition opposing)

    (contains? (or (get terrain-standard-role-same-directions role-id) [])
               direction)
    :same

    :default :ignore))

(defun terrain-standard-role-match [role-id opposing]
  (reduce neighbor-directions
          {}
          (fn [match direction]
            (assoc match
                   direction
                   (terrain-standard-role-match-value role-id
                                                      opposing
                                                      direction)))))

(defun normalized-match-condition [condition]
  (or condition :ignore))

(defun standard-match-condition-equals? [actual expected opposing]
  (if (terrain-standard-opposing-condition? expected opposing)
    (terrain-standard-opposing-condition? actual opposing)
    (= (normalized-match-condition actual)
       (normalized-match-condition expected))))

(defun terrain-rule-condition-known-terrain? [center-terrain condition]
  (let [condition (normalized-match-condition condition)]
    (or (= condition :same)
        (= condition :any-terrain)
        (= condition :other-terrain)
        (= condition :not-same)
        (and (= (type-of condition) "map")
             (or (not (nil? (:terrain condition)))
                 (> (count (or (:terrain-in condition) [])) 0))))))

(defun terrain-rule-condition-terrains [center-terrain condition]
  (let [condition (normalized-match-condition condition)]
    (cond
      (= condition :same) [center-terrain]
      (and (= (type-of condition) "map")
           (contains? condition :terrain-in))
      (or (:terrain-in condition) [])
      (= (type-of condition) "map") [(:terrain condition)]
      :default [])))

(defun terrain-rule-condition-terrain? [center-terrain condition terrain]
  (let [terrains (filter (terrain-rule-condition-terrains center-terrain
                                                          condition)
                         (fn [value]
                           (not (nil? value))))]
    (and (> (count terrains) 0)
         (= 0
            (count (filter terrains
                           (fn [value]
                             (not= value terrain))))))))

(defun terrain-rule-condition-terrains-in? [center-terrain condition terrains]
  (let [condition-terrains
        (filter (terrain-rule-condition-terrains center-terrain condition)
                (fn [value]
                  (not (nil? value))))]
    (and (> (count condition-terrains) 0)
         (= 0
            (count (filter condition-terrains
                           (fn [value]
                             (not (contains? terrains value)))))))))

(defun terrain-rule-condition-other-terrain? [center-terrain condition]
  (let [condition (normalized-match-condition condition)
        terrains (filter (terrain-rule-condition-terrains center-terrain
                                                          condition)
                         (fn [value]
                           (not (nil? value))))]
    (or (= condition :other-terrain)
        (= condition :not-same)
        (and (> (count terrains) 0)
             (= 0
                (count (filter terrains
                               (fn [value]
                                 (= value center-terrain)))))))))

(defun terrain-rule-match-condition-implies? [center-terrain specific general]
  (let [specific (normalized-match-condition specific)
        general (normalized-match-condition general)]
    (cond
      (= general :ignore) true
      (= specific general) true
      (and (= specific :other-terrain)
           (= general :not-same)) true
      (and (= specific :not-same)
           (= general :other-terrain)) true
      (= general :any-terrain)
      (terrain-rule-condition-known-terrain? center-terrain specific)
      (or (= general :other-terrain)
          (= general :not-same))
      (terrain-rule-condition-other-terrain? center-terrain specific)
      (= general :same)
      (terrain-rule-condition-terrain? center-terrain specific center-terrain)
      (and (= (type-of general) "map")
           (contains? general :terrain-in))
      (terrain-rule-condition-terrains-in? center-terrain
                                           specific
                                           (or (:terrain-in general) []))
      (= (type-of general) "map")
      (terrain-rule-condition-terrain? center-terrain
                                       specific
                                       (:terrain general))
      :default false)))

(defun terrain-rule-match-implies? [specific general]
  (let [center-terrain (terrain-rule-center specific)]
    (and (= center-terrain (terrain-rule-center general))
         (= 0
            (count
             (filter neighbor-directions
                     (fn [direction]
                       (not (terrain-rule-match-condition-implies?
                             center-terrain
                             (get (or (:match specific) {}) direction)
                             (get (or (:match general) {}) direction))))))))))

(defun terrain-rule-more-specific-than? [specific general]
  (and (terrain-rule-match-implies? specific general)
       (not (terrain-rule-match-implies? general specific))))

(defun max-index [values]
  (reduce (or values [])
          nil
          (fn [result value]
            (if (or (nil? result)
                    (> value result))
              value
              result))))

(defun min-index [values]
  (reduce (or values [])
          nil
          (fn [result value]
            (if (or (nil? result)
                    (< value result))
              value
              result))))

(defun terrain-rule-specific-insertion-index [rules rule]
  (let [rules (or rules [])
        more-specific-before (max-index
                              (map (filter (for-indexed [index existing rules]
                                             {:index index
                                              :rule existing})
                                           (fn [entry]
                                             (terrain-rule-more-specific-than?
                                              (:rule entry)
                                              rule)))
                                   :index))
        less-specific-after (min-index
                             (map (filter (for-indexed [index existing rules]
                                            {:index index
                                             :rule existing})
                                          (fn [entry]
                                            (terrain-rule-more-specific-than?
                                             rule
                                             (:rule entry))))
                                  :index))
        after-more-specific (if (nil? more-specific-before)
                              0
                              (inc more-specific-before))]
    (if (and (not (nil? less-specific-after))
             (> after-more-specific less-specific-after))
      less-specific-after
      (if (nil? less-specific-after)
        after-more-specific
        (min after-more-specific less-specific-after)))))

(defun insert-terrain-rule-by-specificity [rules rule]
  (let [index (terrain-rule-specific-insertion-index rules rule)]
    (if (nil? index)
      (concat (or rules []) [rule])
      (insert-item-at-index rules index rule))))

(defun terrain-standard-rule-match? [rule role-id opposing]
  (let [shape (terrain-standard-role-match role-id opposing)
        match (or (:match rule) {})]
    (= 0
       (count
        (filter neighbor-directions
                (fn [direction]
                  (not (standard-match-condition-equals?
                        (get match direction)
                        (get shape direction)
                        opposing))))))))

(defun terrain-standard-role-output-position [state role-id]
  (let [unit (selected-terrain-unit state)
        max-x (dec (:w unit))
        max-y (dec (:h unit))
        fallback {:x 0 :y 0}
        requested (case role-id
                    :inner-ne {:x 1 :y 0}
                    :inner-sw {:x 0 :y 1}
                    :inner-se {:x 1 :y 1}
                    :default fallback)]
    {:x (max 0 (min max-x (:x requested)))
     :y (max 0 (min max-y (:y requested)))}))

(defun terrain-standard-role-rule-in-rules [rules role-id opposing]
  (head (filter (or rules [])
                (fn [rule]
                  (terrain-standard-rule-match? rule role-id opposing)))))

(defun terrain-standard-role-rule [state setup-id role-id opposing]
  (terrain-standard-role-rule-in-rules
   (terrain-rules-for-selected-terrain state)
   role-id
   opposing))

(defun terrain-standard-role-rule-id [state setup-id role-id opposing]
  (:id (terrain-standard-role-rule state setup-id role-id opposing)))

(defun terrain-standard-role-output-layer [state setup-id role-id opposing]
  (head (or (-> (terrain-standard-role-rule state setup-id role-id opposing)
                :output
                :layers)
            [])))

(defun terrain-standard-role-tile-ref [state setup-id role-id opposing]
  (let [layer (terrain-standard-role-output-layer state setup-id role-id opposing)
        pos (terrain-standard-role-output-position state role-id)]
    (nth (or (nth (or (:tiles layer) []) (:y pos)) []) (:x pos))))

(defun terrain-standard-role-mask-ref [state setup-id role-id opposing]
  (let [layer (terrain-standard-role-output-layer state setup-id role-id opposing)
        pos (terrain-standard-role-output-position state role-id)]
    (nth (or (nth (or (:transition-masks layer) []) (:y pos)) [])
         (:x pos))))

(defun terrain-standard-role-tileset [state setup-id role-id opposing]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        layer (terrain-standard-role-output-layer state
                                                  setup-id
                                                  role-id
                                                  opposing)]
    (or (:tileset layer)
        (selected-rule-stamp-tileset state)
        (:tileset terrain-set)
        (:tileset (default-output-layer-for-terrain-set state terrain-set)))))

(defun terrain-standard-role-tile [state setup-id role-id opposing]
  (data/tile-in (:tilesets state)
                (terrain-standard-role-tileset state setup-id role-id opposing)
                (terrain-standard-role-tile-ref state
                                                setup-id
                                                role-id
                                                opposing)))

(defun terrain-standard-role-cache-entry [state rules role-id opposing default-tileset]
  (let [rule (terrain-standard-role-rule-in-rules rules role-id opposing)
        layer (head (or (-> rule :output :layers) []))
        pos (terrain-standard-role-output-position state role-id)
        tile-ref (nth (or (nth (or (:tiles layer) []) (:y pos)) [])
                      (:x pos))
        mask-ref (nth (or (nth (or (:transition-masks layer) []) (:y pos)) [])
                      (:x pos))
        tileset (or (:tileset layer)
                    default-tileset)]
    {:rule-id (:id rule)
     :tile-ref tile-ref
     :mask-ref mask-ref
     :tileset tileset
     :tile (data/tile-in (:tilesets state) tileset tile-ref)}))

(defun terrain-standard-role-slot-cache [state opposing]
  (let [rules (terrain-rules-for-selected-terrain state)
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        default-tileset (or (:tileset terrain-set)
                            (:tileset
                             (default-output-layer-for-terrain-set state
                                                                   terrain-set)))]
    (reduce (terrain-standard-role-ids)
            {}
            (fn [cache role-id]
              (assoc cache
                     role-id
                     (terrain-standard-role-cache-entry state
                                                        rules
                                                        role-id
                                                        opposing
                                                        default-tileset))))))

(defun terrain-standard-role-slot-cache-key [state opposing]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        unit (selected-terrain-unit state)]
    {:selected-terrain-set-index (:selected-terrain-set-index state)
     :selected-terrain-set-id (:id terrain-set)
     :selected-terrain-set-tileset (:tileset terrain-set)
     :selected-terrain-unit-w (:w unit)
     :selected-terrain-unit-h (:h unit)
     :selected-terrain-index (:selected-terrain-index state)
     :selected-terrain-id (selected-terrain-id state)
     :selected-terrain-ruleset-id (:selected-terrain-ruleset-id state)
     :opposing opposing
     :selected-layer-profile-id (:selected-layer-profile-id state)}))

(defun terrain-standard-role-slot-cache-for-state [state opposing]
  (let [cache-key (terrain-standard-role-slot-cache-key state opposing)]
    {:key cache-key
     :slots (if (= cache-key (:terrain-standard-role-cache-key state))
              (:terrain-standard-role-slots state)
              (terrain-standard-role-slot-cache state opposing))}))

(defun clear-terrain-standard-role-slot-cache [state]
  (dissoc (dissoc state :terrain-standard-role-cache-key)
          :terrain-standard-role-slots))

(defun terrain-unit-single-tile-stamp [unit pos tile-ref]
  (dotimes [y (:h unit)]
    (dotimes [x (:w unit)]
      (if (and (= x (:x pos))
               (= y (:y pos)))
        tile-ref
        nil))))

(defun terrain-unit-single-signature-stamp [unit pos signature]
  (dotimes [y (:h unit)]
    (dotimes [x (:w unit)]
      (if (and (= x (:x pos))
               (= y (:y pos)))
        signature
        nil))))

(defun terrain-unit-single-mask-stamp [unit pos mask-ref]
  (dotimes [y (:h unit)]
    (dotimes [x (:w unit)]
      (if (and (= x (:x pos))
               (= y (:y pos)))
        mask-ref
        nil))))

(defun terrain-standard-output-layer [state
                                      terrain-set
                                      terrain
                                      rule
                                      role-id
                                      tile-ref
                                      mask-ref]
  (let [unit (data/terrain-unit terrain-set)
        pos (terrain-standard-role-output-position state role-id)
        fallback-layer (default-output-stamp-layer state terrain-set terrain)
        output-layer (or (head (or (-> rule :output :layers) []))
                         fallback-layer)
        signature (when (or tile-ref mask-ref)
                    (default-terrain-signature-for-rule rule))]
    (assoc (assoc output-layer
                  :tiles
                  (terrain-unit-single-tile-stamp unit pos tile-ref))
           :transition-masks
           (terrain-unit-single-mask-stamp unit pos mask-ref)
           :terrain-signatures
           (terrain-unit-single-signature-stamp unit pos signature))))

(defun terrain-standard-rule-with-output [state
                                          terrain-set
                                          terrain
                                          rule
                                          role-id
                                          opposing
                                          tile-ref
                                          mask-ref]
  (replace-first-output-layer
   (assoc rule :match (terrain-standard-role-match role-id opposing))
   (terrain-standard-output-layer state
                                  terrain-set
                                  terrain
                                  (assoc rule
                                         :match
                                         (terrain-standard-role-match role-id
                                                                      opposing))
                                  role-id
                                  tile-ref
                                  mask-ref)))

(defun terrain-standard-rule-with-tile [state terrain-set terrain rule role-id opposing tile-ref]
  (terrain-standard-rule-with-output state
                                     terrain-set
                                     terrain
                                     rule
                                     role-id
                                     opposing
                                     tile-ref
                                     nil))

(defun terrain-standard-rule-with-mask [state terrain-set terrain rule role-id opposing mask-ref]
  (terrain-standard-rule-with-output state
                                     terrain-set
                                     terrain
                                     rule
                                     role-id
                                     opposing
                                     nil
                                     mask-ref))

(defun add-terrain-standard-role-rule [state setup-id role-id opposing tile-ref]
  (let [state (ensure-terrain-ruleset (derive-terrain-workspace-state state))
        ruleset-id (selected-terrain-ruleset-id state)
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set (:selected-terrain-index state))]
    (if (and ruleset-id terrain-set terrain)
      (let [rule (assoc (make-terrain-rule state)
                        :label (terrain-standard-rule-label state
                                                            setup-id
                                                            role-id
                                                            opposing)
                        :exclusive? true
                        :match (terrain-standard-role-match role-id opposing))
            rule (terrain-standard-rule-with-tile state
                                                  terrain-set
                                                  terrain
                                                  rule
                                                  role-id
                                                  opposing
                                                  tile-ref)]
        (assoc state
               :rulesets (update-ruleset
                          (:rulesets state)
                          ruleset-id
                          (fn [ruleset]
                            (assoc ruleset
                                   :rules
                                   (insert-terrain-rule-by-specificity
                                    (:rules ruleset)
                                    rule))))
               :selected-terrain-ruleset-id ruleset-id
               :selected-terrain-rule-id (:id rule)))
      state)))

(defun set-terrain-standard-role-tile [state setup-id role-id opposing tile-ref]
  (let [state (derive-terrain-workspace-state state)
        opposing (or opposing (selected-terrain-standard-opposing state))
        opposing (normalize-terrain-standard-opposing state opposing)
        rule-id (terrain-standard-role-rule-id state setup-id role-id opposing)]
    (if rule-id
      (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                              (:selected-terrain-set-index state))
            terrain (selected-terrain terrain-set (:selected-terrain-index state))
            ruleset-id (selected-terrain-ruleset-id state)]
        (assoc state
               :rulesets (update-ruleset
                          (:rulesets state)
                          ruleset-id
                          (fn [ruleset]
                            (assoc ruleset
                                   :rules
                                   (update-rule
                                    (:rules ruleset)
                                    rule-id
                                    (fn [rule]
                                      (terrain-standard-rule-with-tile
                                       state
                                       terrain-set
                                       terrain
                                       rule
                                       role-id
                                       opposing
                                       tile-ref))))))
               :selected-terrain-rule-id rule-id))
      (add-terrain-standard-role-rule state setup-id role-id opposing tile-ref))))

(defun add-terrain-standard-role-mask-rule [state setup-id role-id opposing mask-ref]
  (let [state (ensure-terrain-ruleset (derive-terrain-workspace-state state))
        ruleset-id (selected-terrain-ruleset-id state)
        terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        terrain (selected-terrain terrain-set (:selected-terrain-index state))]
    (if (and ruleset-id terrain-set terrain mask-ref)
      (let [rule (assoc (make-terrain-rule state)
                        :label (terrain-standard-rule-label state
                                                            setup-id
                                                            role-id
                                                            opposing)
                        :exclusive? true
                        :match (terrain-standard-role-match role-id opposing))
            rule (terrain-standard-rule-with-mask state
                                                  terrain-set
                                                  terrain
                                                  rule
                                                  role-id
                                                  opposing
                                                  mask-ref)]
        (assoc state
               :rulesets (update-ruleset
                          (:rulesets state)
                          ruleset-id
                          (fn [ruleset]
                            (assoc ruleset
                                   :rules
                                   (insert-terrain-rule-by-specificity
                                    (:rules ruleset)
                                    rule))))
               :selected-terrain-ruleset-id ruleset-id
               :selected-terrain-rule-id (:id rule)))
      state)))

(defun set-terrain-standard-role-mask [state setup-id role-id opposing mask-ref]
  (let [state (derive-terrain-workspace-state state)
        opposing (or opposing (selected-terrain-standard-opposing state))
        opposing (normalize-terrain-standard-opposing state opposing)
        rule-id (terrain-standard-role-rule-id state setup-id role-id opposing)]
    (if rule-id
      (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                              (:selected-terrain-set-index state))
            terrain (selected-terrain terrain-set (:selected-terrain-index state))
            ruleset-id (selected-terrain-ruleset-id state)]
        (assoc state
               :rulesets (update-ruleset
                          (:rulesets state)
                          ruleset-id
                          (fn [ruleset]
                            (assoc ruleset
                                   :rules
                                   (update-rule
                                    (:rules ruleset)
                                    rule-id
                                    (fn [rule]
                                      (terrain-standard-rule-with-mask
                                       state
                                       terrain-set
                                       terrain
                                       rule
                                       role-id
                                       opposing
                                       mask-ref))))))
               :selected-terrain-rule-id rule-id))
      (add-terrain-standard-role-mask-rule state
                                           setup-id
                                           role-id
                                           opposing
                                           mask-ref))))

(defun terrain-condition-option [terrain]
  {:value (:id terrain)
   :label (str "Terrain: "
               (or (:label terrain)
                   (:name terrain)
                   (str (:id terrain))))})

(defun match-condition-options [terrain-set center-terrain-id]
  (concat [{:value :ignore
            :label "Ignore"}
           {:value :same
            :label "Same"}
           {:value :none
            :label "Empty"}
           {:value :any-terrain
            :label "Any terrain"}
           {:value :not-same
            :label "Different terrain"}]
          (map (filter (or (:terrains terrain-set) [])
                       (fn [terrain]
                         (not= (:id terrain) center-terrain-id)))
               terrain-condition-option)))

(defun terrain-signature-condition-option [terrain]
  {:value (:id terrain)
   :label (or (:label terrain)
              (:name terrain)
              (str (:id terrain)))})

(defun terrain-signature-options [terrain-set]
  (concat [{:value :unknown
            :label "Unknown"}
           {:value :none
            :label "None"}]
          (map (or (:terrains terrain-set) [])
               terrain-signature-condition-option)))

(defun terrain-signature-option-index [terrain-set value]
  (let [value (or value :unknown)
        match (find-index (terrain-signature-options terrain-set)
                          (fn [option]
                            (= (:value option) value)))]
    (or match 0)))

(defun step-terrain-signature-value [terrain-set value step]
  (let [options (terrain-signature-options terrain-set)
        index (terrain-signature-option-index terrain-set value)
        next-index (if (empty? options)
                     0
                     (mod (+ index step (count options))
                          (count options)))]
    (:value (nth options next-index))))

(defun cycle-selected-rule-output-terrain-signature [state direction step]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        signature (selected-rule-output-terrain-signature state)
        value (get (or signature {}) direction)
        next-value (step-terrain-signature-value terrain-set value step)]
    (set-selected-rule-output-terrain-signature state direction next-value)))

(defun match-condition-index [terrain-set center-terrain-id condition]
  (let [value (match-condition-option-value condition)
        match (find-index (match-condition-options terrain-set
                                                   center-terrain-id)
                          (fn [option]
                            (= (:value option) value)))]
    (or match 0)))

(defun step-match-condition-value [terrain-set center-terrain-id condition step]
  (let [options (match-condition-options terrain-set center-terrain-id)
        index (match-condition-index terrain-set
                                     center-terrain-id
                                     condition)
        next-index (if (empty? options)
                     0
                     (mod (+ index step (count options))
                          (count options)))]
    (:value (nth options next-index))))

(defun cycle-selected-rule-match-condition [state direction step]
  (let [terrain-set (selected-terrain-set (:terrain-sets state)
                                          (:selected-terrain-set-index state))
        rule (selected-terrain-rule state)
        center-terrain-id (terrain-rule-center rule)
        condition (get (or (:match rule) {}) direction)
        next-value (step-match-condition-value terrain-set
                                               center-terrain-id
                                               condition
                                               step)]
    (set-selected-rule-match-condition state direction next-value)))

(defun terrain-rule-output-summary [rule]
  (let [layers (or (-> rule :output :layers) [])]
    (str (count layers) " output layers")))

(defun derive-terrain-workspace-state [state]
  (let [terrain-sets (or (:terrain-sets state) [])
        set-index (selected-terrain-set-index terrain-sets
                                              (:selected-terrain-set-index state))
        terrain-set (selected-terrain-set terrain-sets set-index)
        terrain-index (selected-terrain-index terrain-set
                                              (:selected-terrain-index state))
        mask-set-index (selected-mask-set-index (:mask-sets state)
                                                (:selected-mask-set-index state))
        mask-set (selected-mask-set (:mask-sets state) mask-set-index)
        mask-index (selected-mask-index mask-set (:selected-mask-index state))
        state (assoc state
                     :selected-terrain-set-index set-index
                     :selected-terrain-index terrain-index
                     :selected-mask-set-index mask-set-index
                     :selected-mask-index mask-index)
        ruleset-id (selected-terrain-ruleset-id state)
        rule-id (selected-terrain-rule-id
                 (assoc state :selected-terrain-ruleset-id ruleset-id))
        transition-id (selected-transition-id state)
        selected-state (assoc state
                              :selected-terrain-ruleset-id ruleset-id
                              :selected-terrain-rule-id rule-id
                              :selected-terrain-transition-id transition-id)
        selected-rule (selected-terrain-rule selected-state)
        opposing (selected-terrain-standard-opposing selected-state)
        standard-cache (terrain-standard-role-slot-cache-for-state
                        selected-state
                        opposing)]
    (assoc selected-state
           :selected-terrain-rule-exclusive? (= (:exclusive? selected-rule)
                                                true)
           :selected-terrain-rule-output-position
           (selected-rule-output-position selected-state)
           :terrain-standard-role-cache-opposing opposing
           :terrain-standard-role-cache-key (:key standard-cache)
           :terrain-standard-role-slots
           (:slots standard-cache)
           :terrain-list-panel-disabled? (nil? set-index)
           :terrain-detail-panel-disabled? (nil? set-index))))
