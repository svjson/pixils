(ns tilemap-editor.view.menu
  (:require [pixils.ui.menu :as menu]))


(def tilemap-editor-menu-keymap
  {[:key/ctrl :key/shift :key/n] :project/new
   [:key/ctrl :key/o] :project/open
   [:key/ctrl :key/s] :project/save
   [:key/ctrl :key/shift :key/s] :project/save-as
   [:key/ctrl :key/z] :edit/undo
   [:key/ctrl :key/y] :edit/redo
   [:key/ctrl :key/x] :edit/cut
   [:key/ctrl :key/c] :edit/copy
   [:key/ctrl :key/v] :edit/paste
   [:key/ctrl :key/g] :view/toggle-grid
   [:key/ctrl :key/t] :view/toggle-terrain-rules
   [:key/ctrl :key/alt :key/p] {:action :terrain-rules/set-application
                                :payload :preview}
   [:key/ctrl :key/alt :key/b] {:action :terrain-rules/set-application
                                :payload :paint-baked}})

(defun normalized-menu-state [state]
  {:recent-projects (or (:recent-projects state) [])
   :can-undo? (not (empty? (or (get (or (:workbook-history state) {})
                                      :undo)
                                  [])))
   :can-redo? (not (empty? (or (get (or (:workbook-history state) {})
                                      :redo)
                                  [])))
   :undo-label (:label (head (get (or (:workbook-history state) {})
                                :undo)))
   :redo-label (:label (head (get (or (:workbook-history state) {})
                                :redo)))
   :show-grid? (not= (:show-grid? state) false)
   :show-terrain-rules? (not= (:show-terrain-rules? state) false)
   :terrain-rule-application (or (:terrain-rule-application state)
                                 :preview)
   :application-theme (or (:application-theme state)
                          :pixils/windows-3)})

(defun recent-project-label [project]
  (or (:filename project)
      (:path project)
      "Untitled Project"))

(defun theme-payload [value theme variant]
  (merge {:value value
          :theme theme}
         (if variant
           {:variant variant}
           {})))

(defun theme-menu-item [label value theme variant]
  {:label label
   :type :option
   :action :theme/select
   :value value
   :selected-path [:option-state :application-theme]
   :payload (theme-payload value theme variant)})

(defun theme-variant-menu-item [label theme light-value dark-value]
  {:label label
   :items [(theme-menu-item "&Light" light-value theme :light)
           (theme-menu-item "&Dark" dark-value theme :dark)]})

(defun recent-project-menu-items [projects]
  (map (or projects [])
       (fn [project]
         {:label (recent-project-label project)
          :action :project/open-recent
          :payload project})))

(defun recent-project-menu-item [projects]
  (let [projects (or projects [])]
    (if (empty? projects)
      {:label "Recent Projects"
       :disabled? true}
      {:label "Recent Projects"
       :items (recent-project-menu-items projects)})))

(defun tilemap-editor-menu [state]
  (let [state (normalized-menu-state state)]
    {:settings {:mnemonics {:marker "&"}
                :shortcuts {:render true}}
     :items [{:label "&File"
              :items [{:label "&New Project"
                       :action :project/new}
                      {:label "&Open Project"
                       :action :project/open}
                      :separator
                      (recent-project-menu-item (:recent-projects state))
                      :separator
                      {:label "&Save"
                       :action :project/save}
                      {:label "Save &As..."
                       :action :project/save-as}
                      :separator
                      {:label "&Quit"
                       :action :app/quit}]}
             {:label "&Edit"
              :items [{:label (if (:undo-label state)
                                 (str "&Undo " (:undo-label state))
                                 "&Undo")
                       :action :edit/undo
                       :shortcut [:key/ctrl :key/z]
                       :disabled? (not (:can-undo? state))}
                      {:label (if (:redo-label state)
                                 (str "&Redo " (:redo-label state))
                                 "&Redo")
                       :action :edit/redo
                       :shortcut [:key/ctrl :key/y]
                       :disabled? (not (:can-redo? state))}
                      :separator
                      {:label "Cu&t"
                       :action :edit/cut
                       :shortcut [:key/ctrl :key/x]}
                      {:label "&Copy"
                       :action :edit/copy
                       :shortcut [:key/ctrl :key/c]}
                      {:label "&Paste"
                       :action :edit/paste
                       :shortcut [:key/ctrl :key/v]}
                      :separator
                      {:label "Map &Dimensions..."
                       :action :map/edit-dimensions}]}
             {:label "&Options"
              :items [{:label "Show &Grid"
                       :type :toggle
                       :action :view/toggle-grid
                       :selected-path [:option-state :show-grid?]}
                      {:label "Show Terrain Rule &Output"
                       :type :toggle
                       :action :view/toggle-terrain-rules
                       :selected-path [:option-state :show-terrain-rules?]}
                      :separator
                      {:label "Terrain Rule &Application"
                       :items [{:label "&Preview Only"
                                :type :option
                                :action :terrain-rules/set-application
                                :shortcut [:key/ctrl :key/alt :key/p]
                                :value :preview
                                :selected-path [:option-state
                                                :terrain-rule-application]
                                :payload :preview}
                               {:label "&Bake On Paint"
                                :type :option
                                :action :terrain-rules/set-application
                                :shortcut [:key/ctrl :key/alt :key/b]
                                :value :paint-baked
                                :selected-path [:option-state
                                                :terrain-rule-application]
                                :payload :paint-baked}]}
                      :separator
                      {:label "&Theme"
                       :items [(theme-menu-item "Pixils &Default"
                                                :pixils/default
                                                nil
                                                nil)
                               (theme-variant-menu-item "Windows &3"
                                                        'pixils/windows-3
                                                        :pixils/windows-3
                                                        :pixils/windows-3-dark)
                               (theme-variant-menu-item "Windows &95"
                                                        'pixils/windows-95
                                                        :pixils/windows-95
                                                        :pixils/windows-95-dark)
                               (theme-menu-item "&Classic Blue"
                                                :pixils/classic-blue
                                                'pixils/classic-blue
                                                nil)]}]}]}))

(defun tilemap-editor-menu-child [state]
  (let [menu-state (normalized-menu-state state)]
    (merge {:id "tilemap-editor-menu"}
           (menu/make-menu {:style {:width :fill}
                            :state {:option-state menu-state}}
                           (tilemap-editor-menu state)
                           tilemap-editor-menu-keymap))))

(defun tilemap-editor-menu-state [state]
  (normalized-menu-state state))
