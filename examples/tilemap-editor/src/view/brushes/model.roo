(ns tilemap-editor.view.brushes.model
  (:require pixils
            [pixils.tilemap.project.model :as data]))

(def default-pattern-size {:w 3 :h 3})
(def default-pattern-anchor {:x 1 :y 1})

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun clean-name-separators [value index out]
  (if (>= index (count value))
    (trim out)
    (let [ch (substr value index 1)]
      (clean-name-separators
       value
       (inc index)
       (str out
            (if (or (= ch "-") (= ch "_"))
              " "
              ch))))))

(defun ensure-keyword [value]
  (if (keyword? value)
    value
    (keyword value)))

(defun brush-id-exists? [brushes id]
  (> (count (filter (or brushes [])
                    (fn [brush]
                      (= (:id brush) (ensure-keyword id)))))
     0))

(defun brush-id-exists-except? [brushes id exclude-index]
  (> (count (filter (for-indexed [index brush (or brushes [])]
                      {:index index
                       :id (:id brush)})
                    (fn [entry]
                      (and (= (:id entry) (ensure-keyword id))
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-id-from [brushes root suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)]
    (if (brush-id-exists? brushes candidate)
      (unique-id-from brushes
                      root
                      (if suffix (inc suffix) 2))
      candidate)))

(defun unique-brush-id [brushes]
  (unique-id-from (or brushes []) "brush" nil))

(defun unique-id-from-except [items root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword candidate)]
    (if (brush-id-exists-except? items id exclude-index)
      (unique-id-from-except items
                             root
                             exclude-index
                             (if suffix (inc suffix) 2))
      candidate)))

(defun id-from-text [text fallback-label]
  (if (blank? text)
    (keyword (kebab-case fallback-label))
    (keyword (kebab-case (keyword-label text)))))

(defun requested-id [items payload fallback-label exclude-index]
  (let [id (id-from-text (:id payload) fallback-label)]
    (if (brush-id-exists-except? items id exclude-index)
      nil
      id)))

(defun brush-label-from-id [id]
  (capitalize (clean-name-separators (keyword-label id) 0 "")))

(defun duplicate-label [items label label-key suffix]
  (let [root (str (or label "Item") " Copy")
        candidate (if suffix
                    (str root " " suffix)
                    root)]
    (if (> (count (filter (or items [])
                          (fn [item]
                            (= (get item label-key) candidate))))
           0)
      (duplicate-label items label label-key (if suffix (inc suffix) 2))
      candidate)))

(defun make-pattern-brush [id label]
  {:id (keyword id)
   :label label
   :kind :pattern
   :pattern {:size default-pattern-size
             :anchor default-pattern-anchor
             :layers []}})

(defun clamp [value low high]
  (max low (min high value)))

(defun pattern-width [brush]
  (or (-> brush :pattern :size :w) (:w default-pattern-size)))

(defun pattern-height [brush]
  (or (-> brush :pattern :size :h) (:h default-pattern-size)))

(defun pattern-anchor [brush]
  (let [anchor (or (-> brush :pattern :anchor) default-pattern-anchor)
        width (pattern-width brush)
        height (pattern-height brush)]
    {:x (clamp (or (:x anchor) 0) 0 (dec width))
     :y (clamp (or (:y anchor) 0) 0 (dec height))}))

(defun make-empty-pattern-row [width]
  (dotimes [x width] nil))

(defun make-empty-pattern-tiles [width height]
  (dotimes [y height] (make-empty-pattern-row width)))

(defun resize-pattern-row [row width]
  (dotimes [x width]
    (nth (or row []) x)))

(defun resize-pattern-tiles [tiles width height]
  (dotimes [y height]
    (resize-pattern-row (nth (or tiles []) y) width)))

(defun resize-pattern-layer [layer width height]
  (assoc layer :tiles (resize-pattern-tiles (:tiles layer) width height)))

(defun resize-pattern-layers [layers width height]
  (map (or layers [])
       (fn [layer]
         (resize-pattern-layer layer width height))))

(defun tileset-id [tilesets index]
  (let [items (or tilesets [])]
    (when (> (count items) 0)
      (:id (nth items (or index 0))))))

(defun selected-layer-profile [state]
  (data/layer-profile-by-id (:layer-profiles state)
                            (:selected-layer-profile-id state)))

(defun layer-target-for-tileset [state tileset]
  (data/target-layer-for-tileset (selected-layer-profile state) tileset))

(defun tileset-for-layer-target [state target-layer]
  (data/tileset-for-target-layer (selected-layer-profile state) target-layer))

(defun source-layer-for-target [state target-layer]
  (data/layer-profile-layer-by-id (selected-layer-profile state) target-layer))

(defun pattern-layer-id-exists? [layers id]
  (> (count (filter (or layers [])
                    (fn [layer]
                      (= (:id layer) id))))
     0))

(defun pattern-layer-id-exists-except? [layers id exclude-index]
  (> (count (filter (for-indexed [index layer (or layers [])]
                      {:index index
                       :id (:id layer)})
                    (fn [entry]
                      (and (= (:id entry) id)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-pattern-layer-id-from [layers root suffix]
  (let [candidate (keyword (if suffix
                             (str root "-" suffix)
                             root))]
    (if (pattern-layer-id-exists? layers candidate)
      (unique-pattern-layer-id-from layers
                                    root
                                    (if suffix (inc suffix) 2))
      candidate)))

(defun unique-pattern-layer-id [layers]
  (unique-pattern-layer-id-from layers "layer" nil))

(defun unique-pattern-layer-id-except [layers root exclude-index suffix]
  (let [candidate (keyword (if suffix
                             (str root "-" suffix)
                             root))]
    (if (pattern-layer-id-exists-except? layers candidate exclude-index)
      (unique-pattern-layer-id-except layers
                                      root
                                      exclude-index
                                      (if suffix (inc suffix) 2))
      candidate)))

(defun requested-pattern-layer-id [layers payload fallback-label exclude-index]
  (let [id (id-from-text (:id payload) fallback-label)]
    (if (pattern-layer-id-exists-except? layers id exclude-index)
      nil
      id)))

(defun source-layer-options [state]
  (let [profile-layers (or (:layers (selected-layer-profile state)) [])
        layers (if (empty? profile-layers)
                 (:layers state)
                 profile-layers)]
    (for-indexed [index layer (filter (or layers [])
                                      (fn [layer]
                                        (and (not= (:role layer) :derived)
                                             (or (:tileset layer)
                                                 (:terrain-set layer)))))]
      {:value index
       :label (or (:label layer) (str (:id layer)))
       :layer layer})))

(defun source-layer-option [state index]
  (let [options (source-layer-options state)]
    (when (> (count options) 0)
      (nth options (min (or index 0) (dec (count options)))))))

(defun first-pattern-source-layer [state]
  (:layer (source-layer-option state 0)))

(defun pattern-layer-has-source? [state]
  (not (empty? (source-layer-options state))))

(defun selected-source-layer-index [state layer]
  (find-index (source-layer-options state)
              (fn [option]
                (= (:id (:layer option)) (:target-layer layer)))))

(defun pattern-layer-from-source [layer source-layer]
  (merge (dissoc (dissoc layer :tileset) :terrain-set)
         {:target-layer (:id source-layer)
          :data-kind (or (:data-kind source-layer) :tile-ref)}
         (if (:tileset source-layer)
           {:tileset (:tileset source-layer)}
           {})
         (if (:terrain-set source-layer)
           {:terrain-set (:terrain-set source-layer)}
           {})))

(defun normalize-pattern-layer-target [state layer]
  (let [target-layer (:target-layer layer)
        tileset (:tileset layer)
        profile-layer (source-layer-for-target state target-layer)
        tileset-from-target (tileset-for-layer-target state target-layer)
        target-from-tileset (layer-target-for-tileset state tileset)
        layer (if tileset-from-target
                (assoc layer :tileset tileset-from-target)
                layer)]
    (cond
      profile-layer
      (merge layer
             {:data-kind (or (:data-kind profile-layer) :tile-ref)}
             (if (:tileset profile-layer)
               {:tileset (:tileset profile-layer)}
               {})
             (if (:terrain-set profile-layer)
               {:terrain-set (:terrain-set profile-layer)}
               {}))

      (and (nil? target-layer) target-from-tileset)
      (assoc layer
             :target-layer target-from-tileset
             :data-kind :tile-ref)

      :default
      (assoc layer :data-kind (or (:data-kind layer) :tile-ref)))))

(defun normalize-pattern-layers-targets [state layers]
  (map (or layers [])
       (fn [layer]
         (normalize-pattern-layer-target state layer))))

(defun make-pattern-layer [layers state width height]
  (let [source-layer (first-pattern-source-layer state)
        data-kind (or (:data-kind source-layer) :tile-ref)
        target-layer (:id source-layer)
        layer {:id (unique-pattern-layer-id layers)
               :label (str "Layer " (inc (count (or layers []))))
               :kind :tile
               :data-kind data-kind
               :tiles (make-empty-pattern-tiles width height)}]
    (merge layer
           (if target-layer
             {:target-layer target-layer}
             {})
           (if (:tileset source-layer)
             {:tileset (:tileset source-layer)}
             {})
           (if (:terrain-set source-layer)
             {:terrain-set (:terrain-set source-layer)}
             {}))))

(defun make-initial-pattern-layers [state width height]
  (if (not (pattern-layer-has-source? state))
    []
    [(make-pattern-layer [] state width height)]))

(defun make-pattern-brush-for-state [state id label]
  (let [size default-pattern-size]
    (assoc-in (make-pattern-brush id label)
              [:pattern :layers]
              (make-initial-pattern-layers state
                                           (:w size)
                                           (:h size)))))

(defun brush-options [brushes]
  (for-indexed [index brush (or brushes [])]
    {:value index
     :label (:label brush)}))

(defun selected-brush-index [brushes index]
  (let [brushes (or brushes [])]
    (if (empty? brushes)
      nil
      (min (or index 0) (dec (count brushes))))))

(defun selected-brush [brushes index]
  (if-let [selected-index (selected-brush-index brushes index)]
    (nth brushes selected-index)
    nil))

(defun selected-brush-indices [brushes index]
  (if-let [selected-index (selected-brush-index brushes index)]
    [selected-index]
    []))

(defun selected-pattern-layer-index [brush index]
  (let [layers (or (-> brush :pattern :layers) [])]
    (if (empty? layers)
      nil
      (min (or index 0) (dec (count layers))))))

(defun selected-pattern-layer [brush index]
  (if-let [selected-index (selected-pattern-layer-index brush index)]
    (nth (-> brush :pattern :layers) selected-index)
    nil))

(defun selected-pattern-layers [state]
  (or (-> (selected-brush (:brushes state)
                          (:selected-brush-index state))
          :pattern
          :layers)
      []))

(defun selected-pattern-layer-name [brush index]
  (let [layer (selected-pattern-layer brush index)]
    (if layer
      (or (:label layer) (str (:id layer)))
      "")))

(defun selected-pattern-layer-indices [brush index]
  (if-let [selected-index (selected-pattern-layer-index brush index)]
    [selected-index]
    []))

(defun selected-pattern-layer-tileset [brush index]
  (:tileset (selected-pattern-layer brush index)))

(defun pattern-layer-options [brush]
  (for-indexed [index layer (or (-> brush :pattern :layers) [])]
    {:value index
     :label (or (:label layer) (str (:id layer)))}))

(defun tileset-index [tilesets id]
  (if id
    (find-index (or tilesets [])
                (fn [tileset]
                  (= (:id tileset) id)))
    nil))

(defun clamp-pattern-size [value]
  (clamp (or value 1) 1 32))

(defun replace-selected-brush [brushes index brush]
  (for-indexed [brush-index item (or brushes [])]
    (if (= brush-index index)
      brush
      item)))

(defun replace-selected-brush-layers [state layers]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)]
    (if (and brush (= (:kind brush) :pattern))
      (assoc state
             :brushes (replace-selected-brush
                       brushes
                       brush-index
                       (assoc-in brush [:pattern :layers] (or layers []))))
      state)))

(defun remove-pattern-layer-at [layers delete-index]
  (map (filter (for-indexed [index layer (or layers [])]
                 {:index index
                  :layer layer})
               (fn [entry]
                 (not= (:index entry) delete-index)))
       :layer))

(defun selected-pattern-layer-index-after-delete [selected-index delete-index remaining-count]
  (let [selected-index (or selected-index 0)]
    (cond
      (<= remaining-count 0) nil
      (< selected-index delete-index) selected-index
      (> selected-index delete-index) (dec selected-index)
      :default (min delete-index (dec remaining-count)))))

(defun ensure-pattern-brush-editable [state brush-index]
  (let [brushes (or (:brushes state) [])
        brush (selected-brush brushes brush-index)
        first-source-layer (first-pattern-source-layer state)]
    (if (and brush (= (:kind brush) :pattern) first-source-layer)
      (let [layers (normalize-pattern-layers-targets
                    state
                    (or (-> brush :pattern :layers) []))
            brush (assoc-in brush [:pattern :layers] layers)
            layer-index (selected-pattern-layer-index brush
                                                      (:selected-brush-layer-index state))]
        (cond
          (empty? layers)
          (let [layer (make-pattern-layer []
                                          state
                                          (pattern-width brush)
                                          (pattern-height brush))
                next-brush (assoc-in brush [:pattern :layers] [layer])]
            (assoc state
                   :brushes (replace-selected-brush brushes brush-index next-brush)
                   :selected-brush-layer-index 0))

          (nil? (:data-kind (nth layers (or layer-index 0))))
          (let [next-brush (assoc-in brush
                                     [:pattern :layers (or layer-index 0)]
                                     (normalize-pattern-layer-target
                                      state
                                      (nth layers (or layer-index 0))))]
            (assoc state
                   :brushes (replace-selected-brush brushes brush-index next-brush)
                   :selected-brush-layer-index (or layer-index 0)))

          (and (= (:data-kind (nth layers (or layer-index 0))) :tile-ref)
               (nil? (:tileset (nth layers (or layer-index 0)))))
          (let [next-brush (assoc-in brush
                                     [:pattern :layers (or layer-index 0) :tileset]
                                     (:tileset first-source-layer))]
            (assoc state
                   :brushes (replace-selected-brush brushes brush-index next-brush)
                   :selected-brush-layer-index (or layer-index 0)))

          (and (= (:data-kind (nth layers (or layer-index 0))) :terrain)
               (nil? (:terrain-set (nth layers (or layer-index 0)))))
          (let [next-brush (assoc-in brush
                                     [:pattern :layers (or layer-index 0) :terrain-set]
                                     (:terrain-set first-source-layer))]
            (assoc state
                   :brushes (replace-selected-brush brushes brush-index next-brush)
                   :selected-brush-layer-index (or layer-index 0)))

          :default
          (assoc state
                 :brushes (replace-selected-brush brushes brush-index brush)
                 :selected-brush-layer-index (or layer-index 0))))
      state)))

(defun brush-kind-label [brush]
  (case (:kind brush)
    :pattern "Pattern"
    :marching "Marching Rules"
    :terrain-rules "Terrain Rules"
    :default (str (:kind brush))))

(defun pattern-layer-count [brush]
  (count (or (-> brush :pattern :layers) [])))

(defun brush-summary [brush]
  (case (:kind brush)
    :pattern
    (let [size (-> brush :pattern :size)]
      (str (:w size) "x" (:h size) ", "
           (pattern-layer-count brush) " layers"))

    :marching
    (str (count (or (-> brush :ruleset :rules) [])) " rules")

    :terrain-rules
    (str (count (or (-> brush :ruleset :rules) [])) " rules")

    :default ""))

(defun add-pattern-brush! [state]
  (let [brushes (or (:brushes state) [])
        id (unique-brush-id brushes)
        brush (make-pattern-brush-for-state state id (brush-label-from-id id))
        index (count brushes)]
    (assoc state
           :brushes (concat brushes [brush])
           :selected-brush-index index
           :selected-brush-layer-index (selected-pattern-layer-index brush nil))))

(defun add-pattern-brush-with-identity [state payload]
  (let [brushes (or (:brushes state) [])
        label (:name payload)
        id (requested-id brushes payload label nil)]
    (if (and id (not (blank? label)))
      (let [brush (make-pattern-brush-for-state state (keyword-label id) label)
            index (count brushes)]
        (assoc state
               :brushes (concat brushes [brush])
               :selected-brush-index index
               :selected-brush-layer-index
               (selected-pattern-layer-index brush nil)))
      state)))

(defun rename-selected-brush [state payload]
  (let [brushes (or (:brushes state) [])
        index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes index)
        label (:name payload)
        id (when (not (nil? index))
             (requested-id brushes payload label index))]
    (if (and brush id (not (blank? label)))
      (assoc state :brushes (replace-selected-brush brushes
                                                    index
                                                    (assoc brush
                                                           :id id
                                                           :label label)))
      state)))

(defun insert-after [items index item]
  (apply concat
         (for-indexed [item-index current (or items [])]
           (if (= item-index index)
             [current item]
             [current]))))

(defun duplicate-selected-brush [state payload]
  (let [brushes (or (:brushes state) [])
        index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes index)
        label (:name payload)
        id (requested-id brushes payload label nil)]
    (if (and brush id (not (blank? label)))
      (let [duplicate (assoc brush :id id :label label)
            duplicate-index (inc index)]
        (assoc state
               :brushes (insert-after brushes index duplicate)
               :selected-brush-index duplicate-index
               :selected-brush-layer-index
               (selected-pattern-layer-index duplicate nil)))
      state)))

(defun remove-item-at-index [items remove-index]
  (map (filter (for-indexed [index item (or items [])]
                 {:index index
                  :item item})
               (fn [entry]
                 (not= (:index entry) remove-index)))
       :item))

(defun delete-selected-brush [state]
  (let [brushes (or (:brushes state) [])
        index (selected-brush-index brushes (:selected-brush-index state))]
    (if (and (not (nil? index)) (> (count brushes) 0))
      (let [next-brushes (remove-item-at-index brushes index)
            next-index (selected-brush-index next-brushes index)
            brush (selected-brush next-brushes next-index)]
        (assoc state
               :brushes next-brushes
               :selected-brush-index next-index
               :selected-brush-layer-index
               (selected-pattern-layer-index brush nil)
               :brush-selected-tile nil))
      state)))

(defun add-pattern-layer! [state]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)]
    (if (and brush
             (= (:kind brush) :pattern)
             (pattern-layer-has-source? state))
      (let [layers (or (-> brush :pattern :layers) [])
            width (pattern-width brush)
            height (pattern-height brush)
            layer (make-pattern-layer layers state width height)
            layer-index (count layers)
            next-brush (assoc-in brush [:pattern :layers] (concat layers [layer]))]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :selected-brush-layer-index layer-index))
      state)))

(defun add-pattern-layer-with-details [state payload]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        source-option (source-layer-option state (:source-layer-index payload))]
    (if (and brush (= (:kind brush) :pattern) source-option)
      (let [layers (or (-> brush :pattern :layers) [])
            label (:name payload)
            id (requested-pattern-layer-id layers payload label nil)]
        (if (and id (not (blank? label)))
          (let [layer (pattern-layer-from-source
                       {:id id
                        :label label
                        :kind :tile
                        :tiles (make-empty-pattern-tiles (pattern-width brush)
                                                         (pattern-height brush))}
                       (:layer source-option))
                layer-index (count layers)
                next-brush (assoc-in brush
                                     [:pattern :layers]
                                     (concat layers [layer]))]
            (assoc state
                   :brushes (replace-selected-brush brushes brush-index next-brush)
                   :selected-brush-layer-index layer-index
                   :brush-selected-tile nil))
          state))
      state)))

(defun rename-selected-pattern-layer [state payload]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))
        layers (or (-> brush :pattern :layers) [])
        source-option (source-layer-option state (:source-layer-index payload))
        label (:name payload)
        id (when (not (nil? layer-index))
             (requested-pattern-layer-id layers payload label layer-index))]
    (if (and brush source-option id (not (blank? label)))
      (let [layer (pattern-layer-from-source
                   (assoc (nth layers layer-index)
                          :id id
                          :label label)
                   (:layer source-option))
            next-brush (assoc-in brush [:pattern :layers layer-index] layer)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :brush-selected-tile nil))
      state)))

(defun duplicate-selected-pattern-layer [state payload]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))
        layers (or (-> brush :pattern :layers) [])
        source-option (source-layer-option state (:source-layer-index payload))
        label (:name payload)
        id (requested-pattern-layer-id layers payload label nil)]
    (if (and brush
             (not (nil? layer-index))
             source-option
             id
             (not (blank? label)))
      (let [layer (pattern-layer-from-source
                   (assoc (nth layers layer-index)
                          :id id
                          :label label)
                   (:layer source-option))
            next-layers (insert-after layers layer-index layer)
            next-brush (assoc-in brush [:pattern :layers] next-layers)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :selected-brush-layer-index (inc layer-index)
               :brush-selected-tile nil))
      state)))

(defun swap-index-value [index a b]
  (cond
    (= index a) b
    (= index b) a
    :default index))

(defun swap-pattern-layer-indices [layers a b]
  (for-indexed [index layer (or layers [])]
    (cond
      (= index a) (nth layers b)
      (= index b) (nth layers a)
      :default layer)))

(defun insert-item-at-index [items insert-index item]
  (let [items (or items [])]
    (if (>= insert-index (count items))
      (concat items [item])
      (apply concat
             (for-indexed [index existing items]
               (if (= index insert-index)
                 [item existing]
                 [existing]))))))

(defun reorder-items [items from-index to-index]
  (let [items (or items [])]
    (if (= from-index to-index)
      items
      (insert-item-at-index (remove-item-at-index items from-index)
                            to-index
                            (nth items from-index)))))

(defun reorder-index-value [index from-index to-index]
  (cond
    (= index from-index) to-index
    (and (< from-index index) (<= index to-index)) (dec index)
    (and (> from-index index) (>= index to-index)) (inc index)
    :default index))

(defun layer-move-target-index [command index layer-count]
  (case command
    :move-up
    (when (> index 0) (dec index))

    :move-down
    (when (< index (dec layer-count)) (inc index))

    :default nil))

(defun apply-pattern-layer-move-command [state payload]
  (let [command (:command payload)
        index (:index payload)
        layers (selected-pattern-layers state)
        target-index (layer-move-target-index command index (count layers))]
    (if (nil? target-index)
      state
      (let [next-layers (swap-pattern-layer-indices layers index target-index)
            next-index (swap-index-value (or (:selected-brush-layer-index state) 0)
                                         index
                                         target-index)]
        (assoc (replace-selected-brush-layers state next-layers)
               :selected-brush-layer-index next-index
               :brush-selected-tile nil)))))

(defun apply-pattern-layer-reorder [state payload]
  (let [from-index (:from-index payload)
        to-index (:to-index payload)
        layers (selected-pattern-layers state)]
    (if (and (not (nil? from-index))
             (not (nil? to-index))
             (>= from-index 0)
             (< from-index (count layers))
             (>= to-index 0)
             (< to-index (count layers)))
      (let [next-layers (reorder-items layers from-index to-index)
            next-index (reorder-index-value
                        (or (:selected-brush-layer-index state) 0)
                        from-index
                        to-index)]
        (assoc (replace-selected-brush-layers state next-layers)
               :selected-brush-layer-index next-index
               :brush-selected-tile nil))
      state)))

(defun toggle-hidden-layer [hidden-layer-indices index]
  (let [hidden-layer-indices (or hidden-layer-indices [])]
    (if (contains? hidden-layer-indices index)
      (filter hidden-layer-indices (fn [item]
                                     (not= item index)))
      (concat hidden-layer-indices [index]))))

(defun clear-pattern-layer! [state]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))]
    (if (and brush
             (= (:kind brush) :pattern)
             (not (nil? layer-index)))
      (let [next-brush (assoc-in brush
                                 [:pattern :layers layer-index :tiles]
                                 (make-empty-pattern-tiles (pattern-width brush)
                                                           (pattern-height brush)))]
        (assoc state :brushes (replace-selected-brush brushes
                                                      brush-index
                                                      next-brush)))
      state)))

(defun delete-pattern-layer! [state delete-index]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layers (or (-> brush :pattern :layers) [])]
    (if (and brush
             (= (:kind brush) :pattern)
             (> (count layers) 1)
             (not (nil? delete-index))
             (>= delete-index 0)
             (< delete-index (count layers)))
      (let [next-layers (remove-pattern-layer-at layers delete-index)
            next-layer-index (selected-pattern-layer-index-after-delete
                              (:selected-brush-layer-index state)
                              delete-index
                              (count next-layers))
            next-brush (assoc-in brush [:pattern :layers] next-layers)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :selected-brush-layer-index next-layer-index
               :brush-selected-tile nil))
      state)))

(defun apply-pattern-layer-delete-result! [state payload]
  (if (and (= (:choice payload) :dialog/ok)
           (= (-> payload :payload :operation) :delete-pattern-layer))
    (delete-pattern-layer! state (-> payload :payload :index))
    state))

(defun set-pattern-size! [state dimension value]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)]
    (if (and brush (= (:kind brush) :pattern))
      (let [width (if (= dimension :w)
                    (clamp-pattern-size value)
                    (pattern-width brush))
            height (if (= dimension :h)
                     (clamp-pattern-size value)
                     (pattern-height brush))
            layers (resize-pattern-layers (-> brush :pattern :layers)
                                          width
                                          height)
            anchor {:x (clamp (or (-> brush :pattern :anchor :x) 0)
                              0
                              (dec width))
                    :y (clamp (or (-> brush :pattern :anchor :y) 0)
                              0
                              (dec height))}
            next-brush (-> brush
                           (assoc-in [:pattern :size] {:w width :h height})
                           (assoc-in [:pattern :anchor] anchor)
                           (assoc-in [:pattern :layers] layers))]
        (assoc state :brushes (replace-selected-brush brushes
                                                      brush-index
                                                      next-brush)))
      state)))

(defun set-pattern-anchor! [state dimension value]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)]
    (if (and brush (= (:kind brush) :pattern))
      (let [current (pattern-anchor brush)
            width (pattern-width brush)
            height (pattern-height brush)
            anchor {:x (if (= dimension :x)
                         (clamp (or value 0) 0 (dec width))
                         (:x current))
                    :y (if (= dimension :y)
                         (clamp (or value 0) 0 (dec height))
                         (:y current))}
            next-brush (assoc-in brush [:pattern :anchor] anchor)]
        (assoc state :brushes (replace-selected-brush brushes
                                                      brush-index
                                                      next-brush)))
      state)))

(defun set-pattern-layer-tileset! [state tileset-index]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))
        tileset (tileset-id (:tilesets state) tileset-index)]
    (if (and brush (not (nil? layer-index)) tileset)
      (let [target-layer (layer-target-for-tileset state tileset)
            layer (assoc (nth (-> brush :pattern :layers) layer-index)
                         :tileset tileset)
            layer (if target-layer
                    (assoc layer :target-layer target-layer)
                    (dissoc layer :target-layer))
            next-brush (assoc-in brush
                                 [:pattern :layers layer-index]
                                 layer)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :brush-selected-tile nil))
      state)))

(defun set-pattern-layer-terrain-set! [state terrain-set-index]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))
        terrain-set (data/terrain-set-key (:terrain-sets state) terrain-set-index)]
    (if (and brush (not (nil? layer-index)) terrain-set)
      (let [layer (assoc (nth (-> brush :pattern :layers) layer-index)
                         :data-kind :terrain
                         :terrain-set terrain-set)
            next-brush (assoc-in brush
                                 [:pattern :layers layer-index]
                                 layer)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :brush-selected-tile nil))
      state)))

(defun set-pattern-layer-source! [state source-layer-index]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))
        source-option (source-layer-option state source-layer-index)]
    (if (and brush (not (nil? layer-index)) source-option)
      (let [layer (pattern-layer-from-source
                   (nth (-> brush :pattern :layers) layer-index)
                   (:layer source-option))
            next-brush (assoc-in brush [:pattern :layers layer-index] layer)]
        (assoc state
               :brushes (replace-selected-brush brushes brush-index next-brush)
               :brush-selected-tile nil))
      state)))

(defun selected-pattern-layer-data-kind [brush index]
  (or (:data-kind (selected-pattern-layer brush index)) :tile-ref))

(defun selected-pattern-layer-terrain-set [brush index]
  (:terrain-set (selected-pattern-layer brush index)))

(defun set-pattern-tile! [state x y tile-ref]
  (let [brushes (or (:brushes state) [])
        brush-index (selected-brush-index brushes (:selected-brush-index state))
        brush (selected-brush brushes brush-index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))]
    (if (and brush
             (not (nil? layer-index))
             (>= x 0)
             (< x (pattern-width brush))
             (>= y 0)
             (< y (pattern-height brush)))
      (let [next-brush (assoc-in brush
                                 [:pattern :layers layer-index :tiles y x]
                                 tile-ref)]
        (assoc state :brushes (replace-selected-brush brushes
                                                      brush-index
                                                      next-brush)))
      state)))

(defun derive-brush-workspace-state [state]
  (let [index (selected-brush-index (:brushes state)
                                    (:selected-brush-index state))
        state (ensure-pattern-brush-editable state index)
        brush (selected-brush (:brushes state) index)
        layer-index (selected-pattern-layer-index brush
                                                  (:selected-brush-layer-index state))]
    (assoc state
           :selected-brush-index index
           :selected-brush-layer-index layer-index
           :brush-detail-panel-disabled? (nil? index)
           :brush-layer-panel-disabled? (nil? layer-index))))
