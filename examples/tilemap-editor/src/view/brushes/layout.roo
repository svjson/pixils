(ns tilemap-editor.view.brushes.layout
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [pixils.ui.number-input :as ni]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.workbook :as editor-workbook]
            [tilemap-editor.view.brushes.dialogs :as brush-dialogs]
            [tilemap-editor.view.brushes.model :as model]
            [tilemap-editor.view.layers.controls :as layer-controls]
            tilemap-editor.view.tilemap.canvas
            tilemap-editor.view.tilemap.controls
            [tilemap-editor.view.tilemap.palette :as tile-palette]))

(def brush-list-row-height 24)

(defun brush-context-menu []
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Edit Brush"
            :action :brush/context-dummy
            :payload {:command :edit}}
           {:label "Duplicate Brush"
            :action :brush/context-dummy
            :payload {:command :duplicate}}
           :separator
           {:label "Delete Brush"
            :action :brush/context-dummy
            :payload {:command :delete}}]})

(defcomponent brush-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height brush-list-row-height
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (menu/open-context-menu! (brush-context-menu)
                                               (:global-position event)
                                               state
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :brush/context-command
                                       {:index (:index state)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value (ui/bind-state :kind-label)}}]})

(defun brush-row-child [index option]
  {:mode 'brush-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :kind-label (:kind-label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun brush-options [brushes]
  (map (model/brush-options brushes)
       (fn [option]
         (assoc option
                :kind-label (model/brush-kind-label
                             (nth (or brushes []) (:value option)))))))

(defun brush-list-child [brushes selected-index]
  (let [brushes (or brushes [])
        options (brush-options brushes)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height brush-list-row-height
              :visible-rows (max 1 (count options))
              :content-width 220
              :disabled? (empty? options)
              :selected-indices (model/selected-brush-indices brushes selected-index)
              :force-selection? true
              :item-child brush-row-child})))

(defcomponent brush-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-brushes nil
                  :rendered-selected-index nil))
   :update (fn [state ctx]
             (let [brushes (or (:brushes state) [])
                   selected-index (:selected-brush-index state)]
               (do
                 (when (or (not= brushes (:rendered-brushes state))
                           (not= selected-index (:rendered-selected-index state)))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (brush-list-child brushes
                                                               selected-index))))
                 (assoc state
                        :rendered-brushes brushes
                        :rendered-selected-index selected-index))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :brush/select
                                       (-> event :payload :value))
                             state))}
   :children [(merge {:id "list-box"}
                     (brush-list-child [] nil))]})

(defun make-brush-list-panel []
  (hp/make {:title "Project Brushes"
            :style {:width 260
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :brush/add)
                                             state))}]
            :body-style {:padding 8
                         :height :fill}
            :state {:brushes (ui/bind-state :brushes)
                    :selected-brush-index (ui/bind-state :selected-brush-index)
                    :brush-detail-panel-disabled?
                    (ui/bind-state :brush-detail-panel-disabled?)}
            :body-state {:brushes (ui/bind-state :brushes)
                         :selected-brush-index (ui/bind-state :selected-brush-index)}
            :children [{:mode 'brush-list
                        :state {:brushes (ui/bind-state :brushes)
                                :selected-brush-index (ui/bind-state :selected-brush-index)}}]}))

(defcomponent pattern-size-input
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :on {:number-input/change (fn [state event ctx]
                               (do
                                 (ui/emit! (:view ctx)
                                           :brush/size-change
                                           {:dimension (:dimension state)
                                            :value (-> event :payload :value)})
                                 state))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 48}
               :state {:value (ui/bind-state :label)}}
              (ni/make {:value (ui/bind-state :value)
                        :min 1
                        :max 32
                        :step 1
                        :style {:width 64
                                :height 22}})]})

(defun pattern-size-input-child [dimension label value]
  {:mode 'pattern-size-input
   :state {:dimension dimension
           :label label
           :value value}})

(defcomponent pattern-anchor-input
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :on {:number-input/change (fn [state event ctx]
                               (do
                                 (ui/emit! (:view ctx)
                                           :brush/anchor-change
                                           {:dimension (:dimension state)
                                            :value (-> event :payload :value)})
                                 state))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 48}
               :state {:value (ui/bind-state :label)}}
              (ni/make {:value (ui/bind-state :value)
                        :min 0
                        :max (ui/bind-state :max-value)
                        :step 1
                        :style {:width 64
                                :height 22}})]})

(defun pattern-anchor-input-child [dimension label value max-value]
  {:mode 'pattern-anchor-input
   :state {:dimension dimension
           :label label
           :value value
           :max-value max-value}})

(defun pattern-layer-controls []
  (layer-controls/make-layer-controls
   {:title "Layers"
    :style {:width :fill}
    :state {:layers (ui/bind-state :brush-editor-layers)
            :hidden-layer-indices
            (ui/bind-state :brush-hidden-layer-indices)
            :selected-layer-index
            (ui/bind-state :selected-layer-index)
            :selected-layer-label
            (ui/bind-state :selected-layer-label)}
    :on {:layer/select (fn [state event ctx]
                         (do
                           (ui/stop-propagation! event)
                           (ui/emit! (:view ctx)
                                     :brush/layer-select
                                     (:payload event))
                           state))
         :layer/add (fn [state event ctx]
                      (do
                        (ui/emit! (:view ctx)
                                  :brush/layer-add)
                        state))
         :layer/reorder (fn [state event ctx]
                          (do
                            (ui/stop-propagation! event)
                            (ui/emit! (:view ctx)
                                      :brush/layer-reorder
                                      (:payload event))
                            state))
         :layer/toggle-visible
         (fn [state event ctx]
           (do
             (ui/stop-propagation! event)
             (ui/emit! (:view ctx)
                       :brush/layer-toggle-visible
                       (:payload event))
             state))
         :layer/context-command
         (fn [state event ctx]
           (do
             (ui/stop-propagation! event)
             (ui/emit! (:view ctx)
                       :brush/layer-context-command
                       (:payload event))
             state))}}))

(defcomponent pattern-controls
  {:style {:width 188
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [brush (model/selected-brush (:brushes state)
                                               (:selected-brush-index state))
                   anchor (model/pattern-anchor brush)
                   width (model/pattern-width brush)
                   height (model/pattern-height brush)]
               (assoc state
                      :width width
                      :height-value height
                      :anchor-x (:x anchor)
                      :anchor-y (:y anchor)
                      :anchor-max-x (dec width)
                      :anchor-max-y (dec height)
                      :brush-editor-layers (or (-> brush :pattern :layers) [])
                      :brush-hidden-layer-indices
                      (or (:brush-hidden-layer-indices state) [])
                      :selected-layer-index
                      (:selected-brush-layer-index state)
                      :selected-layer-label
                      (model/selected-pattern-layer-name
                       brush
                       (:selected-brush-layer-index state)))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             state))}
   :children [{:mode 'ui/text
               :class :ui/title
               :state {:value "Pattern"}}
              (pattern-size-input-child :w "Width" (ui/bind-state :width))
              (pattern-size-input-child :h "Height" (ui/bind-state :height-value))
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Anchor"}}
              (pattern-anchor-input-child :x
                                          "X"
                                          (ui/bind-state :anchor-x)
                                          (ui/bind-state :anchor-max-x))
              (pattern-anchor-input-child :y
                                          "Y"
                                          (ui/bind-state :anchor-y)
                                          (ui/bind-state :anchor-max-y))
              (pattern-layer-controls)]})

(defcomponent brush-source-palette
  {:style {:width 220
           :height :fill}
   :update (fn [state ctx]
             (let [brush (model/selected-brush (:brushes state)
                                               (:selected-brush-index state))
                   layer (model/selected-pattern-layer
                          brush
                          (:selected-brush-layer-index state))
                   disabled? (or (:brush-layer-panel-disabled? state)
                                 (nil? layer))]
               (assoc state
                      :palette-layers (if layer [layer] [])
                      :palette-layer-index 0
                      :palette-disabled? disabled?)))
   :on {:tile-select/change (fn [state event ctx]
                              (do
                                (ui/stop-propagation! event)
                                (ui/emit! (:view ctx)
                                          :brush/tile-select
                                          (-> event :payload :value))
                                state))}
   :children [{:mode 'tile-palette-list
               :state {:selected-tile (ui/bind-state :brush-selected-tile)
                       :tilesets (ui/bind-state :tilesets)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :selected-layer-index
                       (ui/bind-state :palette-layer-index)
                       :layers (ui/bind-state :palette-layers)
                       :disabled? (ui/bind-state :palette-disabled?)}}]})

(defun sync-brush-map-layers [state]
  (let [source (:brush-map-source-layers state)
        editor-layers (:brush-map-layers state)]
    (if (and source (not= editor-layers source))
      (change-brush-state
       state
       "Edit brush map"
       (model/replace-selected-brush-layers state editor-layers))
      state)))

(defun tileset-tile-size [tilesets tileset]
  (let [definition (data/tileset-definition tilesets tileset)]
    (data/map-tile-dim (or (:tile-size definition) data/tile-dim))))

(defun terrain-set-tileset [terrain-sets terrain-set]
  (:tileset (data/terrain-set-definition terrain-sets terrain-set)))

(defun pattern-layer-tile-size [state layer]
  (if (= (:data-kind layer) :terrain)
    (tileset-tile-size (:tilesets state)
                       (terrain-set-tileset (:terrain-sets state)
                                            (:terrain-set layer)))
    (tileset-tile-size (:tilesets state) (:tileset layer))))

(defun selected-brush-map-tile-size [state brush]
  (let [layer-index (model/selected-pattern-layer-index
                     brush
                     (:selected-brush-layer-index state))
        layer (when (not (nil? layer-index))
                (nth (or (-> brush :pattern :layers) []) layer-index))]
    (if layer
      (pattern-layer-tile-size state layer)
      data/tile-dim)))

(defun brush-map-editor-children []
  [{:mode 'map-area
    :style {:height :fill}
    :state {:selected-tile (ui/bind-state :selected-tile)
            :selected-map-id :brush-pattern
            :map-width (ui/bind-state :map-width)
            :map-height (ui/bind-state :map-height)
            :tile-size (ui/bind-state :tile-size)
            :tilesets (ui/bind-state :tilesets)
            :mask-sets []
            :transition-mask-diagnostics nil
            :terrain-sets (ui/bind-state :terrain-sets)
            :rulesets []
            :layer-profiles (ui/bind-state :layer-profiles)
            :selected-layer-profile-id
            (ui/bind-state :selected-layer-profile-id)
            :brushes []
            :selected-brush-index nil
            :map-palette-tab :tiles
            :map-tool (ui/bind-state :map-tool)
            :map-selection (ui/bind-state :map-selection)
            :map-line (ui/bind-state :map-line)
            :map-hover-cell (ui/bind-state :map-hover-cell)
            :selected-layer-index
            (ui/bind-state :selected-layer-index)
            :selected-layer-label nil
            :workbook-history (ui/bind-state :workbook-history)
            :layers (ui/bind-state :brush-map-layers)
            :terrain-rule-application
            (ui/bind-state :terrain-rule-application)
            :terrain-stamp-layers
            (ui/bind-state :terrain-stamp-layers)
            :terrain-stamp-replacements
            (ui/bind-state :terrain-stamp-replacements)
            :hidden-layer-indices
            (ui/bind-state :brush-hidden-layer-indices)
            :map-offset (ui/bind-state :map-offset)
            :zoom (ui/bind-state :zoom)
            :show-terrain-rules?
            (ui/bind-state :show-terrain-rules?)
            :show-grid? (ui/bind-state :show-grid?)}}
   {:mode 'map-view-controls
    :state {:zoom (ui/bind-state :zoom)
            :tile-size (ui/bind-state :tile-size)
            :zoom-label (ui/bind-state :zoom-label)}}])

(defun derive-brush-map-editor-state [state]
  (let [state (sync-brush-map-layers state)
        brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))
        layers (or (-> brush :pattern :layers) [])
        width (model/pattern-width brush)
        height (model/pattern-height brush)]
    (assoc state
           :brush-map-source-layers layers
           :brush-map-layers layers
           :map-width width
           :map-height height
           :tile-size (selected-brush-map-tile-size state brush)
           :selected-layer-index
           (:selected-brush-layer-index state)
           :selected-tile (:brush-selected-tile state)
           :map-tool (or (:map-tool state) :paint)
           :map-offset (or (:map-offset state) {:x 0 :y 0})
           :zoom (or (:zoom state) 1)
           :show-grid? true
           :show-terrain-rules? false
           :terrain-rule-application nil
           :terrain-stamp-layers []
           :terrain-stamp-replacements [])))

(defcomponent brush-map-editor
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (derive-brush-map-editor-state state))
   :children (brush-map-editor-children)})

