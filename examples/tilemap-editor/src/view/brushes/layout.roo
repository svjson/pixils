(defun open-pattern-layer-delete-confirm-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))
        layer-index (model/selected-pattern-layer-index
                     brush
                     (:selected-brush-layer-index state))
        layers (or (-> brush :pattern :layers) [])
        layer (when (not (nil? layer-index)) (nth layers layer-index))
        label (or (:label layer) (str (:id layer)))]
    (if (and layer (> (count layers) 1))
      (do
        (dialog/open-confirm!
         ctx
         {:title "Delete Brush Layer"
          :body {:mode 'ui/text
                 :style {:width :fill}
                 :state {:value (str "Delete brush layer \"" label "\"?")}}
          :buttons [:dialog/cancel
                    {:type :dialog/ok
                     :label "Delete"}]
          :result-event :brush/layer-delete-confirm-result
          :payload {:operation :delete-pattern-layer
                    :index layer-index}})
        state)
      state)))

(defun open-brush-add-dialog! [state ctx]
  (let [id (model/unique-brush-id (:brushes state))]
    (brush-dialogs/open-brush-dialog!
     state
     ctx
     :add
     "Add Brush"
     {:id id
      :name (model/brush-label-from-id id)}
     "Add")))

(defun open-brush-edit-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))]
    (if brush
      (brush-dialogs/open-brush-dialog!
       state
       ctx
       :edit
       "Edit Brush"
       {:id (model/keyword-label (:id brush))
        :name (:label brush)}
       "Save")
      state)))

(defun open-brush-duplicate-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))]
    (if brush
      (let [name (model/duplicate-label (:brushes state)
                                        (:label brush)
                                        :label
                                        nil)
            id (model/unique-id-from-except (:brushes state)
                                            (kebab-case name)
                                            nil
                                            nil)]
        (brush-dialogs/open-brush-dialog!
         state
         ctx
         :duplicate
         "Duplicate Brush"
         {:id id
          :name name}
         "Duplicate"))
      state)))

(defun open-brush-delete-confirm-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))]
    (if brush
      (do
        (dialog/open-confirm!
         ctx
         {:title "Delete Brush"
          :body {:mode 'ui/text
                 :style {:width :fill}
                 :state {:value (str "Delete brush \""
                                     (or (:label brush) (:id brush))
                                     "\"?")}}
          :buttons [:dialog/cancel
                    {:type :dialog/ok
                     :label "Delete"}]
          :result-event :brush/delete-confirm-result})
        state)
      state)))

(defun selected-pattern-layer-details [state]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))
        index (model/selected-pattern-layer-index
               brush
               (:selected-brush-layer-index state))]
    (when (not (nil? index))
      (nth (or (-> brush :pattern :layers) []) index))))

(defun open-brush-layer-add-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))
        layers (or (-> brush :pattern :layers) [])
        id (model/unique-pattern-layer-id layers)]
    (brush-dialogs/open-brush-layer-dialog!
     state
     ctx
     :add
     "Add Brush Layer"
     {:id (model/keyword-label id)
      :name (str "Layer " (inc (count layers)))}
     0
     "Add")))

(defun open-brush-layer-edit-dialog! [state ctx]
  (let [layer (selected-pattern-layer-details state)]
    (if layer
      (brush-dialogs/open-brush-layer-dialog!
       state
       ctx
       :edit
       "Edit Brush Layer"
       {:id (model/keyword-label (:id layer))
        :name (or (:label layer) (str (:id layer)))}
       (model/selected-source-layer-index state layer)
       "Save")
      state)))

(defun open-brush-layer-tileset-dialog! [state ctx]
  (let [layer (selected-pattern-layer-details state)]
    (if layer
      (brush-dialogs/open-brush-layer-source-dialog!
       state
       ctx
       :tileset
       "Change Brush Layer Tileset"
       (model/tileset-index (:tilesets state) (:tileset layer)))
      state)))

(defun open-brush-layer-terrain-set-dialog! [state ctx]
  (let [layer (selected-pattern-layer-details state)]
    (if layer
      (brush-dialogs/open-brush-layer-source-dialog!
       state
       ctx
       :terrain-set
       "Change Brush Layer Terrain Set"
       (data/terrain-set-index (:terrain-sets state) (:terrain-set layer)))
      state)))

(defun open-brush-layer-duplicate-dialog! [state ctx]
  (let [brush (model/selected-brush (:brushes state)
                                    (:selected-brush-index state))
        layer (selected-pattern-layer-details state)
        layers (or (-> brush :pattern :layers) [])]
    (if layer
      (let [name (model/duplicate-label layers
                                        (or (:label layer) (str (:id layer)))
                                        :label
                                        nil)
            id (model/unique-pattern-layer-id-except layers
                                                     (kebab-case name)
                                                     nil
                                                     nil)]
        (brush-dialogs/open-brush-layer-dialog!
         state
         ctx
         :duplicate
         "Duplicate Brush Layer"
         {:id (model/keyword-label id)
          :name name}
         (model/selected-source-layer-index state layer)
         "Duplicate"))
      state)))

(defun change-brush-state [state label next-state]
  (editor-workbook/change-to state label next-state))

(defun apply-brush-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (case (:operation payload)
      :add
      (change-brush-state state
                          "Add brush"
                          (model/add-pattern-brush-with-identity state payload))

      :edit
      (change-brush-state state
                          "Edit brush"
                          (model/rename-selected-brush state payload))

      :duplicate
      (change-brush-state state
                          "Duplicate brush"
                          (model/duplicate-selected-brush state payload))

      :default state)
    state))

(defun apply-brush-layer-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (case (:operation payload)
      :add
      (change-brush-state state
                          "Add brush layer"
                          (model/add-pattern-layer-with-details state payload))

      :edit
      (change-brush-state state
                          "Edit brush layer"
                          (model/rename-selected-pattern-layer state payload))

      :duplicate
      (change-brush-state state
                          "Duplicate brush layer"
                          (model/duplicate-selected-pattern-layer state payload))

      :default state)
    state))

(defun apply-brush-layer-source-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (case (:operation payload)
      :tileset
      (change-brush-state
       state
       "Change brush layer tileset"
       (model/set-pattern-layer-tileset! state (:source-index payload)))

      :terrain-set
      (change-brush-state
       state
       "Change brush layer terrain set"
       (model/set-pattern-layer-terrain-set! state (:source-index payload)))

      :default state)
    state))

(defun apply-brush-delete-result [state payload]
  (if (= (:choice payload) :dialog/ok)
    (change-brush-state state "Delete brush" (model/delete-selected-brush state))
    state))

(defun select-brush-index [state index]
  (let [brush (model/selected-brush (:brushes state) index)]
    (assoc state
           :selected-brush-index index
           :selected-brush-layer-index
           (model/selected-pattern-layer-index brush nil)
           :brush-selected-tile nil)))

(defun apply-brush-context-command [state payload ctx]
  (let [state (select-brush-index state (:index payload))]
    (case (:command payload)
      :edit (open-brush-edit-dialog! state ctx)
      :duplicate (open-brush-duplicate-dialog! state ctx)
      :delete (open-brush-delete-confirm-dialog! state ctx)
      :default state)))

(defun apply-brush-layer-context-command [state payload ctx]
  (let [state (assoc state
                     :selected-brush-layer-index (:index payload)
                     :brush-selected-tile nil)
        command (:command payload)]
    (case command
      :rename (open-brush-layer-edit-dialog! state ctx)
      :tileset (open-brush-layer-tileset-dialog! state ctx)
      :terrain-set (open-brush-layer-terrain-set-dialog! state ctx)
      :duplicate (open-brush-layer-duplicate-dialog! state ctx)
      :delete (open-pattern-layer-delete-confirm-dialog! state ctx)
      :move-up (change-brush-state
                state
                "Move brush layer"
                (model/apply-pattern-layer-move-command state payload))
      :move-down (change-brush-state
                  state
                  "Move brush layer"
                  (model/apply-pattern-layer-move-command state payload))
      :default state)))

(defcomponent brush-definition-workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row
                    :gap 8}}
   :init (fn [state ctx]
           (model/derive-brush-workspace-state state))
   :update (fn [state ctx]
             (model/derive-brush-workspace-state state))
   :on {:brush/add (fn [state event ctx]
                     (open-brush-add-dialog! state ctx))
        :brush/edit (fn [state event ctx]
                      (open-brush-edit-dialog! state ctx))
        :brush/duplicate (fn [state event ctx]
                           (open-brush-duplicate-dialog! state ctx))
        :brush/delete (fn [state event ctx]
                        (open-brush-delete-confirm-dialog! state ctx))
        :brush/dialog-result (fn [state event ctx]
                               (apply-brush-dialog-result state
                                                          (:payload event)))
        :brush/delete-confirm-result
        (fn [state event ctx]
          (apply-brush-delete-result state (:payload event)))
        :brush/context-command
        (fn [state event ctx]
          (apply-brush-context-command state (:payload event) ctx))
        :brush/select (fn [state event ctx]
                        (select-brush-index state (:payload event)))
        :brush/layer-add (fn [state event ctx]
                           (open-brush-layer-add-dialog! state ctx))
        :brush/layer-edit (fn [state event ctx]
                            (open-brush-layer-edit-dialog! state ctx))
        :brush/layer-duplicate (fn [state event ctx]
                                 (open-brush-layer-duplicate-dialog! state ctx))
        :brush/layer-dialog-result
        (fn [state event ctx]
          (apply-brush-layer-dialog-result state (:payload event)))
        :brush/layer-source-dialog-result
        (fn [state event ctx]
          (apply-brush-layer-source-dialog-result state (:payload event)))
        :brush/layer-clear (fn [state event ctx]
                             (change-brush-state state
                                                 "Clear brush layer"
                                                 (model/clear-pattern-layer!
                                                  state)))
        :brush/layer-delete (fn [state event ctx]
                              (open-pattern-layer-delete-confirm-dialog! state ctx))
        :brush/layer-delete-confirm-result
        (fn [state event ctx]
          (change-brush-state
           state
           "Delete brush layer"
           (model/apply-pattern-layer-delete-result! state (:payload event))))
        :brush/layer-reorder
        (fn [state event ctx]
          (change-brush-state
           state
           "Reorder brush layer"
           (model/apply-pattern-layer-reorder state (:payload event))))
        :brush/layer-toggle-visible
        (fn [state event ctx]
          (assoc state
                 :brush-hidden-layer-indices
                 (model/toggle-hidden-layer (:brush-hidden-layer-indices state)
                                            (:payload event))))
        :brush/layer-context-command
        (fn [state event ctx]
          (apply-brush-layer-context-command state (:payload event) ctx))
        :brush/layer-select (fn [state event ctx]
                              (assoc state
                                     :selected-brush-layer-index (:payload event)
                                     :brush-selected-tile nil))
        :brush/layer-tileset-change
        (fn [state event ctx]
          (change-brush-state
           state
           "Change brush layer tileset"
           (model/set-pattern-layer-tileset! state (:payload event))))
        :brush/layer-terrain-set-change
        (fn [state event ctx]
          (change-brush-state
           state
           "Change brush layer terrain set"
           (model/set-pattern-layer-terrain-set! state (:payload event))))
        :brush/layer-source-change
        (fn [state event ctx]
          (change-brush-state
           state
           "Change brush layer target"
           (model/set-pattern-layer-source! state (:payload event))))
        :brush/size-change (fn [state event ctx]
                             (let [payload (:payload event)]
                               (change-brush-state
                                state
                                "Resize brush"
                                (model/set-pattern-size! state
                                                         (:dimension payload)
                                                         (:value payload)))))
        :brush/anchor-change (fn [state event ctx]
                               (let [payload (:payload event)]
                                 (change-brush-state
                                  state
                                  "Change brush anchor"
                                  (model/set-pattern-anchor! state
                                                             (:dimension payload)
                                                             (:value payload)))))
        :brush/tile-select (fn [state event ctx]
                             (assoc state :brush-selected-tile (:payload event)))}
   :children [(make-brush-list-panel)
              (make-brush-detail-panel)]})
