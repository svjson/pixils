(ns tilemap-editor.view.tilemap.renderer
  (:require [pixils.image :as img]
            [pixils.render :as r]
            [tilemap-editor.model.data :as data]
            [tilemap-editor.model.tilemap :as tm]))



;; Tile rendering

(defun centered-pos [rect width height]
  {:x (+ (:x rect) (/ (- (:w rect) width) 2))
   :y (+ (:y rect) (/ (- (:h rect) height) 2))})

(defun fit-scale [source-width source-height rect]
  (min (/ (:w rect) source-width)
       (/ (:h rect) source-height)))

(defun draw-color-tile! [tile rect]
  (r/rect! rect {:fill true
                 :color (:color tile)}))

(defun draw-image-tile! [tile rect]
  (let [dim (img/size (:image tile))
        scale (fit-scale (:w dim) (:h dim) rect)
        width (* (:w dim) scale)
        height (* (:h dim) scale)]
    (do
      (r/rect! rect {:fill true
                     :color {:r 0x12 :g 0x15 :b 0x18}})
      (r/image! (:image tile)
                {:pos (centered-pos rect width height)
                 :scale scale}))))

(defun draw-sprite-tile! [tile rect]
  (let [source (:source tile)
        scale (fit-scale (:w source) (:h source) rect)
        width (* (:w source) scale)
        height (* (:h source) scale)]
    (r/image! (:image tile)
              {:pos (centered-pos rect width height)
               :source source
               :scale scale})))

(defun draw-tile! [tile rect]
  (cond
    (= (:type tile) :color)
    (draw-color-tile! tile rect)

    (= (:type tile) :image)
    (draw-image-tile! tile rect)

    (= (:type tile) :sprite)
    (draw-sprite-tile! tile rect)

    :default
    (r/rect! rect {:fill true
                   :color {:r 0xff :g 0x00 :b 0xff}})))

(defun tile-rect [x y offset zoom]
  (let [size (tm/scaled-tile-size zoom)]
    {:x (- (* x size) (:x offset))
     :y (- (* y size) (:y offset))
     :w size
     :h size}))

(defun layer-cell-tile [tileset-definitions terrain-sets layer tile-ref]
  (if (= (:data-kind layer) :terrain)
    (data/terrain-tile-in tileset-definitions
                          terrain-sets
                          (:terrain-set layer)
                          tile-ref)
    (data/tile-in tileset-definitions
                  (:tileset layer)
                  tile-ref)))

(defun render-layer! [tileset-definitions terrain-sets layer offset zoom]
  (let [tiles (:tiles layer)]
    (dotimes [y data/map-height]
      (dotimes [x data/map-width]
        (let [tile-ref (nth (nth tiles y) x)]
          (when (not (nil? tile-ref))
            (let [tile (layer-cell-tile tileset-definitions
                                        terrain-sets
                                        layer
                                        tile-ref)]
              (when tile
                (draw-tile! tile (tile-rect x y offset zoom))))))))))

(defun render-grid-overlay! [offset zoom]
  (dotimes [y data/map-height]
    (dotimes [x data/map-width]
      (r/rect! (tile-rect x y offset zoom)
               {:color {:r 0x12 :g 0x15 :b 0x18}}))))

(defun render-layers! [tileset-definitions terrain-sets layers hidden-layer-indices offset zoom show-grid?]
  (do
    (for-indexed [index layer layers]
      (when (not (contains? (or hidden-layer-indices []) index))
        (render-layer! tileset-definitions terrain-sets layer offset zoom)))
    (when show-grid?
      (render-grid-overlay! offset zoom))))
