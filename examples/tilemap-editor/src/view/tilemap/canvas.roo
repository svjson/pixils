(ns tilemap-editor.view.tilemap.canvas
  (:require pixils
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.ui :as ui]
            [pixils.tilemap.materialize :as materialize]
            [pixils.tilemap.project.model :as data]
            [pixils.tilemap.renderer :as tilemap-renderer]
            [tilemap-editor.model.derivation :as derivation]
            [tilemap-editor.model.tilemap :as tm]))



;; Map canvas

(def map-render-cache-bundle :tilemap-render-cache)
(def map-render-cache-image :tilemap-render-cache/map-canvas)

(defun ensure-map-render-cache-bundle! []
  (when (res/can-create-images?)
    (res/create-bundle! map-render-cache-bundle)))

(defun render-cache-image-exists? []
  (when (res/can-create-images?)
    (do
      (ensure-map-render-cache-bundle!)
      (not (nil? (head (filter (res/list-images map-render-cache-bundle)
                               (fn [resource]
                                 (= (:id resource)
                                    map-render-cache-image)))))))))

(defun selection-screen-rect [state selection offset zoom]
  (let [rect (:rect selection)
        size (tm/scaled-tile-size state zoom)]
    {:x (- (* (:x rect) size) (:x offset))
     :y (- (* (:y rect) size) (:y offset))
     :w (* (:w rect) size)
     :h (* (:h rect) size)}))

(defun draw-selection-corner! [x y dx dy color]
  (do
    (r/line! {:x x :y y} {:x (+ x (* dx 8)) :y y} color)
    (r/line! {:x x :y y} {:x x :y (+ y (* dy 8))} color)))

(defun draw-selection-overlay! [state selection offset zoom]
  (when selection
    (let [rect (selection-screen-rect state selection offset zoom)
          right (dec (+ (:x rect) (:w rect)))
          bottom (dec (+ (:y rect) (:h rect)))
          color {:r 0xff :g 0xcc :b 0x66}]
      (do
        (r/rect! rect {:color color})
        (draw-selection-corner! (:x rect) (:y rect) 1 1 color)
        (draw-selection-corner! right (:y rect) -1 1 color)
        (draw-selection-corner! (:x rect) bottom 1 -1 color)
        (draw-selection-corner! right bottom -1 -1 color)))))

(defun tile-screen-rect [state pos offset zoom]
  (let [size (tm/scaled-tile-size state zoom)]
    {:x (- (* (:x pos) size) (:x offset))
     :y (- (* (:y pos) size) (:y offset))
     :w size
     :h size}))

(defun draw-line-overlay! [state line offset zoom]
  (when (:active? line)
    (let [color {:r 0xff :g 0xcc :b 0x66}]
      (do
        (map (tm/map-line-positions line (:current line))
             (fn [pos]
               (r/rect! (tile-screen-rect state pos offset zoom) {:color color})))
        nil))))

(defun map-canvas-render-input [state]
  {:map-id (:selected-map-id state)
   :width (tm/map-width state)
   :height (tm/map-height state)
   :tile-size (tm/tile-size state)
   :layers (:layers state)
   :terrain-sets (:terrain-sets state)
   :show-terrain-rules? (:show-terrain-rules? state)
   :show-grid? (:show-grid? state)
   :hidden-layer-indices (:hidden-layer-indices state)
   :tilesets (:tilesets state)
   :synced-resources (:synced-resources state)
   :layer-profile (data/layer-profile-by-id (:layer-profiles state)
                                            (:selected-layer-profile-id state))
   :rulesets (:rulesets state)})

(defun logical-profile-source-layer [layers definition]
  (if (= (:role definition) :derived)
    (when (= (:persistence definition) :materialized)
      (derivation/layer-by-id layers (:id definition)))
    (derivation/layer-by-id layers (:id definition))))

(defun logical-render-layers-from-profile [layers profile]
  (filter (map (or (:layers profile) [])
               (fn [definition]
                 (logical-profile-source-layer layers definition)))
          (fn [layer]
            (not (nil? layer)))))

(defun logical-unprofiled-render-layers [layers profile]
  (filter (or layers [])
          (fn [layer]
            (not (derivation/layer-in-profile? profile layer)))))

(defun map-canvas-render-layers [input]
  (let [profile (or (:layer-profile input) {:layers []})
        profile-layers (logical-render-layers-from-profile (:layers input)
                                                           profile)]
    (if (empty? profile-layers)
      (or (:layers input) [])
      (concat profile-layers
              (logical-unprofiled-render-layers (:layers input) profile)))))

(defun materialize-map-canvas-render-layers [input render-layers]
  (materialize/materialize-render-map
   {:width (:width input)
    :height (:height input)
    :tile-size (:tile-size input)
    :tilesets (:tilesets input)
    :terrain-sets (:terrain-sets input)
    :rulesets (:rulesets input)
    :show-terrain-rules? (:show-terrain-rules? input)
    :layers render-layers}))

(defun materialize-map-canvas-render-layer-rect [input render-layers rect]
  (materialize/materialize-render-rect
   {:width (:width input)
    :height (:height input)
    :tile-size (:tile-size input)
    :tilesets (:tilesets input)
    :terrain-sets (:terrain-sets input)
    :rulesets (:rulesets input)
    :show-terrain-rules? (:show-terrain-rules? input)
    :layers render-layers}
   rect))

(defun materialize-map-canvas-render-map [input]
  (materialize-map-canvas-render-layers input
                                        (map-canvas-render-layers input)))

(defun render-layer-signature [layer]
  (dissoc (dissoc (dissoc layer :tiles) :terrain-signatures) :source-mask))

(defun map-canvas-render-input-signature [input]
  {:map-id (:map-id input)
   :width (:width input)
   :height (:height input)
   :tile-size (:tile-size input)
   :tilesets (:tilesets input)
   :layers (map (or (:layers input) []) render-layer-signature)
   :terrain-sets (:terrain-sets input)
   :show-terrain-rules? (:show-terrain-rules? input)
   :layer-profile (:layer-profile input)
   :rulesets (:rulesets input)})

(defun hidden-source-layer-ids [input]
  (reduce (or (:hidden-layer-indices input) [])
          []
          (fn [ids index]
            (let [layer (nth (or (:layers input) []) index)
                  layer-id (:id layer)]
              (if (and layer-id
                       (not (contains? ids layer-id)))
                (concat ids [layer-id])
                ids)))))

(defun render-layer-hidden? [hidden-layer-ids layer]
  (or (contains? hidden-layer-ids (:id layer))
      (contains? hidden-layer-ids (:render-source-layer-id layer))))

(defun hidden-render-layer-indices [input render-map]
  (let [hidden-layer-ids (hidden-source-layer-ids input)]
    (map (filter (for-indexed [index layer (or (:layers render-map) [])]
                   {:index index :layer layer})
                 (fn [entry]
                   (render-layer-hidden? hidden-layer-ids
                                         (:layer entry))))
         :index)))

(defun map-canvas-render-cache-signature [input render-map]
  {:hidden-layer-ids (hidden-source-layer-ids input)
   :render-layer-ids (map (or (:layers render-map) [])
                          (fn [layer]
                            {:id (:id layer)
                             :render-source-layer-id
                             (:render-source-layer-id layer)
                             :ruleset (:ruleset layer)
                             :tileset (:tileset layer)}))})

(defun dirty-render-layer-ids [positions]
  (reduce (or positions [])
          []
          (fn [ids pos]
            (if (contains? ids (:layer-id pos))
              ids
              (concat ids [(:layer-id pos)])))))

(defun dirty-render-rect [positions]
  (when (not (empty? (or positions [])))
    (let [first-pos (head positions)
          bounds (reduce positions
                         {:min-x (:x first-pos)
                          :min-y (:y first-pos)
                          :max-x (:x first-pos)
                          :max-y (:y first-pos)}
                         (fn [bounds pos]
                           {:min-x (min (:min-x bounds) (:x pos))
                            :min-y (min (:min-y bounds) (:y pos))
                            :max-x (max (:max-x bounds) (:x pos))
                            :max-y (max (:max-y bounds) (:y pos))}))]
      {:x (:min-x bounds)
       :y (:min-y bounds)
       :w (inc (- (:max-x bounds) (:min-x bounds)))
       :h (inc (- (:max-y bounds) (:min-y bounds)))})))

(defun render-layer-selected-for-dirty? [layer layer-ids]
  (or (contains? layer-ids (:id layer))
      (contains? layer-ids (:render-source-layer-id layer))))

(defun map-canvas-dirty-render-layers [input positions]
  (let [layer-ids (dirty-render-layer-ids positions)]
    (filter (map-canvas-render-layers input)
            (fn [layer]
              (render-layer-selected-for-dirty? layer layer-ids)))))

(defun empty-render-row [width]
  (dotimes [x width]
    nil))

(defun empty-render-tiles [input]
  (dotimes [y (:height input)]
    (empty-render-row (:width input))))

(defun full-render-layer-for-patch [input patch-layer]
  (assoc (dissoc patch-layer :render-source-rect)
         :tiles (empty-render-tiles input)))

(defun render-map-layer-matches-patch? [layer patch-layer]
  (and (= (:id layer) (:id patch-layer))
       (= (:render-source-layer-id layer)
          (:render-source-layer-id patch-layer))
       (= (:ruleset layer) (:ruleset patch-layer))
       (= (:tileset layer) (:tileset patch-layer))))

(defun render-map-layer-index [render-map patch-layer]
  (find-index (or (:layers render-map) [])
              (fn [layer]
                (render-map-layer-matches-patch? layer patch-layer))))

(defun patch-render-layer-cell [layer rect dx dy tile-ref]
  (assoc-in layer
            [:tiles (+ (:y rect) dy) (+ (:x rect) dx)]
            tile-ref))

(defun patch-render-layer-row [layer rect dy row]
  (reduce (for-indexed [dx tile-ref (or row [])]
            {:dx dx :tile-ref tile-ref})
          layer
          (fn [out cell]
            (patch-render-layer-cell out
                                     rect
                                     (:dx cell)
                                     dy
                                     (:tile-ref cell)))))

(defun patch-render-layer [layer patch-layer rect]
  (reduce (for-indexed [dy row (or (:tiles patch-layer) [])]
            {:dy dy :row row})
          layer
          (fn [out entry]
            (patch-render-layer-row out
                                    rect
                                    (:dy entry)
                                    (:row entry)))))

(defun patch-render-map-layer [input render-map patch-layer rect]
  (let [index (render-map-layer-index render-map patch-layer)]
    (if (nil? index)
      (update render-map
              :layers
              (fn [layers]
                (concat (or layers [])
                        [(patch-render-layer
                          (full-render-layer-for-patch input patch-layer)
                          patch-layer
                          rect)])))
      (assoc-in render-map
                [:layers index]
                (patch-render-layer (nth (or (:layers render-map) []) index)
                                    patch-layer
                                    rect)))))

(defun patch-render-map [input render-map patch-map]
  (reduce (or (:layers patch-map) [])
          render-map
          (fn [out patch-layer]
            (patch-render-map-layer input
                                    out
                                    patch-layer
                                    (:source-rect patch-map)))))

(defun map-canvas-cache-size [input]
  {:w (* (:width input) (:tile-size input))
   :h (* (:height input) (:tile-size input))})

(defun render-map-cache-target-rect [input]
  (merge {:x 0 :y 0}
         (map-canvas-cache-size input)))

(defun image-resource-ready? [image]
  (let [dim (img/size image)]
    (and dim
         (:w dim)
         (:h dim)
         (> (:w dim) 0)
         (> (:h dim) 0))))

(defun tile-image-ready? [tile]
  (if (or (= (:type tile) :sprite)
          (= (:type tile) :image))
    (image-resource-ready? (:image tile))
    true))

(defun tileset-images-ready? [tileset]
  (= 0
     (count (filter (or (:tiles tileset) [])
                    (fn [tile]
                      (not (tile-image-ready? tile)))))))

(defun render-input-images-ready? [input]
  (= 0
     (count (filter (or (:tilesets input) [])
                    (fn [tileset]
                      (not (tileset-images-ready? tileset)))))))

(defun clear-map-canvas-render-cache! [previous-image]
  (when (res/can-create-images?)
    (do
      (ensure-map-render-cache-bundle!)
      (res/remove-image! (or previous-image map-render-cache-image)))))

(defun rebuild-map-canvas-render-cache! [input render-map]
  (when (res/can-create-images?)
    (do
      (ensure-map-render-cache-bundle!)
      (res/remove-image! map-render-cache-image)
      (res/create-image!
       map-render-cache-image
       {:size (map-canvas-cache-size input)}
       (fn []
         (tilemap-renderer/render-layers!
          render-map
          {:tilesets (:tilesets input)
           :hidden-layer-indices (hidden-render-layer-indices input
                                                              render-map)
           :offset {:x 0 :y 0}
           :zoom 1
           :show-grid? false
           :target-rect (render-map-cache-target-rect input)})))
      map-render-cache-image)))

(defun ensure-map-canvas-render-cache! [input render-map]
  (when (and (not (render-cache-image-exists?))
             (render-input-images-ready? input))
    (rebuild-map-canvas-render-cache! input render-map)))

(defun refresh-map-canvas-render-cache [state]
  (if (:render-map state)
    (let [input (map-canvas-render-input state)
          signature (map-canvas-render-cache-signature input
                                                       (:render-map state))
          stale? (and (:render-cache-image state)
                      (not= signature (:render-cache-signature state)))
          state (if stale?
                  (do
                    (clear-map-canvas-render-cache! (:render-cache-image state))
                    (assoc state :render-cache-image nil))
                  state)]
      (if (nil? (:render-cache-image state))
        (let [image (ensure-map-canvas-render-cache! input (:render-map state))]
          (if image
            (assoc state
                   :render-cache-image image
                   :render-cache-signature signature)
            state))
        state))
    state))

(defun refresh-map-canvas-render-map [state]
  (let [input (map-canvas-render-input state)
        signature (map-canvas-render-input-signature input)]
    (if (and (:render-map state)
             (not (:render-map-dirty? state))
             (= signature (:render-map-input-signature state)))
      (assoc state
             :render-map-input input
             :render-map-input-signature signature)
      (let [dirty-positions (or (:render-dirty-positions state) [])
            dirty-rect (dirty-render-rect dirty-positions)
            partial? (and (:render-map state)
                          (:render-map-dirty? state)
                          dirty-rect
                          (= signature (:render-map-input-signature state)))
            render-layers (if partial?
                            (map-canvas-dirty-render-layers input
                                                            dirty-positions)
                            (map-canvas-render-layers input))
            patch-map (when partial?
                        (materialize-map-canvas-render-layer-rect
                         input
                         render-layers
                         dirty-rect))
            render-map (if partial?
                         (patch-render-map input
                                           (:render-map state)
                                           patch-map)
                         (materialize-map-canvas-render-layers input
                                                               render-layers))]
        (do
          (clear-map-canvas-render-cache! (:render-cache-image state))
          (assoc state
                 :render-map-input input
                 :render-map-input-signature signature
                 :render-map render-map
                 :render-cache-image nil
                 :render-cache-signature nil
                 :render-map-dirty? false
                 :render-dirty-positions []
                 :render-dirty-position-index {}))))))

(defun update-map-canvas-state [state ctx]
  (refresh-map-canvas-render-cache
   (refresh-map-canvas-render-map
    (tm/clamp-map-offset state ctx))))

(defun canvas-target-rect [ctx]
  (let [bounds (-> ctx :view :bounds)]
    {:x 0
     :y 0
     :w (:w bounds)
     :h (:h bounds)}))

(defun draw-render-cache! [image offset zoom ctx]
  (r/with-clip-rect (canvas-target-rect ctx)
    (r/image! image
              {:pos {:x (- (:x offset))
                     :y (- (:y offset))}
               :scale (or zoom 1)})))

(defun draw-render-map-direct! [state render-map offset ctx]
  (tilemap-renderer/render-layers!
   render-map
   {:tilesets (:tilesets state)
    :hidden-layer-indices (hidden-render-layer-indices
                           (map-canvas-render-input state)
                           render-map)
    :offset offset
    :zoom (:zoom state)
    :show-grid? false
    :target-rect (canvas-target-rect ctx)}))

(defun draw-grid-overlay! [state render-map offset ctx]
  (when (:show-grid? state)
    (let [target-rect (canvas-target-rect ctx)
          zoom (:zoom state)
          render-offset (tilemap-renderer/target-render-offset offset
                                                               target-rect)
          ranges (tilemap-renderer/render-ranges render-map
                                                 offset
                                                 zoom
                                                 target-rect)]
      (r/with-clip-rect target-rect
        (tilemap-renderer/render-grid-overlay! render-map
                                               render-offset
                                               zoom
                                               ranges)))))

(defun draw-render-map! [state render-map offset ctx]
  (do
    (if (and (:render-cache-image state)
             (render-cache-image-exists?))
      (draw-render-cache! (:render-cache-image state)
                          offset
                          (:zoom state)
                          ctx)
      (draw-render-map-direct! state render-map offset ctx))
    (draw-grid-overlay! state render-map offset ctx)))

(defun map-hover-cell-at-event [state event]
  (let [pos (tm/map-tile-position state event)]
    (when (tm/in-map-bounds-for? state (:x pos) (:y pos))
      pos)))

(defun update-map-hover-cell [state event]
  (assoc state :map-hover-cell (map-hover-cell-at-event state event)))

(defcomponent map-canvas
  {:focusable true
   :class :ui/canvas
   :style {:width :fill
           :height :fill
           :cursor :crosshair}
   :init (fn [state ctx]
            (merge {:offset {:x 0 :y 0}
                   :tilesets []
                   :terrain-sets []
                   :rulesets []
                   :layer-profiles []
                   :brushes []
                   :layers []
                   :map-tool :paint
                   :map-selection nil
                   :map-line nil
                   :map-hover-cell nil}
                  state))
   :update (fn [state ctx]
             (update-map-canvas-state state ctx))
   :on-mouse-down (fn [state event ctx]
                    (update-map-hover-cell
                     (tm/map-canvas-mouse-down state event ctx)
                     event))
   :on-mouse-motion (fn [state event ctx]
                      (update-map-hover-cell state event))
   :on-drag (fn [state event ctx]
              (update-map-hover-cell
               (tm/map-canvas-drag state event)
               event))
   :on-mouse-up (fn [state event ctx]
                  (update-map-hover-cell
                   (tm/map-canvas-mouse-up state event)
                   event))
   :on-mouse-leave (fn [state event ctx]
                     (assoc state :map-hover-cell nil))
   :on-key-down (fn [state event ctx]
                  (let [step (tm/scaled-tile-size state (:zoom state))]
                    (case (:key event)
                      :key/delete (tm/clear-map-selection state)
                      :key/backspace (tm/clear-map-selection state)
                      :key/left (tm/pan-map state ctx (* -1 step) 0)
                      :key/right (tm/pan-map state ctx step 0)
                      :key/up (tm/pan-map state ctx 0 (* -1 step))
                      :key/down (tm/pan-map state ctx 0 step)
                      :default state)))
   :render (fn [state ctx]
             (let [offset (or (:offset state) {:x 0 :y 0})]
               (let [render-map (or (:render-map state)
                                    (materialize-map-canvas-render-map
                                     (map-canvas-render-input state)))]
                 (draw-render-map! state render-map offset ctx)
                 (draw-selection-overlay! state
                                          (:map-selection state)
                                          offset
                                          (:zoom state))
                 (draw-line-overlay! state
                                     (:map-line state)
                                     offset
                                     (:zoom state)))))})


;; Scroll controls

(def default-map-scrollbar-size 14)

(defun map-scrollbar-size [ctx]
  (ui/theme-var ctx :scrollbar-size default-map-scrollbar-size))

(defun map-scroll-footer-content-size [state ctx]
  {:w 0 :h (map-scrollbar-size ctx)})

(defcomponent map-scroll-row
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :children [{:mode 'map-canvas
               :state {:selected-tile (ui/bind-state :selected-tile)
                         :selected-map-id (ui/bind-state :selected-map-id)
                         :map-width (ui/bind-state :map-width)
                         :map-height (ui/bind-state :map-height)
                         :tile-size (ui/bind-state :tile-size)
                         :tilesets (ui/bind-state :tilesets)
                       :synced-resources (ui/bind-state :synced-resources)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :rulesets (ui/bind-state :rulesets)
                       :layer-profiles (ui/bind-state :layer-profiles)
                       :selected-layer-profile-id
                       (ui/bind-state :selected-layer-profile-id)
                       :brushes (ui/bind-state :brushes)
                       :selected-brush-index
                       (ui/bind-state :selected-brush-index)
                       :map-palette-tab (ui/bind-state :map-palette-tab)
                       :map-tool (ui/bind-state :map-tool)
                       :map-selection (ui/bind-state :map-selection)
                       :map-line (ui/bind-state :map-line)
                       :map-hover-cell (ui/bind-state :map-hover-cell)
                       :selected-layer-index (ui/bind-state :selected-layer-index)
                       :selected-layer-label (ui/bind-state :selected-layer-label)
                       :layers (ui/bind-state :layers)
                       :terrain-rule-application
                       (ui/bind-state :terrain-rule-application)
                       :terrain-stamp-layers
                       (ui/bind-state :terrain-stamp-layers)
                       :terrain-stamp-replacements
                       (ui/bind-state :terrain-stamp-replacements)
                       :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                       :offset (ui/bind-state :map-offset)
                       :zoom (ui/bind-state :zoom)
                       :show-terrain-rules?
                       (ui/bind-state :show-terrain-rules?)
                       :show-grid? (ui/bind-state :show-grid?)}}
             {:mode 'ui/scrollbar
               :class :scrollbar/v
               :style {:height :fill}
                 :state {:axis :y
                         :value (ui/bind-state :map-offset :y)
                         :step (ui/bind-state :scroll-tile-size)
                         :content-size (ui/bind-state :content-height)}}]
     :update (fn [state ctx]
               (let [size (tm/scaled-tile-size state (:zoom state))]
                 (assoc (assoc state :scroll-tile-size size)
                        :content-height (* (tm/map-height state) size))))})

(defcomponent map-scroll-footer
  {:content-size map-scroll-footer-content-size
   :style {:width :fill
           :layout {:direction :row}}
   :children [{:mode 'ui/scrollbar
               :class :scrollbar/h
               :style {:width :fill
                       :height :fill}
                 :state {:axis :x
                         :value (ui/bind-state :map-offset :x)
                         :step (ui/bind-state :scroll-tile-size)
                         :content-size (ui/bind-state :content-width)}}
              {:mode 'ui/scrollbar-corner}]
     :update (fn [state ctx]
               (let [size (tm/scaled-tile-size state (:zoom state))]
                 (assoc (assoc state :scroll-tile-size size)
                        :content-width (* (tm/map-width state) size))))})



;; Map Area Component

(defcomponent map-area
  {:style {:width :fill
           :height :fill
           :layout {:direction :column}}
   :children [{:mode 'map-scroll-row
               :state {:selected-tile (ui/bind-state :selected-tile)
                         :selected-map-id (ui/bind-state :selected-map-id)
                         :map-width (ui/bind-state :map-width)
                         :map-height (ui/bind-state :map-height)
                         :tile-size (ui/bind-state :tile-size)
                         :tilesets (ui/bind-state :tilesets)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :rulesets (ui/bind-state :rulesets)
                       :layer-profiles (ui/bind-state :layer-profiles)
                       :selected-layer-profile-id
                       (ui/bind-state :selected-layer-profile-id)
                       :brushes (ui/bind-state :brushes)
                       :selected-brush-index
                       (ui/bind-state :selected-brush-index)
                       :map-palette-tab (ui/bind-state :map-palette-tab)
                       :map-tool (ui/bind-state :map-tool)
                       :map-selection (ui/bind-state :map-selection)
                       :map-line (ui/bind-state :map-line)
                       :map-hover-cell (ui/bind-state :map-hover-cell)
                       :selected-layer-index (ui/bind-state :selected-layer-index)
                       :selected-layer-label (ui/bind-state :selected-layer-label)
                       :layers (ui/bind-state :layers)
                       :terrain-rule-application
                       (ui/bind-state :terrain-rule-application)
                       :terrain-stamp-layers
                       (ui/bind-state :terrain-stamp-layers)
                       :terrain-stamp-replacements
                       (ui/bind-state :terrain-stamp-replacements)
                       :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                       :map-offset (ui/bind-state :map-offset)
                       :zoom (ui/bind-state :zoom)
                       :show-terrain-rules?
                       (ui/bind-state :show-terrain-rules?)
                       :show-grid? (ui/bind-state :show-grid?)}}
              {:mode 'map-scroll-footer
               :state {:map-offset (ui/bind-state :map-offset)
                         :map-width (ui/bind-state :map-width)
                         :map-height (ui/bind-state :map-height)
                         :tile-size (ui/bind-state :tile-size)
                         :zoom (ui/bind-state :zoom)}}]})
