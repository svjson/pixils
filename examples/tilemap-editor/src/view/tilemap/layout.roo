(ns tilemap-editor.view.tilemap.layout
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.split-pane :as split]
            tilemap-editor.view.tilemap.canvas
            [tilemap-editor.view.tilemap.controls :as controls]
            [tilemap-editor.view.tilemap.inspector :as inspector]
            [tilemap-editor.view.tilemap.palette :as palette]))



;; Workspace layout

(defun derive-map-workspace-state [state]
  (assoc state :map-layer-panel-disabled?
         (empty? (or (:layers state) []))))

(defcomponent side-panel
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :init (fn [state ctx]
           (derive-map-workspace-state state))
   :update (fn [state ctx]
             (derive-map-workspace-state state))
   :children [(controls/make-map-tool-controls)
              (controls/make-layer-controls)
              (controls/make-tileset-controls)
              (palette/make-tile-palette)
              (inspector/make-inspector-panel)]})

(defcomponent map-column
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap 8}}
   :children [(controls/make-map-workspace-panel
               {:state {:maps (ui/bind-state :maps)
                        :selected-map-id (ui/bind-state :selected-map-id)
                        :selected-map-label
                        (ui/bind-state :selected-map-label)}
                :body-state {:selected-tile (ui/bind-state :selected-tile)
                               :map-width (ui/bind-state :map-width)
                               :map-height (ui/bind-state :map-height)
                               :tile-size (ui/bind-state :tile-size)
                               :maps (ui/bind-state :maps)
                             :selected-map-id (ui/bind-state :selected-map-id)
                             :selected-map-label
                             (ui/bind-state :selected-map-label)
                             :tilesets (ui/bind-state :tilesets)
                             :mask-sets (ui/bind-state :mask-sets)
                             :transition-mask-diagnostics
                             (ui/bind-state :transition-mask-diagnostics)
                             :terrain-sets (ui/bind-state :terrain-sets)
                             :rulesets (ui/bind-state :rulesets)
                             :layer-profiles (ui/bind-state :layer-profiles)
                             :selected-layer-profile-id
                             (ui/bind-state :selected-layer-profile-id)
                             :brushes (ui/bind-state :brushes)
                             :selected-brush-index
                             (ui/bind-state :selected-brush-index)
                             :map-palette-tab (ui/bind-state :map-palette-tab)
                             :map-tool (ui/bind-state :map-tool)
                             :map-selection (ui/bind-state :map-selection)
                             :map-line (ui/bind-state :map-line)
                             :map-hover-cell (ui/bind-state :map-hover-cell)
                             :selected-layer-index
                             (ui/bind-state :selected-layer-index)
                             :selected-layer-label
                             (ui/bind-state :selected-layer-label)
                             :layers (ui/bind-state :layers)
                             :terrain-rule-application
                             (ui/bind-state :terrain-rule-application)
                             :terrain-stamp-layers
                             (ui/bind-state :terrain-stamp-layers)
                             :terrain-stamp-replacements
                             (ui/bind-state :terrain-stamp-replacements)
                             :hidden-layer-indices
                             (ui/bind-state :hidden-layer-indices)
                             :map-offset (ui/bind-state :map-offset)
                             :zoom (ui/bind-state :zoom)
                             :zoom-label (ui/bind-state :zoom-label)
                             :show-terrain-rules?
                             (ui/bind-state :show-terrain-rules?)
                             :show-grid? (ui/bind-state :show-grid?)}
                :children [{:mode 'map-area
                            :style {:height :fill}
                            :state {:selected-tile (ui/bind-state :selected-tile)
                                      :selected-map-id
                                      (ui/bind-state :selected-map-id)
                                      :map-width (ui/bind-state :map-width)
                                      :map-height (ui/bind-state :map-height)
                                      :tile-size (ui/bind-state :tile-size)
                                      :tilesets (ui/bind-state :tilesets)
                                      :mask-sets (ui/bind-state :mask-sets)
                                    :transition-mask-diagnostics
                                    (ui/bind-state :transition-mask-diagnostics)
                                    :terrain-sets (ui/bind-state :terrain-sets)
                                    :rulesets (ui/bind-state :rulesets)
                                    :layer-profiles (ui/bind-state :layer-profiles)
                                    :selected-layer-profile-id
                                    (ui/bind-state :selected-layer-profile-id)
                                    :brushes (ui/bind-state :brushes)
                                    :selected-brush-index
                                    (ui/bind-state :selected-brush-index)
                                    :map-palette-tab
                                    (ui/bind-state :map-palette-tab)
                                    :map-tool (ui/bind-state :map-tool)
                                    :map-selection (ui/bind-state :map-selection)
                                    :map-line (ui/bind-state :map-line)
                                    :map-hover-cell (ui/bind-state :map-hover-cell)
                                    :selected-layer-index
                                    (ui/bind-state :selected-layer-index)
                                    :selected-layer-label
                                    (ui/bind-state :selected-layer-label)
                                    :layers (ui/bind-state :layers)
                                    :terrain-rule-application
                                    (ui/bind-state :terrain-rule-application)
                                    :terrain-stamp-layers
                                    (ui/bind-state :terrain-stamp-layers)
                                    :terrain-stamp-replacements
                                    (ui/bind-state :terrain-stamp-replacements)
                                    :hidden-layer-indices
                                    (ui/bind-state :hidden-layer-indices)
                                    :map-offset (ui/bind-state :map-offset)
                                    :zoom (ui/bind-state :zoom)
                                    :show-terrain-rules?
                                    (ui/bind-state :show-terrain-rules?)
                                    :show-grid? (ui/bind-state :show-grid?)}}
                             {:mode 'map-view-controls
                              :state {:zoom (ui/bind-state :zoom)
                                      :tile-size (ui/bind-state :tile-size)
                                      :zoom-label (ui/bind-state :zoom-label)}}]})]})

(defcomponent workspace
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :children [(split/make
               {:style {:width :fill
                        :height :fill}
                :axis :x
                :split 0.72
                :min-first 280
                :min-second 220
                :state {:selected-tile (ui/bind-state :selected-tile)
                          :map-width (ui/bind-state :map-width)
                          :map-height (ui/bind-state :map-height)
                          :tile-size (ui/bind-state :tile-size)
                          :maps (ui/bind-state :maps)
                        :selected-map-id (ui/bind-state :selected-map-id)
                        :selected-map-label
                        (ui/bind-state :selected-map-label)
                        :selected-label (ui/bind-state :selected-label)
                        :selected-tileset-index (ui/bind-state :selected-tileset-index)
                        :tilesets (ui/bind-state :tilesets)
                        :mask-sets (ui/bind-state :mask-sets)
                        :tileset (ui/bind-state :tileset)
                        :transition-mask-diagnostics
                        (ui/bind-state :transition-mask-diagnostics)
                        :terrain-sets (ui/bind-state :terrain-sets)
                        :rulesets (ui/bind-state :rulesets)
                        :layer-profiles (ui/bind-state :layer-profiles)
                        :selected-layer-profile-id
                        (ui/bind-state :selected-layer-profile-id)
                        :brushes (ui/bind-state :brushes)
                        :selected-brush-index
                        (ui/bind-state :selected-brush-index)
                        :map-palette-tab (ui/bind-state :map-palette-tab)
                        :map-tool (ui/bind-state :map-tool)
                        :map-selection (ui/bind-state :map-selection)
                        :map-line (ui/bind-state :map-line)
                        :map-hover-cell (ui/bind-state :map-hover-cell)
                        :selected-layer-index (ui/bind-state :selected-layer-index)
                        :selected-layer-label (ui/bind-state :selected-layer-label)
                        :layers (ui/bind-state :layers)
                        :terrain-rule-application
                        (ui/bind-state :terrain-rule-application)
                        :terrain-stamp-layers
                        (ui/bind-state :terrain-stamp-layers)
                        :terrain-stamp-replacements
                        (ui/bind-state :terrain-stamp-replacements)
                        :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                        :map-offset (ui/bind-state :map-offset)
                        :zoom (ui/bind-state :zoom)
                        :zoom-label (ui/bind-state :zoom-label)
                        :show-terrain-rules?
                        (ui/bind-state :show-terrain-rules?)
                        :show-grid? (ui/bind-state :show-grid?)}
                :children [{:mode 'map-column
                            :style {:padding {:r 8}}
                            :state {:selected-tile (ui/bind-state :selected-tile)
                                      :map-width (ui/bind-state :map-width)
                                      :map-height (ui/bind-state :map-height)
                                      :tile-size (ui/bind-state :tile-size)
                                      :maps (ui/bind-state :maps)
                                    :selected-map-id
                                    (ui/bind-state :selected-map-id)
                                    :selected-map-label
                                    (ui/bind-state :selected-map-label)
                                    :tilesets (ui/bind-state :tilesets)
                                    :mask-sets (ui/bind-state :mask-sets)
                                    :transition-mask-diagnostics
                                    (ui/bind-state :transition-mask-diagnostics)
                                    :terrain-sets (ui/bind-state :terrain-sets)
                                    :rulesets (ui/bind-state :rulesets)
                                    :layer-profiles (ui/bind-state :layer-profiles)
                                    :selected-layer-profile-id
                                    (ui/bind-state :selected-layer-profile-id)
                                    :brushes (ui/bind-state :brushes)
                                    :selected-brush-index
                                    (ui/bind-state :selected-brush-index)
                                    :map-palette-tab
                                    (ui/bind-state :map-palette-tab)
                                    :map-tool (ui/bind-state :map-tool)
                                    :map-selection (ui/bind-state :map-selection)
                                    :map-line (ui/bind-state :map-line)
                                    :map-hover-cell (ui/bind-state :map-hover-cell)
                                    :selected-layer-index (ui/bind-state :selected-layer-index)
                                    :selected-layer-label (ui/bind-state :selected-layer-label)
                                    :layers (ui/bind-state :layers)
                                    :terrain-rule-application
                                    (ui/bind-state :terrain-rule-application)
                                    :terrain-stamp-layers
                                    (ui/bind-state :terrain-stamp-layers)
                                    :terrain-stamp-replacements
                                    (ui/bind-state :terrain-stamp-replacements)
                                    :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                                    :map-offset (ui/bind-state :map-offset)
                                    :zoom (ui/bind-state :zoom)
                                    :zoom-label (ui/bind-state :zoom-label)
                                    :show-terrain-rules?
                                    (ui/bind-state :show-terrain-rules?)
                                    :show-grid? (ui/bind-state :show-grid?)}}
                           {:mode 'side-panel
                            :style {:padding {:l 8}}
                            :state {:selected-tile (ui/bind-state :selected-tile)
                                      :map-width (ui/bind-state :map-width)
                                      :map-height (ui/bind-state :map-height)
                                      :tile-size (ui/bind-state :tile-size)
                                      :selected-label (ui/bind-state :selected-label)
                                    :selected-tileset-index (ui/bind-state :selected-tileset-index)
                                    :tilesets (ui/bind-state :tilesets)
                                    :tileset (ui/bind-state :tileset)
                                    :terrain-sets (ui/bind-state :terrain-sets)
                                    :rulesets (ui/bind-state :rulesets)
                                    :layer-profiles (ui/bind-state :layer-profiles)
                                    :selected-layer-profile-id
                                    (ui/bind-state :selected-layer-profile-id)
                                    :brushes (ui/bind-state :brushes)
                                    :selected-brush-index
                                    (ui/bind-state :selected-brush-index)
                                    :map-palette-tab
                                    (ui/bind-state :map-palette-tab)
                                    :map-tool (ui/bind-state :map-tool)
                                    :selected-layer-index (ui/bind-state :selected-layer-index)
                                    :selected-layer-label (ui/bind-state :selected-layer-label)
                                    :layers (ui/bind-state :layers)
                                    :hidden-layer-indices (ui/bind-state :hidden-layer-indices)}}]})]})
