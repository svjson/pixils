(ns tilemap-editor.view.tilemap.inspector
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.header-panel :as hp]))


(defun make-inspector-panel []
  (hp/make {:title "Inspector"
            :style {:width :fill
                    :height :fill}
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-label (ui/bind-state :selected-label)
                    :selected-layer-label (ui/bind-state :selected-layer-label)}
            :body-state {:selected-label (ui/bind-state :selected-label)
                         :selected-layer-label (ui/bind-state :selected-layer-label)}
            :children [{:mode 'ui/text
                        :state {:value (ui/bind-state :selected-label)}}
                       {:mode 'ui/text
                        :class :ui/muted
                        :state {:value (ui/bind-state :selected-layer-label)}}
                       {:mode 'ui/text
                        :class :ui/muted
                        :state {:value "Map canvas scrolls by offset, not by scroll-pane."}}]}))
