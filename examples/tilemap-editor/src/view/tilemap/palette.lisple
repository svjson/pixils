(ns tilemap-editor.view.tilemap.palette
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [tilemap-editor.model.data :as data]
            [tilemap-editor.view.tilemap.renderer :as tr]))



;; Tile palette

(def tile-palette-row-height 22)
(def tile-palette-content-width 160)

(defun selected-layer [state]
  (let [layers (or (:layers state) [])]
    (when (> (count layers) 0)
      (nth layers (min (or (:selected-layer-index state) 0)
                       (dec (count layers)))))))

(defun selected-layer-tileset [state]
  (or (:tileset (selected-layer state))
      (:palette-tileset state)))

(defcomponent tile-swatch-preview
  {:style {:width 14
           :height 14}
   :render (fn [state ctx]
             (let [bounds (-> ctx :view :bounds)
                   rect {:x 0 :y 0 :w (:w bounds) :h (:h bounds)}]
               (do
                 (r/rect! rect {:fill true
                                :color {:r 0x12 :g 0x15 :b 0x18}})
                 (tr/draw-tile! (:tile state) rect)
                 (r/rect! rect {:color {:r 0xe6 :g 0xea :b 0xee}}))))})

(defcomponent tile-swatch
  {:extend 'ui/list-box-item
   :style {:width :fill
           :height tile-palette-row-height
           :padding [4 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (let [tile (data/tile-in (:tilesets state)
                                                   (:tileset state)
                                                   (:tile-id state))]
               (assoc (assoc (assoc state
                                    :selected (contains? (:selected-indices state)
                                                         (:index state)))
                             :tile tile)
                      :name (:name tile))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    state))
   :children [{:mode 'tile-swatch-preview
               :state {:tile (ui/bind-state :tile)}}
              {:mode 'ui/text
               :state {:value (ui/bind-state :name)}}]})

(defun selected-tile-indices [state]
  (if (nil? (:selected-tile state))
    []
    [(data/tile-index (:tilesets state)
                                     (selected-layer-tileset state)
                                     (:selected-tile state))]))

(defun tile-swatch-child [index option]
  {:mode 'tile-swatch
   :state {:index index
           :value (:value option)
           :tile-id (:value option)
           :tileset (ui/bind-state :tileset)
           :tilesets (ui/bind-state :tilesets)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun tile-palette-list-box-child [tilesets tileset]
  (let [options (data/tile-options tilesets tileset)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height tile-palette-row-height
              :visible-rows (count options)
              :content-width tile-palette-content-width
              :disabled? (empty? options)
              :state {:tileset (ui/bind-state :palette-tileset)
                      :tilesets (ui/bind-state :tilesets)}
              :item-state-keys [:tileset :tilesets]
              :selected-indices (ui/bind-state :selected-indices)
              :force-selection? true
              :item-child tile-swatch-child})))

(defcomponent tile-palette-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (let [tileset (selected-layer-tileset state)]
             (assoc state
                    :palette-tileset tileset
                    :palette-tilesets nil
                    :tile-count nil
                    :selected-indices (selected-tile-indices state))))
   :update (fn [state ctx]
             (let [tileset (selected-layer-tileset state)
                   tile-count (data/tile-count (:tilesets state) tileset)]
               (do
                 (when (or (not= tileset (:palette-tileset state))
                           (not= (:tilesets state) (:palette-tilesets state))
                           (not= tile-count (:tile-count state)))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (tile-palette-list-box-child (:tilesets state)
                                                                         tileset))))
                 (assoc state
                        :palette-tileset tileset
                        :palette-tilesets (:tilesets state)
                        :tile-count tile-count
                        :selected-indices (selected-tile-indices
                                           (assoc state
                                                  :palette-tileset
                                                  tileset))))))
   :children [(merge {:id "list-box"}
                     (tile-palette-list-box-child [] nil))]})

(defun make-tile-palette []
  (hp/make {:title "Tiles"
            :style {:width :fill
                    :height 176}
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-tile (ui/bind-state :selected-tile)
                    :tilesets (ui/bind-state :tilesets)
                    :selected-layer-index (ui/bind-state :selected-layer-index)
                    :layers (ui/bind-state :layers)}
            :body-state {:selected-tile (ui/bind-state :selected-tile)
                         :tilesets (ui/bind-state :tilesets)
                         :selected-layer-index (ui/bind-state :selected-layer-index)
                         :layers (ui/bind-state :layers)}
            :update (fn [state ctx]
                      (assoc state
                             :selected-indices
                             (selected-tile-indices state)))
            :on {:list-box/change (fn [state event ctx]
                                    (do
                                      (ui/stop-propagation! event)
                                      (ui/emit! (:view ctx)
                                                :palette/select
                                                (-> event :payload :value))
                                      state))}
            :children [{:mode 'tile-palette-list
                        :state {:selected-tile (ui/bind-state :selected-tile)
                                :tilesets (ui/bind-state :tilesets)
                                :selected-layer-index (ui/bind-state :selected-layer-index)
                                :layers (ui/bind-state :layers)}}]}))
