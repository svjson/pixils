(ns tilemap-editor.view.tilemap.palette
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.tab-panel :as tabs]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.view.brushes.model :as brush-model]
            [tilemap-editor.view.tilemap.renderer :as tr]
            [tilemap-editor.view.tileset.model :as tile-grid]))



;; Tile palette

(def tile-palette-row-height 22)
(def tile-palette-content-width 160)
(def tile-palette-scrollbar-size 14)

(defun selected-layer [state]
  (let [layers (or (:layers state) [])]
    (when (> (count layers) 0)
      (nth layers (min (or (:selected-layer-index state) 0)
                       (dec (count layers)))))))

(defun selected-layer-tileset [state]
  (let [layer (selected-layer state)]
    (when layer
      (or (:tileset layer)
          (:palette-tileset state)))))

(defun selected-layer-terrain-set [state]
  (let [layer (selected-layer state)]
    (when layer
      (or (:terrain-set layer)
          (:palette-terrain-set state)))))

(defun selected-layer-data-kind [state]
  (or (:data-kind (selected-layer state))
      :tile-ref))

(defun source-options [state]
  (if (= (selected-layer-data-kind state) :terrain)
    (data/terrain-options (:terrain-sets state)
                          (selected-layer-terrain-set state))
    (data/tile-options (:tilesets state)
                       (selected-layer-tileset state))))

(defun selected-tile-indices [state]
  (if (or (:disabled? state)
          (nil? (selected-layer state))
          (nil? (:selected-tile state)))
    []
    (if (= (selected-layer-data-kind state) :terrain)
      [(data/terrain-index (:terrain-sets state)
                           (selected-layer-terrain-set state)
                           (:selected-tile state))]
      [(data/tile-index (:tilesets state)
                        (selected-layer-tileset state)
                        (:selected-tile state))])))

(defun source-option-tile [state option]
  (if (= (:palette-data-kind state) :terrain)
    (data/terrain-tile-in (:tilesets state)
                          (:terrain-sets state)
                          (:palette-terrain-set state)
                          (:value option))
    (data/tile-in (:tilesets state)
                  (:palette-tileset state)
                  (:value option))))

(defun tile-select-grid-rect [index columns]
  (let [columns (max 1 (or columns 1))
        stride (tile-grid/tile-grid-stride)
        size tile-grid/tile-grid-cell-size]
    {:x (* (mod index columns) (:w stride))
     :y (* (int (/ index columns)) (:h stride))
     :w (:w size)
     :h (:h size)}))

(defun tile-select-grid-border-rect [rect]
  {:x (+ (:x rect) 1)
   :y (+ (:y rect) 1)
   :w (- (:w rect) 2)
   :h (- (:h rect) 2)})

(defun draw-tile-select-cell! [state option index columns]
  (let [rect (tile-select-grid-rect index columns)
        tile (source-option-tile state option)]
    (do
      (r/rect! rect {:fill true
                     :color {:r 0x12 :g 0x15 :b 0x18}})
      (tr/draw-tile! tile rect)
      (r/rect! rect {:color {:r 0x2c :g 0x34 :b 0x3c}}))))

(defun draw-tile-select-selection! [index columns]
  (when (not (nil? index))
    (r/rect! (tile-select-grid-border-rect (tile-select-grid-rect index columns))
             {:color {:r 0xff :g 0xcc :b 0x66}})))

(defun tile-select-grid-state [state]
  (let [tileset (selected-layer-tileset state)
        terrain-set (selected-layer-terrain-set state)
        data-kind (selected-layer-data-kind state)
        source-state (assoc (assoc state
                                   :palette-tileset tileset)
                            :palette-terrain-set terrain-set
                            :palette-data-kind data-kind)
        options (source-options source-state)
        disabled? (if (or (nil? (selected-layer state))
                           (empty? options))
                     true
                     false)]
    (assoc source-state
           :options options
           :disabled? disabled?
           :selected-indices (selected-tile-indices source-state))))

(defun tile-select-grid-row-count [item-count columns]
  (let [columns (max 1 (or columns 1))
        item-count (max 0 (or item-count 0))]
    (if (= item-count 0)
      0
      (int (/ (+ item-count (dec columns)) columns)))))

(defun tile-select-grid-content-height [item-count columns]
  (let [rows (tile-select-grid-row-count item-count columns)]
    (if (= rows 0)
      0
      (let [stride (tile-grid/tile-grid-stride)
            size tile-grid/tile-grid-cell-size]
        (+ (* (dec rows) (:h stride))
           (:h size))))))

(defun tile-select-grid-content-size [state ctx]
  (let [grid-state (tile-select-grid-state state)
        options (or (:options grid-state) [])
        bounds (-> ctx :view :bounds)
        scrollbar-size (ui/theme-var ctx
                                     :scrollbar-size
                                     tile-palette-scrollbar-size)
        content-width (max 1 (- (or (:w bounds) 1) scrollbar-size))
        columns (tile-grid/tile-grid-columns {:w content-width})]
    {:w content-width
     :h (tile-select-grid-content-height (count options) columns)}))

(defun tile-select-grid-scroll-content-style [state]
  {:position :absolute
   :left 0
   :top (* -1 (or (:offset state) 0))
   :width :fill
   :height (or (:content-height state) 0)})

(defcomponent tile-select-grid
  {:focusable true
   :class :ui/content
   :style {:width :fill
           :height :fill
           :clip true}
   :init (fn [state ctx]
           (assoc state :selected-indices (selected-tile-indices state)))
   :update (fn [state ctx]
             (tile-select-grid-state state))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (ui/focus! ctx)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (let [options (or (:options state) [])
                        index (tile-grid/tile-grid-index-at-position
                               (:position event)
                               (-> ctx :view :bounds)
                               (count options))]
                    (do
                      (ui/stop-propagation! event)
                      (when (and (not (:disabled? state))
                                 (= (:button event) :left)
                                 (not (nil? index)))
                        (ui/emit! (:view ctx)
                                  :tile-select/change
                                  {:index index
                                   :value (:value (nth options index))}))
                      (if (and (not (:disabled? state))
                               (= (:button event) :left)
                               (not (nil? index)))
                        (assoc (assoc state
                                      :selected-tile
                                      (:value (nth options index)))
                               :selected-indices
                               [index])
                        state))))
   :on-key-down (fn [state event ctx]
                  (let [options (or (:options state) [])
                        item-count (count options)
                        columns (tile-grid/tile-grid-columns (-> ctx :view :bounds))
                        current (or (head (:selected-indices state)) 0)
                        delta (case (:key event)
                                :key/left -1
                                :key/right 1
                                :key/up (* -1 columns)
                                :key/down columns
                                :default nil)]
                    (if (or (:disabled? state) (nil? delta))
                      state
                      (let [index (tile-grid/move-tile-grid-index current
                                                                  item-count
                                                                  columns
                                                                  delta)]
                        (do
                          (ui/stop-propagation! event)
                          (when (not (nil? index))
                            (ui/emit! (:view ctx)
                                      :tile-select/change
                                      {:index index
                                       :value (:value (nth options index))}))
                          (if (not (nil? index))
                            (assoc (assoc state
                                          :selected-tile
                                          (:value (nth options index)))
                                   :selected-indices
                                   [index])
                            state))))))
   :render (fn [state ctx]
             (let [options (or (:options state) [])
                   selection (:selected-indices state)
                   columns (tile-grid/tile-grid-columns (-> ctx :view :bounds))]
               (do
                 (for-indexed [index option options]
                   (draw-tile-select-cell! state option index columns))
                 (for [index selection]
                   (draw-tile-select-selection! index columns)))))})

(defun tile-select-grid-child []
  {:mode 'tile-select-grid
   :style {:width :fill
           :height :fill}
   :state {:selected-tile (ui/bind-state :selected-tile)
           :tilesets (ui/bind-state :tilesets)
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-layer-index (ui/bind-state :selected-layer-index)
           :layers (ui/bind-state :layers)
           :disabled? (ui/bind-state :disabled?)}})

(defcomponent tile-select-grid-scroll-viewport
  {:style {:width :fill
           :height :fill
           :clip true}
   :update (fn [state ctx]
             (let [children (ui/children ctx)]
               (do
                 (when (> (count children) 0)
                   (ui/style! (nth children 0)
                              (tile-select-grid-scroll-content-style
                               state)))
                 state)))
   :children [(tile-select-grid-child)]})

(defcomponent tile-select-grid-scroll-pane
  {:style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :init (fn [state ctx]
           (assoc state
                  :offset 0
                  :content-height 0))
   :update (fn [state ctx]
             (let [content-size (tile-select-grid-content-size state ctx)]
               (assoc state
                      :content-height (:h content-size)
                      :step (:h (tile-grid/tile-grid-stride)))))
   :children [{:mode 'tile-select-grid-scroll-viewport
               :state {:offset (ui/bind-state :offset)
                       :content-height (ui/bind-state :content-height)
                       :selected-tile (ui/bind-state :selected-tile)
                       :tilesets (ui/bind-state :tilesets)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :selected-layer-index (ui/bind-state :selected-layer-index)
                       :layers (ui/bind-state :layers)
                       :disabled? (ui/bind-state :disabled?)}}
              {:mode 'ui/scrollbar
               :class :scrollbar/v
               :style {:height :fill}
               :state {:axis :y
                       :value (ui/bind-state :offset)
                       :step (ui/bind-state :step)
                       :content-size (ui/bind-state :content-height)}}]})

(defun tile-palette-list-child []
  {:mode 'tile-select-grid-scroll-pane
   :state {:selected-tile (ui/bind-state :selected-tile)
           :tilesets (ui/bind-state :tilesets)
           :terrain-sets (ui/bind-state :terrain-sets)
           :selected-layer-index (ui/bind-state :selected-layer-index)
           :layers (ui/bind-state :layers)
           :disabled? (ui/bind-state :disabled?)}})

(defcomponent tile-palette-list
  {:style {:width :fill
           :height :fill}
   :children [(tile-palette-list-child)]})

(defcomponent brush-palette-row
  {:extend 'ui/list-box-item
   :style {:width :fill
           :height tile-palette-row-height
           :padding [4 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (assoc state
                    :selected (contains? (:selected-indices state)
                                         (:index state))
                    :name (or (:label state) "")))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:value state)
                               :shift? false
                               :ctrl? false})
                    state))
   :children [{:mode 'ui/text
               :state {:value (ui/bind-state :name)}}]})

(defun brush-palette-row-child [index option]
  {:mode 'brush-palette-row
   :state {:index index
           :value (:value option)
           :label (:label option)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun selected-brush-indices [state]
  (if (:disabled? state)
    []
    (brush-model/selected-brush-indices (:brushes state)
                                        (:selected-brush-index state))))

(defun brush-palette-list-box-child [brushes disabled? selected-index]
  (let [options (brush-model/brush-options brushes)]
    (lb/make {:options options
              :style {:width :fill
                      :height :fill}
              :row-height tile-palette-row-height
              :visible-rows (count options)
              :content-width tile-palette-content-width
              :disabled? (if (or disabled? (empty? options))
                            true
                            false)
              :selected-indices (if disabled?
                                  []
                                  (brush-model/selected-brush-indices
                                   brushes
                                   selected-index))
              :force-selection? true
              :item-child brush-palette-row-child})))

(defcomponent brush-palette-list
  {:style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (assoc state
                  :rendered-brushes nil
                  :rendered-selected-brush-index nil
                  :rendered-disabled? nil
                  :selected-indices (selected-brush-indices state)))
   :update (fn [state ctx]
             (let [brushes (or (:brushes state) [])
                   selected-index (:selected-brush-index state)
                   disabled? (:disabled? state)]
               (do
                 (when (or (not= brushes (:rendered-brushes state))
                           (not= selected-index
                                 (:rendered-selected-brush-index state))
                           (not= disabled? (:rendered-disabled? state)))
                   (ui/replace-child!
                    (:view ctx)
                    "brush-list-box"
                    (merge {:id "brush-list-box"}
                           (brush-palette-list-box-child brushes
                                                         disabled?
                                                         selected-index))))
                 (assoc state
                        :rendered-brushes brushes
                        :rendered-selected-brush-index selected-index
                        :rendered-disabled? disabled?
                        :selected-indices (selected-brush-indices state)))))
   :children [(merge {:id "brush-list-box"}
                     (brush-palette-list-box-child [] true nil))]})

(defcomponent tile-palette-tabs
  {:style {:width :fill
           :height :fill}
   :children [(tabs/make
               {:selected-tab (ui/bind-state :map-palette-tab)
                :style {:width :fill
                        :height :fill}
                :state {:selected-tile (ui/bind-state :selected-tile)
                        :tilesets (ui/bind-state :tilesets)
                        :terrain-sets (ui/bind-state :terrain-sets)
                        :selected-layer-index (ui/bind-state :selected-layer-index)
                        :layers (ui/bind-state :layers)
                        :brushes (ui/bind-state :brushes)
                        :selected-brush-index
                        (ui/bind-state :selected-brush-index)
                        :disabled? (ui/bind-state :disabled?)}
                :tabs [{:id :tiles
                        :label "Tile"
                        :child {:mode 'tile-palette-list
                                :state {:selected-tile
                                        (ui/bind-state :selected-tile)
                                        :tilesets (ui/bind-state :tilesets)
                                        :terrain-sets (ui/bind-state :terrain-sets)
                                        :selected-layer-index
                                        (ui/bind-state :selected-layer-index)
                                        :layers (ui/bind-state :layers)
                                        :disabled? (ui/bind-state :disabled?)}}}
                       {:id :brushes
                        :label "Brush"
                        :child {:mode 'brush-palette-list
                                :state {:brushes (ui/bind-state :brushes)
                                        :selected-brush-index
                                        (ui/bind-state :selected-brush-index)
                                        :disabled? (ui/bind-state :disabled?)}}}]})]})

(defun make-tile-palette []
  (hp/make {:title "Palette"
            :style {:width :fill
                    :height 176}
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-tile (ui/bind-state :selected-tile)
                    :tilesets (ui/bind-state :tilesets)
                    :terrain-sets (ui/bind-state :terrain-sets)
                    :selected-layer-index (ui/bind-state :selected-layer-index)
                    :layers (ui/bind-state :layers)
                    :brushes (ui/bind-state :brushes)
                    :selected-brush-index (ui/bind-state :selected-brush-index)
                    :map-palette-tab (ui/bind-state :map-palette-tab)
                    :disabled? (ui/bind-state :map-layer-panel-disabled?)}
            :body-state {:selected-tile (ui/bind-state :selected-tile)
                         :tilesets (ui/bind-state :tilesets)
                         :terrain-sets (ui/bind-state :terrain-sets)
                         :selected-layer-index (ui/bind-state :selected-layer-index)
                         :layers (ui/bind-state :layers)
                         :brushes (ui/bind-state :brushes)
                         :selected-brush-index (ui/bind-state :selected-brush-index)
                         :map-palette-tab (ui/bind-state :map-palette-tab)
                         :disabled? (ui/bind-state :map-layer-panel-disabled?)}
            :update (fn [state ctx]
                      (assoc state
                             :selected-indices
                             (selected-tile-indices state)))
            :on {:list-box/change (fn [state event ctx]
                                    (do
                                      (ui/stop-propagation! event)
                                      (if (= (:map-palette-tab state)
                                             :brushes)
                                        (ui/emit! (:view ctx)
                                                  :palette/brush-select
                                                  (-> event :payload :value))
                                        (ui/emit! (:view ctx)
                                                  :palette/select
                                                  (-> event :payload :value)))
                                      state))
                  :tile-select/change (fn [state event ctx]
                                        (do
                                          (ui/stop-propagation! event)
                                          (ui/emit! (:view ctx)
                                                    :palette/select
                                                    (-> event :payload :value))
                                          state))
                  :tab-panel/change (fn [state event ctx]
                                      (let [tab (-> event :payload :tab)]
                                        (do
                                          (ui/stop-propagation! event)
                                          (ui/emit! (:view ctx)
                                                    :palette/tab-select
                                                    tab)
                                          (assoc state :map-palette-tab tab))))}
            :children [{:mode 'tile-palette-tabs
                        :state {:selected-tile (ui/bind-state :selected-tile)
                                :tilesets (ui/bind-state :tilesets)
                                :terrain-sets (ui/bind-state :terrain-sets)
                                :selected-layer-index
                                (ui/bind-state :selected-layer-index)
                                :layers (ui/bind-state :layers)
                                :brushes (ui/bind-state :brushes)
                                :selected-brush-index
                                (ui/bind-state :selected-brush-index)
                                :map-palette-tab
                                (ui/bind-state :map-palette-tab)
                                :disabled? (ui/bind-state :disabled?)}}]}))
