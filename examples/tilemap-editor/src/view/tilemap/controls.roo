(ns tilemap-editor.view.tilemap.controls
  (:require pixils
            [pixils.form :as form]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.list-box :as lb]
            [pixils.ui.menu :as menu]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.slider :as sl]
            [pixils.ui.theme-assets :as theme-assets]
            pixils.ui.text-input
            [pixils.ui.toggle-button :as toggle-button]
            [pixils.ui.window :as w]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.maps :as maps]
            [tilemap-editor.model.map-schemas :as map-schemas]
            [tilemap-editor.model.tilemap :as tilemap]
            [tilemap-editor.model.workbook :as editor-workbook]
            [tilemap-editor.view.id-name-dialog :as id-name-dialog]
            [tilemap-editor.view.tilemap.dimensions-dialog :as dimensions-dialog]))



;; Editor controls

(def map-tool-button-size 28)
(def map-tool-icon-size 20)
(def map-tool-icon-bundle :tilemap-editor-tools)
(def default-map-tool-icon-color {:r 0xff :g 0xcc :b 0x66})



;; Map controls

(defun map-context-menu [maps]
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename Map"
            :action :map/context-command
            :payload {:command :rename}}
           {:label "Duplicate Map"
            :action :map/context-command
            :payload {:command :duplicate}}
           :separator
           {:label "Flip Horizontal"
            :action :map/context-command
            :payload {:command :flip-horizontal}}
           {:label "Flip Vertical"
            :action :map/context-command
            :payload {:command :flip-vertical}}
           :separator
           {:label "Delete Map"
            :action :map/context-command
            :disabled? (<= (count (or maps [])) 1)
            :payload {:command :delete}}]})

(defun map-chooser-menu-items [maps]
  (concat [{:label "Add New Map"
            :action :map/add}
           :separator]
          (map (or maps [])
               (fn [map-document]
                 {:label (or (:label map-document)
                             (str (:id map-document)))
                  :type :option
                  :action :map/select
                  :payload (:id map-document)
                  :value (:id map-document)
                  :selected-path [:option-state :selected-map-id]}))))

(defun map-chooser-menu [maps]
  {:settings {:mnemonics {:enabled false}}
   :items (map-chooser-menu-items maps)})

(defun map-menu-state [state]
  (assoc state
         :option-state {:selected-map-id (:selected-map-id state)}))

(defun map-panel-title [state]
  (str "Map - " (or (:selected-map-label state)
                    (:label (data/selected-map-document (:maps state)
                                                       (:selected-map-id state)))
                    "")))

(defcomponent map-header-title
  {:style {:width :fill}
   :update (fn [state ctx]
             (assoc state :title (map-panel-title state)))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (when (= (:button event) :right)
                      (menu/open-context-menu! (map-context-menu (:maps state))
                                               (:global-position event)
                                               (map-menu-state state)
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :map/context-command
                                       (-> payload :payload)))))
                       state)}
   :children [{:mode 'ui/text
               :class :ui/title
               :style {:width :fill}
               :state {:value (ui/bind-state :title)}}]})

(defcomponent map-chooser-button
  {:style {:width 18
           :height 18}
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (when (= (:button event) :left)
                      (menu/open-context-menu! (map-chooser-menu (:maps state))
                                               (:global-position event)
                                               (map-menu-state state)
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       (:action payload)
                                       (:payload payload)))))
                       state)}
   :children [{:mode 'ui/combo-box-button
               :style {:width :fill
                       :height :fill}
               :state {:axis :y
                       :part :end}}]})

(defun open-map-dialog! [state ctx operation title id name]
  (do
    (id-name-dialog/open!
     ctx
     {:title title
      :id id
      :name name
      :context {:operation operation
                :map-id (:selected-map-id state)}
      :result-event :map/id-name-dialog-result})
    state))

(defun open-map-add-dialog! [state ctx]
  (let [label (maps/next-map-label (:maps state))
        id (maps/map-id-text (maps/map-id-from-text nil label))]
    (open-map-dialog! state ctx :add "New Map" id label)))

(defun selected-map-document [state]
  (data/selected-map-document (:maps state) (:selected-map-id state)))

(defun open-map-rename-dialog! [state ctx]
  (let [map-document (selected-map-document state)]
    (open-map-dialog! state
                      ctx
                      :rename
                      "Rename Map"
                      (maps/map-id-text (:id map-document))
                      (:label map-document))))

(defun open-map-duplicate-dialog! [state ctx]
  (let [map-document (selected-map-document state)
        label (maps/unique-map-label-from (:maps state)
                                          (str (:label map-document) " Copy")
                                          nil
                                          nil)
        id (maps/map-id-text (maps/map-id-from-text nil label))]
    (open-map-dialog! state
                      ctx
                      :duplicate
                      "Duplicate Map"
                      id
                      label)))

(defun open-map-delete-confirm-dialog! [state ctx]
  (let [map-document (selected-map-document state)]
    (do
      (dialog/open-confirm!
       ctx
       {:title "Delete Map"
        :body {:mode 'ui/text
               :style {:width :fill}
               :state {:value (str "Delete map \""
                                    (:label map-document)
                                    "\"?")}}
        :buttons [:dialog/cancel
                  {:type :dialog/ok
                   :label "Delete"}]
        :result-event :map/delete-dialog-result
        :payload {:map-id (:id map-document)}})
      state)))

(defun make-map-workspace-panel [opts]
  (hp/make {:title "Map"
            :style {:width :fill
                    :height :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :title-child {:mode 'map-header-title
                          :state {:maps (ui/bind-state :maps)
                                  :selected-map-id
                                  (ui/bind-state :selected-map-id)
                                  :selected-map-label
                                  (ui/bind-state :selected-map-label)}}
            :header-children [{:mode 'map-chooser-button
                               :state {:maps (ui/bind-state :maps)
                                       :selected-map-id
                                       (ui/bind-state :selected-map-id)}}]
            :body-style {:height :fill
                         :padding 8
                         :layout {:direction :column
                                  :gap 8}}
            :state (merge (or (:body-state opts) {})
                          (or (:state opts) {}))
            :body-state (:body-state opts)
            :on {:map/context-command
                 (fn [state event ctx]
                   (let [command (:command (:payload event))]
                     (case command
                       :rename
                       (open-map-rename-dialog! state ctx)

                       :duplicate
                       (open-map-duplicate-dialog! state ctx)

                       :flip-horizontal
                       (tilemap/flip-map state :horizontal)

                       :flip-vertical
                       (tilemap/flip-map state :vertical)

                       :delete
                       (if (> (count (or (:maps state) [])) 1)
                         (open-map-delete-confirm-dialog! state ctx)
                         state)

                       :default
                       state)))}
            :children (:children opts)}))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun string-contains? [text needle index]
  (cond
    (>= index (count text)) false
    (= (substr text index 1) needle) true
    :default (string-contains? text needle (inc index))))

(defun color-id-label [color]
  (str (or (:r color) 0)
       "-"
       (or (:g color) 0)
       "-"
       (or (:b color) 0)
       "-"
       (or (:a color) 255)))

(defun map-tool-icon-id [tool color]
  (keyword (str "tilemap-editor-tools/"
                (keyword-label tool)
                "-20-"
                (color-id-label color))))

(defun map-tool-highlight-color [ctx]
  (ui/theme-var ctx :highlight-color default-map-tool-icon-color))

(defun draw-paint-tool-icon! [color]
  (do
    (r/line! {:x 12 :y 1} {:x 18 :y 7} color)
    (r/line! {:x 11 :y 2} {:x 17 :y 8} color)
    (r/line! {:x 10 :y 4} {:x 15 :y 9} color)
    (r/rect! {:x 4 :y 9 :w 9 :h 5} {:color color})
    (r/line! {:x 4 :y 14} {:x 1 :y 18} color)
    (r/line! {:x 7 :y 14} {:x 5 :y 18} color)
    (r/line! {:x 10 :y 14} {:x 9 :y 18} color)))

(defun draw-select-tool-icon! [color]
  (do
    (r/line! {:x 4 :y 4} {:x 8 :y 4} color)
    (r/line! {:x 12 :y 4} {:x 16 :y 4} color)
    (r/line! {:x 4 :y 16} {:x 8 :y 16} color)
    (r/line! {:x 12 :y 16} {:x 16 :y 16} color)
    (r/line! {:x 4 :y 4} {:x 4 :y 8} color)
    (r/line! {:x 4 :y 12} {:x 4 :y 16} color)
    (r/line! {:x 16 :y 4} {:x 16 :y 8} color)
    (r/line! {:x 16 :y 12} {:x 16 :y 16} color)
    (r/rect! {:x 2 :y 2 :w 4 :h 4} {:color color})
    (r/rect! {:x 15 :y 15 :w 4 :h 4} {:color color})))

(defun draw-line-tool-icon! [color]
  (do
    (r/line! {:x 3 :y 16} {:x 16 :y 3} color)
    (r/line! {:x 4 :y 17} {:x 17 :y 4} color)
    (r/rect! {:x 1 :y 14 :w 5 :h 5} {:color color})
    (r/rect! {:x 14 :y 1 :w 5 :h 5} {:color color})))

(defun draw-fill-rect-tool-icon! [color]
  (do
    (r/line! {:x 4 :y 4} {:x 16 :y 4} color)
    (r/line! {:x 4 :y 16} {:x 16 :y 16} color)
    (r/line! {:x 4 :y 4} {:x 4 :y 16} color)
    (r/line! {:x 16 :y 4} {:x 16 :y 16} color)
    (r/rect! {:x 7 :y 7 :w 7 :h 7} {:color color})))

(defun draw-fill-tool-icon! [color]
  (do
    (r/line! {:x 6 :y 3} {:x 15 :y 12} color)
    (r/line! {:x 5 :y 4} {:x 14 :y 13} color)
    (r/line! {:x 4 :y 9} {:x 9 :y 4} color)
    (r/line! {:x 5 :y 10} {:x 10 :y 5} color)
    (r/rect! {:x 4 :y 10 :w 10 :h 4} {:color color})
    (r/rect! {:x 15 :y 15 :w 3 :h 3} {:color color})))

(defun ensure-map-tool-assets! [color]
  (let [paint-tool-icon (map-tool-icon-id :paint color)
        select-tool-icon (map-tool-icon-id :select color)
        line-tool-icon (map-tool-icon-id :line color)
        fill-rect-tool-icon (map-tool-icon-id :fill-rect color)
        fill-tool-icon (map-tool-icon-id :fill color)]
    (do
      (theme-assets/ensure-generated-image! map-tool-icon-bundle
                                            paint-tool-icon
                                            {:size {:w map-tool-icon-size
                                                    :h map-tool-icon-size}}
                                            (fn []
                                              (draw-paint-tool-icon! color)))
      (theme-assets/ensure-generated-image! map-tool-icon-bundle
                                            select-tool-icon
                                            {:size {:w map-tool-icon-size
                                                    :h map-tool-icon-size}}
                                            (fn []
                                              (draw-select-tool-icon! color)))
      (theme-assets/ensure-generated-image! map-tool-icon-bundle
                                            line-tool-icon
                                            {:size {:w map-tool-icon-size
                                                    :h map-tool-icon-size}}
                                            (fn []
                                              (draw-line-tool-icon! color)))
      (theme-assets/ensure-generated-image! map-tool-icon-bundle
                                            fill-rect-tool-icon
                                            {:size {:w map-tool-icon-size
                                                    :h map-tool-icon-size}}
                                            (fn []
                                              (draw-fill-rect-tool-icon! color)))
      (theme-assets/ensure-generated-image! map-tool-icon-bundle
                                            fill-tool-icon
                                            {:size {:w map-tool-icon-size
                                                    :h map-tool-icon-size}}
                                            (fn []
                                              (draw-fill-tool-icon! color))))))

(defun map-tool-buttons [color]
  [{:value :paint
    :label ""
    :image (map-tool-icon-id :paint color)
    :style {:width map-tool-button-size
            :height map-tool-button-size}}
   {:value :select
    :label ""
    :image (map-tool-icon-id :select color)
    :style {:width map-tool-button-size
            :height map-tool-button-size}}
   {:value :line
    :label ""
    :image (map-tool-icon-id :line color)
    :style {:width map-tool-button-size
            :height map-tool-button-size}}
   {:value :fill-rect
    :label ""
    :image (map-tool-icon-id :fill-rect color)
    :style {:width map-tool-button-size
            :height map-tool-button-size}}
   {:value :fill
    :label ""
    :image (map-tool-icon-id :fill color)
    :style {:width map-tool-button-size
            :height map-tool-button-size}}])

(defcomponent map-tool-grid
  {:style {:width :fill
           :height :shrink
           :layout {:direction :row
                    :gap 6}}
   :update (fn [state ctx]
             (let [color (map-tool-highlight-color ctx)]
               (if (= color (:map-tool-icon-color state))
                 state
                 (do
                   (ensure-map-tool-assets! color)
                   (assoc state
                          :map-tool-icon-color color
                          :map-tool-buttons (map-tool-buttons color))))))
   :on {:toggle-button-group/change
        (fn [state event ctx]
          (let [tool (-> event :payload :selected)]
            (do
              (ui/stop-propagation! event)
              (ui/emit! (:view ctx) :map/tool-select tool)
              (assoc state :map-tool tool))))}
   :children [(toggle-button/make-group
               {:buttons (ui/bind-state :map-tool-buttons)
                :selected (ui/bind-state :map-tool)
                :selection-required? true
                :button-row-style {:layout {:direction :row
                                            :gap 6}}})]})

(defun make-map-tool-controls []
  (hp/make {:title "Tools"
            :style {:width :fill}
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :body-state {:map-tool (ui/bind-state :map-tool)}
            :children [{:mode 'map-tool-grid
                        :state {:map-tool (ui/bind-state :map-tool)}}]}))

(defun layer-visible? [hidden-layer-indices index]
  (not (contains? (or hidden-layer-indices []) index)))

(defun toggle-hidden-layer [hidden-layer-indices index]
  (let [hidden-layer-indices (or hidden-layer-indices [])]
    (if (contains? hidden-layer-indices index)
      (filter hidden-layer-indices (fn [item]
                                     (not= item index)))
      (concat hidden-layer-indices [index]))))

(defun layer-context-menu [state]
  (let [terrain-layer? (= :terrain (-> state :layer :data-kind))
        has-terrain-sets? (not (empty? (or (:terrain-sets state) [])))]
    {:settings {:mnemonics {:enabled false}}
     :items [{:label "Rename Layer"
              :action :layer/context-dummy
              :payload {:command :rename}}
             {:label "Duplicate Layer"
              :action :layer/context-dummy
              :payload {:command :duplicate}}
             {:label "Change Terrain Set"
              :action :layer/context-dummy
              :disabled? (not (and terrain-layer? has-terrain-sets?))
              :payload {:command :terrain-set}}
             :separator
             {:label "Move Up"
              :action :layer/context-dummy
              :payload {:command :move-up}}
             {:label "Move Down"
              :action :layer/context-dummy
              :payload {:command :move-down}}
             :separator
             {:label "Delete Layer"
              :action :layer/context-dummy
              :payload {:command :delete}}]}))

(defun terrain-set-label [terrain-sets terrain-set]
  (let [item (head (filter (or terrain-sets [])
                           (fn [item]
                             (= (:id item) terrain-set))))]
    (if item
      (or (:label item) (:name item) (str (:id item)))
      "")))

(defun layer-source-label [state layer]
  (if (= (:data-kind layer) :terrain)
    (terrain-set-label (:terrain-sets state) (:terrain-set layer))
    (data/tileset-label (:tilesets state) (:tileset layer))))

(defun layer-name-exists? [layers name exclude-index]
  (> (count (filter (for-indexed [index layer (or layers [])]
                      {:index index
                       :label (:label layer)})
                    (fn [entry]
                      (and (= (:label entry) name)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-layer-name-from [layers root-name exclude-index suffix]
  (let [candidate (if suffix
                    (str root-name " " suffix)
                    root-name)]
    (if (layer-name-exists? layers candidate exclude-index)
      (unique-layer-name-from layers
                              root-name
                              exclude-index
                              (if suffix (inc suffix) 2))
      candidate)))

(defun layer-id-exists? [layers id exclude-index]
  (> (count (filter (for-indexed [index layer (or layers [])]
                      {:index index
                       :id (:id layer)})
                    (fn [entry]
                      (and (= (:id entry) id)
                           (not= (:index entry) exclude-index)))))
     0))

(defun unique-layer-id-from [layers root exclude-index suffix]
  (let [candidate (if suffix
                    (str root "-" suffix)
                    root)
        id (keyword (str "scene/" candidate))]
    (if (layer-id-exists? layers id exclude-index)
      (unique-layer-id-from layers
                            root
                            exclude-index
                            (if suffix (inc suffix) 2))
      id)))

(defun layer-id-from-text [text fallback-name]
  (let [text (str (or text ""))]
    (if (blank? text)
      (unique-layer-id-from [] (kebab-case fallback-name) nil nil)
      (let [text (keyword-label text)
            id-text (if (string-contains? text "/" 0)
                      text
                      (str "scene/" (kebab-case text)))]
        (keyword id-text)))))

(defun requested-layer-id [layers payload name exclude-index]
  (let [id-text (:id payload)]
    (if (blank? id-text)
      (unique-layer-id-from layers (kebab-case name) exclude-index nil)
      (let [id (layer-id-from-text id-text name)]
        (if (layer-id-exists? layers id exclude-index)
          nil
          id)))))

(defun make-empty-tile-layer [state layers tilesets name id]
  {:id (or id (unique-layer-id-from layers (kebab-case name) nil nil))
   :label name
   :kind :tile
   :role :source
   :data-kind :tile-ref
   :tileset (data/tileset-key tilesets 0)
   :order (* (count (or layers [])) 10)
   :tiles (data/make-empty-map-for (:map-width state) (:map-height state))})

(defun make-empty-terrain-layer [state layers terrain-sets name id terrain-set-index]
  {:id (or id (unique-layer-id-from layers (kebab-case name) nil nil))
   :label name
   :kind :tile
   :role :source
   :data-kind :terrain
   :terrain-set (data/terrain-set-key terrain-sets terrain-set-index)
   :order (* (count (or layers [])) 10)
   :tiles (data/make-empty-map-for (:map-width state) (:map-height state))})

(defun layer-request-name [request]
  (if (= (type-of request) "map")
    (:name request)
    request))

(defun layer-request-id [request]
  (if (= (type-of request) "map")
    (:id request)
    nil))

(defun layer-request-data-kind [request]
  (if (= (type-of request) "map")
    (or (:data-kind request) :tile-ref)
    :tile-ref))

(defun layer-request-terrain-set-index [request]
  (if (= (type-of request) "map")
    (or (:terrain-set-index request) 0)
    0))

(defun make-empty-layer [state layers tilesets terrain-sets request]
  (let [name (layer-request-name request)
        id (layer-request-id request)]
    (if (and (= (layer-request-data-kind request) :terrain)
             (not (empty? (or terrain-sets []))))
      (make-empty-terrain-layer state
                                layers
                                terrain-sets
                                name
                                id
                                (layer-request-terrain-set-index request))
      (make-empty-tile-layer state layers tilesets name id))))

(defun append-layer [state request]
  (let [layers (or (:layers state) [])
        layer (make-empty-layer state
                                layers
                                (:tilesets state)
                                (:terrain-sets state)
                                request)
        index (count layers)]
    (assoc state
           :layers (concat layers [layer])
           :selected-layer-index index
           :selected-layer-label (:label layer))))

(defun source-layers-reference-patches [path source-layers old-id new-id]
  (apply concat
         (for-indexed [index source-layer (or source-layers [])]
           (if (= source-layer old-id)
             [[:set (concat path [:source-layers index]) new-id]]
             []))))

(defun output-layer-target-reference-patches [path layers old-id new-id]
  (apply concat
         (for-indexed [index layer (or layers [])]
           (if (= (:target-layer layer) old-id)
             [[:set (concat path [index :target-layer]) new-id]]
             []))))

(defun rule-layer-reference-patches [ruleset-index rule-index rule old-id new-id]
  (output-layer-target-reference-patches
   [:rulesets ruleset-index :rules rule-index :output :layers]
   (get-in rule [:output :layers])
   old-id
   new-id))

(defun ruleset-layer-reference-patches [ruleset-index ruleset old-id new-id]
  (concat
   (if (= (:source-layer ruleset) old-id)
     [[:set [:rulesets ruleset-index :source-layer] new-id]]
     [])
   (source-layers-reference-patches
    [:rulesets ruleset-index]
    (:source-layers ruleset)
    old-id
    new-id)
   (apply concat
          (for-indexed [rule-index rule (or (:rules ruleset) [])]
            (rule-layer-reference-patches
             ruleset-index
             rule-index
             rule
             old-id
             new-id)))))

(defun layer-profile-layer-reference-patches [profile-index layer-index layer old-id new-id]
  (concat
   (if (= (:id layer) old-id)
     [[:set [:layer-profiles profile-index :layers layer-index :id] new-id]]
     [])
   (if (= (:target-layer layer) old-id)
     [[:set [:layer-profiles profile-index :layers layer-index :target-layer] new-id]]
     [])
   (source-layers-reference-patches
    [:layer-profiles profile-index :layers layer-index]
    (:source-layers layer)
    old-id
    new-id)))

(defun layer-profile-reference-patches [profile-index profile old-id new-id]
  (apply concat
         (for-indexed [layer-index layer (or (:layers profile) [])]
           (layer-profile-layer-reference-patches
            profile-index
            layer-index
            layer
            old-id
            new-id))))

(defun layer-id-reference-patches [state old-id new-id]
  (if (= old-id new-id)
    []
    (concat
     (apply concat
            (for-indexed [ruleset-index ruleset (or (:rulesets state) [])]
              (ruleset-layer-reference-patches
               ruleset-index
               ruleset
               old-id
               new-id)))
     (apply concat
            (for-indexed [profile-index profile (or (:layer-profiles state) [])]
              (layer-profile-reference-patches
               profile-index
               profile
               old-id
               new-id))))))

(defun rename-layer-change [state index name id]
  (let [old-id (get-in state [:layers index :id])
        new-id (or id
                   (requested-layer-id (:layers state)
                                       {}
                                       name
                                       index))]
    {:label "Rename layer"
     :patches (concat [[:set [:layers index :label] name]
                       [:set [:layers index :id] new-id]
                       [:set [:selected-layer-label] name]]
                      (layer-id-reference-patches state old-id new-id))}))

(defun duplicate-layer-after [layers index name id]
  (apply concat
         (for-indexed [layer-index layer (or layers [])]
           (if (= layer-index index)
             [layer (assoc (assoc layer :label name)
                           :id
                           (or id
                               (unique-layer-id-from layers
                                                     (kebab-case name)
                                                     nil
                                                     nil)))]
             [layer]))))

(defun shift-hidden-layer-indices-for-insert [hidden-layer-indices insert-index]
  (map (or hidden-layer-indices [])
       (fn [index]
         (if (>= index insert-index)
           (inc index)
           index))))

(defun shift-hidden-layer-indices-for-delete [hidden-layer-indices delete-index]
  (map (filter (or hidden-layer-indices [])
               (fn [index]
                 (not= index delete-index)))
       (fn [index]
         (if (> index delete-index)
           (dec index)
           index))))

(defun swap-index-value [index a b]
  (cond
    (= index a) b
    (= index b) a
    :default index))

(defun swap-layer-indices [layers a b]
  (for-indexed [index layer (or layers [])]
    (cond
      (= index a) (nth layers b)
      (= index b) (nth layers a)
      :default layer)))

(defun swap-hidden-layer-indices [hidden-layer-indices a b]
  (map (or hidden-layer-indices [])
       (fn [index]
         (swap-index-value index a b))))

(defun remove-item-at-index [items remove-index]
  (map (filter (for-indexed [index item (or items [])]
                 {:index index
                  :item item})
               (fn [entry]
                 (not= (:index entry) remove-index)))
       :item))

(defun insert-item-at-index [items insert-index item]
  (let [items (or items [])]
    (if (>= insert-index (count items))
      (concat items [item])
      (apply concat
             (for-indexed [index existing items]
               (if (= index insert-index)
                 [item existing]
                 [existing]))))))

(defun reorder-items [items from-index to-index]
  (let [items (or items [])]
    (if (and (not (nil? from-index))
             (not (nil? to-index))
             (>= from-index 0)
             (< from-index (count items))
             (>= to-index 0)
             (< to-index (count items)))
      (insert-item-at-index (remove-item-at-index items from-index)
                            to-index
                            (nth items from-index))
      items)))

(defun reorder-index-value [index from-index to-index]
  (cond
    (nil? index) nil
    (= index from-index) to-index
    (and (< from-index to-index)
         (> index from-index)
         (<= index to-index)) (dec index)
    (and (> from-index to-index)
         (>= index to-index)
         (< index from-index)) (inc index)
    :default index))

(defun reorder-hidden-layer-indices [hidden-layer-indices from-index to-index]
  (map (or hidden-layer-indices [])
       (fn [index]
         (reorder-index-value index from-index to-index))))

(defun remove-layer-at [layers delete-index]
  (map (filter (for-indexed [index layer (or layers [])]
                 {:index index
                  :layer layer})
               (fn [entry]
                 (not= (:index entry) delete-index)))
       :layer))

(defun selected-layer-index-after-delete [selected-index delete-index remaining-count]
  (let [selected-index (or selected-index 0)]
    (cond
      (<= remaining-count 0) 0
      (< selected-index delete-index) selected-index
      (> selected-index delete-index) (dec selected-index)
      :default (min delete-index (dec remaining-count)))))

(defun set-layer-terrain-set [state index terrain-set-index]
  (let [terrain-set (data/terrain-set-key (:terrain-sets state)
                                          terrain-set-index)
        layer (get-in state [:layers index])]
    (if (and terrain-set
             (= (:data-kind layer) :terrain))
      (assoc-in state [:layers index :terrain-set] terrain-set)
      state)))

(defun layer-move-target-index [command index layer-count]
  (case command
    :move-up
    (if (> index 0)
      (dec index)
      nil)

    :move-down
    (if (< index (dec layer-count))
      (inc index)
      nil)

    :default
    nil))

(defun selected-layer-name [layers index]
  (:label (nth layers index)))

(defun selected-layer-terrain-set-index [state index]
  (data/terrain-set-index (:terrain-sets state)
                          (get-in state [:layers index :terrain-set])))

(defun open-layer-name-dialog! [state ctx operation index title name id]
  (let [terrain-set-operation? (= operation :terrain-set)]
    (do
      (push-mode! 'layer-name-dialog-modal
                  {:operation operation
                   :index index
                   :title title
                   :identity {:id id
                              :name name}
                   :layers (:layers state)
                   :terrain-sets (:terrain-sets state)
                   :data-kind (if terrain-set-operation? :terrain :tile-ref)
                   :terrain-set-index (if terrain-set-operation?
                                        (selected-layer-terrain-set-index state index)
                                        0)}
                  {:origin {:view (:view ctx)
                            :event :layer/name-dialog-result}})
      state)))

(defun open-layer-terrain-set-dialog! [state ctx index]
  (open-layer-name-dialog! state
                           ctx
                           :terrain-set
                           index
                           "Change Terrain Set"
                           (selected-layer-name (:layers state) index)
                           (keyword-label (get-in state [:layers index :id]))))

(defun open-layer-add-dialog! [state ctx]
  (open-layer-name-dialog! state
                           ctx
                           :add
                           nil
                           "New Layer"
                           (unique-layer-name-from (:layers state)
                                                   "Layer"
                                                   nil
                                                   nil)
                           (keyword-label
                            (unique-layer-id-from (:layers state)
                                                  "layer"
                                                  nil
                                                  nil))))

(defun open-layer-confirm-dialog! [state ctx operation index title message confirm-label]
  (do
    (dialog/open-confirm!
     ctx
     {:title title
      :body {:mode 'ui/text
             :style {:width :fill}
             :state {:value message}}
      :buttons [:dialog/cancel
                {:type :dialog/ok
                 :label confirm-label}]
      :result-event :layer/confirm-dialog-result
      :payload {:operation operation
                :index index}})
    state))

(defun apply-layer-move-command [state payload]
  (let [command (:command payload)
        index (:index payload)
        layers (or (:layers state) [])
        target-index (layer-move-target-index command index (count layers))]
    (if (nil? target-index)
      state
      (let [next-layers (swap-layer-indices layers index target-index)
            next-selected-index (swap-index-value (or (:selected-layer-index state) 0)
                                                  index
                                                  target-index)]
        (assoc state
               :layers next-layers
               :selected-layer-index next-selected-index
               :selected-layer-label (selected-layer-name next-layers next-selected-index)
               :hidden-layer-indices (swap-hidden-layer-indices
                                      (:hidden-layer-indices state)
                                      index
                                      target-index))))))

(defun apply-layer-reorder [state payload]
  (let [from-index (:from-index payload)
        to-index (:to-index payload)
        layers (or (:layers state) [])]
    (if (and (not (nil? from-index))
             (not (nil? to-index))
             (>= from-index 0)
             (< from-index (count layers))
             (>= to-index 0)
             (< to-index (count layers)))
      (let [next-layers (reorder-items layers from-index to-index)
            next-selected-index (reorder-index-value
                                 (or (:selected-layer-index state) 0)
                                 from-index
                                 to-index)]
        (assoc state
               :layers next-layers
               :selected-layer-index next-selected-index
               :selected-layer-label (selected-layer-name next-layers
                                                          next-selected-index)
               :hidden-layer-indices (reorder-hidden-layer-indices
                                      (:hidden-layer-indices state)
                                      from-index
                                      to-index)))
      state)))

(defun apply-delete-layer-result [state payload]
  (if (and (= (:choice payload) :dialog/ok)
           (= (-> payload :payload :operation) :delete))
    (let [index (-> payload :payload :index)
          layers (or (:layers state) [])]
      (if (<= (count layers) 1)
        state
        (let [next-layers (remove-layer-at layers index)
              next-index (selected-layer-index-after-delete (:selected-layer-index state)
                                                            index
                                                            (count next-layers))]
          (assoc state
                 :layers next-layers
                 :selected-layer-index next-index
                 :selected-layer-label (selected-layer-name next-layers next-index)
                 :hidden-layer-indices (shift-hidden-layer-indices-for-delete
                                        (:hidden-layer-indices state)
                                        index)))))
    state))

(defun apply-layer-name-dialog-result [state payload]
  (if (= (:type payload) :confirm)
    (let [operation (:operation payload)
          index (:index payload)
          layers (:layers state)
          requested-name (:name payload)]
        (case operation
          :add
        (let [name (unique-layer-name-from layers requested-name nil nil)
              id (requested-layer-id layers payload name nil)]
          (if id
            (append-layer state (assoc (assoc payload :name name) :id id))
            state))

        :rename
        (let [name (unique-layer-name-from layers requested-name index nil)
              id (requested-layer-id layers payload name index)]
          (if id
            (editor-workbook/change state (rename-layer-change state index name id))
            state))

        :duplicate
        (let [new-index (inc index)
              name (unique-layer-name-from layers requested-name nil nil)
              id (requested-layer-id layers payload name nil)]
          (if id
            (assoc state
                   :layers (duplicate-layer-after layers index name id)
                   :selected-layer-index new-index
                   :selected-layer-label name
                   :hidden-layer-indices (shift-hidden-layer-indices-for-insert
                                          (:hidden-layer-indices state)
                                          new-index))
            state))

        :terrain-set
        (set-layer-terrain-set state index (:terrain-set-index payload))

        :default
        state))
    state))



;; Map Dimensions Dialog

(defun open-map-dimensions-dialog! [state ctx]
  (dimensions-dialog/open! state ctx))



;; Layer Name Dialog

(def layer-identity-text
  {:id "Layer id"
   :name "Layer name"})

(def layer-identity-layout
  [:id :name])

(def layer-data-kind-options
  [{:value :tile-ref
    :label "Tile layer"}
   {:value :terrain
    :label "Terrain layer"}])

(def layer-data-kind-options-with-disabled-terrain
  [{:value :tile-ref
    :label "Tile layer"}
   {:value :terrain
    :label "Terrain layer"
    :disabled? true}])

(defun layer-data-kind-option-count [terrain-sets]
  (count (layer-data-kind-options-for terrain-sets)))

(defun layer-data-kind-options-for [terrain-sets]
  (if (empty? (or terrain-sets []))
    layer-data-kind-options-with-disabled-terrain
    layer-data-kind-options))

(defun layer-data-kind-selected-index [data-kind terrain-sets]
  (if (and (= data-kind :terrain)
           (> (layer-data-kind-option-count terrain-sets) 1))
    1
    0))

(defun terrain-set-selector-disabled? [data-kind terrain-sets]
  (or (not= data-kind :terrain)
      (empty? (or terrain-sets []))))

(defcomponent layer-create-kind-selector
  {:style {:width :fill
           :height 22}
   :update (fn [state ctx]
             (let [terrain-sets (or (:terrain-sets state) [])
                   selected-index (layer-data-kind-selected-index (:data-kind state)
                                                                  terrain-sets)]
               (assoc state :selected-data-kind-index selected-index)))
   :on {:combo-box/change (fn [state event ctx]
                            (assoc state
                                   :data-kind
                                   (-> event :payload :value)
                                   :selected-data-kind-index
                                   (-> event :payload :selected-index)))}
   :children [(cb/make {:options (ui/bind-state :layer-data-kind-options)
                        :selected-index (ui/bind-state :selected-data-kind-index)})]})

(defcomponent layer-terrain-set-selector
  {:style {:width :fill
           :height 22}
   :update (fn [state ctx]
             (assoc state
                    :terrain-set-disabled?
                    (terrain-set-selector-disabled? (:data-kind state)
                                                    (:terrain-sets state))))
   :on {:combo-box/change (fn [state event ctx]
                            (assoc state
                                   :terrain-set-index
                                   (-> event :payload :selected-index)))}
   :children [(cb/make {:options (ui/bind-state :terrain-set-options)
                        :selected-index (ui/bind-state :terrain-set-index)
                        :disabled? (ui/bind-state :terrain-set-disabled?)})]})

(defcomponent layer-terrain-set-options
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [visible? (and (= (:data-kind state) :terrain)
                                 (not (empty? (or (:terrain-sets state) []))))]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if visible? :visible :none))
                 state)))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Terrain set"}}
              {:mode 'layer-terrain-set-selector
               :state {:data-kind (ui/bind-state :data-kind)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :terrain-set-options
                       (ui/bind-state :terrain-set-options)
                       :terrain-set-index (ui/bind-state :terrain-set-index)
                       :terrain-set-disabled?
                       (ui/bind-state :terrain-set-disabled?)}}]})

(defcomponent layer-data-kind-options-panel
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (do
               (assoc-in! ctx
                          [:view :style :visibility]
                          (if (= (:operation state) :add) :visible :none))
               state))
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Layer type"}}
              {:mode 'layer-create-kind-selector
               :state {:data-kind (ui/bind-state :data-kind)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :layer-data-kind-options
                       (ui/bind-state :layer-data-kind-options)
                       :selected-data-kind-index
                       (ui/bind-state :selected-data-kind-index)}}]})

(defcomponent layer-create-options
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (let [operation (:operation state)
                   visible? (or (= operation :add)
                                (= operation :terrain-set))
                   terrain-sets (or (:terrain-sets state) [])
                   data-kind (if (and (= (:data-kind state) :terrain)
                                      (not (empty? terrain-sets)))
                               :terrain
                               :tile-ref)]
               (do
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if visible? :visible :none))
                 (assoc state
                        :data-kind data-kind
                        :terrain-set-index (or (:terrain-set-index state) 0)
                        :layer-data-kind-options
                        (layer-data-kind-options-for terrain-sets)
                        :terrain-set-options
                        (data/terrain-set-options terrain-sets)))))
   :children [{:mode 'layer-data-kind-options-panel
               :state {:operation (ui/bind-state :operation)
                       :data-kind (ui/bind-state :data-kind)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :layer-data-kind-options
                       (ui/bind-state :layer-data-kind-options)
                       :selected-data-kind-index
                       (ui/bind-state :selected-data-kind-index)}}
              {:mode 'layer-terrain-set-options
               :state {:data-kind (ui/bind-state :data-kind)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :terrain-set-options
                       (ui/bind-state :terrain-set-options)
                       :terrain-set-index (ui/bind-state :terrain-set-index)
                       :terrain-set-disabled?
                       (ui/bind-state :terrain-set-disabled?)}}]})

(defcomponent layer-identity-form-panel
  {:style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (do
               (assoc-in! ctx
                          [:view :style :visibility]
                          (if (= (:operation state) :terrain-set)
                            :none
                            :visible))
               state))
   :children [(form/make {:schema map-schemas/layer-identity-schema
                          :text layer-identity-text
                          :layout layer-identity-layout
                          :value (ui/bind-state :identity)})]})

(defcomponent layer-name-dialog-body
  {:class :ui/content
   :style {:width 300
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :children [{:mode 'layer-identity-form-panel
               :state {:operation (ui/bind-state :operation)
                       :identity (ui/bind-state :identity)}}
              {:mode 'layer-create-options
               :state {:operation (ui/bind-state :operation)
                       :data-kind (ui/bind-state :data-kind)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :terrain-set-index (ui/bind-state :terrain-set-index)}}
              {:mode 'layer-name-dialog-buttons
               :state {:identity (ui/bind-state :identity)
                       :operation (ui/bind-state :operation)
                       :index (ui/bind-state :index)
                       :layers (ui/bind-state :layers)
                       :data-kind (ui/bind-state :data-kind)
                       :terrain-set-index (ui/bind-state :terrain-set-index)}}]})

(defun layer-dialog-id-conflict? [layers id-text index operation name]
  (and (not (= operation :terrain-set))
       (not (blank? id-text))
       (layer-id-exists? layers
                         (layer-id-from-text id-text name)
                         (if (= operation :rename)
                           index
                           nil))))

(defun layer-dialog-invalid? [state]
  (and (not (= (:operation state) :terrain-set))
       (or (blank? (get-in state [:identity :name]))
           (blank? (get-in state [:identity :id]))
           (layer-dialog-id-conflict? (:layers state)
                                      (get-in state [:identity :id])
                                      (:index state)
                                      (:operation state)
                                      (get-in state [:identity :name])))))

(defcomponent layer-name-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :update (fn [state ctx]
             (assoc state :invalid? (layer-dialog-invalid? state)))
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx) :layer-name-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "OK"
                       :identity (ui/bind-state :identity)
                       :disabled? (ui/bind-state :invalid?)
                       :data-kind (ui/bind-state :data-kind)
                       :terrain-set-index (ui/bind-state :terrain-set-index)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :layer-name-dialog/confirm
                                       {:name (get-in state [:identity :name])
                                        :id (get-in state [:identity :id])
                                        :data-kind (:data-kind state)
                                        :terrain-set-index
                                        (:terrain-set-index state)})
                             state))}]})

(defmode layer-name-dialog-modal
  {:on {:layer-name-dialog/cancel (fn [state event ctx]
                                    (do
                                      (ui/stop-propagation! event)
                                      (pop-mode! {:type :cancel
                                                  :operation (:operation state)
                                                  :index (:index state)})
                                      state))
        :layer-name-dialog/confirm (fn [state event ctx]
                                     (do
                                       (ui/stop-propagation! event)
                                       (pop-mode! {:type :confirm
                                                   :operation (:operation state)
                                                   :index (:index state)
                                                   :name (-> event :payload :name)
                                                   :id (-> event :payload :id)
                                                   :data-kind (-> event :payload :data-kind)
                                                   :terrain-set-index
                                                   (-> event :payload :terrain-set-index)})
                                       state))}
   :compose {:render :pass}
   :children [(w/make {:title-bar {:title (ui/bind-state :title)}
                       :state {:title (ui/bind-state :title)
                               :operation (ui/bind-state :operation)
                               :index (ui/bind-state :index)
                               :identity (ui/bind-state :identity)
                               :layers (ui/bind-state :layers)
                               :data-kind (ui/bind-state :data-kind)
                               :terrain-sets (ui/bind-state :terrain-sets)
                               :terrain-set-index
                               (ui/bind-state :terrain-set-index)}
                       :body [{:mode 'layer-name-dialog-body
                               :state {:operation (ui/bind-state :operation)
                                       :index (ui/bind-state :index)
                                       :identity (ui/bind-state :identity)
                                       :layers (ui/bind-state :layers)
                                       :data-kind (ui/bind-state :data-kind)
                                       :terrain-sets (ui/bind-state :terrain-sets)
                                       :terrain-set-index
                                       (ui/bind-state :terrain-set-index)}}]})]})


;; Tileset Selection

(defun tileset-combo-child [tilesets disabled?]
  (let [tilesets (or tilesets [])]
    (cb/make {:options (data/tileset-options tilesets)
              :selected-index (ui/bind-state :selected-tileset-index)
              :row-height 20
              :max-height 72
              :disabled? (if (or disabled? (empty? tilesets))
                            true
                            false)})))

(defcomponent tileset-selector
  {:style {:width :fill
           :height :shrink}
   :init (fn [state ctx]
           (assoc state
                  :tilesets-list nil
                  :rendered-disabled? nil))
   :update (fn [state ctx]
             (let [tilesets (or (:tilesets state) [])
                   disabled? (:disabled? state)]
               (do
                 (when (or (not= tilesets (:tilesets-list state))
                           (not= disabled? (:rendered-disabled? state)))
                   (ui/replace-child! (:view ctx)
                                      "combo-box"
                                      (merge {:id "combo-box"}
                                             (tileset-combo-child tilesets
                                                                  disabled?))))
                 (assoc state
                        :tilesets-list tilesets
                        :rendered-disabled? disabled?))))
   :children [(merge {:id "combo-box"}
                     (tileset-combo-child [] true))]})

(defun make-tileset-controls []
  (hp/make {:title "Tile Definition Set"
            :style {:width :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :tileset/new)
                                             state))}]
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-tileset-index (ui/bind-state :selected-tileset-index)
                    :selected-layer-index (ui/bind-state :selected-layer-index)
                    :tilesets (ui/bind-state :tilesets)
                    :layers (ui/bind-state :layers)
                    :disabled? (ui/bind-state :map-layer-panel-disabled?)}
            :body-state {:selected-tileset-index (ui/bind-state :selected-tileset-index)
                         :tilesets (ui/bind-state :tilesets)
                         :disabled? (ui/bind-state :map-layer-panel-disabled?)}
            :on {:combo-box/change (fn [state event ctx]
                                      (let [index (-> event :payload :selected-index)]
                                        (if (:disabled? state)
                                          state
                                          (if (and (not (nil? (:selected-layer-index state)))
                                                   (> (count (or (:layers state) [])) 0))
                                            (assoc-in
                                             (assoc state :selected-tileset-index index)
                                             [:layers (:selected-layer-index state) :tileset]
                                             (data/tileset-key (:tilesets state) index))
                                            (assoc state :selected-tileset-index index)))))}
            :children [{:mode 'tileset-selector
                        :state {:selected-tileset-index (ui/bind-state :selected-tileset-index)
                                :tilesets (ui/bind-state :tilesets)
                                :disabled? (ui/bind-state :disabled?)}}
                       {:mode 'ui/text
                        :class :ui/muted
                        :state {:value "Applies to selected layer"}}]}))



;; Layer List

(def layer-list-row-height 26)
(def layer-list-min-visible-rows 3)

(defcomponent layer-visibility-toggle
  {:class :ui/list-item-hover
   :style {:width 24
           :height 22
           :layout {:direction :row
                    :align-items :center}}
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx) :layer/toggle-visible (:index state))
                    state))
   :children [{:mode 'ui/text
               :style {:width :fill
                       :text {:align :center}}
               :state {:value (ui/bind-state :visibility-label)}}]})

(defcomponent layer-row
  {:extend 'ui/list-box-item
   :class :ui/list-item-hover
   :style {:width :fill
           :height 26
           :padding [3 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (let [layer (:layer state)
                   visible? (layer-visible? (:hidden-layer-indices state)
                                            (:index state))]
               (assoc state
                      :selected (contains? (:selected-indices state)
                                           (:index state))
                      :visible? visible?
                      :visibility-label (if visible? "V" "-")
                      :layer-name (:label layer)
                      :tileset-label (layer-source-label state layer))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :list-box/item-click
                              {:index (:index state)
                               :value (:index state)
                               :shift? false
                               :ctrl? false})
                    (when (= (:button event) :right)
                      (menu/open-context-menu! (layer-context-menu state)
                                               (:global-position event)
                                               state
                                               ctx))
                    state))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (do
                           (ui/stop-propagation! event)
                           (when (= (:type payload) :action)
                             (ui/emit! (:view ctx)
                                       :layer/context-command
                                       {:index (:index state)
                                        :command (-> payload :payload :command)}))))
                       state)}
   :children [{:mode 'layer-visibility-toggle
               :state {:index (ui/bind-state :index)
                       :visibility-label (ui/bind-state :visibility-label)}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :layer-name)}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value (ui/bind-state :tileset-label)}}]})

(defun layer-row-child [index layer]
  {:mode 'layer-row
   :state {:index index
           :value index
           :layer (ui/bind-state :layers index)
           :tilesets (ui/bind-state :tilesets)
           :terrain-sets (ui/bind-state :terrain-sets)
           :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
           :selected-indices (ui/bind-state :selected-indices)}})

(defun layer-options [layers]
  (for-indexed [index layer (or layers [])]
    {:value index
     :label (:label layer)}))

(defun layer-list-height [layers]
  (* layer-list-row-height
     (max layer-list-min-visible-rows
          (count (or layers [])))))

(defun selected-layer-indices [state]
  (if (nil? (:selected-layer-index state))
    []
    [(:selected-layer-index state)]))

(defun layer-list-box-child [layers]
  (let [layers (or layers [])]
    (lb/make {:options (layer-options layers)
              :style {:width :fill
                      :height (layer-list-height layers)}
              :row-height layer-list-row-height
              :visible-rows (count layers)
              :content-width 200
              :disabled? (empty? layers)
              :state {:layers (ui/bind-state :layers)
                      :tilesets (ui/bind-state :tilesets)
                      :terrain-sets (ui/bind-state :terrain-sets)
                      :hidden-layer-indices (ui/bind-state :hidden-layer-indices)}
              :item-state-keys [:layers :tilesets :terrain-sets :hidden-layer-indices]
              :selected-indices (ui/bind-state :selected-indices)
              :reorderable? true
              :reorder-visual-strategy :placeholder
              :force-selection? true
              :item-child layer-row-child})))

(defcomponent layer-list
  {:style {:width :fill
           :height :shrink}
   :init (fn [state ctx]
           (assoc state
                  :row-count nil
                  :selected-indices (selected-layer-indices state)))
   :update (fn [state ctx]
             (let [layers (or (:layers state) [])
                   row-count (count layers)]
               (do
                 (when (not= row-count (:row-count state))
                   (ui/replace-child! (:view ctx)
                                      "list-box"
                                      (merge {:id "list-box"}
                                             (layer-list-box-child layers))))
                 (assoc state
                        :row-count row-count
                        :selected-indices (selected-layer-indices state)))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :layer/select
                                       (-> event :payload :value))
                             state))
        :list-box/reorder (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (ui/emit! (:view ctx)
                                        :layer/reorder
                                        (:payload event))
                             state))}
   :children [(merge {:id "list-box"}
                     (layer-list-box-child []))]})

(defun make-layer-controls []
  (hp/make {:title "Layers"
            :style {:width :fill}
            :header-style {:layout {:direction :row
                                    :align-items :center
                                    :gap 4}}
            :header-children [{:mode 'ui/button
                               :class :ui/toolbar-button
                               :state {:label "+"}
                               :on-click (fn [state event ctx]
                                           (do
                                             (ui/emit! (:view ctx)
                                                       :layer/add)
                                             state))}]
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-layer-index (ui/bind-state :selected-layer-index)
                    :selected-layer-label (ui/bind-state :selected-layer-label)
                    :map-width (ui/bind-state :map-width)
                    :map-height (ui/bind-state :map-height)
                    :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                    :tilesets (ui/bind-state :tilesets)
                    :terrain-sets (ui/bind-state :terrain-sets)
                    :layers (ui/bind-state :layers)}
            :body-state {:layers (ui/bind-state :layers)
                         :map-width (ui/bind-state :map-width)
                         :map-height (ui/bind-state :map-height)
                         :tilesets (ui/bind-state :tilesets)
                         :terrain-sets (ui/bind-state :terrain-sets)
                         :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                         :selected-layer-index (ui/bind-state :selected-layer-index)}
            :on {:layer/select (fn [state event ctx]
                                  (assoc state :selected-layer-index (:payload event)))
                 :layer/add (fn [state event ctx]
                              (open-layer-add-dialog! state ctx))
                 :layer/reorder (fn [state event ctx]
                                  (apply-layer-reorder state (:payload event)))
                 :layer/toggle-visible (fn [state event ctx]
                                         (assoc state
                                                :hidden-layer-indices
                                                (toggle-hidden-layer (:hidden-layer-indices state)
                                                                     (:payload event))))
                 :layer/context-command (fn [state event ctx]
                                          (let [payload (:payload event)
                                                command (:command payload)
                                                index (:index payload)
                                                name (selected-layer-name (:layers state) index)]
                                            (case command
                                              :rename
                                              (open-layer-name-dialog! state
                                                                       ctx
                                                                       :rename
                                                                       index
                                                                       "Rename Layer"
                                                                       name
                                                                       (keyword-label
                                                                        (get-in state
                                                                                [:layers index :id])))

                                              :duplicate
                                              (open-layer-name-dialog! state
                                                                       ctx
                                                                       :duplicate
                                                                       index
                                                                       "Duplicate Layer"
                                                                       (unique-layer-name-from
                                                                       (:layers state)
                                                                       name
                                                                       nil
                                                                       2)
                                                                       (keyword-label
                                                                        (unique-layer-id-from
                                                                         (:layers state)
                                                                         (kebab-case name)
                                                                         nil
                                                                         2)))

                                              :terrain-set
                                              (open-layer-terrain-set-dialog! state
                                                                              ctx
                                                                              index)

                                              :delete
                                              (open-layer-confirm-dialog! state
                                                                          ctx
                                                                          :delete
                                                                          index
                                                                          "Delete Layer"
                                                                          (str "Delete layer \"" name "\"?")
                                                                          "Delete")

                                              :default
                                              state)))}
            :children [{:mode 'layer-list
                        :state {:layers (ui/bind-state :layers)
                                :tilesets (ui/bind-state :tilesets)
                                :terrain-sets (ui/bind-state :terrain-sets)
                                :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                                :selected-layer-index (ui/bind-state :selected-layer-index)}}]}))



;; Zoom

(defun zoom-slider-state [state]
  (let [zoom (tilemap/clamp-zoom state (:zoom state))]
    (assoc state
           :zoom zoom
           :zoom-pixels (tilemap/zoom-pixels state zoom)
           :zoom-label (tilemap/zoom-label state zoom)
           :min-zoom-pixels 1
           :max-zoom-pixels (tilemap/max-zoom-pixels state))))

(defun apply-zoom-slider-change [state value]
  (let [zoom (tilemap/zoom-from-pixels state value)]
    (assoc state
           :zoom zoom
           :zoom-pixels (tilemap/zoom-pixels state zoom)
           :zoom-label (tilemap/zoom-label state zoom))))

(defcomponent zoom-control
  {:class :ui/panel
   :style {:padding 8
           :layout {:direction :column
                    :gap 4}}
   :update (fn [state ctx]
             (zoom-slider-state state))
   :on {:slider/change (fn [state event ctx]
                         (apply-zoom-slider-change state (:payload event)))}
   :children [{:mode 'ui/text
               :class :ui/title
               :state {:value (ui/bind-state :zoom-label)}}
              (sl/make {:value (ui/bind-state :zoom-pixels)
                        :min (ui/bind-state :min-zoom-pixels)
                        :max (ui/bind-state :max-zoom-pixels)
                        :step 1})]})

(defcomponent map-view-controls
  {:class :ui/panel
   :style {:width :fill
           :height 36
           :padding [6 8]
           :layout {:direction :row
                    :align-items :center
                    :gap 12}}
   :update (fn [state ctx]
             (zoom-slider-state state))
   :on {:slider/change (fn [state event ctx]
                         (apply-zoom-slider-change state (:payload event)))}
   :children [{:mode 'ui/text
               :class :ui/title
               :state {:value (ui/bind-state :zoom-label)}}
              (sl/make {:value (ui/bind-state :zoom-pixels)
                        :min (ui/bind-state :min-zoom-pixels)
                        :max (ui/bind-state :max-zoom-pixels)
                        :step 1})]})
