(ns tilemap-editor.view.masks.detail.mask.composition.selected-tile
  (:require pixils
            [pixils.ui :as ui]
            [tilemap-editor.view.masks.detail.mask.composition.offset-input :as offset-input]
            [tilemap-editor.view.terrains.model :as model]))

(defun selected-index [state]
  (let [index (:selected-mask-tile-item-index state)
        items (or (:selected-mask-tile-items state) [])]
    (when (and (some? index)
               (>= index 0)
               (< index (count items)))
      index)))

(defun selected-state [state]
  (let [index (selected-index state)
        items (or (:selected-mask-tile-items state) [])
        item (when-let [index index] (nth items index))
        offset (or (:offset item) {:x 0 :y 0})]
    {:selected-mask-tile-item-valid-index index
     :selected-mask-tile-item-label
     (if item
       (model/transition-id-label (:tile item))
       "Select a tile")
     :selected-mask-tile-offset-x (or (:x offset) 0)
     :selected-mask-tile-offset-y (or (:y offset) 0)
     :selected-mask-tile-offset-disabled? (nil? item)}))

(defun nudge-payload [state key]
  (let [index (selected-index state)
        items (or (:selected-mask-tile-items state) [])
        item (when-let [index index] (nth items index))
        offset (or (:offset item) {:x 0 :y 0})
        delta (case key
                :key/left {:x -1 :y 0}
                :key/right {:x 1 :y 0}
                :key/up {:x 0 :y -1}
                :key/down {:x 0 :y 1}
                :default nil)]
    (when (and item delta)
      {:index index
       :axis :both
       :value {:x (+ (or (:x offset) 0) (:x delta))
               :y (+ (or (:y offset) 0) (:y delta))}})))

(defun emit-nudge! [state event ctx]
  (when-let [payload (nudge-payload state (:key event))]
    (ui/stop-propagation! event)
    (ui/emit! (:view ctx) :mask/tile-item-offset-change payload))
  state)

(defcomponent mask-selected-tile-editor
  {:id "mask-selected-tile-editor"
   :focusable true
   :style {:width :fill
           :height :shrink
           :layout {:direction :column
                    :gap 6}}
   :update (fn [state ctx]
             (let [state (assoc state
                                :selected-mask-tile-items
                                (model/selected-mask-tile-items state))]
               (merge state (selected-state state))))
   :on-key-down emit-nudge!
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Selected Tile"}}
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 8}}
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width 44}
                           :state {:value "Tile"}}
                          {:mode 'ui/text
                           :style {:width :fill}
                           :state {:value (ui/bind-state
                                           :selected-mask-tile-item-label)}}]}
              {:style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 6}}
               :state (ui/bind-state)
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width 44}
                           :state {:value "Offset"}}
                          {:mode 'ui/text
                           :class :ui/muted
                           :state {:value "X"}}
                          (offset-input/make
                           (ui/bind-state
                            :selected-mask-tile-item-valid-index)
                           :x
                           (ui/bind-state :selected-mask-tile-offset-x)
                           (ui/bind-state
                            :selected-mask-tile-offset-disabled?))
                          {:mode 'ui/text
                           :class :ui/muted
                           :state {:value "Y"}}
                          (offset-input/make
                           (ui/bind-state
                            :selected-mask-tile-item-valid-index)
                           :y
                           (ui/bind-state :selected-mask-tile-offset-y)
                           (ui/bind-state
                            :selected-mask-tile-offset-disabled?))]}]})
