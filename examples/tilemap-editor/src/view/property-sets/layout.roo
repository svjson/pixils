(ns tilemap-editor.view.property-sets.layout
  (:require tilemap-editor.view.property-sets.fields
            tilemap-editor.view.property-sets.lists
            [tilemap-editor.view.property-sets.panels :as panels]
            [tilemap-editor.view.property-sets.targets :as targets]
            [tilemap-editor.view.property-sets.workspace :as workspace]))

(defun make-property-set-list-panel []
  (panels/make-property-set-list-panel))

(defun make-property-definition-panel []
  (panels/make-property-definition-panel))

(defun property-set-assignment-list-content-child [state]
  (targets/property-set-assignment-list-content-child state))

(defun property-value-list-content-child [state]
  (targets/property-value-list-content-child state))

(defun property-set-workspace-children []
  (workspace/property-set-workspace-children))
