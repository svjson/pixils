(ns tilemap-editor.view.property-sets.workspace
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.dialog :as dialog]
            [tilemap-editor.common.dialog.identity-dialog :as identity-dialog]
            [tilemap-editor.view.property-sets.form :as property-form]
            [tilemap-editor.view.property-sets.model :as model]))

(defun open-property-set-edit-dialog!
  "Opens an identity dialog for the selected property set.

  Args:
  - `state`: Property-set workspace state.
  - `ctx`: Current component hook context.

  Returns:
  The unchanged workspace state."
  [state ctx]
  (when-let [property-set (model/selected-property-set state)]
    (identity-dialog/open!
     ctx
     {:title "Edit Property Set"
      :id (model/keyword-label (:id property-set))
      :name (or (:label property-set) "")
      :result-event :property-set/edit-dialog-result}))
  state)

(defun open-property-set-delete-confirm-dialog!
  "Opens a confirmation dialog for a property-set deletion.

  Args:
  - `state`: Property-set workspace state.
  - `ctx`: Current component hook context.
  - `property-set-index`: Index of the property set to delete.
  - `name`: Display name shown in the confirmation message.

  Returns:
  The unchanged workspace state."
  [state ctx property-set-index name]
  (dialog/open-confirm!
   ctx
   {:title "Delete Property Set"
    :body {:mode 'ui/text
           :style {:width :fill}
           :state {:value (str "Delete property set \"" name "\"?")}}
    :buttons [:dialog/cancel
              {:type :dialog/ok
               :label "Delete"}]
    :result-event :property-set/delete-confirm-result
    :payload {:property-set-index property-set-index}})
  state)

(defcomponent property-set-workspace
  {:class :property-set/workspace
   :on {:property-set/add (fn [state event ctx]
                            (let [property-set (model/make-property-set
                                                (:property-sets state))]
                              (identity-dialog/open!
                               ctx
                               {:title "Add Property Set"
                                :id (model/keyword-label (:id property-set))
                                :name (:label property-set)
                                :result-event
                                :property-set/add-dialog-result})
                              state))
        :property-set/add-dialog-result
        (fn [state {:keys [payload]} ctx]
          (case (:type payload)
              :confirm
              (let [next-state
                    (model/add-property-set-with-id state
                                                    (:id payload)
                                                    (:name payload))]
                (ui/emit! (:view ctx)
                          :action/mutate!
                          {:label "Add property set"
                           :op :value/set
                           :target {:path [:property-sets]}
                           :args {:value (:property-sets next-state)}})
                (assoc state
                       :selected-property-set-index
                       (:selected-property-set-index next-state)
                       :selected-property-definition-index nil))

              :default state))
        :form/select
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (case (:field-id payload)
            :property-sets
            (assoc state
                   :selected-property-set-index (:index payload)
                   :selected-property-definition-index nil)

            :properties
            (assoc state
                   :selected-property-definition-index (:index payload))

            :default state))
        :form/change
        (fn [state {:keys [payload] :as event} ctx]
          (ui/stop-propagation! event)
          (ui/emit! (:view ctx)
                    :action/mutate!
                    {:label "Edit property sets"
                     :op :value/set
                     :target {:path [:property-sets]}
                     :args {:value (-> payload :form-value :property-sets)}})
          state)
        :property-set/context-command
        (fn [state {:keys [payload]} ctx]
          (let [property-set-index (:index payload)
                state (assoc state
                             :selected-property-set-index property-set-index
                             :selected-property-definition-index nil)]
            (case (:command payload)
              :edit
              (open-property-set-edit-dialog! state ctx)

              :delete
              (open-property-set-delete-confirm-dialog!
               state
               ctx
               property-set-index
               (model/property-set-label-by-index state property-set-index))

              :default
              state)))
        :property-set/edit-dialog-result
        (fn [state {:keys [payload]} ctx]
          (case (:type payload)
              :confirm
              (let [next-state
                    (model/set-selected-property-set-identity state
                                                              (:id payload)
                                                              (:name payload))]
                (ui/emit!
                 (:view ctx)
                 :action/mutate!
                 {:label "Edit property set"
                  :op :value/merge
                  :target {:path []}
                  :args {:value (select-keys next-state
                                             [:property-sets
                                              :tilesets
                                              :terrain-sets])}})
                state)

              :default state))
        :property-set/delete-confirm-result
        (fn [state {:keys [payload]} ctx]
          (if (and (= (:choice payload) :dialog/ok)
                   (some? (-> payload
                              :payload
                              :property-set-index)))
            (let [next-state
                  (model/delete-selected-property-set
                   (assoc state
                          :selected-property-set-index
                          (-> payload :payload :property-set-index)
                          :selected-property-definition-index nil))]
              (ui/emit!
               (:view ctx)
               :action/mutate!
               {:label "Delete property set"
                :op :value/merge
                :target {:path []}
                :args {:value (select-keys next-state
                                           [:property-sets
                                            :tilesets
                                            :terrain-sets])}})
              (assoc state
                     :selected-property-set-index
                     (:selected-property-set-index next-state)
                     :selected-property-definition-index nil))
            state))
        :property-definition/add
        (fn [state event ctx]
          (when-let [property-set (model/selected-property-set state)]
            (let [property (model/make-property (:properties property-set))]
              (identity-dialog/open!
               ctx
               {:title "Add Property"
                :id (model/keyword-label (:id property))
                :name (:label property)
                :result-event :property-definition/add-dialog-result})))
          state)
        :property-definition/add-dialog-result
        (fn [state {:keys [payload]} ctx]
          (case (:type payload)
              :confirm
              (let [next-state
                    (model/add-property-definition-with-id state
                                                           (:id payload)
                                                           (:name payload))]
                (ui/emit! (:view ctx)
                          :action/mutate!
                          {:label "Add property"
                           :op :value/set
                           :target {:path [:property-sets]}
                           :args {:value (:property-sets next-state)}})
                (assoc state
                       :selected-property-definition-index
                       (:selected-property-definition-index next-state)))

              :default state))}
   :children [(property-form/make)]})
