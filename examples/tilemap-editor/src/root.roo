(ns tilemap-editor.root
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.tab-panel :as tabs]
            [tilemap-editor.view.tilemap.controls :as controls]
            [pixils.tilemap.project.model :as data]
            [tilemap-editor.model.tilemap :as tilemap]
            [tilemap-editor.model.maps :as map-model]
            [tilemap-editor.io.project :as project-io]
            [tilemap-editor.view.resources.model :as resource-model]
            [tilemap-editor.view.tileset.model :as tileset-model]
            tilemap-editor.view.brushes.layout
            [tilemap-editor.view.menu :as app-menu]
            tilemap-editor.view.resources.layout
            tilemap-editor.view.terrains.layout
            tilemap-editor.view.tilemap.layout
            tilemap-editor.view.tileset.dialogs
            tilemap-editor.view.tileset.layout))



;; Root mode

(defun request-tileset-shortcut-dialog [state]
  (assoc state
         :workspace-tab :tilesets
         :pending-tileset-shortcut-dialog? true))

(defun open-tileset-shortcut-dialog! [state ctx]
  (let [id (tileset-model/unique-tileset-id (:tilesets state))]
    (do
      (push-mode! 'tileset-create-dialog-modal
                  {:tileset-id id
                   :tileset-label (tileset-model/label-from-id id)
                   :tile-size (data/map-tile-size (:tile-size state))
                   :confirm-label "Create"}
                  {:origin {:view (:view ctx)
                            :event :tileset/shortcut-dialog-result}})
      (assoc state :pending-tileset-shortcut-dialog? false))))

(defun open-pending-tileset-shortcut-dialog! [state ctx]
  (if (and (:pending-tileset-shortcut-dialog? state)
           (= (:workspace-tab state) :tilesets))
    (open-tileset-shortcut-dialog! state ctx)
    state))

(defun apply-tileset-shortcut-dialog-result [state payload]
  (tileset-model/add-tileset-definition! state payload))

(defun apply-theme-selection! [state payload]
  (do
    (pixils/set-theme! (:theme payload))
    (assoc state :application-theme (:value payload))))

(defmode main-mode
 {:class :ui/app
  :action-map app-menu/tilemap-editor-menu-keymap
  :style {:layout {:direction :column
                   :gap 8}}
  :init (fn [state ctx]
          {:selected-tile nil
           :selected-tileset-index nil
           :selected-tileset-definition-index nil
           :selected-tileset-tile-index nil
           :selected-tileset-tile-indices []
           :tilesets []
           :tileset nil
           :terrain-sets []
           :selected-terrain-set-index nil
           :selected-terrain-index nil
           :rulesets []
           :selected-terrain-ruleset-id nil
           :selected-terrain-rule-id nil
           :selected-terrain-rule-match-direction :n
           :selected-terrain-rule-output-position {:x 1 :y 1}
           :terrain-rule-selected-tile nil
           :terrain-rule-list-offset {:x 0 :y 0}
           :layer-profiles []
           :selected-layer-profile-id nil
           :brushes []
           :selected-brush-index nil
           :selected-brush-layer-index nil
           :brush-selected-tile nil
           :map-palette-tab :tiles
           :maps [(data/normalize-map-document {} 0)]
           :map-ui-states {}
           :selected-map-id data/default-map-id
           :selected-map-label data/default-map-label
           :map-width data/map-width
           :map-height data/map-height
           :tile-size data/tile-size
           :selected-layer-index nil
           :selected-layer-label ""
           :layers []
           :map-tool :paint
           :map-selection nil
           :map-line nil
           :terrain-rule-application :preview
           :application-theme :pixils/windows-3
           :show-terrain-rules? true
           :terrain-stamp-layers []
           :terrain-stamp-replacements []
           :hidden-layer-indices []
           :selected-label ""
           :project-path nil
           :project-directory nil
           :project-filename "tilemap-project.edn"
           :resources data/project-resources
           :synced-resources nil
           :selected-resource-bundle nil
           :selected-image-resource nil
           :project-history-path project-io/default-recent-projects-path
           :recent-projects (project-io/load-recent-projects
                             project-io/default-recent-projects-path)
           :zoom 1
           :zoom-label "Zoom 100%"
           :show-grid? true
           :map-offset {:x 0 :y 0}
           :workspace-tab :map
           :pending-tileset-shortcut-dialog? false})
  :update (fn [state ctx]
            (let [resources (:resources state)
                  state (if (not= resources (:synced-resources state))
                          (do
                            (resource-model/sync-project-resources! resources)
                            (assoc state :synced-resources resources))
                          state)
                  layers (or (:layers state) [])
                  layer-index (or (:selected-layer-index state) 0)
                  layer (when (> (count layers) 0)
                          (nth layers (min layer-index (dec (count layers)))))
                  tileset (:tileset layer)
                  tilesets (or (:tilesets state) [])
                  terrain-sets (or (:terrain-sets state) [])
                  tileset-definition-index (when (> (count tilesets) 0)
                                             (min (or (:selected-tileset-definition-index state)
                                                      0)
                                                  (dec (count tilesets))))
                  tileset-definition (when (not (nil? tileset-definition-index))
                                       (nth tilesets tileset-definition-index))
                  tileset-tile-count (count (or (:tiles tileset-definition) []))
                  tileset-tile-index (when (> tileset-tile-count 0)
                                       (min (or (:selected-tileset-tile-index state) 0)
                                            (dec tileset-tile-count)))
                  tileset-tile-indices (filter (or (:selected-tileset-tile-indices state)
                                                    [])
                                                (fn [index]
                                                  (and (not (nil? index))
                                                       (>= index 0)
                                                       (< index tileset-tile-count))))
                  tileset-tile-indices (if (or (not (empty? tileset-tile-indices))
                                               (nil? tileset-tile-index))
                                         tileset-tile-indices
                                         [tileset-tile-index])
                  selected-tile (data/source-layer-value-id
                                 tilesets
                                 terrain-sets
                                 layer
                                 (:selected-tile state))
                  zoom (tilemap/clamp-zoom state (:zoom state))]
              (open-pending-tileset-shortcut-dialog!
               (assoc state
                      :tileset tileset
                      :selected-tileset-index (when tileset
                                                (data/tileset-index tilesets
                                                                    tileset))
                      :selected-tileset-definition-index tileset-definition-index
                      :selected-tileset-tile-index tileset-tile-index
                      :selected-tileset-tile-indices tileset-tile-indices
                      :selected-tile selected-tile
                      :selected-label (data/source-layer-value-label
                                       tilesets
                                       terrain-sets
                                       layer
                                       selected-tile)
                      :zoom zoom
                      :zoom-label (tilemap/zoom-label state zoom)
                      :selected-layer-label (or (:label layer) ""))
               ctx)))
  :children [{:mode 'tilemap-editor-menu-bar
              :state {:recent-projects (ui/bind-state :recent-projects)
                      :show-grid? (ui/bind-state :show-grid?)
                      :show-terrain-rules?
                      (ui/bind-state :show-terrain-rules?)
                      :terrain-rule-application
                      (ui/bind-state :terrain-rule-application)
                      :application-theme
                      (ui/bind-state :application-theme)}}
             (tabs/make
              {:selected-tab (ui/bind-state :workspace-tab)
               :style {:width :fill
                       :height :fill}
               :state {:selected-tile (ui/bind-state :selected-tile)
                       :map-width (ui/bind-state :map-width)
                       :map-height (ui/bind-state :map-height)
                       :tile-size (ui/bind-state :tile-size)
                       :maps (ui/bind-state :maps)
                       :map-ui-states (ui/bind-state :map-ui-states)
                       :selected-map-id (ui/bind-state :selected-map-id)
                       :selected-map-label
                       (ui/bind-state :selected-map-label)
                       :selected-label (ui/bind-state :selected-label)
                       :selected-tileset-index (ui/bind-state :selected-tileset-index)
                       :selected-tileset-definition-index (ui/bind-state :selected-tileset-definition-index)
                       :selected-tileset-tile-index (ui/bind-state :selected-tileset-tile-index)
                       :selected-tileset-tile-indices (ui/bind-state :selected-tileset-tile-indices)
                       :tilesets (ui/bind-state :tilesets)
                       :tileset (ui/bind-state :tileset)
                       :terrain-sets (ui/bind-state :terrain-sets)
                       :selected-terrain-set-index
                       (ui/bind-state :selected-terrain-set-index)
                       :selected-terrain-index
                       (ui/bind-state :selected-terrain-index)
                       :rulesets (ui/bind-state :rulesets)
                       :selected-terrain-ruleset-id
                       (ui/bind-state :selected-terrain-ruleset-id)
                       :selected-terrain-rule-id
                       (ui/bind-state :selected-terrain-rule-id)
                       :selected-terrain-rule-match-direction
                       (ui/bind-state
                        :selected-terrain-rule-match-direction)
                       :selected-terrain-rule-output-position
                       (ui/bind-state
                        :selected-terrain-rule-output-position)
                       :terrain-rule-selected-tile
                       (ui/bind-state :terrain-rule-selected-tile)
                       :terrain-rule-list-offset
                       (ui/bind-state :terrain-rule-list-offset)
                       :layer-profiles (ui/bind-state :layer-profiles)
                       :selected-layer-profile-id
                       (ui/bind-state :selected-layer-profile-id)
                       :brushes (ui/bind-state :brushes)
                       :selected-brush-index (ui/bind-state :selected-brush-index)
                       :selected-brush-layer-index (ui/bind-state :selected-brush-layer-index)
                       :brush-selected-tile (ui/bind-state :brush-selected-tile)
                       :map-palette-tab (ui/bind-state :map-palette-tab)
                       :map-tool (ui/bind-state :map-tool)
                       :map-selection (ui/bind-state :map-selection)
                       :map-line (ui/bind-state :map-line)
                       :selected-layer-index (ui/bind-state :selected-layer-index)
                       :selected-layer-label (ui/bind-state :selected-layer-label)
                       :layers (ui/bind-state :layers)
                       :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                       :zoom (ui/bind-state :zoom)
                       :zoom-label (ui/bind-state :zoom-label)
                       :terrain-rule-application
                       (ui/bind-state :terrain-rule-application)
                       :terrain-stamp-layers
                       (ui/bind-state :terrain-stamp-layers)
                       :terrain-stamp-replacements
                       (ui/bind-state :terrain-stamp-replacements)
                       :show-terrain-rules?
                       (ui/bind-state :show-terrain-rules?)
                       :show-grid? (ui/bind-state :show-grid?)
                       :map-offset (ui/bind-state :map-offset)
                       :resources (ui/bind-state :resources)
                       :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                       :selected-image-resource (ui/bind-state :selected-image-resource)}
               :tabs [{:id :map
                       :label "Map"
                       :child {:mode 'workspace
                               :style {:padding {:l 8
                                                 :r 8
                                                 :b 8}}
                               :state {:selected-tile (ui/bind-state :selected-tile)
                                       :map-width (ui/bind-state :map-width)
                                       :map-height (ui/bind-state :map-height)
                                       :tile-size (ui/bind-state :tile-size)
                                       :maps (ui/bind-state :maps)
                                       :map-ui-states
                                       (ui/bind-state :map-ui-states)
                                       :selected-map-id
                                       (ui/bind-state :selected-map-id)
                                       :selected-map-label
                                       (ui/bind-state :selected-map-label)
                                       :selected-label (ui/bind-state :selected-label)
                                       :selected-tileset-index (ui/bind-state :selected-tileset-index)
                                       :tilesets (ui/bind-state :tilesets)
                                       :tileset (ui/bind-state :tileset)
                                       :terrain-sets (ui/bind-state :terrain-sets)
                                       :rulesets (ui/bind-state :rulesets)
                                       :layer-profiles (ui/bind-state :layer-profiles)
                                       :selected-layer-profile-id
                                       (ui/bind-state :selected-layer-profile-id)
                                       :brushes (ui/bind-state :brushes)
                                       :selected-brush-index
                                       (ui/bind-state :selected-brush-index)
                                       :map-palette-tab
                                       (ui/bind-state :map-palette-tab)
                                       :map-tool (ui/bind-state :map-tool)
                                       :map-selection (ui/bind-state :map-selection)
                                       :map-line (ui/bind-state :map-line)
                                       :selected-layer-index (ui/bind-state :selected-layer-index)
                                       :selected-layer-label (ui/bind-state :selected-layer-label)
                                       :layers (ui/bind-state :layers)
                                       :hidden-layer-indices (ui/bind-state :hidden-layer-indices)
                                       :zoom (ui/bind-state :zoom)
                                       :zoom-label (ui/bind-state :zoom-label)
                                       :terrain-rule-application
                                       (ui/bind-state :terrain-rule-application)
                                       :terrain-stamp-layers
                                       (ui/bind-state :terrain-stamp-layers)
                                       :terrain-stamp-replacements
                                       (ui/bind-state :terrain-stamp-replacements)
                                       :show-terrain-rules?
                                       (ui/bind-state :show-terrain-rules?)
                                       :show-grid? (ui/bind-state :show-grid?)
                                       :map-offset (ui/bind-state :map-offset)}}}
                      {:id :tilesets
                       :label "Tilesets"
                       :child {:mode 'tileset-definition-workspace
                               :style {:padding 8}
                               :state {:selected-tileset-index (ui/bind-state :selected-tileset-index)
                                       :selected-tileset-definition-index (ui/bind-state :selected-tileset-definition-index)
                                       :selected-tileset-tile-index (ui/bind-state :selected-tileset-tile-index)
                                       :selected-tileset-tile-indices (ui/bind-state :selected-tileset-tile-indices)
                                       :tilesets (ui/bind-state :tilesets)
                                       :tileset (ui/bind-state :tileset)
                                       :selected-layer-index (ui/bind-state :selected-layer-index)
                                       :layers (ui/bind-state :layers)
                                       :project-directory (ui/bind-state :project-directory)
                                       :resources (ui/bind-state :resources)
                                       :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                                       :selected-image-resource (ui/bind-state :selected-image-resource)}}}
                      {:id :brushes
                       :label "Brushes"
                       :child {:mode 'brush-definition-workspace
                               :style {:padding 8}
                               :state {:brushes (ui/bind-state :brushes)
                                       :selected-brush-index (ui/bind-state :selected-brush-index)
                                       :selected-brush-layer-index
                                       (ui/bind-state :selected-brush-layer-index)
                                       :brush-selected-tile (ui/bind-state :brush-selected-tile)
                                       :tilesets (ui/bind-state :tilesets)
                                       :terrain-sets (ui/bind-state :terrain-sets)
                                       :layer-profiles (ui/bind-state :layer-profiles)
                                       :selected-layer-profile-id
                                       (ui/bind-state :selected-layer-profile-id)
                                       :layers (ui/bind-state :layers)}}}
                      {:id :resources
                       :label "Resources"
                       :child {:mode 'resource-explorer-workspace
                               :style {:padding 8}
                               :state {:project-directory (ui/bind-state :project-directory)
                                       :tilesets (ui/bind-state :tilesets)
                                       :layers (ui/bind-state :layers)
                                       :terrain-sets (ui/bind-state :terrain-sets)
                                       :resources (ui/bind-state :resources)
                                       :selected-resource-bundle (ui/bind-state :selected-resource-bundle)
                                       :selected-image-resource (ui/bind-state :selected-image-resource)}}}
                      {:id :terrains
                       :label "Terrains"
                       :child {:mode 'terrain-definition-workspace
                               :style {:padding 8}
                               :state {:terrain-sets (ui/bind-state :terrain-sets)
                                       :tilesets (ui/bind-state :tilesets)
                                       :rulesets (ui/bind-state :rulesets)
                                       :layers (ui/bind-state :layers)
                                       :layer-profiles
                                       (ui/bind-state :layer-profiles)
                                       :selected-layer-profile-id
                                       (ui/bind-state
                                        :selected-layer-profile-id)
                                       :selected-terrain-set-index
                                       (ui/bind-state :selected-terrain-set-index)
                                       :selected-terrain-index
                                       (ui/bind-state :selected-terrain-index)
                                       :selected-terrain-ruleset-id
                                       (ui/bind-state
                                        :selected-terrain-ruleset-id)
                                       :selected-terrain-rule-id
                                       (ui/bind-state
                                        :selected-terrain-rule-id)
                                       :selected-terrain-rule-match-direction
                                       (ui/bind-state
                                        :selected-terrain-rule-match-direction)
                                       :selected-terrain-rule-output-position
                                       (ui/bind-state
                                        :selected-terrain-rule-output-position)
                                       :terrain-rule-selected-tile
                                       (ui/bind-state
                                        :terrain-rule-selected-tile)
                                       :terrain-rule-list-offset
                                       (ui/bind-state
                                        :terrain-rule-list-offset)}}}]})]
  :on {:palette/select (fn [state event ctx]
                         (assoc state :selected-tile (:payload event)))
       :palette/brush-select (fn [state event ctx]
                               (assoc state :selected-brush-index
                                      (:payload event)))
       :palette/tab-select (fn [state event ctx]
                             (assoc state :map-palette-tab (:payload event)))
       :map/tool-select (fn [state event ctx]
                          (let [tool (or (:payload event) :paint)]
                            (assoc state
                                   :map-tool tool
                                   :map-selection (if (= tool :select)
                                                    (:map-selection state)
                                                    nil)
                                   :map-line nil)))
       :tab-panel/change (fn [state event ctx]
                           (assoc state :workspace-tab (-> event :payload :tab)))
       :layer/name-dialog-result (fn [state event ctx]
                                   (controls/apply-layer-name-dialog-result
                                    state
                                    (:payload event)))
       :layer/confirm-dialog-result (fn [state event ctx]
                                      (controls/apply-delete-layer-result
                                       state
                                       (:payload event)))
       :layer/context-command (fn [state event ctx]
                                (controls/apply-layer-move-command
                                 state
                                 (:payload event)))
       :tileset/new (fn [state event ctx]
                      (request-tileset-shortcut-dialog state))
       :tileset/shortcut-dialog-result
       (fn [state event ctx]
         (apply-tileset-shortcut-dialog-result state (:payload event)))
       :map/select (fn [state event ctx]
                     (map-model/activate-map state (:payload event)))
       :map/add (fn [state event ctx]
                  (controls/open-map-add-dialog! state ctx))
       :map/rename (fn [state event ctx]
                     (controls/open-map-rename-dialog! state ctx))
       :map/duplicate (fn [state event ctx]
                        (controls/open-map-duplicate-dialog! state ctx))
       :map/delete (fn [state event ctx]
                     (if (> (count (or (:maps state) [])) 1)
                       (controls/open-map-delete-confirm-dialog! state ctx)
                       state))
       :map/id-name-dialog-result
       (fn [state event ctx]
         (map-model/apply-map-dialog-result state (:payload event)))
       :map/delete-dialog-result
       (fn [state event ctx]
         (let [payload (:payload event)]
           (if (= (:choice payload) :dialog/ok)
             (map-model/delete-map state (-> payload :payload :map-id))
             state)))
       :map/edit-dimensions (fn [state event ctx]
                              (controls/open-map-dimensions-dialog! state ctx))
       :map/dimensions-dialog-result
       (fn [state event ctx]
         (let [payload (:payload event)]
           (if (= (:type payload) :confirm)
             (tilemap/set-map-dimensions state
                                         (:width payload)
                                         (:height payload)
                                         (:tile-size payload))
             state)))
       :project/open (fn [state event ctx]
                       (project-io/open-project-file-dialog! state
                                                             ctx
                                                             :file-dialog/open
                                                             "Open Project"))
       :project/open-recent (fn [state event ctx]
                              (project-io/open-recent-project! state
                                                               (:payload event)))
       :project/save-as (fn [state event ctx]
                          (project-io/open-project-file-dialog! state
                                                                ctx
                                                                :file-dialog/save
                                                                "Save Project As"))
       :project/save (fn [state event ctx]
                       (if (:project-path state)
                         (project-io/apply-project-file-dialog-result
                          state
                          {:type :confirm
                           :mode :file-dialog/save
                           :path (:project-path state)
                           :directory (:project-directory state)
                           :filename (:project-filename state)})
                         (project-io/open-project-file-dialog! state
                                                               ctx
                                                               :file-dialog/save
                                                               "Save Project")))
              :project/file-dialog-result (fn [state event ctx]
                                            (project-io/apply-project-file-dialog-result
                                             state
                                             (:payload event)))
              :project/resources-change
              (fn [state event ctx]
                (let [payload (:payload event)]
                  (assoc state
                         :resources (:resources payload)
                         :selected-resource-bundle (:selected-resource-bundle payload)
                         :selected-image-resource (:selected-image-resource payload))))
              :view/toggle-grid (fn [state event ctx]
                                  (assoc state
                                         :show-grid?
                                         (not (:show-grid? state))))
              :view/toggle-terrain-rules
              (fn [state event ctx]
                (assoc state
                       :show-terrain-rules?
                       (not (:show-terrain-rules? state))))
              :terrain-rules/set-application
              (fn [state event ctx]
                (tilemap/set-terrain-rule-application state (:payload event)))
              :theme/select
              (fn [state event ctx]
                (apply-theme-selection! state (:payload event)))
              :app/quit (fn [state event ctx]
                          (quit!))}})
