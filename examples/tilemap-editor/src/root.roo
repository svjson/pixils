                       :selected-terrain-transition-id
                       (ui/bind-state :selected-terrain-transition-id)
                       :selected-terrain-ruleset-id
                       (ui/bind-state :selected-terrain-ruleset-id)
                       :selected-terrain-rule-id
                       (ui/bind-state :selected-terrain-rule-id)
                       :selected-terrain-rule-match-direction
                       (ui/bind-state
