(def tile-types platform-level-tile-types)

(def tilesets
  [{:id :colors
    :label "Background Colors"}
   {:id :platform-level
    :label "Platform Level"}
   {:id :platform-actors
    :label "Platform Actors"}
   {:id :platform-foreground
    :label "Platform Foreground"}])

(def project-format :pixils.tilemap-editor/project)
(def project-format-version 1)

(def project-resources
  {:images {:editor-assets/spritesheet
            {:file-name "assets/simples_pimples.png"
             :transparency-color "#5a5268"}}})

(def tileset-options
  (for-indexed [index tileset tilesets]
    {:value index
     :label (:label tileset)}))

(defun tileset-options-for-definitions [tileset-definitions]
  (for-indexed [index tileset (or tileset-definitions [])]
    {:value index
     :label (:label tileset)}))

(def tilemap-layers
  [{:id :scene/background
    :label "Background"
    :kind :tile
    :tileset :colors
    :order 0}
   {:id :scene/level
    :label "Level"
    :kind :tile
    :tileset :platform-level
    :order 10}
   {:id :scene/actor
    :label "Actor"
    :kind :tile
    :tileset :platform-actors
    :order 20}
   {:id :scene/foreground
    :label "Foreground"
    :kind :tile
    :tileset :platform-foreground
    :order 30}])

(def layer-options
  (for-indexed [index layer tilemap-layers]
    {:value index
     :label (:label layer)}))

(defun tileset-key [index]
  (:id (nth tilesets (or index 0))))

(defun tileset-key-in [tileset-definitions index]
  (let [items (or tileset-definitions [])]
    (when (> (count items) 0)
      (:id (nth items (or index 0))))))

(defun tileset-index [tileset]
  (let [match (find-index tilesets (fn [item]
                                     (= (:id item) tileset)))]
    (or match 0)))

(defun tileset-index-in [tileset-definitions tileset]
  (let [match (find-index (or tileset-definitions [])
                          (fn [item]
                            (= (:id item) tileset)))]
    (or match 0)))

(defun tileset-label [tileset]
  (or (:label (nth tilesets (tileset-index tileset))) ""))

(defun tileset-label-in [tileset-definitions tileset]
  (let [items (or tileset-definitions [])]
    (if (> (count items) 0)
      (or (:label (nth items (tileset-index-in tileset-definitions tileset))) "")
      "")))

(defun layer-key [index]
  (:id (nth tilemap-layers (or index 0))))

(defun layer-label [index]
  (:label (nth tilemap-layers (or index 0))))

(defun tile-types-for [tileset]
  (case tileset
    :colors color-tile-types
    :platform-level platform-level-tile-types
    :platform-actors platform-actor-tile-types
    :platform-foreground platform-foreground-tile-types
    :default []))

(defun tile-count-for [tileset]
  (count (tile-types-for tileset)))

(defun clamp-tile-index [tileset index]
  (let [count (tile-count-for tileset)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun tile-index-in [tileset tile-ref]
  (if (keyword? tile-ref)
    (let [match (find-index (tile-types-for tileset)
                            (fn [tile]
                              (= (:id tile) tile-ref)))]
      (or match 0))
    (clamp-tile-index tileset tile-ref)))

(defun tile-id-in [tileset tile-ref]
  (let [types (tile-types-for tileset)]
    (when (> (count types) 0)
      (:id (nth types (tile-index-in tileset tile-ref))))))

(defun tile-char-match? [tile ch]
  (and (not (nil? (:char tile)))
       (= (:char tile) ch)))

(defun tile-id-for-char [tileset ch]
  (let [tile (head (filter (tile-types-for tileset)
                           (fn [candidate]
                             (tile-char-match? candidate ch))))]
    (when tile
      (:id tile))))

(defun tile-options-for [tileset]
  (for-indexed [index tile (tile-types-for tileset)]
    {:value (:id tile)
     :label (:name tile)}))

(defun tile-in [tileset tile-ref]
  (let [types (tile-types-for tileset)]
    (when (> (count types) 0)
      (nth types (tile-index-in tileset tile-ref)))))

(defun tile [tile-ref]
  (tile-in :platform-level tile-ref))

(defun tile-color [tile-ref]
  (:color (tile tile-ref)))

(defun tile-name [tile-ref]
  (:name (tile tile-ref)))

(defun tile-name-in [tileset tile-ref]
  (:name (tile-in tileset tile-ref)))

(defun tile-label-in [tileset tile-ref]
  (let [tile (tile-in tileset tile-ref)]
    (if tile
      (str "Selected: " (:name tile) " (" (:type tile) ")")
      "")))

(defun tile-label [tile-ref]
  (tile-label-in :platform-level tile-ref))

