   :scene/level level-map-strings
   :scene/actor actor-map-strings
   :scene/foreground foreground-map-strings})

(defun string-map-width [rows]
  (count (or (head rows) "")))

(defun uniform-string-map? [rows]
  (let [width (string-map-width rows)]
    (= 0 (count (filter rows (fn [row]
                               (not= (count row) width)))))))

(defun string-row-to-tile-ids [tileset row width]
  (dotimes [x width]
    (tile-id-for-char tileset (substr row x 1))))

(defun string-map-to-tile-map [tileset rows]
  (let [width (string-map-width rows)]
    (dotimes [y (count rows)]
      (string-row-to-tile-ids tileset (nth rows y) width))))

(defun make-empty-row []
  (dotimes [x map-width]
    nil))

(defun make-empty-map []
  (dotimes [y map-height]
    (make-empty-row)))

(defun make-layer [definition tiles]
  (assoc definition :tiles tiles))

(defun serialized-nil? [value]
  (and (= (type-of value) "symbol")
       (= (str value) "nil")))

(defun normalize-tile-ref [tile-ref]
  (if (serialized-nil? tile-ref)
    nil
    tile-ref))

(defun normalize-tile-row [row]
  (map row normalize-tile-ref))

(defun normalize-layer [layer]
  (update layer :tiles (fn [tiles]
                         (map (or tiles [])
                              normalize-tile-row))))

(defun normalize-layers [layers]
  (map (or layers []) normalize-layer))

(defun normalize-project-document [project]
  (assoc-in project
            [:tilemap :layers]
            (normalize-layers (-> project :tilemap :layers))))

(defun make-layer-from-string-map [definition rows]
  (make-layer definition
              (if (and rows (uniform-string-map? rows))
                (string-map-to-tile-map (:tileset definition) rows)
                (make-empty-map))))

(defun make-layered-map-from-string-maps [layer-definitions layer-string-maps]
  (for-indexed [index layer layer-definitions]
    (make-layer-from-string-map layer
                                (get layer-string-maps (:id layer)))))

(defun make-example-layered-map []
  (make-layered-map-from-string-maps tilemap-layers example-layer-string-maps))

(defun make-empty-layered-map []
  (for-indexed [index layer tilemap-layers]
    (make-layer layer (make-empty-map))))

(defun make-layered-map []
  (make-empty-layered-map))

(defun tileset-definition [tileset]
  (assoc tileset
         :tile-size tile-size
         :tiles (tile-types-for (:id tileset))))

(defun project-tileset-definitions []
  (map tilesets tileset-definition))

(defun project-document [state]
  {:format project-format
   :version project-format-version
   :resources project-resources
   :tilesets (or (:tilesets state) [])
   :tilemap {:width map-width
             :height map-height
             :tile-size tile-size
             :layers (or (:layers state) [])}})
