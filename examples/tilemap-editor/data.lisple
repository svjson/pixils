(def tile-types platform-level-tile-types)

(def tilesets
  [{:id :colors
    :label "Background Colors"}
   {:id :platform-level
    :label "Platform Level"}
   {:id :platform-actors
    :label "Platform Actors"}
   {:id :platform-foreground
    :label "Platform Foreground"}])

(def tileset-options
  (for-indexed [index tileset tilesets]
    {:value index
     :label (:label tileset)}))

(def tilemap-layers
  [{:id :scene/background
    :label "Background"
    :kind :tile
    :tileset :colors
    :order 0}
   {:id :scene/level
    :label "Level"
    :kind :tile
    :tileset :platform-level
    :order 10}
   {:id :scene/actor
    :label "Actor"
    :kind :tile
    :tileset :platform-actors
    :order 20}
   {:id :scene/foreground
    :label "Foreground"
    :kind :tile
    :tileset :platform-foreground
    :order 30}])

(def layer-options
  (for-indexed [index layer tilemap-layers]
    {:value index
     :label (:label layer)}))

(defun tileset-key [index]
  (:id (nth tilesets (or index 0))))

(defun tileset-index [tileset]
  (let [match (find-index tilesets (fn [item]
                                     (= (:id item) tileset)))]
    (or match 0)))

(defun tileset-label [tileset]
  (:label (nth tilesets (tileset-index tileset))))

(defun layer-key [index]
  (:id (nth tilemap-layers (or index 0))))

(defun layer-label [index]
  (:label (nth tilemap-layers (or index 0))))

(defun tile-types-for [tileset]
  (case tileset
    :colors color-tile-types
    :platform-level platform-level-tile-types
    :platform-actors platform-actor-tile-types
    :platform-foreground platform-foreground-tile-types
    :default platform-level-tile-types))

(defun tile-count-for [tileset]
  (count (tile-types-for tileset)))

(defun clamp-tile-index [tileset index]
  (let [count (tile-count-for tileset)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun tile-options-for [tileset]
  (for-indexed [index tile (tile-types-for tileset)]
    {:value index
     :label (:name tile)}))

(defun tile-in [tileset index]
  (let [types (tile-types-for tileset)]
    (nth types (mod (or index 0) (count types)))))

(defun tile [index]
  (tile-in :platform-level index))

(defun tile-color [index]
  (:color (tile index)))

(defun tile-name [index]
  (:name (tile index)))

(defun tile-name-in [tileset index]
  (:name (tile-in tileset index)))

(defun tile-label-in [tileset index]
  (let [tile (tile-in tileset index)]
    (str "Selected: " (:name tile) " (" (:type tile) ")")))

(defun tile-label [index]
  (tile-label-in :platform-level index))

(defun between? [value low high]
  (and (>= value low)
       (<= value high)))

(defun background-tile-at [x y]
  (cond
    (< y 8) 0
    (< y 16) 1
    (< y 24) 3
    :default 2))

(defun level-tile-at [x y]
  (cond
    (and (= x 13) (between? y 18 24))
    4

    (and (between? x 10 16) (between? y 26 27))
    5

    (and (or (= x 9) (= x 17)) (between? y 24 27))
    3

    (and (between? x 0 8) (= y 24))
    8

    (and (between? x 0 8) (between? y 25 27))
    6

    (and (between? x 2 6) (= y 21))
    3

    (and (between? x 5 14) (= y 18))
    1

    (and (between? x 5 14) (between? y 19 23))
    0

    (and (between? x 16 20) (= y 16))
    1

    (and (between? x 16 20) (between? y 17 20))
    2

    (and (= x 22) (between? y 17 21))
    11

    (and (between? x 18 27) (= y 22))
    3

    (and (or (= x 18) (= x 27)) (between? y 23 26))
    3

    (and (= x 25) (between? y 23 26))
    3

    (and (between? x 23 35) (= y 10))
    1

    (and (between? x 23 35) (between? y 11 14))
    0

    (and (between? x 26 32) (between? y 15 16))
    2

    (and (between? x 29 30) (= y 17))
    2

    (and (between? x 34 39) (= y 18))
    1

    (and (between? x 34 39) (between? y 19 27))
    0

    (and (between? x 28 30) (= y 25))
    10

    (= y 27)
    6

    :default
    nil))

(defun actor-tile-at [x y]
  (cond
    (and (= x 19) (= y 21)) 0
    (and (= x 25) (= y 8)) 1
    (and (= x 33) (= y 15)) 2
    (and (= x 28) (= y 9)) 3
    (and (= x 6) (= y 20)) 4
    (and (= x 24) (= y 21)) 5
    (and (= x 4) (= y 20)) 6
    (and (= x 11) (= y 17)) 7
    (and (= x 3) (= y 23)) 8
    (and (= x 30) (= y 24)) 9
    (and (= x 30) (= y 9)) 10
    (and (= x 29) (= y 24)) 11
    :default nil))

(defun foreground-tile-at [x y]
  (cond
    (and (= x 34) (= y 8)) 0
    (and (= x 34) (= y 9)) 1
    (and (between? x 36 37) (= y 16)) 2
    (and (= x 30) (between? y 11 13)) 3
    (and (= x 30) (= y 14)) 4
    (and (= x 12) (= y 17)) 5
    (and (= x 19) (= y 15)) 6
    (and (= x 24) (= y 9)) 7
    (and (= x 8) (= y 17)) 8
    (and (= x 5) (= y 20)) 9
    (and (= x 1) (between? y 20 23)) 10
    (and (= x 26) (between? y 23 26)) 11
    :default nil))

(defun make-background-map []
  (dotimes [y map-height]
    (dotimes [x map-width]
      (background-tile-at x y))))

(defun make-level-map []
  (dotimes [y map-height]
    (dotimes [x map-width]
      (level-tile-at x y))))

(defun make-actor-map []
  (dotimes [y map-height]
    (dotimes [x map-width]
      (actor-tile-at x y))))

(defun make-foreground-map []
  (dotimes [y map-height]
    (dotimes [x map-width]
      (foreground-tile-at x y))))

(defun make-empty-row []
  (dotimes [x map-width]
    nil))

(defun make-empty-map []
  (dotimes [y map-height]
    (make-empty-row)))

(defun make-map-for-layer [layer]
  (case (:id layer)
    :scene/background (make-background-map)
    :scene/level (make-level-map)
    :scene/actor (make-actor-map)
    :scene/foreground (make-foreground-map)
    :default (make-empty-map)))

(defun make-layer [definition tiles]
  (assoc definition :tiles tiles))

(defun make-layered-map []
  (for-indexed [index layer tilemap-layers]
    (make-layer layer (make-map-for-layer layer))))
