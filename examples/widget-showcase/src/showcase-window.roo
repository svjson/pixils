(ns widget-showcase.showcase-window
  (:require [pixils.ui :as ui]
            [pixils.ui.scroll-pane :as scroll-pane]
            [pixils.ui.tab-panel :as tabs]
            [pixils.ui.window :as window]
            [widget-showcase.pages.dialogs :as dialogs-page]
            [widget-showcase.pages.icons :as icons-page]
            [widget-showcase.pages.inputs :as inputs-page]
            [widget-showcase.pages.layout :as layout-page]
            [widget-showcase.pages.lists :as lists-page]
            [widget-showcase.state :as showcase-state]))

(def showcase-window-style
  {:width 740
   :height 488})

(defun showcase-tabs []
  (let [tabs-view (tabs/make
                   {:selected-tab (ui/bind-state :selected-tab)
                    :state (showcase-window-state)
                    :style {:width :fill
                            :height :shrink}
                    :tabs [{:id :inputs
                            :label "Inputs"
                            :body (inputs-page/make)}
                           {:id :lists
                            :label "Lists"
                            :body (lists-page/make)}
                           {:id :layout
                            :label "Layout"
                            :body (layout-page/make)}
                           {:id :dialogs
                            :label "Menus & Dialogs"
                            :body (dialogs-page/make)}
                           {:id :icons
                            :label "Icons & Windows"
                            :body (icons-page/make)}]})]
    (assoc tabs-view
           :state (assoc (:state tabs-view)
                         :body-state (ui/bind-state)))))

(defun showcase-window-state []
  (showcase-state/bindings))

(defun showcase-scroll-body []
  (scroll-pane/make
   {:style {:width :fill
            :height :fill}
    :scroll-x? false
    :state {:content-state (ui/bind-state)}
    :step 24
    :children [{:id "showcase-scroll-surface"
                :style {:width :fill
                        :height :shrink}
                :state (showcase-state/bindings)
                :children [(showcase-tabs)]}]}))

(defun make []
  (window/make
   {:title-bar {:title "Pixils Widget Showcase"}
    :style showcase-window-style
    :body-style {:width :fill
                 :height :fill}
    :state (showcase-window-state)
    :body [(showcase-scroll-body)]}))
