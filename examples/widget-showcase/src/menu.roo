(ns widget-showcase.menu
  (:require [pixils.ui.menu :as menu]))

(def showcase-keymap
  {:key/f1 :showcase/about
   :key/f2 :showcase/open-confirm
   :key/f3 :showcase/open-file-dialog
   :key/f4 :showcase/quit
   :key/f5 :showcase/reset})

(defun theme-item [label theme theme-label variant]
  (merge {:label label
          :action :showcase/theme
          :payload {:theme theme
                    :label theme-label}}
         (if variant
           {:payload {:theme theme
                      :variant variant
                      :label theme-label}}
           {})))

(defun theme-variant-menu [label theme light-label dark-label]
  {:label label
   :items [(theme-item "&Light" theme light-label :light)
           (theme-item "&Dark" theme dark-label :dark)]})

(def showcase-menu
  {:settings {:mnemonics {:marker "&"}
              :shortcuts {:render true}}
   :items [{:label "&Showcase"
            :items [{:label "&About"
                     :action :showcase/about
                     :shortcut :key/f1}
                    {:label "&Reset State"
                     :action :showcase/reset
                     :shortcut :key/f5}
                    {:label "&Quit"
                     :action :showcase/quit
                     :shortcut :key/f4}]}
           {:label "&Dialogs"
            :items [{:label "&Confirm Dialog"
                     :action :showcase/open-confirm
                     :shortcut :key/f2}
                    {:label "&File Dialog"
                     :action :showcase/open-file-dialog
                     :shortcut :key/f3}]}
           {:label "&Theme"
            :items [(theme-item "Pixils &Default"
                                nil
                                "Pixils Default"
                                nil)
                    (theme-variant-menu "Windows &3"
                                        'pixils/windows-3
                                        "Windows 3 Light"
                                        "Windows 3 Dark")
                    (theme-variant-menu "Windows &95"
                                        'pixils/windows-95
                                        "Windows 95 Light"
                                        "Windows 95 Dark")
                    (theme-item "&Classic Blue"
                                'pixils/classic-blue
                                "Classic Blue"
                                nil)]}]})

(defun make-menu []
  (menu/make-menu {:style {:height 20}}
                  showcase-menu
                  showcase-keymap))
