(ns widget-showcase.pages.inputs
  (:require [pixils.ui :as ui]
            [pixils.ui.button :as button]
            [pixils.ui.checkbox :as checkbox]
            [pixils.ui.combo-box :as combo-box]
            [pixils.ui.color-picker :as color-picker]
            [pixils.ui.number-input :as number-input]
            [pixils.ui.option-box :as option-box]
            [pixils.ui.progress-bar :as progress-bar]
            [pixils.ui.slider :as slider]
            [pixils.ui.toggle-button :as toggle-button]
            [widget-showcase.state :as showcase-state]
            [widget-showcase.style :as style]))

(defun make []
  {:style style/page-style
   :state (showcase-state/bindings)
   :children [(style/state-section
               "Buttons"
               [{:style style/button-row-style
                 :state (showcase-state/bindings)
                 :children [(button/make {:label "Normal"
                                           :value :normal})
                            (button/make {:label "Disabled"
                                          :disabled? true})
                            (toggle-button/make-group
                             {:selected (ui/bind-state :toggle-value)
                              :selection-required? true
                              :button-row-style style/button-row-style
                              :buttons [{:label "Left"
                                         :value :left}
                                        {:label "Center"
                                         :value :center}
                                        {:label "Right"
                                         :value :right}]})]}])
              (style/state-section
               "Choices"
               [(checkbox/make {:label "Checkbox"
                                :checked? (ui/bind-state :checked?)
                                :value :checked})
                (option-box/make-group
                 {:selected (ui/bind-state :option-value)
                  :options [{:label "First option"
                             :value :one}
                            {:label "Second option"
                             :value :two}
                            {:label "Disabled option"
                             :value :three
                             :disabled? true}]})
                (style/field-row
                 "Combo boxes"
                 {:style {:height :shrink
                          :layout {:direction :row
                                   :align-items :center
                                   :gap 8}}
                  :children [(combo-box/make {:style {:width 180}
                                              :selected-index (ui/bind-state :combo-index)
                                              :options showcase-state/sample-options})
                             (combo-box/make {:style {:width 180}
                                              :selected-index (ui/bind-state :scroll-combo-index)
                                              :options showcase-state/scrollable-options})]})])
              (style/state-section
               "Text And Numeric Input"
               [(style/field-row
                 "Text"
                 {:mode 'ui/text-input
                  :style {:width 260
                          :height 24}
                  :state {:value (ui/bind-state :text-value)}})
                (style/field-row
                 "Read only"
                 {:mode 'ui/text-input
                  :style {:width 260
                          :height 24}
                  :state {:value (ui/bind-state :read-only-value)
                          :read-only? true}})
                (style/field-row
                 "Number"
                 (number-input/make {:style {:width 90
                                             :height 24}
                                     :value (ui/bind-state :number-value)
                                     :min -20
                                     :max 120
                                     :step 5}))])
              (style/state-section
               "Sliders"
               [(style/field-row
                 "Horizontal"
                 (slider/make {:style {:width 240
                                       :height 18}
                               :value (ui/bind-state :slider-value)
                               :min 0
                               :max 100
                               :limit-min (ui/bind-state :slider-limit-min)
                               :limit-max (ui/bind-state :slider-limit-max)
                               :limits-enabled? (ui/bind-state :slider-limits-enabled?)
                               :step 5}))
                (checkbox/make {:label "Show visual limits"
                                :checked? (ui/bind-state :slider-limits-enabled?)
                                :value :slider-limits-enabled?})
                {:style style/row-style
                 :state (showcase-state/bindings)
                 :children [{:mode 'ui/text
                             :style style/field-label-style
                             :state {:value "Limit min"}}
                            (slider/make {:style {:width 180
                                                  :height 18}
                                          :value (ui/bind-state :slider-limit-min)
                                          :min 0
                                          :max 100
                                          :limit-max (ui/bind-state :slider-limit-max)
                                          :step 5})
                            {:mode 'ui/text
                             :state {:value (ui/bind-state :slider-limit-min)}}]}
                {:style style/row-style
                 :state (showcase-state/bindings)
                 :children [{:mode 'ui/text
                             :style style/field-label-style
                             :state {:value "Limit max"}}
                            (slider/make {:style {:width 180
                                                  :height 18}
                                          :value (ui/bind-state :slider-limit-max)
                                          :min 0
                                          :max 100
                                          :limit-min (ui/bind-state :slider-limit-min)
                                          :step 5})
                            {:mode 'ui/text
                             :state {:value (ui/bind-state :slider-limit-max)}}]}
                {:style style/row-style
                 :state (showcase-state/bindings)
                 :children [{:mode 'ui/text
                             :style style/field-label-style
                             :state {:value "Vertical"}}
                            (slider/make {:style {:width 22
                                                  :height 90}
                                          :axis :y
                                          :value (ui/bind-state :vertical-slider-value)
                                          :min 0
                                          :max 100
                                          :limit-min (ui/bind-state :slider-limit-min)
                                          :limit-max (ui/bind-state :slider-limit-max)
                                          :limits-enabled? (ui/bind-state :slider-limits-enabled?)
                                          :step 10})
                            {:mode 'ui/text
                             :state {:value (ui/bind-state :vertical-slider-value)}}]}])
              (style/state-section
               "Progress"
               [(style/field-row
                 "Bound value"
                 (progress-bar/make {:style {:width 240
                                             :height 18}
                                     :value (ui/bind-state :slider-value)
                                     :min 0
                                     :max 100}))
                {:style style/row-style
                 :state (showcase-state/bindings)
                 :children [{:mode 'ui/text
                             :style style/field-label-style
                             :state {:value "Vertical"}}
                            (progress-bar/make {:style {:width 22
                                                        :height 90}
                                                :axis :y
                                                :value (ui/bind-state :vertical-slider-value)
                                                :min 0
                                                :max 100})
                            {:mode 'ui/text
                             :state {:value (ui/bind-state :vertical-slider-value)}}]}])
              (style/state-section
               "Color"
               [(style/field-row
                 "RGBA"
                 {:style style/row-style
                  :state (showcase-state/bindings)
                  :children [(color-picker/make
                              {:value (ui/bind-state :accent-color)})]})])]})
