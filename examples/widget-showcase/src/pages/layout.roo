(ns widget-showcase.pages.layout
  (:require [pixils.ui :as ui]
            [pixils.ui.collapsible :as collapsible]
            [pixils.ui.header-panel :as header-panel]
            [pixils.ui.popover :as popover]
            [pixils.ui.rich-text :as rich-text]
            [pixils.ui.split-pane :as split-pane]
            [widget-showcase.state :as showcase-state]
            [widget-showcase.style :as style]))

(defun make []
  {:style style/page-style
   :state (showcase-state/bindings)
   :children [(header-panel/make
               {:title "Header Panel"
                :style {:width :fill
                        :height :shrink}
                :body-style {:padding 8
                             :layout {:direction :column
                                      :gap 4}}
                :children [(style/label "Header panels provide a title band and body area.")
                           (style/label "They are useful for app settings and inspectors.")]})
              (style/state-section
               "Rich Text"
               [(rich-text/make
                 {:style {:width :fill
                          :height 56
                          :padding 6
                          :background style/content-bg
                          :text {:marked-style {:color {:r 0x1c
                                                        :g 0x52
                                                        :b 0x9b
                                                        :a 0xff}
                                                :font-styles :underline}}}
                  :state (showcase-state/bindings)
                  :runs [{:text "Marked metadata"
                          :marked? true
                          :value {:subject :showcase/rich-text
                                  :kind :value
                                  :title "Marked Metadata"
                                  :body "This highlighted run carries structured metadata. The popover contents come from that payload."}}
                         " can sit "
                         {:text "inline"
                          :class :rich-text/emphasis
                          :style {:text {:font-styles :bold}}}
                         " with plain wrapped text, "
                         {:text "identifier spans"
                          :marked? true
                          :id :showcase/identifier-span}
                         ", and "
                         {:text "external references"
                          :marked? true
                          :href "https://pixils.local/rich-text"}
                         ". Hover an interactive run to update the status bar, or click one to receive its payload."]})
                {:style {:width :fill
                         :height :shrink
                         :layout {:direction :row
                                  :gap 6}}
                 :state (showcase-state/bindings)
                 :children [{:mode 'ui/text
                            :style {:width 72}
                            :state {:value "Events:"}}
                           {:mode 'ui/text
                             :style {:width :fill}
                             :state {:value (ui/bind-state :rich-text-event)}}]}])
              (style/section
               "Split Pane"
               [(split-pane/make
                 {:style {:width :fill
                          :height 210}
                  :split 0.44
                  :children [{:style {:width :fill
                                      :height :fill
                                      :padding 8
                                      :background style/content-bg}
                              :children [(style/label "Primary pane")
                                         (style/label "Drag the resizer.")]}
                             {:style {:width :fill
                                      :height :fill
                                      :padding 8
                                      :background style/panel-bg}
                              :children [(style/label "Secondary pane")
                                         (style/label "This side fills remaining space.")]}]})])
              (collapsible/make
               {:title "Disclosure Section"
                :value :layout-disclosure
                :expanded? (ui/bind-state :layout-collapsible-expanded?)
                :style {:width :fill
                        :height :shrink}
                :content-style {:layout {:direction :column
                                         :gap 4}}
                :state (showcase-state/bindings)
                :content-state (showcase-state/bindings)
                :children [(style/label "This body is part of the normal layout while expanded.")
                           (style/label "Click the header to collapse it without changing tabs.")]})
              (style/section
               "Nested Layout"
               [{:style {:width :fill
                         :height 72
                         :layout {:direction :row
                                  :gap 8}}
                 :children [{:style {:width :fill
                                     :height :fill
                                     :background style/content-bg
                                     :padding 6}
                             :children [(style/label "Fill")]}
                            {:style {:width 140
                                     :height :fill
                                     :background style/quiet-bg
                                     :padding 6}
                             :children [(style/label "Fixed width")]}]}])
              (style/section
               "Popover"
               [(popover/make-trigger
                 {:label "Toggle popover"
                  :popover-style {:width 260}
                  :children [{:mode 'ui/text
                              :style {:width :fill}
                              :state {:value "Local popover content can contain ordinary Pixils views."}}
                             {:mode 'ui/text
                              :style {:width :fill}
                              :state {:value "Use popover/open! when it must escape clipping."}}]})])]})
