(ns widget-showcase.fixture
  (:require [pixils.test :as px]
            widget-showcase.root))

(defun start!
  "Starts and settles the widget showcase with the supplied runtime options."
  [opts]
  (let [app (px/make-app (merge {:package-root "."
                                      :buffer-width 800
                                      :buffer-height 600
                                      :render-backend false}
                                     opts))]
    (if-let [theme (:theme opts)]
      (px/push-mode-with-overrides! app
                                         'main-mode
                                         nil
                                         {:theme theme})
      (px/push-mode! app 'main-mode))
    (px/settle-layout! app)
    app))

(defun open-tab!
  "Selects `tab-id`, settles the resulting layout, and returns `app`."
  [app tab-id]
  (px/click! app
                  (px/find-view-containing app
                                                "ui/tab"
                                                (str ":tab-id " tab-id)))
  (px/settle-layout! app)
  app)
