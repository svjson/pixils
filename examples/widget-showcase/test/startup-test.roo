(ns widget-showcase.startup-test
  (:require proof.core
            [pixils.test.runtime :as runtime]
            [widget-showcase.menu :as showcase-menu]))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun view-center-x [view]
  (int (/ (:w (:bounds view)) 2)))

(defun view-center-y [view]
  (int (/ (:h (:bounds view)) 2)))

(defun view-lower-y [view]
  (max 0 (- (:h (:bounds view)) 3)))

(defun view-upper-y [view]
  2)

(defun view-bottom [view]
  (+ (-> view :bounds :y)
     (-> view :bounds :h)))

(defun view-render-pixel-at [app view x y]
  (let [bounds (:bounds view)]
    (runtime/rendered-pixel app
                            (+ (:x bounds) x)
                            (+ (:y bounds) y))))

(defun visible-view-pixel [app view]
  (let [bounds (:bounds view)
        background (runtime/rendered-pixel app 1 1)
        left (min 4 (max 0 (- (:w bounds) 2)))
        right (max 0 (- (:w bounds) 4))
        top (min 4 (max 0 (- (:h bounds) 2)))
        middle-x (int (/ (:w bounds) 2))
        middle-y (int (/ (:h bounds) 2))
        pixels [(view-render-pixel-at app view left top)
                (view-render-pixel-at app view right top)
                (view-render-pixel-at app view middle-x top)
                (view-render-pixel-at app view middle-x middle-y)]]
    (head (filter pixels
                  (fn [pixel]
                    (and (not (nil? pixel))
                         (not (= background pixel))))))))

(defun assert-view-rendered! [app view]
  (if (not (nil? (runtime/rendered-pixel app 1 1)))
    (is (not (nil? (visible-view-pixel app view))))
    true))

(defun style-position [view]
  {:position (:position (:style view))
   :left (:left (:style view))
   :top (:top (:style view))
   :effective-position (:position (:effective-style view))
   :effective-left (:left (:effective-style view))
   :effective-top (:top (:effective-style view))})

(defun vertical-containment [outer inner]
  {:contained? (and (>= (-> inner :bounds :y)
                        (-> outer :bounds :y))
                    (<= (view-bottom inner)
                        (view-bottom outer)))
   :outer (:bounds outer)
   :inner (:bounds inner)})

(defun assert-contained-y! [outer inner]
  (is (= {:contained? true
          :outer (:bounds outer)
          :inner (:bounds inner)}
         (vertical-containment outer inner))))

(defun window-chrome-snapshot [app]
  (let [window (runtime/find-view app "ui/window")
        title-bar (runtime/find-view app "ui/window-title-bar")
        body (runtime/find-view app "ui/window-body")
        control (runtime/find-view app "ui/window-control-button")
        minimize (runtime/find-view app "ui/window-minimize-button")
        title-text (runtime/find-view-containing app
                                                 "ui/text"
                                                 "Pixils Widget Showcase")]
    {:window-bounds (:bounds window)
     :window-style-position (style-position window)
     :title-bar-bounds (:bounds title-bar)
     :body-bounds (:bounds body)
     :control-bounds (:bounds control)
     :minimize-bounds (:bounds minimize)
     :title-text-bounds (:bounds title-text)}))

(defun assert-window-chrome-contained! [app]
  (let [title-bar (runtime/find-view app "ui/window-title-bar")
        control (runtime/find-view app "ui/window-control-button")
        minimize (runtime/find-view app "ui/window-minimize-button")
        title-text (runtime/find-view-containing app
                                                 "ui/text"
                                                 "Pixils Widget Showcase")]
    (assert-contained-y! title-bar control)
    (assert-contained-y! title-bar minimize)
    (assert-contained-y! title-bar title-text)))

(defun slider-with-state [app predicate]
  (head (filter (runtime/find-views app "ui/slider")
                (fn [slider]
                  (predicate (runtime/view-state slider))))))

(deftest widget-showcase-theme-menu-nests_multi_variant_themes
  (let [theme-menu (nth (:items showcase-menu/showcase-menu) 2)]
    (is (= "&Theme" (:label theme-menu)))
    (is (= "Pixils &Default" (get-in theme-menu [:items 0 :label])))
    (is (= :showcase/theme (get-in theme-menu [:items 0 :action])))
    (is (nil? (get-in theme-menu [:items 0 :payload :theme])))
    (is (nil? (get-in theme-menu [:items 0 :payload :variant])))
    (is (= "Pixils Default" (get-in theme-menu [:items 0 :payload :label])))
    (is (= "Windows &3" (get-in theme-menu [:items 1 :label])))
    (is (nil? (get-in theme-menu [:items 1 :action])))
    (is (= "&Light" (get-in theme-menu [:items 1 :items 0 :label])))
    (is (= :light (get-in theme-menu [:items 1 :items 0 :payload :variant])))
    (is (= 'pixils/windows-3
           (get-in theme-menu [:items 1 :items 0 :payload :theme])))
    (is (= "&Dark" (get-in theme-menu [:items 1 :items 1 :label])))
    (is (= :dark (get-in theme-menu [:items 1 :items 1 :payload :variant])))
    (is (= 'pixils/windows-3
           (get-in theme-menu [:items 1 :items 1 :payload :theme])))
    (is (= "Windows &95" (get-in theme-menu [:items 2 :label])))
    (is (nil? (get-in theme-menu [:items 2 :action])))
    (is (= "&Classic Blue" (get-in theme-menu [:items 3 :label])))
    (is (= :showcase/theme (get-in theme-menu [:items 3 :action])))
    (is (nil? (get-in theme-menu [:items 3 :payload :variant])))))

(deftest widget-showcase-loads-and-renders-main-window
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (is (not (nil? (runtime/find-view app "ui/window"))))
    (is (not (nil? (runtime/find-view app "ui/tab-panel"))))
    (is (not (nil? (runtime/find-view app "ui/scroll-pane"))))
    (is (not (nil? (runtime/find-view app "ui/button"))))
    (is (not (nil? (runtime/find-view app "ui/text-input"))))
    (let [progress (runtime/find-view app "ui/progress-bar")]
      (is (not (nil? progress)))
      (is (= 42 (:value (runtime/view-state progress)))))))

(deftest widget-showcase-window-body-scrolls-inside-fixed-window
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          body (runtime/find-view app "ui/window-body")
          scroll-pane (runtime/find-view app "ui/scroll-pane")
          viewport (runtime/find-view app "ui/scroll-pane-viewport")
          tab-panel (runtime/find-view app "ui/tab-panel")]
      (is (= 740 (:w (:bounds window))))
      (is (= 488 (:h (:bounds window))))
      (is (= true (< (:h (:bounds body))
                     (:h (:bounds window)))))
      (is (= (:h (:bounds body))
             (:h (:bounds scroll-pane))))
      (is (= true (< (:h (:bounds viewport))
                     (:h (:bounds tab-panel))))))))

(deftest layout-tab-collapsible-toggles_disclosure_section
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [layout-tab (runtime/find-view-containing app
                                                   "ui/tab"
                                                   ":tab-id :layout")]
      (runtime/click! app layout-tab)
      (settle-layout! app)
      (let [collapsible (runtime/find-view app "ui/collapsible")
            content (runtime/find-view app "ui/collapsible-content")
            header (runtime/find-view app "ui/collapsible-header")]
        (is (not (nil? collapsible)))
        (is (= true (:layout-collapsible-expanded? (runtime/active-state app))))
        (is (= true (> (:h (:bounds content)) 0)))
        (runtime/click! app header)
        (settle-layout! app)
        (let [content-after (runtime/find-view app "ui/collapsible-content")]
          (is (= false
                 (:layout-collapsible-expanded? (runtime/active-state app))))
          (is (= 0 (:h (:bounds content-after)))))))))

(deftest layout-tab-renders-rich-text-section
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (runtime/click! app (runtime/find-view-containing app "ui/tab" ":tab-id :layout"))
    (settle-layout! app)
    (let [rich-text (runtime/find-view app "ui/rich-text")]
      (is (not (nil? rich-text)))
      (is (= 56 (:h (:bounds rich-text))))
      (is (= 6 (count (:runs (runtime/view-state rich-text))))))))

(deftest layout-tab-rich-text-events-update-status
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend true})]
    (runtime/eval! app "(pixils/set-theme! 'pixils/windows-3)")
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (runtime/click! app (runtime/find-view-containing app "ui/tab" ":tab-id :layout"))
    (settle-layout! app)
    (let [rich-text (runtime/find-view app "ui/rich-text")]
      (runtime/mouse-move-in! app rich-text 8 8)
      (runtime/update! app)
      (runtime/update! app)
      (is (= "Hover rich text: Marked metadata"
             (:message (runtime/active-state app))))
      (is (= "Hover rich text: Marked metadata"
             (:rich-text-event (runtime/active-state app))))
      (is (not (nil? (runtime/find-view-containing
                      app
                      "ui/text"
                      "Hover rich text: Marked metadata"))))
      (runtime/mouse-click-in! app rich-text 8 8)
      (runtime/update! app)
      (is (= "Clicked rich text: Marked metadata"
             (:message (runtime/active-state app))))
      (is (not (nil? (runtime/find-view-containing
                      app
                      "ui/text"
                      "Clicked rich text: Marked metadata"))))
      (runtime/mouse-move-in! app rich-text 4 (- (:h (:bounds rich-text)) 4))
      (runtime/update! app)
      (runtime/update! app)
      (is (= "Rich text hover cleared."
             (:message (runtime/active-state app))))
      (is (not (nil? (runtime/find-view-containing app "ui/text" "leave")))))))

(deftest widget-showcase-title-bar-stays-anchored-on-first-hover
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend true})]
    (runtime/push-mode-with-overrides! app
                                       'main-mode
                                       nil
                                       {:theme 'pixils/windows-3})
    (runtime/frame! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")
          window-bounds (:bounds window)
          title-bounds (:bounds title-bar)
          initial-chrome (window-chrome-snapshot app)]
      (is (= true (> (:h title-bounds) 0)))
      (is (= true (> (:w title-bounds) 0)))
      (is (= true (> (:x title-bounds) (:x window-bounds))))
      (is (= true (> (:y title-bounds) (:y window-bounds))))
      (assert-window-chrome-contained! app)
      (assert-view-rendered! app title-bar)
      (runtime/mouse-move-in! app title-bar 10 10)
      (runtime/frame! app)
      (let [window-after (runtime/find-view app "ui/window")
            title-after (runtime/find-view app "ui/window-title-bar")
            chrome-after (window-chrome-snapshot app)]
        (is (= window-bounds (:bounds window-after)))
        (is (= title-bounds (:bounds title-after)))
        (is (= initial-chrome chrome-after))
        (assert-window-chrome-contained! app)
        (assert-view-rendered! app title-after))
      (runtime/frame! app)
      (let [window-after-second-frame (runtime/find-view app "ui/window")
            title-after-second-frame (runtime/find-view app "ui/window-title-bar")
            chrome-after-second-frame (window-chrome-snapshot app)]
        (is (= window-bounds (:bounds window-after-second-frame)))
        (is (= title-bounds (:bounds title-after-second-frame)))
        (is (= initial-chrome chrome-after-second-frame))
        (assert-window-chrome-contained! app)
        (assert-view-rendered! app title-after-second-frame))
      (runtime/frame! app)
      (let [window-after-third-frame (runtime/find-view app "ui/window")
            title-after-third-frame (runtime/find-view app "ui/window-title-bar")
            chrome-after-third-frame (window-chrome-snapshot app)]
        (is (= window-bounds (:bounds window-after-third-frame)))
        (is (= title-bounds (:bounds title-after-third-frame)))
        (is (= initial-chrome chrome-after-third-frame))
        (assert-window-chrome-contained! app)
        (assert-view-rendered! app title-after-third-frame)))))

(deftest widget-showcase-title-bar-drag-starts-from-current-window-position
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode-with-overrides! app
                                       'main-mode
                                       nil
                                       {:theme 'pixils/windows-3})
    (runtime/frame! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")
          start-bounds (:bounds window)
          press-x 120
          press-y 9
          drag-dx 24
          drag-dy 14]
      (runtime/mouse-down-in! app title-bar press-x press-y)
      (runtime/frame! app)
      (let [after-down (runtime/find-view app "ui/window")]
        (is (= start-bounds (:bounds after-down))))
      (let [title-bar-after-down (runtime/find-view app "ui/window-title-bar")
            move-global {:x (+ (:x (:bounds title-bar-after-down)) press-x drag-dx)
                         :y (+ (:y (:bounds title-bar-after-down)) press-y drag-dy)}]
        (runtime/mouse-move-at! app (:x move-global) (:y move-global)))
      (runtime/frame! app)
      (let [after-first-drag (runtime/find-view app "ui/window")
            expected-bounds (assoc start-bounds
                                   :x (+ (:x start-bounds) drag-dx)
                                   :y (+ (:y start-bounds) drag-dy))]
        (is (= expected-bounds (:bounds after-first-drag)))))))

(deftest inputs-tab-choices-group-expands_to_contain_combo_box
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [bodies (runtime/find-views app "ui/group-box-body")
          choices-body (nth bodies 1)
          combo (runtime/find-view app "ui/combo-box")]
      (is (= true
             (<= (view-bottom combo)
                 (view-bottom choices-body)))))))

(deftest inputs-tab-slider-drag-does_not_rebuild_tab_body
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [tab-panel (runtime/find-view app "ui/tab-panel")
          before-body-state (:rendered-body-state
                             (runtime/view-state tab-panel))
          slider (runtime/find-view app "ui/slider")]
      (runtime/mouse-down-in! app slider 102 (view-center-y slider))
      (runtime/update! app)
      (runtime/mouse-move-in! app slider 140 (view-center-y slider))
      (runtime/update! app)
      (runtime/mouse-move-in! app
                              slider
                              (- (:w (:bounds slider)) 2)
                              (view-center-y slider))
      (runtime/update! app)
      (runtime/mouse-up-in! app
                            slider
                            (- (:w (:bounds slider)) 2)
                            (view-center-y slider))
      (runtime/update! app)
      (settle-layout! app)
      (let [after-tab-panel (runtime/find-view app "ui/tab-panel")
            after-body-state (:rendered-body-state
                              (runtime/view-state after-tab-panel))]
        (is (= before-body-state after-body-state))
        (is (= 85
               (:slider-value (runtime/active-state app))))))))

(deftest inputs-tab-slider-limit_controls_do_not_cross
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [min-limit-slider (slider-with-state app
                                              (fn [state]
                                                (= 20 (:value state))))]
      (runtime/mouse-click-in! app
                              min-limit-slider
                              (- (:w (:bounds min-limit-slider)) 2)
                              (view-center-y min-limit-slider))
      (is (= 85
             (:slider-limit-min (runtime/active-state app))))
      (settle-layout! app)
      (let [max-limit-slider (slider-with-state
                              app
                              (fn [state]
                                (and (= 85 (:value state))
                                     (not (nil? (:limit-min state))))))]
        (runtime/mouse-click-in! app
                                max-limit-slider
                                2
                                (view-center-y max-limit-slider))
        (is (= 85
               (:slider-limit-max (runtime/active-state app))))))))

(deftest inputs-tab-button-hover-uses-full-visual-height
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)
    (let [button (runtime/find-view-containing app
                                               "ui/button"
                                               ":label \"Normal\"")
          bounds (:bounds button)]
      (runtime/mouse-move-in! app
                              button
                              (int (/ (:w bounds) 2))
                              (int (/ (:h bounds) 2)))
      (runtime/update! app)
      (let [button-after (runtime/find-view-containing app
                                                       "ui/button"
                                                       ":label \"Normal\"")]
        (is (= true
               (-> button-after :interaction :hovered)))))))

(deftest inputs-tab-combo-box-lower-edge-click-works-near-group-box-bottom
