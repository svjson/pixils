(ns form-playground.form-playground-test
  (:require proof.core
            form-playground.core
            [pixils.test.runtime :as runtime]))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun press-key! [app key]
  (runtime/key-down! app key)
  (runtime/update! app)
  (runtime/key-up! app key)
  (runtime/update! app)
  app)

(defun type-keys! [app keys]
  (reduce keys app
          (fn [app key]
            (press-key! app key))))

(defun switch-tab! [app tab-id]
  (let [tab (runtime/find-view-containing app "ui/tab" (str ":tab-id " tab-id))]
    (is (not (nil? tab)))
    (runtime/click! app tab)
    (settle-layout! app)))

(defun input-with-value [app value]
  (head (filter (runtime/find-views app "ui/text-input")
                (fn [view]
                  (= value (:value (runtime/view-state view)))))))

(defun text-input-inner-with-value [app value]
  (head (filter (runtime/find-views app "ui/text-input-inner")
                (fn [view]
                  (= value (:value (runtime/view-state view)))))))

(defun combo-with-selected-label [app label]
  (head (filter (runtime/find-views app "ui/combo-box")
                (fn [view]
                  (= label (:selected-label (runtime/view-state view)))))))

(defun number-input-with-text [app value]
  (head (filter (runtime/find-views app "ui/number-input")
                (fn [view]
                  (= value (:text-value (runtime/view-state view)))))))

(defun number-input-texts [app]
  (map (runtime/find-views app "ui/number-input")
       (fn [view]
         (:text-value (runtime/view-state view)))))

(defun active-person [app]
  (:selected-person (runtime/active-state app)))

(defun active-person-at [app index]
  (nth (:people (runtime/active-state app)) index))

(defun active-conference [app]
  (:selected-conference (runtime/active-state app)))

(defun active-conference-at [app index]
  (nth (:conferences (runtime/active-state app)) index))

(defun program-entry-at [app index]
  (nth (:program/entries (active-conference app)) index))

(defun make-form-playground-app []
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/push-mode! app 'main-mode)
    (settle-layout! app)))

(def nested-transient-form-source
  "(pixils/defmode nested-transient-root-mode
     {:init
      (fn [state ctx]
        {:generators
         [{:id \"generator\"
           :shape
           {:type :merged-polygons
            :parts
            [{:id \"base\"
              :shape
              {:type :radial-polygon
               :radius
               {:x {:type :random
                    :range {:min nil :max nil}}
                :y {:type :random
                    :range {:min nil :max nil}}}}}]}}]})
      :children
      [(pixils.form/make
        {:schema
         {:definitions
          {:number-range
           {:type :object
            :fields {:min {:type :number}
                     :max {:type :number}}}
           :random-number-base
           {:type :object
            :fields {:type {:type :keyword
                            :valid-values [:fixed :random]}}}
           :fixed-number
           {:extends :random-number-base
            :fields {:value {:type :number}}}
           :random-number
           {:extends :random-number-base
            :fields {:range {:ref :number-range}}}
           :randomizable-number
           {:type :union
            :discriminator :type
            :base {:ref :random-number-base}
            :variants {:fixed {:ref :fixed-number}
                       :random {:ref :random-number}}}
           :radius
           {:type :object
            :fields {:x {:ref :randomizable-number}
                     :y {:ref :randomizable-number}}}
           :part-shape-base
           {:type :object
            :fields {:type {:type :keyword
                            :valid-values [:radial-polygon]}}}
           :part-radial-shape
           {:extends :part-shape-base
            :fields {:radius {:ref :radius}}}
           :part-shape
           {:type :union
            :discriminator :type
            :base {:ref :part-shape-base}
            :variants {:radial-polygon {:ref :part-radial-shape}}}
           :part
           {:type :object
            :fields {:id {:type :text}
                     :shape {:ref :part-shape}}}
           :generator-shape-base
           {:type :object
            :fields {:type {:type :keyword
                            :valid-values [:merged-polygons]}}}
           :merged-shape
           {:extends :generator-shape-base
            :fields {:parts {:type :array
                             :item-label {:path [:id]}
                             :items {:ref :part}}}}
           :generator-shape
           {:type :union
            :discriminator :type
            :base {:ref :generator-shape-base}
            :variants {:merged-polygons {:ref :merged-shape}}}
           :generator
           {:type :object
            :fields {:id {:type :text}
                     :shape {:ref :generator-shape}}}}
          :schema
          {:type :array
           :item-label {:path [:id]}
           :items {:ref :generator}}}
         :value (pixils.ui/bind-state :generators)
         :mode :live
         :field-label-style {:width 112 :height 18}
         :control-style {:width :fill :height 22}})]
      :on {:form/change
           (fn [state event ctx]
             (do
               (pixils.ui/stop-propagation! event)
               (assoc state :generators (-> event :payload :form-value))))}})")

(defun make-nested-transient-form-app []
  (let [app (runtime/make-app {:package-root "."
                               :buffer-width 800
                               :buffer-height 600
                               :render-backend false})]
    (runtime/eval! app nested-transient-form-source)
    (runtime/push-mode! app 'nested-transient-root-mode)
    (settle-layout! app)))

(defun click-button! [app label]
  (let [button (runtime/find-view-containing app "ui/button" label)]
    (is (not (nil? button)))
    (runtime/click! app button)
    (settle-layout! app)))

(defun type-number-input! [app current-value keys]
  (let [input (number-input-with-text app current-value)]
    (is (not (nil? input)))
    (runtime/click! app input)
    (type-keys! app keys)
    (settle-layout! app)))

(deftest nested-array-dialog-preserves-blur-number-drafts
  (let [app (make-nested-transient-form-app)]
    (click-button! app "Edit")
    (is (= "ui/dialog-frame" (runtime/active-mode-name app)))
    (click-button! app "Edit")
    (is (= "ui/dialog-frame" (runtime/active-mode-name app)))
    (is (= ["" "" "" ""] (number-input-texts app)))
    (type-number-input! app "" ["1" "8" "0" "0"])
    (is (= ["1800" "" "" ""] (number-input-texts app)))
    (type-number-input! app "" ["2" "2" "0" "0"])
    (is (= ["1800" "2200" "" ""] (number-input-texts app)))
    (click-button! app "OK")
    (click-button! app "Edit")
    (is (= ["1800" "2200" "" ""] (number-input-texts app)))
    (click-button! app "OK")
    (click-button! app "OK")
    (is (= "nested-transient-root-mode" (runtime/active-mode-name app)))))

(deftest person-register-selects-and-edits-person-through-form
  (let [app (make-form-playground-app)]
    (switch-tab! app :people)
    (is (not (nil? (runtime/find-view-containing
                    app
                    "ui/text"
                    "Pixils Form Playground"))))
    (is (= "Ada"
           (:field/first-name (active-person app))))
    (let [grace-row (runtime/find-view-containing
                     app
                     "ui/list-box-item"
                     "Grace Hopper")]
      (runtime/click! app grace-row)
      (settle-layout! app))
    (is (= 1 (:selected-person-index (runtime/active-state app))))
    (is (= "Grace"
           (:field/first-name (active-person app))))
    (let [first-name-input (input-with-value app "Grace")
          first-name-inner (text-input-inner-with-value app "Grace")]
      (is (not (nil? first-name-input)))
      (is (not (nil? first-name-inner)))
      (runtime/click! app first-name-input)
      (press-key! app :end)
      (type-keys! app [:backspace
                       :backspace
                       :backspace
                       :backspace
                       :backspace
                       :m
                       :a
                       :r
                       :y])
      (settle-layout! app))
    (is (= "Grace"
           (:field/first-name (active-person app))))
    (let [new-person-button (runtime/find-view-containing
                             app
                             "ui/button"
                             "New Person")]
      (is (not (nil? new-person-button)))
      (runtime/mouse-down-in! app new-person-button 2 2)
      (settle-layout! app)
      (runtime/mouse-up-at! app 2 2))
    (settle-layout! app)
    (is (= "mary"
           (:field/first-name (active-person app))))
    (is (= "mary"
           (:field/first-name (active-person-at app 1))))
    (is (not (nil? (runtime/find-view-containing
                    app
                    "ui/list-box-item"
                    "mary Hopper"))))))

(deftest program-planner-creates-union-entry-referencing-person-data
  (let [app (make-form-playground-app)]
    (switch-tab! app :program)
    (is (= :program (:selected-form-tab (runtime/active-state app))))
    (is (= 2 (count (:conferences (runtime/active-state app)))))
    (is (= "Summer Conference"
           (:program/name (active-conference app))))
    (let [autumn-row (runtime/find-view-containing
                      app
                      "ui/list-box-item"
                      "Autumn Workshop")]
      (runtime/click! app autumn-row)
      (settle-layout! app))
    (is (= 1 (:selected-conference-index (runtime/active-state app))))
    (is (= "Autumn Workshop"
           (:program/name (active-conference app))))
    (let [name-input (input-with-value app "Autumn Workshop")]
      (is (not (nil? name-input)))
      (runtime/click! app name-input)
      (press-key! app :end)
      (type-keys! app [:space
                       :d
                       :a
                       :y])
      (settle-layout! app))
    (is (= "Autumn Workshop"
           (:program/name (active-conference app))))
    (let [new-conference-button (runtime/find-view-containing
                                 app
                                 "ui/button"
                                 "New Conference")]
      (is (not (nil? new-conference-button)))
      (runtime/mouse-down-in! app new-conference-button 2 2)
      (settle-layout! app)
      (runtime/mouse-up-at! app 2 2))
    (settle-layout! app)
    (is (= "Autumn Workshop day"
           (:program/name (active-conference app))))
    (is (= "Autumn Workshop day"
           (:program/name (active-conference-at app 1))))
    (is (= []
           (:program/entries (active-conference-at app 0))))
    (let [summer-row (runtime/find-view-containing
                      app
                      "ui/list-box-item"
                      "Summer Conference")]
      (runtime/click! app summer-row)
      (settle-layout! app))
    (is (= 0 (:selected-conference-index (runtime/active-state app))))
    (is (= []
           (:program/entries (active-conference app))))
    (let [add-button (runtime/find-view-containing app "ui/button" "Add")]
      (runtime/click! app add-button)
      (settle-layout! app))
    (is (= "ui/dialog-frame" (runtime/active-mode-name app)))
    (is (not (nil? (head (runtime/find-views app "ui/color-picker")))))
    (let [title-input (input-with-value app "")]
      (is (not (nil? title-input)))
      (runtime/click! app title-input)
      (type-keys! app [:k :e :y :n :o :t :e])
      (settle-layout! app))
    (let [speaker-combo (combo-with-selected-label app "Lovelace")]
      (is (not (nil? speaker-combo)))
      (runtime/click! app speaker-combo)
      (settle-layout! app)
      (let [hopper-option (runtime/find-view-containing
                           app
                           "ui/list-box-item"
                           "Hopper")]
        (is (not (nil? hopper-option)))
        (runtime/click! app hopper-option)
        (settle-layout! app)))
    (let [ok-button (runtime/find-view-containing app "ui/button" "OK")]
      (is (not (nil? ok-button)))
      (runtime/click! app ok-button)
      (settle-layout! app))
    (is (= "main-mode" (runtime/active-mode-name app)))
    (is (= {:kind :talk
            :color {:r 0x4f :g 0x83 :b 0xcc :a 255}
            :title "keynote"
            :speaker :person/grace
            :duration 30}
           (select-keys (program-entry-at app 0)
                        [:kind
                         :color
                         :title
                         :speaker
                         :duration])))
    (is (not (nil? (runtime/find-view-containing
                    app
                    "ui/list-box-item"
                    "keynote"))))
    (let [new-conference (runtime/find-view-containing
                          app
                          "ui/button"
                          "New Conference")]
      (is (not (nil? new-conference)))
      (runtime/click! app new-conference)
      (settle-layout! app))
    (let [name-input (input-with-value app "New Conference")]
      (is (not (nil? name-input)))
      (runtime/click! app name-input)
      (press-key! app :end)
      (type-keys! app [:space
                       "2"
                       "0"
                       "2"
                       "7"])
      (settle-layout! app))
    (let [save-button (runtime/find-view-containing app "ui/button" "Save")]
      (is (not (nil? save-button)))
      (runtime/click! app save-button)
      (settle-layout! app))
    (is (= 3 (count (:conferences (runtime/active-state app)))))
    (is (= 2 (:selected-conference-index (runtime/active-state app))))
    (is (= "New Conference 2027"
           (:program/name (active-conference app))))
    (is (= "New Conference 2027"
           (:program/name (active-conference-at app 2))))
    (is (not (nil? (runtime/find-view-containing
                    app
                    "ui/list-box-item"
                    "New Conference 2027"))))))
