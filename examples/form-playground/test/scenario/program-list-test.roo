(ns form-playground.scenario.program-list-test
  (:require proof.core
            form-playground.core
            [proof.syntax :as s]
            [pixils.test :as px]))



;; Program array presentation

(deftest program-list/presents-the-first-conference-on-tab-open
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app "ui/tab" ":tab-id :program"))
      (px/settle-layout! app)
      app))

  (s/when [app]
    (let [conference-control
          (find-first (px/find-views app "pixils/form-array-control")
                      (fn [view] (= :conferences (-> view :state :field-id))))]
      {:selection (select-keys (:state conference-control) [:selected-index :value])
       :name-input? (any? (px/find-views app "ui/text-input")
                          (fn [view]
                            (= "Summer Conference" (-> view :ui-state :value))))
       :agenda-label? (some? (px/find-view-containing app
                                                           "ui/text"
                                                           "Agenda entries"))}))

  (s/then [result]
    (is (= {:selection {:selected-index 0
                        :value {:conference/id :conference/summer
                                :program/name "Summer Conference"
                                :program/entries []}}
            :name-input? true
            :agenda-label? true}
           result))))

(deftest program-list/selects-a-conference-through-component-state
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app "ui/tab" ":tab-id :program"))
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app
                    (px/find-view-containing app
                                                  "ui/list-box-item"
                                                  "Autumn Workshop"))
    (px/settle-layout! app)
    (let [conference-control
          (find-first (px/find-views app "pixils/form-array-control")
                      (fn [view] (= :conferences (-> view :state :field-id))))]
      {:selection (select-keys (:state conference-control) [:selected-index :value])
       :name-input? (any? (px/find-views app "ui/text-input")
                          (fn [view]
                            (= "Autumn Workshop" (-> view :ui-state :value))))}))

  (s/then [result]
    (is (= {:selection {:selected-index 1
                        :value {:conference/id :conference/autumn
                                :program/name "Autumn Workshop"
                                :program/entries [{:kind :break
                                                   :color {:r 214 :g 165 :b 79 :a 255}
                                                   :label "Arrival"
                                                   :duration 15}]}}
            :name-input? true}
           result))))

(deftest program-list/keeps-an-entry-visible-after-dialog-editing
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app "ui/tab" ":tab-id :program"))
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app
                                                    "ui/list-box-item"
                                                    "Autumn Workshop"))
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app
                    (px/find-view-containing app
                                                  "ui/list-box-item"
                                                  "Untitled entry"))
    (px/settle-layout! app)
    (px/click! app (px/find-view-containing app "ui/button" "Edit"))
    (px/settle-layout! app)
    (let [dialog-open? (= "ui/dialog-frame" (px/active-mode-name app))]
      (px/click! app (px/find-view-containing app "ui/button" "OK"))
      (px/settle-layout! app)
      {:dialog-open? dialog-open?
       :active-mode (px/active-mode-name app)
       :entries (-> (px/active-state app) :conferences (nth 1) :program/entries)
       :entry-visible? (some? (px/find-view-containing app
                                                            "ui/list-box-item"
                                                            "Untitled entry"))}))

  (s/then [result]
    (is (= {:dialog-open? true
            :active-mode "main-mode"
            :entries [{:kind :break
                       :color {:r 214 :g 165 :b 79 :a 255}
                       :label "Arrival"
                       :duration 15}]
            :entry-visible? true}
           result))))

(deftest program-list/adds-an-entry-using-people-as-form-context
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app "ui/tab" ":tab-id :program"))
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view-containing app "ui/button" "Add"))
    (px/settle-layout! app)
    (let [title-input
          (find-first (px/find-views app "ui/text-input")
                      (fn [view] (= "" (-> view :ui-state :value))))]
      (px/click! app title-input)
      (px/press-key! app :k)
      (px/press-key! app :e)
      (px/press-key! app :y)
      (px/press-key! app :n)
      (px/press-key! app :o)
      (px/press-key! app :t)
      (px/press-key! app :e)
      (px/settle-layout! app))
    (let [speaker-combo
          (find-first (px/find-views app "ui/combo-box")
                      (fn [view]
                        (= "Lovelace" (:selected-label (px/view-state view)))))]
      (px/click! app speaker-combo)
      (px/settle-layout! app))
    (px/click! app
                    (px/find-view-containing app "ui/combo-box-item" "Hopper"))
    (px/settle-layout! app)
    (px/click! app (px/find-view-containing app "ui/button" "OK"))
    (px/settle-layout! app)
    {:entry (select-keys (-> (px/active-state app)
                             :conferences head :program/entries head)
                         [:kind :color :title :speaker :duration])
     :entry-visible? (some? (px/find-view-containing app
                                                          "ui/list-box-item"
                                                          "keynote"))})

  (s/then [result]
    (is (= {:entry {:kind :talk
                    :color {:r 79 :g 131 :b 204 :a 255}
                    :title "keynote"
                    :speaker :person/grace
                    :duration 30}
            :entry-visible? true}
           result))))

(deftest program-list/creates-a-conference-through-the-inline-editor
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      (px/click! app
                      (px/find-view-containing app "ui/tab" ":tab-id :program"))
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view-containing app "ui/button" "New"))
    (px/settle-layout! app)
    (let [name-input
          (find-first (px/find-views app "ui/text-input")
                      (fn [view]
                        (= "New Conference" (-> view :ui-state :value))))]
      (px/click! app name-input)
      (px/press-key! app :end)
      (px/press-key! app :space)
      (px/press-key! app "2")
      (px/press-key! app "0")
      (px/press-key! app "2")
      (px/press-key! app "7")
      (px/settle-layout! app))
    (px/click! app (px/find-view-containing app "ui/button" "Save"))
    (px/settle-layout! app)
    (let [conference-control
          (find-first (px/find-views app "pixils/form-array-control")
                      (fn [view] (= :conferences (-> view :state :field-id))))]
      {:conferences (:conferences (px/active-state app))
       :selection (select-keys (:state conference-control) [:selected-index :value])
       :item-visible? (some? (px/find-view-containing app
                                                           "ui/list-box-item"
                                                           "New Conference 2027"))}))

  (s/then [result]
    (is (= {:conferences [{:conference/id :conference/summer
                           :program/name "Summer Conference"
                           :program/entries []}
                          {:conference/id :conference/autumn
                           :program/name "Autumn Workshop"
                           :program/entries [{:kind :break
                                              :color {:r 214 :g 165 :b 79 :a 255}
                                              :label "Arrival"
                                              :duration 15}]}
                          {:conference/id :conference/new-3
                           :program/name "New Conference 2027"
                           :program/entries []}]
            :selection {:selected-index 2
                        :value {:conference/id :conference/new-3
                                :program/name "New Conference 2027"
                                :program/entries []}}
            :item-visible? true}
           result))))
