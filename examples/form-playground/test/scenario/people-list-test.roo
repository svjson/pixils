(ns form-playground.scenario.people-list-test
  (:require proof.core
            form-playground.core
            [proof.syntax :as s]
            [pixils.test :as px]
            [pixils.ui :as ui]))

(deftest people-list/renders-and-selects-the-people-array
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (let [list-box (px/find-view app "ui/list-box")]
      (ui/set-ui-state! list-box (assoc (:ui-state list-box) :sentinel :retained))
      (px/click! app
                      (px/find-view-containing app
                                                    "ui/list-box-item"
                                                    "Grace Hopper"))
      (px/settle-layout! app)
      {:list-box-sentinel (:sentinel (:ui-state (px/find-view app "ui/list-box")))
       :selection (select-keys (:state (px/find-view app
                                                          "pixils/form-array-control"))
                               [:selected-index :value])}))

  (s/then [result]
    (is (= {:list-box-sentinel :retained
            :selection {:selected-index 1
                        :value {:person/id :person/grace
                                :field/first-name "Grace"
                                :field/last-name "Hopper"
                                :field/age 85
                                :field/birth-place "New York"
                                :field/newsletter? false}}}
           result))))

(deftest people-list/uses-the-person-layout-at-the-referenced-editor-location
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (let [fields (px/find-views app "pixils/form-field")
          first-name-field
          (find-first fields
                      (fn [field]
                        (= :field/first-name (-> field :state :field-id))))]
      {:editor-present? (some? (px/find-view app
                                                  "pixils/form-layout-item-editor"))
       :first-name (-> (nth (ui/children first-name-field) 1) :ui-state :value)
       :field-ids (for [field fields]
                    (-> field :state :field-id))}))

  (s/then [result]
    (is (= {:editor-present? true
            :first-name "Ada"
            :field-ids [:field/first-name
                        :field/last-name
                        :field/age
                        :field/birth-place
                        :field/newsletter?
                        :people]}
           result))))

(deftest people-list/disables-the-item-form-when-the-array-has-no-selection
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/set-active-state! app (assoc (px/active-state app) :people []))
    (px/settle-layout! app)
    (let [first-name-field
          (find-first (px/find-views app "pixils/form-field")
                      (fn [field]
                        (= :field/first-name (-> field :state :field-id))))]
      (px/click! app (nth (ui/children first-name-field) 1))
      (px/press-key! app :x)
      (px/settle-layout! app)
      {:editor-disabled? (-> (px/find-view app "pixils/form-layout-item-editor")
                             :state :disabled?)
       :field-disabled? (-> first-name-field :state :disabled?)
       :people (:people (px/active-state app))}))

  (s/then [result]
    (is (= {:editor-disabled? true
            :field-disabled? true
            :people []}
           result))))

(deftest people-list/preserves-and-reorders-people-after-a-drag
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (let [items (px/find-views app "ui/list-box-item")
          first-item (head items)
          last-item (nth items 2)]
      (px/mouse-down-in! app first-item 5 5)
      (px/update! app)
      (px/mouse-move-in! app last-item 5 (dec (-> last-item :bounds :h)))
      (px/update! app)
      (px/mouse-up-in! app last-item 5 (dec (-> last-item :bounds :h)))
      (px/settle-layout! app)
      {:people (for [person (:people (px/active-state app))]
                 (:person/id person))
       :rendered-items (count (px/find-views app "ui/list-box-item"))}))

  (s/then [result]
    (is (= {:people [:person/grace :person/katherine :person/ada]
            :rendered-items 3}
           result))))

(deftest people-list/edits-the-selected-person-at-the-referenced-location
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app
                    (px/find-view-containing app
                                                  "ui/list-box-item"
                                                  "Grace Hopper"))
    (px/settle-layout! app)
    (let [first-name-input
          (find-first (px/find-views app "ui/text-input")
                      (fn [view] (= "Grace" (:value (:ui-state view)))))]
      (px/click! app first-name-input)
      (px/press-key! app :end)
      (px/press-key! app :x)
      (px/settle-layout! app))
    (px/click! app
                    (px/find-view-containing app
                                                  "ui/text"
                                                  "Pixils Form Playground"))
    (px/settle-layout! app)
    {:people (for [person (:people (px/active-state app))]
               (:field/first-name person))
     :rendered-items (count (px/find-views app "ui/list-box-item"))})

  (s/then [result]
    (is (= {:people ["Ada" "Gracex" "Katherine"]
            :rendered-items 3}
           result))))

(deftest people-list/starts-and-cancels-a-new-item-at-the-referenced-location
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view-containing app "ui/button" "New"))
    (px/settle-layout! app)
    (let [new-state
          (select-keys (:state (px/find-view app "pixils/form-array-control"))
                       [:new? :value])]
      (px/click! app (px/find-view-containing app "ui/button" "Cancel"))
      (px/settle-layout! app)
      {:new-state new-state
       :cancelled-state (select-keys (:state (px/find-view app "pixils/form-array-control"))
                                     [:new? :selected-index :value])
       :people-count (count (:people (px/active-state app)))}))

  (s/then [result]
    (is (= {:new-state {:new? true
                        :value {:person/id :person/new-4
                                :field/first-name ""
                                :field/last-name ""
                                :field/age 0
                                :field/birth-place ""
                                :field/newsletter? false
                                :label "New Person 4"}}
            :cancelled-state {:new? false
                              :selected-index 0
                              :value {:person/id :person/ada
                                      :field/first-name "Ada"
                                      :field/last-name "Lovelace"
                                      :field/age 36
                                      :field/birth-place "London"
                                      :field/newsletter? true}}
            :people-count 3}
           result))))

(deftest people-list/saves-a-new-item-from-the-referenced-location
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800 :buffer-height 600
                                 :render-backend false})]
      (px/push-mode! app 'main-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view-containing app "ui/button" "New"))
    (px/settle-layout! app)
    (let [first-name-field
          (find-first (px/find-views app "pixils/form-field")
                      (fn [field]
                        (= :field/first-name (-> field :state :field-id))))
          last-name-field
          (find-first (px/find-views app "pixils/form-field")
                      (fn [field]
                        (= :field/last-name (-> field :state :field-id))))]
      (px/click! app (nth (ui/children first-name-field) 1))
      (px/press-key! app :n)
      (px/press-key! app :e)
      (px/press-key! app :w)
      (px/click! app (nth (ui/children last-name-field) 1))
      (px/press-key! app :p)
      (px/press-key! app :e)
      (px/press-key! app :r)
      (px/press-key! app :s)
      (px/press-key! app :o)
      (px/press-key! app :n)
      (px/click! app
                      (px/find-view-containing app
                                                    "ui/text"
                                                    "Pixils Form Playground"))
      (px/settle-layout! app))
    (px/click! app (px/find-view-containing app "ui/button" "Save"))
    (px/settle-layout! app)
    {:people (for [person (:people (px/active-state app))]
               (select-keys person
                            [:person/id :field/first-name :field/last-name]))
     :rendered-items (count (px/find-views app "ui/list-box-item"))})

  (s/then [result]
    (is (= {:people [{:person/id :person/ada
                      :field/first-name "Ada"
                      :field/last-name "Lovelace"}
                     {:person/id :person/grace
                      :field/first-name "Grace"
                      :field/last-name "Hopper"}
                     {:person/id :person/katherine
                      :field/first-name "Katherine"
                      :field/last-name "Johnson"}
                     {:person/id :person/new-4
                      :field/first-name "new"
                      :field/last-name "person"}]
            :rendered-items 4}
           result))))
