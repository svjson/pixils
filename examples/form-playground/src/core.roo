(ns form-playground.core
  (:require pixils
            pixils.form.base-theme
            pixils.ui.theme.windows-3
            form-playground.view.root
            form-playground.theme))

(defprogram form-playground
  {:display {:resolution {:scale 2}
             :align :align/center
             :background {:r 0x1c :g 0x20 :b 0x24}}
   :target-frame-rate 0
   :theme ['pixils/windows-3 'pixils-form/base 'form-playground/theme]
   :initial-mode 'main-mode})
