(ns form-playground.forms.program.components
  (:require pixils
            [form-playground.forms.persons.model :as persons-model]
            [form-playground.forms.program.model :as model]
            [form-playground.forms.program.schema :as schema]
            [pixils.form :as form]
            [pixils.ui :as ui]))

(defcomponent program-planner
  {:class :program-planner
   :children [(form/make {:schema schema/program-schema
                          :value (ui/bind-state :selected-conference)
                          :items (ui/bind-state :conferences)
                          :selected-index
                          (ui/bind-state :selected-conference-index)
                          :new-value-fn model/empty-conference
                          :text model/program-text
                          :class :program-planner-form
                          :mode :live
                          :context persons-model/people
                          :valid? (ui/bind-state :program-valid?)
                          :errors (ui/bind-state :program-errors)
                          :layout [[:row.program-main-row
                                    {:type :form
                                     :layout model/program-layout}
                                    [:group.program-list-column
                                     {:type :selection
                                      :class :program-list
                                      :item-label
                                      model/conference-label}
                                     [:button.program-new
                                      :form/new
                                      {:label "New Conference"
                                       :disabled-when :new?}]]]
                                   [:row.program-button-row
                                    [:button.program-save
                                     :form/save-new
                                     {:label "Save"
                                      :enabled-when [:and :new? :valid?]}]
                                    [:button.program-cancel
                                     :form/cancel-new
                                     {:label "Cancel"
                                      :enabled-when :new?}]]]})]})

(defun make []
  {:mode 'program-planner
   :state {:conferences (ui/bind-state :conferences)
           :selected-conference-index
           (ui/bind-state :selected-conference-index)
           :selected-conference
           (ui/bind-state :selected-conference)
           :program-valid? (ui/bind-state :program-valid?)
           :program-errors (ui/bind-state :program-errors)}})
