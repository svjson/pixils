(ns form-playground.forms.program.model)

(def program-text
  {:program/name "Program name"
   :program/entries "Agenda entries"
   :kind "Entry type"
   :title "Title"
   :speaker "Speaker"
   :duration "Duration"
   :facilitator "Facilitator"
   :capacity "Capacity"
   :hands-on? "Hands-on"
   :topic "Topic"
   :moderator "Moderator"
   :panelist "Panelist"
   :label "Label"})

(def program-layout
  [:program/name
   :program/entries])

(def conferences
  [{:conference/id :conference/summer
    :program/name "Summer Conference"
    :program/entries []}
   {:conference/id :conference/autumn
    :program/name "Autumn Workshop"
    :program/entries [{:kind :break
                       :label "Arrival"
                       :duration 15}]}])

(defun empty-conference [index]
  {:conference/id (keyword (str "conference/new-" (inc index)))
   :program/name "New Conference"
   :program/entries []})

(defun conference-label [conference index]
  (let [name (:program/name conference)]
    (if (and (not (nil? name))
             (> (count name) 0))
      name
      (str "Conference " (inc index)))))
