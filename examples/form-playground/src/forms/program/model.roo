(ns form-playground.forms.program.model)

(def program-text
  {:program/name "Program name"
   :program/entries "Agenda entries"
   :kind "Entry type"
   :color "Color"
   :title "Title"
   :speaker "Speaker"
   :duration "Duration"
   :facilitator "Facilitator"
   :capacity "Capacity"
   :hands-on? "Hands-on"
   :topic "Topic"
   :moderator "Moderator"
   :panelist "Panelist"
   :label "Label"})

(def program-layout
  [:program/name
   :program/entries])

(def program-layout-fragments
  {:talk-entry [:kind
                :color
                :title
                :speaker
                :duration]
   :workshop-entry [:kind
                    :color
                    :title
                    :facilitator
                    :capacity
                    :hands-on?]
   :panel-entry [:kind
                 :color
                 :topic
                 :moderator
                 :panelist]
   :break-entry [:kind
                 :color
                 :label
                 :duration]})

(def conferences
  [{:conference/id :conference/summer
    :program/name "Summer Conference"
    :program/entries []}
   {:conference/id :conference/autumn
    :program/name "Autumn Workshop"
    :program/entries [{:kind :break
                       :color {:r 0xd6 :g 0xa5 :b 0x4f :a 255}
                       :label "Arrival"
                       :duration 15}]}])

(defun empty-conference [index]
  {:conference/id (keyword (str "conference/new-" (inc index)))
   :program/name "New Conference"
   :program/entries []})

(defun conference-label [conference index]
  (let [name (:program/name conference)]
    (if (and (not (nil? name))
             (not-empty? name))
      name
      (str "Conference " (inc index)))))
