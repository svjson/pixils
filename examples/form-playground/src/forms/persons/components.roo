(ns form-playground.forms.persons.components
  (:require pixils
            [form-playground.forms.persons.model :as model]
            [form-playground.forms.persons.schema :as schema]
            [pixils.form :as form]
            [pixils.ui :as ui]))

(defcomponent person-register
  {:class :person-register
   :children [(form/make {:schema schema/person-schema
                          :value (ui/bind-state :selected-person)
                          :items (ui/bind-state :people)
                          :selected-index
                          (ui/bind-state :selected-person-index)
                          :new-value-fn model/empty-person
                          :text model/person-text
                          :class :person-register-form
                          :mode :live
                          :valid? (ui/bind-state :person-valid?)
                          :errors (ui/bind-state :person-errors)
                          :layout [[:row.person-main-row
                                    {:type :form
                                     :layout model/person-layout}
                                    [:group.person-list-column
                                     {:type :selection
                                      :class :person-list
                                      :item-label model/person-label}
                                     [:button.person-new
                                      :form/new
                                      {:label "New Person"
                                       :disabled-when :new?}]]]
                                   [:row.person-button-row
                                    [:button.person-save
                                     :form/save-new
                                     {:label "Save"
                                      :enabled-when [:and :new? :valid?]}]
                                    [:button.person-cancel
                                     :form/cancel-new
                                     {:label "Cancel"
                                      :enabled-when :new?}]]]})]})

(defun make []
  {:mode 'person-register
   :state {:people (ui/bind-state :people)
           :selected-person-index
           (ui/bind-state :selected-person-index)
           :selected-person (ui/bind-state :selected-person)
           :person-valid? (ui/bind-state :person-valid?)
           :person-errors (ui/bind-state :person-errors)}})
