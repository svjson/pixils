(ns form-playground.forms.persons.components
  (:require pixils
            [form-playground.forms.persons.logic :as logic]
            [form-playground.forms.persons.model :as model]
            [form-playground.forms.persons.schema :as schema]
            [pixils.form :as form]
            [pixils.ui :as ui]))

(defcomponent person-register
  {:style {:width 620
           :height :shrink
           :padding 10
           :background {:r 0xd6 :g 0xd6 :b 0xce}
           :layout {:direction :column
                    :gap 8}}
   :on {:person-register/new logic/handle-new-person
        :person-register/save logic/handle-save-person
        :person-register/cancel logic/handle-cancel-person}
   :children [(form/make {:models {:register
                                   {:models
                                    {:person
                                     {:schema schema/person-schema
                                      :value (ui/bind-state
                                              :selected-person)}
                                     :people
                                     {:value (ui/bind-state :people)}
                                     :selected-person-index
                                     {:value
                                      (ui/bind-state :selected-person-index)
                                      :transient? true}
                                     :new-person?
                                     {:value (ui/bind-state :new-person?)
                                      :transient? true}
                                     :new-person
                                     {:value (ui/bind-state :new-person)
                                      :transient? true}}
                                    :projections
                                    {:current-person
                                     {:target [:register :person]
                                      :items [:register :people]
                                      :selected-index
                                      [:register :selected-person-index]
                                      :new? [:register :new-person?]
                                      :new-value
                                      [:register :new-person]}}}}
                          :text model/person-text
                          :style {:width :fill
                                  :height :shrink
                                  :layout {:direction :column
                                           :gap 8}}
                          :valid? (ui/bind-state :person-valid?)
                          :errors (ui/bind-state :person-errors)
                          :layout [{:type :row
                                    :style {:width :fill
                                            :height :shrink
                                            :layout {:direction :row
                                                     :align-items :start
                                                     :gap 12}}
                                    :children [{:type :form
                                                :model [:register :person]
                                                :layout model/person-layout}
                                               {:type :group
                                                :style {:width 180
                                                        :height :shrink
                                                        :layout
                                                        {:direction :column
                                                         :gap 8}}
                                                :children
                                                [{:type :selection
                                                  :projection
                                                  [:register :current-person]
                                                  :style {:width :fill
                                                          :height :shrink
                                                          :layout
                                                          {:direction :column
                                                           :gap 4}}
                                                  :item-label
                                                  model/person-label}
                                                 {:type :action
                                                  :id :person-register/new
                                                  :label "New Person"
                                                  :style {:width :fill
                                                          :height 24}
                                                  :disabled-when
                                                  :new?}]}]}
                                   {:type :row
                                    :style {:width :fill
                                            :height 24
                                            :layout {:direction :row
                                                     :gap 8}}
                                    :children [{:type :action
                                                :id :person-register/save
                                                :label "Save"
                                                :enabled-when
                                                [:and :new? :valid?]}
                                               {:type :action
                                                :id :person-register/cancel
                                                :label "Cancel"
                                                :enabled-when :new?}]}]})]})

(defun make []
  {:mode 'person-register
   :state {:people (ui/bind-state :people)
           :selected-person-index
           (ui/bind-state :selected-person-index)
           :selected-person (ui/bind-state :selected-person)
           :new-person? (ui/bind-state :new-person?)
           :new-person (ui/bind-state :new-person)
           :previous-person-index
           (ui/bind-state :previous-person-index)
           :person-valid? (ui/bind-state :person-valid?)
           :person-errors (ui/bind-state :person-errors)}})
