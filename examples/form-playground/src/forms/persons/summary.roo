(ns form-playground.forms.persons.summary
  (:require pixils
            [pixils.ui :as ui]))

(defun summary-line [label binding]
  {:style {:width :fill
           :height 18
           :layout {:direction :row
                    :gap 6}}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 92}
               :state {:value label}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value binding}}]})

(defcomponent person-summary
  {:class :person-summary
   :children [(summary-line "First"
                            (ui/bind-state :person :field/first-name))
              (summary-line "Last"
                            (ui/bind-state :person :field/last-name))
              (summary-line "Age"
                            (ui/bind-state :person :field/age))
              (summary-line "Birth place"
                            (ui/bind-state :person :field/birth-place))
              (summary-line "Newsletter"
                            (ui/bind-state :person :field/newsletter?))
              (summary-line "Valid"
                            (ui/bind-state :form-valid?))
              (summary-line "Errors"
                            (ui/bind-state :form-errors))]})

(defun make []
  {:mode 'person-summary
   :state {:person (ui/bind-state :selected-person)
           :form-valid? (ui/bind-state :person-valid?)
           :form-errors (ui/bind-state :person-errors)}})
