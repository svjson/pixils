(ns form-playground.theme
  (:require pixils))

(def panel-bg {:r 0xd6 :g 0xd6 :b 0xce})

(deftheme form-playground/theme
  {:extend 'pixils/windows-3
   :styles {:person-register
            {:width 620
             :height :shrink
             :padding 10
             :background panel-bg
             :layout {:direction :column
                      :gap 8}}

            :person-register-form
            {:width :fill
             :height :shrink
             :layout {:direction :column
                      :gap 8}}

            :person-main-row
            {:width :fill
             :height :shrink
             :layout {:direction :row
                      :align-items :start
                      :gap 12}}

            :person-list-column
            {:width 180
             :height :shrink
             :layout {:direction :column
                      :gap 8}}

            :person-list
            {:width :fill
             :height :shrink
             :layout {:direction :column
                      :gap 4}}

            :person-new
            {:width :fill
             :height 24}

            :person-button-row
            {:width :fill
             :height 24
             :layout {:direction :row
                      :gap 8}}

            :person-save
            {:width 96
             :height 24}

            :person-cancel
            {:width 96
             :height 24}

            :person-summary
            {:width :fill
             :height :shrink
             :padding 8
             :background panel-bg
             :layout {:direction :column
                      :gap 4}}}})
