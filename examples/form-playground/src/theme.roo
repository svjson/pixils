(ns form-playground.theme
  (:require pixils
            pixils.ui.theme.windows-3))

(def panel-bg {:r 0xd6 :g 0xd6 :b 0xce})

(deftheme form-playground/theme
  {:extend 'pixils/windows-3
   :styles {:app/person-register
            {:width 680
             :height :shrink
             :padding 10
             :background panel-bg
             :layout {:direction :column
                      :gap 8}}

            :app/person-register-form
            {:width :fill
             :height :shrink
             :layout {:direction :column
                      :gap 8}}

            :app/person-main-row
            {:width :fill
             :height :shrink
             :layout {:direction :row
                      :align-items :start
                      :gap 12}}

            :app/person-list-column
            {:width 180
             :height :shrink
             :layout {:direction :column
                      :gap 8}}

            :app/person-summary
            {:width :fill
             :height :shrink
             :padding 8
             :background panel-bg
             :layout {:direction :column
                      :gap 4}}

            :app/program-planner
            {:width 680
             :height :shrink
             :padding 10
             :background panel-bg
             :layout {:direction :column
                      :gap 8}}

            :app/program-planner-form
            {:width :fill
             :height :shrink
             :layout {:direction :column
                      :gap 8}}

            :app/program-main-row
            {:width :fill
             :height :shrink
             :layout {:direction :row
                      :align-items :start
                      :gap 12}}

            :app/program-list-column
            {:width 180
             :height :shrink
             :layout {:direction :column
                      :gap 8}}}})
