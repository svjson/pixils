(ns form-playground.root
  (:require pixils
            [form-playground.forms.persons.components :as persons]
            [form-playground.forms.persons.model :as persons-model]
            [form-playground.forms.persons.summary :as persons-summary]
            [pixils.ui :as ui]))

(defmode main-mode
  {:class :ui/app
   :style {:width :fill
           :height :fill
           :padding 16
           :background {:r 0xeb :g 0xeb :b 0xe4}
           :layout {:direction :column
                    :gap 12}}
   :init (fn [state ctx]
           (persons-model/initial-state))
   :children [{:mode 'ui/text
               :style {:width :fill
                       :height 22
                       :text {:font :font/default
                              :scale 1.2}}
               :state {:value "Pixils Form Playground"}}
              (persons/make)
              (persons-summary/make)]})
