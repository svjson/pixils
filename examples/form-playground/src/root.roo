(ns form-playground.root
  (:require pixils
            [pixils.form :as form]
            [pixils.ui :as ui]))

(def person-schema
  {:field/first-name {:type :text
                      :required true}
   :field/last-name {:type :text
                     :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/birth-place {:type :text}
   :field/newsletter? {:type :boolean}})

(def person-text
  {:field/first-name "First name"
   :field/last-name "Last name"
   :field/age "Age"
   :field/birth-place "Birth place"
   :field/newsletter? "Newsletter"})

(def person-layout
  [[:field/first-name :field/last-name]
   :------
   :field/age
   :field/birth-place
   :field/newsletter?])

(defun preview-line [label state-key]
  {:style {:width :fill
           :height 18
           :layout {:direction :row
                    :gap 6}}
   :state {state-key (ui/bind-state state-key)}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width 92}
               :state {:value label}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state state-key)}}]})

(defun bool-text [value]
  (if value "true" "false"))

(defun errors-text [errors]
  (if (or (nil? errors)
          (empty? (keys errors)))
    "{}"
    (str errors)))

(defun preview-value [person key]
  (let [value (get (or person {}) key)]
    (if (nil? value) "" (str value))))

(defcomponent person-preview
  {:style {:width :fill
           :height :shrink
           :padding 8
           :background {:r 0xd6 :g 0xd6 :b 0xce}
           :layout {:direction :column
                    :gap 4}}
   :update (fn [state ctx]
             (let [person (:person state)]
               (assoc state
                      :first-name-value
                      (preview-value person :field/first-name)
                      :last-name-value
                      (preview-value person :field/last-name)
                      :age-value
                      (preview-value person :field/age)
                      :birth-place-value
                      (preview-value person :field/birth-place)
                      :newsletter-value
                      (bool-text (:field/newsletter? person))
                      :valid-value
                      (bool-text (:form-valid? state))
                      :errors-value
                      (errors-text (:form-errors state)))))
   :children [(preview-line "First" :first-name-value)
              (preview-line "Last" :last-name-value)
              (preview-line "Age" :age-value)
              (preview-line "Birth place" :birth-place-value)
              (preview-line "Newsletter" :newsletter-value)
              (preview-line "Valid" :valid-value)
              (preview-line "Errors" :errors-value)]})

(defmode main-mode
  {:class :ui/app
   :style {:width :fill
           :height :fill
           :padding 16
           :background {:r 0xeb :g 0xeb :b 0xe4}
           :layout {:direction :column
                    :gap 12}}
   :init (fn [state ctx]
           {:person {:field/first-name "Ada"
                     :field/last-name "Lovelace"
                     :field/age 36
                     :field/birth-place "London"
                     :field/newsletter? true}
            :person-valid? false
            :person-errors {}})
   :children [{:mode 'ui/text
               :style {:width :fill
                       :height 22
                       :text {:font :font/default
                              :scale 1.2}}
               :state {:value "Pixils Form Playground"}}
              {:style {:width 420
                       :height :shrink
                       :padding 10
                       :background {:r 0xd6 :g 0xd6 :b 0xce}}
               :state {:person (ui/bind-state :person)
                       :person-valid? (ui/bind-state :person-valid?)
                       :person-errors (ui/bind-state :person-errors)}
               :children [(form/make {:schema person-schema
                                      :text person-text
                                      :layout person-layout
                                      :value (ui/bind-state :person)
                                      :valid? (ui/bind-state :person-valid?)
                                      :errors (ui/bind-state :person-errors)})]}
              {:mode 'person-preview
               :state {:person (ui/bind-state :person)
                       :form-valid? (ui/bind-state :person-valid?)
                       :form-errors (ui/bind-state :person-errors)}}]})
