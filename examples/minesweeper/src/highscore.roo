(ns pixils.examples.minesweeper.highscore
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.window :as w]
            [pixils.ui.text-input :as ti]))



;; Highscore Table Window

(def col-1-width 90)
(def col-2-width 100)

(defcomponent highscore-row
  {:style {:layout {:direction :row}}
   :update (fn [state ctx]
             (assoc state :time-str (str (:time state) " seconds")))
   :children [{:mode 'ui/text
               :style {:width col-1-width}
               :state {:value (ui/bind-state :difficulty-name)}}
              {:mode 'ui/text
               :style {:width col-2-width}
               :state {:value (ui/bind-state :time-str)}}
              {:mode 'ui/text
               :state {:value (ui/bind-state :player-name)}}]})

(defcomponent highscore-table
  {:style {:margin 16}
   :children [{:mode 'highscore-row
               :state (ui/bind-state :beginner)}
              {:mode 'highscore-row
               :state (ui/bind-state :intermediate)}
              {:mode 'highscore-row
               :state (ui/bind-state :expert)}]})

(defcomponent highscore-buttons
  {:style {:width :fill
           :layout {:direction :row
                    :gap :space-between}
           :margin [8 28]}
   :children [{:mode 'ui/button
               :state {:label "Reset Scores"}}
              {:mode 'ui/button
               :init (fn [state ctx]
                       (ui/focus! ctx)
                       state)
               :state {:label " OK "}
               :on-click (fn [state event ctx]
                           (ui/emit! (:view ctx) :highscores/close)
                           state)}]})

(defcomponent highscores-window
  {:class :ui/content
   :children [{:mode 'highscore-table
               :state (ui/bind-state :highscores)}
              {:mode 'highscore-buttons}]})

(defmode highscores-modal
  {:on {:highscores/close (fn [state event ctx]
                            (ui/stop-propagation! event)
                            (pop-mode!)
                            state)}
   :compose {:render :pass}
   :children [(w/make {:position {:x 100 :y 100}
                       :kind :dialog-frame
                       :title-bar {:title "Fastest Mine Sweepers"}
                       :state {:highscores (ui/bind-state :highscores)}
                       :body [{:mode 'highscores-window
                               :state {:highscores (ui/bind-state :highscores)}}]})]})



;; New Highscore Window

(defcomponent new-highscore-window
  {:style {:style {:width 155}
           :layout {:align-items :center}
           :padding 8}
   :class :ui/content
   :children [{:mode 'ui/text
               :state {:difficulty-name (ui/bind-state :difficulty-name)}
               :style {:width 170
                       :text {:align :center}}
               :update (fn [state ctx]
                         (assoc state :value (str "You have the fastest time for "
                                                  (:difficulty-name state)
                                                  " level.")))}
              {:mode 'ui/text
               :style {:width :fill
                       :text {:align :center}}
               :state {:value "Please type your name."}}
              {:mode 'text-input
               :style {:margin 16
                       :width :fill}}
              {:mode 'ui/button
               :state {:label "   OK   "}
               :init (fn [state ctx]
                       (ui/focus! ctx)
                       state)
               :on-click (fn [state event ctx]
                           (ui/emit! (:view ctx) :highscores/close)
                           state)}]})


(defmode new-highscore-modal
  {:on {:highscores/close (fn [state event ctx]
                            (ui/stop-propagation! event)
                            (pop-mode!)
                            state)}
   :compose {:render :pass}
   :children [(w/make {:position {:x 100 :y 100}
                       :title-bar {:title "New Highscore"}
                       :body [{:mode 'new-highscore-window
                               :state {:difficulty-name "beginner"}}]})]})
