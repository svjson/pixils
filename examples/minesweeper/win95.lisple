(ns pixils.examples.minesweeper.win95
  (:require pixils
            [pixils.color :as c]
            [pixils.examples.minesweeper.win :as win]))


;; Win95 Sans Serif System Font

(defbundle win95 {:images {:system-font "assets/win95systemfont.png"
                           :minimize-button "assets/win95-minimize-button.png"}})

(deffont win95-system-font
  {:type :bitmap
   :spacing 1
   :resource :win95/system-font
   :baseline 8
   :styles {:underline {:offset 2
                        :thickness 1}}
   :glyphs {' ' {:x 144 :y 11 :w 1 :h 11}
            '.' {:x 73 :y 22 :w 1 :h 10}
            '?' {:x 67 :y 22 :w 6 :h 10}
            '(' {:x 61 :y 22 :w 2 :h 12}
            ')' {:x 64 :y 22 :w 2 :h 12}
            '0' {:x 0 :y 22 :w 5 :h 9}
            '1' {:x 7 :y 22 :w 3 :h 9}
            '2' {:x 11 :y 22 :w 5 :h 9}
            '3' {:x 17 :y 22 :w 5 :h 9}
            '4' {:x 24 :y 22 :w 5 :h 9}
            '5' {:x 30 :y 22 :w 5 :h 9}
            '6' {:x 36 :y 22 :w 5 :h 9}
            '7' {:x 42 :y 22 :w 5 :h 9}
            '8' {:x 48 :y 22 :w 5 :h 9}
            '9' {:x 54 :y 22 :w 5 :h 9}
            'A' {:x 0 :y 0 :w 7 :h 9}
            'B' {:x 8 :y 0 :w 5 :h 9}
            'C' {:x 14 :y 0 :w 6 :h 9}
            'D' {:x 22 :y 0 :w 6 :h 9}
            'E' {:x 29 :y 0 :w 5 :h 9}
            'F' {:x 35 :y 0 :w 5 :h 10}
            'G' {:x 41 :y 0 :w 6 :h 9}
            'H' {:x 48 :y 0 :w 6 :h 9}
            'I' {:x 55 :y 0 :w 1 :h 9}
            'J' {:x 58 :y 0 :w 4 :h 9}
            'K' {:x 63 :y 0 :w 6 :h 9}
            'M' {:x 77 :y 0 :w 7 :h 9}
            'N' {:x 85 :y 0 :w 6 :h 9}
            'O' {:x 92 :y 0 :w 6 :h 9}
            'P' {:x 99 :y 0 :w 6 :h 9}
            'Q' {:x 107 :y 0 :w 6 :h 10}
            'R' {:x 114 :y 0 :w 6 :h 10}
            'S' {:x 121 :y 0 :w 5 :h 9}
            'T' {:x 127 :y 0 :w 5 :h 9}
            'U' {:x 133 :y 0 :w 6 :h 9}
            'V' {:x 140 :y 0 :w 7 :h 9}
            'W' {:x 148 :y 0 :w 11 :h 9}
            'a' {:x 0 :y 11 :w 5 :h 9}
            'b' {:x 6 :y 11 :w 5 :h 9}
            'c' {:x 12 :y 11 :w 5 :h 9}
            'd' {:x 18 :y 11 :w 5 :h 9}
            'e' {:x 24 :y 11 :w 5 :h 9}
            'f' {:x 30 :y 11 :w 2 :h 9}
            'g' {:x 34 :y 11 :w 5 :h 11}
            'h' {:x 40 :y 11 :w 5 :h 9}
            'i' {:x 46 :y 11 :w 1 :h 9}
            'j' {:x 48 :y 11 :w 1 :h 11}
            'k' {:x 51 :y 11 :w 5 :h 9}
            'l' {:x 57 :y 11 :w 1 :h 11}
            'm' {:x 59 :y 11 :w 7 :h 9}
            'n' {:x 68 :y 11 :w 5 :h 9}
            'o' {:x 74 :y 11 :w 5 :h 9}
            'p' {:x 80 :y 11 :w 5 :h 11}
            'r' {:x 93 :y 11 :w 2 :h 9}
            's' {:x 96 :y 11 :w 4 :h 9}
            't' {:x 101 :y 11 :w 2 :h 9}
            'u' {:x 105 :y 11 :w 5 :h 9}
            'v' {:x 111 :y 11 :w 5 :h 9}
            'w' {:x 117 :y 11 :w 7 :h 9}
            'x' {:x 126 :y 11 :w 4 :h 9}}})


;; Windows 95 colors

(def WHITE {:r 255 :g 255 :b 255})
(def PANEL-COLOR {:r 0xb8 :g 0xb8 :b 0xb8})
(def PANEL-LIGHT {:r 0xdf :g 0xdf :b 0xdf})
(def PANEL-SHADOW {:r 0x7f :g 0x7f :b 0x7f})
(def FOCUS-BLUE {:r 0x00 :g 0x00 :b 0x7f})

(deftheme windows-95
  {:styles {'window {:border {:line-style :solid
                              :thickness 1
                              :color c/BLACK}
                     :text {:font :font/win95-system-font}}

            'window-title-bar {:background FOCUS-BLUE
                               :text {:color c/WHITE}
                               :width :fill
                               :height 19}

            'window-control-button {:hidden true}

            'window-minimize-button {:margin {:t 2}
                                     :width 16
                                     :height 14}

            'button
            {:border {:line-style :solid
                      :color c/BLACK
                      :thickness 1
                      :top {:thickness 0}
                      :left {:thickness 0}}}

            '(button {:pressed true})
            {:border {:top {:thickness 1 :color c/BLACK}
                      :left {:thickness 1 :color c/BLACK}}}

            'button-inner
            {:background PANEL-COLOR
             :border {:line-style :bevel
                      :color PANEL-LIGHT
                      :thickness 1
                      :right {:color PANEL-SHADOW}
                      :bottom {:color PANEL-SHADOW}}}

            '(button-inner {:pressed true})
            {:border {:line-style :bevel
                      :color PANEL-SHADOW
                      :thickness 1
                      :right {:thickness 1 :color PANEL-LIGHT}
                      :bottom {:thickness 1 :color PANEL-LIGHT}}}

            'menu-bar {:background PANEL-COLOR
                       :text {:font :font/win95-system-font
                              :color c/BLACK}}

            :menu/item
            {:text {:color c/BLACK
                    :marked-style {:enabled true
                                   :marker "@"
                                    :font-styles :underline}}
             :hover {:background FOCUS-BLUE
                     :text {:color WHITE}}}

            'menu-item {:hover {:background FOCUS-BLUE
                                :text {:color WHITE}}}

            'menu-bar-item:hover
            {:background PANEL-COLOR
             :text {:color c/BLACK}}

            '(menu-bar-item {:highlighted true})
            {:background FOCUS-BLUE
             :text {:color WHITE}}

            'popup-menu-item:hover
            {:background PANEL-COLOR
             :text {:color c/BLACK
                    :marked-style {:color c/BLACK}}}

            'popup-menu-option-item:hover
            {:background PANEL-COLOR
             :text {:color c/BLACK
                    :marked-style {:color c/BLACK}}}

            '(popup-menu-item {:highlighted true})
            {:background FOCUS-BLUE
             :text {:color WHITE
                    :marked-style {:color WHITE}}}

            '(popup-menu-option-item {:highlighted true})
            {:background FOCUS-BLUE
             :text {:color WHITE
                    :marked-style {:color WHITE}}}

            'menu-option-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            'menu-option-indicator
            {:margin {:l 2 :r 4}
             :box-sizing :content-box
             :width 8
             :height 10}

            '(menu-option-indicator {:selected true})
            {:background {:image :win3/checkmark}}

            'menu-separator {:height 2
                             :margin {:t 3 :r 2 :b 2 :l 2}
                             :border {:thickness 1
                                      :line-style :solid
                                      :color PANEL-SHADOW
                                      :left {:thickness 0}
                                      :right {:thickness 0}
                                      :bottom {:color PANEL-LIGHT}}}
            'popup-menu-outer {:border {:color PANEL-LIGHT
                                        :line-style :sold
                                        :thickness 1
                                        :bottom {:color c/BLACK}
                                        :right {:color c/BLACK}}}
            'popup-menu-inner {:border {:color c/WHITE
                                        :line-style :sold
                                        :thickness 1
                                        :bottom {:color PANEL-SHADOW}
                                        :right {:color PANEL-SHADOW}}
                               :background PANEL-COLOR
                               :text {:font :font/win95-system-font
                                      :color c/BLACK}}

            :ui/panel {:background PANEL-COLOR}}})
