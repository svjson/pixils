(ns pixils.examples.minesweeper.core
  (:require pixils
            [pixils.render :as r]
            [pixils.color :as c]
            [pixils.point :as pt]
            [pixils.ui :as ui]
            pixils.examples.minesweeper.container
            pixils.examples.minesweeper.button
            [pixils.examples.minesweeper.window :as w]
            [pixils.examples.minesweeper.game-logic :as gl]
            [pixils.examples.minesweeper.status-panel :as status-panel]
            [pixils.examples.minesweeper.board :as board]
            [pixils.examples.minesweeper.menu :as menu]
            [pixils.examples.minesweeper.highscore :as hs]
            [pixils.examples.minesweeper.win :as win]
            [pixils.examples.minesweeper.win95 :as win95]))

(defprogram minesweeper
  {:display {:resolution {:scale 3}}
   :target-frame-rate 0
   :theme 'windows-3
   :initial-mode 'main-mode})

(def menu-keymap
  {:key/f2 :game/new-game
   :key/f5 :action/show-highscores
   :key/f4 :game/quit
   :key/f1 :help/about
   [:key/shift :key/f5] :help/about})

(def menu-definition
  {:settings {:mnemonics {:marker "&"}
              :shortcuts {:render true}}
   :items [{:label "&Game"
            :items [{:label "&New"
                     :action :game/new-game}
                    :separator
                    {:label "&Beginner"
                     :type :option
                     :action :game/set-difficulty
                     :value :beginner
                     :selected-path [:game :settings :mode]}
                    {:label "&Intermediate"
                     :type :option
                     :action :game/set-difficulty
                     :value :intermediate
                     :selected-path [:game :settings :mode]}
                    {:label "&Expert"
                     :type :option
                     :action :game/set-difficulty
                     :value :expert
                     :selected-path [:game :settings :mode]}
                    {:label "&Custom..."
                     :type :option
                     :action :game/set-difficulty
                     :value :custom
                     :selected-path [:game :settings :mode]}
                    :separator
                    {:label "&Marks (?)"
                     :type :toggle
                     :action :preferences/toggle-marks
                     :selected-path [:preferences :marks?]}
                    {:label "Co&lor"
                     :type :toggle
                     :action :preferences/toggle-color
                     :selected-path [:preferences :color?]}
                    :separator
                    {:label "Best &Times..."
                     :action :action/show-highscores}
                    :separator
                    {:label "E&xit"
                     :action :game/quit}]}
           {:label "&Edit"
            :settings {:shortcuts {:render false}}
            :items [{:label "&Undo move"}]}
           {:label "&View"
            :items [{:label "&Game board"}
                    {:label "&Highscores"
                     :action :action/show-highscores
                     :shortcut [:key/shift :key/f5]}]}
           {:label "&Help"
            :settings {:shortcuts {:render false}}
            :items [{:label "&About"
                     :action :help/about}]}]})

(defun restart-game [state ctx settings]
  (let [new-state (assoc state :game (gl/new-game-state settings))]
    (ui/replace-child! (:view ctx) "game" (make-game-mode settings))
    new-state))



;; Game Layout mode

(defmode game-mode
  {:update (fn [state ctx]
             (assoc-in state [:counters :timer] (min 999 (int (/ (- (epoch-ms) (:start-time state)) 1000)))))
   :class :ui/panel
   :style {:padding 6
           :border {:thickness 3
                    :line-style :bevel
                    :color win/panel-shadow
                    :right {:trim [1 0]}
                    :bottom {:trim [0 1]}
                    :top {:color c/WHITE}
                    :left {:color c/WHITE}}}
   :children [{:mode 'status-panel
               :state {:counters (ui/bind-state :counters)
                       :face (ui/bind-state :face)}}
              {:mode 'board-mode
               :state {:board (ui/bind-state :board)
                       :board-mask (ui/bind-state :board-mask)
                       :settings (ui/bind-state :settings)
                       :face (ui/bind-state :face)}
               :style {:margin {:t 6}
                       :border {:thickness 3
                                :line-style :bevel
                                :color win/panel-shadow
                                :bottom {:color c/WHITE :trim [0 1]}
                                :right {:color c/WHITE :trim [1 0]}}}}]
   :on {:cell/click (fn [state event ctx]
                      (let [payload (:payload event)]
                        (gl/reveal-board-cell state (:y payload) (:x payload))))
        :cell/toggle-flag (fn [state event ctx]
                            (let [payload (:payload event)
                                  flag-state (get-in state [:board-mask (:y payload) (:x payload) :flagged?])
                                  new-state (assoc-in state [:board-mask (:y payload) (:x payload) :flagged?]
                                                      (not flag-state))]
                              (assoc-in new-state [:counters :mines-left]
                                        (max 0 (- (-> state :settings :mines)
                                                  (reduce (:board-mask new-state)
                                                          0
                                                          (fn [num row]
                                                            (+ num
                                                               (count (filter row (fn [cell] (:flagged? cell))))))))))))}})

(defun make-game-mode [& settings]
  (merge {:mode 'game-mode
          :id "game"
          :state (ui/bind-state :game)}
         (if settings
           {:children [{:mode 'status-panel
                        :state {:counters (ui/bind-state :counters)
                                :face (ui/bind-state :face)}}
                       (board/make-board-child settings)]}
           {})))



(defmode window-mode
  {:focusable true
   :init (fn [state ctx]
           (merge state
                  {:game (gl/new-game-state (merge {:mode :beginner}
                                                   (get gl/difficulty-settings :beginner)))
                   :preferences {:marks? true
                                 :color? true}}))
   :action-map menu-keymap
   :children [(merge {:id "menu"}
                     (menu/make-menu {:game (ui/bind-state :game)
                                      :preferences (ui/bind-state :preferences)}
                                     menu-definition
                                     menu-keymap))
              (make-game-mode)]
   :on {:game/new-game (fn [state event ctx]
                         (restart-game state ctx (-> state :game :settings)))
        :action/show-highscores (fn [state event ctx]
                                  (ui/emit! (:view ctx) :action/show-highscores)
                                  state)
        :game/quit (fn [state event ctx]
                     (quit!))
        :menu/select (fn [state event ctx]
                       (case (-> event :payload :action)
                         :game/new-game
                         (restart-game state ctx (-> state :game :settings))

                         :game/set-difficulty
                         (let [difficulty (-> event :payload :value)]
                           (restart-game state
                                         ctx
                                         (merge {:mode difficulty}
                                                (get gl/difficulty-settings difficulty))))

                         :preferences/toggle-marks
                         (assoc-in state
                                   [:preferences :marks?]
                                   (not (-> state :preferences :marks?)))

                         :preferences/toggle-color
                         (assoc-in state
                                   [:preferences :color?]
                                   (not (-> state :preferences :color?)))

                         :action/show-highscores
                         (do
                           (ui/emit! (:view ctx) :action/show-highscores)
                           state)

                         :game/quit
                         (quit!)

                         :default
                         state))}})




(defmode main-mode
  {:init (fn [state ctx]
           {:highscores {:beginner {:difficulty-name "Beginner"
                                    :time 6
                                    :player-name "Nisse"}
                         :intermediate {:difficulty-name "Intermediate"
                                        :time 32
                                        :player-name "Korven"}
                         :expert {:difficulty-name "Expert"
                                  :time 114
                                  :player-name "Herr Anka"}}})
   :style {:background win/teal}
   :on {:action/show-highscores (fn [state event ctx]
                                  (push-mode! 'highscores-modal
                                              {:highscores (:highscores state)})
                                  state)}
   :children [(w/make {:position {:x 24 :y 20}
                       :title-bar {:title "Minesweeper"}
                       :init (fn [state ctx]
                               (merge state
                                      {:game (gl/new-game-state (merge {:mode :beginner}
                                                                       (get gl/difficulty-settings :beginner)))
                                       :preferences {:marks? true
                                                     :color? true}}))
                       :body [{:mode 'window-mode
                               :state {:highscores (ui/bind-state :highscores)}}]})
              ;; (w/make {:position {:x 100 :y 100}
              ;;          :title-bar {:title "New Highscore"}
              ;;          :body [{:mode 'new-highscore-window
              ;;                  :state {:difficulty-name "beginner"}}]})
              ]})
