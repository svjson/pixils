(ns pixils.examples.minesweeper.core
  (:require pixils
            [pixils.render :as r]
            [pixils.color :as c]
            [pixils.point :as pt]
            [pixils.ui :as ui]
            pixils.examples.minesweeper.container
            pixils.examples.minesweeper.button
            [pixils.examples.minesweeper.game-logic :as gl]
            [pixils.examples.minesweeper.status-panel :as status-panel]
            [pixils.examples.minesweeper.board :as board]
            [pixils.examples.minesweeper.menu :as menu]
            [pixils.examples.minesweeper.win :as win]
            [pixils.examples.minesweeper.win95 :as win95]))

(defprogram minesweeper
  {:display {:resolution {:scale 3}}
   :target-frame-rate 0
   :theme 'windows-95
   :initial-mode 'main-mode})



;; Game Layout mode

(defmode game-mode
  {:update (fn [state ctx]
             (assoc-in state [:counters :timer] (min 999 (int (/ (- (epoch-ms) (:start-time state)) 1000)))))
   :class :ui/panel
   :style {:padding 6
           :border {:thickness 3
                    :line-style :bevel
                    :color win/panel-shadow
                    :right {:trim [1 0]}
                    :bottom {:trim [0 1]}
                    :top {:color c/WHITE}
                    :left {:color c/WHITE}}}
   :children [{:mode 'status-panel
               :state {:counters (ui/bind-state :counters)
                       :face (ui/bind-state :face)}
               :style {:border {:thickness 2
                                :line-style :bevel
                                :color win/panel-shadow
                                :bottom {:color c/WHITE :trim [0 1]}
                                :right {:color c/WHITE :trim [1 0]}}}}
              {:mode 'board-mode
               :state {:board (ui/bind-state :board)
                       :board-mask (ui/bind-state :board-mask)
                       :face (ui/bind-state :face)}
               :style {:margin {:t 6}
                       :border {:thickness 3
                                :line-style :bevel
                                :color win/panel-shadow
                                :bottom {:color c/WHITE :trim [0 1]}
                                :right {:color c/WHITE :trim [1 0]}}}}]
   :on {:cell/click (fn [state event ctx]
                      (let [payload (:payload event)]
                        (gl/reveal-board-cell state (:y payload) (:x payload))))
        :cell/toggle-flag (fn [state event ctx]
                            (let [payload (:payload event)
                                  flag-state (get-in state [:board-mask (:y payload) (:x payload) :flagged?])
                                  new-state (assoc-in state [:board-mask (:y payload) (:x payload) :flagged?]
                                                      (not flag-state))]
                              (assoc-in new-state [:counters :mines-left]
                                        (max 0 (- (-> state :settings :mines)
                                                  (reduce (:board-mask new-state)
                                                          0
                                                          (fn [num row]
                                                            (+ num
                                                               (count (filter row (fn [cell] (:flagged? cell))))))))))))
        :game/new-game (fn [state event ctx]
                         (gl/new-game-state (:settings state)))}})




(defmode window-mode
  {:init (fn [state ctx]
           (merge state
                  {:game (gl/new-game-state (merge {:mode :beginner}
                                                   (get gl/difficulty-settings :beginner)))
                   :preferences {:marks? true
                                 :color? true}}))
   :style {:border {:thickness 1
                    :color c/BLACK}}
   :children [{:mode 'menu-bar-mode
               :state {:game (ui/bind-state :game)
                       :preferences (ui/bind-state :preferences)}
               :on {:menu/select (fn [state event ctx]
                                   (case (-> event :payload :key)
                                     :game/new-game
                                     (update state :game (fn [game-state]
                                                           (gl/new-game-state (:settings game-state))))

                                     :game/difficulty
                                     (update state :game (fn [game-state]
                                                           (let [difficulty (-> event :payload :value)]
                                                             (gl/new-game-state (merge {:mode difficulty}
                                                                                       (get gl/difficulty-settings difficulty))))))

                                     :default
                                     state))}}
              {:mode 'game-mode
               :state (ui/bind-state :game)}]})




(defmode main-mode
  {:style {:background win/teal}
   :children [{:mode 'window-mode}]})
