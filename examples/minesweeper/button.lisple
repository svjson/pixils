(ns pixils.examples.minesweeper.button
  (:require pixils
            [pixils.color :as c]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.examples.minesweeper.win :as win]))

(defcomponent button-inner {:style {:width :fill
                                    :height :fill}
                            :children [{:mode 'text-node
                                        :style {:padding {:t 4 :l 4 :r 4 :b 2}}
                                        :state {:value (ui/bind-state :label)}}]
                            :render (fn [state {:keys [view] :as ctx}]
                                      (let [bw (-> view :bounds :w)
                                            bh (-> view :bounds :h)
                                            pressed (:pressed state)
                                            offset (if pressed 1 0)]
                                        (when (keyword? (:image state))
                                          (r/image! (:image state) {:x 0 :y 0}))))})

(defcomponent button {:init (fn [state ctx]
                              (update state :pressed (fn [pressed] pressed)))
                      :update (fn [state {:keys [view] :as ctx}]
                                (assoc state :pressed
                                       (and (not (:inhibit-pressed? state))
                                            (or (:force-pressed? state)
                                                (and (contains? (-> view :interaction :pressed) :left)
                                                     (-> view :interaction :hovered))))))
                      :children [{:mode 'button-inner
                                  :state {:pressed (ui/bind-state :pressed)
                                          :image (ui/bind-state :image)
                                          :label (ui/bind-state :label)}}]})

