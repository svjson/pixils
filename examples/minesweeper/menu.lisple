(ns pixils.examples.minesweeper.menu
  (:require pixils
            [pixils.color :as c]
            [pixils.ui :as ui]
            [pixils.render :as r]))


;; Menu item component

(defcomponent menu-item
  {:class :menu/item
   :on-mouse-down (fn [state event ctx]
                    (push-mode!
                     'popup-menu
                     {}
                     {:children [{:mode 'popup-menu-outer
                                  :style {:position :absolute
                                          :width :shrink
                                          :height :shrink
                                          :left (-> ctx :view :bounds :x)
                                          :top (+ (-> ctx :view :bounds :y)
                                                  (-> ctx :view :bounds :h))}
                                  :children [{:mode 'popup-menu-inner
                                              :style {}
                                              :children (for-indexed [n item (:items state)]
                                                                     (merge (make-menu-item item)
                                                                            {:style {:width :fill}}))}]}]})
                    state)
   :children [{:mode 'text-node
               :state {:value (ui/bind-state :text)}}]})

(defcomponent menu-option-indicator
  {:class :menu/option-indicator})

(defcomponent menu-option-item
  {:class :menu/item
   :style {:layout {:direction :row}}
   :children [{:mode 'menu-option-indicator
               :state {:value false}}
              {:mode 'text-node
               :state {:value (ui/bind-state :text)}}]})

(defcomponent menu-separator {})



;; Menu bar

(def menu-items [{:title "File" :items [{:title "New"}
                                        :separator
                                        {:title "Beginner"
                                         :type :option
                                         :group "difficulty"}
                                        {:title "Intermediate"
                                         :type :option
                                         :group "difficulty"}
                                        {:title "Expert"
                                         :type :option
                                         :group "difficulty"}
                                        {:title "Custom..."
                                         :type :option
                                         :group "difficulty"}
                                        :separator
                                        {:title "Marks (?)"}
                                        {:title "Color"}
                                        :separator
                                        {:title "Best Times..."}
                                        :separator
                                        {:title "Exit"}]}
                 {:title "Edit" :items [{:title "Undo move"}]}
                 {:title "View" :items [{:title "Game board"}
                                        {:title "Highscores"}]}
                 {:title "Help" :items [{:title "About"}]}])

(defun make-menu-item [item]
  (cond
    (= :separator item)
    {:mode 'menu-separator}

    (= (:type item) :option)
    {:mode 'menu-option-item
     :state {:text (:title item)
             :selected false}}

    :default
    {:mode 'menu-item
     :state {:text (:title item)
             :items (:items item)}}))

(defmode menu-bar-mode
  {:style {:width :fill
           :layout {:direction :row}}
   :children (for-indexed [n item menu-items]
                          (merge (make-menu-item item)
                                 {:style {:padding [2 8]}}))})


;; Popup menu mode

(defmode popup-menu {:update (fn [state ctx]
                               (when (:mouse-button-down ctx)
                                 (pop-mode!))
                               state)
                        :compose {:render :pass}})

(defmode popup-menu-outer {})

(defmode popup-menu-inner {})
