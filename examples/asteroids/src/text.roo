(ns asteroids.text
  (:require [pixils.point :as pt]
            [pixils.render :as r]))

(def top-round-cap [{:x 7 :y 2}
                {:x 5 :y 0}
                {:x 2 :y 0}
                {:x 0 :y 2}])

(def top!>---< [{:x 5 :y 0}
                {:x 2 :y 0}])

(def top-left-cap [{:x 7 :y 2}
                {:x 5 :y 0}
                {:x 0 :y 0}])

(def top-right-cap [{:x 7 :y 0}
                {:x 2 :y 0}
                {:x 0 :y 2}])


(def low-round-cap [{:x 7 :y 7}
                {:x 5 :y 9}
                {:x 2 :y 9}
                {:x 0 :y 7}])

(def low-center-line [{:x 5 :y 9}
                {:x 2 :y 9}])

(def low-flat-line [{:x 0 :y 9}
                {:x 7 :y 9}])

(def low-left-cap [{:x 7 :y 7}
                {:x 5 :y 9}
                {:x 0 :y 9}])

(def mid!----- [{:x 0 :y 4}
                {:x 7 :y 4}])

(def mid!----< [{:x 0 :y 4}
                {:x 4 :y 4}])

(def mid-left-line-lower [{:x 0 :y 5}
                {:x 4 :y 5}])

(def mid-right-bend [{:x 0 :y 5}
                {:x 5 :y 5}
                {:x 7 :y 3}
                {:x 7 :y 2}])

(def top-left-stem [{:x 2 :y 0}
                {:x 0 :y 2}])

(def top-right-stem [{:x 7 :y 2}
                {:x 5 :y 0}])


(def top!|<<<< [{:x 0 :y 0}
                {:x 0 :y 2}])

(def mid!|<<<< [{:x 0 :y 2}
                {:x 0 :y 7}])

(def low!|<<<< [{:x 0 :y 7}
                {:x 0 :y 9}])

(def top!>>|<< [{:x 4 :y 0}
                {:x 4 :y 2}])

(def mid!>>|<< [{:x 4 :y 2}
                {:x 4 :y 7}])

(def mid-right-diag-down [{:x 5 :y 5}
                {:x 7 :y 7}])

(def mid-right-diag-up [{:x 4 :y 6}
                {:x 7 :y 3}])

(def mid-left-diag-down[{:x 0 :y 2}
               {:x 3 :y 5}])


(def low!>>|<< [{:x 4 :y 7}
                {:x 4 :y 9}])

(def top!>>>>| [{:x 7 :y 0}
                {:x 7 :y 2}])

(def mid!>>>>| [{:x 7 :y 2}
                {:x 7 :y 7}])

(def low!>>>>| [{:x 7 :y 7}
                {:x 7 :y 9}])

(def low-right-stem [{:x 5 :y 9}
                {:x 7 :y 7}])

(def ring [{:x 1 :y 0}
           {:x 0 :y 1}
           {:x 1 :y 2}
           {:x 2 :y 1}])

(def VECTOR-CHARS
  {'0' [[{:x 7 :y 2}
         {:x 5 :y 0}
         {:x 2 :y 0}
         {:x 0 :y 2}

         {:x 0 :y 7}
         {:x 2 :y 9}
         {:x 5 :y 9}
         {:x 7 :y 7}

         {:x 7 :y 2}]
        [{:x 6 :y 1}
         {:x 1 :y 8}]]

   '1' [[{:x 3 :y 1}
         {:x 4 :y 0}
         {:x 4 :y 9}]
        [{:x 2 :y 9}
         {:x 6 :y 9}]]

   '2' [[{:x 0 :y 2}
         {:x 2 :y 0}
         {:x 5 :y 0}
         {:x 7 :y 2}
         {:x 7 :y 3}

         {:x 0 :y 9}
         {:x 7 :y 9}]]

   '3' [[{:x 0 :y 2}
         {:x 2 :y 0}
         {:x 5 :y 0}
         {:x 7 :y 2}
         {:x 7 :y 3}
         {:x 6 :y 4}

         {:x 7 :y 7}
         {:x 5 :y 9}
         {:x 2 :y 9}
         {:x 0 :y 7}]
        [{:x 6 :y 4}
         {:x 3 :y 4}]]

   '4' [[{:x 0 :y 0}
         {:x 0 :y 4}
         {:x 7 :y 4}]
        [{:x 7 :y 0}
         {:x 7 :y 9}]]

   '5' [[{:x 7 :y 0}
         {:x 0 :y 0}

         {:x 0 :y 3}
         {:x 5 :y 3}
         {:x 7 :y 5}

         {:x 7 :y 7}
         {:x 5 :y 9}
         {:x 2 :y 9}
         {:x 0 :y 7}]]

   '6' [[{:x 7 :y 2}
         {:x 5 :y 0}
         {:x 2 :y 0}
         {:x 0 :y 2}
         {:x 0 :y 7}

         {:x 0 :y 7}
         {:x 2 :y 9}
         {:x 5 :y 9}
         {:x 7 :y 7}

         {:x 7 :y 6}
         {:x 5 :y 4}
         {:x 2 :y 4}
         {:x 0 :y 6}]]

   '7' [[{:x 0 :y 0}
         {:x 7 :y 0}
         {:x 7 :y 9}]]

   '8' [[{:x 7 :y 2}
         {:x 5 :y 0}
         {:x 2 :y 0}
         {:x 0 :y 2}
         {:x 2 :y 4}
         {:x 5 :y 4}
         {:x 7 :y 2}]
        [{:x 2 :y 4}
         {:x 0 :y 6}
         {:x 0 :y 7}
         {:x 2 :y 9}
         {:x 5 :y 9}
         {:x 7 :y 7}
         {:x 7 :y 6}
         {:x 5 :y 4}]]


   '9' [[{:x 0 :y 7}
         {:x 2 :y 9}
         {:x 5 :y 9}
         {:x 7 :y 7}
         {:x 7 :y 2}

         {:x 7 :y 2}
         {:x 5 :y 0}
         {:x 2 :y 0}
         {:x 0 :y 2}

         {:x 0 :y 2}
         {:x 2 :y 5}
         {:x 5 :y 5}
         {:x 7 :y 3}]]

   'A' [top-round-cap
        mid!|<<<<
        mid!>>>>|
        mid!-----
        low-right-stem
        low!|<<<<]

   'C' [top-round-cap
        mid!|<<<<
        low-round-cap]

   'D' [top-left-cap
        top!|<<<<
        mid!|<<<<
        low!|<<<<
        mid!>>>>|
        low-left-cap]

   'E' [top-round-cap
        mid!|<<<<
        low!|<<<<
        low-left-cap
        mid-left-line-lower]

   'G' [top-round-cap
        mid!|<<<<
        mid-right-diag-down
        low-round-cap]

   'H' [top-left-stem
        top!>>>>|
        mid!|<<<<
        mid!>>>>|
        mid!-----
        low!|<<<<
        low-right-stem]

   'I' [top!>---<
        top!>>|<<
        mid!>>|<<
        low!>>|<<
        low-center-line
        [{:x 5 :y 0} {:x 6 :y 0}]
        [{:x 5 :y 9} {:x 6 :y 9}]]

   'L' [top-left-stem
        mid!|<<<<
        low!|<<<<
        low-flat-line]

   'M' [top-right-cap
        top!>>>>|
        top!>>|<<
        mid!|<<<<
        mid!>>|<<
        mid!>>>>|
        low!|<<<<
        low-right-stem]

   'O' [top-round-cap
        mid!|<<<<
        mid!>>>>|
        low-round-cap]

   'P' [top-left-cap
        top!|<<<<
        mid-right-bend
        mid!|<<<<
        low!|<<<<]

   'R' [top-left-cap
        top!|<<<<
        mid-right-bend
        mid!|<<<<
        low!|<<<<
        [{:x 3 :y 5}
         {:x 7 :y 9}]]
   'S' [top-round-cap
        [{:x 0 :y 2}
         {:x 7 :y 7}]
        low-round-cap]

   'T' [top-right-cap
        top!>>|<<
        mid!>>|<<
        low!>>|<<]

   'U' [top-left-stem
        top!>>>>|
        mid!|<<<<
        mid!>>>>|
        low-round-cap]

   'V' [[{:x 2 :y 0}
         {:x 0 :y 2}
         {:x 0 :y 7}
         {:x 2 :y 9}
         {:x 7 :y 4}
         {:x 7 :y 0}]]

   'W' [top-left-stem
        top!>>>>|
        mid!|<<<<
        mid!>>|<<
        mid!>>>>|
        low!|<<<<
        low!>>|<<
        low-left-cap]

   'Y' [top-left-stem
        top!>>>>|
        mid-left-diag-down
        mid-right-diag-up
        low!>>|<<
        low-center-line
        [{:x 5 :y 9} {:x 6 :y 9}]]

   ':' [(for [p ring] (pt/+ p {:x 3 :y 2}))
        (for [p ring] (pt/+ p {:x 3 :y 6}))]
   '!' [[(head top!>>|<<)
         (pt/+ (head top!>>|<<) {:x 0 :y 5})]
        (for [p ring] (pt/+ p {:x 3 :y 7}))]})


(defun print! [{:keys [pos text scale rotation color]}]
  (let [crsr pos
        scale (or scale 1.0)]
    (for [ch text]
      (for [poly (get VECTOR-CHARS ch)]
        (r/polygon! poly {:offset (pt/+ crsr
                                        {:x (- 4 (* 4 scale))
                                         :y (- 5 (* 5 scale))})
                          :color color
                          :rotation rotation
                          :scale scale}))
      (set! [crsr] (pt/+ crsr {:x (* 9 scale) :y 0})))))
