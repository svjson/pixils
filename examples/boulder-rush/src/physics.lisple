(ns boulder-rush.physics
  (:require [boulder-rush.explosion :as explosion]
            [boulder-rush.grid :as grid]
            [boulder-rush.level.map :as level-map]
            [pixils.state.timer :as timer]
            [pixils.tilemap.model :as tilemap]
            [pixils.point :as pt]))

(def falling-wait-interval-ms 100)
(def falling-interval-ms 160)
(def falling-tiles [:boulder :gem])
(def down {:x 0 :y 1})
(def left {:x -1 :y 0})
(def right {:x 1 :y 0})

(defun falling-tile? [tile-id]
  (contains? falling-tiles tile-id))

(defun event-source? [level-map pos]
  (and (tilemap/in-bounds? level-map pos)
       (falling-tile? (level-map/cell-at level-map pos))))

(defun events-around [level-map pos]
  (map (filter (grid/adjacent-points pos)
               (fn [candidate]
                 (event-source? level-map candidate)))
       (fn [pos]
         {:pos pos
          :state :candidate
          :timer (timer/make {:interval-ms falling-wait-interval-ms})})))

(defun map-points [level-map]
  (reduce (dotimes [y (:height level-map)]
            (dotimes [x (:width level-map)]
              {:x x :y y}))
          []
          (fn [out row]
            (concat out row))))

(defun events [level-map]
  (map (filter (map-points level-map)
               (fn [pos]
                 (event-source? level-map pos)))
       (fn [pos]
         {:pos pos
          :state :candidate
          :timer (timer/make {:interval-ms falling-wait-interval-ms})})))

(defun fall-target [pos]
  (pt/+ pos down))

(defun roll-target [pos dir]
  (pt/+ pos dir))

(defun roll-support-target [pos dir]
  (pt/+ (roll-target pos dir) down))

(defun player-cell? [level-map pos]
  (and (tilemap/in-bounds? level-map pos)
       (= :player-default (level-map/cell-at level-map pos))))

(defun empty-cell? [level-map pos]
  (and (tilemap/in-bounds? level-map pos)
       (= :empty (level-map/cell-at level-map pos))))

(defun can-fall? [level-map pos]
  (and (falling-tile? (level-map/cell-at level-map pos))
       (empty-cell? level-map (fall-target pos))))

(defun can-roll? [level-map pos dir]
  (and (falling-tile? (level-map/cell-at level-map pos))
       (contains? [:boulder :gem :barrier :wall]
                  (level-map/cell-at level-map (fall-target pos)))
       (empty-cell? level-map (roll-target pos dir))
       (empty-cell? level-map (roll-support-target pos dir))))

(defun movement-target [level-map pos]
  (cond
    (can-fall? level-map pos)
    (fall-target pos)

    (can-roll? level-map pos left)
    (roll-target pos left)

    (can-roll? level-map pos right)
    (roll-target pos right)

    :default
    nil))

(defun next-event-for-move [target]
  {:pos target
   :state :falling
   :timer (timer/make {:interval-ms falling-interval-ms})})

(defun exclude-pos [events pos]
  (filter events
          (fn [candidate]
            (not (= (:pos candidate) pos)))))

(defun exposed-events-around [level-map pos target]
  (exclude-pos (events-around level-map pos)
               target))

(defun falling-on-player? [level-map current-event]
  (let [pos (:pos current-event)]
    (and (= :falling (:state current-event))
         (falling-tile? (level-map/cell-at level-map pos))
         (player-cell? level-map (fall-target pos)))))

(defun evaluate-impact [state current-event]
  (let [result (explosion/start (:level-map state)
                                (fall-target (:pos current-event)))]
    (assoc state
           :level-map (:level-map result)
           :explosions (concat (:explosions state)
                               [(:pos (:event result))])
           :events (concat (:events state)
                           [(:event result)]))))

(defun evaluate-explosion-event [state current-event]
  (let [result (explosion/advance (:level-map state) current-event)]
    (assoc state
           :level-map (:level-map result)
           :events (if (:event result)
                     (concat (:events state) [(:event result)])
                     (:events state)))))

(defun evaluate-move [state current-event target]
  (let [pos (:pos current-event)]
    (let [tile-id (level-map/cell-at (:level-map state) pos)
          next-map (level-map/move-cell (:level-map state) pos target)
          next-event (next-event-for-move target)]
      (assoc state
             :level-map next-map
             :moved-to (concat (:moved-to state) [target])
             :moved-tiles (concat (:moved-tiles state) [tile-id])
             :events (concat (:events state)
                             [next-event]
                             (exposed-events-around next-map pos target))))))

(defun evaluate-movement [state current-event]
  (let [pos (:pos current-event)
        target (movement-target (:level-map state) pos)]
    (if target
      (evaluate-move state current-event target)
      state)))

(defun evaluate-event [state current-event]
  (let [pos (:pos current-event)]
    (cond
      (contains? (:moved-to state) pos)
      state

      (= :explosion (:state current-event))
      (evaluate-explosion-event state current-event)

      (falling-on-player? (:level-map state) current-event)
      (evaluate-impact state current-event)

      :default
      (evaluate-movement state current-event))))
