(ns boulder-rush.sounds
  (:require pixils
            [pixils.audio :as audio]))

(defbundle boulder-rush-sfx
  {:sounds {:gem "../assets/gem.wav"
            :dig "../assets/dig.wav"
            :boulder "../assets/boulder.wav"
            :explosion "../assets/explosion.wav"}})

(defun play-game-event-sounds [state]
  (when (contains? (or (:moved-tiles state) []) :boulder)
    (audio/play! :boulder-rush-sfx/boulder {:volume 0.1}))
  (when (or (:play-explosion-sound? state)
            (not (empty? (or (:explosions state) []))))
    (audio/play! :boulder-rush-sfx/explosion {:volume 0.1}))
  (dissoc state :moved-tiles
                :explosions
                :play-explosion-sound?))

(defun play-player-movement-sound [entered-tile]
  (case entered-tile
    :gem (audio/play! :boulder-rush-sfx/gem {:volume 0.1})
    :dirt (audio/play! :boulder-rush-sfx/dig {:volume 0.1})
    :default nil))
