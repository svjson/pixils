(ns boulder-rush.game-mode
  (:require pixils
            [pixils.audio :as audio]
            [boulder-rush.camera :as camera]
            [boulder-rush.event :as event]
            [boulder-rush.player :as pl]
            [boulder-rush.physics :as physics]
            [boulder-rush.level.loader :as level-loader]
            [pixils.state.timer :as timer]
            [pixils.tilemap.renderer :as tilemap-renderer]))

(defun play-physics-sounds [state]
  (when (contains? (or (:moved-tiles state) []) :boulder)
    (audio/play! :boulder-rush-sfx/boulder {:volume 0.1}))
  (when (not (empty? (or (:explosions state) [])))
    (audio/play! :boulder-rush-sfx/explosion {:volume 0.1}))
  (dissoc (dissoc state :moved-tiles) :explosions))

(defun move-player [state dir]
  (if (timer/ticked? (-> state :player :move-timer))
    (let [player-pos (-> state :player :pos)
          result (pl/move-player (:level-map state) (:player state) dir)]
      (if (empty? result)
        state
        (do
          (case (:entered-tile result)
            :gem (audio/play! :boulder-rush-sfx/gem {:volume 0.1})
            :dirt (audio/play! :boulder-rush-sfx/dig {:volume 0.1})
            :default nil)
          (let [state (merge state (dissoc result :entered-tile))]
            (assoc state
                   :events (event/upsert-many (:events state)
                                              (physics/events-around (:level-map state)
                                                                     player-pos))
                   :player (pl/begin-walk (:player state) dir))))))
    state))

(defmode game-mode
  {:init (fn [state ctx]
           (let [level (or (:level state) 1)
                 map (level-loader/level-map state level)]
             {:level level
              :level-map map
              :tile-offset {:x 0 :y 0}
              :offset {:x 0 :y 0}
              :tileset (level-loader/level-tileset state level)
              :events (physics/events map)
              :player (pl/make (reduce (-> map :layers head :tiles)
                                      {:x nil :y 0}
                                      (fn [coord row]
                                        (case (:x coord)
                                          nil
                                          (if-let [x (find-index row (fn [cell] (= :player-default cell)))]
                                          (assoc coord :x x)
                                          (update coord :y inc))

                                        :default
                                        coord))))}))

   :on-key-held {:key/up
                 (fn [state e ctx]
                   (move-player state {:x 0 :y -1}))

                 :key/right
                 (fn [state e ctx]
                   (move-player state {:x 1 :y 0}))

                 :key/down
                 (fn [state e ctx]
                   (move-player state {:x 0 :y 1}))

                 :key/left
                 (fn [state e ctx]
                   (move-player state {:x -1 :y 0}))}

   :update (fn [state ctx]
             (-> state
                 (pl/update-player)
                 (assoc :events (event/tick-many (:events state)))
                 (event/update-physics)
                 (play-physics-sounds)
                 (camera/update-offset (:buffer-size ctx))))

   :render (fn [state ctx]
             (tilemap-renderer/render-map! (:level-map state)
                                           (:tileset state)
                                           {:offset (:offset state)
                                            :tile-substitutions (if (-> state :player :walking?)
                                                                  {:player-default {:tile (-> state :player :walk-tile)
                                                                                    :render-opts (-> state :player :render-opts)}}
                                                                  {})}))})
