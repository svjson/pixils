(ns boulder-rush.game-mode
  (:require pixils
            pixils.tilemap.render
            [pixils.tilemap.renderer :as tilemap-renderer]
            [boulder-rush.camera :as camera]
            [boulder-rush.level.index :as caves]
            [boulder-rush.event :as event]
            [boulder-rush.player :as pl]
            [boulder-rush.physics :as physics]
            [boulder-rush.status-hud :as hud]
            [boulder-rush.sounds :as sound]
            [boulder-rush.level.loader :as level-loader]
            [pixils.state.timer :as timer]))

(def empty-flash-interval-ms 150)
(def exit-flash-interval-ms 200)
(def start-phase-duration-ms 4500)

(defun held-direction [held-keys]
  (cond
    (contains? held-keys :key/up)
    {:x 0 :y -1}

    (contains? held-keys :key/right)
    {:x 1 :y 0}

    (contains? held-keys :key/down)
    {:x 0 :y 1}

    (contains? held-keys :key/left)
    {:x -1 :y 0}

    :default
    nil))

(defun fire-held? [held-keys]
  (or (contains? held-keys :key/ctrl)
      (contains? held-keys :key/left-ctrl)
      (contains? held-keys :key/right-ctrl)))

(defun gem-value [state]
  (if (>= (-> state :gems :collected)
          (-> state :gems :required))
    (-> state :gems :bonus-value)
    (-> state :gems :value)))

(defun apply-player-result [state result]
  (let [entered-tile (:entered-tile result)
        moved-tiles (:moved-tiles result)
        changed-positions (:changed-positions result)
        result (dissoc result :entered-tile)
        result (dissoc result :changed-positions)
        state (merge state (dissoc result :moved-tiles))
        state (if (= :gem entered-tile)
                (let [collected (-> state :gems :collected)
                      score (+ (or (-> state :player :score) 0)
                               (gem-value state))
                      state (if (and (< collected (-> state :gems :required))
                                     (>= (inc collected) (-> state :gems :required)))
                              (assoc state
                                     :play-explosion-sound? true
                                     :empty-flash-timer (timer/make {:interval-ms empty-flash-interval-ms}))
                              state)]
                  (-> state
                    (update-in [:gems :collected] inc)
                    (assoc-in [:player :score] score)))
                state)
        state (if (empty? (or moved-tiles []))
                state
                (assoc state
                       :moved-tiles (concat (or (:moved-tiles state) [])
                                            moved-tiles)))]
    (sound/play-player-movement-sound entered-tile)
    (if (empty? (or changed-positions []))
      state
      (assoc state
             :events (reduce (or changed-positions [])
                             (:events state)
                             (fn [events pos]
                               (event/upsert-many events
                                                  (physics/events-around (:level-map state)
                                                                         pos))))))))

(defun handle-player-input [state ctx]
  (let [held-keys (or (:held-keys ctx) [])
        dir (held-direction held-keys)]
    (apply-player-result state
                         (if dir
                           (if (fire-held? held-keys)
                             (pl/fire (:level-map state)
                                      (:player state)
                                      dir)
                             (pl/apply-intent (:level-map state)
                                              (:player state)
                                              dir))
                           {:player (pl/release-input (:player state))}))))

(defun update-remaining-time [state]
  (let [timer (timer/tick (:remaining-time-timer state))]
    (assoc state
           :remaining-time-timer timer
           :remaining-time (if (timer/ticked? timer)
                             (max 0 (- (:remaining-time state) 1))
                             (:remaining-time state)))))

(defun update-empty-flash [state]
  (if (:empty-flash-timer state)
    (let [timer (timer/tick (:empty-flash-timer state))]
      (if (timer/ticked? timer)
        (dissoc state :empty-flash-timer)
        (assoc state :empty-flash-timer timer)))
    state))

(defun update-exit-flash [state]
  (if (>= (-> state :gems :collected)
          (-> state :gems :required))
    (let [timer (timer/tick (or (:exit-flash-timer state)
                                (timer/make {:interval-ms exit-flash-interval-ms})))
          state (assoc state
                       :exit-flash-timer timer
                       :exit-substitution (or (:exit-substitution state) :empty))]
      (if (timer/ticked? timer)
        (assoc state
               :exit-substitution (case (:exit-substitution state)
                                    :empty :barrier
                                    :default :empty))
        state))
    (dissoc (assoc state :exit-substitution :barrier)
            :exit-flash-timer)))


(defun make-cycle [interval values & opts]
  (merge {:timer (timer/make {:interval-ms interval})
          :iteration 0
          :value (head values)
          :values values}
         opts))

(defun process-cycle [{:keys [value values iteration] :as cycle}]
  (let [cycle (update cycle :timer timer/tick)]
    (if (timer/ticked? (:timer cycle))
      (let [index (find-index values (fn [val] (= val value)))]
        (assoc cycle :value (nth values (mod (inc index) (count values)))
                     :iteration (inc iteration)))
      cycle)))

(defun update-entry-tile [state]
  (let [phase-timer (timer/tick (or (:phase-timer state)
                                    (timer/make {:interval-ms start-phase-duration-ms})))
        state (assoc state :phase-timer phase-timer)
        cycle (process-cycle (or (:cycle state) (make-cycle exit-flash-interval-ms
                                                            [:empty :barrier])))
        state (-> state
                  (assoc :cycle cycle)
                  (assoc-in [:tile-substitutions :player-default] (:value cycle)))]
    (case (:phase state)
      :entry-blink
      (if (timer/ticked? phase-timer)
        (-> state
            (assoc :play-explosion-sound? true
                   :phase :player-in
                   :cycle (make-cycle 100 [:debris-1 :debris-2 :debris-3 :player-default])))
        state)

      :player-in
      (if (= :player-default (:value cycle))
        (assoc state :update phase-game)
        state)

      :default state)))

(defun tile-substitutions [state]
  (merge
   {:exit (or (:exit-substitution state) :barrier)}
   (if (:empty-flash-timer state)
     {:empty :white}
     {})
   (if (-> state :player :walking?)
     {:player-default {:tile (-> state :player :walk-tile)
                       :render-opts (-> state :player :render-opts)}}
     {})))

(defun init-level [state]
  (let [current-level (or (:current-level state) 1)
        level (nth caves/levels (dec current-level))
        map (level-loader/map-by-id state (:map-id level))
        initial-offset (:initial-offset level)
        initial-tile-offset {:x (int (/ (:x initial-offset)
                                        (:tile-size map)))
                             :y (int (/ (:y initial-offset)
                                        (:tile-size map)))}]
    {:current-level current-level
     :level level
     :level-map map
     :update phase-start
     :gems (assoc (:gems level) :collected 0)
     :remaining-time (:remaining-time level)
     :remaining-time-timer (timer/make {:interval-ms 1000})
     :tile-offset initial-tile-offset
     :offset initial-offset
     :tileset (level-loader/tileset-by-id state (:tileset-id level))
     :tile-substitutions {}
     :events (physics/events map)
     :player (pl/make (reduce (-> map :layers head :tiles)
                              {:x nil :y 0}
                              (fn [coord row]
                                (case (:x coord)
                                  nil
                                  (if-let [x (find-index row (fn [cell] (= :player-default cell)))]
                                    (assoc coord :x x)
                                    (update coord :y inc))

                                  :default
                                  coord))))}))

(defun phase-start [state ctx]
  (let [state (assoc state :phase (or (:phase state) :entry-blink)
                           :events (event/tick-many (:events state)))]
    (-> state
      (update-entry-tile)
      (event/update-physics)
      (sound/play-game-event-sounds)
      (camera/update-offset (:buffer-size ctx)))))

(defun phase-game [state ctx]
  (let [state (pl/update-player state)
        state (handle-player-input state ctx)
        state (update-empty-flash state)
        state (update-exit-flash state)
        state (update-remaining-time state)
        state (assoc state :events (event/tick-many (:events state)))]
    (-> state
        (event/update-physics)
        (sound/play-game-event-sounds)
        (camera/update-offset (:buffer-size ctx)))))


(defmode game-mode
  {:init (fn [state ctx]
           (init-level state))

   :update (fn [state ctx]
             (apply (:update state) [state ctx]))

   :render (fn [state ctx]
             (tilemap-renderer/render-map! (:level-map state)
                                           (:tileset state)
                                           {:offset (:offset state)
                                            :target-rect
                                            {:x 0
                                             :y 16
                                             :w (-> ctx :buffer-size :w)
                                             :h (- (-> ctx :buffer-size :h) 16)}
                                            :tile-substitutions (merge (:tile-substitutions state)
                                                                       (tile-substitutions state))})
             (hud/render! {:gems (assoc (:gems state) :value (gem-value state))
                           :tileset (:tileset state)
                           :score (-> state :player :score)
                           :remaining-time (-> state :remaining-time)}))})
