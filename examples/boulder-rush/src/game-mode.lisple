(ns boulder-rush.game-mode
  (:require pixils
            [boulder-rush.camera :as camera]
            [boulder-rush.player :as pl]
            [boulder-rush.physics :as physics]
            [boulder-rush.level.loader :as level-loader]
            [pixils.tilemap.renderer :as tilemap-renderer]))

(defun add-point-of-interest [state pos]
  (assoc state
         :points-of-interest (concat (or (:points-of-interest state) []) [pos])))

(defun move-player [state dir]
  (let [player-pos (-> state :player :pos)
        result (pl/move-player (:level-map state) (:player state) dir)]
    (if (empty? result)
      state
      (add-point-of-interest (merge state result) player-pos))))

(defun update-physics [state]
  (let [result (physics/evaluate-points-result (:level-map state)
                                               (:points-of-interest state))]
    (assoc state
           :level-map (:level-map result)
           :points-of-interest (:points-of-interest result))))

(defun update-game [state ctx]
  (camera/update-offset (update-physics state) (:buffer-size ctx)))

(defmode game-mode
  {:init (fn [state ctx]
           (let [level (or (:level state) 1)
                 map (level-loader/level-map state level)]
             {:level level
              :level-map map
              :tile-offset {:x 0 :y 0}
              :offset {:x 0 :y 0}
              :tileset (level-loader/level-tileset state level)
              :points-of-interest (physics/points-of-interest map)
              :player {:pos (reduce (-> map :layers head :tiles)
                                    {:x nil :y 0}
                                    (fn [coord row]
                                      (case (:x coord)
                         nil
                         (if-let [x (find-index row (fn [cell] (= :player-default cell)))]
                           (assoc coord :x x)
                           (update coord :y inc))

                       :default
                       coord)))}}))

   :on-key-down (fn [state e ctx]
                (case (:key e)
                  :key/up
                  (move-player state {:x 0 :y -1})

                  :key/right
                  (move-player state {:x 1 :y 0})

                  :key/down
                  (move-player state {:x 0 :y 1})

                  :key/left
                  (move-player state {:x -1 :y 0})

                  :default
                  state))

   :update (fn [state ctx]
             (update-game state ctx))

   :render (fn [state ctx]
             (tilemap-renderer/render-map! (:level-map state)
                                           (:tileset state)
                                           {:offset (:offset state)}))})
