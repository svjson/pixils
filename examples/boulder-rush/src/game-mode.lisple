(ns boulder-rush.game-mode
  (:require pixils
            pixils.tilemap.render
            [pixils.tilemap.renderer :as tilemap-renderer]
            [boulder-rush.cycle :as cycle]
            [boulder-rush.level.current :as level]
            [boulder-rush.status-hud :as hud]
            [boulder-rush.game.init :as init]
            [boulder-rush.game.phase.level-start :as start-phase]
            [boulder-rush.game.phase.main :as main-phase]
            [boulder-rush.game.phase.death :as death-phase]
            [boulder-rush.game.phase.level-complete :as complete-phase]))

(defmode game-mode
  {:init (fn [state ctx]
           (init/init-level state))

   :update (fn [state ctx]
             (let [update-fn (case (:phase state)
                               :phase/level-start start-phase/update
                               :phase/main main-phase/update
                               :phase/death death-phase/update
                               :phase/level-complete complete-phase/update)]
               (if update-fn
                 (apply update-fn [state ctx])
                 state)))

   :render (fn [state ctx]
             (tilemap-renderer/render-map! (:level-map state)
                                           (:tileset state)
                                           {:offset (:offset state)
                                            :target-rect
                                            {:x 0
                                             :y 16
                                             :w (-> ctx :buffer-size :w)
                                             :h (- (-> ctx :buffer-size :h) 16)}
                                            :tile-substitutions (:tile-substitutions state)})
             (hud/render! {:gems (assoc (:gems state) :value (level/gem-value state))
                           :tileset (:tileset state)
                           :score (-> state :player :score)
                           :remaining-time (-> state :remaining-time)}))})
