(ns boulder-rush.game-mode
  (:require pixils
            [pixils.point :as pt]
            [boulder-rush.camera :as camera]
            [boulder-rush.player :as pl]
            [boulder-rush.level.loader :as level-loader]
            [pixils.tilemap.renderer :as tilemap-renderer]))


(defmode game-mode
  {:init (fn [state ctx]
           (let [level (or (:level state) 1)
                 map (level-loader/level-map state level)]
             {:level level
              :level-map map
              :tile-offset {:x 0 :y 0}
              :offset {:x 0 :y 0}
              :tileset (level-loader/level-tileset state level)
              :player {:pos (reduce (-> map :layers head :tiles)
                                    {:x nil :y 0}
                                    (fn [coord row]
                                      (case (:x coord)
                         nil
                         (if-let [x (find-index row (fn [cell] (= :player-default cell)))]
                           (assoc coord :x x)
                           (update coord :y inc))

                       :default
                       coord)))}}))

   :on-key-down (fn [{:keys [player level-map] :as state} e ctx]
                (case (:key e)
                  :key/up
                  (merge state (pl/move-player level-map player {:x 0 :y -1}))

                  :key/right
                  (merge state (pl/move-player level-map player {:x 1 :y 0}))

                  :key/down
                  (merge state (pl/move-player level-map player {:x 0 :y 1}))

                  :key/left
                  (merge state (pl/move-player level-map player {:x -1 :y 0}))

                  :default
                  state))

   :update (fn [state ctx]
             (camera/update-offset state (:buffer-size ctx)))

   :render (fn [state ctx]
             (tilemap-renderer/render-map! (:level-map state)
                                           (:tileset state)
                                           {:offset (:offset state)}))})
