(ns boulder-rush.game.phase.common
  (:require [boulder-rush.camera :as camera]
            [boulder-rush.cycle :as cycle]
            [boulder-rush.event :as event]
            [boulder-rush.sounds :as sound]
            [boulder-rush.level.current :as level]
            [boulder-rush.level.index :as caves]))



;; Constants

(def BARRIER-SCROLL-INTERVAL-MS 25)



;; Animation cycle support

(defun cycle-tile-substitution [tile-ref]
  (fn [state cycle]
    (assoc-in state [:tile-substitutions tile-ref] (:value cycle))))



;; Animation Cycles

(defun barrier-scroll-cycle []
  (cycle/make BARRIER-SCROLL-INTERVAL-MS
              [:barrier]
              {:offset 0
               :iterations (* 16 12)
               :apply (fn [state cycle]
                        (if (cycle/done? cycle)
                          (dissoc-in state [:tile-substitutions :barrier])
                          (assoc-in state [:tile-substitutions :barrier]
                                          {:tile :barrier
                                           :render-opts (fn [{:keys [rect]}]
                                                          {:target (assoc rect :y (- (mod (inc (:iteration cycle)) 16 )))
                                                           :clip-rect rect
                                                           :repeat-y? true})})))}))


;; Common Phase Update Functions

(defun tick-events [state]
  (assoc state :events (event/tick-many (:events state))))

(defun update [state ctx]
  (-> state
      (cycle/process-all)
      (event/update-physics)
      (sound/play-game-event-sounds)
      (camera/update-offset (:buffer-size ctx))))
