(ns boulder-rush.game.phase.death
  (:require [pixils.state.timer :as timer]
            [boulder-rush.player :as pl]
            [boulder-rush.physics :as physics]
            [boulder-rush.game.phase.common :as common]
            [boulder-rush.level.current :as level]))


;; Constants

(def DEATH-DELAY-MS 2000)



;; Phase Functions

(defun restart-after-death [state]
  (let [base-map (:base-level-map state)
        player (pl/make (pl/player-start-pos base-map))]
    (-> state
        (assoc :phase :phase/level-start
               :level-map (level/add-start-cover base-map (:level state))
               :gems (assoc (-> state :level :gems) :collected 0)
               :remaining-time (-> state :level :remaining-time)
               :remaining-time-timer (timer/make {:interval-ms 1000})
               :tile-substitutions {:exit :barrier}
               :cycles [(common/barrier-scroll-cycle) (boulder-rush.game.phase.level-start/entry-cycle)]
               :events (physics/events base-map)
               :player (assoc player
                         :score (or (-> state :player :score) 0)
                         :lives (or (-> state :player :lives) 3)))
        (dissoc
          :death
          :player-death
          :moved-tiles
          :explosions
          :play-explosion-sound?))))

(defun update-death-cover [state]
  (if (-> state :death :filling?)
    (common/update-cover-fill state
                              :death
                              restart-after-death)
    (let [timer (timer/tick (-> state :death :timer))
          state (assoc-in state [:death :timer] timer)]
      (if (timer/ticked? timer)
        (common/begin-cover-fill state :death)
        state))))



;; Death Phase Update Function

(defun update [state ctx]
  (-> state
      (common/tick-events)
      (common/update ctx)
      (update-death-cover)))
