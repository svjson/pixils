(ns boulder-rush.init-mode
  (:require pixils
            boulder-rush.game-mode
            [boulder-rush.level.loader :as level-loader]))

(defmode init-mode
  {:init (fn [state ctx]

             (push-mode! 'game-mode
                         (assoc (level-loader/load-level-pack!)
                                :current-level 1))
             state)})
