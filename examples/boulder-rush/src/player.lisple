(ns boulder-rush.player
  (:require [pixils.point :as pt]
            [pixils.state.timer :as timer]
            [boulder-rush.level.map :as map]))

(def MOVE-INTERVAL-MS 150)
(def WALK-ANIMATION-INTERVAL-MS 150)
(def PUSH-INTERVALS-MS [100 130 160 190 220 250 280 300])

(defun make [pos]
  {:lives 3
   :pos pos
   :move-timer (timer/make {:interval-ms MOVE-INTERVAL-MS
                            :started? true
                            :last-tick-ms 0
                            :ticked? true})
   :walking? false
   :score 0
   :render-opts {}})

(defun move-player [map player dir]
  (let [player-pos (:pos player)
        target-pos (pt/+ player-pos dir)
        target-tile (map/cell-at map target-pos)]
    (if (contains? [:empty :dirt :gem] target-tile)
        {:level-map (map/move-cell map
                                   player-pos
                                   target-pos)
        :player (assoc player :pos target-pos)
        :entered-tile target-tile}
        {})))

(defun walk [player dir]
  (assoc player
         :walking? true
         :render-opts (if (contains? [{:x 0 :y -1}
                                      {:x -1 :y 0}]
                                     dir)
                        {:flip-x? true}
                        {})))

(defun begin-walk [player dir]
  (dissoc (assoc (walk player dir)
                 :move-timer (timer/make {:interval-ms MOVE-INTERVAL-MS}))
          :push))

(defun release-input [player]
  (let [player (dissoc player :push)]
    (if (and (:walking? player)
             (timer/ticked? (:move-timer player)))
      (assoc player :walking? false)
      player)))

(defun begin-push [player dir]
  (let [player (walk player dir)
        push (:push player)]
    (if (= dir (:dir push))
      player
      (assoc player
             :push {:dir dir
                    :timer (timer/make {:interval-ms (rand-nth PUSH-INTERVALS-MS)})}))))

(defun push-boulder [level-map player dir boulder-pos push-mode]
  (let [player-pos (:pos player)
        boulder-target (pt/+ boulder-pos dir)
        player-follows? (= :player-follows push-mode)
        player (begin-push player dir)]
    (if (and (timer/ticked? (-> player :push :timer))
             (= :empty (map/cell-at level-map boulder-target)))
      {:level-map (let [level-map (map/move-cell level-map boulder-pos boulder-target)]
                    (if player-follows?
                      (map/move-cell level-map player-pos boulder-pos)
                      level-map))
       :player (assoc (begin-walk player dir)
                      :pos (if player-follows?
                             boulder-pos
                             player-pos))
       :changed-positions [player-pos boulder-pos boulder-target]
       :moved-tiles [:boulder]}
      {:player player})))

(defun fire [level-map player dir]
  (let [target-pos (pt/+ (:pos player) dir)
        target-tile (map/cell-at level-map target-pos)]
    (cond
      (contains? [:dirt :gem] target-tile)
      {:level-map (map/set-cell level-map target-pos :empty)
       :player (walk (dissoc player :push) dir)
       :entered-tile target-tile
       :changed-positions [target-pos]}

      (and (= :boulder target-tile)
           (= 0 (:y dir))
           (not= 0 (:x dir)))
      (push-boulder level-map player dir target-pos :player-stays)

      :default
      {:player (walk (dissoc player :push) dir)})))

(defun apply-intent [level-map player dir]
  (let [player-pos (:pos player)
        target-pos (pt/+ player-pos dir)
        target-tile (map/cell-at level-map target-pos)]
    (cond
      (and (contains? [:empty :dirt :gem] target-tile)
           (timer/ticked? (:move-timer player)))
      (assoc (move-player level-map player dir)
             :player (begin-walk (assoc player :pos target-pos) dir)
             :changed-positions [player-pos])

      (and (= :boulder target-tile)
           (= 0 (:y dir))
           (not= 0 (:x dir)))
      (push-boulder level-map player dir target-pos :player-follows)

      :default
      {:player (release-input player)})))

(defun update-player [state]
  (let [state (-> state
                (update-in [:player :move-timer] timer/tick))
        state (if (-> state :player :push)
                (assoc-in state
                          [:player :push :timer]
                          (timer/tick (-> state :player :push :timer)))
                state)]
    state))
