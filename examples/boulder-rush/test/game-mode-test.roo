  (s/then [result]
    (is (= ["PW"]
           (fixtures/map->rows (:level-map result))))
    (is (= true
           (-> result :player :walking?)))
    (is (= {}
           (-> result :player :render-opts)))))

(deftest handle-player-input-fire-pushes-boulder-without-moving-player
  (s/given
    {:level-map (fixtures/rows->map ["PO "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)
              :push {:dir {:x 1 :y 0}
                     :timer (ready-timer)}}
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/ctrl :key/right]}))
  (s/then [result]
    (is (= ["P O"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 0 :y 0}
           (-> result :player :pos)))
    (is (= [:boulder]
           (:moved-tiles result)))))

(deftest play-game-event-sounds-clears-moved-tiles
  (s/given
    {:moved-tiles [:boulder]})
  (s/when [state]
    (sounds/play-game-event-sounds state))
  (s/then [result]
    (is (nil? (:moved-tiles result)))))

(deftest play-game-event-sounds-clears-explosions
  (s/given
    {:explosions [{:x 1 :y 1}]})
  (s/when [state]
    (sounds/play-game-event-sounds state))
  (s/then [result]
    (is (nil? (:explosions result)))))

(deftest play-game-event-sounds-clears-explicit-explosion-sound
  (s/given
    {:play-explosion-sound? true})
  (s/when [state]
    (sounds/play-game-event-sounds state))
  (s/then [result]
    (is (nil? (:play-explosion-sound? result)))))

(deftest update-remaining-time-counts-down-once-per-second
  (s/given
    {:remaining-time 150
     :remaining-time-timer (ready-timer)})
  (s/when [state]
    (main-phase/tick-remaining-time state))
  (s/then [result]
    (is (= 149
           (:remaining-time result)))))

(deftest update-remaining-time-does-not-count-below-zero
  (s/given
    {:remaining-time 0
     :remaining-time-timer (ready-timer)})
  (s/when [state]
    (main-phase/tick-remaining-time state))
  (s/then [result]
    (is (= 0
           (:remaining-time result)))))

(deftest exit-cycle-remaps-exit-through-tile-substitutions
  (s/given
    {:tile-substitutions {}
     :cycles [(assoc (main-phase/exit-cycle)
                     :timer (ready-timer)
                     :value :empty)]})
  (s/when [state]
    (cycle/process-all state))
  (s/then [result]
    (is (= :barrier
           (-> result :tile-substitutions :exit)))))

(deftest exit-flash-remaps-empty-to-white-then-removes-substitution
  (s/given
    {:tile-substitutions {}
     :cycles [(assoc (main-phase/exit-flash)
                     :timer (ready-timer)
                     :value :white)]})
  (s/when [state]
    (cycle/process-all state))
  (s/then [result]
    (is (nil? (-> result :tile-substitutions :empty)))
    (is (= []
           (:cycles result)))))

(deftest entry-cycle-removes-start-cover-and-queues-player-appear-cycle
  (s/given
    {:level-map {:layers [{:id :level}
                          {:id :boulder-rush/start-cover}]}
     :tile-substitutions {}
     :cycles [(assoc (level-start/entry-cycle)
                     :timer (ready-timer)
                     :duration-timer (ready-timer))]})
  (s/when [state]
    (cycle/process-all state))
  (s/then [result]
    (is (= true
           (:play-explosion-sound? result)))
    (is (= [:level]
           (map (-> result :level-map :layers) :id)))
    (is (= [[:debris-1 :debris-2 :debris-3 :player-default]]
           (map (:cycles result) :values)))))

(deftest player-appear-cycle-enables-gameplay-after-appear-animation
  (s/given
    {:level-map {:layers [{:id :level}]}
     :tile-substitutions {:barrier {:tile :barrier}
                          :player-default :player-default}
     :cycles [(assoc (level-start/player-appear-cycle)
                     :timer (ready-timer)
                     :value :player-default
                     :iteration 1)]})
  (s/when [state]
    (cycle/process-all state))
  (s/then [result]
    (is (= :phase/main
           (:phase result)))
    (is (nil? (-> result :tile-substitutions :player-default)))
    (is (= {:tile :barrier}
           (-> result :tile-substitutions :barrier)))
    (is (= [:level]
           (map (-> result :level-map :layers) :id)))
    (is (= 1
           (count (:cycles result))))))

(deftest phase-game-enters-death-phase-when-player-is-smashed
  (s/given
    {:level-map (fixtures/rows->map [" O "
                                     " P "
                                     "   "])
     :base-level-map (fixtures/rows->map [" P "])
     :level {:tileset-id :level
             :gems {:required 3
                    :value 10
                    :bonus-value 15}
             :remaining-time 20
             :initial-offset {:x 0 :y 0}}
     :player (player/make {:x 1 :y 1})
     :gems {:collected 0
            :required 3
            :value 10
            :bonus-value 15}
     :events [(event-ready (fixtures/falling {:x 1 :y 0}))]
     :cycles []
     :tile-substitutions {}
     :offset {:x 0 :y 0}
     :tile-offset {:x 0 :y 0}
     :remaining-time 20
     :remaining-time-timer (timer/make {:interval-ms 1000})})
  (s/when [state]
    (main-phase/update state {:held-keys []
                              :buffer-size {:w 320 :h 240}}))
  (s/then [result]
    (is (= {:reason :explosion}
           (:player-death result)))
    (is (= :phase/death
           (:phase result)))
    (is (= death-phase/DEATH-DELAY-MS
           (-> result :death :timer :interval-ms)))))

(deftest level-complete-counts-remaining-time-into-score-without-physics
  (s/given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :player {:pos {:x 0 :y 1}
              :score 40}
     :events [(event-ready (fixtures/candidate {:x 1 :y 0}))]
     :cycles []
     :tile-substitutions {}
     :offset {:x 0 :y 0}
     :tile-offset {:x 0 :y 0}
     :remaining-time 2
     :level-complete {:timer (ready-timer)}})
  (s/when [state]
    (complete-phase/update state {:buffer-size {:w 320 :h 240}}))
  (s/then [result]
    (is (= 1
           (:remaining-time result)))
    (is (= 41
           (-> result :player :score)))
    (is (= [" O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 1 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))

(deftest level-complete-starts-cover-fill-when-time-bonus-is-counted
  (s/given
    {:level-map (fixtures/rows->map ["P "])
     :level {:tileset-id :level}
     :player {:pos {:x 0 :y 0}
              :score 40}
     :events []
     :cycles []
     :tile-substitutions {}
     :offset {:x 0 :y 0}
     :tile-offset {:x 0 :y 0}
     :remaining-time 1
     :level-complete {:timer (ready-timer)}})
  (s/when [state]
    (complete-phase/update state {:buffer-size {:w 320 :h 240}}))
  (s/then [result]
    (is (= 0
           (:remaining-time result)))
    (is (= 41
           (-> result :player :score)))
    (is (= true
           (-> result :level-complete :filling?)))
    (is (= [:scene/level :boulder-rush/start-cover]
           (map (-> result :level-map :layers) :id)))
    (is (= [[nil nil]]
           (-> result :level-map :layers (nth 1) :tiles)))))

(deftest level-complete-cover-loads-next-level-when-full
  (s/given
    (let [level-1 (assoc (fixtures/rows->map ["P "])
                         :id :cave-a/level-1)
          level-2 (assoc (fixtures/rows->map [" P"])
                         :id :cave-a/level-2)]
      {:current-level 1
       :level-pack {:maps [level-1 level-2]
                    :tilesets [{:id :br}]}
       :level-map (level/add-empty-start-cover level-1
                                               {:tileset-id :br})
       :level {:tileset-id :br}
       :player {:pos {:x 0 :y 0}
                :score 123
                :lives 2}
       :events []
       :cycles []
       :tile-substitutions {}
       :offset {:x 0 :y 0}
       :tile-offset {:x 0 :y 0}
       :remaining-time 0
       :level-complete {:filling? true
                        :cover-index 0
                        :cover-timer (ready-timer)}}))
  (s/when [state]
    (complete-phase/update state {:buffer-size {:w 320 :h 240}}))
  (s/then [result]
    (is (= 2
           (:current-level result)))
    (is (= :phase/level-start
           (:phase result)))
    (is (= :cave-a/level-2
           (-> result :level-map :id)))
    (is (= 123
           (-> result :player :score)))
    (is (= 2
           (-> result :player :lives)))
    (is (= 2
           (count (:cycles result))))))

(deftest update-death-cover-adds-empty-start-cover-after-delay
  (s/given
    {:level-map (fixtures/rows->map ["P "])
     :level {:tileset-id :level}
     :death {:timer (ready-timer)}})
  (s/when [state]
    (death-phase/update-death-cover state))
  (s/then [result]
    (is (= true
           (-> result :death :filling?)))
    (is (= [:scene/level :boulder-rush/start-cover]
           (map (-> result :level-map :layers) :id)))
    (is (= [[nil nil]]
           (-> result :level-map :layers (nth 1) :tiles)))))

(deftest update-death-cover-restores-level-under-full-start-cover
  (s/given
    (let [base-map (fixtures/rows->map ["P "])]
      {:level-map (level/add-empty-start-cover (fixtures/rows->map ["XX"])
                                               {:tileset-id :level})
       :base-level-map base-map
       :level {:tileset-id :level
               :gems {:required 3
                      :value 10
                      :bonus-value 15}
               :remaining-time 20
               :initial-offset {:x 0 :y 0}}
       :player {:score 40
                :lives 2}
       :offset {:x 48 :y 32}
       :tile-offset {:x 3 :y 2}
       :death {:filling? true
               :cover-index 0
               :cover-timer (ready-timer)}}))
  (s/when [state]
    (death-phase/update-death-cover state))
  (s/then [result]
    (is (= :phase/level-start
           (:phase result)))
    (is (= ["P "]
           (fixtures/map->rows (:level-map result))))
    (is (= [[:barrier :barrier]]
           (-> result :level-map :layers (nth 1) :tiles)))
    (is (= 2
           (count (:cycles result))))
    (is (= 0
           (-> result :gems :collected)))
    (is (= 20
           (:remaining-time result)))
    (is (= 40
           (-> result :player :score)))
    (is (= 2
           (-> result :player :lives)))
    (is (= {:x 48 :y 32}
           (:offset result)))
    (is (= {:x 3 :y 2}
           (:tile-offset result)))
    (is (nil? (:death result)))))

(deftest update-physics-evaluates-current-events-and-retains-moved-coordinates
  (s/given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "   "
                                     "WWW"])
     :events [(event-ready (fixtures/candidate {:x 1 :y 0}))]})
  (s/when [state]
    (let [first-pass (event/update-physics state)
          second-pass (event/update-physics
                       (assoc first-pass
                              :events (map (:events first-pass)
                                                       event-ready)))]
      {:first-pass first-pass
       :second-pass second-pass}))
  (s/then [{:keys [first-pass second-pass]}]
    (is (= ["   "
            " O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map first-pass))))
    (is (= [{:pos {:x 1 :y 1}
             :state :falling}]
           (event-summaries (:events first-pass))))
    (is (= [:boulder]
           (:moved-tiles first-pass)))
    (is (= []
           (:explosions first-pass)))
    (is (= ["   "
            "   "
            " O "
            "WWW"]
           (fixtures/map->rows (:level-map second-pass))))
    (is (= [{:pos {:x 1 :y 2}
             :state :falling}]
           (event-summaries (:events second-pass))))
    (is (= [:boulder]
           (:moved-tiles second-pass)))
    (is (= []
           (:explosions second-pass)))))

(deftest update-physics-keeps-unready-events-waiting
  (s/given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (s/when [state]
    (event/update-physics state))
  (s/then [result]
    (is (= [" O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 1 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))
