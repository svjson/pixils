           (-> result :gems :collected)))
    (is (= 30
           (-> result :player :score)))))

(deftest handle-player-input-triggers-gem-required-flash-when-collected-reaches-required
  (s/given
    {:level-map (fixtures/rows->map ["PV"])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)
              :score 20}
     :gems {:collected 2
            :required 3
            :value 10
            :bonus-value 15}
     :cycles []
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/right]}))
  (s/then [result]
    (is (= 3
           (-> result :gems :collected)))
    (is (= true
           (:play-explosion-sound? result)))
    (is (= 2
           (count (:cycles result))))))

(deftest handle-player-input-uses-bonus-gem-value-after-required-count
  (s/given
    {:level-map (fixtures/rows->map ["PV"])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)
              :score 20}
     :gems {:collected 3
            :required 3
            :value 10
            :bonus-value 15}
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/right]}))
  (s/then [result]
    (is (= 4
           (-> result :gems :collected)))
    (is (= 35
           (-> result :player :score)))
    (is (nil? (:play-explosion-sound? result)))))

