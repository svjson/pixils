    (is (= {:x 0 :y 0}
           (-> result :player :pos)))
    (is (= true
           (-> result :player :walking?)))))

(deftest handle-player-input-fire-picks-up-gem-without-moving-player
  (s/given
    {:level-map (fixtures/rows->map ["PV"])
     :player {:pos {:x 0 :y 0}
              :move-timer (waiting-player-move-timer)
              :score 20}
     :gems {:collected 2
            :required 12
            :value 10
            :bonus-value 15}
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/ctrl :key/right]}))
  (s/then [result]
    (is (= ["P "]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 0 :y 0}
           (-> result :player :pos)))
    (is (= 3
           (-> result :gems :collected)))
    (is (= 30
           (-> result :player :score)))))

