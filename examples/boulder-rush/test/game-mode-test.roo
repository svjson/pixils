  (s/then [result state]
    (is (= state
           result))))

(deftest handle-player-input-enters-exit-after-required-gems
  (s/given
    {:level-map (fixtures/rows->map ["PE"])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :gems {:collected 3
            :required 3
            :value 10
            :bonus-value 15}
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/right]}))
  (s/then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= :phase/level-complete
           (:phase result)))
    (is (= complete-phase/TIME-BONUS-INTERVAL-MS
           (-> result :level-complete :timer :interval-ms)))))

(deftest gem-value-uses-bonus-value-after-required-count
  (is (= 10
         (level/gem-value {:gems {:collected 2
                                 :required 3
                                 :value 10
                                 :bonus-value 15}})))
  (is (= 15
         (level/gem-value {:gems {:collected 3
                                 :required 3
                                 :value 10
                                 :bonus-value 15}}))))

(deftest handle-player-input-fire-animates-when-target-is-blocked
  (s/given
    {:level-map (fixtures/rows->map ["PW"])
     :player {:pos {:x 0 :y 0}
