  (s/then [result state]
    (is (= state
           result))))

(deftest handle-player-input-clears-walking-state-when-timeout-expires
  (s/given
    {:player {:move-timer (ready-player-move-timer)
              :walking? true}})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys []}))
  (s/then [result]
    (is (= false
           (-> result :player :walking?)))))

(deftest handle-player-input-pushes-boulder-when-push-timer-is-ready
  (s/given
    {:level-map (fixtures/rows->map ["PO "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)
              :push {:dir {:x 1 :y 0}
                     :timer (ready-timer)}}
     :gems {:collected 0
            :required 3}
     :events []})
  (s/when [state]
    (main-phase/handle-player-input state {:held-keys [:key/right]}))
  (s/then [result]
    (is (= [" PO"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= [:boulder]
           (:moved-tiles result)))
    (is (= [{:pos {:x 2 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))

(deftest handle-player-input-fire-digs-dirt-without-moving-player
