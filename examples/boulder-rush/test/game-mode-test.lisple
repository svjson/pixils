(ns boulder-rush.game-mode-test
  (:require proof.core
            [boulder-rush.event :as event]
            [boulder-rush.explosion :as explosion]
            [boulder-rush.fixtures :as fixtures]
            [boulder-rush.cycle :as cycle]
            [boulder-rush.game-mode :as game]
            [boulder-rush.level.current :as level]
            [boulder-rush.level.index :as caves]
            [boulder-rush.player :as player]
            [boulder-rush.physics :as physics]
            [boulder-rush.sounds :as sounds]
            [pixils.state.timer :as timer]))

(defun ready-timer []
  (timer/make {:interval-ms 0
               :started? true
               :last-tick-ms 0
               :ticked? true}))

(defun event-ready [event]
  (assoc event :timer (ready-timer)))

(defun event-summary [event]
  {:pos (:pos event)
   :state (:state event)})

(defun event-summaries [events]
  (map events event-summary))

(defun ready-player-move-timer []
  (timer/make {:interval-ms player/MOVE-INTERVAL-MS
               :started? true
               :last-tick-ms 0
               :ticked? true}))

(defun waiting-player-move-timer []
  (timer/make {:interval-ms player/MOVE-INTERVAL-MS
               :started? true
               :last-tick-ms 0}))

(deftest produced-events-use-domain-timers
  (given
    {:level-map (fixtures/rows->map ["O"])
     :explosion-map (fixtures/rows->map [" "])})
  (when [{:keys [level-map explosion-map]}]
    {:falling (head (physics/events level-map))
     :explosion (:event (explosion/start explosion-map
                                         {:x 0 :y 0}))})
  (then [{:keys [falling explosion]}]
    (is (= physics/falling-wait-interval-ms
           (:interval-ms (:timer falling))))
    (is (= explosion/interval-ms
           (:interval-ms (:timer explosion))))))

(deftest level-properties-selects-current-level_configuration
  (is (= {:map-id :cave-a/level-1
          :tileset-id :br
          :gems {:required 12
                 :value 10
                 :bonus-value 15}
          :remaining-time 150
          :initial-offset {:x 344 :y 176}}
         (head caves/levels)))
  (is (= {:map-id :cave-a/level-2
          :tileset-id :br
          :gems {:required 10
                 :value 20
                 :bonus-value 50}
          :remaining-time 150
          :initial-offset {:x 0 :y 0}}
         (nth caves/levels 1))))

(deftest game-mode-init-loads-current-level_properties
  (given
    {:pack {:format :pixils.tilemap/pack
            :current-level 2
            :maps [(assoc (fixtures/rows->map ["P"])
                          :id :cave-a/level-1)
                   (assoc (fixtures/rows->map [" P"])
                          :id :cave-a/level-2)]
            :tilesets [{:id :br}]}})
  (when [{:keys [pack]}]
    (game/init-level pack))
  (then [result]
    (is (= 2
           (:current-level result)))
    (is (= :cave-a/level-2
           (-> result :level :map-id)))
    (is (= :cave-a/level-2
           (-> result :level-map :id)))
    (is (= :cave-a/level-2
           (-> result :base-level-map :id)))
    (is (= 0
           (-> result :gems :collected)))
    (is (= 10
           (-> result :gems :required)))
    (is (= 20
           (-> result :gems :value)))
    (is (= 50
           (-> result :gems :bonus-value)))
    (is (= 150
           (:remaining-time result)))
    (is (= {:x 0 :y 0}
           (:offset result)))
    (is (= {:x 0 :y 0}
           (:tile-offset result)))
    (is (= game/phase-start
           (:update result)))
    (is (= {:exit :barrier}
           (:tile-substitutions result)))
    (is (= 2
           (count (:cycles result))))
    (is (= :br
           (-> result :tileset :id)))
    (is (= [:scene/level :boulder-rush/start-cover]
           (map (-> result :level-map :layers) :id)))
    (is (= [[:barrier :barrier]]
           (-> result :level-map :layers (nth 1) :tiles)))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))))

(deftest reveal-start-cover-clears-random-cover-cells
  (given
    {:level-map {:width 3
                 :height 2
                 :layers [{:id :scene/level}
                          {:id :boulder-rush/start-cover
                           :tiles [[:barrier :barrier :barrier]
                                   [:barrier :barrier :barrier]]}]}})
  (when [state]
    (level/reveal-start-cover state))
  (then [result]
    (is (contains? (apply concat (-> result :level-map :layers (nth 1) :tiles))
                   nil))))

(deftest handle-player-input-adds-vacated-coordinate-as-event
  (given
    {:level-map (fixtures/rows->map ["O  "
                                     "P  "
                                     "WWW"])
     :player {:pos {:x 0 :y 1}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/right]}))
  (then [result]
    (is (= ["O  "
            " P "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 0 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))

(deftest handle-player-input-starts-pushing-boulder
  (given
    {:level-map (fixtures/rows->map ["PO "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/right]}))
  (then [result]
    (is (= ["PO "]
           (fixtures/map->rows (:level-map result))))
    (is (= true
           (-> result :player :walking?)))
    (is (= {:x 1 :y 0}
           (-> result :player :push :dir)))
    (is (contains? player/PUSH-INTERVALS-MS
                   (-> result :player :push :timer :interval-ms)))))

(deftest handle-player-input-moves-when-timer-is-ready
  (given
    {:level-map (fixtures/rows->map ["P "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/right]}))
  (then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= player/MOVE-INTERVAL-MS
           (:interval-ms (-> result :player :move-timer))))
    (is (= true (-> result :player :walking?)))
    (is (= {} (-> result :player :render-opts)))
    (is (not (timer/ticked? (-> result :player :move-timer))))))

(deftest handle-player-input-flips-walk-rendering-when-moving-left
  (given
    {:level-map (fixtures/rows->map [" P"])
     :player {:pos {:x 1 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/left]}))
  (then [result]
    (is (= {:flip-x? true}
           (-> result :player :render-opts)))))

(deftest player-walk-cycle-animates-walking-player-substitution
  (given
    {:player {:walking? true
              :render-opts {:flip-x? true}}
     :tile-substitutions {}
     :cycles [(assoc (game/player-walk-cycle)
                     :timer (ready-timer)
                     :value :player-walk-1)]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (= {:tile :player-walk-2
            :render-opts {:flip-x? true}}
           (-> result :tile-substitutions :player-default)))))

(deftest player-walk-cycle-removes-player-substitution-when-not-walking
  (given
    {:player {:walking? false}
     :tile-substitutions {:player-default {:tile :player-walk-1}}
     :cycles [(game/player-walk-cycle)]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (nil? (-> result :tile-substitutions :player-default)))))

(deftest barrier-scroll-cycle-adds-clipped-repeating-barrier-substitution
  (given
    {:tile-substitutions {}
     :cycles [(assoc (game/barrier-scroll-cycle)
                     :timer (ready-timer))]})
  (when [state]
    (let [state (cycle/process-all state)
          render-opts (-> state :tile-substitutions :barrier :render-opts)
          rect {:x 8 :y 16 :w 16 :h 16}]
      (apply render-opts [{:rect rect}])))
  (then [opts]
    (is (= {:target {:x 8 :y -2 :w 16 :h 16}
            :clip-rect {:x 8 :y 16 :w 16 :h 16}
            :repeat-y? true}
           opts))))

(deftest barrier-scroll-cycle-removes-barrier-substitution-when-done
  (given
    {:tile-substitutions {:barrier {:tile :barrier}}
     :cycles [(assoc (game/barrier-scroll-cycle)
                     :iteration (* 16 12))]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (nil? (-> result :tile-substitutions :barrier)))
    (is (= []
           (:cycles result)))))

(deftest handle-player-input-ignores-move-while-timer-is-waiting
  (given
    {:level-map (fixtures/rows->map ["P "])
