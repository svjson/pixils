(ns boulder-rush.game-mode-test
  (:require proof.core
            [boulder-rush.event :as event]
            [boulder-rush.explosion :as explosion]
            [boulder-rush.fixtures :as fixtures]
            [boulder-rush.game-mode :as game]
            [boulder-rush.player :as player]
            [boulder-rush.physics :as physics]
            [pixils.state.timer :as timer]))

(defun ready-timer []
  (timer/make {:interval-ms 0
               :started? true
               :last-tick-ms 0
               :ticked? true}))

(defun event-ready [event]
  (assoc event :timer (ready-timer)))

(defun event-summary [event]
  {:pos (:pos event)
   :state (:state event)})

(defun event-summaries [events]
  (map events event-summary))

(defun ready-player-move-timer []
  (timer/make {:interval-ms player/MOVE-INTERVAL-MS
               :started? true
               :last-tick-ms 0
               :ticked? true}))

(defun waiting-player-move-timer []
  (timer/make {:interval-ms player/MOVE-INTERVAL-MS
               :started? true
               :last-tick-ms 0}))

(defun ready-player-walk-animation-timer []
  (timer/make {:interval-ms player/WALK-ANIMATION-INTERVAL-MS
               :started? true
               :last-tick-ms 0
               :ticked? true}))

(deftest produced-events-use-domain-timers
  (given
    {:level-map (fixtures/rows->map ["O"])
     :explosion-map (fixtures/rows->map [" "])})
  (when [{:keys [level-map explosion-map]}]
    {:falling (head (physics/events level-map))
     :explosion (:event (explosion/start explosion-map
                                         {:x 0 :y 0}))})
  (then [{:keys [falling explosion]}]
    (is (= physics/falling-wait-interval-ms
           (:interval-ms (:timer falling))))
    (is (= explosion/interval-ms
           (:interval-ms (:timer explosion))))))

(deftest move-player-adds-vacated-coordinate-as-event
  (given
    {:level-map (fixtures/rows->map ["O  "
                                     "P  "
                                     "WWW"])
     :player {:pos {:x 0 :y 1}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x 1 :y 0}))
  (then [result]
    (is (= ["O  "
            " P "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 0 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))

(deftest move-player-does-not-add-event-when-blocked
  (given
    {:level-map (fixtures/rows->map ["PO"])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x 1 :y 0}))
  (then [result state]
    (is (= state
           result))))

(deftest move-player-moves-when-timer-is-ready
  (given
    {:level-map (fixtures/rows->map ["P "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x 1 :y 0}))
  (then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= player/MOVE-INTERVAL-MS
           (:interval-ms (-> result :player :move-timer))))
    (is (= true (-> result :player :walking?)))
    (is (= :player-walk-1 (-> result :player :walk-tile)))
    (is (= {} (-> result :player :render-opts)))
    (is (not (timer/ticked? (-> result :player :move-timer))))))

(deftest move-player-flips-walk-rendering-when-moving-left
  (given
    {:level-map (fixtures/rows->map [" P"])
     :player {:pos {:x 1 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x -1 :y 0}))
  (then [result]
    (is (= {:flip-x? true}
           (-> result :player :render-opts)))))

(deftest update-player-animates-walking-player
  (given
    {:player {:move-timer (timer/make {:interval-ms 999999999
                                        :started? true
                                        :last-tick-ms 0})
              :walking? true
              :walk-animation-timer (ready-player-walk-animation-timer)
              :walk-tile :player-walk-1}})
  (when [state]
    (player/update-player state))
  (then [result]
    (is (= :player-walk-2
           (-> result :player :walk-tile)))
    (is (not (timer/ticked? (-> result :player :walk-animation-timer))))))

(deftest move-player-ignores-move-while-timer-is-waiting
  (given
    {:level-map (fixtures/rows->map ["P "])
     :player {:pos {:x 0 :y 0}
              :move-timer (waiting-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x 1 :y 0}))
  (then [result state]
    (is (= state
           result))))

(deftest move-player-keeps-ready-timer-after-blocked-move
  (given
    {:level-map (fixtures/rows->map ["PW"])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)}
     :events []})
  (when [state]
    (game/move-player state {:x 1 :y 0}))
  (then [result state]
    (is (= state
           result))))

(deftest update-player-clears-walking-state-when-timeout-expires
  (given
    {:player {:move-timer (ready-player-move-timer)
              :walking? true
              :walk-animation-timer (ready-player-walk-animation-timer)
              :walk-tile :player-walk-1}})
  (when [state]
    (player/update-player state))
  (then [result]
    (is (= false
           (-> result :player :walking?)))))

(deftest play-physics-sounds-clears-moved-tiles
  (given
    {:moved-tiles [:boulder]})
  (when [state]
    (game/play-physics-sounds state))
  (then [result]
    (is (nil? (:moved-tiles result)))))

(deftest play-physics-sounds-clears-explosions
  (given
    {:explosions [{:x 1 :y 1}]})
  (when [state]
    (game/play-physics-sounds state))
  (then [result]
    (is (nil? (:explosions result)))))

(deftest update-physics-evaluates-current-events-and-retains-moved-coordinates
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "   "
                                     "WWW"])
     :events [(event-ready (fixtures/candidate {:x 1 :y 0}))]})
  (when [state]
    (let [first-pass (event/update-physics state)
          second-pass (event/update-physics
                       (assoc first-pass
                              :events (map (:events first-pass)
                                                       event-ready)))]
      {:first-pass first-pass
       :second-pass second-pass}))
  (then [{:keys [first-pass second-pass]}]
    (is (= ["   "
            " O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map first-pass))))
    (is (= [{:pos {:x 1 :y 1}
             :state :falling}]
           (event-summaries (:events first-pass))))
    (is (= [:boulder]
           (:moved-tiles first-pass)))
    (is (= []
           (:explosions first-pass)))
    (is (= ["   "
            "   "
            " O "
            "WWW"]
           (fixtures/map->rows (:level-map second-pass))))
    (is (= [{:pos {:x 1 :y 2}
             :state :falling}]
           (event-summaries (:events second-pass))))
    (is (= [:boulder]
           (:moved-tiles second-pass)))
    (is (= []
           (:explosions second-pass)))))

(deftest update-physics-keeps-unready-events-waiting
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [state]
    (event/update-physics state))
  (then [result]
    (is (= [" O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 1 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))
