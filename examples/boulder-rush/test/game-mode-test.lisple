    (game/handle-player-input state {:held-keys [:key/right]}))
  (then [result]
    (is (= 3
           (-> result :gems :collected)))
    (is (= true
           (:play-explosion-sound? result)))
    (is (= 2
           (count (:cycles result))))))

(deftest handle-player-input-uses-bonus-gem-value-after-required-count
