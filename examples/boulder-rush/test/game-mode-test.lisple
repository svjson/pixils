              :move-timer (waiting-player-move-timer)}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/right]}))
  (then [result state]
    (is (= state
           result))))

(deftest handle-player-input-keeps-ready-timer-after-blocked-move
