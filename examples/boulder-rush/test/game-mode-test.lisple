  (then [result]
    (is (= 4
           (-> result :gems :collected)))
    (is (= 35
           (-> result :player :score)))
    (is (nil? (:play-explosion-sound? result)))))

(deftest gem-value-uses-bonus-value-after-required-count
  (is (= 10
         (game/gem-value {:gems {:collected 2
                                 :required 3
                                 :value 10
                                 :bonus-value 15}})))
  (is (= 15
         (game/gem-value {:gems {:collected 3
                                 :required 3
                                 :value 10
                                 :bonus-value 15}}))))

(deftest handle-player-input-fire-animates-when-target-is-blocked
  (given
    {:level-map (fixtures/rows->map ["PW"])
