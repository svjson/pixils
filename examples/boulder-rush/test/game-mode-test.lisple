  (then [result]
    (is (= ["PW"]
           (fixtures/map->rows (:level-map result))))
    (is (= true
           (-> result :player :walking?)))
    (is (= {}
           (-> result :player :render-opts)))))

(deftest handle-player-input-fire-pushes-boulder-without-moving-player
  (given
    {:level-map (fixtures/rows->map ["PO "])
     :player {:pos {:x 0 :y 0}
              :move-timer (ready-player-move-timer)
              :push {:dir {:x 1 :y 0}
                     :timer (ready-timer)}}
     :events []})
  (when [state]
    (game/handle-player-input state {:held-keys [:key/ctrl :key/right]}))
  (then [result]
    (is (= ["P O"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 0 :y 0}
           (-> result :player :pos)))
    (is (= [:boulder]
           (:moved-tiles result)))))

(deftest play-game-event-sounds-clears-moved-tiles
  (given
    {:moved-tiles [:boulder]})
  (when [state]
    (sounds/play-game-event-sounds state))
  (then [result]
    (is (nil? (:moved-tiles result)))))

(deftest play-game-event-sounds-clears-explosions
  (given
    {:explosions [{:x 1 :y 1}]})
  (when [state]
    (sounds/play-game-event-sounds state))
  (then [result]
    (is (nil? (:explosions result)))))

(deftest play-game-event-sounds-clears-explicit-explosion-sound
  (given
    {:play-explosion-sound? true})
  (when [state]
    (sounds/play-game-event-sounds state))
  (then [result]
    (is (nil? (:play-explosion-sound? result)))))

(deftest update-remaining-time-counts-down-once-per-second
  (given
    {:remaining-time 150
     :remaining-time-timer (ready-timer)})
  (when [state]
    (game/update-remaining-time state))
  (then [result]
    (is (= 149
           (:remaining-time result)))))

(deftest update-remaining-time-does-not-count-below-zero
  (given
    {:remaining-time 0
     :remaining-time-timer (ready-timer)})
  (when [state]
    (game/update-remaining-time state))
  (then [result]
    (is (= 0
           (:remaining-time result)))))

(deftest exit-cycle-remaps-exit-through-tile-substitutions
  (given
    {:tile-substitutions {}
     :cycles [(assoc (game/exit-cycle)
                     :timer (ready-timer)
                     :value :empty)]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (= :barrier
           (-> result :tile-substitutions :exit)))))

(deftest exit-flash-remaps-empty-to-white-then-removes-substitution
  (given
    {:tile-substitutions {}
     :cycles [(assoc (game/exit-flash)
                     :timer (ready-timer)
                     :value :white)]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (nil? (-> result :tile-substitutions :empty)))
    (is (= []
           (:cycles result)))))

(deftest entry-cycle-removes-start-cover-and-queues-player-appear-cycle
  (given
    {:level-map {:layers [{:id :level}
                          {:id :boulder-rush/start-cover}]}
     :tile-substitutions {}
     :cycles [(assoc (game/entry-cycle)
                     :timer (ready-timer)
                     :duration-timer (ready-timer))]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (= true
           (:play-explosion-sound? result)))
    (is (= [:level]
           (map (-> result :level-map :layers) :id)))
    (is (= [[:debris-1 :debris-2 :debris-3 :player-default]]
           (map (:cycles result) :values)))))

(deftest player-appear-cycle-enables-gameplay-after-appear-animation
  (given
    {:level-map {:layers [{:id :level}]}
     :tile-substitutions {:barrier {:tile :barrier}
                          :player-default :player-default}
     :cycles [(assoc (game/player-appear-cycle)
                     :timer (ready-timer)
                     :value :player-default
                     :iteration 1)]})
  (when [state]
    (cycle/process-all state))
  (then [result]
    (is (= game/phase-game
           (:update result)))
    (is (nil? (-> result :tile-substitutions :player-default)))
    (is (= {:tile :barrier}
           (-> result :tile-substitutions :barrier)))
    (is (= [:level]
           (map (-> result :level-map :layers) :id)))
    (is (= 1
           (count (:cycles result))))))

(deftest phase-game-enters-death-phase-when-player-is-smashed
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " P "
                                     "   "])
     :base-level-map (fixtures/rows->map [" P "])
     :level {:tileset-id :level
             :gems {:required 3
                    :value 10
                    :bonus-value 15}
             :remaining-time 20
             :initial-offset {:x 0 :y 0}}
     :player (player/make {:x 1 :y 1})
     :gems {:collected 0
            :required 3
            :value 10
            :bonus-value 15}
     :events [(event-ready (fixtures/falling {:x 1 :y 0}))]
     :cycles []
     :tile-substitutions {}
     :offset {:x 0 :y 0}
     :tile-offset {:x 0 :y 0}
     :remaining-time 20
     :remaining-time-timer (timer/make {:interval-ms 1000})})
  (when [state]
    (game/phase-game state {:held-keys []
                            :buffer-size {:w 320 :h 240}}))
  (then [result]
    (is (= game/phase-death
           (:update result)))
    (is (= game/death-delay-ms
           (-> result :death :timer :interval-ms)))))

(deftest update-death-cover-adds-empty-start-cover-after-delay
  (given
    {:level-map (fixtures/rows->map ["P "])
     :level {:tileset-id :level}
     :death {:timer (ready-timer)}})
  (when [state]
    (game/update-death-cover state))
  (then [result]
    (is (= true
           (-> result :death :filling?)))
    (is (= [:scene/level :boulder-rush/start-cover]
           (map (-> result :level-map :layers) :id)))
    (is (= [[nil nil]]
           (-> result :level-map :layers (nth 1) :tiles)))))

(deftest update-death-cover-restores-level-under-full-start-cover
  (given
    (let [base-map (fixtures/rows->map ["P "])]
      {:level-map (level/add-empty-start-cover (fixtures/rows->map ["XX"])
                                               {:tileset-id :level})
       :base-level-map base-map
       :level {:tileset-id :level
               :gems {:required 3
                      :value 10
                      :bonus-value 15}
               :remaining-time 20
               :initial-offset {:x 0 :y 0}}
       :player {:score 40
                :lives 2}
       :offset {:x 48 :y 32}
       :tile-offset {:x 3 :y 2}
       :death {:filling? true
               :cover-index 0
               :cover-timer (ready-timer)}}))
  (when [state]
    (game/update-death-cover state))
  (then [result]
    (is (= game/phase-start
           (:update result)))
    (is (= ["P "]
           (fixtures/map->rows (:level-map result))))
    (is (= [[:barrier :barrier]]
           (-> result :level-map :layers (nth 1) :tiles)))
    (is (= 2
           (count (:cycles result))))
    (is (= 0
           (-> result :gems :collected)))
    (is (= 20
           (:remaining-time result)))
    (is (= 40
           (-> result :player :score)))
    (is (= 2
           (-> result :player :lives)))
    (is (= {:x 48 :y 32}
           (:offset result)))
    (is (= {:x 3 :y 2}
           (:tile-offset result)))
    (is (nil? (:death result)))))

(deftest update-physics-evaluates-current-events-and-retains-moved-coordinates
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "   "
                                     "WWW"])
     :events [(event-ready (fixtures/candidate {:x 1 :y 0}))]})
  (when [state]
    (let [first-pass (event/update-physics state)
          second-pass (event/update-physics
                       (assoc first-pass
                              :events (map (:events first-pass)
                                                       event-ready)))]
      {:first-pass first-pass
       :second-pass second-pass}))
  (then [{:keys [first-pass second-pass]}]
    (is (= ["   "
            " O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map first-pass))))
    (is (= [{:pos {:x 1 :y 1}
             :state :falling}]
           (event-summaries (:events first-pass))))
    (is (= [:boulder]
           (:moved-tiles first-pass)))
    (is (= []
           (:explosions first-pass)))
    (is (= ["   "
            "   "
            " O "
            "WWW"]
           (fixtures/map->rows (:level-map second-pass))))
    (is (= [{:pos {:x 1 :y 2}
             :state :falling}]
           (event-summaries (:events second-pass))))
    (is (= [:boulder]
           (:moved-tiles second-pass)))
    (is (= []
           (:explosions second-pass)))))

(deftest update-physics-keeps-unready-events-waiting
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [state]
    (event/update-physics state))
  (then [result]
    (is (= [" O "
            "   "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:pos {:x 1 :y 0}
             :state :candidate}]
           (event-summaries (:events result))))))
