(ns boulder-rush.fixtures
  (:require [boulder-rush.explosion :as explosion]
            [boulder-rush.physics :as physics]
            [pixils.state.timer :as timer]
            [pixils.tilemap.string-map :as string-map]))

(def test-tilesets
  [{:id :level
    :tiles [{:id :empty
             :char " "}
            {:id :dirt
             :char "."}
            {:id :wall
             :char "W"}
            {:id :barrier
             :char "B"}
            {:id :boulder
             :char "O"}
            {:id :gem
             :char "V"}
            {:id :exit
             :char "E"}
            {:id :debris-1
             :char "X"}
            {:id :debris-2
             :char "x"}
            {:id :debris-3
             :char "-"}
            {:id :player-default
             :char "P"}]}])

(def string-map-opts
  {:tilesets test-tilesets
   :tileset :level
   :layer {:id :scene/level}})

(defun rows->map [rows]
  (string-map/string-map->map rows string-map-opts))

(defun map->rows [level-map]
  (string-map/map->string-map level-map
                              {:tilesets test-tilesets
                               :layers [:scene/level]}))

(defun candidate [pos]
  {:pos pos
   :state :candidate
   :timer (timer/make {:interval-ms physics/falling-wait-interval-ms})})

(defun falling [pos]
  {:pos pos
   :state :falling
   :timer (timer/make {:interval-ms physics/falling-interval-ms})})

(defun explosion [pos phase]
  {:pos pos
   :state :explosion
   :phase phase
   :timer (timer/make {:interval-ms explosion/interval-ms})})
