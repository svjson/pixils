(ns boulder-rush.player-test
  (:require proof.core
            [boulder-rush.player :as player]
            [boulder-rush.fixtures :as fixtures]))

(def right {:x 1 :y 0})

(defun move-right [rows pos]
  (player/move-player (fixtures/rows->map rows)
                      {:pos pos}
                      right))

(deftest move-player-moves-right-into-dirt
  (let [result (move-right ["..OO"
                            ".P.V"
                            "WWWW"]
                           {:x 1 :y 1})]
    (is (= ["..OO"
            ". PV"
            "WWWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 2 :y 1}
           (-> result :player :pos)))))

(deftest move-player-moves-right-into-empty-space
  (let [result (move-right ["P "]
                           {:x 0 :y 0})]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))))

(deftest move-player-moves-right-into-gem
  (let [result (move-right ["PV"]
                           {:x 0 :y 0})]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))))

(deftest move-player-does-not-move-right-into-wall
  (is (= {}
         (move-right ["PW"]
                     {:x 0 :y 0}))))

(deftest move-player-does-not-move-right-into-boulder
  (is (= {}
         (move-right ["PO"]
                     {:x 0 :y 0}))))
