(ns boulder-rush.physics-test
  (:require proof.core
            [boulder-rush.physics :as physics]
            [boulder-rush.fixtures :as fixtures]))

(deftest points-of-interest-around-finds-adjacent-and-diagonal-falling-tiles
  (given
    (fixtures/rows->map ["OOO"
                         "V O"
                         "   "]))
  (when [level-map]
    (physics/points-of-interest-around level-map {:x 1 :y 1}))
  (then [points]
    (is (= [{:x 1 :y 0}
            {:x 2 :y 0}
            {:x 2 :y 1}
            {:x 0 :y 1}
            {:x 0 :y 0}]
           points))))

(deftest points-of-interest-scans-map-in-row-order
  (given
    (fixtures/rows->map ["  O"
                         "V  "
                         " V "]))
  (when [level-map]
    (physics/points-of-interest level-map))
  (then [points]
    (is (= [{:x 2 :y 0}
            {:x 0 :y 1}
            {:x 1 :y 2}]
           points))))

(deftest points-of-interest-includes-current-map-boulder-id
  (given
    (assoc-in (fixtures/rows->map ["   "])
              [:layers 0 :tiles 0 1]
              :simples-pimples-13))
  (when [level-map]
    (physics/points-of-interest level-map))
  (then [points]
    (is (= [{:x 1 :y 0}]
           points))))

(deftest evaluate-points-drops-boulder-with-empty-side-neighbors
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :points [{:x 1 :y 0}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points level-map points))
  (then [level-map]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-points-can-use-trigger-coordinate
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :points [{:x 1 :y 1}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points level-map points))
  (then [level-map]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-points-trigger-coordinate-wakes-diagonal-rolling-boulder
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " O "
                                     " W "
                                     "WWW"])
     :points [{:x 0 :y 1}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points level-map points))
  (then [level-map]
    (is (= ["O  "
            " O "
            " W "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-points-result-returns-moved-object-coordinates
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :points [{:x 1 :y 0}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points-result level-map points))
  (then [result]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [{:x 1 :y 1}]
           (:points-of-interest result)))))

(deftest evaluate-points-drops-boulder-with-blocked-side-neighbors
  (given
    {:level-map (fixtures/rows->map ["WOW"
                                     "W W"
                                     "WWW"])
     :points [{:x 1 :y 0}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points level-map points))
  (then [level-map]
    (is (= ["W W"
            "WOW"
            "WWW"]
           (fixtures/map->rows level-map)))))

