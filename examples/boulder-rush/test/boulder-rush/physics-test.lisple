(deftest evaluate-map-allows-previously-blocked-object-to-move-after-change
  (given
    (fixtures/rows->map ["WOW"
                         "WOW"
                         "W W"
                         "W W"]))
  (when [level-map]
    (physics/evaluate-map level-map))
  (then [level-map]
    (is (= ["W W"
            "WOW"
            "WOW"
            "W W"]
           (fixtures/map->rows level-map)))))
