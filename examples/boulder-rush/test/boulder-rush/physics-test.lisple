(deftest evaluate-points-does-not-drop-after-rolling-in-same-pass
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " O "
                                     " W "
                                     "WWW"])
     :points [{:x 1 :y 0}
              {:x 0 :y 0}]})
  (when [{:keys [level-map points]}]
    (physics/evaluate-points level-map points))
  (then [level-map]
    (is (= ["O  "
            " O "
            " W "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-points-does-not-drop-into-dirt-with-empty-side-neighbors
