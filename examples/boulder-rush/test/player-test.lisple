(ns boulder-rush.player-test
  (:require proof.core
            [boulder-rush.player :as player]
            [boulder-rush.fixtures :as fixtures]))

(def right {:x 1 :y 0})

(defun move-right [rows pos]
  (player/move-player (fixtures/rows->map rows)
                      {:pos pos}
                      right))

(deftest move-player-moves-right-into-dirt
  (given
    {:rows ["..OO"
            ".P.V"
            "WWWW"]
     :pos {:x 1 :y 1}})
  (when [{:keys [rows pos]}]
    (move-right rows pos))
  (then [result]
    (is (= ["..OO"
            ". PV"
            "WWWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 2 :y 1}
           (-> result :player :pos)))))

(deftest move-player-moves-right-into-empty-space
  (given
    {:rows ["P "]
     :pos {:x 0 :y 0}})
  (when [{:keys [rows pos]}]
    (move-right rows pos))
  (then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))))

(deftest move-player-preserves-player-properties
  (given
    {:rows ["P "]
     :player {:pos {:x 0 :y 0}
              :walking? true
              :walk-tile :player-walk-1}})
  (when [{:keys [rows player]}]
    (player/move-player (fixtures/rows->map rows)
                        player
                        right))
  (then [result]
    (is (= {:pos {:x 1 :y 0}
            :walking? true
            :walk-tile :player-walk-1}
           (:player result)))))

(deftest move-player-moves-right-into-gem
  (given
    {:rows ["PV"]
     :pos {:x 0 :y 0}})
  (when [{:keys [rows pos]}]
    (move-right rows pos))
  (then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))))

(deftest move-player-does-not-move-right-into-wall
  (given
    {:rows ["PW"]
     :pos {:x 0 :y 0}})
  (when [{:keys [rows pos]}]
    (move-right rows pos))
  (then [result]
    (is (= {}
           result))))

(deftest move-player-does-not-move-right-into-boulder
  (given
    {:rows ["PO"]
     :pos {:x 0 :y 0}})
  (when [{:keys [rows pos]}]
    (move-right rows pos))
  (then [result]
    (is (= {}
           result))))
