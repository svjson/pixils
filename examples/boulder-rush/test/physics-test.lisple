            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-map-moves-previously-blocked-object-after-change
  (given
    (fixtures/rows->map ["WOW"
                         "WOW"
                         "W W"
                         "W W"]))
  (when [level-map]
    (event/evaluate-map level-map))
  (then [level-map]
    (is (= ["WOW"
            "W W"
            "WOW"
            "W W"]
           (fixtures/map->rows level-map)))))
