(deftest evaluate-events-result-creates-explosion-after-impact
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " P "
                                     "   "])
     :events [(fixtures/falling {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["XXX"
            "XXX"
            "XXX"]
           (fixtures/map->rows (:level-map result))))
    (is (= [(fixtures/explosion {:x 1 :y 1} :debris-1)]
           (:events result)))))

(deftest evaluate-events-advances-explosion-to-debris-2
  (given
    {:level-map (fixtures/rows->map ["XXX"
                                     "XXX"
                                     "XXX"])
     :events [(fixtures/explosion {:x 1 :y 1} :debris-1)]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["xxx"
            "xxx"
            "xxx"]
           (fixtures/map->rows (:level-map result))))
    (is (= [(fixtures/explosion {:x 1 :y 1} :debris-2)]
           (:events result)))))

(deftest evaluate-events-advances-explosion-to-debris-3
  (given
    {:level-map (fixtures/rows->map ["xxx"
                                     "xxx"
                                     "xxx"])
     :events [(fixtures/explosion {:x 1 :y 1} :debris-2)]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["---"
            "---"
            "---"]
           (fixtures/map->rows (:level-map result))))
    (is (= [(fixtures/explosion {:x 1 :y 1} :debris-3)]
           (:events result)))))

(deftest evaluate-events-clears-explosion-after-debris-3
  (given
    {:level-map (fixtures/rows->map ["---"
                                     "---"
                                     "---"])
     :events [(fixtures/explosion {:x 1 :y 1} :debris-3)]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["   "
            "   "
            "   "]
           (fixtures/map->rows (:level-map result))))
    (is (= []
           (:events result)))))

(deftest evaluate-events-does-not-explode-when-candidate-boulder-is-above-player
  (given
    {:level-map (fixtures/rows->map [" O "
