(deftest evaluate-events-does-not-drop-after-rolling-in-same-pass
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " O "
                                     " W "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})
              (fixtures/candidate {:x 0 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["O  "
            " O "
            " W "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-events-does-not-drop-into-dirt-with-empty-side-neighbors
  (given
    {:level-map (fixtures/rows->map [" O "
