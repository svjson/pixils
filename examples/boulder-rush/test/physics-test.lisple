(ns boulder-rush.physics-test
  (:require proof.core
            [boulder-rush.event :as event]
            [boulder-rush.physics :as physics]
            [boulder-rush.fixtures :as fixtures]))

(deftest events-around-finds-adjacent-and-diagonal-falling-tiles
  (given
    (fixtures/rows->map ["OOO"
                         "V O"
                         "   "]))
  (when [level-map]
    (physics/events-around level-map {:x 1 :y 1}))
  (then [events]
    (is (= [(fixtures/candidate {:x 1 :y 0})
            (fixtures/candidate {:x 2 :y 0})
            (fixtures/candidate {:x 2 :y 1})
            (fixtures/candidate {:x 0 :y 1})
            (fixtures/candidate {:x 0 :y 0})]
           events))))

(deftest events-scans-map-in-row-order
  (given
    (fixtures/rows->map ["  O"
                         "V  "
                         " V "]))
  (when [level-map]
    (physics/events level-map))
  (then [events]
    (is (= [(fixtures/candidate {:x 2 :y 0})
            (fixtures/candidate {:x 0 :y 1})
            (fixtures/candidate {:x 1 :y 2})]
           events))))

(deftest events-includes-current-map-boulder-id
  (given
    (assoc-in (fixtures/rows->map ["   "])
              [:layers 0 :tiles 0 1]
              :boulder))
  (when [level-map]
    (physics/events level-map))
  (then [events]
    (is (= [(fixtures/candidate {:x 1 :y 0})]
           events))))

(deftest evaluate-events-drops-boulder-with-empty-side-neighbors
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-events-can-use-trigger-coordinate
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 1})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-events-trigger-coordinate-wakes-diagonal-rolling-boulder
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " O "
                                     " W "
                                     "WWW"])
     :events [(fixtures/candidate {:x 0 :y 1})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["O  "
            " O "
            " W "
            "WWW"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-events-result-returns-moved-object-coordinates
  (given
    {:level-map (fixtures/rows->map [" O "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["   "
            " O "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [(fixtures/falling {:x 1 :y 1})]
           (:events result)))
    (is (= [:boulder]
           (:moved-tiles result)))))

(deftest evaluate-events-result-records-moving-gem
  (given
    {:level-map (fixtures/rows->map [" V "
                                     "   "
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events-result level-map events))
  (then [result]
    (is (= ["   "
            " V "
            "WWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= [:gem]
           (:moved-tiles result)))))

(deftest evaluate-events-explodes-when-falling-boulder-hits-player
  (given
    {:level-map (fixtures/rows->map [" O "
                                     " P "
                                     "   "])
     :events [(fixtures/falling {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["XXX"
            "XXX"
            "XXX"]
           (fixtures/map->rows level-map)))))

(deftest evaluate-events-explodes-when-falling-gem-hits-player
  (given
    {:level-map (fixtures/rows->map [" V "
                                     " P "
                                     "   "])
     :events [(fixtures/falling {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["XXX"
