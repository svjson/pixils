(deftest evaluate-events-drops-boulder-with-blocked-side-neighbors
  (given
    {:level-map (fixtures/rows->map ["WOW"
                                     "W W"
                                     "WWW"])
     :events [(fixtures/candidate {:x 1 :y 0})]})
  (when [{:keys [level-map events]}]
    (event/evaluate-events level-map events))
  (then [level-map]
    (is (= ["W W"
            "WOW"
            "WWW"]
           (fixtures/map->rows level-map)))))

