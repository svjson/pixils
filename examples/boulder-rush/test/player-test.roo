(ns boulder-rush.player-test
  (:require proof.core
            [proof.syntax :as s]
            [boulder-rush.player :as player]
            [boulder-rush.fixtures :as fixtures]))

(def right {:x 1 :y 0})

(defun move-right [rows pos]
  (player/move-player (fixtures/rows->map rows)
                      {:pos pos}
                      right))

(deftest move-player-moves-right-into-dirt
  (s/given
    {:rows ["..OO"
            ".P.V"
            "WWWW"]
     :pos {:x 1 :y 1}})
  (s/when [{:keys [rows pos]}]
    (move-right rows pos))
  (s/then [result]
    (is (= ["..OO"
            ". PV"
            "WWWW"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 2 :y 1}
           (-> result :player :pos)))
    (is (= :dirt (:entered-tile result)))))

(deftest move-player-moves-right-into-empty-space
  (s/given
    {:rows ["P "]
     :pos {:x 0 :y 0}})
  (s/when [{:keys [rows pos]}]
    (move-right rows pos))
  (s/then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= :empty (:entered-tile result)))))

(deftest move-player-preserves-player-properties
  (s/given
    {:rows ["P "]
     :player {:pos {:x 0 :y 0}
              :walking? true}})
  (s/when [{:keys [rows player]}]
    (player/move-player (fixtures/rows->map rows)
                        player
                        right))
  (s/then [result]
    (is (= {:pos {:x 1 :y 0}
            :walking? true}
           (:player result)))
    (is (= :empty (:entered-tile result)))))

(deftest begin-walk-flips-rendering-when-moving-up-or-left
  (is (= {:flip-x? true}
         (:render-opts (player/begin-walk {:pos {:x 0 :y 0}}
                                          {:x 0 :y -1}))))
  (is (= {:flip-x? true}
         (:render-opts (player/begin-walk {:pos {:x 0 :y 0}}
                                          {:x -1 :y 0})))))

(deftest begin-walk-does-not-flip-rendering-when-moving-right-or-down
  (is (= {}
         (:render-opts (player/begin-walk {:pos {:x 0 :y 0}}
                                          {:x 1 :y 0}))))
  (is (= {}
         (:render-opts (player/begin-walk {:pos {:x 0 :y 0}}
                                          {:x 0 :y 1})))))

(deftest move-player-moves-right-into-gem
  (s/given
    {:rows ["PV"]
     :pos {:x 0 :y 0}})
  (s/when [{:keys [rows pos]}]
    (move-right rows pos))
  (s/then [result]
    (is (= [" P"]
           (fixtures/map->rows (:level-map result))))
    (is (= {:x 1 :y 0}
           (-> result :player :pos)))
    (is (= :gem (:entered-tile result)))))

(deftest move-player-does-not-move-right-into-wall
  (s/given
    {:rows ["PW"]
     :pos {:x 0 :y 0}})
  (s/when [{:keys [rows pos]}]
    (move-right rows pos))
  (s/then [result]
    (is (= {}
           result))))

(deftest move-player-does-not-move-right-into-boulder
  (s/given
    {:rows ["PO"]
     :pos {:x 0 :y 0}})
  (s/when [{:keys [rows pos]}]
    (move-right rows pos))
  (s/then [result]
    (is (= {}
           result))))
