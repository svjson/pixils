(ns pixils.test-test
  (:require proof.core
            [proof.syntax :as s]
            pixils.test
            pixils.test.combo-box
            pixils.test.list-box
            pixils.test.menu-bar
            pixils.test.tab-panel
            [pixils.color :as color]
            [pixils.point :as point]))



;; pixils.test facade

(deftest facade/re-exports-common-operations-and-loads-component-drivers
  (s/when []
    {:color (color/make-color {:r 12 :g 34 :b 56 :a 78})
     :translated-point (point/translate {:x 3 :y 5} 1 0)
     :runtime? (some? (resolve 'pixils.test/make-app))
     :view? (some? (resolve 'pixils.test/find-view))
     :input? (some? (resolve 'pixils.test/click!))
     :settle? (some? (resolve 'pixils.test/settle!))
     :resource? (some? (resolve 'pixils.test/image-size-is?))
     :tab-panel? (some? (resolve 'pixils.test.tab-panel/switch-to!))
     :list-box? (some? (resolve 'pixils.test.list-box/has-visible-text?))
     :combo-box? (some? (resolve 'pixils.test.combo-box/has-visible-text?))
     :menu-bar? (some? (resolve 'pixils.test.menu-bar/command))})

  (s/then [loaded]
    (is (= {:color {:r 12 :g 34 :b 56 :a 78}
            :translated-point {:x 4 :y 5}
            :runtime? true
            :view? true
            :input? true
            :settle? true
            :resource? true
            :tab-panel? true
            :list-box? true
            :combo-box? true
            :menu-bar? true}
           loaded))))
