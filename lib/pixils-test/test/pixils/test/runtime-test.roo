(ns pixils.test.runtime-test
  "Verifies the public isolated Pixils runtime test surface."
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]))



;; pixils.test/make-app

(deftest make-app/isolates-built-in-render-assets-between-apps
  (s/when []
    (let [renderless-app
          (px/make-app {:package-root "."
                        :buffer-width 40
                        :buffer-height 24
                        :render-backend false})]
      (px/eval!
       renderless-app
       "(pixils/defmode renderless-root
          {:children [{:mode 'ui/text
                       :state {:value \"A\"}}]})")
      (px/push-mode! renderless-app 'renderless-root)
      (px/settle-layout! renderless-app))
    (let [app (px/make-app {:package-root "."
                            :buffer-width 40
                            :buffer-height 24
                            :render-backend true})]
      (px/eval!
       app
       "(pixils/defmode rendered-assets-root
          {:style {:background {:r 255 :g 255 :b 255}
                   :layout {:direction :row}}
           :children [{:mode 'ui/text
                      :state {:value \"A\"}}
                      {:mode 'ui/menu-option-indicator
                       :state {:checked? true}}]})")
      (px/push-mode! app 'rendered-assets-root)
      (px/settle-layout! app)
      (px/render! app)
      (let [text (px/find-view app "ui/text")
            indicator (px/find-view app "ui/menu-option-indicator")
            {:keys [x y w h]} (:visual-bounds indicator)
            pixels
            (apply concat
                   (for [py (range y (+ y (dec h)))]
                   (for [pixel-x (range x (+ x (dec w)))]
                     (px/rendered-pixel app pixel-x py))))
            first-pixel (head pixels)]
        {:text-sized? (and (> (-> text :bounds :w) 0)
                           (> (-> text :bounds :h) 0))
         :indicator-size {:w w :h h}
         :indicator-rendered?
         (not-empty?
          (filter pixels
                  (fn [pixel]
                    (not= first-pixel pixel))))})))

  (s/then [result]
    (is (= {:text-sized? true
            :indicator-size {:w 12 :h 10}
            :indicator-rendered? true}
           result))))
