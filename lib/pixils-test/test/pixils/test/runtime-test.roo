(ns pixils.test.runtime-test
  "Verifies the public isolated Pixils runtime test surface."
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test.runtime :as runtime]))



;; pixils.test.runtime/make-app

(deftest make-app/isolates-built-in-render-assets-between-apps
  (s/when []
    (let [renderless-app
          (runtime/make-app {:package-root "."
                             :buffer-width 40
                             :buffer-height 24
                             :render-backend false})]
      (runtime/eval!
       renderless-app
       "(pixils/defmode renderless-root
          {:children [{:mode 'ui/text
                       :state {:value \"A\"}}]})")
      (runtime/push-mode! renderless-app 'renderless-root)
      (runtime/settle-layout! renderless-app))
    (let [app (runtime/make-app {:package-root "."
                                 :buffer-width 40
                                 :buffer-height 24
                                 :render-backend true})]
      (runtime/eval!
       app
       "(pixils/defmode rendered-assets-root
          {:style {:background {:r 255 :g 255 :b 255}
                   :layout {:direction :row}}
           :children [{:mode 'ui/text
                      :state {:value \"A\"}}
                      {:mode 'ui/menu-option-indicator
                       :state {:checked? true}}]})")
      (runtime/push-mode! app 'rendered-assets-root)
      (runtime/settle-layout! app)
      (runtime/render! app)
      (let [text (runtime/find-view app "ui/text")
            indicator (runtime/find-view app "ui/menu-option-indicator")
            {:keys [x y w h]} (:visual-bounds indicator)
            pixels
            (apply concat
                   (for [py (range y (+ y (dec h)))]
                     (for [px (range x (+ x (dec w)))]
                       (runtime/rendered-pixel app px py))))
            first-pixel (head pixels)]
        {:text-sized? (and (> (-> text :bounds :w) 0)
                           (> (-> text :bounds :h) 0))
         :indicator-size {:w w :h h}
         :indicator-rendered?
         (not-empty?
          (filter pixels
                  (fn [pixel]
                    (not= first-pixel pixel))))})))

  (s/then [result]
    (is (= {:text-sized? true
            :indicator-size {:w 12 :h 10}
            :indicator-rendered? true}
           result))))
