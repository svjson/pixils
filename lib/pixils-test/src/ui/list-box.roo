(ns pixils.test.ui.list-box
  (:require proof.core
            [pixils.ui :as ui]
            [pixils.test.runtime :as runtime]))

(defun views
  "Find every rendered list box.

  Args:
  - `app`: Test application to inspect.

  Returns:
  A vector of list-box views."
  [app]
  (runtime/find-views app "ui/list-box"))

(defun view-renders-text?
  "Test whether a view tree renders an exact text value.

  Args:
  - `view`: Root runtime view to inspect.
  - `text`: Expected `ui/text` value.

  Returns:
  True when a matching text view exists; otherwise false."
  [view text]
  (or (and (= "ui/text" (runtime/view-mode-name view))
           (= text (:value (runtime/view-state view))))
      (not-empty? (filter (ui/children view)
                          (fn [child]
                            (view-renders-text? child text))))))

(defun views-containing
  "Find list boxes that render an exact text value.

  Args:
  - `app`: Test application to inspect.
  - `text`: Expected `ui/text` value.

  Returns:
  A collection of matching list-box views."
  [app text]
  (filter (views app)
          (fn [view]
            (view-renders-text? view text))))

(defun has-visible-text?
  "Assert that a list box renders an exact text value.

  Args:
  - `app`: Test application to inspect.
  - `text`: Expected `ui/text` value.

  Returns:
  True when a matching list box exists; otherwise false."
  [app text]
  (let [matched (views-containing app text)
        present? (> (count matched) 0)]
    (is (= true present?))
    present?))

(defun count-is?
  "Assert the number of rendered list boxes.

  Args:
  - `app`: Test application to inspect.
  - `expected`: Required list-box count.

  Returns:
  The actual list-box count."
  [app expected]
  (let [actual (count (views app))]
    (is (= expected actual))
    actual))
