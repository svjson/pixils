(ns pixils.test.ui.list-box
  (:require proof.core
            [pixils.test.runtime :as runtime]))

(defun views [app]
  (runtime/find-views app "ui/list-box"))

(defun views-containing [app text]
  (runtime/find-views-containing app "ui/list-box" text))

(defun has-visible-text? [app text]
  (let [matched (views-containing app text)
        present? (> (count matched) 0)]
    (is (= true present?))
    present?))

(defun count-is? [app expected]
  (let [actual (count (views app))]
    (is (= expected actual))
    actual))
