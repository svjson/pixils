(ns pixils.test.runtime
  (:require [pixils.test.runtime.native :as native]))

(defun make-app [opts] (native/make-app opts))
(defun eval! [app source] (native/eval! app source))
(defun push-mode! [app mode] (native/push-mode! app mode))
(defun push-mode-with-state! [app mode state] (native/push-mode! app mode state))
(defun push-mode-with-overrides! [app mode state overrides]
  (native/push-mode! app mode state overrides))
(defun pop-mode! [app payload] (native/pop-mode! app payload))
(defun update! [app] (native/update! app))
(defun render! [app] (native/render! app))
(defun frame! [app] (native/frame! app))
(defun active-mode [app] (native/active-mode app))
(defun active-mode-name [app] (native/active-mode-name app))
(defun active-state [app] (native/active-state app))
(defun set-active-state! [app state] (native/set-active-state! app state))
(defun view-mode-name [view] (native/view-mode-name view))
(defun view-state [view] (native/view-state view))
(defun find-view [app mode-name] (native/find-view app mode-name))
(defun find-view-containing [app mode-name state-text]
  (native/find-view app mode-name state-text))
(defun click! [app view] (native/click! app view))
(defun mouse-move-at! [app x y] (native/mouse-move-at! app x y))
(defun mouse-down-at! [app x y & button]
  (if button
    (native/mouse-down-at! app x y button)
    (native/mouse-down-at! app x y)))
(defun mouse-up-at! [app x y & button]
  (if button
    (native/mouse-up-at! app x y button)
    (native/mouse-up-at! app x y)))
(defun mouse-click-at! [app x y & button]
  (if button
    (native/mouse-click-at! app x y button)
    (native/mouse-click-at! app x y)))
(defun mouse-move-in! [app view x y] (native/mouse-move-in! app view x y))
(defun mouse-down-in! [app view x y & button]
  (if button
    (native/mouse-down-in! app view x y button)
    (native/mouse-down-in! app view x y)))
(defun mouse-up-in! [app view x y & button]
  (if button
    (native/mouse-up-in! app view x y button)
    (native/mouse-up-in! app view x y)))
(defun mouse-click-in! [app view x y & button]
  (if button
    (native/mouse-click-in! app view x y button)
    (native/mouse-click-in! app view x y)))
(defun mouse-drag-in! [app view from-x from-y to-x to-y & button]
  (let [button (or button :left)]
    (mouse-down-in! app view from-x from-y button)
    (update! app)
    (mouse-move-in! app view to-x to-y)
    (update! app)
    (mouse-up-in! app view to-x to-y button)
    (update! app)
    app))
(defun mouse-drag-between! [app from-view from-x from-y to-view to-x to-y & button]
  (let [button (or button :left)]
    (mouse-down-in! app from-view from-x from-y button)
    (update! app)
    (mouse-move-in! app to-view to-x to-y)
    (update! app)
    (mouse-up-in! app to-view to-x to-y button)
    (update! app)
    app))
(defun key-down! [app key] (native/key-down! app key))
(defun key-up! [app key] (native/key-up! app key))
