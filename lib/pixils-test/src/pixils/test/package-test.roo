(ns pixils.test.package-test
  (:require proof.core
            pixils.test
            pixils.test.resource
            [pixils.test.runtime :as runtime]
            pixils.test.ui.combo-box
            pixils.test.ui.list-box
            pixils.test.ui.tab-panel
            [pixils.color :as color]
            [pixils.point :as point]))

(deftest pixils-test-loads-pixils-native-namespaces
  (is (= true pixils.test/test-package-loaded?))
  (let [value (color/make-color {:r 12 :g 34 :b 56 :a 78})]
    (is (= 12 (:r value)))
    (is (= 34 (:g value)))
    (is (= 56 (:b value)))
    (is (= 78 (:a value)))))

(deftest pixils-test-can-host-pure-function-tests
  (let [move-right (fn [point] (point/translate point 1 0))]
    (is (= {:x 4 :y 5} (move-right {:x 3 :y 5})))))

(deftest pixils-test-can-host-runtime-fixtures
  (is (not (nil? (resolve 'pixils.test.runtime/make-app)))))

(deftest pixils-test-provides-ui-component-fixtures
  (is (not (nil? (resolve 'pixils.test.ui.tab-panel/switch-to!))))
  (is (not (nil? (resolve 'pixils.test.ui.list-box/has-visible-text?))))
  (is (not (nil? (resolve 'pixils.test.ui.combo-box/has-visible-text?)))))

(deftest pixils-test-provides-resource-fixtures
  (is (not (nil? (resolve 'pixils.test.resource/image-size-is?))))
  (is (not (nil? (resolve 'pixils.test.resource/image-resource-file-is?)))))
