(ns pixils.test.package-test
  (:require proof.core
            pixils.test
            pixils.test.resource
            [pixils.test.runtime :as runtime]
            pixils.test.ui.combo-box
            pixils.test.ui.list-box
            pixils.test.ui.tab-panel
            [pixils.color :as color]
            [pixils.point :as point]))

(deftest pixils-test-loads-pixils-native-namespaces
  (is (= true pixils.test/test-package-loaded?))
  (let [value (color/make-color {:r 12 :g 34 :b 56 :a 78})]
    (is (= 12 (:r value)))
    (is (= 34 (:g value)))
    (is (= 56 (:b value)))
    (is (= 78 (:a value)))))

(deftest pixils-test-can-host-pure-function-tests
  (let [move-right (fn [point] (point/translate point 1 0))]
    (is (= {:x 4 :y 5} (move-right {:x 3 :y 5})))))

(deftest pixils-test-can-host-runtime-fixtures
  (is (not (nil? (resolve 'pixils.test.runtime/make-app)))))

(deftest pixils-test-provides-ui-component-fixtures
  (is (not (nil? (resolve 'pixils.test.ui.tab-panel/switch-to!))))
  (is (not (nil? (resolve 'pixils.test.ui.list-box/has-visible-text?))))
  (is (not (nil? (resolve 'pixils.test.ui.combo-box/has-visible-text?)))))

(deftest pixils-test-provides-resource-fixtures
  (is (not (nil? (resolve 'pixils.test.resource/image-size-is?))))
  (is (not (nil? (resolve 'pixils.test.resource/image-resource-file-is?)))))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun window-move-probe-source []
  "(ns pixils.test.window-move-probe
     (:require pixils
               pixils.ui.window))

   (pixils/defcomponent probe-body
     {:style {:width 80
              :height 40}
      :on-mouse-down (fn [state event ctx]
                       (assoc state :presses (+ (or (:presses state) 0) 1)))})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:position {:x 24 :y 20}
                   :style {:width 80
                           :height 56}
                   :title-bar {:title \"Probe\"}
                   :body [{:mode 'probe-body
                           :state {:presses 0}}]})]})")

(deftest dragged-window-keeps-latest-position-after-follow-up-interaction
  (let [app (runtime/make-app {:package-root "lib/pixils"
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (window-move-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")]
      (is (= 24 (:x (:bounds window))))
      (is (= 20 (:y (:bounds window))))
      (runtime/mouse-down-in! app title-bar 40 9)
      (runtime/update! app)
      (runtime/mouse-move-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [position (:position (runtime/view-state (runtime/find-view app "ui/window")))]
        (is (= 55 (:x position)))
        (is (= 37 (:y position))))
      (runtime/mouse-up-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-drag (runtime/find-view app "ui/window")
            probe-body (runtime/find-view app "probe-body")]
        (is (= 55 (:x (:bounds window-after-drag))))
        (is (= 37 (:y (:bounds window-after-drag))))
        (runtime/mouse-down-in! app probe-body 4 4)
        (runtime/update! app)
        (runtime/layout! app)
        (let [window-after-body-press (runtime/find-view app "ui/window")
              probe-body-after-press (runtime/find-view app "probe-body")]
          (is (= 55 (:x (:bounds window-after-body-press))))
          (is (= 37 (:y (:bounds window-after-body-press))))
          (is (= 1 (:presses (runtime/view-state probe-body-after-press)))))))))
