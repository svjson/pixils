(ns pixils.test.menu-bar
  (:require [pixils.test.view :as view]))

(defun item
  "Finds a top-level menu-bar item by its semantic label.

  Searches active `ui/menu-bar-item` views and compares `label` with the
  normalized node text stored at `:ui-state :node :text`. It does not open the
  menu, search submenu items, assert a match, or advance the application.

  Args:
  - `app`: Running Pixils test application.
  - `label`: Menu label without mnemonic markup.

  Returns:
  The matching menu-bar item view, or `nil`."
  [app label]
  (find-first (view/find-views app "ui/menu-bar-item")
              (fn [view]
                (= label (-> view :ui-state :node :text)))))

(defun command
  "Finds a command in a top-level application menu.

  Finds the requested top-level item, then searches its normalized immediate
  `:items` for an exact `:action`. It does not open the menu, recurse into nested
  submenus, assert a match, or advance the application.

  Args:
  - `app`: Running Pixils test application.
  - `menu-label`: Top-level menu label without mnemonic markup.
  - `action`: Command action keyword.

  Returns:
  The normalized command node, or `nil`."
  [app menu-label action]
  (when-let [menu-item (item app menu-label)]
    (find-first (-> menu-item :ui-state :node :items)
                (fn [node]
                  (= action (:action node))))))

(defun command-enabled?
  "Returns whether a command is present and enabled.

  Calls `command` and treats a command as enabled unless its normalized node
  contains `:disabled? true`. It does not evaluate dynamic enablement, open the
  menu, assert the result, or advance the application.

  Args:
  - `app`: Running Pixils test application.
  - `menu-label`: Top-level menu label without mnemonic markup.
  - `action`: Command action keyword.

  Returns:
  `true` when the command exists and is not disabled, otherwise `nil` or
  `false`."
  [app menu-label action]
  (when-let [node (command app menu-label action)]
    (not= true (:disabled? node))))

(defun command-text
  "Returns the visible text of a command.

  Calls `command` and reads the normalized node's `:text`. It does not open or
  render the menu, strip text itself, assert a result, or advance the
  application.

  Args:
  - `app`: Running Pixils test application.
  - `menu-label`: Top-level menu label without mnemonic markup.
  - `action`: Command action keyword.

  Returns:
  The command text without mnemonic markup, or `nil`."
  [app menu-label action]
  (:text (command app menu-label action)))
