(ns pixils.ui.child-mutation-test
  (:require proof.core
            [pixils.ui :as ui]
            [pixils.test.runtime :as runtime]))

(deftest remove-child-removes-only-the-addressed-child
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/child-mutation-probe.roo")
    (runtime/push-mode! app 'child-removal-root)
    (is (some? (runtime/find-view app "removable-child")))
    (is (some? (runtime/find-view app "retained-child")))
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :remove? true))
    (runtime/update! app)
    (is (nil? (runtime/find-view app "removable-child")))
    (is (some? (runtime/find-view app "retained-child")))
    (is (= :retained
           (:application-value (runtime/active-state app))))))

(deftest reconcile-children-preserves-reorders-removes-and-creates
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/child-mutation-probe.roo")
    (runtime/push-mode! app 'child-reconciliation-root)
    (ui/set-ui-state! (head (ui/children (runtime/active-mode app)))
                      {:value 42})
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :reconcile? true))
    (runtime/update! app)
    (let [children (ui/children (runtime/active-mode app))]
      (is (= ["second" "first" "third"]
             [(:id (head children))
              (:id (nth children 1))
              (:id (nth children 2))]))
      (is (= 20 (-> (head children) :ui-state :value)))
      (is (= 42 (-> (nth children 1) :ui-state :value)))
      (is (= 3 (-> (nth children 2) :ui-state :value))))))

(deftest reconcile-children-refreshes-retained-ui-state-bindings
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/child-mutation-probe.roo")
    (runtime/push-mode! app 'child-binding-reconciliation-root)
    (let [owner (runtime/find-view app "child-binding-reconciliation-owner")
          first-child (head (ui/children owner))]
      (ui/set-ui-state! first-child
                        (assoc (:ui-state first-child) :sentinel :retained))
      (ui/set-ui-state! owner
                        (assoc (:ui-state owner)
                               :items [{:value :second-updated}
                                       {:value :first-updated}]
                               :reconcile? true)))
    (runtime/update! app)
    (let [children (ui/children
                    (runtime/find-view app "child-binding-reconciliation-owner"))]
      (is (= ["second" "first"]
             [(:id (head children))
              (:id (nth children 1))]))
      (is (= :second-updated (-> (head children) :ui-state :value)))
      (is (= {:value :first-updated
              :sentinel :retained}
             (select-keys (:ui-state (nth children 1))
                          [:value :sentinel]))))))
