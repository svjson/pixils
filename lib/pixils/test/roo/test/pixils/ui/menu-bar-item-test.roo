(ns pixils.ui.menu-bar-item-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test.runtime :as runtime]
            [pixils.ui.menu-bar-item :as menu-bar-item]))

(defun app-for [mode]
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file! app "pixils/test/menu-bar-probe.roo")
    (runtime/push-mode! app mode)
    (runtime/settle-layout! app)
    app))



;; pixils.ui.menu-bar-item/make

(deftest make/supplies-the-stable-label-directly-to-the-text-child
  (is (= {:mode 'ui/menu-bar-item
          :style {:padding [2 8]}
          :state-policy :isolated
          :ui-state {:node {:display-text "File"}
                     :menu-index 2
                     :disabled? nil
                     :active-index 1}
          :children [{:mode 'ui/text
                      :state {:value "File"}}]}
         (let [spec (menu-bar-item/make {:display-text "File"} 2 1)]
           {:mode (:mode spec)
            :style (:style spec)
            :state-policy (:ui/state-policy spec)
            :ui-state (:ui-state spec)
            :children (:children spec)}))))



;; pixils.ui.menu-bar-item/highlighted?

(deftest highlighted?/uses-hover-until-a-menu-is-active
  (is (= [true
          false
          true
          false
          false]
         (for [[ui-state hovered]
               [[{:menu-index 1} true]
                [{:menu-index 1} false]
                [{:menu-index 1 :active-index 1} false]
                [{:menu-index 1 :active-index 0} true]
                [{:menu-index 1 :disabled? true} true]]]
           (menu-bar-item/highlighted? ui-state hovered)))))



;; pixils.ui/menu-bar-item

(deftest menu-bar-item/gives-the-text-child-its-label
  (s/when []
    (let [app (app-for 'menu-action-root)
          text (runtime/find-view app "ui/text")]
      (runtime/view-state text)))

  (s/then [state]
    (is (= {:value "Quit"} state))))

(deftest menu-bar-item/highlights-hover-in-the-windows-3-theme
  (s/given
    (app-for 'menu-windows-3-root))

  (s/when [app]
    (runtime/mouse-move-at! app 170 110)
    (runtime/update! app)
    (runtime/settle-layout! app)
    (let [item (runtime/find-view app "ui/menu-bar-item")
          background-before (-> item :effective-style :background)]
      (runtime/mouse-move-in! app item 1 1)
      (runtime/update! app)
      (runtime/settle-layout! app)
      {:hovered (-> item :interaction :hovered)
       :highlighted (-> item :ui-state :highlighted)
       :background-before background-before
       :background-after (-> item :effective-style :background)}))

  (s/then [result]
    (is (= true (:hovered result)))
    (is (= true (:highlighted result)))
    (is (not= (:background-before result)
              (:background-after result)))))

(deftest menu-bar-item/emits-leaf-actions-without-opening-a-popup
  (s/given
    (app-for 'menu-action-root))

  (s/when [app]
    (runtime/mouse-down-in! app
                            (runtime/find-view app "ui/menu-bar-item")
                            1
                            1)
    (runtime/update! app)
    {:mode (runtime/active-mode-name app)
     :state (runtime/active-state app)})

  (s/then [result]
    (is (= {:mode "menu-action-root"
            :state {:quit true
                    :payload {:source :menu}}}
           result))))

(deftest menu-bar-item/does-not-open-an-empty-item
  (s/given
    (app-for 'menu-static-root))

  (s/when [app]
    (runtime/mouse-down-in! app
                            (runtime/find-view app "ui/menu-bar-item")
                            1
                            1)
    (runtime/update! app)
    {:mode (runtime/active-mode-name app)
     :ui-state (select-keys
                (:ui-state (runtime/find-view app "ui/menu-bar-item"))
                [:highlighted :suppress-next-open?])})

  (s/then [result]
    (is (= {:mode "menu-static-root"
            :ui-state {:highlighted true}}
           result))))
