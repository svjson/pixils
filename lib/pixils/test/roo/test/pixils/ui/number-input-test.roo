(ns pixils.ui.number-input-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.ui.number-input :as number-input]
            [pixils.test.runtime :as runtime]))



;; pixils.ui.number-input/make

(deftest make/preserves-commit-mode
  (is (= :blur
         (-> (number-input/make {:commit-on :blur})
             :state
             :component
             :commit-on))))



;; pixils.ui.number-input/number-input-accepts-text?

(deftest number-input-accepts-text?/accepts-editable-blur-mode-characters
  (let [state {:commit-on :blur
               :allow-negative? true
               :allow-fractions? true}]
    (is (= true
           (number-input/number-input-accepts-text? "" state)))
    (is (= true
           (number-input/number-input-accepts-text? "--1.." state)))
    (is (= false
           (number-input/number-input-accepts-text? "1a" state)))))



;; ui/number-input

(deftest number-input/keeps-editing-state-outside-application-state
  (s/given
    (let [app (runtime/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (runtime/eval-file! app "pixils/test/input-userspace-state-probe.roo")
      (runtime/push-mode! app 'number-input-userspace-state-mode)
      (runtime/settle-layout! app)
      app))

  (s/when [app]
    (runtime/press-key! app :up)
    {:application-state (runtime/active-state app)
     :number-input (select-keys
                    (-> (runtime/find-view app "ui/number-input") :ui-state)
                    [:value :text-value])
     :inner (select-keys
             (-> (runtime/find-view app "ui/text-input-inner") :ui-state)
             [:value])})

  (s/then [result]
    (is (= {:application-state {}
            :number-input {:value 2 :text-value "2"}
            :inner {:value "2"}}
           result))))
