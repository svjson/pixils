(ns pixils.ui.menu-bar-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test.runtime :as runtime]
            [pixils.ui.menu-bar :as menu-bar]))

(defun app-for [mode]
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file! app "pixils/test/menu-bar-probe.roo")
    (runtime/push-mode! app mode)
    (runtime/settle-layout! app)
    app))



;; pixils.ui.menu-bar/make

(deftest make/separates-application-and-component-state
  (s/when []
    (let [spec (menu-bar/make
                {:state {:game :ready}
                 :style {:width 123
                         :height 17}}
                {:items [{:label "File"}]}
                {})]
      {:mode (:mode spec)
       :style (:style spec)
       :state-policy (:ui/state-policy spec)
       :application (select-keys (:state spec) [:game])
       :component (select-keys (-> spec :state :component)
                               [:active-index])
       :child-modes (map (:children spec) :mode)
       :child-state-policy (-> spec :children head :ui/state-policy)
       :child-application-state (-> spec :children head :state)
       :child-inputs (select-keys (-> spec :children head :ui-state)
                                  [:menu-index :disabled?])
       :child-text-state (-> spec :children head :children head :state)
       :dead-child-inputs (select-keys (-> spec :children head :ui-state)
                                       [:text
                                        :option-state
                                        :game
                                        :preferences])}))

  (s/then [result]
    (is (= {:mode 'ui/menu-bar
            :style {:width 123
                    :height 17}
            :state-policy :isolated
            :application {:game :ready}
            :component {}
            :child-modes ['ui/menu-bar-item]
            :child-state-policy :isolated
            :child-application-state nil
            :child-inputs {:menu-index 0}
            :child-text-state {:value "File"}
            :dead-child-inputs {}}
           result))))

(deftest make/preserves-the-application-map-call-shape
  (is (= {:mode 'ui/menu-bar
          :application {:game :ready}
          :style-supplied? false}
         (let [spec (menu-bar/make
                     {:game :ready}
                     {:items [{:label "File"}]}
                     {})]
           {:mode (:mode spec)
            :application (select-keys (:state spec) [:game])
            :style-supplied? (contains? spec :style)}))))

(deftest make/applies-canonical-component-input-precedence
  (is (= {:active-index 3}
         (let [spec (menu-bar/make
                     {:state {:active-index 1
                              :component {:active-index 2}}
                      :active-index 3}
                     {:items [{:label "File"}]}
                     {})]
           (select-keys (-> spec :state :component)
                        [:active-index])))))

(deftest make/preserves-explicit-shared-state-policy
  (is (= :shared
         (:ui/state-policy
          (menu-bar/make
           {:state-policy :shared}
           {:items [{:label "File"}]}
           {})))))



;; pixils.ui/menu-bar

(deftest menu-bar/opens-a-popup-with-the-effective-menu-scale
  (s/given
    (app-for 'menu-scaled-root))

  (s/when [app]
    (runtime/mouse-down-in! app
                            (runtime/find-view app "ui/menu-bar-item")
                            1
                            1)
    (runtime/update! app)
    (runtime/render! app)
    {:mode (runtime/active-mode-name app)
     :popup-visual-scale (-> (runtime/active-mode app) :visual-scale)})

  (s/then [result]
    (is (= {:mode "ui/popup-menu"
            :popup-visual-scale 2}
           result))))

(deftest menu-bar/defaults-an-unscaled-popup-to-unit-scale
  (s/given
    (app-for 'menu-unscaled-root))

  (s/when [app]
    (runtime/mouse-down-in! app
                            (runtime/find-view app "ui/menu-bar-item")
                            1
                            1)
    (runtime/update! app)
    (runtime/render! app)
    {:mode (runtime/active-mode-name app)
     :popup-visual-scale (-> (runtime/active-mode app) :visual-scale)})

  (s/then [result]
    (is (= {:mode "ui/popup-menu"
            :popup-visual-scale 1}
           result))))

(deftest menu-bar/reopens-with-the-next-click-after-anchor-dismissal
  (s/given
    (app-for 'menu-unscaled-root))

  (s/when [app]
    (let [item (runtime/find-view app "ui/menu-bar-item")]
      (runtime/mouse-down-in! app item 1 1)
      (runtime/update! app)
      (runtime/settle-layout! app)
      (let [opened-mode (runtime/active-mode-name app)]
        (runtime/mouse-down-in! app item 1 1)
        (runtime/update! app)
        (let [dismissed-mode (runtime/active-mode-name app)
              reopened-item (runtime/find-view app "ui/menu-bar-item")]
          (runtime/mouse-down-in! app reopened-item 1 1)
          (runtime/update! app)
          (runtime/settle-layout! app)
          {:opened-mode opened-mode
           :dismissed-mode dismissed-mode
           :reopened-mode (runtime/active-mode-name app)}))))

  (s/then [result]
    (is (= {:opened-mode "ui/popup-menu"
            :dismissed-mode "menu-unscaled-root"
            :reopened-mode "ui/popup-menu"}
           result))))

(deftest menu-bar/switches-an-open-popup-with-one-click
  (s/given
    (app-for 'menu-unscaled-root))

  (s/when [app]
    (let [items (runtime/find-views app "ui/menu-bar-item")]
      (runtime/mouse-down-in! app (head items) 1 1)
      (runtime/update! app)
      (runtime/render! app)
      (runtime/mouse-down-in! app (nth items 1) 1 1)
      (runtime/update! app)
      (runtime/settle-layout! app)
      (let [inner (runtime/find-view app "ui/popup-menu-inner")]
        {:popup-mode (runtime/active-mode-name app)
         :popup-label (-> (runtime/find-view app "ui/text") :state :value)
         :navigation {:input-source (-> inner :ui-state :input-source)
                      :active-index (-> inner :ui-state :active-index)}})))

  (s/then [result]
    (is (= {:popup-mode "ui/popup-menu"
            :popup-label "Undo"
            :navigation {:input-source :mouse
                         :active-index nil}}
           result))))

(deftest menu-bar/visually-follows-one-click-switches-between-open-items
  (s/given
    (app-for 'menu-windows-3-root))

  (s/when [app]
    (runtime/mouse-move-at! app 170 110)
    (runtime/update! app)
    (runtime/settle-layout! app)
    (let [items (runtime/find-views app "ui/menu-bar-item")
          normal-background (-> (head items) :effective-style :background)]
      (runtime/mouse-down-in! app (head items) 1 1)
      (runtime/update! app)
      (runtime/settle-layout! app)
      (let [selected-background (-> (head items)
                                    :effective-style
                                    :background)
            after-first (for [item items]
                          (= selected-background
                             (-> item :effective-style :background)))]
        (runtime/mouse-move-in! app (nth items 1) 1 1)
        (runtime/update! app)
        (runtime/render! app)
        (let [after-hovering-second
              (for [item items]
                (= selected-background
                   (-> item :effective-style :background)))]
          (runtime/mouse-down-in! app (nth items 1) 1 1)
          (runtime/update! app)
          (runtime/render! app)
          (let [after-second (for [item items]
                               (= selected-background
                                  (-> item :effective-style :background)))]
            (runtime/mouse-down-in! app (nth items 2) 1 1)
            (runtime/update! app)
            (runtime/render! app)
            {:selected-background-differs? (not= normal-background
                                                    selected-background)
             :after-first after-first
             :after-hovering-second after-hovering-second
             :after-second after-second
             :after-third (for [item items]
                            (= selected-background
                               (-> item :effective-style :background)))})))))

  (s/then [result]
    (is (= {:selected-background-differs? true
            :after-first [true false false]
            :after-hovering-second [true false false]
            :after-second [false true false]
            :after-third [false false true]}
           result))))

(deftest menu-bar/switches-an-open-popup-with-horizontal-arrow-keys
  (s/given
    (app-for 'menu-unscaled-root))

  (s/when [app]
    (runtime/mouse-down-in! app
                            (head (runtime/find-views app "ui/menu-bar-item"))
                            1
                            1)
    (runtime/update! app)
    (runtime/settle-layout! app)
    (runtime/press-key! app :right)
    (runtime/settle-layout! app)
    (let [inner (runtime/find-view app "ui/popup-menu-inner")
          item (runtime/find-view app "ui/popup-menu-item")]
      {:popup-mode (runtime/active-mode-name app)
       :popup-label (-> (runtime/find-view app "ui/text") :state :value)
       :navigation (select-keys (:ui-state inner)
                                [:active-index :input-source])
       :first-row (select-keys (:ui-state item)
                               [:index
                                :active-index
                                :input-source
                                :highlighted])}))

  (s/then [result]
    (is (= {:popup-mode "ui/popup-menu"
            :popup-label "Undo"
            :navigation {:active-index 0
                         :input-source :keyboard}
            :first-row {:index 0
                        :active-index 0
                        :highlighted true}}
           result))))

(deftest menu-bar/inherits-the-theme-font
  (s/when []
    (let [app (app-for 'menu-classic-blue-root)
          text (runtime/find-view app "ui/text")]
      (-> text :effective-style :text :font)))

  (s/then [font]
    (is (= :font/classic-blue-font font))))

(deftest menu-bar/shrinks-to-its-items
  (s/when []
    (let [app (app-for 'menu-windows-3-root)
          menu (runtime/find-view app "ui/menu-bar")
          item (runtime/find-view app "ui/menu-bar-item")]
      {:height (-> menu :effective-style :height)
       :min-height (-> menu :effective-style :min-height)
       :menu-height (-> menu :bounds :h)
       :item-height (-> item :bounds :h)}))

  (s/then [result]
    (is (= {:height :shrink
            :min-height 18
            :menu-height 18
            :item-height 17}
           result))))

(deftest menu-bar/keeps-an-empty-bar-visible
  (s/when []
    (let [app (app-for 'menu-empty-root)
          menu (runtime/find-view app "ui/menu-bar")]
      {:height (-> menu :effective-style :height)
       :min-height (-> menu :effective-style :min-height)
       :bounds-height (-> menu :bounds :h)}))

  (s/then [result]
    (is (= {:height :shrink
            :min-height 18
            :bounds-height 18}
           result))))
