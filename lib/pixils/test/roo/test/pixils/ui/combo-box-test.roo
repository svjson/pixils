(ns pixils.ui.combo-box-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]
            [pixils.ui.combo-box :as combo-box]))



;; Selection queries

(deftest selected-option/preserves-no-selection
  (is (nil? (combo-box/selected-option [{:value :a :label "Alpha"}]
                                       nil))))

(deftest popup-selected-indices/preserves-no-selection
  (is (= []
         (combo-box/popup-selected-indices {:selected-index nil}))))



;; pixils.ui.combo-box/open-popup!

(deftest open-popup!/shrinks-to-fewer-options-than-the-default-maximum
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 320
                                 :buffer-height 240
                                 :render-backend false})]
      (px/eval-file! app "pixils/test/combo-box-probe.roo")
      (px/push-mode! app 'combo-box-short-options-root)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view app "ui/combo-box"))
    (px/settle-layout! app)
    (let [panel (px/find-view app "ui/combo-box-popup-panel")
          option-list (px/find-view app "ui/option-list")
          rows (px/find-views app "ui/combo-box-item")]
      {:mode (px/active-mode-name app)
       :panel-height (-> panel :bounds :h)
       :option-list-height (-> option-list :bounds :h)
       :visible-rows (-> option-list :effective-style :visible-rows)
       :row-heights (for [row rows] (-> row :bounds :h))}))

  (s/then [result]
    (is (= {:mode "ui/combo-box-popup"
            :panel-height 42
            :option-list-height 40
            :visible-rows {:max 10}
            :row-heights [20 20]}
           result))))
