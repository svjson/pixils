(ns pixils.ui.icon-container-test
  (:require proof.core
            [pixils.test :as px]))

(deftest icon-grid-can-bind-scroll-content-state-from-owner
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/icon-grid-binding-probe.roo")
    (px/push-mode! app 'root-mode)
    (is (= [{:id :one} {:id :two} {:id :three}]
           (:items
            (:state
             (px/find-view app "bound-grid-owner")))))
    (px/settle-layout! app)
    (is (= [{:id :one} {:id :two} {:id :three}]
           (:items
            (:state
             (px/find-view app "bound-grid-owner")))))
    (is (= [{:id :one} {:id :two} {:id :three}]
           (get-in (-> (px/find-view app "ui/scroll-pane") :state)
                   [:content-state :items])))
    (is (= 48
           (get-in (-> (px/find-view app "ui/scroll-pane") :ui-state)
                   [:content-size :h])))
    (is (= {:id :one}
           (:item
            (:state
             (head (px/find-views app "ui/icon"))))))))
