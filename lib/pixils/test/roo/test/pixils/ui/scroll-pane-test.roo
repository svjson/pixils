(ns pixils.ui.scroll-pane-test
  (:require proof.core
            [pixils.test :as px]))

(defun fill-scroll-pane-probe-source []
  "(ns pixils.test.fill-scroll-pane-probe
     (:require pixils
               [pixils.ui.scroll-pane :as scroll-pane]))

   (pixils/defmode root-mode
     {:style {:width 100
              :height 80}
      :children [(scroll-pane/make
                  {:style {:width :fill
                           :height :fill}
                   :content-size {:w 100
                                  :h 200}
                   :children [{:style {:width 100
                                       :height 200}}]})]})")

(deftest fill-sized-scroll-pane-does-not-prefer-full-content-height
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (fill-scroll-pane-probe-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [scroll-pane (px/find-view app "ui/scroll-pane")
          viewport (px/find-view app "ui/scroll-pane-viewport")]
      (is (= 80 (:h (:bounds scroll-pane))))
      (is (= true (< (:h (:bounds viewport))
                     200))))))
