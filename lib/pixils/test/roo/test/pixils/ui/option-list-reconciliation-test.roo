(ns pixils.ui.option-list-reconciliation-test
  (:require proof.core
            [pixils.ui :as ui]
            [pixils.test :as px]))

(deftest option-list-reconciles-rows-without-replacing-retained-views
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/option-list-reconciliation-probe.roo")
    (px/push-mode! app 'option-list-reconciliation-root)
    (px/settle-layout! app)
    (let [scroll-pane (px/find-view app "ui/scroll-pane")
          first-row (head (px/find-views app "preserved-option-row"))]
      (ui/set-ui-state! scroll-pane
                        (assoc (:ui-state scroll-pane) :sentinel :scroll-pane))
      (ui/set-ui-state! first-row
                        (assoc (:ui-state first-row) :sentinel :first-row)))
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :expanded? true
            :selected [1]))
    (px/settle-layout! app)
    (let [scroll-pane (px/find-view app "ui/scroll-pane")
          rows (px/find-views app "preserved-option-row")]
      (is (= 3 (count rows)))
      (is (= :scroll-pane (-> scroll-pane :ui-state :sentinel)))
      (is (= :first-row (-> (nth rows 1) :ui-state :sentinel)))
      (is (= "Updated Alpha" (-> (nth rows 1) :ui-state :label)))
      (is (= false (-> (head rows) :ui-state :selected)))
      (is (= true (-> (nth rows 1) :ui-state :selected))))))
