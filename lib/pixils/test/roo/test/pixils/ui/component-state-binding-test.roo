(ns pixils.ui.component-state-binding-test
  (:require proof.core
            [pixils.test :as px]))

(deftest isolated-parent-preserves-default-child-state-policy
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'root-mode)
    (is (= 1
           (:value
            (:ui-state
             (px/find-view app "component-state-child")))))
    (px/update! app)
    (is (= 99
           (:value
            (:ui-state
             (px/find-view app "component-state-parent")))))
    (is (= 99
           (:value
            (:state
             (px/find-view app "component-state-child")))))
    (is (nil? (:value (px/active-state app))))))

(deftest parent-ui-state-changes-propagate-to-existing-child
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'parent-driven-state-root-mode)
    (is (= 1
           (:value
            (:ui-state
             (px/find-view app "parent-driven-state-child")))))
    (px/set-active-state! app {:advance? true})
    (px/update! app)
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "parent-driven-state-parent")))))
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "parent-driven-state-child")))))))

(deftest replaced-child-initializes-ui-state-from-current-parent
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'replacement-state-root-mode)
    (is (= 1
           (:value
            (:ui-state
             (px/find-view app "replacement-state-child")))))
    (px/set-active-state! app {:advance? true})
    (px/update! app)
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "replacement-state-parent")))))
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "replacement-state-child")))))))

(deftest consume-state-propagates-child-state-to-parent-only
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'consuming-state-root-mode)
    (is (= :child
           (:produced
            (:state
             (px/find-view app "consuming-state-child")))))
    (is (= :child
           (:received (px/active-state app))))
    (is (= :parent
           (:untouched (px/active-state app))))
    (is (nil? (:cleared (px/active-state app))))))

(deftest consume-state-propagates-child-ui-state-to-parent-only
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'consuming-ui-state-root-mode)
    (is (= :child
           (:produced
            (:ui-state
             (px/find-view app "consuming-ui-state-child")))))
    (is (= :child
           (:received
            (:ui-state
             (px/find-view app "consuming-ui-state-parent")))))
    (is (= :parent
           (:untouched
            (:ui-state
             (px/find-view app "consuming-ui-state-parent")))))
    (is (nil?
         (:cleared
          (:ui-state
           (px/find-view app "consuming-ui-state-parent")))))))

(deftest parent-ui-state-projection-propagates-through-existing-descendants
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'projected-state-root-mode)
    (is (= {:parent 1
            :middle 1
            :leaf 1
            :leaf-initialized-value 1}
           {:parent (-> (px/find-view app "projected-state-parent")
                        :ui-state :value)
            :middle (-> (px/find-view app "projected-state-middle")
                        :ui-state :value)
            :leaf (-> (px/find-view app "projected-state-leaf")
                      :ui-state :value)
            :leaf-initialized-value (-> (px/find-view app "projected-state-leaf")
                                        :ui-state :initialized-value)}))
    (px/set-active-state! app {:advance? true})
    (px/update! app)
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "projected-state-parent")))))
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "projected-state-middle")))))
    (is (= 2
           (:value
            (:ui-state
             (px/find-view app "projected-state-leaf")))))))

(deftest parent-component-state-projection-is-visible-during-descendant-init
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/component-state-binding-probe.roo")
    (px/push-mode! app 'projected-component-state-root-mode)
    (is (= {:parent 1
            :middle 1
            :leaf 1
            :leaf-initialized-value 1}
           {:parent (-> (px/find-view app "projected-component-state-parent")
                        :state :value)
            :middle (-> (px/find-view app "projected-component-state-middle")
                        :state :value)
            :leaf (-> (px/find-view app "projected-component-state-leaf")
                      :state :value)
            :leaf-initialized-value (-> (px/find-view
                                         app
                                         "projected-component-state-leaf")
                                        :state :initialized-value)}))))
