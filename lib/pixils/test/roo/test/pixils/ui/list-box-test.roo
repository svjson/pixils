(ns pixils.ui.list-box-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.ui.list-box :as list-box]
            [pixils.test.runtime :as runtime]))

(deftest list-box-keyboard-target-skips-disabled-options
  (is (= 2
         (list-box/keyboard-target-index
          {:options [{:value :a}
                     {:value :b :disabled? true}
                     {:value :c}]
           :selected-indices [0]
           :anchor-index 0}
          :key/down))))

(deftest navigation-state-transition/preserves-shift-selection-anchor
  (is (= {:anchor-index 2
          :active-index 0}
         (list-box/navigation-state-transition
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [2]
           :anchor-index 2
           :active-index 2}
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [0 1 2]
           :anchor-index 2
           :active-index 0}
          [:selected-indices :active-index]))))

(deftest reorder-at-position/precomputes-drop-geometry
  (is (= {:row-height 10
          :drop-index 3
          :target-index 2
          :drag-top 23}
         (select-keys
          (list-box/reorder-at-position
           {:options [{:value :a}
                      {:value :b}
                      {:value :c}]
            :computed-row-height 10
            :offset {:x 0 :y 0}}
           {:phase :dragging
            :index 0
            :start-position {:x 5 :y 5}}
           {:x 5 :y 28})
          [:row-height :drop-index :target-index :drag-top]))))

(deftest reorder-at-position/uses-quarter-row-overlap-threshold
  (let [state {:options [{:value :a}
                         {:value :b}
                         {:value :c}]
               :computed-row-height 10}]
    (is (= 0
           (:target-index
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 0
              :start-position {:x 5 :y 5}}
             {:x 5 :y 7}))))
    (is (= 1
           (:target-index
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 1
              :start-position {:x 5 :y 15}}
             {:x 5 :y 13}))))
    (is (= {:drop-index 2
            :target-index 1
            :drag-top 3}
           (select-keys
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 0
              :start-position {:x 5 :y 5}}
             {:x 5 :y 8})
            [:drop-index :target-index :drag-top])))
    (is (= {:drop-index 0
            :target-index 0
            :drag-top 7}
           (select-keys
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 1
              :start-position {:x 5 :y 15}}
             {:x 5 :y 12})
            [:drop-index :target-index :drag-top])))))

(deftest navigation-state-transition/follows-external-selection
  (is (= {:anchor-index 2
          :active-index 2}
         (list-box/navigation-state-transition
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [0]
           :anchor-index 0
           :active-index 0}
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [2]
           :anchor-index 0
           :active-index 0}
          [:selected-indices]))))


;;; pixils.ui.list-box/click-selection

(deftest click-selection/excludes-disabled-options-from-shift-range
  (is (= [0 2]
         (list-box/click-selection
          {:options [{:value :a}
                     {:value :b :disabled? true}
                     {:value :c}]
           :multi-select? true
           :selected-indices [0]
           :anchor-index 0}
          {:index 2
           :shift? true
           :ctrl? false}))))

(deftest click-selection/context-click-selects-an-unselected-item
  (is (= [1]
         (list-box/click-selection
          {:options [{:value :a} {:value :b}]
           :multi-select? true
           :selected-indices [0]}
          {:button :right
           :index 1}))))

(deftest click-selection/context-click-preserves-the-current-selection
  (is (= [0 1]
         (list-box/click-selection
          {:options [{:value :a} {:value :b}]
           :multi-select? true
           :selected-indices [0 1]}
          {:button :right
           :index 1}))))


(deftest list-box-initializes-selected-values-from-selected-indices
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (is (= [:a]
           (:selected-values
            (-> (runtime/find-view app "ui/list-box") :ui-state))))))

(deftest list-box-updates-selected-values-with-bound-selection-and-options
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :selected [2]))
    (runtime/update! app)
    (is (= [:c]
           (:selected-values
            (-> (runtime/find-view app "ui/list-box") :ui-state))))
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app)
            :options [{:value :a :label "Alpha"}
                      {:value :b :label "Beta" :disabled? true}
                      {:value :updated :label "Updated"}]))
    (runtime/update! app)
    (is (= [:updated]
           (:selected-values
            (-> (runtime/find-view app "ui/list-box") :ui-state))))
    (is (= {:selected-indices [2]
            :selected-values [:updated]}
           (:last-change (runtime/active-state app))))))

(deftest list-box-emits-selection-change-after-reconciling-options
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app)
            :options [{:value :a :label "Alpha" :disabled? true}
                      {:value :b :label "Beta" :disabled? true}
                      {:value :c :label "Gamma"}]))
    (runtime/update! app)
    (is (= [2] (:selected (runtime/active-state app))))
    (is (= {:selected-indices [2]
            :selected-values [:c]}
           (:last-change (runtime/active-state app))))))

(deftest list-box-rejects-invalid-projected-selections
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :selected []))
    (runtime/update! app)
    (is (= [0]
           (:selected-indices
            (-> (runtime/find-view app "ui/list-box") :ui-state))))
    (is (nil? (:last-change (runtime/active-state app))))
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :selected [0 2]))
    (runtime/update! app)
    (is (= [0]
           (:selected-indices
            (-> (runtime/find-view app "ui/list-box") :ui-state))))
    (is (nil? (:last-change (runtime/active-state app))))))

(deftest list-box-arrow-key-navigation-selects-next-enabled-item
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (do
      (is (= true (-> (runtime/find-view app "ui/list-box")
                      :interaction
                      :focused)))
      (is (= 5 (count (:options
                       (-> (runtime/find-view app "ui/list-box") :ui-state)))))
      (is (= 0 (:anchor-index
                (-> (runtime/find-view app "ui/list-box") :ui-state))))
      (runtime/press-key! app :down)
      (let [state (-> (runtime/find-view app "ui/list-box") :ui-state)
            root-state (runtime/active-state app)]
        (is (nil? (:root-key-down root-state)))
        (is (= [2] (:selected-indices state)))
        (is (= 2 (:anchor-index state)))
        (is (= [2] (:selected root-state)))
        (is (= [:c] (-> root-state :last-change :selected-values)))))))

(deftest list-box-arrow-key-navigation-scrolls-selected-row-into-view
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (do
      (runtime/press-key! app :down)
      (runtime/press-key! app :down)
      (runtime/press-key! app :down)
      (let [state (-> (runtime/find-view app "ui/list-box") :ui-state)]
        (is (= [4] (:selected-indices state)))
        (is (= 30 (-> state :offset :y)))
        (is (= (:offset state)
               (:offset
                (:ui-state
                 (runtime/find-view app "ui/scroll-pane")))))))))


(deftest list-box-activation-reports-committed-selection
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-activation-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (runtime/click! app
                    (head (runtime/find-views app "activating-item")))
    (is (= {:ui-selection []
            :ui-values []
            :application-selection []
            :activation-selection []
            :activation-values []
            :event-order [:selection-change :activate]}
           (let [ui-state (-> (runtime/find-view app "ui/list-box") :ui-state)
                 application-state (runtime/active-state app)
                 activated (:activated application-state)]
             {:ui-selection (:selected-indices ui-state)
              :ui-values (:selected-values ui-state)
              :application-selection (:selected application-state)
              :activation-selection (:selected-indices activated)
              :activation-values (:selected-values activated)
              :event-order (:event-order application-state)})))))


(deftest list-box-reorder-state-has-explicit-lifecycle
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-reorder-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (let [list-box (runtime/find-view app "ui/list-box")
          first-item (head (runtime/find-views app "ui/list-box-item"))]
      (is (= {:phase :idle}
             (:reorder (:ui-state list-box))))
      (runtime/mouse-down-in! app first-item 5 5)
      (runtime/update! app)
      (runtime/mouse-move-in! app list-box 5 28)
      (runtime/update! app)
      (is (= :dragging
             (-> (runtime/find-view app "ui/list-box")
                 :ui-state
                 :reorder
                 :phase)))
      (is (= 0
             (-> (runtime/find-view app "ui/list-box")
                 :ui-state
                 :reorder
                 :index)))
      (runtime/mouse-up-in! app list-box 5 28)
      (runtime/settle-layout! app)
      (is (= {:phase :idle}
             (:reorder
              (:ui-state
               (runtime/find-view app "ui/list-box")))))
      (is (= {:from-index 0
              :to-index 2
              :drop-index 3
              :value :a
              :option {:value :a :label "Alpha"}}
             (:reorder (runtime/active-state app))))
      (let [first-item (head (runtime/find-views app "ui/list-box-item"))
            drop-surface (runtime/find-view app "drop-surface")]
        (runtime/mouse-down-in! app first-item 5 5)
        (runtime/update! app)
        (runtime/mouse-move-in! app drop-surface 5 5)
        (runtime/update! app)
        (is (= :dragging
               (-> (runtime/find-view app "ui/list-box")
                   :ui-state
                   :reorder
                   :phase)))
        (runtime/mouse-up-in! app drop-surface 5 5)
        (runtime/update! app)
        (is (= :ended
               (-> (runtime/find-view app "ui/list-box")
                   :ui-state
                   :reorder
                   :phase)))
        (runtime/settle-layout! app)
        (is (= {:phase :idle}
               (:reorder
                (:ui-state
                 (runtime/find-view app "ui/list-box")))))))))


(deftest list-box-survives-userspace-state-replacement
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/list-box-userspace-state-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (runtime/settle-layout! app)
    (runtime/click! app
                    (nth (runtime/find-views app "ui/list-box-item") 1))
    (runtime/update! app)
    (is (= {} (runtime/active-state app)))
    (is (= [1]
           (:selected-indices
            (-> (runtime/find-view app "ui/list-box") :ui-state))))
    (is (= [:b]
           (:selected-values
            (-> (runtime/find-view app "ui/list-box") :ui-state))))))



;; pixils.ui.list-box/make

(deftest make/custom-item-inherits-stock-selection
  (s/given
    (let [app (runtime/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (runtime/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (runtime/push-mode! app 'inherited-list-item-mode)
      (runtime/settle-layout! app)))

  (s/when [app]
    (let [items (runtime/find-views app "inherited-list-item")]
      (runtime/click! app (nth items 1))
      (runtime/update! app)
      {:item-modes (map items runtime/view-mode-name)
       :application-state (runtime/active-state app)}))

  (s/then [result]
    (is (= {:item-modes ["inherited-list-item"
                         "inherited-list-item"]
            :application-state
            {:selected [1]
             :selection-change {:selected-indices [1]
                                :selected-values [:b]}}}
           result))))

(deftest make/custom-item-can-override-stock-selection
  (s/given
    (let [app (runtime/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (runtime/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (runtime/push-mode! app 'overridden-list-item-mode)
      (runtime/settle-layout! app)))

  (s/when [app]
    (let [items (runtime/find-views app "overridden-list-item")]
      (runtime/click! app (nth items 1))
      (runtime/update! app)
      {:item-modes (map items runtime/view-mode-name)
       :application-state (runtime/active-state app)}))

  (s/then [result]
    (is (= {:item-modes ["overridden-list-item"
                         "overridden-list-item"]
            :application-state
            {:selected [0]
             :selection-change nil
             :custom-click {:index 1
                            :value :b}}}
           result))))

(deftest make/item-context-menu-emits-option-context
  (s/given
    (let [app (runtime/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (runtime/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (runtime/push-mode! app 'item-context-menu-mode)
      (runtime/settle-layout! app)))

  (s/when [app]
    (let [items (runtime/find-views app "ui/list-box-item")]
      (runtime/mouse-click-in! app (nth items 1) 5 5 :right)
      (runtime/update! app)
      (runtime/render! app)
      (is (= "ui/context-menu" (runtime/active-mode-name app)))
      (let [menu-item (runtime/find-view-containing app
                                                    "ui/popup-menu-item"
                                                    "Inspect Beta")]
        (is (some? menu-item))
        (runtime/click! app menu-item)
        (runtime/update! app)
        (:context-action (runtime/active-state app)))))

  (s/then [payload]
    (is (= {:index 1
            :value :b
            :option {:value :b :label "Beta"}
            :action :inspect
            :payload {:provided-index 1}
            :selected-indices [1]
            :selected-values [:b]}
           payload))))
