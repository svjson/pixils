(ns pixils.ui.list-box-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.ui.list-box :as list-box]
            [pixils.ui.option-list :as option-list]
            [pixils.test :as px]))

(deftest list-box-keyboard-target-skips-disabled-options
  (is (= 2
         (list-box/keyboard-target-index
          {:options [{:value :a}
                     {:value :b :disabled? true}
                     {:value :c}]
           :selected-indices [0]
           :anchor-index 0}
          :key/down))))

(deftest navigation-state-transition/preserves-shift-selection-anchor
  (is (= {:anchor-index 2
          :active-index 0}
         (list-box/navigation-state-transition
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [2]
           :anchor-index 2
           :active-index 2}
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [0 1 2]
           :anchor-index 2
           :active-index 0}
          [:selected-indices :active-index]))))

(deftest reorder-at-position/precomputes-drop-geometry
  (is (= {:row-height 10
          :drop-index 3
          :target-index 2
          :drag-top 23}
         (select-keys
          (list-box/reorder-at-position
           {:options [{:value :a}
                      {:value :b}
                      {:value :c}]
            :computed-row-height 10
            :offset {:x 0 :y 0}}
           {:phase :dragging
            :index 0
            :start-position {:x 5 :y 5}}
           {:x 5 :y 28})
          [:row-height :drop-index :target-index :drag-top]))))

(deftest reorder-at-position/uses-quarter-row-overlap-threshold
  (let [state {:options [{:value :a}
                         {:value :b}
                         {:value :c}]
               :computed-row-height 10}]
    (is (= 0
           (:target-index
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 0
              :start-position {:x 5 :y 5}}
             {:x 5 :y 7}))))
    (is (= 1
           (:target-index
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 1
              :start-position {:x 5 :y 15}}
             {:x 5 :y 13}))))
    (is (= {:drop-index 2
            :target-index 1
            :drag-top 3}
           (select-keys
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 0
              :start-position {:x 5 :y 5}}
             {:x 5 :y 8})
            [:drop-index :target-index :drag-top])))
    (is (= {:drop-index 0
            :target-index 0
            :drag-top 7}
           (select-keys
            (list-box/reorder-at-position
             state
             {:phase :dragging
              :index 1
              :start-position {:x 5 :y 15}}
             {:x 5 :y 12})
            [:drop-index :target-index :drag-top])))))

(deftest navigation-state-transition/follows-external-selection
  (is (= {:anchor-index 2
          :active-index 2}
         (list-box/navigation-state-transition
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [0]
           :anchor-index 0
           :active-index 0}
          {:options [{:value :a}
                     {:value :b}
                     {:value :c}]
           :selected-indices [2]
           :anchor-index 0
           :active-index 0}
          [:selected-indices]))))


;;; pixils.ui.list-box/click-selection

(deftest click-selection/excludes-disabled-options-from-shift-range
  (is (= [0 2]
         (list-box/click-selection
          {:options [{:value :a}
                     {:value :b :disabled? true}
                     {:value :c}]
           :multi-select? true
           :selected-indices [0]
           :anchor-index 0}
          {:index 2
           :shift? true
           :ctrl? false}))))

(deftest click-selection/context-click-selects-an-unselected-item
  (is (= [1]
         (list-box/click-selection
          {:options [{:value :a} {:value :b}]
           :multi-select? true
           :selected-indices [0]}
          {:button :right
           :index 1}))))

(deftest click-selection/context-click-preserves-the-current-selection
  (is (= [0 1]
         (list-box/click-selection
          {:options [{:value :a} {:value :b}]
           :multi-select? true
           :selected-indices [0 1]}
          {:button :right
           :index 1}))))


(deftest list-box-initializes-selected-values-from-selected-indices
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (is (= [:a]
           (:selected-values
            (-> (px/find-view app "ui/list-box") :ui-state))))))

(deftest list-box-updates-selected-values-with-bound-selection-and-options
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app) :selected [2]))
    (px/update! app)
    (is (= [:c]
           (:selected-values
            (-> (px/find-view app "ui/list-box") :ui-state))))
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :options [{:value :a :label "Alpha"}
                      {:value :b :label "Beta" :disabled? true}
                      {:value :updated :label "Updated"}]))
    (px/update! app)
    (is (= [:updated]
           (:selected-values
            (-> (px/find-view app "ui/list-box") :ui-state))))
    (is (= {:selected-indices [2]
            :selected-values [:updated]}
           (:last-change (px/active-state app))))))

(deftest list-box-emits-selection-change-after-reconciling-options
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app)
            :options [{:value :a :label "Alpha" :disabled? true}
                      {:value :b :label "Beta" :disabled? true}
                      {:value :c :label "Gamma"}]))
    (px/update! app)
    (is (= [2] (:selected (px/active-state app))))
    (is (= {:selected-indices [2]
            :selected-values [:c]}
           (:last-change (px/active-state app))))))

(deftest list-box-rejects-invalid-projected-selections
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/set-active-state!
     app
     (assoc (px/active-state app) :selected []))
    (px/update! app)
    (is (= [0]
           (:selected-indices
            (-> (px/find-view app "ui/list-box") :ui-state))))
    (is (nil? (:last-change (px/active-state app))))
    (px/set-active-state!
     app
     (assoc (px/active-state app) :selected [0 2]))
    (px/update! app)
    (is (= [0]
           (:selected-indices
            (-> (px/find-view app "ui/list-box") :ui-state))))
    (is (nil? (:last-change (px/active-state app))))))

(deftest list-box-arrow-key-navigation-selects-next-enabled-item
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (do
      (is (= true (-> (px/find-view app "ui/list-box")
                      :interaction
                      :focused)))
      (is (= 5 (count (:options
                       (-> (px/find-view app "ui/list-box") :ui-state)))))
      (is (= 0 (:anchor-index
                (-> (px/find-view app "ui/list-box") :ui-state))))
      (px/press-key! app :down)
      (let [state (-> (px/find-view app "ui/list-box") :ui-state)
            root-state (px/active-state app)]
        (is (nil? (:root-key-down root-state)))
        (is (= [2] (:selected-indices state)))
        (is (= 2 (:anchor-index state)))
        (is (= [2] (:selected root-state)))
        (is (= [:c] (-> root-state :last-change :selected-values)))))))

(deftest list-box-arrow-key-navigation-scrolls-selected-row-into-view
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-keyboard-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (do
      (px/press-key! app :down)
      (px/press-key! app :down)
      (px/press-key! app :down)
      (let [state (-> (px/find-view app "ui/list-box") :ui-state)]
        (is (= [4] (:selected-indices state)))
        (is (= 30 (-> state :offset :y)))
        (is (= (:offset state)
               (:offset
                (:ui-state
                 (px/find-view app "ui/scroll-pane")))))))))


(deftest list-box-activation-reports-committed-selection
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-activation-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/click! app
                    (head (px/find-views app "activating-item")))
    (is (= {:ui-selection []
            :ui-values []
            :application-selection []
            :activation-selection []
            :activation-values []
            :event-order [:selection-change :activate]}
           (let [ui-state (-> (px/find-view app "ui/list-box") :ui-state)
                 application-state (px/active-state app)
                 activated (:activated application-state)]
             {:ui-selection (:selected-indices ui-state)
              :ui-values (:selected-values ui-state)
              :application-selection (:selected application-state)
              :activation-selection (:selected-indices activated)
              :activation-values (:selected-values activated)
              :event-order (:event-order application-state)})))))


(deftest list-box-reorder-state-has-explicit-lifecycle
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-reorder-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [list-box (px/find-view app "ui/list-box")
          first-item (head (px/find-views app "ui/list-box-item"))]
      (is (= {:phase :idle}
             (:reorder (:ui-state list-box))))
      (px/mouse-down-in! app first-item 5 5)
      (px/update! app)
      (px/mouse-move-in! app list-box 5 28)
      (px/update! app)
      (is (= :dragging
             (-> (px/find-view app "ui/list-box")
                 :ui-state
                 :reorder
                 :phase)))
      (is (= 0
             (-> (px/find-view app "ui/list-box")
                 :ui-state
                 :reorder
                 :index)))
      (px/mouse-up-in! app list-box 5 28)
      (px/settle-layout! app)
      (is (= {:phase :idle}
             (:reorder
              (:ui-state
               (px/find-view app "ui/list-box")))))
      (is (= {:from-index 0
              :to-index 2
              :drop-index 3
              :value :a
              :option {:value :a :label "Alpha"}}
             (:reorder (px/active-state app))))
      (let [first-item (head (px/find-views app "ui/list-box-item"))
            drop-surface (px/find-view app "drop-surface")]
        (px/mouse-down-in! app first-item 5 5)
        (px/update! app)
        (px/mouse-move-in! app drop-surface 5 5)
        (px/update! app)
        (is (= :dragging
               (-> (px/find-view app "ui/list-box")
                   :ui-state
                   :reorder
                   :phase)))
        (px/mouse-up-in! app drop-surface 5 5)
        (px/update! app)
        (is (= :ended
               (-> (px/find-view app "ui/list-box")
                   :ui-state
                   :reorder
                   :phase)))
        (px/settle-layout! app)
        (is (= {:phase :idle}
               (:reorder
                (:ui-state
                 (px/find-view app "ui/list-box")))))))))


(deftest list-box-survives-userspace-state-replacement
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (px/eval-file!
     app
     "pixils/test/list-box-userspace-state-probe.roo")
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/click! app
                    (nth (px/find-views app "ui/list-box-item") 1))
    (px/update! app)
    (is (= {} (px/active-state app)))
    (is (= [1]
           (:selected-indices
            (-> (px/find-view app "ui/list-box") :ui-state))))
    (is (= [:b]
           (:selected-values
            (-> (px/find-view app "ui/list-box") :ui-state))))))



;; pixils.ui.option-list/item-view

(deftest item-view/component-provider-uses-complete-option-state
  (is (= {:component 'app/person-row
          :state {:id :ada
                  :name "Ada"}}
         (option-list/item-view 'app/person-row
                                0
                                {:id :ada
                                 :name "Ada"}))))

(deftest item-view/recursively-resolves-function-providers
  (is (= {:component 'app/person-row
          :state {:name "Ada"}}
         (option-list/item-view
          (fn [_index _option]
            (fn [_index _option]
              'app/person-row))
          0
          {:name "Ada"}))))

(deftest item-view/preserves-explicit-declaration-state
  (is (= {:component 'app/person-row
          :class :compact
          :state {:name "Grace"}}
         (option-list/item-view
          {:component 'app/person-row
           :class :compact
           :state {:name "Grace"}}
          0
          {:name "Ada"}))))

(deftest make-item-child/uses-option-identity
  (is (= :ada
         (:id (option-list/make-item-child
               {:item=> 'app/person-row}
               3
               {:id :ada
                :name "Ada"})))))

(deftest make-item-child/prefers-declaration-identity
  (is (= :row-ada
         (:id (option-list/make-item-child
               {:item=> {:id :row-ada
                         :component 'app/person-row}}
               3
               {:id :ada
                :name "Ada"})))))


;; pixils.ui.list-box/make

(deftest make/stabilizes-scrollbar-handle-on-first-frame
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (px/eval!
       app
       "(ns pixils.test.list-box-first-frame-probe
          (:require pixils
                    [pixils.ui.list-box :as list-box]))

        (pixils/defmode root-mode
          {:children [(list-box/make
                       {:options (for [index (range 20)]
                                   {:value index
                                    :label (str \"Item \" index)})
                        :style {:width 100
                                :visible-rows {:max 5}}})]})")
      (px/push-mode! app 'root-mode)
      app))

  (s/when [app]
    (px/frame! app)
    (let [first-track (:bounds (px/find-view app "ui/scrollbar-track"))
          first-handle (:bounds (px/find-view app "ui/scrollbar-handle"))]
      (px/frame! app)
      {:first {:track (select-keys first-track [:w :h])
               :handle (select-keys first-handle [:w :h])}
       :second {:track (select-keys
                        (:bounds (px/find-view app "ui/scrollbar-track"))
                        [:w :h])
                :handle (select-keys
                         (:bounds (px/find-view app "ui/scrollbar-handle"))
                         [:w :h])}}))

  (s/then [geometry]
    (is (= {:first {:track {:w 14 :h 72}
                            :handle {:w 14 :h 15}}
            :second {:track {:w 14 :h 72}
                     :handle {:w 14 :h 15}}}
           geometry))))

(deftest make/uses-item-provider
  (is (= ['app/person-row 'app/person-row]
         (for [child
               (option-list/item-children
                (-> (list-box/make
                     {:options [{:name "Ada"}
                                {:name "Grace"}]
                      :item=> 'app/person-row})
                    :state
                    :component))]
           (:component child)))))

(deftest make/custom-item-inherits-stock-selection
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (px/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (px/push-mode! app 'inherited-list-item-mode)
      (px/settle-layout! app)))

  (s/when [app]
    (let [items (px/find-views app "inherited-list-item")]
      (px/click! app (nth items 1))
      (px/update! app)
      {:item-modes (map items px/view-mode-name)
       :application-state (px/active-state app)}))

  (s/then [result]
    (is (= {:item-modes ["inherited-list-item"
                         "inherited-list-item"]
            :application-state
            {:selected [1]
             :selection-change {:selected-indices [1]
                                :selected-values [:b]}}}
           result))))

(deftest make/custom-item-can-override-stock-selection
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (px/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (px/push-mode! app 'overridden-list-item-mode)
      (px/settle-layout! app)))

  (s/when [app]
    (let [items (px/find-views app "overridden-list-item")]
      (px/click! app (nth items 1))
      (px/update! app)
      {:item-modes (map items px/view-mode-name)
       :application-state (px/active-state app)}))

  (s/then [result]
    (is (= {:item-modes ["overridden-list-item"
                         "overridden-list-item"]
            :application-state
            {:selected [0]
             :selection-change nil
             :custom-click {:index 1
                            :value :b}}}
           result))))

(deftest make/item-context-menu-emits-option-context
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 160
                                 :buffer-height 120
                                 :render-backend false})]
      (px/eval-file!
       app
       "pixils/test/list-box-custom-item-probe.roo")
      (px/push-mode! app 'item-context-menu-mode)
      (px/settle-layout! app)))

  (s/when [app]
    (let [items (px/find-views app "ui/list-box-item")]
      (px/mouse-click-in! app (nth items 1) 5 5 :right)
      (px/update! app)
      (px/render! app)
      (is (= "ui/context-menu" (px/active-mode-name app)))
      (let [menu-item (px/find-view-containing app
                                                    "ui/popup-menu-item"
                                                    "Inspect Beta")]
        (is (some? menu-item))
        (px/click! app menu-item)
        (px/update! app)
        (:context-action (px/active-state app)))))

  (s/then [payload]
    (is (= {:index 1
            :value :b
            :option {:value :b :label "Beta"}
            :action :inspect
            :payload {:provided-index 1}
            :selected-indices [1]
            :selected-values [:b]}
           payload))))
