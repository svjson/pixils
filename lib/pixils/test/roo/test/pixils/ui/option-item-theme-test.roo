(ns pixils.ui.option-item-theme-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]))

(deftest base-theme/highlights-only-items-with-hover-highlight-class
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 180 :buffer-height 160
                                 :render-backend false})]
      (px/eval-file! app "pixils/test/option-item-hover-probe.roo")
      (px/push-mode! app 'root-mode)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/mouse-move-at! app 170 150)
    (px/update! app)
    (px/layout! app)
    (let [list-item (px/find-view app "ui/list-box-item")
          list-background-before (-> list-item :effective-style :background)]
      (px/mouse-move-in! app list-item 3 3)
      (px/update! app)
      (px/layout! app)
      (let [list-result {:hovered (-> list-item :interaction :hovered)
                         :background-before list-background-before
                         :background-after (-> list-item :effective-style :background)}
            combo-box (px/find-view app "ui/combo-box")]
        (px/click! app combo-box)
        (px/settle-layout! app)
        (let [combo-item (px/find-view app "ui/combo-box-item")
              combo-background-before (-> combo-item :effective-style :background)]
          (px/mouse-move-in! app combo-item 3 3)
          (px/update! app)
          (px/layout! app)
          {:list list-result
           :combo {:hovered (-> combo-item :interaction :hovered)
                   :background-before combo-background-before
                   :background-after (-> combo-item :effective-style :background)}}))))

  (s/then [{:keys [list combo]}]
    (is (:hovered list))
    (is (= (:background-before list) (:background-after list)))
    (is (:hovered combo))
    (is (not= (:background-before combo) (:background-after combo)))))

(deftest classic-blue/highlights-list-and-combo-items-with-distinct-colors
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 180 :buffer-height 160
                                 :render-backend false})]
      (px/eval-file! app "pixils/test/option-item-hover-probe.roo")
      (px/push-mode-with-overrides! app
                                         'root-mode
                                         {}
                                         {:theme 'pixils/classic-blue})
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/mouse-move-at! app 170 150)
    (px/update! app)
    (px/layout! app)
    (let [list-item (px/find-view app "ui/list-box-item")
          list-background-before (-> list-item :effective-style :background)]
      (px/mouse-move-in! app list-item 3 3)
      (px/update! app)
      (px/layout! app)
      (let [list-result {:hovered (-> list-item :interaction :hovered)
                         :background-before list-background-before
                         :background-after (-> list-item :effective-style :background)}
            combo-box (px/find-view app "ui/combo-box")]
        (px/click! app combo-box)
        (px/settle-layout! app)
        (let [combo-item (px/find-view app "ui/combo-box-item")
              combo-background-before (-> combo-item :effective-style :background)]
          (px/mouse-move-in! app combo-item 3 3)
          (px/update! app)
          (px/layout! app)
          {:list list-result
           :combo {:hovered (-> combo-item :interaction :hovered)
                   :background-before combo-background-before
                   :background-after (-> combo-item :effective-style :background)}}))))

  (s/then [{:keys [list combo]}]
    (is (:hovered list))
    (is (not= (:background-before list) (:background-after list)))
    (is (:hovered combo))
    (is (not= (:background-before combo) (:background-after combo)))
    (is (not= (:background-after list) (:background-after combo)))))
