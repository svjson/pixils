(ns pixils.ui.tree-view-test
  (:require proof.core
            [pixils.ui.tree-view :as tree-view]
            [pixils.test :as px]))

(def sample-tree
  [{:id :project
    :label "Project"
    :children [{:id :src
                :label "src"
                :children [{:id :main
                            :label "main.roo"}]}
               {:id :readme
                :label "README.md"}]}
   {:id :assets
    :label "Assets"
    :children [{:id :logo
                :label "logo.png"}]}])

(deftest visible-tree-rows-only-reads-children-for-expanded-nodes
  (let [collapsed-adapter {:id (fn [node] (:id node))
                           :label (fn [node] (:label node))
                           :expandable? (fn [node]
                                          (contains? [:project :src :assets]
                                                     (:id node)))
                           :children (fn [node]
                                       (unexpected-collapsed-child-read))}
        adapter {:id (fn [node] (:id node))
                 :label (fn [node] (:label node))
                 :expandable? (fn [node]
                                (contains? [:project :src :assets]
                                           (:id node)))
                 :children (fn [node]
                             (or (:children node) []))}
        collapsed (tree-view/visible-tree-rows collapsed-adapter sample-tree [])
        project-open (tree-view/visible-tree-rows adapter sample-tree [:project])
        src-open (tree-view/visible-tree-rows adapter sample-tree [:project :src])]
    (is (= [:project :assets]
           (map collapsed (fn [row] (:id row)))))
    (is (= [:project :src :readme :assets]
           (map project-open (fn [row] (:id row)))))
    (is (= [:project :src :main :readme :assets]
           (map src-open (fn [row] (:id row)))))))

(deftest make-composes-tree-view-with-visible-rows
  (let [view (tree-view/make {:roots sample-tree
                              :expanded-ids [:project]
                              :selected-id :src
                              :row-height 18
                              :visible-rows 4
                              :content-width 180})
        state (:state view)
        scroll-pane (-> view :children (nth 0))
        row (-> scroll-pane :children (nth 0))
        viewport (-> row :children (nth 0))
        content (-> viewport :children (nth 0))
        tree-root (-> content :children (nth 0))]
    (is (= 'ui/tree-view (:mode view)))
    (is (= 4 (count (:rows state))))
    (is (= [:project :src :readme :assets]
           (map (:rows state) (fn [row] (:id row)))))
    (is (= ["-" "+" "" "+"]
           (map (:rows state) (fn [row] (:disclosure-glyph row)))))
    (is (= :src (:selected-id state)))
    (is (= 18 (:computed-row-height state)))
    (is (= [:project :assets]
           (map (:children tree-root)
                (fn [node]
                  (-> node :state :node :id)))))))

(defun view-center-y [view]
  (int (/ (:h (:bounds view)) 2)))

(defun tree-view-probe-source []
  "(ns pixils.test.tree-view-probe
     (:require pixils
               [pixils.ui :as ui]
               [pixils.ui.tree-view :as tree-view]))

   (def tree
     [{:id :project
       :label \"Project\"
       :children [{:id :src
                   :label \"src\"}
                  {:id :readme
                   :label \"README.md\"}]}])

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              {:expanded []
               :selected nil
               :focused? false
               :last-change nil
               :last-expand nil})
      :update (fn [state ctx]
                (do
                  (when (not (:focused? state))
                    (ui/focus! (head (ui/children ctx))))
                  (assoc state :focused? true)))
      :on {:tree-view/change
           (fn [state event ctx]
             (assoc state
                    :selected (-> event :payload :id)
                    :last-change (:payload event)))
           :tree-view/expand
           (fn [state event ctx]
             (assoc state
                    :expanded [:project]
                    :last-expand (:payload event)))}
      :children [(tree-view/make
                  {:roots tree
                   :expanded-ids (ui/bind-state :expanded)
                   :selected-id (ui/bind-state :selected)
                   :row-height 12
                   :visible-rows 3
                   :content-width 120})]})")

(defun tree-view-themed-disclosure-source []
  "(ns pixils.test.tree-view-themed-disclosure-probe
     (:require pixils
               [pixils.ui.tree-view :as tree-view]))

   (def tree
     [{:id :project
       :label \"Project\"
       :children [{:id :src
                   :label \"src\"
                   :children [{:id :main
                               :label \"main.roo\"}]}
                  {:id :readme
                   :label \"README.md\"}]}
      {:id :assets
       :label \"Assets\"
       :children [{:id :logo
                   :label \"logo.png\"}]}])

   (pixils/defmode root-mode
     {:theme 'pixils/windows-3
      :children [(tree-view/make
                  {:roots tree
                   :expanded-ids [:project]
                   :row-height 12
                   :visible-rows 4
                   :content-width 120})]})")

(defun tree-view-nested-expansion-source []
  "(ns pixils.test.tree-view-nested-expansion-probe
     (:require pixils
               [pixils.ui :as ui]
               [pixils.ui.tree-view :as tree-view]))

   (def tree
     [{:id :project
       :label \"Project\"
       :children [{:id :src
                   :label \"src\"
                   :children [{:id :main
                               :label \"main.roo\"}]}
                  {:id :readme
                   :label \"README.md\"}]}
      {:id :assets
       :label \"Assets\"
       :children [{:id :logo
                   :label \"logo.png\"}]}])

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              {:focused? false})
      :update (fn [state ctx]
                (do
                  (when (not (:focused? state))
                    (ui/focus! (head (ui/children ctx))))
                  (assoc state :focused? true)))
      :children [(tree-view/make
                  {:roots tree
                   :expanded-ids [:project :src]
                   :row-height 12
                   :visible-rows 6
                   :content-width 120})]})")

(defun tree-view-bound-initial-expansion-source []
  "(ns pixils.test.tree-view-bound-initial-expansion-probe
     (:require pixils
               [pixils.ui :as ui]
               [pixils.ui.tree-view :as tree-view]))

   (def tree
     [{:id :project
       :label \"Project\"
       :children [{:id :src
                   :label \"src\"
                   :children [{:id :main
                               :label \"main.roo\"}]}
                  {:id :readme
                   :label \"README.md\"}]}
      {:id :assets
       :label \"Assets\"
       :children [{:id :logo
                   :label \"logo.png\"}]}])

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              {:expanded [:project :src]})
      :children [(tree-view/make
                  {:roots tree
                   :expanded-ids (ui/bind-state :expanded)
                   :row-height 12
                   :visible-rows 6
                   :content-width 120})]})")

(defun tree-view-lazy-adapter-source []
  "(ns pixils.test.tree-view-lazy-adapter-probe
     (:require pixils
               [pixils.ui :as ui]
               [pixils.ui.tree-view :as tree-view]))

   (def root-node {:id :project
                   :label \"Project\"})

   (def child-map
     {:project [{:id :src
                 :label \"src\"}
                {:id :readme
                 :label \"README.md\"}]
      :src [{:id :main
             :label \"main.roo\"}]})

   (def adapter
     {:id (fn [node] (:id node))
      :label (fn [node] (:label node))
      :expandable? (fn [node]
                     (contains? child-map (:id node)))
      :children (fn [node]
                  (or (get child-map (:id node)) []))})

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              {:focused? false})
      :update (fn [state ctx]
                (do
                  (when (not (:focused? state))
                    (ui/focus! (head (ui/children ctx))))
                  (assoc state :focused? true)))
      :children [(tree-view/make
                  {:roots [root-node]
                   :adapter adapter
                   :expanded-ids [:project]
                   :row-height 12
                   :visible-rows 4
                   :content-width 120})]})")

(defun tree-view-scroll-offset-probe-source []
  "(ns pixils.test.tree-view-scroll-offset-probe
     (:require pixils
               [pixils.ui :as ui]
               [pixils.ui.tree-view :as tree-view]))

   (def tree
     [{:id :project
       :label \"Project\"
       :children [{:id :src
                   :label \"src\"
                   :children [{:id :main
                               :label \"main.roo\"}]}
                  {:id :readme
                   :label \"README.md\"}]}
      {:id :assets
       :label \"Assets\"
       :children [{:id :logo
                   :label \"logo.png\"}]}])

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              {:focused? false})
      :update (fn [state ctx]
                (do
                  (when (not (:focused? state))
                    (ui/focus! (head (ui/children ctx))))
                  (assoc state :focused? true)))
      :children [(tree-view/make
                  {:roots tree
                   :expanded-ids [:project :src]
                   :selected-id :assets
                   :row-height 12
                   :visible-rows 3
                   :content-width 120
                   :state {:offset {:x 0 :y 12}}})]})")

(deftest tree-view-keyboard-expands-and-selects-visible-rows
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (tree-view-probe-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/key-down! app :down)
    (px/update! app)
    (px/key-up! app :down)
    (px/update! app)
    (px/key-down! app :right)
    (px/update! app)
    (px/key-up! app :right)
    (px/update! app)
    (px/settle-layout! app)
    (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
          root-state (px/active-state app)]
      (is (= :project (:selected root-state)))
      (is (= :project (-> root-state :last-change :id)))
      (is (= :project (-> root-state :last-expand :id)))
      (is (= [:project] (:expanded-ids tree-state)))
      (is (= 3 (count (:rows tree-state)))))))

(deftest tree-view-mouse-disclosure-expands-bound-tree
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (tree-view-probe-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [item (px/find-view app "ui/tree-view-item")]
      (px/mouse-down-in! app item 2 (view-center-y item))
      (px/update! app)
      (px/mouse-up-in! app item 2 (view-center-y item))
      (px/update! app)
      (px/settle-layout! app)
      (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
            root-state (px/active-state app)]
        (is (= :project (-> root-state :last-expand :id)))
        (is (= [:project] (:expanded-ids tree-state)))
        (is (= 3 (count (:rows tree-state))))))))

(deftest tree-view-expansion-preserves-scroll-pane-offset
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (tree-view-scroll-offset-probe-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [before-state (px/view-state (px/find-view app "ui/tree-view"))
          before-scroll-ui-state (-> (px/find-view app "ui/scroll-pane")
                                     :ui-state)]
      (is (= {:x 0 :y 12} (:offset before-scroll-ui-state)))
      (is (= [:project :src] (:expanded-ids before-state)))
      (is (= 5 (count (:rows before-state))))
      (px/key-down! app :right)
      (px/update! app)
      (px/key-up! app :right)
      (px/update! app)
      (px/settle-layout! app)
      (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
            scroll-ui-state (-> (px/find-view app "ui/scroll-pane")
                                :ui-state)]
        (is (= [:project :src :assets] (:expanded-ids tree-state)))
        (is (= 6 (count (:rows tree-state))))
        (is (= {:x 0 :y 12} (:offset scroll-ui-state)))))))

(deftest tree-view-disclosure-glyphs-follow-theme-and-expanded-state
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (tree-view-themed-disclosure-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [items (px/find-views app "ui/tree-view-item")
          disclosures (px/find-views app "ui/tree-view-disclosure")]
      (is (= ["-" "+" "" "+"]
             (map items
                  (fn [view]
                    (-> (px/view-state view) :row :disclosure-glyph)))))
      (is (= ["-" "+" "" "+"]
             (map items
                  (fn [view]
                    (:disclosure-glyph (px/view-state view))))))
      (is (= [true false false false]
             (map disclosures
                  (fn [view]
                    (-> (px/view-state view) :row :expanded?)))))
      (is (= [true true false true]
             (map disclosures
                  (fn [view]
                    (:expandable? (px/view-state view))))))
      (is (= ["-" "+" "" "+"]
             (map disclosures
                  (fn [view]
                    (-> (px/view-state view) :row :disclosure-glyph))))))))

(deftest tree-view-renders-expanded-rows-without-empty-visual-space
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 140
                               :render-backend false})]
    (px/eval! app (tree-view-nested-expansion-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/settle-layout! app)
    (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
          item-ids (map (px/find-views app "ui/tree-view-item")
                        (fn [view]
                          (-> (px/view-state view) :row :id)))
          item-expanded (map (px/find-views app "ui/tree-view-item")
                             (fn [view]
                               (-> (px/view-state view) :row :expanded?)))]
      (is (= [:project :src] (:expanded-ids tree-state)))
      (is (= [:project :src :main :readme :assets]
             (map (:rows tree-state) (fn [row] (:id row)))))
      (is (= [true true false false false] item-expanded))
      (is (= [:project :src :main :readme :assets]
             item-ids)))))

(deftest tree-view-renders-bound-initial-expanded-state
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 140
                               :render-backend false})]
    (px/eval! app (tree-view-bound-initial-expansion-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (px/settle-layout! app)
    (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
          item-ids (map (px/find-views app "ui/tree-view-item")
                        (fn [view]
                          (-> (px/view-state view) :row :id)))
          item-glyphs (map (px/find-views app "ui/tree-view-item")
                           (fn [view]
                             (-> (px/view-state view) :row :disclosure-glyph)))]
      (is (= [:project :src] (:expanded-ids tree-state)))
      (is (= [:project :src :main :readme :assets]
             (map (:rows tree-state) (fn [row] (:id row)))))
      (is (= [:project :src :main :readme :assets]
             item-ids))
      (is (= ["-" "-" "" "" "+"]
             item-glyphs)))))

(deftest tree-view-renders-children-from-lazy-adapter
  (let [app (px/make-app {:package-root "../.."
                               :buffer-width 180
                               :buffer-height 120
                               :render-backend false})]
    (px/eval! app (tree-view-lazy-adapter-source))
    (px/push-mode! app 'root-mode)
    (px/settle-layout! app)
    (let [tree-state (px/view-state (px/find-view app "ui/tree-view"))
          item-ids (map (px/find-views app "ui/tree-view-item")
                        (fn [view]
                          (-> (px/view-state view) :row :id)))]
      (is (= [:project] (:expanded-ids tree-state)))
      (is (= [:project :src :readme]
             (map (:rows tree-state) (fn [row] (:id row)))))
      (is (= [:project :src :readme] item-ids)))))
