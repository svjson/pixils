(ns pixils.ui.popover-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]))



;; pixils.ui.popover/make-trigger

(deftest make-trigger/toggles-the-local-popover
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 800
                                 :buffer-height 600
                                 :render-backend false})]
      (px/eval-file! app "pixils/test/popover-trigger-probe.roo")
      (px/push-mode! app 'popover-trigger-root)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (let [popover (px/find-view app "ui/popover")
          before {:present? (some? popover)
                  :open? (:open? (px/view-state popover))}]
      (px/click! app
                      (px/find-view app "ui/popover-trigger-control"))
      (px/settle-layout! app)
      {:before before
       :after {:open? (:open? (px/view-state
                               (px/find-view app "ui/popover")))}}))

  (s/then [result]
    (is (= {:before {:present? true
                     :open? false}
            :after {:open? true}}
           result))))



;; pixils.ui.popover/open!

(deftest open!/pushes-an-overlay-mode
  (s/given
    (let [app (px/make-app {:package-root "../.."
                                 :buffer-width 320
                                 :buffer-height 240
                                 :render-backend false})]
      (px/eval-file! app "pixils/test/popover-open-probe.roo")
      (px/push-mode! app 'popover-open-root)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app (px/find-view app "ui/button"))
    (px/update! app)
    {:mode (px/active-mode-name app)
     :popover? (some? (px/find-view app "ui/popover"))})

  (s/then [opened]
    (is (= {:mode "ui/popover-overlay"
            :popover? true}
           opened))))
