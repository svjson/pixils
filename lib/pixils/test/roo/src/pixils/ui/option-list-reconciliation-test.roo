(ns pixils.ui.option-list-reconciliation-test
  (:require proof.core
            [pixils.ui :as ui]
            [pixils.test.runtime :as runtime]))

(deftest option-list-reconciles-rows-without-replacing-retained-views
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "pixils/test/option-list-reconciliation-probe.roo")
    (runtime/push-mode! app 'option-list-reconciliation-root)
    (runtime/settle-layout! app)
    (let [scroll-pane (runtime/find-view app "ui/scroll-pane")
          first-row (head (runtime/find-views app "preserved-option-row"))]
      (ui/set-ui-state! scroll-pane
                        (assoc (:ui-state scroll-pane) :sentinel :scroll-pane))
      (ui/set-ui-state! first-row
                        (assoc (:ui-state first-row) :sentinel :first-row)))
    (runtime/set-active-state!
     app
     (assoc (runtime/active-state app) :expanded? true))
    (runtime/settle-layout! app)
    (let [scroll-pane (runtime/find-view app "ui/scroll-pane")
          rows (runtime/find-views app "preserved-option-row")]
      (is (= 3 (count rows)))
      (is (= :scroll-pane (-> scroll-pane :ui-state :sentinel)))
      (is (= :first-row (-> (head rows) :ui-state :sentinel)))
      (is (= "Updated Alpha" (-> (head rows) :ui-state :label))))))
