(defun explicit-offscreen-window-probe-source []
  "(ns pixils.test.explicit-offscreen-window-probe
     (:require pixils
               pixils.ui.window))

   (pixils/defcomponent probe-body
     {:style {:width 80
              :height 40}})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:position {:x -30 :y -20}
                   :style {:width 80
                           :height 56}
                   :title-bar {:title \"Explicit\"}
                   :body [{:mode 'probe-body}]})]})")

(defun modal-overlay-focus-probe-source []
  "(ns pixils.test.modal-overlay-focus-probe
     (:require pixils
               [pixils.ui :as ui]
               pixils.ui.dialog
               pixils.ui.text-input))

   (pixils/defcomponent probe-dialog-body
     {:class :ui/content
      :style {:width 80
              :height 40
              :padding 4}
      :children [{:mode 'ui/text-input
                  :style {:width 70
                          :height 24}
                  :state {:value \"hello\"
                          :auto-focus? true}}]})

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              (do
                (pixils.ui.dialog/open-dialog!
                 ctx
                 {:title \"Focus Probe\"
                  :style {:width 100
                          :height 64}
                  :body [{:mode 'probe-dialog-body}]})
                state))})")

(deftest window-make-composes-standard-chrome-by-default
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (standard-window-map-probe-source))
        children (:children window)
        title-bar (nth children 0)
        body (nth children 1)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :window (:window/kind state)))
    (is (= :standard (:window/chrome state)))
    (is (= true (contains? (:class window) :window/kind-window)))
    (is (= true (contains? (:class window) :window/chrome-standard)))
    (is (= true (-> state :window/capabilities :movable?)))
    (is (= true (-> state :window/capabilities :minimizable?)))
    (is (= 2 (count children)))
    (is (= 'ui/window-title-bar (:mode title-bar)))
    (is (= 'ui/window-body (:mode body)))))

(deftest window-make-composes-regular-frame-without-title-bar
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (frame-window-map-probe-source))
        children (:children window)
        body (nth children 0)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :window (:window/kind state)))
    (is (= :frame (:window/chrome state)))
    (is (= true (contains? (:class window) :window/chrome-frame)))
    (is (= false (-> state :window/capabilities :movable?)))
    (is (= false (-> state :window/capabilities :minimizable?)))
    (is (= false (-> state :window/capabilities :system-menu?)))
    (is (= 1 (count children)))
    (is (= 'ui/window-body (:mode body)))
    (is (= [{:mode 'probe-body}] (:children body)))))

(deftest window-make-composes-dialog-frame-without-title-bar
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (dialog-frame-window-map-probe-source))
        children (:children window)
        body (nth children 0)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :dialog-frame (:window/kind state)))
    (is (= :dialog-frame (:window/chrome state)))
    (is (= true (contains? (:class window) :window/kind-dialog-frame)))
    (is (= true (contains? (:class window) :window/chrome-dialog-frame)))
    (is (= false (-> state :window/capabilities :movable?)))
    (is (= false (-> state :window/capabilities :minimizable?)))
    (is (= 1 (count children)))
    (is (= 'ui/window-body (:mode body)))))

(deftest window-without-explicit-position-centers-in-buffer
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= 40 (:x (:position state))))
      (is (= 32 (:y (:position state))))
      (is (= 40 (:x (:bounds window))))
      (is (= 32 (:y (:bounds window)))))))

(deftest implicit-natural-size-window-stays-offscreen-until-it-can-center
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (natural-size-centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (runtime/update! app)
    (runtime/layout! app)
    (let [first-window (runtime/find-view app "ui/window")
          first-state (runtime/view-state first-window)]
      (is (= false (:window/explicit-position? first-state)))
      (is (= nil (:position first-state)))
      (is (< (:x (:bounds first-window)) 0))
      (is (< (:y (:bounds first-window)) 0)))
    (runtime/update! app)
    (runtime/layout! app)
    (let [centered-window (runtime/find-view app "ui/window")
          centered-state (runtime/view-state centered-window)]
      (is (> (:x (:position centered-state)) 0))
      (is (> (:y (:position centered-state)) 0))
      (is (= (:x (:position centered-state)) (:x (:bounds centered-window))))
      (is (= (:y (:position centered-state)) (:y (:bounds centered-window)))))))

(deftest scaled-window-without-explicit-position-centers-visual-bounds
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 120
                               :buffer-height 90
                               :render-backend false})]
    (runtime/eval! app (centered-scaled-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= 20 (:x (:position state))))
      (is (= 15 (:y (:position state))))
      (is (= 20 (:x (:bounds window))))
      (is (= 15 (:y (:bounds window))))
      (is (= 80 (:w (:external-bounds window))))
      (is (= 60 (:h (:external-bounds window)))))))

(deftest window-make-applies-body-style
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (body-style-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [body (runtime/find-view app "ui/window-body")]
      (is (= 40 (:h (:bounds body)))))))

(deftest window-autofocuses-by-default
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (autofocus-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")]
      (is (= true (-> window :interaction :focused)))
      (is (= true (-> window :interaction :focus-within))))))

(deftest child-autofocus-wins-over-window-autofocus
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (child-autofocus-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          input (runtime/find-view app "ui/text-input-inner")]
      (is (= false (-> window :interaction :focused)))
      (is (= true (-> window :interaction :focus-within)))
      (is (= true (-> input :interaction :focused))))))

(deftest window-autofocus-can-be-disabled
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (autofocus-disabled-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")]
      (is (= false (-> window :interaction :focused)))
      (is (= false (-> window :interaction :focus-within))))))

(deftest oversized-window-without-explicit-position-keeps-chrome-on-screen
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 100
                               :buffer-height 80
                               :render-backend false})]
    (runtime/eval! app (oversized-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= 0 (:x (:position state))))
      (is (= 0 (:y (:position state))))
      (is (= 0 (:x (:bounds window))))
      (is (= 0 (:y (:bounds window))))
      (is (= true (>= (:x (:bounds title-bar)) 0)))
      (is (= true (>= (:y (:bounds title-bar)) 0)))
      (is (= true (< (:x (:bounds title-bar)) 100)))
      (is (= true (< (:y (:bounds title-bar)) 80))))))

(deftest explicit-offscreen-window-position-is-preserved
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (explicit-offscreen-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= true (:window/explicit-position? state)))
      (is (= -30 (:x (:position state))))
      (is (= -20 (:y (:position state))))
      (is (= -30 (:x (:bounds window))))
      (is (= -20 (:y (:bounds window)))))))

(deftest modal-overlay-mouse-down-preserves-dialog-focus
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (modal-overlay-focus-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          input (runtime/find-view app "ui/text-input-inner")]
      (is (= true (-> input :interaction :focused)))
      (is (= true (-> window :interaction :focus-within)))
      (runtime/mouse-down-at! app 2 2)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-overlay-click (runtime/find-view app "ui/window")
            input-after-overlay-click (runtime/find-view app "ui/text-input-inner")]
        (is (= true (-> input-after-overlay-click :interaction :focused)))
        (is (= true (-> window-after-overlay-click
                        :interaction
                        :focus-within)))))))

(deftest dialog-window-without-explicit-position-centers-in-buffer
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (centered-dialog-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= 40 (:x (:position state))))
      (is (= 32 (:y (:position state))))
      (is (= 40 (:x (:bounds window))))
      (is (= 32 (:y (:bounds window)))))))

(deftest dragged-window-keeps-latest-position-after-follow-up-interaction
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (window-move-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")]
      (is (= 24 (:x (:bounds window))))
      (is (= 20 (:y (:bounds window))))
      (runtime/mouse-down-in! app title-bar 40 9)
      (runtime/update! app)
      (runtime/mouse-move-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [position (:position (runtime/view-state (runtime/find-view app "ui/window")))]
        (is (= 55 (:x position)))
        (is (= 37 (:y position))))
      (runtime/mouse-up-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-drag (runtime/find-view app "ui/window")
            probe-body (runtime/find-view app "probe-body")]
        (is (= 55 (:x (:bounds window-after-drag))))
        (is (= 37 (:y (:bounds window-after-drag))))
        (runtime/mouse-down-in! app probe-body 4 4)
        (runtime/update! app)
        (runtime/layout! app)
        (let [window-after-body-press (runtime/find-view app "ui/window")
              probe-body-after-press (runtime/find-view app "probe-body")]
          (is (= 55 (:x (:bounds window-after-body-press))))
          (is (= 37 (:y (:bounds window-after-body-press))))
          (is (= 1 (:presses (runtime/view-state probe-body-after-press)))))))))

(deftest fixed-frame-chrome-ignores-window-move-events
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (fixed-frame-move-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          body (runtime/find-view app "move-emitter-body")]
      (is (= 24 (:x (:bounds window))))
      (is (= 20 (:y (:bounds window))))
      (runtime/mouse-down-in! app body 4 4)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-move-event (runtime/find-view app "ui/window")
            state (runtime/view-state window-after-move-event)]
        (is (= 24 (:x (:bounds window-after-move-event))))
        (is (= 20 (:y (:bounds window-after-move-event))))
        (is (= 24 (:x (:position state))))
        (is (= 20 (:y (:position state))))
        (is (not (= true (:window/moved? state))))))))
