    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (do
      (press-key! app :tab)
      (is (= true (focused-button app "First")))
      (press-key! app :tab)
      (is (= true (focused-consuming-button app)))
      (press-key! app :tab)
      (is (= true (focused-consuming-button app)))
      (is (= true (:tab-consumed?
                   (runtime/view-state
                    (runtime/find-view app "tab-consuming-button"))))))))

