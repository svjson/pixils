                               :render-backend false})]
    (runtime/eval! app (tab-focus-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (do
      (press-shift-tab! app)
      (is (= true (focused-button app "Third")))
      (press-shift-tab! app)
      (is (= true (focused-button app "Second")))
      (press-shift-tab! app)
      (is (= false (focused-button app "Disabled")))
      (is (= true (focused-button app "First"))))))

(deftest focused_view_can_consume_tab_key
