(defun modal-overlay-focus-probe-source []
  "(ns pixils.test.modal-overlay-focus-probe
     (:require pixils
               [pixils.ui :as ui]
               pixils.ui.dialog
               pixils.ui.text-input))

   (pixils/defcomponent probe-dialog-body
     {:class :ui/content
      :style {:width 80
              :height 40
              :padding 4}
      :children [{:mode 'ui/text-input
                  :style {:width 70
                          :height 24}
                  :state {:value \"hello\"
                          :auto-focus? true}}]})

   (pixils/defmode root-mode
     {:init (fn [state ctx]
              (do
                (pixils.ui.dialog/open-dialog!
                 ctx
                 {:title \"Focus Probe\"
                  :style {:width 100
                          :height 64}
                  :body [{:mode 'probe-dialog-body}]})
                state))})")

(deftest window-make-composes-standard-chrome-by-default
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (standard-window-map-probe-source))
        children (:children window)
        title-bar (nth children 0)
        body (nth children 1)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :window (:window/kind state)))
    (is (= :standard (:window/chrome state)))
    (is (= true (contains? (:class window) :window/kind-window)))
    (is (= true (contains? (:class window) :window/chrome-standard)))
    (is (= true (-> state :window/capabilities :movable?)))
    (is (= true (-> state :window/capabilities :minimizable?)))
    (is (= 2 (count children)))
    (is (= 'ui/window-title-bar (:mode title-bar)))
    (is (= 'ui/window-body (:mode body)))))

(deftest window-make-composes-regular-frame-without-title-bar
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (frame-window-map-probe-source))
        children (:children window)
        body (nth children 0)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :window (:window/kind state)))
    (is (= :frame (:window/chrome state)))
    (is (= true (contains? (:class window) :window/chrome-frame)))
    (is (= false (-> state :window/capabilities :movable?)))
    (is (= false (-> state :window/capabilities :minimizable?)))
    (is (= false (-> state :window/capabilities :system-menu?)))
    (is (= 1 (count children)))
    (is (= 'ui/window-body (:mode body)))
    (is (= [{:mode 'probe-body}] (:children body)))))

(deftest window-make-composes-dialog-frame-without-title-bar
  (let [app (runtime/make-app {:package-root "../.."
                               :render-backend false})
        window (runtime/eval! app (dialog-frame-window-map-probe-source))
        children (:children window)
        body (nth children 0)
        state (:state window)]
    (is (= 'ui/window (:mode window)))
    (is (= :dialog-frame (:window/kind state)))
    (is (= :dialog-frame (:window/chrome state)))
    (is (= true (contains? (:class window) :window/kind-dialog-frame)))
    (is (= true (contains? (:class window) :window/chrome-dialog-frame)))
    (is (= false (-> state :window/capabilities :movable?)))
    (is (= false (-> state :window/capabilities :minimizable?)))
    (is (= 1 (count children)))
    (is (= 'ui/window-body (:mode body)))))

(deftest window-without-explicit-position-centers-in-buffer
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= (centered-axis 160 (:w (:bounds window)))
             (:x (:position state))))
      (is (= (centered-axis 120 (:h (:bounds window)))
             (:y (:position state))))
      (is (= (:x (:position state)) (:x (:bounds window))))
      (is (= (:y (:position state)) (:y (:bounds window)))))))

(deftest implicit-natural-size-window-centers-after-first-layout
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (natural-size-centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (runtime/update! app)
    (runtime/layout! app)
    (let [centered-window (runtime/find-view app "ui/window")
          centered-state (runtime/view-state centered-window)]
      (is (= false (:window/explicit-position? centered-state)))
      (is (> (:x (:position centered-state)) 0))
      (is (> (:y (:position centered-state)) 0))
      (is (= (:x (:position centered-state)) (:x (:bounds centered-window))))
      (is (= (:y (:position centered-state)) (:y (:bounds centered-window))))
      (runtime/layout! app)
      (let [stable-window (runtime/find-view app "ui/window")]
        (is (= (:bounds centered-window)
               (:bounds stable-window)))))))

(deftest implicit-natural-size-window-does-not-drift-during-first-rendered-frames
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (natural-size-centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (layout-frame! app)
    (let [first-window (runtime/find-view app "ui/window")
          first-title-bar (runtime/find-view app "ui/window-title-bar")
          first-body (runtime/find-view app "ui/window-body")
          first-window-bounds (:bounds first-window)
          first-title-bounds (:bounds first-title-bar)
          first-body-bounds (:bounds first-body)
          first-state (runtime/view-state first-window)
          first-chrome (window-chrome-snapshot app "Natural")]
      (is (= false (:window/explicit-position? first-state)))
      (is (= (:x (:position first-state)) (:x first-window-bounds)))
      (is (= (:y (:position first-state)) (:y first-window-bounds)))
      (assert-window-chrome-contained! app "Natural")
      (assert-view-rendered! app first-title-bar)
      (layout-frame! app)
      (let [second-window (runtime/find-view app "ui/window")
            second-title-bar (runtime/find-view app "ui/window-title-bar")
            second-body (runtime/find-view app "ui/window-body")
            second-chrome (window-chrome-snapshot app "Natural")]
        (is (= first-window-bounds (:bounds second-window)))
        (is (= first-title-bounds (:bounds second-title-bar)))
        (is (= first-body-bounds (:bounds second-body)))
        (is (= first-chrome second-chrome))
        (assert-window-chrome-contained! app "Natural")
        (assert-view-rendered! app second-title-bar))
      (layout-frame! app)
      (let [third-window (runtime/find-view app "ui/window")
            third-title-bar (runtime/find-view app "ui/window-title-bar")
            third-body (runtime/find-view app "ui/window-body")
            third-chrome (window-chrome-snapshot app "Natural")]
        (is (= first-window-bounds (:bounds third-window)))
        (is (= first-title-bounds (:bounds third-title-bar)))
        (is (= first-body-bounds (:bounds third-body)))
        (is (= first-chrome third-chrome))
        (assert-window-chrome-contained! app "Natural")
        (assert-view-rendered! app third-title-bar)))))

(deftest implicit-natural-size-window-recenters-when-content-size-changes
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 140
                               :render-backend false})]
    (runtime/eval! app (dynamic-natural-size-centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [before-window (runtime/find-view app "ui/window")
          before-bounds (:bounds before-window)
          body (runtime/find-view app "dynamic-body")]
      (runtime/mouse-down-in! app body 4 4)
      (runtime/update! app)
      (runtime/layout! app)
      (let [after-window (runtime/find-view app "ui/window")
            after-state (runtime/view-state after-window)
            after-bounds (:bounds after-window)]
        (is (= true (> (:h after-bounds) (:h before-bounds))))
        (is (= true (< (:y after-bounds) (:y before-bounds))))
        (is (= (:x (:position after-state)) (:x after-bounds)))
        (is (= (:y (:position after-state)) (:y after-bounds)))))))

(deftest implicit-natural-size-window-resizes-and-recenters-in-one-rendered-frame
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 140
                               :render-backend false})]
    (runtime/eval! app (dynamic-natural-size-centered-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (layout-frame! app)
    (layout-frame! app)
    (let [before-window (runtime/find-view app "ui/window")
          before-title-bar (runtime/find-view app "ui/window-title-bar")
          before-body (runtime/find-view app "dynamic-body")
          before-window-bounds (:bounds before-window)
          before-title-bounds (:bounds before-title-bar)
          before-body-bounds (:bounds before-body)
          before-chrome (window-chrome-snapshot app "Dynamic")]
      (assert-window-chrome-contained! app "Dynamic")
      (assert-view-rendered! app before-title-bar)
      (runtime/mouse-down-in! app before-body 4 4)
      (layout-frame! app)
      (let [after-window (runtime/find-view app "ui/window")
            after-title-bar (runtime/find-view app "ui/window-title-bar")
            after-body (runtime/find-view app "dynamic-body")
            after-state (runtime/view-state after-window)
            after-window-bounds (:bounds after-window)
            after-title-bounds (:bounds after-title-bar)
            after-body-bounds (:bounds after-body)
            after-chrome (window-chrome-snapshot app "Dynamic")]
        (is (= true (> (:h after-window-bounds) (:h before-window-bounds))))
        (is (= true (> (:h after-body-bounds) (:h before-body-bounds))))
        (is (= true (< (:y after-window-bounds) (:y before-window-bounds))))
        (is (= (centered-axis 160 (:w after-window-bounds))
               (:x after-window-bounds)))
        (is (= (centered-axis 140 (:h after-window-bounds))
               (:y after-window-bounds)))
        (is (= (:x (:position after-state)) (:x after-window-bounds)))
        (is (= (:y (:position after-state)) (:y after-window-bounds)))
        (is (not (= before-title-bounds after-title-bounds)))
        (is (not (= before-chrome after-chrome)))
        (assert-window-chrome-contained! app "Dynamic")
        (assert-view-rendered! app after-title-bar)
        (layout-frame! app)
        (let [stable-window (runtime/find-view app "ui/window")
              stable-title-bar (runtime/find-view app "ui/window-title-bar")
              stable-body (runtime/find-view app "dynamic-body")
              stable-chrome (window-chrome-snapshot app "Dynamic")]
          (is (= after-window-bounds (:bounds stable-window)))
          (is (= after-title-bounds (:bounds stable-title-bar)))
          (is (= after-body-bounds (:bounds stable-body)))
          (is (= after-chrome stable-chrome))
          (assert-window-chrome-contained! app "Dynamic")
          (assert-view-rendered! app stable-title-bar))))))

(deftest scaled-window-without-explicit-position-centers-visual-bounds
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 120
                               :buffer-height 90
                               :render-backend false})]
    (runtime/eval! app (centered-scaled-window-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          state (runtime/view-state window)]
      (is (= false (:window/explicit-position? state)))
      (is (= (centered-axis 120 (:w (:external-bounds window)))
             (:x (:position state))))
      (is (= (centered-axis 90 (:h (:external-bounds window)))
             (:y (:position state))))
      (is (= (:x (:position state)) (:x (:bounds window))))
      (is (= (:y (:position state)) (:y (:bounds window))))
      (is (= (* 2 (:w (:bounds window)))
             (:w (:external-bounds window))))
      (is (= (* 2 (:h (:bounds window)))
             (:h (:external-bounds window)))))))

