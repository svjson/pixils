(defun tab-focus-probe-source []
  "(ns pixils.test.tab-focus-probe
     (:require pixils))

   (pixils/defmode root-mode
     {:style {:width 120
              :height 80
              :layout {:direction :column
                       :gap 4}}
      :children [{:mode 'ui/button
                  :style {:width 80
                          :height 20}
                  :state {:label \"First\"}}
                 {:mode 'ui/button
                  :style {:width 80
                          :height 20}
                  :state {:label \"Disabled\"
                          :disabled? true}}
                 {:mode 'ui/button
                  :style {:width 80
                          :height 20}
                  :state {:label \"Second\"}}
                 {:mode 'ui/button
                  :style {:width 80
                          :height 20}
                  :state {:label \"Third\"}}]})")

(defun tab-consuming-probe-source []
  "(ns pixils.test.tab-consuming-probe
     (:require pixils
               [pixils.ui :as ui]))

   (pixils/defcomponent tab-consuming-button
     {:extend 'ui/button
      :on-key-down (fn [state event ctx]
                     (if (= :key/tab (:key event))
                       (do
                         (ui/stop-propagation! event)
                         (assoc state :tab-consumed? true))
                       state))})

   (pixils/defmode root-mode
     {:style {:width 120
              :height 52
              :layout {:direction :column
                       :gap 4}}
      :children [{:mode 'ui/button
                  :style {:width 80
                          :height 20}
                  :state {:label \"First\"}}
                 {:mode 'tab-consuming-button
                  :style {:width 80
                          :height 20}
                  :state {:label \"Second\"}}]})")

