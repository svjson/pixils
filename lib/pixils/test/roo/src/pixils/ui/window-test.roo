(ns pixils.ui.window-test
  (:require proof.core
            [pixils.test.runtime :as runtime]))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun window-move-probe-source []
  "(ns pixils.test.window-move-probe
     (:require pixils
               pixils.ui.window))

   (pixils/defcomponent probe-body
     {:style {:width 80
              :height 40}
      :on-mouse-down (fn [state event ctx]
                       (assoc state :presses (+ (or (:presses state) 0) 1)))})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:position {:x 24 :y 20}
                   :style {:width 80
                           :height 56}
                   :title-bar {:title \"Probe\"}
                   :body [{:mode 'probe-body
                           :state {:presses 0}}]})]})")

(defun standard-window-map-probe-source []
  "(ns pixils.test.standard-window-map-probe
     (:require pixils.ui.window))

   (pixils.ui.window/make
    {:style {:width 80
             :height 56}
     :title-bar {:title \"Standard\"}
     :body [{:mode 'probe-body}]})")

(defun frame-window-map-probe-source []
  "(ns pixils.test.frame-window-map-probe
     (:require pixils.ui.window))

   (pixils.ui.window/make
    {:chrome :frame
     :style {:width 80
             :height 40}
     :body [{:mode 'probe-body}]})")

(defun dialog-frame-window-map-probe-source []
  "(ns pixils.test.dialog-frame-window-map-probe
     (:require pixils.ui.window))

   (pixils.ui.window/make
    {:kind :dialog-frame
     :style {:width 80
             :height 40}
     :body [{:mode 'probe-body}]})")

(defun fixed-frame-move-probe-source []
  "(ns pixils.test.fixed-frame-move-probe
     (:require pixils
               [pixils.ui :as ui]
               pixils.ui.window))

   (pixils/defcomponent move-emitter-body
     {:style {:width 80
              :height 40}
      :on-mouse-down (fn [state event ctx]
                       (do
                         (ui/emit! (:view ctx)
                                   :window/move-by
                                   {:x 20 :y 12})
                         state))})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:chrome :frame
                   :position {:x 24 :y 20}
                   :style {:width 80
                           :height 40}
                   :body [{:mode 'move-emitter-body}]})]})")

