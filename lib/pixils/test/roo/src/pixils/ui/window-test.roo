(defun fixed-frame-move-probe-source []
  "(ns pixils.test.fixed-frame-move-probe
     (:require pixils
               [pixils.ui :as ui]
               pixils.ui.window))

   (pixils/defcomponent move-emitter-body
     {:style {:width 80
              :height 40}
      :on-mouse-down (fn [state event ctx]
                       (do
                         (ui/emit! (:view ctx)
                                   :window/move-by
                                   {:x 20 :y 12})
                         state))})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:chrome :frame
                   :position {:x 24 :y 20}
                   :style {:width 80
                           :height 40}
                   :body [{:mode 'move-emitter-body}]})]})")

