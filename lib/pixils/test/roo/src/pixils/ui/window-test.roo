      (is (= true (-> enabled :interaction :focused))))))

(deftest tab-key-focuses_next_focusable_view_and_wraps
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (tab-focus-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (do
      (press-key! app :tab)
      (is (= true (focused-button app "First")))
      (press-key! app :tab)
      (is (= false (focused-button app "Disabled")))
      (is (= true (focused-button app "Second")))
      (press-key! app :tab)
      (is (= true (focused-button app "Third")))
      (press-key! app :tab)
      (is (= true (focused-button app "First"))))))

(deftest shift-tab-focuses_previous_focusable_view_and_wraps
