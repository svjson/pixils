(defun dynamic-natural-size-centered-window-probe-source []
  "(ns pixils.test.dynamic-natural-size-centered-window-probe
     (:require pixils
               [pixils.ui :as ui]
               pixils.ui.window))

   (pixils/defcomponent dynamic-body
     {:content-size (fn [state ctx]
                      {:w 80
                       :h (if (:expanded? state) 80 40)})
      :on-mouse-down (fn [state event ctx]
                       (assoc state :expanded? true))})

   (pixils/defmode root-mode
     {:theme 'pixils/windows-3
      :children [(pixils.ui.window/make
                  {:title-bar {:title \"Dynamic\"}
                   :body [{:mode 'dynamic-body
                           :state {:expanded? false}}]})]})")

