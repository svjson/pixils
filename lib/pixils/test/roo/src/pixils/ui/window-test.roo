  "(ns pixils.test.oversized-window-probe
     (:require pixils
               pixils.ui.window))

   (pixils/defcomponent probe-body
     {:style {:width 120
              :height 184}})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:style {:width 120
                           :height 200}
                   :title-bar {:title \"Oversized\"}
