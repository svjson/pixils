(ns pixils.ui.window-test
  (:require proof.core
            [pixils.test.runtime :as runtime]))

(defun settle-layout! [app]
  (runtime/update! app)
  (runtime/layout! app)
  (runtime/update! app)
  (runtime/layout! app)
  app)

(defun window-move-probe-source []
  "(ns pixils.test.window-move-probe
     (:require pixils
               pixils.ui.window))

   (pixils/defcomponent probe-body
     {:style {:width 80
              :height 40}
      :on-mouse-down (fn [state event ctx]
                       (assoc state :presses (+ (or (:presses state) 0) 1)))})

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:position {:x 24 :y 20}
                   :style {:width 80
                           :height 56}
                   :title-bar {:title \"Probe\"}
                   :body [{:mode 'probe-body
                           :state {:presses 0}}]})]})")

(deftest dragged-window-keeps-latest-position-after-follow-up-interaction
  (let [app (runtime/make-app {:package-root "lib/pixils"
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (window-move-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          title-bar (runtime/find-view app "ui/window-title-bar")]
      (is (= 24 (:x (:bounds window))))
      (is (= 20 (:y (:bounds window))))
      (runtime/mouse-down-in! app title-bar 40 9)
      (runtime/update! app)
      (runtime/mouse-move-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [position (:position (runtime/view-state (runtime/find-view app "ui/window")))]
        (is (= 55 (:x position)))
        (is (= 37 (:y position))))
      (runtime/mouse-up-in! app title-bar 71 26)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-drag (runtime/find-view app "ui/window")
            probe-body (runtime/find-view app "probe-body")]
        (is (= 55 (:x (:bounds window-after-drag))))
        (is (= 37 (:y (:bounds window-after-drag))))
        (runtime/mouse-down-in! app probe-body 4 4)
        (runtime/update! app)
        (runtime/layout! app)
        (let [window-after-body-press (runtime/find-view app "ui/window")
              probe-body-after-press (runtime/find-view app "probe-body")]
          (is (= 55 (:x (:bounds window-after-body-press))))
          (is (= 37 (:y (:bounds window-after-body-press))))
          (is (= 1 (:presses (runtime/view-state probe-body-after-press)))))))))
