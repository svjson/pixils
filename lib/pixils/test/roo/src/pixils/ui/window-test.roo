(defun child-autofocus-window-probe-source []
  "(ns pixils.test.child-autofocus-window-probe
     (:require pixils
               pixils.ui.window
               pixils.ui.text-input))

   (pixils/defmode root-mode
     {:children [(pixils.ui.window/make
                  {:style {:width 120
                           :height 64}
                   :title-bar {:title \"Child Autofocus\"}
                   :body [{:mode 'ui/text-input
                           :style {:width 90
                                   :height 24}
                           :state {:value \"child\"
                                   :auto-focus? true}}]})]})")

