(deftest modal-overlay-mouse-down-preserves-dialog-focus
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval! app (modal-overlay-focus-probe-source))
    (runtime/push-mode! app 'root-mode)
    (settle-layout! app)
    (let [window (runtime/find-view app "ui/window")
          input (runtime/find-view app "ui/text-input-inner")]
      (is (= true (-> input :interaction :focused)))
      (is (= true (-> window :interaction :focus-within)))
      (runtime/mouse-down-at! app 2 2)
      (runtime/update! app)
      (runtime/layout! app)
      (let [window-after-overlay-click (runtime/find-view app "ui/window")
            input-after-overlay-click (runtime/find-view app "ui/text-input-inner")]
        (is (= true (-> input-after-overlay-click :interaction :focused)))
        (is (= true (-> window-after-overlay-click
                        :interaction
                        :focus-within)))))))

