(ns pixils.ui.icon-container-test
  (:require proof.core
            [pixils.test.runtime :as runtime]))

(deftest icon-grid-can-bind-scroll-content-state-from-owner
  (let [app (runtime/make-app {:package-root "../.."
                               :buffer-width 160
                               :buffer-height 120
                               :render-backend false})]
    (runtime/eval-file!
     app
     "../assets/roo/pixils/test/icon-grid-binding-probe.roo")
    (runtime/push-mode! app 'root-mode)
    (is (= [{:id :one} {:id :two} {:id :three}]
           (:items
            (:state
             (runtime/find-view app "bound-grid-owner")))))
    (runtime/settle-layout! app)
    (is (= [{:id :one} {:id :two} {:id :three}]
           (:items
            (:state
             (runtime/find-view app "bound-grid-owner")))))
    (is (= [{:id :one} {:id :two} {:id :three}]
           (get-in (-> (runtime/find-view app "ui/scroll-pane") :state)
                   [:content-state :items])))
    (is (= 48
           (get-in (-> (runtime/find-view app "ui/scroll-pane") :ui-state)
                   [:content-size :h])))
    (is (= {:id :one}
           (:item
            (:state
             (head (runtime/find-views app "ui/icon"))))))))
