(ns pixils.test.app.minesweeper.core
  (:require pixils
            [pixils.ui :as ui]
            pixils.test.app.shared.ui.components.button))

(defcomponent board-button
  {:extend 'button
   :style {:width 17 :max-width 17 :height 17 :max-height 17}
   :update (fn [state {:keys [view] :as ctx}]
             (let [flagged (-> state :mask :flagged?)
                   state (-> state
                             (assoc :image (when flagged
                                             :mine-layer-mode/flag))
                             (assoc :force-pressed? (-> state :mask :chord-pressed?))
                             (assoc :inhibit-pressed? flagged))]
               (assoc-in! ctx
                          [:view :style :visibility]
                          (if (:revealed? (:mask state)) :hidden :visible))
               (assoc state :pressed
                      (and (not (:inhibit-pressed? state))
                           (or (:force-pressed? state)
                               (and (contains? (-> view :interaction :pressed) :left)
                                    (-> view :interaction :hovered)))))))
   :on-click (fn [state e ctx]
               (case (:button e)
                 :left (when (not (:flagged? (:mask state)))
                         (ui/emit! (:view ctx) :cell/click state))
                 :right (ui/emit! (:view ctx) :cell/toggle-flag state))
               state)})
