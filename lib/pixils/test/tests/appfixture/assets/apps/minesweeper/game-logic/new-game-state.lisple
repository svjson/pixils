(ns pixils.test.app.minesweeper.game-logic)

(def difficulty-settings
  {:beginner {:w 9 :h 9 :mines 10}
   :intermediate {:w 16 :h 16 :mines 40}
   :expert {:w 30 :h 16 :mines 99}
   :custom {:w 9 :h 9 :mines 10}})

(defun new-game-state [{:keys [w h mines] :as settings}]
  {:settings settings
   :face :status/face-normal
   :board (generate-mine-field w h mines)
   :board-mask (dotimes [y h]
                 (dotimes [x w]
                   {:revealed? false
                    :flagged? false}))
   :start-time (epoch-ms)
   :counters {:mines-left mines
              :timer 0}})
