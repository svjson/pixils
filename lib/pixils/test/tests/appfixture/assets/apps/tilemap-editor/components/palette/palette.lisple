(ns tilemap-editor.palette
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.header-panel :as hp]
            [pixils.ui.scroll-pane :as sp]
            [tilemap-editor.data :as data]
            [tilemap-editor.tile-renderer :as tr]))



;; Tile palette

(def tile-palette-row-height 22)
(def tile-palette-row-gap 4)
(def tile-palette-content-width 160)

(defun tile-palette-content-height []
  (+ (* data/max-tile-count tile-palette-row-height)
     (* (dec data/max-tile-count) tile-palette-row-gap)))

(defcomponent tile-swatch-preview
  {:style {:width 14
           :height 14}
   :render (fn [state ctx]
             (let [bounds (-> ctx :view :bounds)
                   rect {:x 0 :y 0 :w (:w bounds) :h (:h bounds)}]
               (do
                 (r/rect! rect {:fill true
                                :color {:r 0x12 :g 0x15 :b 0x18}})
                 (tr/draw-tile! (:tile state) rect)
                 (r/rect! rect {:color {:r 0xe6 :g 0xea :b 0xee}}))))})

(defcomponent tile-swatch
  {:class :ui/list-item
   :style {:width :fill
           :height tile-palette-row-height
           :padding [4 6]
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :update (fn [state ctx]
             (let [tile (data/tile-in (:tileset state) (:tile-index state))]
               (assoc (assoc (assoc state
                                    :selected
                                    (= (:tile-index state) (:selected-tile state)))
                             :tile tile)
                      :name (:name tile))))
   :on-click (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx) :palette/select (:tile-index state))
                 state))
   :children [{:mode 'tile-swatch-preview
               :state {:tile (ui/bind-state :tile)}}
              {:mode 'ui/text
               :state {:value (ui/bind-state :name)}}]})

(defcomponent tile-palette-list
  {:style {:width :fill
           :height :fill
           :layout {:direction :column
                    :gap tile-palette-row-gap}}
   :children (dotimes [index data/max-tile-count]
               {:mode 'tile-swatch
                :state {:tile-index index
                        :tileset (ui/bind-state :tileset)
                        :selected-tile (ui/bind-state :selected-tile)}})})

(defun make-tile-palette []
  (hp/make {:title "Tiles"
            :style {:height 176}
            :body-style {:padding 8
                         :layout {:direction :column
                                  :gap 4}}
            :state {:selected-tile (ui/bind-state :selected-tile)
                    :tileset (ui/bind-state :tileset)}
            :body-state {:content-state (ui/bind-state :content-state)}
            :update (fn [state ctx]
                      (assoc state
                             :content-state
                             {:selected-tile (:selected-tile state)
                              :tileset (:tileset state)}))
            :children [(sp/make {:style {:width :fill
                                          :height :fill}
                                 :content-size {:w tile-palette-content-width
                                                :h (tile-palette-content-height)}
                                 :state {:content-state (ui/bind-state :content-state)}
                                 :scroll-x? false
                                 :step (+ tile-palette-row-height tile-palette-row-gap)
                                 :children [{:mode 'tile-palette-list
                                             :state {:selected-tile (ui/bind-state :selected-tile)
                                                     :tileset (ui/bind-state :tileset)}}]})]}))
