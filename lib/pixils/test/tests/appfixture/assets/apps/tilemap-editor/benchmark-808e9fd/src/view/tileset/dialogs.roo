(ns tilemap-editor.view.tileset.dialogs
  (:require pixils
            [roo.io :as io]
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.ui :as ui]
            [pixils.ui.checkbox :as chk]
            [pixils.ui.combo-box :as cb]
            [pixils.ui.file-dialog :as file-dialog]
            [pixils.ui.menu :as menu]
            [pixils.ui.slider :as sl]
            [pixils.ui.window :as w]
            [tilemap-editor.model.data :as data]
            tilemap-editor.view.tileset.model))

(def tile-import-preview-width 360)

(def tile-import-preview-height 280)

(def color-range-preview-width 320)

(def color-range-preview-height 24)

(def image-file-filters
  [{:label "Image files (*.png, *.jpg, *.jpeg, *.bmp)"
    :extensions [".png" ".jpg" ".jpeg" ".bmp"]}
   {:label "All files (*)"
    :extensions []}])

(defun tile-add-menu [has-resources?]
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Add from resource"
            :action :tile/add-menu-dummy
            :payload {:command :from-resource}
            :disabled? (not has-resources?)}
           {:label "Add from file"
            :action :tile/add-menu-dummy
            :payload {:command :from-file}}
           {:label "Add multiple tiles from multiple files"
            :action :tile/add-menu-dummy
            :payload {:command :from-multiple-files}}
           :separator
           {:label "Add color tile"
            :action :tile/add-menu-dummy
            :payload {:command :color}}
           {:label "Add range of color tiles"
            :action :tile/add-menu-dummy
            :payload {:command :color-range}}]})

(defun open-tileset-create-dialog! [state ctx]
  (let [id (unique-tileset-id (:tilesets state))]
    (do
      (push-mode! 'tileset-create-dialog-modal
                  {:tileset-id id
                   :tileset-label (label-from-id id)
                   :tile-size data/tile-size}
                  {:origin {:view (:view ctx)
                            :event :tileset/dialog-result}})
      state)))

(defun open-tile-create-dialog! [state ctx]
  (let [tiles (selected-tileset-tiles state)
        id (unique-color-tile-id tiles)]
    (if (nil? (:selected-tileset-definition-index state))
      state
      (do
        (push-mode! 'tile-create-dialog-modal
                    {:tile-id id
                     :tile-name (label-from-id id)
                     :tile-char (default-tile-char id)
                     :tile-type :color}
                    {:origin {:view (:view ctx)
                              :event :tile/dialog-result}})
        state))))

(defun open-color-range-dialog! [state ctx]
  (let [id (unique-color-tile-id (selected-tileset-tiles state))]
    (if (nil? (:selected-tileset-definition-index state))
      state
      (do
        (push-mode! 'color-range-dialog-modal
                    {:tile-id id
                     :tile-name (label-from-id id)
                     :count 8
                     :from-color {:r 0 :g 0 :b 0}
                     :to-color {:r 255 :g 255 :b 255}}
                    {:origin {:view (:view ctx)
                                      :event :tile/color-range-result}})
        state))))

(defun open-tile-import-dialog! [state ctx selected-bundle-id selected-resource-key]
  (let [bundle-options (bundle-options (:resources state))
        selected-bundle-index (or (bundle-index-by-id bundle-options
                                                     selected-bundle-id)
                                  (if (empty? bundle-options) nil 0))
        selected-bundle-id (bundle-id-at-index bundle-options
                                               selected-bundle-index)
        options (image-resource-options (:resources state) selected-bundle-id)
        selected-index (or (resource-index-by-key options selected-resource-key)
                           (if (empty? options) nil 0))]
    (if (or (nil? (:selected-tileset-definition-index state))
            (nil? selected-bundle-index))
      state
      (do
        (push-mode! 'tile-import-dialog-modal
                    {:resources (:resources state)
                     :tilesets (:tilesets state)
                     :selected-tileset-definition-index (:selected-tileset-definition-index state)
                     :bundle-options bundle-options
                     :selected-bundle-index selected-bundle-index
                     :resource-options options
                     :selected-resource-index selected-index
                     :selected-source-indices []
                     :select-all? false
                     :exclude-same-tileset? true
                     :exclude-project? false
                     :tile-size (selected-tileset-tile-size state)}
                    {:origin {:view (:view ctx)
                              :event :tile/import-result}})
        state))))

(defun open-add-from-file-dialog! [state ctx multi-file?]
  (do
    (file-dialog/open-file-dialog!
     ctx
     {:title (if multi-file?
               "Add Tiles from Images"
               "Add Tiles from Image")
      :mode :file-dialog/open
      :path (or (:project-directory state) file-dialog/default-path)
      :filters image-file-filters
      :multi-file? multi-file?
      :result-event :tile/file-dialog-result})
    state))

(defun image-file-dialog-result? [payload]
  (and (= (:type payload) :confirm)
       (= (:mode payload) :file-dialog/open)
       (not (nil? (:path payload)))))

(defun resource-bundle-for-import [state]
  (or (:selected-resource-bundle state)
      (first-dynamic-bundle-id (:resources state))
      default-import-bundle))

(defun import-file-resource! [state payload]
  (let [bundle-id (resource-bundle-for-import state)
        path (:path payload)
        resource-root (default-resource-id path)
        images (or (get-in state [:resources :bundles bundle-id :images]) {})
        resource-id (keyword (unique-id-from (map (keys images)
                                                  (fn [id]
                                                    {:id id}))
                                             resource-root
                                             nil))
        dependency {:file-name path
                    :name (default-resource-name path)}
        resource {:id resource-id
                  :bundle-id bundle-id
                  :key (image-resource-key bundle-id resource-id)
                  :name (:name dependency)
                  :file-name path}]
    (do
      (res/create-bundle! bundle-id)
      (res/add-image! (image-resource-key bundle-id resource-id)
                      {:file-name path})
      (assoc
       (assoc-in state
                 [:resources :bundles bundle-id :images resource-id]
                 dependency)
       :selected-resource-bundle bundle-id
       :selected-image-resource resource-id
       :last-imported-image-resources
       (concat (or (:last-imported-image-resources state) [])
               [resource])))))

(defun import-file-resources! [state paths]
  (reduce (or paths [])
          (assoc state :last-imported-image-resources [])
          (fn [out path]
            (import-file-resource! out {:path path}))))

(defcomponent tileset-create-dialog-body
  {:class :ui/content
   :style {:width 300
           :height :shrink
           :padding 10
           :layout {:direction :column
                    :gap 8}}
   :update (fn [state ctx]
             (assoc state
                    :invalid? (or (blank? (:tileset-id state))
                                  (blank? (:tileset-label state)))))
   :on {:slider/change (fn [state event ctx]
                         (assoc state :tile-size (:payload event)))}
   :children [{:mode 'ui/text
               :class :ui/muted
               :state {:value "Id"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :tileset-id)
                       :auto-focus? true}}
              {:mode 'ui/text
               :class :ui/muted
               :state {:value "Label"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 24}
               :state {:value (ui/bind-state :tileset-label)}}
              {:mode 'tile-definition-row
               :style {:width :fill
                       :height 24
                       :layout {:direction :row
                                :align-items :center
                                :gap 8}}
               :state {:tile-size (ui/bind-state :tile-size)}
               :children [{:mode 'ui/text
                           :class :ui/muted
                           :style {:width 58}
                           :state {:value "Tile size"}}
                          (sl/make {:value (ui/bind-state :tile-size)
                                    :min 8
                                    :max 64
                                    :step 8})
                          {:mode 'ui/text
                           :style {:width 28}
                           :state {:value (ui/bind-state :tile-size)}}]}
              {:mode 'tileset-create-dialog-buttons
               :state {:invalid? (ui/bind-state :invalid?)}}]})

(defcomponent tileset-create-dialog-buttons
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :gap :space-between}}
   :children [{:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Cancel"}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :tileset-create-dialog/cancel)
                             state))}
              {:mode 'ui/button
               :style {:width 78
                       :height 24}
               :state {:label "Create"
                       :disabled? (ui/bind-state :invalid?)}
               :on-click (fn [state event ctx]
                           (do
                             (ui/emit! (:view ctx)
                                       :tileset-create-dialog/confirm)
                             state))}]})

(defmode tileset-create-dialog-modal
  {:on {:tileset-create-dialog/cancel
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (pop-mode! {:type :cancel})
            state))
        :tileset-create-dialog/confirm
        (fn [state event ctx]
          (do
            (ui/stop-propagation! event)
            (if (or (blank? (:tileset-id state))
                    (blank? (:tileset-label state)))
              state
              (do
                (pop-mode! {:type :confirm
                            :tileset-id (:tileset-id state)
                            :tileset-label (:tileset-label state)
                            :tile-size (:tile-size state)})
                state))))}
   :compose {:render :pass}
   :children [(w/make {:position {:x 220 :y 140}
                       :title-bar {:title "New Tile Set"}
                       :state {:tileset-id (ui/bind-state :tileset-id)
                               :tileset-label (ui/bind-state :tileset-label)
                               :tile-size (ui/bind-state :tile-size)}
                       :body [{:mode 'tileset-create-dialog-body
                               :state {:tileset-id (ui/bind-state :tileset-id)
                                       :tileset-label (ui/bind-state :tileset-label)
                                       :tile-size (ui/bind-state :tile-size)}}]})]})

(defcomponent tile-create-type-selector
  {:style {:width :fill
           :height 22}
   :update (fn [state ctx]
             (assoc state
                    :selected-index
                    (tile-type-index {:type (:tile-type state)})))
   :on {:combo-box/change (fn [state event ctx]
                            (assoc state
                                   :tile-type
                                   (-> event :payload :value)))}
   :children [(cb/make {:options tile-type-options
                        :selected-index (ui/bind-state :selected-index)})]})

