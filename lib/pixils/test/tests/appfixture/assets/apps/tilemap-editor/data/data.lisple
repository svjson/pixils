(def tile-types mixed-tile-types)

(def tilesets
  [{:id :mixed
    :label "Mixed Bag"}
   {:id :colors
    :label "Colors"}
   {:id :sprites
    :label "Sprite Sheet"}])

(def tileset-options
  (for-indexed [index tileset tilesets]
    {:value index
     :label (:label tileset)}))

(defun tileset-key [index]
  (:id (nth tilesets (or index 0))))

(defun tile-types-for [tileset]
  (case tileset
    :colors color-tile-types
    :sprites sprite-tile-types
    :default mixed-tile-types))

(defun tile-in [tileset index]
  (let [types (tile-types-for tileset)]
    (nth types (mod index (count types)))))

(defun tile [index]
  (tile-in :mixed index))

(defun tile-color [index]
  (:color (tile index)))

(defun tile-name [index]
  (:name (tile index)))

(defun tile-name-in [tileset index]
  (:name (tile-in tileset index)))

(defun tile-label-in [tileset index]
  (let [tile (tile-in tileset index)]
    (str "Selected: " (:name tile) " (" (:type tile) ")")))

(defun tile-label [index]
  (tile-label-in :mixed index))

(defun make-row [y]
  (dotimes [x map-width]
    (cond
      (or (= x 0)
          (= y 0)
          (= x (dec map-width))
          (= y (dec map-height)))
      5

      (= 0 (mod (+ x (* y 3)) 17))
      3

      (= 0 (mod (+ (* x 7) (* y 5)) 29))
      8

      (= 0 (mod (+ (* x 5) y) 31))
      9

      (= 0 (mod (+ (* x 2) y) 23))
      2

      (= 0 (mod (+ x y) 11))
      1

      :default
      0)))

(defun make-map []
  (dotimes [y map-height]
    (make-row y)))
