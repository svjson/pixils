(ns pixils.test.app.shared.ui.components.button
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]))

(defcomponent button-inner
  {:style {:width :fill
           :height :fill}
   :children [{:mode 'text-node
               :style {:padding {:t 4 :l 4 :r 4 :b 2}}
               :state {:value (ui/bind-state :label)}}]
   :render (fn [state ctx]
             (when (keyword? (:image state))
               (r/image! (:image state) {:x 0 :y 0})))})
