(ns pixils.test.app.shared.ui.components.menu
  (:require pixils
            [pixils.ui :as ui]
            [pixils.test.app.minesweeper.menu-definition :as md]))

(defcomponent menu-item
  {:class :menu/item
   :on-mouse-down (fn [state event ctx]
                    (when-let [items (:items state)]
                      (push-mode!
                       'popup-menu
                       {}
                       {:origin {:view (:view ctx) :event :menu/select}
                        :children [{:mode 'popup-menu-outer
                                    :style {:position :absolute
                                            :width :shrink
                                            :height :shrink
                                            :left (-> ctx :view :bounds :x)
                                            :top (+ (-> ctx :view :bounds :y)
                                                    (-> ctx :view :bounds :h))}
                                    :children [{:mode 'popup-menu-inner
                                                :style {}
                                                :children (for-indexed [n item items]
                                                                       (merge (md/make-menu-item item state)
                                                                              {:style {:width :fill}}))}]}]}))
                    (ui/stop-propagation! event)
                    state)
   :on-mouse-up (fn [state event ctx]
                  (when (not (:items state))
                    (ui/emit! (:view ctx) :menu/select {:key (:key state)}))
                  state)
   :on {:menu/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (ui/emit! (:view ctx) :menu/select (:payload event))
                       state)}
   :children [{:mode 'text-node
               :state {:value (ui/bind-state :text)}}]})
