(ns pixils.test.app.shared.ui.themes.win311
  (:require pixils
            [pixils.color :as c]
            [pixils.point :as pt]
            [pixils.render :as r]))

(defbundle win3 {:images {:system-font "assets/win311systemfont.png"
                          :checkmark "assets/win311-checkmark.png"
                          :control-button "assets/win311-control-button.png"
                          :minimize-button "assets/win311-minimize-button.png"}})

(deffont win3-system-font
  {:type :bitmap
   :spacing 1
   :resource :win3/system-font
   :baseline 9
   :styles {:underline {:offset 2
                        :thickness 1}}
   :glyphs {' ' {:x 235 :y 0 :w 4 :h 10}
            '.' {:x 0 :y 25 :w 2 :h 10}
            '?' {:x 37 :y 25 :w 6 :h 10}
            '@' {:x 47 :y 24 :w 12 :h 13}
            '&' {:x 104 :y 25 :w 7 :h 10}
            '(' {:x 112 :y 25 :w 3 :h 13}
            ')' {:x 116 :y 25 :w 3 :h 13}
            '+' {:x 120 :y 25 :w 6 :h 10}
            '-' {:x 127 :y 25 :w 4 :h 10}
            '0' {:x 179 :y 11 :w 6 :h 10}
            '1' {:x 186 :y 11 :w 4 :h 10}
            '2' {:x 191 :y 11 :w 6 :h 10}
            '3' {:x 198 :y 11 :w 6 :h 10}
            '4' {:x 205 :y 11 :w 6 :h 10}
            '5' {:x 212 :y 11 :w 6 :h 10}
            '6' {:x 219 :y 11 :w 6 :h 10}
            '7' {:x 226 :y 11 :w 6 :h 10}
            '8' {:x 233 :y 11 :w 6 :h 10}
            '9' {:x 240 :y 11 :w 6 :h 10}
            'A' {:x 0 :y 0 :w 8 :h 10}
            'B' {:x 9 :y 0 :w 8 :h 10}
            'C' {:x 18 :y 0 :w 7 :h 10}
            'D' {:x 26 :y 0 :w 8 :h 10}
            'E' {:x 35 :y 0 :w 7 :h 10}
            'F' {:x 43 :y 0 :w 7 :h 10}
            'G' {:x 51 :y 0 :w 8 :h 10}
            'H' {:x 60 :y 0 :w 8 :h 10}
            'I' {:x 69 :y 0 :w 2 :h 10}
            'J' {:x 72 :y 0 :w 6 :h 10}
            'K' {:x 79 :y 0 :w 8 :h 10}
            'L' {:x 88 :y 0 :w 8 :h 10}
            'M' {:x 97 :y 0 :w 10 :h 10}
            'N' {:x 108 :y 0 :w 8 :h 10}
            'O' {:x 117 :y 0 :w 8 :h 10}
            'P' {:x 126 :y 0 :w 8 :h 10}
            'Q' {:x 135 :y 0 :w 8 :h 10}
            'R' {:x 144 :y 0 :w 9 :h 10}
            'S' {:x 154 :y 0 :w 7 :h 10}
            'T' {:x 162 :y 0 :w 8 :h 10}
            'U' {:x 171 :y 0 :w 8 :h 10}
            'V' {:x 180 :y 0 :w 8 :h 10}
            'W' {:x 189 :y 0 :w 14 :h 10}
            'X' {:x 204 :y 0 :w 9 :h 10}
            'Y' {:x 214 :y 0 :w 10 :h 10}
            'Z' {:x 225 :y 0 :w 9 :h 10}
            'a' {:x 0 :y 11 :w 6 :h 10}
            'b' {:x 7 :y 11 :w 6 :h 10}
            'c' {:x 14 :y 11 :w 6 :h 10}
            'd' {:x 21 :y 11 :w 6 :h 10}
            'e' {:x 28 :y 11 :w 6 :h 10}
            'f' {:x 35 :y 11 :w 4 :h 10}
            'g' {:x 40 :y 11 :w 6 :h 13}
            'h' {:x 47 :y 11 :w 6 :h 10}
            'i' {:x 54 :y 11 :w 2 :h 10}
            'j' {:x 57 :y 11 :w 3 :h 13}
            'k' {:x 61 :y 11 :w 6 :h 10}
            'l' {:x 68 :y 11 :w 2 :h 10}
            'm' {:x 71 :y 11 :w 10 :h 10}
            'n' {:x 82 :y 11 :w 6 :h 10}
            'o' {:x 89 :y 11 :w 6 :h 10}
            'p' {:x 96 :y 11 :w 6 :h 13}
            'q' {:x 103 :y 11 :w 6 :h 13}
            'r' {:x 110 :y 11 :w 4 :h 10}
            's' {:x 115 :y 11 :w 6 :h 10}
            't' {:x 122 :y 11 :w 4 :h 10}
            'u' {:x 127 :y 11 :w 6 :h 10}
            'v' {:x 134 :y 11 :w 8 :h 10}
            'w' {:x 143 :y 11 :w 10 :h 10}
            'x' {:x 154 :y 11 :w 8 :h 10}
            'y' {:x 163 :y 11 :w 8 :h 13}
            'z' {:x 172 :y 11 :w 6 :h 10}}})

(def white {:r 255 :g 255 :b 255})
(def focus-blue {:r 0x00 :g 0x0b :b 0xc8})
(def teal {:r 0x00 :g 0x80 :b 0x80})
(def cyan {:r 0x00 :g 0xff :b 0xff})
(def panel-face {:r 0xc0 :g 0xc7 :b 0xc8})
(def panel-shadow {:r 0x87 :g 0x88 :b 0x8f})

(defun draw-bevel! [rect {:keys [thickness invert]}]
  (let [thickness (or thickness 1)
        tl-color (if invert panel-shadow white)
        br-color (if invert white panel-shadow)]
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (:x rect) :y (:y rect)} {:x 0 :y n})
               {:x (+ (:x rect) (- (:w rect) (+ 1 n))) :y (+ (:y rect) n)}
               tl-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (:x rect) :y (:y rect)} {:x n :y 0})
               {:x (+ (:x rect) n) :y (+ (:y rect) (- (:h rect) (+ 1 n)))}
               tl-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (+ 1 (:x rect) (- thickness n))
                      :y (- (+ (:y rect) (:h rect)) thickness)}
                     {:x 0 :y n})
               {:x (- (+ (:x rect) (:w rect)) 1)
                :y (- (+ n (:y rect) (:h rect)) thickness)}
               br-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (- (+ (:x rect) (:w rect)) thickness)
                      :y (+ 1 (:y rect) (- thickness n))}
                     {:x n :y 0})
               {:x (- (+ n (:x rect) (:w rect)) thickness)
                :y (- (+ (:y rect) (:h rect)) thickness)}
               br-color))))

(deftheme windows-3
  {:styles {'window {:border {:line-style :solid
                              :thickness 1
                              :color c/BLACK}
                     :text {:font :font/win3-system-font}}

            'window-title-bar {:background c/WHITE
                               :text {:color c/BLACK}
                               :border {:bottom {:color c/BLACK
                                                 :thickness 1}}
                               :width :fill
                               :height 19
                               :max-height 19
                               :padding 0}

            ['window:focus-within 'window-title-bar]
            {:background focus-blue
             :text {:color c/WHITE}}

            'window-control-button {:background {:image :win3/control-button}
                                    :border {:right {:thickness 1
                                                     :color c/BLACK}}
                                    :hidden false
                                    :width 18
                                    :max-width 18
                                    :height 18
                                    :max-height 18}

            'window-minimize-button {:width 18
                                     :max-width 18
                                     :hidden false
                                     :height 18
                                     :max-height 18}

            '(window-minimize-button button-inner)
            {:background {:image :win3/minimize-button}}

            '(button {:pressed true})
            {:border {:line-style :solid
                      :color c/TRANSPARENT
                      :thickness 1
                      :right {:thickness 0}
                      :bottom {:thickness 0}}}

            'button-inner
            {:background panel-face
             :border {:line-style :bevel
                      :width :fill
                      :color c/WHITE
                      :thickness 2
                      :right {:color panel-shadow}
                      :bottom {:color panel-shadow}}}

            'button-inner:hover
            {:text {:color c/BLACK}
             :background panel-face
             :border {:line-style :bevel
                      :width :fill
                      :color c/WHITE
                      :thickness 2
                      :right {:color panel-shadow}
                      :bottom {:color panel-shadow}}}

            '(button-inner {:pressed true})
            {:border {:line-style :bevel
                      :color panel-shadow
                      :thickness 2
                      :right {:color c/WHITE :thickness 1}
                      :bottom {:color c/WHITE :thickness 1}}}

            'text-input
            {:width 80
             :border {:line-style :solid
                      :color c/BLACK
                      :thickness 1}}

            'text-input-inner
            {:width :fill
             :padding [2 4]}

            'menu-bar
            {:background white
             :text {:font :font/win3-system-font}
             :border {:line-style :solid
                      :color {:r 0 :g 0 :b 0}
                      :bottom {:thickness 1}}}

            'popup-menu-item
            {:padding [2 16]}

            'popup-menu-option-item
            {:padding [2 2]}

            :menu/item
            {:text {:color c/BLACK
                    :marked-style {:enabled true
                                   :marker "@"
                                   :font-styles :underline}}}

            :menu/item:hover
            {:background focus-blue
             :text {:color white
                    :marked-style {:color c/WHITE}}}

            'menu-bar-item:hover
            {:background white
             :text {:color c/BLACK
                    :marked-style {:color c/BLACK}}}

            '(menu-bar-item {:highlighted true})
            {:background focus-blue
             :text {:color white
                    :marked-style {:color c/WHITE}}}

            'popup-menu-item:hover
            {:background white
             :text {:color c/BLACK
                    :marked-style {:color c/BLACK}}}

            'popup-menu-option-item:hover
            {:background white
             :text {:color c/BLACK
                    :marked-style {:color c/BLACK}}}

            :menu/shortcut-column
            {:margin {:l 16}}

            '(popup-menu-item {:highlighted true})
            {:background focus-blue
             :text {:color white
                    :marked-style {:color c/WHITE}}}

            '(popup-menu-option-item {:highlighted true})
            {:background focus-blue
             :text {:color white
                    :marked-style {:color c/WHITE}}}

            'menu-option-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            'menu-option-indicator
            {:margin {:l 2 :r 4}
             :box-sizing :content-box
             :width 8
             :height 10}

            '(menu-option-indicator {:selected true})
            {:background {:image :win3/checkmark}}

            'menu-separator
            {:height 1
             :margin {:t 3 :r 0 :b 2 :l 0}
             :border {:thickness 1
                      :line-style :solid
                      :color c/BLACK
                      :right {:thickness 0}
                      :bottom {:thickness 0}
                      :left {:thickness 0}}}

            'popup-menu-inner
            {:background white
             :text {:font :font/win3-system-font}
             :border {:thickness 1
                      :line-style :solid
                      :color c/BLACK}}

            :ui/panel {:background panel-face}}})
