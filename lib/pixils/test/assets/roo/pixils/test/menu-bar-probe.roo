(ns pixils.test.menu-bar-probe
  (:require pixils
            [pixils.ui.menu-bar :as menu-bar]))

(pixils/defmode menu-action-root
  {:init (fn [_state _ctx]
           {:quit false
            :payload nil})
   :on {:game/quit
        (fn [state event _ctx]
          (assoc state
                 :quit true
                 :payload (:payload event)))}
   :children [(menu-bar/make
               {:style {:width 120
                        :height 20}}
               {:items [{:label "Quit"
                         :action :game/quit
                         :payload {:source :menu}}]}
               {})]})

(pixils/defmode menu-static-root
  {:children [(menu-bar/make
               {:style {:width 120
                        :height 20}}
               {:items [{:label "Static"}]}
               {})]})
