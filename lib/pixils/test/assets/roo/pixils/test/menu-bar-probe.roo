(ns pixils.test.menu-bar-probe
  (:require pixils
            [pixils.ui.menu-bar :as menu-bar]))

(def submenu-menu
  {:items [{:label "File"
            :items [{:label "Open"
                     :action :file/open}]}]})

(pixils/defmode menu-action-root
  {:init (fn [_state _ctx]
           {:quit false
            :payload nil})
   :on {:game/quit
        (fn [state event _ctx]
          (assoc state
                 :quit true
                 :payload (:payload event)))}
   :children [(menu-bar/make
               {:style {:width 120
                        :height 20}}
               {:items [{:label "Quit"
                         :action :game/quit
                         :payload {:source :menu}}]}
               {})]})

(pixils/defmode menu-static-root
  {:children [(menu-bar/make
               {:style {:width 120
                        :height 20}}
               {:items [{:label "Static"}]}
               {})]})

(pixils/defmode menu-scaled-root
  {:children [(menu-bar/make
               {:style {:scale 2}}
               submenu-menu
               {})]})

(pixils/defmode menu-unscaled-root
  {:children [(menu-bar/make
               {}
               submenu-menu
               {})]})

(pixils/defmode menu-classic-blue-root
  {:theme 'pixils/classic-blue
   :children [(menu-bar/make
               {}
               submenu-menu
               {})]})

(pixils/defmode menu-windows-3-root
  {:theme 'pixils/windows-3
   :children [(menu-bar/make
               {}
               submenu-menu
               {})]})
