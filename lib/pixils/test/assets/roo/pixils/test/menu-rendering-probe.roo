(ns pixils.test.menu-rendering-probe
  "Defines public menu configurations for rendered-contract scenarios."
  (:require pixils
            [pixils.ui.menu-bar :as menu-bar]
            [pixils.ui.popup-menu :as popup-menu]))

(def MENU
  "Menu definition covering actions, selection markers, and nesting."
  {:items [{:label "File"
            :items [{:label "Snap"
                     :type :toggle
                     :selected-path [:preferences :snap?]}
                    {:label "Open"
                     :action :file/open}
                    {:label "Recent"
                     :items [{:label "Map"
                              :action :file/open-recent}]}]}
           {:label "Edit"
            :items [{:label "Copy"
                     :action :edit/copy}]}
           {:label "View"
            :items [{:label "Zoom"
                     :action :view/zoom}]}]})

(def APP-STYLE
  "Full-buffer application geometry for rendered menu scenarios."
  {:width :fill
   :height :fill})

(def EDGE-MENU
  "Compact menu definition used to exercise viewport-edge placement."
  {:items [{:label "File"
            :items [{:label "Recent files"
                     :items [{:label "Open map"
                              :action :file/open-recent}]}
                    {:label "Open"
                     :action :file/open}]}]})

(def EDGE-CONTEXT-MENU
  "Context menu used to exercise point-anchored viewport placement."
  {:items [{:label "Rename"
            :action :item/rename}
           {:label "Delete"
            :action :item/delete}]})

(defun make-menu-bar
  "Build the menu bar exercised by rendered-contract scenarios.

  Returns:
  A public `ui/menu-bar` declaration."
  []
  (menu-bar/make {:state {:preferences {:snap? true}}}
                 MENU
                 {}))

(pixils/defmode menu-rendering-base-root
  {:class :ui/app
   :style APP-STYLE
   :children [(make-menu-bar)]})

(pixils/defmode menu-rendering-classic-blue-root
  {:theme 'pixils/classic-blue
   :class :ui/app
   :style APP-STYLE
   :children [(make-menu-bar)]})

(pixils/defmode menu-rendering-windows-3-root
  {:theme 'pixils/windows-3
   :class :ui/app
   :style APP-STYLE
   :children [(make-menu-bar)]})

(pixils/defmode menu-rendering-windows-95-root
  {:theme 'pixils/windows-95
   :class :ui/app
   :style APP-STYLE
   :children [(make-menu-bar)]})

(pixils/defmode menu-rendering-bottom-edge-root
  {:class :ui/app
   :style APP-STYLE
   :children [(menu-bar/make
               {:style {:position :absolute
                        :left 0
                        :top 162
                        :width :shrink}}
               EDGE-MENU
               {})]})

(pixils/defmode menu-rendering-right-edge-root
  {:class :ui/app
   :style APP-STYLE
   :children [(menu-bar/make
               {:style {:position :absolute
                        :left 200
                        :top 0
                        :width :shrink}}
               EDGE-MENU
               {})]})

(pixils/defmode menu-rendering-context-edge-root
  {:class :ui/app
   :style APP-STYLE
   :on-mouse-up
   (fn [state event ctx]
     (when (= (:button event) :right)
       (popup-menu/open-context! EDGE-CONTEXT-MENU
                                 (:global-position event)
                                 state
                                 ctx))
     state)})
