(ns pixils.test.list-box-activation-probe
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.list-box :as list-box]))

(pixils/defcomponent activating-item
  {:extend 'ui/list-box-item
   :on-click (fn [state event ctx]
               (let [ui-state (-> ctx :view :ui-state)
                     payload {:index (:index ui-state)
                              :value (:value ui-state)
                              :shift? false
                              :ctrl? false}]
                 (ui/emit! (:view ctx)
                           :option-item/click
                           payload)
                 (ui/emit! (:view ctx)
                           :option-item/activate
                           payload))
               state)})

(pixils/defmode root-mode
  {:init (fn [state ctx]
           {:selected [0]
            :activated nil
            :event-order []})
   :on {:list-box/selection-change
        (fn [state event ctx]
          (assoc state
                 :selected
                 (:selected-indices (:payload event))
                 :event-order
                 (append (:event-order state) :selection-change)))
        :list-box/activate
        (fn [state event ctx]
          (assoc state
                 :activated (:payload event)
                 :event-order
                 (append (:event-order state) :activate)))}
   :children [(list-box/make
               {:options [{:value :a :label "Alpha"}
                          {:value :b :label "Beta"}]
                :style {:width 100}
                :row-height 10
                :visible-rows 2
                :content-width 100
                :multi-select? true
                :toggle-selected? true
                :selected-indices (ui/project-state :selected)
                :item=> (fn [index item]
                              {:component 'activating-item})})]})
