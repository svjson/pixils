(ns pixils.test.option-list-reconciliation-probe
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.option-list :as option-list]))

(pixils/defcomponent preserved-option-row
  {:extend 'ui/option-item})

(pixils/defmode option-list-reconciliation-root
  {:init (fn [state ctx]
           {:expanded? false
            :selected [0]
            :items [{:id :a :value :a :label "Alpha"}
                    {:id :b :value :b :label "Beta"}]})
   :update (fn [state ctx]
             (cond-> state
               (:expanded? state)
               (assoc :items [{:id :c :value :c :label "Gamma"}
                              {:id :a :value :a :label "Updated Alpha"}
                              {:id :b :value :b :label "Beta"}])))
   :children [(option-list/make
               {:options (ui/bind-state :items)
                :selected-indices (ui/bind-state :selected)
                :row-height 16
                :style {:visible-rows 2}
                :item=> 'preserved-option-row})]})
