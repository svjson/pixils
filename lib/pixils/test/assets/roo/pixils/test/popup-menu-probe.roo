(ns pixils.test.popup-menu-probe
  (:require pixils
            [pixils.ui.menu :as menu]))

(def keyboard-menu
  {:items [{:label "File"
            :items [{:label "Open"
                     :action :file/open}
                    :separator
                    {:label "Disabled"
                     :disabled? true
                     :action :file/disabled}
                    {:label "Save"
                     :action :file/save
                     :payload {:source :keyboard}}]}]})

(pixils/defmode popup-keyboard-root
  {:init (fn [_state _ctx]
           {:last-action nil})
   :on {:file/open
        (fn [state event _ctx]
          (assoc state :last-action {:action :file/open
                                     :payload (:payload event)}))
        :file/save
        (fn [state event _ctx]
          (assoc state :last-action {:action :file/save
                                     :payload (:payload event)}))}
   :children [(menu/make-menu
               {:style {:width 120
                        :height 20}}
               keyboard-menu
               {})]})
