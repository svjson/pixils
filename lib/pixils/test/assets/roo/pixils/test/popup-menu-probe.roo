(ns pixils.test.popup-menu-probe
  (:require pixils
            [pixils.ui.menu-bar :as menu-bar]
            [pixils.ui.popup-menu :as popup-menu]))

(def keyboard-menu
  {:items [{:label "File"
            :items [{:label "Open"
                     :action :file/open}
                    :separator
                    {:label "Disabled"
                     :disabled? true
                     :action :file/disabled}
                    {:label "Save"
                     :action :file/save
                     :payload {:source :keyboard}}]}]})

(def submenu-indicator-menu
  {:items [{:label "File"
            :items [{:label "Recent"
                     :items [{:label "Map"
                              :action :file/open-recent}]}
                    {:label "Open"
                     :action :file/open}]}]})

(def context-menu
  {:settings {:mnemonics {:enabled false}}
   :items [{:label "Rename"
            :action :layer/rename}
           {:label "Delete"
            :action :layer/delete}]})

(pixils/defmode popup-keyboard-root
  {:init (fn [_state _ctx]
           {:last-action nil})
   :on {:file/open
        (fn [state event _ctx]
          (assoc state :last-action {:action :file/open
                                     :payload (:payload event)}))
        :file/save
        (fn [state event _ctx]
          (assoc state :last-action {:action :file/save
                                     :payload (:payload event)}))}
   :children [(menu-bar/make
               {:style {:width 120}}
               keyboard-menu
               {})]})

(pixils/defmode popup-classic-blue-root
  {:theme 'pixils/classic-blue
   :children [(menu-bar/make
               {}
               keyboard-menu
               {})]})

(pixils/defmode popup-windows-3-root
  {:theme 'pixils/windows-3
   :children [(menu-bar/make
               {}
               keyboard-menu
               {})]})

(pixils/defmode popup-submenu-indicator-root
  {:theme 'pixils/classic-blue
   :children [(menu-bar/make
               {}
               submenu-indicator-menu
               {})]})

(pixils/defmode popup-context-target
  {:style {:width 100
           :height 30}
   :on-mouse-up (fn [state event ctx]
                  (case (:button event)
                    :right
                    (do
                      (popup-menu/open-context!
                       context-menu
                       (:global-position event)
                       state
                       ctx)
                      state)
                    :default state))})
