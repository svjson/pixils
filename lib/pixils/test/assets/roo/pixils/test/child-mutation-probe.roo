(ns pixils.test.child-mutation-probe
  (:require pixils
            [pixils.ui :as ui]))

(pixils/defcomponent removable-child {})
(pixils/defcomponent retained-child {})
(pixils/defcomponent reconciled-child
  {:ui/state-keys [:value]})

(pixils/defcomponent rebound-child
  {:ui/state-keys [:value :sentinel]})

(pixils/defcomponent child-binding-reconciliation-owner
  {:ui/state-keys [:items :reconcile? :reconciled?]
   :init-ui (fn [ui-state state ctx]
              {:items [{:value :first}
                       {:value :second}]
               :reconcile? false
               :reconciled? false})
   :update-ui (fn [ui-state state ctx]
                (if (and (:reconcile? ui-state)
                         (not (:reconciled? ui-state)))
                  (do
                    (ui/reconcile-children!
                     (:view ctx)
                     [{:component 'rebound-child
                       :id "second"
                       :ui-state {:value (ui/project-state :items 0 :value)}}
                      {:component 'rebound-child
                       :id "first"
                       :ui-state {:value (ui/project-state :items 1 :value)}}])
                    (assoc ui-state :reconciled? true))
                  ui-state))
   :children [{:component 'rebound-child
               :id "first"
               :ui-state {:value (ui/project-state :items 0 :value)}}
              {:component 'rebound-child
               :id "second"
               :ui-state {:value (ui/project-state :items 1 :value)}}]})

(pixils/defmode child-removal-root
  {:init (fn [state ctx]
           {:remove? false
            :removed? false
            :application-value :retained})
   :update (fn [state ctx]
             (if (and (:remove? state)
                      (not (:removed? state)))
               (do
                 (ui/remove-child! (:view ctx) "removable")
                 (assoc state :removed? true))
               state))
   :children [{:mode 'removable-child
               :id "removable"}
              {:mode 'retained-child
               :id "retained"}]})

(pixils/defmode child-reconciliation-root
  {:init (fn [state ctx]
           {:reconcile? false
            :reconciled? false})
   :update (fn [state ctx]
             (if (and (:reconcile? state)
                      (not (:reconciled? state)))
               (do
                 (ui/reconcile-children!
                  (:view ctx)
                  [{:mode 'reconciled-child
                    :id "second"
                    :ui-state {:value 20}}
                   {:mode 'reconciled-child
                    :id "first"
                    :ui-state {:value -1}}
                   {:mode 'reconciled-child
                    :id "third"
                    :ui-state {:value 3}}])
                 (assoc state :reconciled? true))
               state))
   :children [{:mode 'reconciled-child
               :id "first"
               :ui-state {:value 1}}
              {:mode 'reconciled-child
               :id "removed"
               :ui-state {:value 2}}
              {:mode 'reconciled-child
               :id "second"
               :ui-state {:value 20}}]})

(pixils/defmode child-binding-reconciliation-root
  {:children [{:component 'child-binding-reconciliation-owner
               :id "owner"}]})
