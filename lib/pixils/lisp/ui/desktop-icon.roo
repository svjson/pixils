(ns pixils.ui.desktop-icon
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.icon :as icon]))



;; Desktop icon: a focusable/selectable icon with a label underneath.

(def desktop-icon-default-image-size 64)

(defun desktop-icon-label [state]
  (or (:label (icon/icon-item state))
      (:title (icon/icon-item state))
      (:name (icon/icon-item state))
      (:label state)
      ""))

(defun desktop-icon-image [state]
  (or (:image (icon/icon-item state))
      (:image state)))

(defun desktop-icon-selected? [state]
  (or (:selected? state)
      (and (some? (:selected-id state))
           (some? (:id (icon/icon-item state)))
           (= (:id (icon/icon-item state))
              (:selected-id state)))))

(defun update-desktop-icon! [state ctx]
  (let [pos (icon/icon-position state)
        next-state (assoc state
                          :label (desktop-icon-label state)
                          :image (desktop-icon-image state)
                          :selected (desktop-icon-selected? state))]
    (when pos
      (ui/style! (:view ctx)
                 {:position :absolute
                  :left (:x pos)
                  :top (:y pos)}))
    (ui/style! (:view ctx)
               {:hidden (icon/icon-hidden? state)})
    next-state))

(defcomponent ui/desktop-icon-image
  {:class :ui/desktop-icon-image
   :style {:width desktop-icon-default-image-size
           :height desktop-icon-default-image-size
           :background {:fit :contain
                        :align :center}}
   :update (fn [state ctx]
             (if (keyword? (:image state))
               (ui/style! (:view ctx)
                          {:background {:image (:image state)
                                        :fit :contain
                                        :align :center}
                           :hidden false})
               (ui/style! (:view ctx)
                          {:background nil
                           :hidden true}))
             (ui/style! (:view ctx)
                        {:opacity (if (:dragging? state) 0.4 1.0)})
             state)})

(defcomponent ui/desktop-icon-label
  {:class :ui/desktop-icon-label
   :style {:width :fill
           :margin {:t 6}
           :padding {:l 3 :r 3}
           :layout {:align-items :center}
           :text {:align :center}}
   :children [{:class :ui/desktop-icon-label-box
               :style {:width :shrink
                       :layout {:align-items :center}
                       :text {:align :center}}
               :state {:value (ui/bind-state :label)}
               :children [{:mode 'ui/text
                           :class :ui/desktop-icon-label-text
                           :style {:text {:align :center}}
                           :state {:value (ui/bind-state :value)}}]}]})

(defun bound-state-keys [keys]
  (reduce keys
          {}
          (fn [out key]
            (assoc out key (ui/bind-state key)))))

(defun desktop-icon-image-child [opts]
  (let [icon (or (:icon opts) {})]
    {:mode (or (:mode icon) 'ui/desktop-icon-image)
     :style (or (:style icon) {})
     :state (merge (bound-state-keys (or (:state-keys icon)
                                         [:image :dragging?]))
                   (or (:state icon) {}))}))

(defun desktop-icon-label-child [opts]
  (let [label (or (:label opts) {})]
    {:mode (or (:mode label) 'ui/desktop-icon-label)
     :style (or (:style label) {})
     :state (merge (bound-state-keys (or (:state-keys label)
                                         [:label]))
                   (or (:state label) {}))}))

(defun desktop-icon-children [opts]
  [(desktop-icon-image-child opts)
   (desktop-icon-label-child opts)])

(defun desktop-icon-state [opts]
  (cond-> (or (:state opts) {})
    (contains? opts :item) (assoc :item (:item opts))
    (and (contains? opts :label)
         (not (map? (:label opts)))) (assoc :label (:label opts))
    (contains? opts :image) (assoc :image (:image opts))
    (contains? opts :position) (assoc :position (:position opts))
    (contains? opts :selected-id) (assoc :selected-id (:selected-id opts))
    (contains? opts :selected?) (assoc :selected? (:selected? opts))
    (contains? opts :dragging?) (assoc :dragging? (:dragging? opts))))



;; Component definitions

(defcomponent ui/desktop-icon
  {:extend 'ui/icon
   :class :ui/desktop-icon
   :style {:width :shrink
           :height :shrink
           :padding 6
           :layout {:align-items :center}}
   :update update-desktop-icon!
   :children (desktop-icon-children {})})

(defcomponent ui/desktop-icon-preview
  {:extend 'ui/icon-preview
   :class [:ui/desktop-icon :ui/desktop-icon-preview]
   :style {:width :shrink
           :height :shrink
           :padding 6
           :layout {:align-items :center}
           :hit-test false}
   :update update-desktop-icon!
   :children (desktop-icon-children {})})



;; Make functions

(defun make-desktop-icon [{:keys [class style init update on on-click on-double-click on-drop] :as opts}]
  (cond-> {:component 'ui/desktop-icon
           :style (or style {})
           :state (desktop-icon-state opts)
           :children (desktop-icon-children opts)}
    class (assoc :class class)
    init (assoc :init init)
    update (assoc :update update)
    on (assoc :on on)
    on-click (assoc :on-click on-click)
    on-double-click (assoc :on-double-click on-double-click)
    on-drop (assoc :on-drop on-drop)))

(defun make-desktop-icon-preview [{:keys [class style init update on on-click on-double-click on-drop] :as opts}]
  (cond-> {:component 'ui/desktop-icon-preview
           :style (or style {})
           :state (desktop-icon-state opts)
           :children (desktop-icon-children opts)}
    class (assoc :class class)
    init (assoc :init init)
    update (assoc :update update)
    on (assoc :on on)
    on-click (assoc :on-click on-click)
    on-double-click (assoc :on-double-click on-double-click)
    on-drop (assoc :on-drop on-drop)))
