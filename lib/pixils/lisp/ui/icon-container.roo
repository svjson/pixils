(ns pixils.ui.icon-container
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.scroll-pane :as scroll-pane]))



;; Generic icon container behavior

(defun subtract-point [position offset]
  (let [pos (or position {:x 0 :y 0})
        off (or offset {:x 0 :y 0})]
    {:x (- (:x pos) (:x off))
     :y (- (:y pos) (:y off))}))

(defun clamp [value low high]
  (max low (min high value)))

(defun drop-position [event offset]
  (subtract-point (:position event) offset))

(defun grid-options [state]
  (let [grid (or (:grid state) {})]
    {:cell-width (or (:cell-width grid)
                     (:cell-size grid)
                     80)
     :cell-height (or (:cell-height grid)
                      (:cell-size grid)
                      84)
     :origin (or (:origin grid) {:x 0 :y 0})
     :columns (:columns grid)
     :min-rows (:min-rows grid)}))

(defun grid-mode? [state]
  (= (:layout-mode state) :grid))

(defun snap-enabled? [state]
  (or (= (:snap-to-grid? state) true)
      (grid-mode? state)))

(defun grid-columns [state ctx]
  (let [grid (grid-options state)
        configured (:columns grid)
        width (or (:available-width ctx)
                  (-> ctx :view :bounds :w)
                  0)
        cell-width (max 1 (:cell-width grid))]
    (max 1 (or configured
               (int (/ width cell-width))))))

(defun icon-count-from-state [state children]
  (let [key (or (:icon-count-key state) :items)]
    (or (:icon-count state)
        (:item-count state)
        (if (and key (contains? state key))
          (count (or (get state key) []))
          nil)
        (count children))))

(defun icon-entry? [count entry]
  (< (:index entry) count))

(defun icon-children [state children]
  (let [count (icon-count-from-state state children)]
    (map (filter (for-indexed [index child children]
                   {:index index
                    :child child})
                 (fn [entry]
                   (icon-entry? count entry)))
         (fn [entry]
           (:child entry)))))

(defun grid-row-count [count columns]
  (if (> count 0)
    (inc (int (/ (dec count) columns)))
    0))

(defun grid-content-size [state count ctx]
  (let [grid (grid-options state)
        columns (grid-columns state ctx)
        visible-columns (if (> count 0)
                          (min columns count)
                          0)
        rows (max (or (:min-rows grid) 0)
                  (grid-row-count count columns))
        origin (:origin grid)]
    {:w (+ (:x origin) (* visible-columns (:cell-width grid)))
     :h (+ (:y origin) (* rows (:cell-height grid)))}))

(defun icon-container-content-size [state ctx]
  (if (grid-mode? state)
    (grid-content-size state
                       (icon-count-from-state state (ui/children ctx))
                       ctx)
    nil))

(defun grid-cell-position [state index ctx]
  (let [grid (grid-options state)
        columns (grid-columns state ctx)
        col (mod index columns)
        row (int (/ index columns))
        origin (:origin grid)]
    {:x (+ (:x origin) (* col (:cell-width grid)))
     :y (+ (:y origin) (* row (:cell-height grid)))}))

(defun snap-position [state position]
  (let [grid (grid-options state)
        origin (:origin grid)
        cell-width (max 1 (:cell-width grid))
        cell-height (max 1 (:cell-height grid))
        x (- (or (:x position) 0) (:x origin))
        y (- (or (:y position) 0) (:y origin))
        col (max 0 (int (/ (+ x (int (/ cell-width 2))) cell-width)))
        row (max 0 (int (/ (+ y (int (/ cell-height 2))) cell-height)))]
    {:x (+ (:x origin) (* col cell-width))
     :y (+ (:y origin) (* row cell-height))}))

(defun icon-container-position [state raw-position]
  (if (snap-enabled? state)
    (snap-position state raw-position)
    raw-position))

(defun child-state [child]
  (or (:state child) {}))

(defun child-item [child]
  (:item (child-state child)))

(defun child-id [child]
  (or (:id (child-item child))
      (:id (child-state child))))

(defun child-index-by-id [children id]
  (:index (head (filter (for-indexed [index child children]
                          {:index index
                           :child child})
                        (fn [entry]
                          (= (child-id (:child entry)) id))))))

(defun valid-child-index? [children index]
  (and (not (nil? index))
       (>= index 0)
       (< index (count children))))

(defun selected-child-index [state children]
  (cond
    (valid-child-index? children (:selected-index state))
    (:selected-index state)

    (not (nil? (:selected-id state)))
    (child-index-by-id children (:selected-id state))

    :default
    (or (:index (head (filter (for-indexed [index child children]
                                {:index index
                                 :child child})
                              (fn [entry]
                                (let [s (child-state (:child entry))]
                                  (or (= (:selected? s) true)
                                      (= (:selected s) true)))))))
        (if (empty? children) nil 0))))

(defun child-event-payload [child index]
  (let [item (child-item child)
        id (child-id child)]
    {:item item
     :index index
     :id id
     :input-source :keyboard}))

(defun keyboard-target-index [state children key ctx]
  (let [current (selected-child-index state children)
        count (count children)
        columns (grid-columns state ctx)]
    (when (and (not (nil? current))
               (> count 0))
      (case key
        :key/left (clamp (dec current) 0 (dec count))
        :key/right (clamp (inc current) 0 (dec count))
        :key/up (clamp (- current columns) 0 (dec count))
        :key/down (clamp (+ current columns) 0 (dec count))
        :key/home 0
        :key/end (dec count)
        :default nil))))

(defun reorderable-grid? [state]
  (and (grid-mode? state)
       (= (:reorderable? state) true)))

(defun drop-grid-index [state position child-count ctx]
  (let [grid (grid-options state)
        origin (:origin grid)
        cell-width (max 1 (:cell-width grid))
        cell-height (max 1 (:cell-height grid))
        columns (grid-columns state ctx)
        x (- (or (:x position) 0) (:x origin))
        y (- (or (:y position) 0) (:y origin))
        col (clamp (int (/ (+ x (int (/ cell-width 2))) cell-width))
                   0
                   (dec columns))
        row (max 0 (int (/ (+ y (int (/ cell-height 2))) cell-height)))
        raw (+ (* row columns) col)]
    (clamp raw 0 (max 0 (dec child-count)))))

(defun drag-child-index [children payload]
  (cond
    (valid-child-index? children (:index payload))
    (:index payload)

    (not (nil? (:id (:item payload))))
    (child-index-by-id children (:id (:item payload)))

    :default
    nil))

(defun apply-grid-layout! [state ctx]
  (when (grid-mode? state)
    (let [children (ui/children ctx)
          count (icon-count-from-state state children)]
      (for-indexed [index child children]
        (if (< index count)
          (let [pos (grid-cell-position state index ctx)]
            (ui/style! child
                       {:position :absolute
                        :left (:x pos)
                        :top (:y pos)
                        :hidden false}))
          (ui/style! child {:hidden true}))))))

(defun icon-grid-state [state grid snap-to-grid? reorderable? items-key]
  (merge (or state {})
         {:layout-mode :grid
          :snap-to-grid? (if (nil? snap-to-grid?)
                           true
                           snap-to-grid?)}
         (if (nil? grid) {} {:grid grid})
         (if (nil? reorderable?) {} {:reorderable? reorderable?})
         (if (nil? items-key) {} {:icon-count-key items-key})))

(defun icon-grid-container-style [style]
  (merge {:width :fill
          :height :auto}
         (or style {})))

(defun icon-grid-options [grid]
  (merge {:min-rows 1}
         (or grid {})))

(defun icon-grid-scroll-state [scroll-state bind-content-state?]
  (if (= bind-content-state? true)
    (merge {:content-state (ui/bind-state)}
           (or scroll-state {}))
    scroll-state))

(defun icon-grid-scroll-content-state [state content-state bind-content-state?]
  (if (= bind-content-state? true)
    {}
    (or content-state state {})))

(defun make-grid [{:keys [auto-scroll-y bind-content-state? children container-style content-state grid items-key offset reorderable? scroll-state scroll-x? scroll-y? snap-to-grid? state step style]}]
  (let [container-state (icon-grid-state state
                                         (icon-grid-options grid)
                                         snap-to-grid?
                                         reorderable?
                                         (if (contains? (or state {}) :items)
                                           (or items-key :items)
                                           items-key))]
    (scroll-pane/make
     {:style style
      :scroll-x? (if (nil? scroll-x?) false scroll-x?)
      :scroll-y? (if (nil? scroll-y?) :auto scroll-y?)
      :auto-scroll-y auto-scroll-y
      :offset offset
      :step step
      :content-state (icon-grid-scroll-content-state state
                                                     content-state
                                                     bind-content-state?)
      :state (icon-grid-scroll-state scroll-state bind-content-state?)
      :children [{:mode 'ui/icon-container
                  :style (icon-grid-container-style container-style)
                  :state container-state
                  :children children}]})))

(defcomponent ui/icon-container
  {:focusable true
   :style {:width :fill
           :height :fill
           :clip true}
   :content-size icon-container-content-size
   :update (fn [state ctx]
             (do
               (apply-grid-layout! state ctx)
               state))
   :on-key-down (fn [state event ctx]
                  (let [children (icon-children state (ui/children ctx))
                        key (:key event)
                        target-index (keyboard-target-index state children key ctx)
                        selected-index (selected-child-index state children)]
                    (cond
                      (not (nil? target-index))
                      (do
                        (ui/stop-propagation! event)
                        (ui/emit! (:view ctx)
                                  :ui/icon-select
                                  (child-event-payload (nth children target-index)
                                                       target-index))
                        (assoc (assoc state
                                      :selected-index target-index)
                               :selected-id (child-id (nth children target-index))))

                      (and (= key :key/enter)
                           (valid-child-index? children selected-index))
                      (do
                        (ui/stop-propagation! event)
                        (ui/emit! (:view ctx)
                                  :ui/icon-activate
                                  (child-event-payload (nth children selected-index)
                                                       selected-index))
                        state)

                      :default
                      state)))
   :on-drop (fn [state event ctx]
              (let [payload (:payload event)
                    item (:item payload)
                    children (icon-children state (ui/children ctx))
                    raw-position (drop-position event (:offset payload))
                    position (icon-container-position state raw-position)
                    from-index (drag-child-index children payload)
                    to-index (drop-grid-index state
                                              position
                                              (count children)
                                              ctx)]
                (do
                  (when item
                    (if (and (reorderable-grid? state)
                             (valid-child-index? children from-index))
                      (when (not= from-index to-index)
                        (ui/emit! (:view ctx)
                                  :ui/icon-reorder
                                  {:item item
                                   :target (or (:target state)
                                               (:path state))
                                   :from-index from-index
                                   :to-index to-index}))
                      (ui/emit! (:view ctx)
                                :ui/icon-drop
                                {:item item
                                 :target (or (:target state)
                                             (:path state))
                                 :position position
                                 :raw-position raw-position})))
                  state)))})
