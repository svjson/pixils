(ns pixils.ui.base-theme
  (:require pixils
            [pixils.render :as r]
            [pixils.ui.theme-assets :as theme-assets]))

(def theme-bundle :base-theme)
(def menu-option-checkmark :base-theme/menu-option-checkmark)
(def scrollbar-arrow-up :base-theme/scrollbar-arrow-up)
(def scrollbar-arrow-down :base-theme/scrollbar-arrow-down)
(def scrollbar-arrow-left :base-theme/scrollbar-arrow-left)
(def scrollbar-arrow-right :base-theme/scrollbar-arrow-right)
(def menu-option-checkmark-color {:r 0x00 :g 0x00 :b 0x00})
(def scrollbar-arrow-color {:r 0x00 :g 0x00 :b 0x00})

(defun draw-menu-option-checkmark! []
 (let [color menu-option-checkmark-color]
   (r/line! {:x 7 :y 0} {:x 7 :y 1} color)
   (r/line! {:x 6 :y 2} {:x 7 :y 2} color)
   (r/line! {:x 6 :y 3} {:x 6 :y 3} color)
   (r/line! {:x 5 :y 4} {:x 6 :y 4} color)
   (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
   (r/line! {:x 5 :y 5} {:x 5 :y 5} color)
   (r/line! {:x 1 :y 6} {:x 2 :y 6} color)
   (r/line! {:x 4 :y 6} {:x 5 :y 6} color)
   (r/line! {:x 2 :y 7} {:x 2 :y 7} color)
   (r/line! {:x 4 :y 7} {:x 4 :y 7} color)
   (r/line! {:x 2 :y 8} {:x 4 :y 8} color)
   (r/line! {:x 3 :y 9} {:x 3 :y 9} color)))

(defun draw-outline-scrollbar-arrow-up-with-color! [color]
 (r/line! {:x 4 :y 0} {:x 4 :y 0} color)
 (r/line! {:x 3 :y 1} {:x 3 :y 1} color)
 (r/line! {:x 5 :y 1} {:x 5 :y 1} color)
 (r/line! {:x 2 :y 2} {:x 2 :y 2} color)
 (r/line! {:x 6 :y 2} {:x 6 :y 2} color)
 (r/line! {:x 1 :y 3} {:x 1 :y 3} color)
 (r/line! {:x 7 :y 3} {:x 7 :y 3} color)
 (r/line! {:x 0 :y 4} {:x 3 :y 4} color)
 (r/line! {:x 5 :y 4} {:x 8 :y 4} color)
 (r/line! {:x 3 :y 5} {:x 3 :y 7} color)
 (r/line! {:x 5 :y 5} {:x 5 :y 7} color)
 (r/line! {:x 3 :y 8} {:x 5 :y 8} color))

(defun draw-scrollbar-arrow-up! []
  (draw-outline-scrollbar-arrow-up-with-color! scrollbar-arrow-color))

(defun draw-scrollbar-arrow-down! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation 3.14159265}))

(defun draw-scrollbar-arrow-left! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation -1.57079633}))

(defun draw-scrollbar-arrow-right! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation 1.57079633}))

(defun ensure-base-theme-assets! []
  (do
    (theme-assets/ensure-generated-image! theme-bundle
                                          menu-option-checkmark
                                          {:size {:w 8 :h 10}}
                                          draw-menu-option-checkmark!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-up
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-up!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-down
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-down!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-left
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-left!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-right
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-right!)))

(ensure-base-theme-assets!)

(def TEXT-INPUT-FRAME-STYLE
  {:width 80
   :height 22
   :background (pixils/var :field-bg)
   :border (pixils/var :inset-border-style)})

(def definition
  {:default-variant :base
   :vars {:base {:split-pane-resizer-size 6
                 :scrollbar-size 14
                 :surface {:r 0xff :g 0xff :b 0xff}
                 :panel-bg {:r 0xcc :g 0xcc :b 0xcc}
                 :field-bg {:r 0xff :g 0xff :b 0xff}
                 :text {:r 0x00 :g 0x00 :b 0x00}
                 :muted-text {:r 0x66 :g 0x66 :b 0x66}
                 :inactive-text {:r 0x88 :g 0x88 :b 0x88}
                 :border {:r 0x00 :g 0x00 :b 0x00}
                 :border-light (pixils/var :border)
                 :border-dark (pixils/var :border)
                 :border-inset-top-left (pixils/var :border-dark)
                 :border-inset-bottom-right (pixils/var :border-light)
                 :border-raised-top-left (pixils/var :border-light)
                 :border-raised-bottom-right (pixils/var :border-dark)
                 :inset-border-style {:color (pixils/var :border)
                                      :thickness 1
                                      :top {:color (pixils/var :border-inset-top-left)}
                                      :left {:color (pixils/var :border-inset-top-left)}
                                      :right {:color (pixils/var :border-inset-bottom-right)}
                                      :bottom {:color (pixils/var :border-inset-bottom-right)}}
                 :disabled-bg {:r 0xcc :g 0xcc :b 0xcc}
                 :disabled-text {:r 0x66 :g 0x66 :b 0x66}
                 :disabled-border {:r 0x66 :g 0x66 :b 0x66}
                 :disabled-border-light (pixils/var :disabled-border)
                 :disabled-border-dark (pixils/var :disabled-border)
                 :disabled-border-inset-top-left (pixils/var :disabled-border-dark)
                 :disabled-border-inset-bottom-right (pixils/var :disabled-border-light)
                 :disabled-inset-border-style {:color (pixils/var :disabled-border)
                                               :thickness 1
                                               :top {:color (pixils/var :disabled-border-inset-top-left)}
                                               :left {:color (pixils/var :disabled-border-inset-top-left)}
                                               :right {:color (pixils/var :disabled-border-inset-bottom-right)}
                                               :bottom {:color (pixils/var :disabled-border-inset-bottom-right)}}
                 :selection-bg {:r 0x00 :g 0x00 :b 0x00}
                 :selection-text {:r 0xff :g 0xff :b 0xff}
                 :menu-option-indicator {:selected-image :base-theme/menu-option-checkmark}
                 :menu-submenu-indicator {:text ">"}
                 :scrollbar-button-symbols {:up-image :base-theme/scrollbar-arrow-up
                                            :down-image :base-theme/scrollbar-arrow-down
                                            :left-image :base-theme/scrollbar-arrow-left
                                            :right-image :base-theme/scrollbar-arrow-right}}}
 :styles
 {:ui/app {:background (pixils/var :surface)
           :text {:color (pixils/var :text)}}

  :ui/panel {:background (pixils/var :panel-bg)
             :padding 4}

  :ui/title {:text {:color (pixils/var :text)}}

  :ui/muted {:text {:color (pixils/var :muted-text)}}

  :ui/accent {:text {:color (pixils/var :text)}}

  :ui/canvas {:background (pixils/var :field-bg)
              :border (pixils/var :inset-border-style)}

  :ui/content {:background (pixils/var :surface)
               :border (pixils/var :inset-border-style)
               :clip true}

  'ui/tab-panel {:background (pixils/var :surface)
                 :layout {:direction :column}}

  'ui/tab-strip {:background (pixils/var :surface)
                 :layout {:direction :row}}

  'ui/tab {:padding [3 8]
           :background (pixils/var :panel-bg)
           :border (pixils/var :inset-border-style)
           :text {:color (pixils/var :text)}}

  '(ui/tab {:selected? true})
  {:background (pixils/var :surface)}

  'ui/tab:disabled
  {:background (pixils/var :disabled-bg)
   :text {:color (pixils/var :disabled-text)}}

  'ui/tab-panel-body {:width :fill
                      :height :fill
                      :background (pixils/var :surface)
                      :border (pixils/var :inset-border-style)}

  :ui/list-item {:text {:color (pixils/var :text)}}

  :ui/list-item-hover:hover
  {:background (pixils/var :selection-bg)
   :text {:color (pixils/var :selection-text)}}

  '(:ui/list-item {:selected true})
  {:background (pixils/var :selection-bg)
   :text {:color (pixils/var :selection-text)}}

  'ui/list-box {:background (pixils/var :field-bg)
                :border (pixils/var :inset-border-style)}

  'ui/combo-box {:background (pixils/var :field-bg)
                 :border (pixils/var :inset-border-style)}

  'ui/combo-box-trigger {:padding [3 5]
                         :layout {:direction :row
                                  :align-items :center
                                  :gap :space-between}}

  'ui/combo-box-button {:width 14
                        :height :fill}

  'ui/combo-box-trigger:hover
  {:text {:color (pixils/var :selection-text)}
   :background (pixils/var :selection-bg)}

  'ui/combo-box-popup-panel {:background (pixils/var :field-bg)
                             :border (pixils/var :inset-border-style)}

  'ui/checkbox {:height 16
                :layout {:direction :row
                         :align-items :center
                         :gap 4}
                :text {:color (pixils/var :text)}}

  'ui/checkbox-box {:width 12
                    :height 12
                    :background (pixils/var :field-bg)
                    :border (pixils/var :inset-border-style)
                    :text {:color (pixils/var :text)}}

  '(ui/checkbox-box {:pressed true})
  {:background (pixils/var :disabled-bg)}

  'ui/slider {:background (pixils/var :field-bg)
              :border (pixils/var :inset-border-style)}

  :ui/split-pane-resizer {:border (pixils/var :inset-border-style)}

  '(:ui/split-pane-resizer {:axis :x})
  {:width (pixils/var :split-pane-resizer-size)
   :height :fill
   :cursor :resize-x}

  '(:ui/split-pane-resizer {:axis :y})
  {:width :fill
   :height (pixils/var :split-pane-resizer-size)
   :cursor :resize-y}

  'ui/scrollbar {:background (pixils/var :surface)
                 :text {:color (pixils/var :text)}}

  'ui/scrollbar-button {:background (pixils/var :surface)
                        :border (pixils/var :inset-border-style)
                        :text {:color (pixils/var :text)}}

  '(ui/scrollbar-button {:pressed true})
  {:background (pixils/var :disabled-bg)}

  'ui/scrollbar-button:disabled
  {:background (pixils/var :disabled-bg)
   :border (pixils/var :disabled-inset-border-style)
   :text {:color (pixils/var :disabled-text)}}

  'ui/scrollbar-track {:background (pixils/var :surface)}

  'ui/scrollbar-handle {:background (pixils/var :surface)
                        :border (pixils/var :inset-border-style)}

  '(ui/scrollbar-handle {:pressed true})
  {:background (pixils/var :disabled-bg)}

  'ui/scrollbar-corner {:background (pixils/var :surface)
                        :border (pixils/var :inset-border-style)}

  'ui/scroll-pane {:background (pixils/var :surface)}

  'ui/scroll-pane-viewport {:background (pixils/var :surface)}


  'ui/header-panel {:padding 0
                    :layout {:direction :column}}

  'ui/header-panel-header {:width :fill
                           :padding [2 4]
                           :layout {:direction :row}
                           :background (pixils/var :surface)
                           :border {:bottom {:color (pixils/var :border)
                                             :thickness 1}}}

  'ui/header-panel-body {:width :fill
                         :height :fill
                         :padding 4}

  'ui/window {:border (pixils/var :inset-border-style)
              :text {:color (pixils/var :text)}}

  'ui/window-title-bar {:background (pixils/var :surface)
                        :text {:color (pixils/var :inactive-text)}
                        :border {:bottom {:color (pixils/var :border)
                                          :thickness 1}}
                        :width :fill
                        :height 19
                        :padding 0
                        :layout {:direction :row
                                 :gap :space-between}}

  'ui/window-body {:width :fill}

  ['ui/window:focus-within 'ui/window-title-bar]
  {:text {:color (pixils/var :text)}}

  'ui/window-control-button {:hidden true
                             :width 18
                             :height 18}

  'ui/window-minimize-button {:hidden true
                              :width 18
                              :height 18}

  'ui/button-inner
  {:text {:color (pixils/var :text)}
   :background (pixils/var :field-bg)
   :layout {:direction :row
            :align-items :center}
   :border (pixils/var :inset-border-style)}

  ['ui/button-inner 'ui/text]
  {:padding [3 6]}

  :ui/toolbar-button
  {:width 18
   :height 18}

  [:ui/toolbar-button 'ui/button-inner 'ui/text]
  {:padding [0 3]}

  'ui/button-inner:hover
  {:text {:color (pixils/var :selection-text)}
   :background (pixils/var :selection-bg)
   :layout {:direction :row
            :align-items :center}
   :border (pixils/var :inset-border-style)}

  '(ui/button-inner {:pressed true})
  {:background (pixils/var :disabled-bg)}

  'ui/button-inner:disabled
  {:text {:color (pixils/var :disabled-text)}
   :background (pixils/var :disabled-bg)
   :border (pixils/var :disabled-inset-border-style)}

  'ui/text-input TEXT-INPUT-FRAME-STYLE

  'ui/number-input TEXT-INPUT-FRAME-STYLE

  'ui/text-input-inner {:width :fill
                        :height :fill
                        :padding [0 4]
                        :layout {:direction :row
                                 :align-items :center}}

  'ui/text-input-inner:disabled
  {:text {:color (pixils/var :disabled-text)}
   :background (pixils/var :disabled-bg)}

  'ui/menu-bar {:background (pixils/var :surface)}

  'ui/popup-menu-item
  {:padding [2 16]}

  'ui/popup-menu-option-item
  {:padding [2 2]}

  :menu/shortcut-column
  {:margin {:l 16}}

  :menu/item
  {:text {:color (pixils/var :text)
          :marked-style {:enabled true
                         :marker "@"
                         :font-styles :underline}}}

  :menu/item:hover
  {:text {:color (pixils/var :selection-text)}
   :background (pixils/var :selection-bg)}

  :menu/item:disabled
  {:text {:color (pixils/var :disabled-text)
          :marked-style {:color (pixils/var :disabled-text)}}
   :background (pixils/var :surface)}

  :ui/list-item:disabled
  {:text {:color (pixils/var :disabled-text)}
   :background (pixils/var :surface)}

  'ui/combo-box-trigger:disabled
  {:text {:color (pixils/var :disabled-text)}
   :background (pixils/var :disabled-bg)}

  'ui/combo-box:disabled
  {:background (pixils/var :disabled-bg)
   :border (pixils/var :disabled-inset-border-style)}

  'ui/menu-option-item {:padding {:t 2 :r 12 :b 2 :l 2}}

  'ui/menu-option-indicator {:margin {:l 2 :r 4}
                             :box-sizing :content-box
                             :width 8
                             :height 10}

  'ui/menu-submenu-indicator {:margin {:l 8 :r 2}
                              :box-sizing :content-box
                              :width 8
                              :height 10}

  'ui/menu-separator
  {:height 1
   :margin {:t 3 :r 0 :b 2 :l 0}
   :border {:thickness 1
            :line-style :solid
            :color (pixils/var :border)
            :right {:thickness 0}
            :bottom {:thickness 0}
            :left {:thickness 0}}}

  'ui/popup-menu-inner
  {:text {:color (pixils/var :text)}
   :background (pixils/var :surface)
   :border (pixils/var :inset-border-style)}}})
