(ns pixils.ui.file-dialog
  (:require pixils
            [roo.io :as io]
            [pixils.ui :as ui]
            pixils.ui.combo-box
            [pixils.ui.dialog :as dialog]))

(def default-path (io/current-directory!))

(def default-filters
  [{:label "EDN files (*.edn)"
    :extensions [".edn"]}
   {:label "All files (*)"
    :extensions []}])

(defun filter-patterns [{:keys [patterns extensions]}]
  (or patterns
      (for [extension extensions]
        (str "*" extension))))

(defun file-list-options [filter]
  (let [patterns (filter-patterns filter)]
    (if (empty? patterns)
      {:directories? false}
      {:directories? false
       :filter patterns})))

(defun list-directory [path filter]
  (concat (io/list-directory! path {:files? false})
          (io/list-directory! path (file-list-options filter))))

(defun accessible-directory? [path]
  (and (some? path)
       (not-empty? path)
       (io/directory? path)))

(defun safe-list-directory [path filter]
  (if (accessible-directory? path)
    (list-directory path filter)
    []))

(defun parent-path [path]
  (let [parent (io/parent-path path)]
    (if (empty? parent)
      path
      parent)))

(defun join-path [path name]
  (cond
    (or (nil? name)
        (empty? name))
    path

    :default
    (io/join-path path name)))

(defun normalize-dialog-mode [mode]
  (case mode
    :file-dialog/save :file-dialog/save
    :save :file-dialog/save
    :default :file-dialog/open))

(defun confirm-label [mode]
  (case (normalize-dialog-mode mode)
    :file-dialog/save "Save"
    :default "Open"))

(defun default-title [mode]
  (case (normalize-dialog-mode mode)
    :file-dialog/save "Save File"
    :default "Open File"))

(defun directory-entry? [entry]
  (= (:type entry) :directory))

(defun file-entry? [entry]
  (= (:type entry) :file))

(defun entry-label [entry]
  (str (if (directory-entry? entry) "[D] " "    ")
       (:name entry)))

(defun entry-options [entries]
  (for [entry entries]
    (merge entry
           {:value entry
            :label (entry-label entry)})))

(defun filter-options [filters]
  (for [filter (or filters default-filters)]
    {:value filter
     :label (:label filter)}))

(defun multi-select-dialog? [opts mode]
  (and (= mode :file-dialog/open)
       (or (:multi-select? opts)
           (:multi-file? opts))))

(defun initial-state [opts]
  (let [path (or (:path opts) default-path)
        mode (normalize-dialog-mode (:mode opts))
        filters (or (:filters opts) default-filters)
        filter-index (or (:filter-index opts) 0)
        selected-filter (nth filters filter-index)]
    {:dialog-mode mode
     :path path
     :pending-path path
     :path-error nil
     :entry-path path
     :entries (safe-list-directory path selected-filter)
     :selected-indices []
     :selected-entries []
     :selected-entry nil
     :multi-select? (multi-select-dialog? opts mode)
     :filename (or (:filename opts) "")
     :filters filters
     :filter-index filter-index
     :selected-filter selected-filter
     :filter-options (filter-options filters)}))

(defun entry-list-child [entries selected-indices multi-select?]
  (merge
   {:id "entry-list"}
   (pixils.ui.list-box/make
    {:options (entry-options entries)
     :style {:width :fill
             :visible-rows 6}
     :selected-indices (or selected-indices [])
     :multi-select? multi-select?
     :toggle-selected? false})))

(defun navigate-to [state path]
  (if (accessible-directory? path)
    (assoc state
           :path path
           :pending-path path
           :path-error nil
           :entry-path nil
           :entries (safe-list-directory path (:selected-filter state))
           :selected-indices []
           :selected-entries []
           :selected-entry nil
           :filename "")
    (assoc state
           :pending-path path
           :path-error "Folder not found")))

(defun selected-file-entries [state]
  (filter (:selected-entries state) file-entry?))

(defun selected-file-paths [state]
  (let [entries (selected-file-entries state)
        filename (or (:filename state) "")]
    (cond
      (not-empty? entries)
      (for [entry entries] (:path entry))

      (not-empty? filename)
      [(join-path (:path state) filename)]

      :default
      [])))

(defun selected-file-names [state]
  (let [entries (selected-file-entries state)
        filename (or (:filename state) "")]
    (cond
      (not-empty? entries)
      (for [entry entries] (:name entry))

      (not-empty? filename)
      [filename]

      :default
      [])))

(defun selected-file-path [state]
  (head (selected-file-paths state)))

(defun selected-file-name [state]
  (head (selected-file-names state)))

(defun confirm-result [state]
  {:type :confirm
   :mode (:dialog-mode state)
   :path (selected-file-path state)
   :paths (selected-file-paths state)
   :directory (:path state)
   :filename (selected-file-name state)
   :filenames (selected-file-names state)
   :filter (:selected-filter state)})

(defun cancel-result [state]
  {:type :cancel
   :mode (:dialog-mode state)
   :directory (:path state)
   :filename (:filename state)})

(defun confirm-or-navigate [{:keys [selected-entry] :as state} {:keys [view]}]
  (if (and selected-entry
           (directory-entry? selected-entry)
           (empty? (selected-file-entries state)))
    (navigate-to state (:path selected-entry))
    (do
      (ui/emit! view :file-dialog/confirm (confirm-result state))
      state)))

(defun activate-entry [state {:keys [index value]} ctx]
  (let [entry value
        next-state (assoc state
                          :selected-indices [index]
                          :selected-entries [entry]
                          :selected-entry entry
                          :filename (if (file-entry? entry)
                                      (:name entry)
                                      ""))]
    (confirm-or-navigate next-state ctx)))

(defcomponent ui/file-dialog-path-row
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :children [{:mode 'ui/text
               :state {:value "Folder:"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 22}
               :state {:value (ui/bind-state :pending-path)}}
              {:mode 'ui/button
               :state {:label "Up"}
               :on-click (fn [state event ctx]
                           (ui/emit! (:view ctx) :file-dialog/up)
                           state)}]
   :on {:text-input/change (fn [state event ctx]
                             (ui/stop-propagation! event)
                             (assoc state
                                    :pending-path (-> event :payload :value)
                                    :path-error nil))}
   :on-key-down (fn [state event ctx]
                  (when (= (:key event) :key/enter)
                    (ui/stop-propagation! event)
                    (ui/emit! (:view ctx)
                              :file-dialog/commit-path
                              {:path (:pending-path state)}))
                  state)})

(defcomponent ui/file-dialog-name-row
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :children [{:mode 'ui/text
               :state {:value "File:"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height 22}
               :state {:value (ui/bind-state :filename)
                       :auto-focus? (ui/bind-state :auto-focus-filename?)}}]})

(defcomponent ui/file-dialog-filter-row
  {:style {:width :fill
           :height 24
           :layout {:direction :row
                    :align-items :center
                    :gap 6}}
   :children [{:mode 'ui/text
               :state {:value "File type:"}}
              {:mode 'ui/combo-box
               :style {:width :fill
                       :height 22}
               :state {:options (ui/bind-state :filter-options)
                       :selected-index (ui/bind-state :filter-index)
                       :row-height 20
                       :max-height 96}}]})

(defun button-row-child [state]
  {:mode 'ui/dialog-button-row
   :class [:ui/dialog-button-row
           :ui/file-dialog-button-row]
   :state {:dialog-mode (ui/bind-state :dialog-mode)
           :path (ui/bind-state :path)
           :selected-entry (ui/bind-state :selected-entry)
           :selected-entries (ui/bind-state :selected-entries)
           :filename (ui/bind-state :filename)
           :selected-filter (ui/bind-state :selected-filter)}
   :children [{:mode 'ui/button
               :class [:ui/dialog-button
                       :ui/dialog-button-cancel
                       :ui/file-dialog-button
                       :ui/file-dialog-cancel-button]
               :state {:label "Cancel"
                       :dialog-mode (ui/bind-state :dialog-mode)
                       :path (ui/bind-state :path)
                       :filename (ui/bind-state :filename)}
               :on-mouse-up (fn [state event ctx]
                               (ui/stop-propagation! event)
                               (ui/emit! (:view ctx)
                                         :file-dialog/cancel
                                         (cancel-result state))
                               state)}
              {:mode 'ui/button
               :class [:ui/dialog-button
                       :ui/dialog-button-ok
                       :ui/file-dialog-button
                       :ui/file-dialog-confirm-button]
               :state {:label (confirm-label (:dialog-mode state))
                       :dialog-mode (ui/bind-state :dialog-mode)
                       :path (ui/bind-state :path)
                       :selected-entry (ui/bind-state :selected-entry)
                       :selected-entries (ui/bind-state :selected-entries)
                       :filename (ui/bind-state :filename)
                       :selected-filter (ui/bind-state :selected-filter)}
               :on-mouse-up (fn [state event ctx]
                               (ui/stop-propagation! event)
                               (confirm-or-navigate state ctx))}]})

(defcomponent ui/file-dialog-body
  {:class [:ui/content
           :ui/dialog-body
           :ui/file-dialog-body]
   :init (fn [state ctx]
           (let [path (or (:path state) default-path)
                 filters (or (:filters state) default-filters)
                 filter-index (or (:filter-index state) 0)]
             (assoc state
                    :path path
                    :pending-path (or (:pending-path state) path)
                    :filters filters
                    :filter-index filter-index
                    :selected-filter (or (:selected-filter state)
                                         (nth filters filter-index))
                    :filter-options (filter-options filters))))
   :update (fn [state ctx]
             (let [path (or (:path state) default-path)]
               (if (= path (:entry-path state))
                 state
                 (let [entries (safe-list-directory path
                                                    (:selected-filter state))]
                   (ui/replace-child! (:view ctx)
                                      "entry-list"
                                      (entry-list-child entries
                                                        []
                                                        (:multi-select? state)))
                   (assoc state
                          :path path
                          :pending-path path
                          :path-error nil
                          :entry-path path
                          :entries entries
                          :selected-indices []
                          :selected-entries []
                          :selected-entry nil
                          :filename "")))))
   :on {:list-box/selection-change (fn [state {:keys [payload] :as event} ctx]
                           (let [indices (or (:selected-indices payload) [])
                                 entries (or (:selected-values payload) [])
                                 entry (head entries)
                                 file-entries (filter entries file-entry?)]
                             (ui/stop-propagation! event)
                             (assoc state
                                    :selected-indices indices
                                    :selected-entries entries
                                    :selected-entry entry
                                    :filename (case (count file-entries)
                                                1 (:name (head file-entries))
                                                :default ""))))
        :file-dialog/up (fn [state event ctx]
                          (ui/stop-propagation! event)
                          (navigate-to state (parent-path (:path state))))
        :file-dialog/commit-path (fn [state event ctx]
                                   (ui/stop-propagation! event)
                                   (navigate-to state
                                                (-> event :payload :path)))
        :combo-box/change (fn [state event ctx]
                            (let [filter-index (-> event :payload :selected-index)
                                  selected-filter (-> event :payload :value)
                                  entries (safe-list-directory (:path state)
                                                               selected-filter)]
                              (ui/stop-propagation! event)
                              (ui/replace-child! (:view ctx)
                                                 "entry-list"
                                                 (entry-list-child entries
                                                                   []
                                                                   (:multi-select? state)))
                              (assoc state
                                     :filter-index filter-index
                                     :selected-filter selected-filter
                                     :entries entries
                                     :selected-indices []
                                     :selected-entries []
                                     :selected-entry nil
                                     :filename "")))
        :list-box/activate (fn [state event ctx]
                             (ui/stop-propagation! event)
                             (activate-entry state
                                             (:payload event)
                                             ctx))}})

(defun make-body [opts]
  (let [state (initial-state opts)]
    {:mode 'ui/file-dialog-body
     :state (merge state
                   {:confirm-label (confirm-label (:dialog-mode state))
                    :auto-focus-filename? (= (:dialog-mode state)
                                             :file-dialog/save)})
     :children [{:mode 'ui/file-dialog-path-row
                 :state {:path (ui/bind-state :path)
                         :pending-path (ui/bind-state :pending-path)
                         :path-error (ui/bind-state :path-error)}}
                (entry-list-child (:entries state)
                                  (:selected-indices state)
                                  (:multi-select? state))
                {:mode 'ui/file-dialog-name-row
                 :state {:filename (ui/bind-state :filename)
                         :auto-focus-filename? (ui/bind-state :auto-focus-filename?)}}
                {:mode 'ui/file-dialog-filter-row
                 :state {:filter-options (ui/bind-state :filter-options)
                         :filter-index (ui/bind-state :filter-index)}}
                (button-row-child state)]}))

(defun result-from-event [state event ctx]
  (:payload event))

(defun open-file-dialog! [ctx opts]
  (let [mode (normalize-dialog-mode (:mode opts))
        state (initial-state (assoc opts :mode mode))]
    (dialog/open-dialog!
     ctx
     (merge opts
            {:title (or (:title opts)
                        (default-title mode))
             :class (dialog/merge-classes [:ui/file-dialog-window]
                                          (:class opts))
             :style (or (:style opts) {})
             :state state
             :body (make-body (assoc opts :mode mode))
             :result-event (or (:result-event opts)
                               :file-dialog/result)
             :results {:file-dialog/confirm result-from-event
                       :file-dialog/cancel result-from-event}}))))
