(ns pixils.ui.theme.classic-blue
  (:require pixils
            [pixils.color :as c]
            [pixils.render :as r]
            [pixils.ui.theme-assets :as theme-assets]))

(def theme-bundle :classic-blue-theme)
(def scrollbar-arrow-up :classic-blue-theme/scrollbar-arrow-up)
(def scrollbar-arrow-down :classic-blue-theme/scrollbar-arrow-down)
(def scrollbar-arrow-left :classic-blue-theme/scrollbar-arrow-left)
(def scrollbar-arrow-right :classic-blue-theme/scrollbar-arrow-right)

(defun draw-classic-scrollbar-arrow-with-color! [direction color]
  (case direction
    :up (do
          (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
          (r/line! {:x 2 :y 1} {:x 4 :y 1} color)
          (r/line! {:x 1 :y 2} {:x 5 :y 2} color)
          (r/line! {:x 0 :y 3} {:x 1 :y 3} color)
          (r/line! {:x 5 :y 3} {:x 6 :y 3} color))
    :down (do
            (r/line! {:x 0 :y 0} {:x 1 :y 0} color)
            (r/line! {:x 5 :y 0} {:x 6 :y 0} color)
            (r/line! {:x 1 :y 1} {:x 5 :y 1} color)
            (r/line! {:x 2 :y 2} {:x 4 :y 2} color)
            (r/line! {:x 3 :y 3} {:x 3 :y 3} color))
    :left (do
            (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
            (r/line! {:x 2 :y 1} {:x 3 :y 1} color)
            (r/line! {:x 1 :y 2} {:x 2 :y 2} color)
            (r/line! {:x 0 :y 3} {:x 2 :y 3} color)
            (r/line! {:x 1 :y 4} {:x 2 :y 4} color)
            (r/line! {:x 2 :y 5} {:x 3 :y 5} color)
            (r/line! {:x 3 :y 6} {:x 3 :y 6} color))
    :right (do
             (r/line! {:x 0 :y 0} {:x 0 :y 0} color)
             (r/line! {:x 0 :y 1} {:x 1 :y 1} color)
             (r/line! {:x 1 :y 2} {:x 2 :y 2} color)
             (r/line! {:x 1 :y 3} {:x 3 :y 3} color)
             (r/line! {:x 1 :y 4} {:x 2 :y 4} color)
             (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
             (r/line! {:x 0 :y 6} {:x 0 :y 6} color))
    :default nil))

(defun draw-scrollbar-arrow-up! []
  (draw-classic-scrollbar-arrow-with-color! :up c/WHITE))

(defun draw-scrollbar-arrow-down! []
  (draw-classic-scrollbar-arrow-with-color! :down c/WHITE))

(defun draw-scrollbar-arrow-left! []
  (draw-classic-scrollbar-arrow-with-color! :left c/WHITE))

(defun draw-scrollbar-arrow-right! []
  (draw-classic-scrollbar-arrow-with-color! :right c/WHITE))

(defun ensure-classic-blue-theme-assets! []
  (do
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-up
                                          {:size {:w 7 :h 4}}
                                          draw-scrollbar-arrow-up!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-down
                                          {:size {:w 7 :h 4}}
                                          draw-scrollbar-arrow-down!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-left
                                          {:size {:w 4 :h 7}}
                                          draw-scrollbar-arrow-left!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-right
                                          {:size {:w 4 :h 7}}
                                          draw-scrollbar-arrow-right!)))

(ensure-classic-blue-theme-assets!)

(def BUTTON-BG {:r 0x3d :g 0x4a :b 0x5e})
(def BUTTON-HIGHLIGHT {:r 0x67 :g 0x78 :b 0x8f})
(def BUTTON-SHADOW {:r 0x2d :g 0x36 :b 0x46})
(def BUTTON-GLYPH {:r 0xf5 :g 0xf6 :b 0xf3})
(def HIGHLIGHT-COLOR {:r 0xff :g 0xcc :b 0x66})
(def DISABLED-BG {:r 0x25 :g 0x2d :b 0x38})
(def DISABLED-BORDER {:r 0x43 :g 0x4d :b 0x5a})
(def DISABLED-TEXT {:r 0x72 :g 0x7c :b 0x88})

(def TITLE-BAR-BG {:r 0x29 :g 0x3e :b 0x5c})
(def TITLE-BAR-HIGHLIGHT {:r 0x7c :g 0x8d :b 0xa8})
(def TITLE-BAR-SHADOW {:r 0x56 :g 0x6d :b 0x87})

(def PANEL-BG {:r 0x20 :g 0x29 :b 0x36})
(def PANEL-HIGHLIGHT {:r 0x67 :g 0x78 :b 0x8f})
(def PANEL-SHADOW {:r 0x2d :g 0x36 :b 0x46})

(def CONTENT-BG {:r 0x2d :g 0x39 :b 0x48})
(def CONTENT-BORDER {:r 0x5f :g 0x6f :b 0x7f})

(def TEXT-INPUT-FRAME-STYLE
  {:width 80
   :background (var :content-bg)
   :border (var :inset-border-style)
   :text {:color (var :text)}})

(deffont classic-blue-font
  {:type :ttf
   :resource :pixils/autoega-8x14
   :size 14
   :spacing 0
   :line-height 14})

(deftheme pixils/classic-blue
  {:vars {:dark {:menu-bg CONTENT-BG
                 :content-bg CONTENT-BG
                 :panel-bg PANEL-BG
                 :panel-highlight PANEL-HIGHLIGHT
                 :panel-shadow PANEL-SHADOW
                 :button-bg BUTTON-BG
                 :button-hover-bg (var :button-bg)
                 :button-pressed-bg (var :button-bg)
                 :button-disabled-bg (var :panel-bg)
                 :button-highlight BUTTON-HIGHLIGHT
                 :highlight-color HIGHLIGHT-COLOR
                 :button-shadow BUTTON-SHADOW
                 :button-glyph BUTTON-GLYPH
                 :title-bar-bg TITLE-BAR-BG
                 :title-bar-highlight TITLE-BAR-HIGHLIGHT
                 :title-bar-shadow TITLE-BAR-SHADOW
                 :content-border CONTENT-BORDER
                 :surface (var :content-bg)
                 :field-bg (var :content-bg)
                 :field-text (var :text)
                 :muted-text {:r 0xa7 :g 0xb0 :b 0xb8}
                 :inactive-text {:r 0xa7 :g 0xb0 :b 0xb8}
                 :disabled-bg DISABLED-BG
                 :disabled-border DISABLED-BORDER
                 :disabled-text DISABLED-TEXT
                 :border c/BLACK
                 :border-light (var :button-highlight)
                 :border-dark (var :button-shadow)
                 :border-inset-top-left (var :border-dark)
                 :border-inset-bottom-right (var :border-light)
                 :border-raised-top-left (var :border-light)
                 :border-raised-bottom-right (var :border-dark)
                 :text c/WHITE
                 :focus-text BUTTON-HIGHLIGHT
                 :selection-bg {:r 0x4a :g 0x3f :b 0x24}
                 :selection-text (var :text)
                 :desktop-icon-label-padding 1
                 :content-border-style {:line-style :solid
                                        :color (var :content-border)
                                        :thickness 1}
                 :inset-border-style {:line-style :solid
                                      :color (var :panel-shadow)
                                      :thickness 1
                                      :right {:color (var :panel-highlight)}
                                      :bottom {:color (var :panel-highlight)}}
                 :raised-border-style {:line-style :solid
                                       :color (var :button-highlight)
                                       :thickness 1
                                       :right {:color (var :button-shadow)}
                                       :bottom {:color (var :button-shadow)}}
                 :pressed-border-style {:line-style :solid
                                        :color (var :button-shadow)
                                        :thickness 1
                                        :right {:color (var :button-highlight)}
                                        :bottom {:color (var :button-highlight)}}
                 :button-border-style {:line-style :bevel
                                       :color (var :button-highlight)
                                       :thickness 2
                                       :right {:color (var :button-shadow)}
                                       :bottom {:color (var :button-shadow)}}
                 :button-pressed-border-style {:line-style :bevel
                                               :color (var :button-shadow)
                                               :thickness 2
                                               :right {:color (var :button-highlight) :thickness 1}
                                               :bottom {:color (var :button-highlight) :thickness 1}}
                 :button-hover-border-style (var :button-border-style)
                 :button-disabled-border-style {:line-style :solid
                                                :color (var :panel-shadow)
                                                :thickness 1}
                 :disabled-inset-border-style {:line-style :solid
                                               :color (var :disabled-border)
                                               :thickness 1
                                               :right {:color (var :button-shadow)}
                                               :bottom {:color (var :button-shadow)}}
                 :split-pane-resizer-size 8
                 :scrollbar-size 14
                 :menu-option-indicator {:selected-text "[x]"
                                         :unselected-text "[ ]"}
                 :menu-submenu-indicator {:text ">"}
                 :scrollbar-button-symbols {:up-image :classic-blue-theme/scrollbar-arrow-up
                                            :down-image :classic-blue-theme/scrollbar-arrow-down
                                            :left-image :classic-blue-theme/scrollbar-arrow-left
                                            :right-image :classic-blue-theme/scrollbar-arrow-right}}}
   :default-variant :dark
   :defaults {:text {:font :font/classic-blue-font}}
   :styles
   {:ui/panel {:background PANEL-BG
               :padding 4}

    :ui/app {:background {:r 0x1d :g 0x23 :b 0x2a}
             :text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    :ui/title {:text {:color c/WHITE}}

    :ui/muted {:text {:color {:r 0xa7 :g 0xb0 :b 0xb8}}}

    :ui/accent {:text {:color {:r 0xff :g 0xcc :b 0x66}}}

    :ui/content {:background (var :content-bg)
                 :border (var :content-border-style)
                 :clip true
                 :text {:color (var :text)}}

    'ui/tab-panel {:background {:r 0 :g 0 :b 0 :a 0}
                   :layout {:direction :column}
                   :text {:color (var :text)}}

    'ui/tab-strip {:background {:r 0 :g 0 :b 0 :a 0}
                   :layout {:direction :row}}

    'ui/tab {:background (var :content-bg)
             :margin {:t 2}
             :padding [3 10]
             :border (var :raised-border-style)
             :text {:color (var :text)}}

    '(ui/tab {:selected? true})
    {:background (var :button-bg)
     :margin {:t 0}
     :padding [3 10 5 10]
     :border {:color (var :button-highlight)
              :thickness 1
              :right {:color (var :button-shadow)}
              :bottom {:color (var :button-bg)}}}

    'ui/tab:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)
     :text {:color (var :disabled-text)}}

    'ui/tab-panel-body {:width :fill
                        :height :fill
                        :background (var :content-bg)
                        :border (var :content-border-style)}

    :ui/canvas {:background (var :content-bg)
                :border (var :content-border-style)}

    :ui/desktop-icon-label-box {:padding (var :desktop-icon-label-padding)
                                :text {:color (var :text)}}

    ['(:ui/desktop-icon {:selected true}) :ui/desktop-icon-label-box]
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    [:ui/desktop-icon:focus :ui/desktop-icon-label-box]
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    :ui/list-item {:text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    :ui/list-item-hover:hover
    {:background {:r 0x33 :g 0x3b :b 0x48}}

    '(:ui/list-item {:selected true})
    {:background (var :selection-bg)}

    'ui/list-box {:background (var :content-bg)
                  :border (var :content-border-style)}

    'ui/list-box:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)}

    ['ui/list-box:disabled 'ui/scroll-pane]
    {:background (var :disabled-bg)}

    ['ui/list-box:disabled 'ui/scroll-pane-viewport]
    {:background (var :disabled-bg)}

    'ui/combo-box {:background (var :button-bg)
                   :border (var :raised-border-style)}

    'ui/combo-box:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)}

    'ui/combo-box-popup-panel {:background (var :content-bg)
                               :border (var :content-border-style)}

    'ui/checkbox {:text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    'ui/checkbox-box {:background (var :content-bg)
                      :border (var :raised-border-style)
                      :text {:color (var :button-glyph)}}

    '(ui/checkbox-box {:pressed true})
    {:border (var :pressed-border-style)}

    'ui/option-box {:text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    'ui/option-box:disabled
    {:text {:color (var :disabled-text)}}

    'ui/slider {:background (var :button-bg)
                :border (var :raised-border-style)}

    :ui/split-pane-resizer {:background (var :button-bg)
                            :border (var :raised-border-style)}

    :ui/split-pane-resizer:hover {:background (var :panel-highlight)
                                  :border {:line-style :bevel
                                           :color (var :button-highlight)
                                           :thickness 1
                                           :right {:color (var :border)}
                                           :bottom {:color (var :border)}}}

    '(:ui/split-pane-resizer {:axis :x})
    {:width (var :split-pane-resizer-size)}

    '(:ui/split-pane-resizer {:axis :y})
    {:height (var :split-pane-resizer-size)}

    '(ui/button {:pressed true})
    {:border {:line-style :solid
              :color c/TRANSPARENT
              :thickness 1
              :right {:thickness 0}
              :bottom {:thickness 0}}}

    'ui/button-inner
    {:background (var :button-bg)
     :text {:color (var :text)}
     :border (var :button-border-style)}

    'ui/button-inner:hover
    {:text {:color (var :focus-text)}
     :background (var :button-hover-bg)
     :border (var :button-hover-border-style)}

    '(ui/button-inner {:pressed true})
    {:background (var :button-pressed-bg)
     :border (var :button-pressed-border-style)}

    [:ui/toolbar-button 'ui/button-inner]
    {:background {:color TITLE-BAR-BG}
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    [:ui/toolbar-button 'ui/button-inner:hover]
    {:background {:color TITLE-BAR-BG}
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    [:ui/toolbar-button '(ui/button-inner {:pressed true})]
    {:border {:line-style :solid
              :color c/BLACK
              :thickness 1
              :right {:color TITLE-BAR-HIGHLIGHT}
              :bottom {:color TITLE-BAR-HIGHLIGHT}}}

    'ui/button-inner:disabled
    {:background (var :button-disabled-bg)
     :text {:color (var :muted-text)}
     :border (var :button-disabled-border-style)}

    [:ui/toolbar-button 'ui/button-inner:disabled]
    {:background {:color (var :disabled-bg)}
     :text {:color (var :disabled-text)}
     :border {:line-style :solid
              :color PANEL-SHADOW
              :thickness 1}}

    'ui/scrollbar {:background (var :panel-bg)
                   :text {:color (var :text)}}

    'ui/scrollbar-button {:background (var :button-bg)
                          :border (var :raised-border-style)
                          :text {:color (var :button-glyph)}}

    '(ui/scrollbar-button {:pressed true})
    {:background (var :button-bg)
     :border (var :pressed-border-style)}

    'ui/scrollbar-button:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)
     :text {:color (var :disabled-text)}}

    'ui/scrollbar-track {:background (var :panel-bg)}

    'ui/scrollbar-handle {:background (var :button-bg)
                          :border (var :raised-border-style)}

    '(ui/scrollbar-handle {:pressed true})
    {:background (var :button-bg)
     :border (var :pressed-border-style)}

    'ui/scrollbar-corner {:background (var :panel-bg)
                          :border (var :content-border-style)}

    'ui/scroll-pane {:background (var :panel-bg)}

    'ui/scroll-pane-viewport {:background (var :content-bg)}

    :window/chrome-none {:border {:thickness 0}}

    'ui/window-title-bar {:background {:r 0x34 :g 0x42 :b 0x55}
                          :border {:top {:color {:r 0x58 :g 0x84 :b 0xc8}
                                         :thickness 1}
                                   :left {:color {:r 0x58 :g 0x84 :b 0xc8}
                                          :thickness 1}}
                          :width :fill
                          :height 19
                          :max-height 19
                          :padding 0
                          :layout {:direction :row
                                   :gap :space-between}}

    ['ui/window:focus-within 'ui/window-title-bar]
    {:background {:r 0x26 :g 0x48 :b 0x8a}
     :text {:color c/WHITE}}

    'ui/window-control-button {:width 18
                               :max-width 18
                               :height 18
                               :max-height 18}

    'ui/window-minimize-button {:width 18
                                :max-width 18
                                :height 18
                                :max-height 18}

    'ui/text-input TEXT-INPUT-FRAME-STYLE

    'ui/number-input TEXT-INPUT-FRAME-STYLE

    'ui/text-input-inner {:width :fill
                          :background (var :panel-bg)
                          :padding [0 4]}

    'ui/text-input-caret {:background (var :text)}

    'ui/text-input-inner:disabled
    {:background (var :panel-bg)
     :text {:color (var :muted-text)}}


    'ui/menu-bar
    {:background (var :menu-bg)
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color (var :border)
              :top {:thickness 1}
              :bottom {:thickness 1}}}

    'ui/menu-bar-item
    {:background (var :menu-bg)
     :text {:color (var :text)
            :marked-style {:color (var :text)}}}

    'ui/menu-item {:padding [2 16]}

    'ui/menu-option-item {:padding {:t 2 :r 12 :b 2 :l 2}}

    'ui/menu-option-indicator {:box-sizing :content-box
                               :width 24
                               :height 14}

    'ui/menu-submenu-indicator {:box-sizing :content-box
                                :width 8
                                :height 10}

    '(ui/menu-submenu-indicator {:has-submenu false})
    {:visibility :none}

    'ui/popup-menu-inner
    {:background (var :menu-bg)
     :text {:color (var :text)}
     :border {:thickness 1
              :line-style :solid
              :color (var :border)}}

    :menu/item
    {:padding [2 16]
     :text {:color c/WHITE}}

    '(ui/popup-menu-option-item :menu/item)
    {:padding {:t 2 :r 12 :b 2 :l 2}
     :text {:color c/WHITE}}

    '(ui/popup-menu-item :menu/item)
    {:padding {:t 2 :r 12 :b 2 :l 2}}

    :menu/trailing-column
    {:margin {:l 16}}

    :menu/item:disabled
    {:background (var :menu-bg)
     :text {:color (var :disabled-text)
            :marked-style {:color (var :disabled-text)}}}

    :ui/list-item:disabled
    {:background (var :disabled-bg)
     :text {:color (var :disabled-text)}}

    'ui/combo-box-trigger:disabled
    {:background (var :disabled-bg)
     :text {:color (var :disabled-text)}}

    'ui/header-panel
    {:border {:color c/BLACK
              :thickness 1}}

    'ui/header-panel-header
    {:background {:color TITLE-BAR-BG}
     :padding 4
     :text {:color c/WHITE}
     :border {:color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    ['ui/header-panel:disabled 'ui/header-panel-header]
    {:background {:color (var :disabled-bg)}
     :text {:color (var :disabled-text)}
     :border {:color PANEL-HIGHLIGHT
              :thickness 1
              :right {:color PANEL-SHADOW}
              :bottom {:color PANEL-SHADOW}}}

    ['ui/header-panel:disabled 'ui/header-panel-header :ui/title]
    {:text {:color (var :disabled-text)}}

    'ui/header-panel-body
    {:border {:color PANEL-SHADOW
              :thickness 1
              :left {:color PANEL-HIGHLIGHT}}}}})
