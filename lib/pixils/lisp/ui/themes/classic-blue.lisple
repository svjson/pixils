(ns pixils.ui.theme.classic-blue
  (:require pixils
            [pixils.color :as c]))

(def BUTTON-BG {:r 0x3d :g 0x4a :b 0x5e})
(def BUTTON-HIGHLIGHT {:r 0x67 :g 0x78 :b 0x8f})
(def BUTTON-SHADOW {:r 0x2d :g 0x36 :b 0x46})
(def BUTTON-GLYPH {:r 0xf5 :g 0xf6 :b 0xf3})
(def DISABLED-BG {:r 0x25 :g 0x2d :b 0x38})
(def DISABLED-BORDER {:r 0x43 :g 0x4d :b 0x5a})
(def DISABLED-TEXT {:r 0x72 :g 0x7c :b 0x88})

(def TITLE-BAR-BG {:r 0x29 :g 0x3e :b 0x5c})
(def TITLE-BAR-HIGHLIGHT {:r 0x7c :g 0x8d :b 0xa8})
(def TITLE-BAR-SHADOW {:r 0x56 :g 0x6d :b 0x87})

(def PANEL-BG {:r 0x20 :g 0x29 :b 0x36})
(def PANEL-HIGHLIGHT {:r 0x67 :g 0x78 :b 0x8f})
(def PANEL-SHADOW {:r 0x2d :g 0x36 :b 0x46})

(def CONTENT-BG {:r 0x2d :g 0x39 :b 0x48})
(def CONTENT-BORDER {:r 0x5f :g 0x6f :b 0x7f})

(deffont classic-blue-font
  {:type :ttf
   :resource :pixils/autoega-8x14
   :size 14
   :spacing 0
   :line-height 14})

(deftheme pixils/classic-blue
  {:vars {:dark {:menu-bg CONTENT-BG
                 :content-bg CONTENT-BG
                 :panel-bg PANEL-BG
                 :panel-highlight PANEL-HIGHLIGHT
                 :panel-shadow PANEL-SHADOW
                 :button-bg BUTTON-BG
                 :button-highlight BUTTON-HIGHLIGHT
                 :button-shadow BUTTON-SHADOW
                 :border c/BLACK
                 :text c/WHITE
                 :focus-text BUTTON-HIGHLIGHT
                 :split-pane-resizer-size 8}}
   :default-variant :dark
   :defaults {:text {:font :font/classic-blue-font}}
   :styles
   {:ui/panel {:background PANEL-BG
               :padding 4}

    :ui/app {:background {:r 0x1d :g 0x23 :b 0x2a}
             :text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    :ui/title {:text {:color c/WHITE}}

    :ui/muted {:text {:color {:r 0xa7 :g 0xb0 :b 0xb8}}}

    :ui/accent {:text {:color {:r 0xff :g 0xcc :b 0x66}}}

    :ui/content {:background CONTENT-BG
                 :border {:color CONTENT-BORDER
                          :thickness 1}
                 :clip true
                 :text {:color (var :text)}}

    'ui/tab-panel {:background PANEL-BG
                   :layout {:direction :column}
                   :text {:color (var :text)}}

    'ui/tab-strip {:background PANEL-BG
                   :layout {:direction :row}}

    'ui/tab {:background BUTTON-BG
             :padding [3 10]
             :border {:color BUTTON-HIGHLIGHT
                      :thickness 1
                      :right {:color BUTTON-SHADOW}
                      :bottom {:color BUTTON-SHADOW}}
             :text {:color (var :text)}}

    '(ui/tab {:selected? true})
    {:background CONTENT-BG
     :border {:color CONTENT-BORDER
              :thickness 1
              :bottom {:color CONTENT-BG}}}

    'ui/tab:disabled
    {:background DISABLED-BG
     :border {:color DISABLED-BORDER
              :thickness 1
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}
     :text {:color DISABLED-TEXT}}

    'ui/tab-panel-body {:width :fill
                        :height :fill
                        :background CONTENT-BG
                        :border {:color CONTENT-BORDER
                                 :thickness 1}}

    :ui/canvas {:background CONTENT-BG
                :border {:color CONTENT-BORDER
                         :thickness 1}}

    :ui/list-item {:text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    :ui/list-item-hover:hover
    {:background {:r 0x33 :g 0x3b :b 0x48}}

    '(:ui/list-item {:selected true})
    {:background {:r 0x4a :g 0x3f :b 0x24}}

    'ui/list-box {:background CONTENT-BG
                  :border {:color CONTENT-BORDER
                           :thickness 1}}

    'ui/list-box:disabled
    {:background DISABLED-BG
     :border {:color DISABLED-BORDER
              :thickness 1
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}}

    ['ui/list-box:disabled 'ui/scroll-pane]
    {:background DISABLED-BG}

    ['ui/list-box:disabled 'ui/scroll-pane-viewport]
    {:background DISABLED-BG}

    'ui/combo-box {:background BUTTON-BG
                   :border {:color BUTTON-HIGHLIGHT
                            :thickness 1
                            :right {:color BUTTON-SHADOW}
                            :bottom {:color BUTTON-SHADOW}}}

    'ui/combo-box:disabled
    {:background DISABLED-BG
     :border {:color DISABLED-BORDER
              :thickness 1
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}}

    'ui/combo-box-popup-panel {:background CONTENT-BG
                               :border {:color CONTENT-BORDER
                                        :thickness 1}}

    'ui/checkbox {:text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    'ui/checkbox-box {:background CONTENT-BG
                      :border {:color BUTTON-HIGHLIGHT
                               :thickness 1
                               :right {:color BUTTON-SHADOW}
                               :bottom {:color BUTTON-SHADOW}}
                      :text {:color BUTTON-GLYPH}}

    '(ui/checkbox-box {:pressed true})
    {:border {:color BUTTON-SHADOW
              :thickness 1
              :right {:color BUTTON-HIGHLIGHT}
              :bottom {:color BUTTON-HIGHLIGHT}}}

    'ui/slider {:background BUTTON-BG
                :border {:color BUTTON-HIGHLIGHT
                         :thickness 1
                         :right {:color BUTTON-SHADOW}
                         :bottom {:color BUTTON-SHADOW}}}

    :ui/split-pane-resizer {:background (var :button-bg)
                            :border {:line-style :bevel
                                     :color (var :button-highlight)
                                     :thickness 1
                                     :right {:color (var :button-shadow)}
                                     :bottom {:color (var :button-shadow)}}}

    :ui/split-pane-resizer:hover {:background (var :panel-highlight)
                                  :border {:line-style :bevel
                                           :color (var :button-highlight)
                                           :thickness 1
                                           :right {:color (var :border)}
                                           :bottom {:color (var :border)}}}

    '(:ui/split-pane-resizer {:axis :x})
    {:width (var :split-pane-resizer-size)}

    '(:ui/split-pane-resizer {:axis :y})
    {:height (var :split-pane-resizer-size)}

    '(ui/button {:pressed true})
    {:border {:line-style :solid
              :color c/TRANSPARENT
              :thickness 1
              :right {:thickness 0}
              :bottom {:thickness 0}}}

    'ui/button-inner
    {:background BUTTON-BG
     :text {:color (var :text)}
     :border {:line-style :bevel
              :width :fill
              :color BUTTON-HIGHLIGHT
              :thickness 2
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}}

    'ui/button-inner:hover
    {:text {:color (var :focus-text)}
     :background BUTTON-BG
     :border {:line-style :bevel
              :width :fill
              :color BUTTON-HIGHLIGHT
              :thickness 2
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}}

    '(ui/button-inner {:pressed true})
    {:border {:line-style :bevel
              :color (var :button-shadow)
              :thickness 2
              :right {:color (var :button-highlight) :thickness 1}
              :bottom {:color (var :button-highlight) :thickness 1}}}

    [:ui/toolbar-button 'ui/button-inner]
    {:background {:color TITLE-BAR-BG}
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    [:ui/toolbar-button 'ui/button-inner:hover]
    {:background {:color TITLE-BAR-BG}
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    [:ui/toolbar-button '(ui/button-inner {:pressed true})]
    {:border {:line-style :solid
              :color c/BLACK
              :thickness 1
              :right {:color TITLE-BAR-HIGHLIGHT}
              :bottom {:color TITLE-BAR-HIGHLIGHT}}}

    'ui/button-inner:disabled
    {:background (var :panel-bg)
     :text {:color {:r 0xa7 :g 0xb0 :b 0xb8}}
     :border {:line-style :solid
              :color (var :panel-shadow)
              :thickness 1}}

    [:ui/toolbar-button 'ui/button-inner:disabled]
    {:background {:color DISABLED-BG}
     :text {:color DISABLED-TEXT}
     :border {:line-style :solid
              :color PANEL-SHADOW
              :thickness 1}}

    'ui/scrollbar {:background {:r 0x20 :g 0x29 :b 0x36}
                   :text {:color {:r 0xe6 :g 0xea :b 0xee}}}

    'ui/scrollbar-button {:background BUTTON-BG
                          :border {:color BUTTON-HIGHLIGHT
                                   :thickness 1
                                   :right {:color BUTTON-SHADOW}
                                   :bottom {:color BUTTON-SHADOW}}
                          :text {:color BUTTON-GLYPH}}

    '(ui/scrollbar-button {:pressed true})
    {:background BUTTON-BG
     :border {:color BUTTON-SHADOW
              :thickness 1
              :right {:color BUTTON-HIGHLIGHT}
              :bottom {:color BUTTON-HIGHLIGHT}}}

    'ui/scrollbar-button:disabled
    {:background DISABLED-BG
     :border {:color DISABLED-BORDER
              :thickness 1
              :right {:color BUTTON-SHADOW}
              :bottom {:color BUTTON-SHADOW}}
     :text {:color DISABLED-TEXT}}

    'ui/scrollbar-track {:background PANEL-BG}

    'ui/scrollbar-handle {:background BUTTON-BG
                          :border {:color BUTTON-HIGHLIGHT
                                   :thickness 1
                                   :right {:color BUTTON-SHADOW}
                                   :bottom {:color BUTTON-SHADOW}}}

    '(ui/scrollbar-handle {:pressed true})
    {:background BUTTON-BG
     :border {:color BUTTON-SHADOW
              :thickness 1
              :right {:color BUTTON-HIGHLIGHT}
              :bottom {:color BUTTON-HIGHLIGHT}}}

    'ui/scrollbar-corner {:background {:r 0x20 :g 0x29 :b 0x36}
                          :border {:color {:r 0x5f :g 0x6f :b 0x7f}
                                   :thickness 1}}

    'ui/scroll-pane {:background {:r 0x20 :g 0x29 :b 0x36}}

    'ui/scroll-pane-viewport {:background CONTENT-BG}

    'ui/window-title-bar {:background {:r 0x34 :g 0x42 :b 0x55}
                          :border {:top {:color {:r 0x58 :g 0x84 :b 0xc8}
                                         :thickness 1}
                                   :left {:color {:r 0x58 :g 0x84 :b 0xc8}
                                          :thickness 1}}
                          :width :fill
                          :height 19
                          :padding 0
                          :layout {:direction :row
                                   :gap :space-between}}

    ['ui/window:focus-within 'ui/window-title-bar]
    {:background {:r 0x26 :g 0x48 :b 0x8a}
     :text {:color c/WHITE}}

    'ui/window-control-button {:width 18
                               :height 18}

    'ui/window-minimize-button {:width 18
                                :height 18}

    'ui/text-input {:width 80
                    :background (var :content-bg)
                    :border {:color (var :panel-shadow)
                             :thickness 1
                             :right {:color (var :panel-highlight)}
                             :bottom {:color (var :panel-highlight)}}
                    :text {:color (var :text)}}

    'ui/text-input-inner {:width :fill
                          :background (var :panel-bg)
                          :padding [0 4]}

    'ui/text-input-caret {:background (var :text)}

    'ui/text-input-inner:disabled
    {:background (var :panel-bg)
     :text {:color {:r 0xa7 :g 0xb0 :b 0xb8}}}


    'ui/menu-bar
    {:background (var :menu-bg)
     :text {:color c/WHITE}
     :border {:line-style :solid
              :color (var :border)
              :top {:thickness 1}
              :bottom {:thickness 1}}}

    'ui/menu-bar-item
    {:background (var :menu-bg)
     :text {:color (var :text)
            :marked-style {:color (var :text)}}}

    'ui/menu-item {:padding [2 16]}

    'ui/menu-option-item {:padding {:t 2 :r 12 :b 2 :l 2}}

    'ui/menu-option-indicator {:margin {:l 2 :r 4}
                               :box-sizing :content-box
                               :width 8
                               :height 10}

    'ui/popup-menu-inner
    {:background (var :menu-bg)
     :text {:color (var :text)}
     :border {:thickness 1
              :line-style :solid
              :color (var :border)}}

    :menu/item
    {:padding [2 16]
     :text {:color c/WHITE}}

    'ui/popup-menu-option-item
    {:padding [2 2]
     :text {:color c/WHITE}}

    :menu/item:disabled
    {:background (var :menu-bg)
     :text {:color DISABLED-TEXT
            :marked-style {:color DISABLED-TEXT}}}

    :ui/list-item:disabled
    {:background DISABLED-BG
     :text {:color DISABLED-TEXT}}

    'ui/combo-box-trigger:disabled
    {:background DISABLED-BG
     :text {:color DISABLED-TEXT}}

    'ui/header-panel
    {:border {:color c/BLACK
              :thickness 1}}

    'ui/header-panel-header
    {:background {:color TITLE-BAR-BG}
     :padding 4
     :text {:color c/WHITE}
     :border {:color TITLE-BAR-HIGHLIGHT
              :thickness 1
              :right {:color TITLE-BAR-SHADOW}
              :bottom {:color c/BLACK}}}

    ['ui/header-panel:disabled 'ui/header-panel-header]
    {:background {:color DISABLED-BG}
     :text {:color DISABLED-TEXT}
     :border {:color PANEL-HIGHLIGHT
              :thickness 1
              :right {:color PANEL-SHADOW}
              :bottom {:color PANEL-SHADOW}}}

    ['ui/header-panel:disabled 'ui/header-panel-header :ui/title]
    {:text {:color DISABLED-TEXT}}

    'ui/header-panel-body
    {:border {:color PANEL-SHADOW
              :thickness 1
              :left {:color PANEL-HIGHLIGHT}}}}})
