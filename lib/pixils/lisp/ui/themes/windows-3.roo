(ns pixils.ui.theme.windows-3
  (:require pixils
            [pixils.color :as c]
            [pixils.point :as pt]
            [pixils.render :as r]
            [pixils.ui.theme-assets :as theme-assets]))

(def theme-bundle :windows-3-theme)
(def menu-option-checkmark :windows-3-theme/menu-option-checkmark)
(def chevron-up :windows-3-theme/chevron-up)
(def chevron-down :windows-3-theme/chevron-down)
(def chevron-left :windows-3-theme/chevron-left)
(def chevron-right :windows-3-theme/chevron-right)
(def scrollbar-arrow-up :windows-3-theme/scrollbar-arrow-up)
(def scrollbar-arrow-down :windows-3-theme/scrollbar-arrow-down)
(def scrollbar-arrow-left :windows-3-theme/scrollbar-arrow-left)
(def scrollbar-arrow-right :windows-3-theme/scrollbar-arrow-right)
(def scrollbar-arrow-up-dark :windows-3-theme/scrollbar-arrow-up-dark)
(def scrollbar-arrow-down-dark :windows-3-theme/scrollbar-arrow-down-dark)
(def scrollbar-arrow-left-dark :windows-3-theme/scrollbar-arrow-left-dark)
(def scrollbar-arrow-right-dark :windows-3-theme/scrollbar-arrow-right-dark)
(def submenu-chevron-highlighted :windows-3-theme/submenu-chevron-highlighted)
(def dark-symbol-color {:r 0xdc :g 0xe0 :b 0xe4})

(defun draw-menu-option-checkmark! []
  (r/line! {:x 7 :y 0} {:x 7 :y 1} c/BLACK)
  (r/line! {:x 6 :y 2} {:x 7 :y 2} c/BLACK)
  (r/line! {:x 6 :y 3} {:x 6 :y 3} c/BLACK)
  (r/line! {:x 5 :y 4} {:x 6 :y 4} c/BLACK)
  (r/line! {:x 0 :y 5} {:x 1 :y 5} c/BLACK)
  (r/line! {:x 5 :y 5} {:x 5 :y 5} c/BLACK)
  (r/line! {:x 1 :y 6} {:x 2 :y 6} c/BLACK)
  (r/line! {:x 4 :y 6} {:x 5 :y 6} c/BLACK)
  (r/line! {:x 2 :y 7} {:x 2 :y 7} c/BLACK)
  (r/line! {:x 4 :y 7} {:x 4 :y 7} c/BLACK)
  (r/line! {:x 2 :y 8} {:x 4 :y 8} c/BLACK)
  (r/line! {:x 3 :y 9} {:x 3 :y 9} c/BLACK))

(defun draw-filled-chevron-with-color! [direction color]
  (case direction
    :up (do
          (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
          (r/line! {:x 2 :y 1} {:x 4 :y 1} color)
          (r/line! {:x 1 :y 2} {:x 5 :y 2} color)
          (r/line! {:x 0 :y 3} {:x 6 :y 3} color))
    :down (do
            (r/line! {:x 0 :y 0} {:x 6 :y 0} color)
            (r/line! {:x 1 :y 1} {:x 5 :y 1} color)
            (r/line! {:x 2 :y 2} {:x 4 :y 2} color)
            (r/line! {:x 3 :y 3} {:x 3 :y 3} color))
    :left (do
            (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
            (r/line! {:x 2 :y 1} {:x 3 :y 1} color)
            (r/line! {:x 1 :y 2} {:x 3 :y 2} color)
            (r/line! {:x 0 :y 3} {:x 3 :y 3} color)
            (r/line! {:x 1 :y 4} {:x 3 :y 4} color)
            (r/line! {:x 2 :y 5} {:x 3 :y 5} color)
            (r/line! {:x 3 :y 6} {:x 3 :y 6} color))
    :right (do
             (r/line! {:x 0 :y 0} {:x 0 :y 0} color)
             (r/line! {:x 0 :y 1} {:x 1 :y 1} color)
             (r/line! {:x 0 :y 2} {:x 2 :y 2} color)
             (r/line! {:x 0 :y 3} {:x 3 :y 3} color)
             (r/line! {:x 0 :y 4} {:x 2 :y 4} color)
             (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
             (r/line! {:x 0 :y 6} {:x 0 :y 6} color))
    :default nil))

(defun draw-submenu-chevron-with-color! [color]
  (draw-filled-chevron-with-color! :right color))

(defun draw-submenu-chevron-highlighted! []
  (draw-submenu-chevron-with-color! c/WHITE))

(defun draw-chevron-up! []
  (draw-filled-chevron-with-color! :up c/BLACK))

(defun draw-chevron-down! []
  (draw-filled-chevron-with-color! :down c/BLACK))

(defun draw-chevron-left! []
  (draw-filled-chevron-with-color! :left c/BLACK))

(defun draw-chevron-right! []
  (draw-filled-chevron-with-color! :right c/BLACK))

(defun offset-x [point dx]
  {:x (+ (:x point) dx)
   :y (:y point)})

(defun draw-offset-line! [from to color dx]
  (r/line! (offset-x from dx) (offset-x to dx) color))

(defun draw-full-arrow-pass-with-color! [direction color dx]
  (case direction
    :up (do
          (draw-offset-line! {:x 3 :y 0} {:x 3 :y 0} color dx)
          (draw-offset-line! {:x 2 :y 1} {:x 4 :y 1} color dx)
          (draw-offset-line! {:x 1 :y 2} {:x 5 :y 2} color dx)
          (draw-offset-line! {:x 0 :y 3} {:x 6 :y 3} color dx)
          (draw-offset-line! {:x 2 :y 4} {:x 4 :y 4} color dx)
          (draw-offset-line! {:x 2 :y 5} {:x 4 :y 5} color dx)
          (draw-offset-line! {:x 2 :y 6} {:x 4 :y 6} color dx))
    :down (do
            (draw-offset-line! {:x 2 :y 0} {:x 4 :y 0} color dx)
            (draw-offset-line! {:x 2 :y 1} {:x 4 :y 1} color dx)
            (draw-offset-line! {:x 2 :y 2} {:x 4 :y 2} color dx)
            (draw-offset-line! {:x 0 :y 3} {:x 6 :y 3} color dx)
            (draw-offset-line! {:x 1 :y 4} {:x 5 :y 4} color dx)
            (draw-offset-line! {:x 2 :y 5} {:x 4 :y 5} color dx)
            (draw-offset-line! {:x 3 :y 6} {:x 3 :y 6} color dx))
    :left (do
            (draw-offset-line! {:x 3 :y 0} {:x 3 :y 0} color dx)
            (draw-offset-line! {:x 2 :y 1} {:x 3 :y 1} color dx)
            (draw-offset-line! {:x 1 :y 2} {:x 6 :y 2} color dx)
            (draw-offset-line! {:x 0 :y 3} {:x 6 :y 3} color dx)
            (draw-offset-line! {:x 1 :y 4} {:x 6 :y 4} color dx)
            (draw-offset-line! {:x 2 :y 5} {:x 3 :y 5} color dx)
            (draw-offset-line! {:x 3 :y 6} {:x 3 :y 6} color dx))
    :right (do
             (draw-offset-line! {:x 3 :y 0} {:x 3 :y 0} color dx)
             (draw-offset-line! {:x 3 :y 1} {:x 4 :y 1} color dx)
             (draw-offset-line! {:x 0 :y 2} {:x 5 :y 2} color dx)
             (draw-offset-line! {:x 0 :y 3} {:x 6 :y 3} color dx)
             (draw-offset-line! {:x 0 :y 4} {:x 5 :y 4} color dx)
             (draw-offset-line! {:x 3 :y 5} {:x 4 :y 5} color dx)
             (draw-offset-line! {:x 3 :y 6} {:x 3 :y 6} color dx))
    :default nil))

(defun draw-full-arrow-with-color! [direction color]
  (draw-full-arrow-pass-with-color! direction color 0))

(defun draw-thick-full-arrow-with-color! [direction color]
  (do
    (draw-full-arrow-pass-with-color! direction color 0)
    (draw-full-arrow-pass-with-color! direction color 1)))

(defun draw-scrollbar-arrow-up! []
  (draw-thick-full-arrow-with-color! :up c/BLACK))

(defun draw-scrollbar-arrow-down! []
  (draw-thick-full-arrow-with-color! :down c/BLACK))

(defun draw-scrollbar-arrow-left! []
  (draw-thick-full-arrow-with-color! :left c/BLACK))

(defun draw-scrollbar-arrow-right! []
  (draw-thick-full-arrow-with-color! :right c/BLACK))

(defun draw-scrollbar-arrow-up-dark! []
  (draw-thick-full-arrow-with-color! :up dark-symbol-color))

(defun draw-scrollbar-arrow-down-dark! []
  (draw-thick-full-arrow-with-color! :down dark-symbol-color))

(defun draw-scrollbar-arrow-left-dark! []
  (draw-thick-full-arrow-with-color! :left dark-symbol-color))

(defun draw-scrollbar-arrow-right-dark! []
  (draw-thick-full-arrow-with-color! :right dark-symbol-color))

(defun ensure-windows-3-theme-assets! []
  (theme-assets/ensure-generated-image! theme-bundle
                                        menu-option-checkmark
                                        {:size {:w 8 :h 10}}
                                        draw-menu-option-checkmark!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        chevron-up
                                        {:size {:w 7 :h 4}}
                                        draw-chevron-up!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        chevron-down
                                        {:size {:w 7 :h 4}}
                                        draw-chevron-down!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        chevron-left
                                        {:size {:w 4 :h 7}}
                                        draw-chevron-left!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        chevron-right
                                        {:size {:w 4 :h 7}}
                                        draw-chevron-right!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        submenu-chevron-highlighted
                                        {:size {:w 4 :h 7}}
                                        draw-submenu-chevron-highlighted!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-up
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-up!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-down
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-down!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-left
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-left!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-right
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-right!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-up-dark
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-up-dark!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-down-dark
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-down-dark!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-left-dark
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-left-dark!)
  (theme-assets/ensure-generated-image! theme-bundle
                                        scrollbar-arrow-right-dark
                                        {:size {:w 7 :h 7}}
                                        draw-scrollbar-arrow-right-dark!))

(ensure-windows-3-theme-assets!)

(def TEXT-INPUT-FRAME-STYLE
  {:width 80
   :border (var :solid-border-style)})



;; Win 3.11 Sans Serif System Font

(deffont win3-system-font
  {:type :bitmap
   :spacing 1
   :resource :pixils/win311-system-font
   :baseline 9
   :styles {:underline {:offset 2
                        :thickness 1}}
   :glyphs {' ' {:x 235 :y 0 :w 4 :h 10}
            '.' {:x 0 :y 25 :w 2 :h 10}
            ',' {:x 3 :y 25 :w 3 :h 13}
            '\'' {:x 27 :y 25 :w 2 :h 10}
            '"' {:x 31 :y 25 :w 5 :h 10}
            '?' {:x 37 :y 25 :w 6 :h 10}
            '!' {:x 44 :y 25 :w 2 :h 10}
            '@' {:x 47 :y 24 :w 12 :h 13}
            '*' {:x 69 :y 25 :w 6 :h 10}
            '&' {:x 104 :y 25 :w 7 :h 10}
            '(' {:x 112 :y 25 :w 3 :h 13}
            ')' {:x 116 :y 25 :w 3 :h 13}
            '+' {:x 120 :y 25 :w 6 :h 10}
            '-' {:x 127 :y 25 :w 4 :h 10}
            '/' {:x 132 :y 25 :w 4 :h 12}
            ':' {:x 137 :y 25 :w 2 :h 10}
            '<' {:x 144 :y 25 :w 6 :h 10}
            '=' {:x 151 :y 25 :w 6 :h 10}
            '>' {:x 158 :y 25 :w 6 :h 10}
            '{' {:x 189 :y 25 :w 4 :h 13}
            '}' {:x 197 :y 25 :w 4 :h 13}
            '0' {:x 179 :y 11 :w 6 :h 10}
            '1' {:x 186 :y 11 :w 4 :h 10}
            '2' {:x 191 :y 11 :w 6 :h 10}
            '3' {:x 198 :y 11 :w 6 :h 10}
            '4' {:x 205 :y 11 :w 6 :h 10}
            '5' {:x 212 :y 11 :w 6 :h 10}
            '6' {:x 219 :y 11 :w 6 :h 10}
            '7' {:x 226 :y 11 :w 6 :h 10}
            '8' {:x 233 :y 11 :w 6 :h 10}
            '9' {:x 240 :y 11 :w 6 :h 10}
            'A' {:x 0 :y 0 :w 8 :h 10}
            'B' {:x 9 :y 0 :w 8 :h 10}
            'C' {:x 18 :y 0 :w 7 :h 10}
            'D' {:x 26 :y 0 :w 8 :h 10}
            'E' {:x 35 :y 0 :w 7 :h 10}
            'F' {:x 43 :y 0 :w 7 :h 10}
            'G' {:x 51 :y 0 :w 8 :h 10}
            'H' {:x 60 :y 0 :w 8 :h 10}
            'I' {:x 69 :y 0 :w 2 :h 10}
            'J' {:x 72 :y 0 :w 6 :h 10}
            'K' {:x 79 :y 0 :w 8 :h 10}
            'L' {:x 88 :y 0 :w 8 :h 10}
            'M' {:x 97 :y 0 :w 10 :h 10}
            'N' {:x 108 :y 0 :w 8 :h 10}
            'O' {:x 117 :y 0 :w 8 :h 10}
            'P' {:x 126 :y 0 :w 8 :h 10}
            'Q' {:x 135 :y 0 :w 8 :h 10}
            'R' {:x 144 :y 0 :w 9 :h 10}
            'S' {:x 154 :y 0 :w 7 :h 10}
            'T' {:x 162 :y 0 :w 8 :h 10}
            'U' {:x 171 :y 0 :w 8 :h 10}
            'V' {:x 180 :y 0 :w 8 :h 10}
            'W' {:x 189 :y 0 :w 14 :h 10}
            'X' {:x 204 :y 0 :w 9 :h 10}
            'Y' {:x 214 :y 0 :w 10 :h 10}
            'Z' {:x 225 :y 0 :w 9 :h 10}
            'a' {:x 0 :y 11 :w 6 :h 10}
            'b' {:x 7 :y 11 :w 6 :h 10}
            'c' {:x 14 :y 11 :w 6 :h 10}
            'd' {:x 21 :y 11 :w 6 :h 10}
            'e' {:x 28 :y 11 :w 6 :h 10}
            'f' {:x 35 :y 11 :w 4 :h 10}
            'g' {:x 40 :y 11 :w 6 :h 13}
            'h' {:x 47 :y 11 :w 6 :h 10}
            'i' {:x 54 :y 11 :w 2 :h 10}
            'j' {:x 57 :y 11 :w 3 :h 13}
            'k' {:x 61 :y 11 :w 6 :h 10}
            'l' {:x 68 :y 11 :w 2 :h 10}
            'm' {:x 71 :y 11 :w 10 :h 10}
            'n' {:x 82 :y 11 :w 6 :h 10}
            'o' {:x 89 :y 11 :w 6 :h 10}
            'p' {:x 96 :y 11 :w 6 :h 13}
            'q' {:x 103 :y 11 :w 6 :h 13}
            'r' {:x 110 :y 11 :w 4 :h 10}
            's' {:x 115 :y 11 :w 6 :h 10}
            't' {:x 122 :y 11 :w 4 :h 10}
            'u' {:x 127 :y 11 :w 6 :h 10}
            'v' {:x 134 :y 11 :w 8 :h 10}
            'w' {:x 143 :y 11 :w 10 :h 10}
            'x' {:x 154 :y 11 :w 8 :h 10}
            'y' {:x 163 :y 11 :w 8 :h 13}
            'z' {:x 172 :y 11 :w 6 :h 10}}})



;; Windows 3.11 colors

(def white {:r 255 :g 255 :b 255})
(def FOCUS-BLUE {:r 0x00 :g 0x0b :b 0xc8})
(def teal {:r 0x00 :g 0x80 :b 0x80})
(def cyan {:r 0x00 :g 0xff :b 0xff})
(def panel-face {:r 0xc0 :g 0xc7 :b 0xc8})
(def panel-shadow {:r 0x87 :g 0x88 :b 0x8f})


;; Win 3.11 UI drawing routines

(defun draw-bevel! [rect {:keys [thickness invert]}]
  (let [thickness (or thickness 1)
        tl-color (if invert panel-shadow white)
        br-color (if invert white panel-shadow)]
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (:x rect) :y (:y rect)} {:x 0 :y n})
               {:x (+ (:x rect) (- (:w rect) (+ 1 n))) :y (+ (:y rect) n)}
               tl-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (:x rect) :y (:y rect)} {:x n :y 0})
               {:x (+ (:x rect) n) :y (+ (:y rect) (- (:h rect) (+ 1 n)))}
               tl-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (+ 1 (:x rect) (- thickness n)) :y (- (+ (:y rect) (:h rect)) thickness)} {:x 0 :y n})
               {:x (- (+ (:x rect) (:w rect)) 1) :y (- (+ n (:y rect) (:h rect)) thickness)}
               br-color))
    (dotimes [n thickness]
      (r/line! (pt/+ {:x (- (+ (:x rect) (:w rect)) thickness) :y (+ 1 (:y rect) (- thickness n))}
                     {:x n :y 0})
               {:x (- (+ n (:x rect) (:w rect)) thickness) :y (- (+ (:y rect) (:h rect)) thickness)}
               br-color))))



(deftheme pixils/windows-3
  {:default-variant :light
   :vars {:light {:desktop-bg teal
                  :panel-bg panel-face
                  :panel-highlight c/WHITE
                  :panel-shadow panel-shadow
                  :text c/BLACK
                  :muted-text panel-shadow
                  :accent FOCUS-BLUE
                  :focus-bg FOCUS-BLUE
                  :focus-text c/WHITE
                  :content-bg c/WHITE
                  :content-text c/BLACK
                  :surface (var :content-bg)
                  :field-bg c/WHITE
                  :field-text c/BLACK
                  :button-bg (var :panel-bg)
                  :button-hover-bg (var :button-bg)
                  :button-pressed-bg (var :button-bg)
                  :button-disabled-bg (var :button-bg)
                  :menu-bg white
                  :border c/BLACK
                  :control-border (var :border)
                  :highlight c/WHITE
                  :highlight-color (var :highlight)
                  :border-light (var :highlight)
                  :border-dark (var :panel-shadow)
                  :border-inset-top-left (var :border-dark)
                  :border-inset-bottom-right (var :border-light)
                  :border-raised-top-left (var :border-light)
                  :border-raised-bottom-right (var :border-dark)
                  :selection-bg (var :focus-bg)
                  :selection-text (var :focus-text)
                  :desktop-icon-label-padding 2
                  :button-pressed-image-offset {:x 1 :y 1}
                  :solid-border-style {:line-style :solid
                                       :color (var :border)
                                       :thickness 1}
                  :control-border-style {:line-style :solid
                                         :color (var :control-border)
                                         :thickness 1}
                  :button-outline-border-style {:line-style :solid
                                                :color (var :control-border)
                                                :thickness 1
                                                :trim 1}
                  :dialog-frame-border-style {:line-style :solid
                                              :color (var :focus-bg)
                                              :thickness 2}
                  :raised-border-style {:line-style :bevel
                                        :color (var :highlight)
                                        :thickness 2
                                        :right {:color (var :panel-shadow)}
                                        :bottom {:color (var :panel-shadow)}}
                  :pressed-border-style {:line-style :bevel
                                         :color (var :panel-shadow)
                                         :thickness 2
                                         :right {:color (var :highlight)}
                                         :bottom {:color (var :highlight)}}
                  :button-pressed-border-style {:line-style :bevel
                                               :color (var :panel-shadow)
                                               :thickness 0
                                               :top {:thickness 1}
                                               :left {:thickness 1}}
                  :button-border-style (var :raised-border-style)
                  :button-hover-border-style (var :button-border-style)
                  :button-disabled-border-style (var :button-border-style)
                  :scrollbar-button-border-style {:line-style :bevel
                                                  :color (var :highlight)
                                                  :thickness 0
                                                  :top {:thickness 1}
                                                  :left {:thickness 1}
                                                  :right {:color (var :panel-shadow)
                                                          :thickness 2}
                                                  :bottom {:color (var :panel-shadow)
                                                           :thickness 2}}
                  :scrollbar-button-pressed-border-style {:line-style :bevel
                                                          :color (var :panel-shadow)
                                                          :thickness 0
                                                          :top {:thickness 1}
                                                          :left {:thickness 1}
                                                          :right {:color (var :highlight)
                                                                  :thickness 2}
                                                          :bottom {:color (var :highlight)
                                                                   :thickness 2}}
                  :split-pane-resizer-size 8
                  :scrollbar-size 17
                  :scrollbar-handle-size 15
                  :option-box-indicator {:color {:r 0x00 :g 0x00 :b 0x00}
                                         :radius 5
                                         :inner-radius 2
                                         :pressed-thickness 2}
                  :menu-option-indicator {:selected-symbol :checkmark}
                  :menu-submenu-indicator {:image :windows-3-theme/chevron-right
                                           :highlighted-image :windows-3-theme/submenu-chevron-highlighted}
                  :scrollbar-button-symbols {:up-image :windows-3-theme/scrollbar-arrow-up
                                             :down-image :windows-3-theme/scrollbar-arrow-down
                                             :left-image :windows-3-theme/scrollbar-arrow-left
                                             :right-image :windows-3-theme/scrollbar-arrow-right}}
          :dark {:desktop-bg {:r 0x18 :g 0x28 :b 0x2a}
                 :panel-bg {:r 0x32 :g 0x35 :b 0x38}
                 :panel-shadow {:r 0x1b :g 0x1d :b 0x20}
                 :text {:r 0xdc :g 0xe0 :b 0xe4}
                 :muted-text {:r 0x9a :g 0xa0 :b 0xa6}
                 :accent {:r 0x6f :g 0xa8 :b 0xff}
                 :focus-bg {:r 0x18 :g 0x4f :b 0x9d}
                 :focus-text c/WHITE
                 :content-bg {:r 0x14 :g 0x16 :b 0x18}
                 :content-text {:r 0xdc :g 0xe0 :b 0xe4}
                 :field-bg {:r 0x14 :g 0x16 :b 0x18}
                 :field-text {:r 0xdc :g 0xe0 :b 0xe4}
                 :menu-bg {:r 0x24 :g 0x27 :b 0x2a}
                 :border {:r 0x69 :g 0x70 :b 0x76}
                 :control-border c/BLACK
                 :highlight {:r 0x69 :g 0x70 :b 0x76}
                 :highlight-color (var :highlight)
                 :split-pane-resizer-size 8
                 :scrollbar-size 17
                 :scrollbar-handle-size 15
                 :option-box-indicator {:color (var :text)
                                        :radius 5
                                        :inner-radius 2
                                        :pressed-thickness 2}
                 :menu-option-indicator {:selected-symbol :checkmark}
                 :menu-submenu-indicator {:image :windows-3-theme/submenu-chevron-highlighted
                                          :highlighted-image :windows-3-theme/submenu-chevron-highlighted}
                 :scrollbar-button-symbols {:up-image :windows-3-theme/scrollbar-arrow-up-dark
                                            :down-image :windows-3-theme/scrollbar-arrow-down-dark
                                            :left-image :windows-3-theme/scrollbar-arrow-left-dark
                                            :right-image :windows-3-theme/scrollbar-arrow-right-dark}}}
   :defaults {:text {:font :font/win3-system-font}}
   :styles {:ui/app {:background (var :desktop-bg)
                     :text {:color (var :text)}}

            :ui/panel {:background (var :panel-bg)
                       :padding 4
                       :text {:color (var :text)}}

            :ui/title {:text {:color (var :text)}}

            :ui/muted {:text {:color (var :muted-text)}}

            :ui/accent {:text {:color (var :accent)}}

            :ui/canvas {:background (var :field-bg)
                        :border (var :solid-border-style)}

            :ui/content {:background (var :content-bg)
                         :border (var :solid-border-style)
                         :clip true
                         :text {:color (var :content-text)}}

            'ui/tab-panel {:background (var :panel-bg)
                           :layout {:direction :column}
                           :text {:color (var :text)}}

            'ui/tab-strip {:background (var :panel-bg)
                           :layout {:direction :row}
                           :padding {:t 2 :l 2}}

            'ui/tab {:background (var :panel-bg)
                     :margin {:t 2 :r 1}
                     :padding [2 9]
                     :border {:line-style :solid
                              :color (var :highlight)
                              :thickness 1
                              :right {:color (var :border)}
                              :bottom {:color (var :border)}}
                     :text {:color (var :text)}}

            '(ui/tab {:selected? true})
            {:background (var :panel-bg)
             :margin {:t 0 :r 1}
             :padding [2 9 4 9]
             :border {:line-style :solid
                      :color (var :highlight)
                      :thickness 1
                      :right {:color (var :border)}
                      :bottom {:color (var :panel-bg)}}}

            'ui/tab:disabled
            {:background (var :panel-bg)
             :text {:color (var :muted-text)}}

            'ui/tab-panel-body {:width :fill
                                :height :fill
                                :background (var :panel-bg)
                                :border (var :solid-border-style)
                                :text {:color (var :text)}}

            :ui/desktop-icon-label-box {:padding (var :desktop-icon-label-padding)
                                        :text {:color (var :text)}}

            ['(:ui/desktop-icon {:selected true}) :ui/desktop-icon-label-box]
            {:background (var :selection-bg)
             :text {:color (var :selection-text)}}

            [:ui/desktop-icon:focus :ui/desktop-icon-label-box]
            {:background (var :selection-bg)
             :text {:color (var :selection-text)}}

            :ui/list-item {:text {:color (var :field-text)}}

            :ui/list-item-hover:hover
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            '(:ui/list-item {:selected true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            'ui/list-box {:background (var :field-bg)
                          :border (var :solid-border-style)}

            'ui/combo-box {:background (var :field-bg)
                           :border (var :solid-border-style)}

            'ui/combo-box-trigger {:padding {:t 0 :r 0 :b 0 :l 3}
                                   :layout {:direction :row
                                            :align-items :center
                                            :gap 0}}

            'ui/combo-box-button {:width 15
                                  :height :fill}

            'ui/combo-box-popup-panel {:background (var :field-bg)
                                       :border (var :solid-border-style)}

            'ui/checkbox {:text {:color (var :text)}}

            'ui/checkbox-box {:background (var :field-bg)
                              :border (var :solid-border-style)
                              :text {:color (var :field-text)}}

            '(ui/checkbox-box {:pressed true})
            {:background (var :panel-bg)}

            'ui/option-box {:text {:color (var :text)}}

            'ui/option-box:disabled
            {:text {:color (var :disabled-text)}}

            'ui/slider {:background (var :panel-bg)
                        :border (var :raised-border-style)}

            'ui/progress-bar {:background (var :field-bg)
                              :border (var :control-border-style)
                              :text {:color (var :focus-bg)}}

            :ui/split-pane-resizer {:background (var :panel-bg)
                                    :border (var :raised-border-style)}

            :ui/split-pane-resizer:hover {:background (var :panel-bg)
                                          :border (var :pressed-border-style)}

            '(:ui/split-pane-resizer {:axis :x})
            {:width (var :split-pane-resizer-size)}

            '(:ui/split-pane-resizer {:axis :y})
            {:height (var :split-pane-resizer-size)}

            'ui/scrollbar {:background (var :panel-bg)
                           :border (var :control-border-style)
                           :cursor :default
                           :text {:color (var :text)}}

            '(ui/scrollbar {:axis :x})
            {:height 17}

            '(ui/scrollbar {:axis :y})
            {:width 17}

            'ui/scrollbar-button {:background (var :panel-bg)
                                  :border (var :scrollbar-button-border-style)
                                  :text {:color (var :text)}}

            '(ui/scrollbar-button {:pressed true})
            {:border (var :scrollbar-button-pressed-border-style)}

            'ui/scrollbar-track {:background (var :panel-bg)}

            '(ui/scrollbar-track {:axis :x})
            {:border {:color (var :border)
                      :thickness 0
                      :left {:thickness 1}
                      :right {:thickness 1}}}

            '(ui/scrollbar-track {:axis :y})
            {:border {:color (var :border)
                      :thickness 0
                      :top {:thickness 1}
                      :bottom {:thickness 1}}}

            'ui/scrollbar-handle {:background (var :panel-bg)
                                  :border (var :raised-border-style)}

            '(ui/scrollbar-handle {:pressed true})
            {:border (var :pressed-border-style)}

            'ui/scrollbar-corner {:background (var :panel-bg)
                                  :width 17
                                  :height 17
                                  :border (var :raised-border-style)}

            'ui/scroll-pane {:background (var :panel-bg)}

            'ui/scroll-pane-footer {:height 17}

            'ui/scroll-pane-viewport {:background (var :field-bg)}

            'ui/group-box {:background (var :content-bg)}

            'ui/group-box-frame {:margin {:t 6 :r 4 :b 4 :l 4}
                                 :border {:line-style :solid
                                          :color (var :border)
                                          :thickness 1}}

            'ui/group-box-title {:background (var :content-bg)}

            'ui/header-panel-header {:background (var :focus-bg)
                                     :border {:color (var :border)
                                              :thickness 1}}

            ['ui/header-panel-header :ui/title]
            {:text {:color (var :focus-text)}}

            'ui/window {:border {:line-style :solid
                                 :thickness 1
                                 :color (var :border)}}

            :window/chrome-none {:border {:thickness 0}}

            :window/chrome-dialog-frame {:border (var :dialog-frame-border-style)}

            'ui/window-title-bar {:background (var :menu-bg)
                                  :text {:color (var :text)}
                                  :border {:bottom {:color (var :border)
                                                    :thickness 1}}
                                  :width :fill
                                  :height 19
                                  :padding 0}

            ['ui/window:focus-within 'ui/window-title-bar]
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            'ui/window-control-button {:background {:image :pixils/win311-control-button}
                                       :border {:right {:thickness 1
                                                        :color (var :border)}}
                                       :hidden false
                                       :width 18
                                       :height 18}

            '(ui/window-minimize-button ui/button)
            {:border {:left {:color (var :border)
                             :thickness 1}
                      :thickness 0}
             :width 18
             :hidden false
             :height 18}

            ['ui/window-minimize-button 'ui/button-inner]
            {:background {:image :pixils/win311-minimize-button
                          :align :center}}

            'ui/button
            {:border (var :button-outline-border-style)}

            'ui/button-inner
            {:background (var :button-bg)
             :border (var :button-border-style)}

            'ui/button-inner:hover
            {:text {:color (var :text)}
             :background (var :button-hover-bg)
             :border (var :button-hover-border-style)}

            '(ui/button-inner {:pressed true})
            {:background (var :button-pressed-bg)
             :border (var :button-pressed-border-style)}

            ['ui/window-minimize-button '(ui/button-inner {:pressed true})]
            {:background {:image :pixils/win311-minimize-button
                          :align :center
                          :offset {:x 1 :y 1}}}

            ['(ui/button-inner {:pressed true}) 'ui/text]
            {:padding [4 4 2 8]}

            'ui/text-input
            TEXT-INPUT-FRAME-STYLE

            'ui/number-input
            TEXT-INPUT-FRAME-STYLE

            'ui/text-input-inner
            {:width :fill
             :padding [2 4]}

            'ui/menu-bar
            {:background (var :menu-bg)
             :border {:line-style :solid :color (var :border) :bottom {:thickness 1}}}

            'ui/popup-menu-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            'ui/popup-menu-option-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            :menu/item
            {:text {:color (var :text)
                    :marked-style {:enabled true
                                   :marker "@"
                                   :font-styles :underline}}}

            :menu/item:hover
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            'ui/menu-bar-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)
                    :marked-style {:color (var :text)}}}

            '(ui/menu-bar-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            'ui/popup-menu-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)
                    :marked-style {:color (var :text)}}}

            'ui/popup-menu-option-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)
                    :marked-style {:color (var :text)}}}

            :menu/shortcut-column
            {:margin {:l 16}}

            :menu/trailing-column
            {:margin {:l 16}}

            '(ui/popup-menu-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            '(ui/popup-menu-option-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            'ui/menu-option-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            'ui/menu-option-indicator
            {:box-sizing :content-box
             :width 12
             :height 10}

            'ui/menu-submenu-indicator
            {:box-sizing :content-box
             :width 8
             :height 10}

            '(ui/menu-submenu-indicator {:has-submenu false})
            {:visibility :none}

            'ui/menu-separator
            {:height 1
             :margin {:t 3 :r 0 :b 2 :l 0}
             :border {:thickness 1
                      :line-style :solid
                      :color (var :border)
                      :right {:thickness 0}
                      :bottom {:thickness 0}
                      :left {:thickness 0}}}

            'ui/popup-menu-inner
            {:background (var :menu-bg)
             :border {:thickness 1
                      :line-style :solid
                      :color (var :border)}}

            :ui/panel {:background (var :panel-bg)}}})
