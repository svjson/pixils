(ns pixils.ui.theme.windows-95
  (:require pixils
            [pixils.color :as c]
            [pixils.render :as r]
            [pixils.ui.theme-assets :as theme-assets]))

(def theme-bundle :windows-95-theme)
(def menu-option-checkmark :windows-95-theme/menu-option-checkmark)
(def scrollbar-arrow-up :windows-95-theme/scrollbar-arrow-up)
(def scrollbar-arrow-down :windows-95-theme/scrollbar-arrow-down)
(def scrollbar-arrow-left :windows-95-theme/scrollbar-arrow-left)
(def scrollbar-arrow-right :windows-95-theme/scrollbar-arrow-right)
(def submenu-chevron-highlighted :windows-95-theme/submenu-chevron-highlighted)
(def tree-disclosure-collapsed :windows-95-theme/tree-disclosure-collapsed)
(def tree-disclosure-expanded :windows-95-theme/tree-disclosure-expanded)

(defun draw-menu-option-checkmark! []
  (let [color c/BLACK]
    (do
      (r/line! {:x 7 :y 0} {:x 7 :y 1} color)
      (r/line! {:x 6 :y 2} {:x 7 :y 2} color)
      (r/line! {:x 6 :y 3} {:x 6 :y 3} color)
      (r/line! {:x 5 :y 4} {:x 6 :y 4} color)
      (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
      (r/line! {:x 5 :y 5} {:x 5 :y 5} color)
      (r/line! {:x 1 :y 6} {:x 2 :y 6} color)
      (r/line! {:x 4 :y 6} {:x 5 :y 6} color)
      (r/line! {:x 2 :y 7} {:x 2 :y 7} color)
      (r/line! {:x 4 :y 7} {:x 4 :y 7} color)
      (r/line! {:x 2 :y 8} {:x 4 :y 8} color)
      (r/line! {:x 3 :y 9} {:x 3 :y 9} color))))

(defun draw-filled-arrow-with-color! [direction color]
  (case direction
    :up (do
          (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
          (r/line! {:x 2 :y 1} {:x 4 :y 1} color)
          (r/line! {:x 1 :y 2} {:x 5 :y 2} color)
          (r/line! {:x 0 :y 3} {:x 6 :y 3} color))
    :down (do
            (r/line! {:x 0 :y 0} {:x 6 :y 0} color)
            (r/line! {:x 1 :y 1} {:x 5 :y 1} color)
            (r/line! {:x 2 :y 2} {:x 4 :y 2} color)
            (r/line! {:x 3 :y 3} {:x 3 :y 3} color))
    :left (do
            (r/line! {:x 3 :y 0} {:x 3 :y 0} color)
            (r/line! {:x 2 :y 1} {:x 3 :y 1} color)
            (r/line! {:x 1 :y 2} {:x 3 :y 2} color)
            (r/line! {:x 0 :y 3} {:x 3 :y 3} color)
            (r/line! {:x 1 :y 4} {:x 3 :y 4} color)
            (r/line! {:x 2 :y 5} {:x 3 :y 5} color)
            (r/line! {:x 3 :y 6} {:x 3 :y 6} color))
    :right (do
             (r/line! {:x 0 :y 0} {:x 0 :y 0} color)
             (r/line! {:x 0 :y 1} {:x 1 :y 1} color)
             (r/line! {:x 0 :y 2} {:x 2 :y 2} color)
             (r/line! {:x 0 :y 3} {:x 3 :y 3} color)
             (r/line! {:x 0 :y 4} {:x 2 :y 4} color)
             (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
             (r/line! {:x 0 :y 6} {:x 0 :y 6} color))
    :default nil))

(defun draw-submenu-chevron-with-color! [color]
  (draw-filled-arrow-with-color! :right color))

(defun draw-submenu-chevron-highlighted! []
  (draw-submenu-chevron-with-color! c/WHITE))

(defun draw-scrollbar-arrow-up! []
  (draw-filled-arrow-with-color! :up c/BLACK))

(defun draw-scrollbar-arrow-down! []
  (draw-filled-arrow-with-color! :down c/BLACK))

(defun draw-scrollbar-arrow-left! []
  (draw-filled-arrow-with-color! :left c/BLACK))

(defun draw-scrollbar-arrow-right! []
  (draw-filled-arrow-with-color! :right c/BLACK))

(defun draw-tree-disclosure-box! [collapsed?]
  (do
    (r/rect! {:x 0 :y 0 :w 9 :h 9}
             {:fill true
              :color c/WHITE})
    (r/rect! {:x 0 :y 0 :w 9 :h 9}
             {:color c/BLACK})
    (r/line! {:x 2 :y 4} {:x 6 :y 4} c/BLACK)
    (when collapsed?
      (r/line! {:x 4 :y 2} {:x 4 :y 6} c/BLACK))))

(defun draw-tree-disclosure-collapsed! []
  (draw-tree-disclosure-box! true))

(defun draw-tree-disclosure-expanded! []
  (draw-tree-disclosure-box! false))

(defun ensure-windows-95-theme-assets! []
  (do
    (theme-assets/ensure-generated-image! theme-bundle
                                          menu-option-checkmark
                                          {:size {:w 8 :h 10}}
                                          draw-menu-option-checkmark!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          submenu-chevron-highlighted
                                          {:size {:w 4 :h 7}}
                                          draw-submenu-chevron-highlighted!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-up
                                          {:size {:w 7 :h 4}}
                                          draw-scrollbar-arrow-up!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-down
                                          {:size {:w 7 :h 4}}
                                          draw-scrollbar-arrow-down!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-left
                                          {:size {:w 4 :h 7}}
                                          draw-scrollbar-arrow-left!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-right
                                          {:size {:w 4 :h 7}}
                                          draw-scrollbar-arrow-right!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          tree-disclosure-collapsed
                                          {:size {:w 9 :h 9}}
                                          draw-tree-disclosure-collapsed!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          tree-disclosure-expanded
                                          {:size {:w 9 :h 9}}
                                          draw-tree-disclosure-expanded!)))

(ensure-windows-95-theme-assets!)



;; Win95 Sans Serif System Font

(deffont win95-system-font
  {:type :bitmap
   :spacing 1
   :resource :pixils/win95-system-font
   :baseline 8
   :styles {:underline {:offset 2
                        :thickness 1}}
   :glyphs {' ' {:x 144 :y 11 :w 1 :h 11}
            '.' {:x 73 :y 22 :w 1 :h 10}
            ',' {:x 76 :y 22 :w 2 :h 10}
            '<' {:x 78 :y 22 :w 4 :h 10}
            '=' {:x 83 :y 22 :w 5 :h 10}
            '>' {:x 89 :y 22 :w 4 :h 10}
            '+' {:x 94 :y 22 :w 5 :h 10}
            '-' {:x 100 :y 22 :w 2 :h 10}
            ':' {:x 103 :y 22 :w 1 :h 10}
            '?' {:x 67 :y 22 :w 6 :h 10}
            '(' {:x 61 :y 22 :w 2 :h 12}
            ')' {:x 64 :y 22 :w 2 :h 12}
            '0' {:x 0 :y 22 :w 5 :h 9}
            '1' {:x 7 :y 22 :w 3 :h 9}
            '2' {:x 11 :y 22 :w 5 :h 9}
            '3' {:x 17 :y 22 :w 5 :h 9}
            '4' {:x 24 :y 22 :w 5 :h 9}
            '5' {:x 30 :y 22 :w 5 :h 9}
            '6' {:x 36 :y 22 :w 5 :h 9}
            '7' {:x 42 :y 22 :w 5 :h 9}
            '8' {:x 49 :y 22 :w 5 :h 9}
            '9' {:x 55 :y 22 :w 5 :h 9}
            'A' {:x 0 :y 0 :w 7 :h 9}
            'B' {:x 8 :y 0 :w 5 :h 9}
            'C' {:x 14 :y 0 :w 6 :h 9}
            'D' {:x 22 :y 0 :w 6 :h 9}
            'E' {:x 29 :y 0 :w 5 :h 9}
            'F' {:x 35 :y 0 :w 5 :h 10}
            'G' {:x 41 :y 0 :w 6 :h 9}
            'H' {:x 48 :y 0 :w 6 :h 9}
            'I' {:x 55 :y 0 :w 1 :h 9}
            'J' {:x 58 :y 0 :w 4 :h 9}
            'K' {:x 63 :y 0 :w 6 :h 9}
            'L' {:x 70 :y 0 :w 5 :h 9}
            'M' {:x 77 :y 0 :w 7 :h 9}
            'N' {:x 85 :y 0 :w 6 :h 9}
            'O' {:x 92 :y 0 :w 6 :h 9}
            'P' {:x 99 :y 0 :w 7 :h 9}
            'Q' {:x 107 :y 0 :w 6 :h 10}
            'R' {:x 114 :y 0 :w 6 :h 10}
            'S' {:x 121 :y 0 :w 5 :h 9}
            'T' {:x 127 :y 0 :w 5 :h 9}
            'U' {:x 133 :y 0 :w 6 :h 9}
            'V' {:x 140 :y 0 :w 7 :h 9}
            'W' {:x 148 :y 0 :w 11 :h 9}
            'X' {:x 160 :y 0 :w 7 :h 9}
            'Y' {:x 168 :y 0 :w 7 :h 9}
            'Z' {:x 176 :y 0 :w 7 :h 9}
            'a' {:x 0 :y 11 :w 5 :h 9}
            'b' {:x 6 :y 11 :w 5 :h 9}
            'c' {:x 12 :y 11 :w 5 :h 9}
            'd' {:x 18 :y 11 :w 5 :h 9}
            'e' {:x 24 :y 11 :w 5 :h 9}
            'f' {:x 30 :y 11 :w 2 :h 9}
            'g' {:x 34 :y 11 :w 5 :h 11}
            'h' {:x 40 :y 11 :w 5 :h 9}
            'i' {:x 46 :y 11 :w 1 :h 9}
            'j' {:x 48 :y 11 :w 1 :h 11}
            'k' {:x 51 :y 11 :w 5 :h 9}
            'l' {:x 57 :y 11 :w 1 :h 11}
            'm' {:x 59 :y 11 :w 7 :h 9}
            'n' {:x 68 :y 11 :w 5 :h 9}
            'o' {:x 74 :y 11 :w 5 :h 9}
            'p' {:x 80 :y 11 :w 5 :h 11}
            'r' {:x 93 :y 11 :w 2 :h 9}
            's' {:x 96 :y 11 :w 4 :h 9}
            't' {:x 101 :y 11 :w 2 :h 9}
            'u' {:x 105 :y 11 :w 5 :h 9}
            'v' {:x 111 :y 11 :w 5 :h 9}
            'w' {:x 117 :y 11 :w 7 :h 9}
            'x' {:x 126 :y 11 :w 4 :h 9}
            'y' {:x 131 :y 11 :w 4 :h 11}}})



;; Windows 95 colors

(def WHITE {:r 255 :g 255 :b 255})
(def PANEL-COLOR {:r 0xb8 :g 0xb8 :b 0xb8})
(def PANEL-LIGHT {:r 0xdf :g 0xdf :b 0xdf})
(def PANEL-SHADOW {:r 0x7f :g 0x7f :b 0x7f})
(def FOCUS-BLUE {:r 0x00 :g 0x00 :b 0x7f})
(def CONTENT-BG WHITE)
(def DESKTOP-TEAL {:r 0x00 :g 0x80 :b 0x80})

(deftheme pixils/windows-95
  {:default-variant :light
   :vars {:light {:desktop-bg DESKTOP-TEAL
                  :panel-bg PANEL-COLOR
                  :panel-highlight PANEL-LIGHT
                  :panel-shadow PANEL-SHADOW
                  :text c/BLACK
                  :muted-text PANEL-SHADOW
                  :accent FOCUS-BLUE
                  :focus-bg FOCUS-BLUE
                  :focus-text c/WHITE
                  :content-bg CONTENT-BG
                  :content-text c/BLACK
                  :surface (var :content-bg)
                  :field-bg CONTENT-BG
                  :field-text c/BLACK
                  :button-bg (var :panel-bg)
                  :button-hover-bg (var :button-bg)
                  :button-pressed-bg (var :button-bg)
                  :button-disabled-bg (var :button-bg)
                  :menu-bg PANEL-COLOR
                  :border c/BLACK
                  :highlight PANEL-LIGHT
                  :highlight-color (var :highlight)
                  :border-light (var :panel-highlight)
                  :border-dark (var :panel-shadow)
                  :border-inset-top-left (var :border-dark)
                  :border-inset-bottom-right (var :border-light)
                  :border-raised-top-left (var :border-light)
                  :border-raised-bottom-right (var :border-dark)
                  :selection-bg (var :focus-bg)
                  :selection-text (var :focus-text)
                  :desktop-icon-label-padding 2
                  :solid-border-style {:line-style :solid
                                       :color (var :border)
                                       :thickness 1}
                  :inset-border-style {:line-style :bevel
                                       :color (var :panel-shadow)
                                       :thickness 1
                                       :right {:color (var :panel-highlight)}
                                       :bottom {:color (var :panel-highlight)}}
                  :raised-border-style {:line-style :bevel
                                        :color (var :highlight)
                                        :thickness 1
                                        :right {:color (var :panel-shadow)}
                                        :bottom {:color (var :panel-shadow)}}
                  :pressed-border-style {:line-style :bevel
                                         :color (var :panel-shadow)
                                         :thickness 1
                                         :right {:color (var :highlight)}
                                         :bottom {:color (var :highlight)}}
                  :button-border-style (var :raised-border-style)
                  :button-hover-border-style (var :button-border-style)
                  :button-pressed-border-style (var :pressed-border-style)
                  :button-disabled-border-style (var :button-border-style)
                  :split-pane-resizer-size 6
                  :scrollbar-size 14
                  :slider {:thumb-shape :windows
                           :thumb-color (var :panel-bg)
                           :thumb-length 13
                           :thumb-point-size 6
                           :track-layout :handle-travel
                           :track-shape :windows-track
                           :track-thickness 4
                           :track-border? false
                           :limit-track-color (var :panel-shadow)
                           :track-bevel {:outer-top-color (var :panel-shadow)
                                         :outer-bottom-color c/WHITE
                                         :inner-top-color (var :border)
                                         :inner-bottom-color {:r 0xdd :g 0xdd :b 0xdd}}
                           :thumb-bevel {:outer-top-color c/WHITE
                                          :outer-bottom-color (var :border)
                                          :inner-top-color {:r 0xdd :g 0xdd :b 0xdd}
                                          :inner-bottom-color (var :panel-shadow)}}
                  :option-box-indicator {:color {:r 0x00 :g 0x00 :b 0x00}
                                         :radius 5
                                         :inner-radius 2
                                         :pressed-thickness 2}
                  :menu-option-indicator {:selected-image :windows-95-theme/menu-option-checkmark}
                  :menu-submenu-indicator {:image :windows-95-theme/scrollbar-arrow-right
                                           :highlighted-image :windows-95-theme/submenu-chevron-highlighted}
                  :collapsible {:collapsed-image :windows-95-theme/scrollbar-arrow-right
                                :expanded-image :windows-95-theme/scrollbar-arrow-down}
                  :scrollbar-button-symbols {:up-image :windows-95-theme/scrollbar-arrow-up
                                             :down-image :windows-95-theme/scrollbar-arrow-down
                                             :left-image :windows-95-theme/scrollbar-arrow-left
                                             :right-image :windows-95-theme/scrollbar-arrow-right}
                  :tree-view-disclosure {:collapsed-image :windows-95-theme/tree-disclosure-collapsed
                                         :expanded-image :windows-95-theme/tree-disclosure-expanded}}
          :dark {:desktop-bg {:r 0x12 :g 0x2f :b 0x33}
                 :panel-bg {:r 0x33 :g 0x36 :b 0x39}
                 :panel-highlight {:r 0x58 :g 0x5d :b 0x63}
                 :panel-shadow {:r 0x18 :g 0x1a :b 0x1d}
                 :text {:r 0xe8 :g 0xea :b 0xec}
                 :muted-text {:r 0x9a :g 0xa0 :b 0xa6}
                 :accent {:r 0x79 :g 0xa7 :b 0xff}
                 :focus-bg {:r 0x18 :g 0x4f :b 0x9d}
                 :focus-text c/WHITE
                 :content-bg {:r 0x14 :g 0x16 :b 0x18}
                 :content-text {:r 0xf0 :g 0xf2 :b 0xf4}
                 :field-bg {:r 0x14 :g 0x16 :b 0x18}
                 :field-text {:r 0xf0 :g 0xf2 :b 0xf4}
                 :menu-bg {:r 0x33 :g 0x36 :b 0x39}
                 :border {:r 0x05 :g 0x06 :b 0x07}
                 :highlight {:r 0x58 :g 0x5d :b 0x63}
                 :highlight-color (var :highlight)
                 :split-pane-resizer-size 6
                 :scrollbar-size 14
                 :slider {:thumb-shape :windows
                          :thumb-color (var :panel-bg)
                          :thumb-length 13
                          :thumb-point-size 6
                          :track-layout :handle-travel
                          :track-shape :windows-track
                          :track-thickness 4
                          :track-border? false
                          :limit-track-color (var :panel-shadow)
                          :track-bevel {:outer-top-color (var :panel-shadow)
                                        :outer-bottom-color (var :panel-highlight)
                                        :inner-top-color (var :border)
                                        :inner-bottom-color (var :highlight)}
                          :thumb-bevel {:outer-top-color (var :highlight)
                                         :outer-bottom-color (var :border)
                                         :inner-top-color (var :panel-highlight)
                                         :inner-bottom-color (var :panel-shadow)}}
                 :option-box-indicator {:color {:r 0x00 :g 0x00 :b 0x00}
                                        :radius 5
                                        :inner-radius 2
                                        :pressed-thickness 2}
                 :menu-option-indicator {:selected-image :windows-95-theme/menu-option-checkmark}
                 :menu-submenu-indicator {:image :windows-95-theme/submenu-chevron-highlighted
                                          :highlighted-image :windows-95-theme/submenu-chevron-highlighted}
                 :collapsible {:collapsed-image :windows-95-theme/tree-disclosure-collapsed
                               :expanded-image :windows-95-theme/tree-disclosure-expanded}
                 :scrollbar-button-symbols {:up-image :windows-95-theme/scrollbar-arrow-up
                                            :down-image :windows-95-theme/scrollbar-arrow-down
                                            :left-image :windows-95-theme/scrollbar-arrow-left
                                            :right-image :windows-95-theme/scrollbar-arrow-right}
                 :tree-view-disclosure {:collapsed-image :windows-95-theme/tree-disclosure-collapsed
                                        :expanded-image :windows-95-theme/tree-disclosure-expanded}}}
   :defaults {:text {:font :font/win95-system-font}}
   :styles {:ui/app {:background (var :desktop-bg)
                     :text {:color (var :text)}}

            :ui/panel {:background (var :panel-bg)
                       :text {:color (var :text)}
                       :padding 4}

            :ui/title {:text {:color (var :text)}}

            :ui/muted {:text {:color (var :muted-text)}}

            :ui/accent {:text {:color (var :accent)}}

            :ui/canvas {:background (var :field-bg)
                        :border (var :solid-border-style)}

            :ui/content {:background (var :content-bg)
                         :border (var :solid-border-style)
                         :clip true
                         :text {:color (var :content-text)}}

            :ui/dialog-body {:width :fill
                             :min-width 260
                             :height :shrink
                             :padding 10
                             :layout {:direction :column
                                      :gap 10}}

            :ui/dialog-button-row {:width :fill
                                   :height 24
                                   :layout {:direction :row
                                            :gap :space-between}}

            :ui/dialog-button {:width 78
                               :height 24}

            :ui/file-dialog-window {:width 420}

            :ui/file-dialog-body {:width :fill
                                  :height :shrink
                                  :padding 10
                                  :layout {:direction :column
                                           :gap 8}}

            :ui/file-dialog-button-row {:width :fill
                                        :height 24
                                        :layout {:direction :row
                                                 :gap :space-between}}

            'ui/tab-panel {:background {:r 0 :g 0 :b 0 :a 0}
                           :layout {:direction :column}
                           :text {:color (var :text)}}

            'ui/tab-strip {:width :fill
                           :background {:r 0 :g 0 :b 0 :a 0}
                           :layout {:direction :row}
                           :padding {:t 3 :l 4}
                           :border {:line-style :solid
                                    :thickness 0
                                    :bottom {:color (var :highlight)
                                             :thickness 2}}}

            'ui/tab {:background (var :panel-bg)
                     :margin {:t 2}
                     :padding [3 10]
                     :corner-radius {:tl 2 :tr 2}
                     :border {:line-style :bevel
                              :color (var :highlight)
                              :thickness 2
                              :right {:color (var :panel-shadow)}
                              :bottom {:thickness 0}}
                     :text {:color (var :text)}}

            '(ui/tab {:selected? true})
            {:background (var :panel-bg)
             :margin {:t 0 :b -2}
             :padding [4 10 6 10]
             :corner-radius {:tl 2 :tr 2}
             :border {:line-style :bevel
                      :color (var :highlight)
                      :thickness 2
                      :right {:color (var :panel-shadow)}
                      :bottom {:color (var :panel-bg)
                               :thickness 0}}}

            'ui/tab:disabled
            {:background (var :panel-bg)
             :text {:color (var :muted-text)}}

            'ui/tab-panel-body {:width :fill
                                :height :fill
                                :background (var :panel-bg)
                                :border {:line-style :bevel
                                         :color (var :highlight)
                                         :thickness 2
                                         :top {:thickness 0}
                                         :right {:color (var :panel-shadow)}
                                         :bottom {:color (var :panel-shadow)}}
                                :text {:color (var :text)}}

            :ui/desktop-icon-label-box {:padding (var :desktop-icon-label-padding)
                                        :text {:color (var :text)}}

            ['(:ui/desktop-icon {:selected true}) :ui/desktop-icon-label-box]
            {:background (var :selection-bg)
             :text {:color (var :selection-text)}}

            [:ui/desktop-icon:focus :ui/desktop-icon-label-box]
            {:background (var :selection-bg)
             :text {:color (var :selection-text)}}

            :ui/list-item {:padding (var :list-box-item-padding)
                           :text {:color (var :field-text)
                                  :wrap :none}}

            :ui/list-item-hover:hover
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            [:ui/list-item-hover:hover 'ui/tree-view-disclosure]
            {:text {:color (var :focus-text)}}

            '(:ui/list-item {:selected true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            ['(:ui/list-item {:selected true}) 'ui/tree-view-disclosure]
            {:text {:color (var :focus-text)}}

            'ui/list-box {:background (var :field-bg)
                          :border (var :solid-border-style)}

            'ui/tree-view {:background (var :field-bg)
                           :border (var :solid-border-style)}

            'ui/tree-view-disclosure {:text {:color (var :field-text)}}

            'ui/combo-box {:background (var :field-bg)
                           :border (var :inset-border-style)}

            'ui/combo-box-trigger {:padding {:t 0 :r 0 :b 0 :l 3}
                                   :layout {:direction :row
                                            :align-items :center
                                            :gap 0}}

            'ui/combo-box-button {:width 16
                                  :max-width 16
                                  :height :fill}

            'ui/combo-box-popup-panel {:background (var :field-bg)
                                       :border (var :solid-border-style)}

            'ui/checkbox {:text {:color (var :text)}}

            'ui/checkbox-box {:background (var :field-bg)
                              :border (var :inset-border-style)
                              :text {:color (var :field-text)}}

            '(ui/checkbox-box {:pressed true})
            {:background (var :panel-bg)}

            'ui/option-box {:height 18
                            :text {:color (var :text)}}

            'ui/option-box:disabled
            {:text {:color (var :disabled-text)}}

            'ui/slider {:width :fill
                        :height 21
                        :max-height 21
                        :background {:r 0 :g 0 :b 0 :a 0}
                        :border {:thickness 0}}
            '(ui/slider {:axis :y})
            {:width 21
             :max-width 21}

            :ui/split-pane-resizer {:background (var :panel-bg)
                                    :border (var :raised-border-style)}

            :ui/split-pane-resizer:hover {:background (var :panel-bg)
                                          :border (var :pressed-border-style)}

            '(:ui/split-pane-resizer {:axis :x})
            {:width (var :split-pane-resizer-size)}

            '(:ui/split-pane-resizer {:axis :y})
            {:height (var :split-pane-resizer-size)}

            'ui/scrollbar {:background (var :panel-bg)
                           :text {:color (var :text)}}

            'ui/scrollbar-button {:background (var :panel-bg)
                                  :border (var :raised-border-style)
                                  :text {:color (var :text)}}

            '(ui/scrollbar-button {:pressed true})
            {:border (var :pressed-border-style)}

            'ui/scrollbar-track {:background (var :panel-highlight)}

            'ui/scrollbar-handle {:background (var :panel-bg)
                                  :border (var :raised-border-style)}

            '(ui/scrollbar-handle {:pressed true})
            {:border (var :pressed-border-style)}

            'ui/scrollbar-corner {:background (var :panel-bg)
                                  :border (var :raised-border-style)}

            'ui/scroll-pane {:background (var :panel-bg)}

            'ui/scroll-pane-viewport {:background (var :field-bg)}

            'ui/window {:border {:line-style :solid
                                 :thickness 1
                                 :color (var :border)
                                 :top {:color (var :panel-bg)}
                                 :left {:color (var :panel-bg)}}}

            :window/chrome-none {:border {:thickness 0}}

            'ui/window-title-bar {:background (var :panel-shadow)
                                  :border {:line-style :solid
                                           :thickness 1
                                           :color (var :panel-highlight)
                                           :right {:color (var :panel-bg)}
                                           :bottom {:thickness 0}}
                                  :text {:color (var :text)}
                                  :width :fill
                                  :height 19
                                  :max-height 19}

            'ui/window-body {:background (var :menu-bg)
                             :border {:line-style :solid
                                      :thickness 1
                                      :color (var :panel-highlight)
                                      :right {:color (var :panel-bg)}
                                      :bottom {:color (var :panel-bg)}
                                      :top {:thickness 0}}
                             :text {:color (var :text)}}

            [:window/chrome-none 'ui/window-body]
            {:border {:thickness 0}}

            [:window/chrome-frame 'ui/window-body]
            {:border {:thickness 0}}

            [:window/chrome-dialog-frame 'ui/window-body]
            {:border {:thickness 0}}

            ['ui/window:focus-within 'ui/window-title-bar]
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            'ui/window-control-button {:hidden true}

            'ui/window-minimize-button {:margin {:t 2}
                                        :width 16
                                        :max-width 16
                                        :height 14
                                        :max-height 14}

            ['ui/window-minimize-button 'ui/button-inner]
            {:background {:image :pixils/win95-minimize-button
                          :align :center}}

            'ui/button
            {:border {:line-style :solid
                      :color (var :border)
                      :thickness 1
                      :top {:thickness 0}
                      :left {:thickness 0}}}

            '(ui/button {:pressed true})
            {:border {:top {:thickness 1 :color (var :border)}
                      :left {:thickness 1 :color (var :border)}}}

            'ui/button-inner
            {:background (var :button-bg)
             :border (var :button-border-style)}

            '(ui/button-inner:hover)
            {:background (var :button-hover-bg)
             :border (var :button-hover-border-style)}

            '(ui/button-inner {:pressed true})
            {:background (var :button-pressed-bg)
             :border (var :button-pressed-border-style)}

            ['ui/window-minimize-button '(ui/button-inner {:pressed true})]
            {:background {:image :pixils/win95-minimize-button
                          :align :center
                          :offset {:x 1 :y 1}}}

            'ui/menu-bar {:background (var :menu-bg)
                          :text {:color (var :text)}}

            :menu/item
            {:text {:color (var :text)
                    :marked-style {:enabled true
                                   :marker "@"
                                   :font-styles :underline}}
             :hover {:background (var :focus-bg)
                     :text {:color (var :focus-text)}}}

            'ui/menu-bar-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)}}

            '(ui/menu-bar-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)}}

            'ui/popup-menu-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)
                    :marked-style {:color (var :text)}}}

            'ui/popup-menu-option-item:hover
            {:background (var :menu-bg)
             :text {:color (var :text)
                    :marked-style {:color (var :text)}}}

            '(ui/popup-menu-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            '(ui/popup-menu-option-item {:highlighted true})
            {:background (var :focus-bg)
             :text {:color (var :focus-text)
                    :marked-style {:color (var :focus-text)}}}

            'ui/popup-menu-option-item
            {:padding {:t 2 :r 12 :b 2 :l 2}}

            :menu/trailing-column
            {:margin {:l 16}}

            'ui/menu-option-indicator
            {:box-sizing :content-box
             :width 12
             :height 10}

            'ui/menu-submenu-indicator
            {:box-sizing :content-box
             :width 8
             :height 10}

            '(ui/menu-submenu-indicator {:has-submenu false})
            {:visibility :none}

            'ui/menu-separator {:height 2
                                :margin {:t 3 :r 2 :b 2 :l 2}
                                :border {:thickness 1
                                         :line-style :solid
                                         :color (var :panel-shadow)
                                         :left {:thickness 0}
                                         :right {:thickness 0}
                                         :bottom {:color (var :highlight)}}}
            'ui/popup-menu-outer {:border {:color (var :highlight)
                                           :line-style :solid
                                           :thickness 1
                                           :bottom {:color (var :border)}
                                           :right {:color (var :border)}}}
            'ui/popup-menu-inner {:border {:color (var :highlight)
                                           :line-style :solid
                                           :thickness 1
                                           :bottom {:color (var :panel-shadow)}
                                           :right {:color (var :panel-shadow)}}
                                  :background (var :menu-bg)
                                  :text {:color (var :text)}}

            'ui/group-box-frame {:margin {:t 6 :r 4 :b 4 :l 4}}

            :ui/panel {:background (var :panel-bg)}}})
