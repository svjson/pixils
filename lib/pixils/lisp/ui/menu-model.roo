(ns pixils.ui.menu-model
  (:require [pixils.keyboard :as kbd]))



;; Settings and normalization

(def default-settings
  "Default mnemonic and shortcut-rendering settings for normalized menus."
  {:mnemonics {:enabled true
               :marker "&"
               :render-marker "@"
               :trigger :alt
               :style :underline}
   :shortcuts {:render true}})

(def shortcut-key-names
  "Display names for non-character keys used in menu shortcuts."
  {:key/alt "Alt"
   :key/left-alt "Alt"
   :key/right-alt "Alt"
   :key/ctrl "Ctrl"
   :key/left-ctrl "Ctrl"
   :key/right-ctrl "Ctrl"
   :key/shift "Shift"
   :key/left-shift "Shift"
   :key/right-shift "Shift"
   :key/super "Super"
   :key/left-super "Super"
   :key/right-super "Super"
   :key/enter "Enter"
   :key/escape "Esc"
   :key/delete "Del"
   :key/backspace "Backspace"
   :key/space "Space"
   :key/home "Home"
   :key/end "End"
   :key/pageup "PgUp"
   :key/pagedown "PgDn"
   :key/left "Left"
   :key/right "Right"
   :key/up "Up"
   :key/down "Down"
   :key/f1 "F1"
   :key/f2 "F2"
   :key/f3 "F3"
   :key/f4 "F4"
   :key/f5 "F5"
   :key/f6 "F6"
   :key/f7 "F7"
   :key/f8 "F8"
   :key/f9 "F9"
   :key/f10 "F10"
   :key/f11 "F11"
   :key/f12 "F12"})

(defun merge-settings
  "Merge menu settings while preserving nested mnemonic and shortcut defaults.

  Args:
  - `parent`: Settings inherited from the containing menu node.
  - `local`: Settings declared by the current menu node.

  Returns:
  The merged settings map."
  [parent local]
  (let [local (or local {})]
    (-> (merge parent local)
        (assoc :mnemonics (merge (:mnemonics parent)
                                 (:mnemonics local)))
        (assoc :shortcuts (merge (:shortcuts parent)
                                 (:shortcuts local))))))

(defun item-settings
  "Return the settings declared by a menu item.

  Args:
  - `item`: Declarative menu item.

  Returns:
  Item settings including the legacy shortcut-rendering option."
  [item]
  (let [settings (or (:settings item) {})]
    (cond-> settings
      (contains? item :render-shortcut?)
      (assoc-in [:shortcuts :render] (:render-shortcut? item)))))

(defun parse-mnemonic-label
  "Parse mnemonic markers from a label using the supplied accumulator state.

  Args:
  - `label`: Source label containing mnemonic markers.
  - `marker`: Marker string that introduces a mnemonic.
  - `trigger`: Input modifier associated with the mnemonic.
  - `style`: Display style recorded for the mnemonic.
  - `index`: Current source-string offset.
  - `out`: Accumulated label text without control markers.
  - `mnemonic`: First mnemonic discovered so far, or `nil`.

  Returns:
  Parsed text and mnemonic metadata."
  [label marker trigger style index out mnemonic]
  (if (>= index (count label))
    {:text out
     :mnemonic mnemonic}
    (let [ch (nth label index)]
      (cond
        (not= (str ch) marker)
        (parse-mnemonic-label label
                              marker
                              trigger
                              style
                              (inc index)
                              (str out ch)
                              mnemonic)

        (= index (dec (count label)))
        (parse-mnemonic-label label
                              marker
                              trigger
                              style
                              (inc index)
                              (str out ch)
                              mnemonic)

        :default
        (let [next-ch (nth label (inc index))]
          (parse-mnemonic-label label
                                marker
                                trigger
                                style
                                (+ index 2)
                                (if (= (str next-ch) marker)
                                  (str out marker)
                                  (str out next-ch))
                                (if (= (str next-ch) marker)
                                  mnemonic
                                  (or mnemonic
                                      {:char next-ch
                                       :index (count out)
                                       :trigger trigger
                                       :style style}))))))))

(defun normalize-label
  "Normalize a menu item's label and mnemonic metadata.

  Args:
  - `item`: Declarative menu item.
  - `settings`: Effective menu settings for the item.

  Returns:
  A map containing normalized `:text` and `:mnemonic` values."
  [item settings]
  (let [label (or (:label item) "")]
    (cond
      (contains? item :mnemonic)
      {:text label
       :mnemonic (unless (= false (:mnemonic item))
                   (:mnemonic item))}

      (-> settings :mnemonics :enabled)
      (parse-mnemonic-label label
                            (-> settings :mnemonics :marker)
                            (-> settings :mnemonics :trigger)
                            (-> settings :mnemonics :style)
                            0
                            ""
                            nil)

      :default
      {:text label
       :mnemonic nil})))

(defun mnemonic-display-text
  "Insert display markers around a normalized mnemonic character.

  Args:
  - `text`: Label text without control markers.
  - `mnemonic`: Mnemonic metadata, or `nil`.
  - `render-marker`: Marker emitted around the mnemonic character.

  Returns:
  Display-ready label text."
  [text mnemonic render-marker]
  (if (or (nil? mnemonic)
          (nil? render-marker))
    text
    (let [index (:index mnemonic)]
      (str (substr text 0 index)
           render-marker
           (substr text index 1)
           render-marker
           (substr text (inc index))))))

(defun action-binding-action
  "Resolve the action keyword represented by a key binding.

  Args:
  - `binding`: Action keyword or binding map.

  Returns:
  The bound action keyword, or `nil`."
  [binding]
  (cond
    (keyword? binding) binding
    (:action binding) (:action binding)
    :default nil))

(defun first-shortcut-for-action
  "Find the first shortcut mapped to an action.

  Args:
  - `action`: Action keyword to match.
  - `keymap`: Shortcut-to-binding map.

  Returns:
  A shortcut value, or `nil` when no binding matches."
  [action keymap]
  (unless (or (nil? action)
              (empty? keymap))
    (reduce-kv keymap
               nil
               (fn [match shortcut-or-index binding]
                 (or match
                     (when (= (action-binding-action binding) action)
                       (or (:shortcut binding)
                           shortcut-or-index)))))))

(defun shortcut-key-name
  "Return the display name for one shortcut key.

  Args:
  - `key`: Key keyword.

  Returns:
  A compact display string."
  [key]
  (if-let [display-name (get shortcut-key-names key)]
    display-name
    (let [value (name key)]
      (case (count value)
        1 (upper-case value)
        :default value))))

(defun format-shortcut-parts
  "Format a non-empty shortcut sequence recursively.

  Args:
  - `parts`: Ordered key keywords.

  Returns:
  A plus-separated shortcut string."
  [parts]
  (if (empty? parts)
    ""
    (let [head-text (shortcut-key-name (head parts))
          tail-parts (tail parts)]
      (if (empty? tail-parts)
        head-text
        (str head-text "+" (format-shortcut-parts tail-parts))))))

(defun format-shortcut
  "Format a menu shortcut for display.

  Args:
  - `shortcut`: A key keyword, key sequence, or `nil`.

  Returns:
  A display string, or `nil` when no shortcut is supplied."
  [shortcut]
  (cond
    (nil? shortcut) nil
    (keyword? shortcut) (shortcut-key-name shortcut)
    :default (format-shortcut-parts shortcut)))

(defun normalize-item
  "Normalize one menu item and its descendants.

  Args:
  - `item`: Declarative menu item or `:separator`.
  - `inherited-settings`: Effective settings inherited from the parent.
  - `keymap`: Action bindings used to resolve shortcuts.

  Returns:
  A stable normalized menu node."
  [item inherited-settings keymap]
  (case item
    :separator
    {:node-type :separator
     :settings inherited-settings}

    :default
    (let [settings (merge-settings inherited-settings
                                        (item-settings item))
          label-data (normalize-label item settings)
          action (:action item)
          shortcut (if (contains? item :shortcut)
                     (:shortcut item)
                     (first-shortcut-for-action action keymap))]
      {:node-type :item
       :item-type (or (:type item) :action)
       :action action
       :payload (:payload item)
       :disabled? (:disabled? item)
       :value (or (:value item) (:selected-value item))
       :label (:label item)
       :text (:text label-data)
       :display-text (mnemonic-display-text (:text label-data)
                                            (:mnemonic label-data)
                                            (-> settings
                                                :mnemonics
                                                :render-marker))
       :mnemonic (:mnemonic label-data)
       :settings settings
       :selected-path (:selected-path item)
       :resolved-shortcut shortcut
       :shortcut-text (when (and (-> settings :shortcuts :render)
                                 (some? shortcut))
                        (format-shortcut shortcut))
       :items (for [child (:items item)]
                (normalize-item child settings keymap))})))

(defun normalize
  "Normalize a declarative menu tree.

  Args:
  - `menu-definition`: Root menu definition and optional settings.
  - `keymap`: Action bindings used to resolve displayed shortcuts.

  Returns:
  A normalized menu root with stable item shapes."
  [menu-definition keymap]
  (let [settings (merge-settings default-settings
                                      (:settings menu-definition))]
    {:node-type :root
     :settings settings
     :items (for [item (:items menu-definition)]
              (normalize-item item settings keymap))}))



;; Selection and navigation

(defun selectable-item?
  "Return whether a normalized menu node can receive selection.

  Args:
  - `node`: Normalized menu node."
  [node]
  (and (not= :separator (:node-type node))
       (not (:disabled? node))))

(defun submenu-node?
  "Return whether a normalized menu node owns submenu items.

  Args:
  - `node`: Normalized menu node."
  [node]
  (not-empty? (:items node)))

(defun first-selectable-index
  "Find the first selectable menu-item index.

  Args:
  - `items`: Normalized menu nodes.

  Returns:
  An index, or `nil` when no item is selectable."
  [items]
  (find-index items selectable-item?))

(defun selectable-indices
  "Collect the indices of selectable menu items.

  Args:
  - `items`: Normalized menu nodes.

  Returns:
  Selectable indices in menu order."
  [items]
  (keep (for-indexed [index item items]
          {:index index
           :item item})
        (fn [{:keys [index item]}]
          (when (selectable-item? item)
            index))))

(defun highlighted-item
  "Resolve the item at a logical highlight index.

  Args:
  - `items`: Normalized menu nodes.
  - `highlighted-index`: Candidate logical index.

  Returns:
  The indexed item, or `nil` for an invalid index."
  [items highlighted-index]
  (when (and (some? highlighted-index)
             (>= highlighted-index 0)
             (< highlighted-index (count items)))
    (nth items highlighted-index)))

(defun normalized-mnemonic-char
  "Normalize an input value to one uppercase mnemonic character.

  Args:
  - `value`: Text-like mnemonic input.

  Returns:
  An uppercase character string, or `nil`."
  [value]
  (unless (or (nil? value)
              (empty? value))
    (upper-case (substr value 0 1))))

(defun event-mnemonic-char
  "Extract a normalized mnemonic character from a keyboard event.

  Args:
  - `event`: Keyboard event map.

  Returns:
  An uppercase character string, or `nil`."
  [event]
  (when-let [text (kbd/event->text event)]
    (normalized-mnemonic-char text)))

(defun find-mnemonic-index
  "Find the first selectable item matching a mnemonic character.

  Args:
  - `items`: Normalized menu nodes.
  - `mnemonic-char`: Normalized uppercase mnemonic character.

  Returns:
  An item index, or `nil`."
  [items mnemonic-char]
  (find-index items
              (fn [item]
                (and (selectable-item? item)
                     (= mnemonic-char (-> item
                                          :mnemonic
                                          :char
                                          str
                                          upper-case))))))

(defun wrap-index
  "Wrap an adjacent index around a collection boundary.

  Args:
  - `index`: Candidate adjacent index.
  - `count`: Collection size.

  Returns:
  The wrapped index."
  [index count]
  (cond
    (< index 0) (+ index count)
    (>= index count) (- index count)
    :default index))

(defun move-highlight-index
  "Move a logical highlight across selectable menu items.

  Args:
  - `items`: Normalized menu nodes.
  - `highlighted-index`: Current logical index, or `nil`.
  - `direction`: Step direction, normally `1` or `-1`.

  Returns:
  The next selectable index, preserving the current value when none exist."
  [items highlighted-index direction]
  (let [indices (selectable-indices items)]
    (if (empty? indices)
      highlighted-index
      (let [current-pos (find-index indices (fn [index]
                                              (= index highlighted-index)))
            start-pos (if (or (nil? current-pos)
                              (< current-pos 0))
                        0
                        current-pos)
            next-pos (wrap-index (+ start-pos direction) (count indices))]
        (nth indices next-pos)))))
