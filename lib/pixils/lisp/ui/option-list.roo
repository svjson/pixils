(ns pixils.ui.option-list
  (:require pixils
            pixils.ui.scroll-pane
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.option-item :as option]))



;; Public query functions

(defun values-at-indices
  "Returns the values of the options at indices, omitting missing options."
  [options indices]
  (keep indices
        (fn [index]
          (option/value (nth options index)))))



;; Geometry

(defun content-height [options row-height]
  (* (count options) row-height))

(defun visible-height
  "Calculates the intrinsic height for an option collection and row policy.

  Args:
  - `options`: Option values whose complete rows contribute to the height.
  - `row-height`: Height of one option row.
  - `visible-rows`: Canonical `{:min ... :max ...}` row policy.

  Returns:
  The intrinsic height in pixels."
  [options row-height visible-rows]
  (let [target-rows (max (count options)
                         (or (:min visible-rows) 0))]
    (* row-height
       (if-let [max-rows (:max visible-rows)]
         (min target-rows max-rows)
         target-rows))))

(defun style [ctx]
  (or (-> ctx :view :effective-style)
      (-> ctx :view :style)))

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun item-padding [ctx]
  (ui/theme-var ctx :list-box-item-padding nil))

(defun theme-row-height [ctx]
  (ui/theme-var ctx :list-box-row-height nil))

(defun padding-side [padding side]
  (case side
    :top (or (:top padding) (:t padding) 0)
    :right (or (:right padding) (:r padding) 0)
    :bottom (or (:bottom padding) (:b padding) 0)
    :left (or (:left padding) (:l padding) 0)
    :default 0))

(defun measured-row-height [ctx]
  (let [dim (r/text-size "M" (text-args (style ctx)))
        padding (item-padding ctx)]
    (max (theme-row-height ctx)
         (+ (get dim :h 0)
            (padding-side padding :top)
            (padding-side padding :bottom)))))

(defun option-label-width [item text-opts]
  (or (:w (r/text-size (option/label item) text-opts)) 0))

(defun measured-options-width [state ctx]
  (let [text-opts (text-args (style ctx))
        padding (item-padding ctx)
        label-width (reduce (:options state)
                            0
                            (fn [out item]
                              (max out
                                   (option-label-width item text-opts))))]
    (max 1 (+ label-width
              (padding-side padding :left)
              (padding-side padding :right)))))

(defun row-height [state ctx]
  (or (:row-height state)
      (when ctx (measured-row-height ctx))
      (:computed-row-height state)))

(defun preferred-height [state ctx]
  (visible-height (:options state)
                  (row-height state ctx)
                  (:visible-rows (style ctx))))

(defun content-state [ui-state state]
  (merge (:content-state ui-state)
         (reduce (:item-state-keys ui-state)
                 {}
                 (fn [out key]
                   (merge out {key (get state key)})))
         {:selected-indices (or (:selected-indices ui-state) [])
          :active-index (:active-index ui-state)}))

(defun component-content-size [state ctx]
  (let [state (get-in ctx [:view :ui-state] state)]
    {:w (measured-options-width state ctx)
     :h (preferred-height state ctx)}))

(defun scroll-content-size [state]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state))
        height (if row-height
                 (content-height (:options state) row-height)
                 0)]
    {:h height}))

(defun style-padding-side [style side]
  (get (:padding style) side 0))

(defun style-border-side-thickness [style side]
  (let [border (:border style)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun vertical-content-inset [ctx]
  (let [style (style ctx)]
    (+ (style-padding-side style :top)
       (style-padding-side style :bottom)
       (style-border-side-thickness style :top)
       (style-border-side-thickness style :bottom))))

(defun content-view [ctx]
  (let [scroll-pane (head (ui/children ctx))
        row (when scroll-pane
              (head (ui/children scroll-pane)))
        viewport (when row
                   (head (ui/children row)))]
    (when viewport
      (head (ui/children viewport)))))

(defun visible-content-height [state ctx]
  (if-let [height (-> ctx :view :bounds :h)]
    (case (-> (style ctx) :box-sizing)
      :content-box height
      :default (max 0 (- height (vertical-content-inset ctx))))
    (or (preferred-height state ctx)
        0)))

(defun scroll-offset-for-index [state ctx index]
  (let [row-height (row-height state ctx)
        visible-height (visible-content-height state ctx)
        content-height (content-height (:options state) row-height)
        offset (or (:offset state) {:x 0 :y 0})
        offset-y (or (:y offset) 0)
        row-top (* index row-height)
        row-bottom (+ row-top row-height)
        visible-bottom (+ offset-y visible-height)
        max-offset (max 0 (- content-height visible-height))
        next-y (cond
                 (< row-top offset-y)
                 row-top

                 (> row-bottom visible-bottom)
                 (- row-bottom visible-height)

                 :default
                 offset-y)]
    (assoc offset :y (clamp next-y 0 max-offset))))



;; Items and scrolling

(defun scroll-pane-child [state children]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state))
        content-size (scroll-content-size state)
        item-state-projection (reduce (:item-state-keys state)
                                      {}
                                      (fn [out key]
                                        (assoc out key (ui/project-state key))))]
    (merge {:id "scroll-pane"}
           (pixils.ui.scroll-pane/make
            {:style {:width :fill
                     :height :fill}
             :content-size content-size
             :content-height-explicit? (:explicit-row-height? state)
             :ui-state {:offset (ui/bind-state :offset)
                        :content-size (ui/project-state :scroll-content-size)
                        :content-height-explicit?
                        (ui/project-state :explicit-row-height?)
                        :content-ui-state (ui/project-state :content-state)
                        :step (ui/project-state :computed-row-height)}
             :state {:content-state item-state-projection}
             :scroll-x? false
             :scroll-y? :auto
             :step row-height
             :children children}))))

(defun apply-item-height [child height]
  (if (or (nil? height)
          (contains? (:style child) :height))
    child
    (update child :style
            (fn [style]
              (assoc style :height height)))))

(defun merge-item-state [child item-state]
  (update-in child
             [:state :component]
             (fn [component]
               (merge component item-state))))

(defun resolve-item [item=> index option]
  "Resolves an item provider for an option.

  Functions receive `index` and `option`. A function result is resolved again
  until it produces a component symbol or view declaration."
  (cond
    (fn? item=>)
    (resolve-item (item=> index option) index option)

    :default
    item=>))

(defun item-view [item=> index option]
  "Returns the view declaration provided for an option.

  A component symbol becomes a component declaration. When a declaration does
  not provide ordinary `:state`, the complete option becomes its state."
  (let [provided (resolve-item item=> index option)
        child (case (type-of provided)
                "symbol" {:component provided}
                :default provided)]
    (if (contains? child :state)
      child
      (assoc child :state option))))

(defun make-item-child [{:keys [decorate-item
                                disabled?
                                selected-indices] :as state}
                        index
                        item]
  (let [disabled? (or disabled?
                      (:disabled? item))
        selected? (and (sequential? selected-indices)
                       (contains? selected-indices index))
        item-state {:index index
                    :value (option/value item)
                    :label (option/label item)
                    :disabled? disabled?
                    :selected selected?}
        item-height (or (:computed-row-height state)
                        (:row-height state))
        child (item-view (:item=> state) index item)]
    (let [child (-> child
                    (merge-item-state item-state)
                    (cond-> decorate-item (decorate-item state index item))
                    (apply-item-height item-height)
                    (update :style (fn [style] (assoc style :width :fill))))
          item-ui-state (-> (get-in child [:state :component])
                            (dissoc :selected)
                            (dissoc :selected-indices))
          projected-ui-state (reduce-kv item-ui-state
                                        (or (:ui-state child) {})
                                        (fn [out key value]
                                          (assoc out
                                                 key
                                                 (ui/project-state :content-ui-state
                                                                   :items
                                                                   index
                                                                   key))))]
      (assoc child
             :id (or (:id child) (:id item) (str "option-"
                                                 index
                                                 "-"
                                                 (or (:component child) (:mode child))))
             :ui-state (assoc projected-ui-state
                              :selected-indices (ui/project-state :content-ui-state
                                                                  :selected-indices)
                              :active-index (ui/project-state :content-ui-state
                                                              :active-index))))))

(defun item-children [state]
  (for-indexed [index item (:options state)]
    (make-item-child state index item)))

(defun render-key [state]
  (merge (select-keys state
                      [:options
                       :row-height
                       :computed-row-height
                       :disabled?
                       :item=>
                       :decorate-item])
         (select-keys state (:render-state-keys state))))

(defun scroll-pane-for-state [state]
  (scroll-pane-child state (item-children state)))

(defun sync-retained-item-styles! [content children]
  (let [styles (reduce children
                       {}
                       (fn [out child]
                         (assoc out (:id child) (:style child))))]
    (doseq [child (ui/children content)]
      (when-let [style (get styles (:id child))]
        (ui/style! child style)))))

(defun sync-layout [state ctx]
  (let [computed-row-height (if (:auto-row-height? state)
                              (measured-row-height ctx)
                              (:row-height state))
        state (assoc state :computed-row-height computed-row-height)]
    (assoc state :scroll-content-size (scroll-content-size state))))

(defun sync-rendered-items-in [state content]
  (let [render-key (render-key state)]
    (if (= render-key (:rendered-render-key state))
      state
      (let [children (item-children state)
            state (update state
                          :content-state
                          (fn [content-state]
                            (assoc content-state
                                   :items
                                   (for [child children]
                                     (-> (get-in child [:state :component])
                                         (dissoc :selected)
                                         (dissoc :selected-indices))))))]
        (when content
          (sync-retained-item-styles! content children)
          (ui/reconcile-children! content children))
        (assoc state :rendered-render-key render-key)))))

(defun sync-rendered-items [state ctx]
  (sync-rendered-items-in state (content-view ctx)))

(defun sync-ui [ui-state state ctx]
  (-> ui-state
      (assoc :content-state (content-state ui-state state)
             :scroll-y? :auto)
      (sync-layout ctx)
      (sync-rendered-items ctx)))



;; Component

(def OPTION-LIST-UI-STATE-KEYS
  [:options
   :item-state-keys
   :row-height
   :explicit-row-height?
   :computed-row-height
   :auto-row-height?
   :disabled?
   :item=>
   :decorate-item
   :render-state-keys
   :selected-indices
   :active-index
   :content-state
   :offset
   :scroll-y?
   :scroll-content-size
   :rendered-render-key])

(defcomponent ui/option-list
  {:class :ui/option-list
   :ui/state-keys OPTION-LIST-UI-STATE-KEYS
   :content-size component-content-size
   :init-ui sync-ui
   :update-ui sync-ui
   :after-layout-ui (fn [ui-state state ctx]
                      (-> ui-state
                          (sync-layout ctx)
                          (sync-rendered-items ctx)))})



;; Make function

(defun component-state
  "Returns normalized component state for an option-list-based control.

  `opts` accepts the option-list constructor fields, ordinary application
  `:state`, and explicit `:state :component` values. Derived controls can merge
  their own policy fields into the returned map before constructing children."
  [{:keys [state] :as opts}]
  (let [supplied-component (merge (select-keys state OPTION-LIST-UI-STATE-KEYS)
                                   (:component state)
                                   (select-keys opts OPTION-LIST-UI-STATE-KEYS))
        component (merge supplied-component
                         {:options (or (:options supplied-component) [])
                          :explicit-row-height? (some? (:row-height supplied-component))
                          :computed-row-height (:row-height supplied-component)
                          :auto-row-height?
                          (if (contains? supplied-component :auto-row-height?)
                            (:auto-row-height? supplied-component)
                            (nil? (:row-height supplied-component)))})]
    (assoc component
           :scroll-content-size
           (scroll-content-size component))))

(defun make
  "Builds a neutral, scrollable ui/option-list component. Item interaction is
  emitted by ui/option-item; selection policy belongs to the parent control."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [component (component-state opts)
        component (update component :item=> [or 'ui/option-item])]
    (cond-> {:mode 'ui/option-list
             :state (assoc state :component component)
             :children [(scroll-pane-for-state component)]}
            (contains? opts :style) (assoc :style style)
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state)
            state-policy (assoc :ui/state-policy state-policy))))
