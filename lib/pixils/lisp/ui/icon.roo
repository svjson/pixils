(ns pixils.ui.icon
  (:require pixils
            [pixils.ui :as ui]))



;; Generic icon behavior

(defun icon-item [state]
  (:item state))

(defun icon-position [state]
  (or (:position state)
      (:position (icon-item state))))

(defun icon-hidden? [state]
  (nil? (icon-item state)))

(defcomponent ui/icon
  {:focusable true
   :update (fn [state ctx]
             (do
               (ui/style! (:view ctx)
                          {:hidden (icon-hidden? state)})
               state))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/emit! (:view ctx)
                                :ui/icon-select
                                (icon-item state))
                      state))
   :on-click (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx)
                           :ui/icon-activate
                           (icon-item state))
                 state))})

(defcomponent ui/icon-preview
  {:style {:position :absolute
           :hit-test false}
   :update (fn [state ctx]
             (let [pos (icon-position state)]
               (do
                 (when pos
                   (ui/style! (:view ctx)
                              {:position :absolute
                               :left (:x pos)
                               :top (:y pos)}))
                 (ui/style! (:view ctx)
                            {:hidden (icon-hidden? state)})
                 state)))})



;; Desktop icon: a focusable/selectable icon with a label underneath.

(def desktop-icon-default-image-size 64)

(defun desktop-icon-label [state]
  (or (:label (icon-item state))
      (:title (icon-item state))
      (:name (icon-item state))
      (:label state)
      ""))

(defun desktop-icon-image [state]
  (or (:image (icon-item state))
      (:image state)))

(defun desktop-icon-selected? [state]
  (or (= (:selected? state) true)
      (and (not (nil? (:selected-id state)))
           (not (nil? (:id (icon-item state))))
           (= (:id (icon-item state))
              (:selected-id state)))))

(defun update-desktop-icon! [state ctx]
  (let [pos (icon-position state)
        next-state (assoc state
                          :label (desktop-icon-label state)
                          :image (desktop-icon-image state)
                          :selected (desktop-icon-selected? state))]
    (do
      (when pos
        (ui/style! (:view ctx)
                   {:position :absolute
                    :left (:x pos)
                    :top (:y pos)}))
      (ui/style! (:view ctx)
                 {:hidden (icon-hidden? state)})
      next-state)))

(defcomponent ui/desktop-icon-image
  {:class :ui/desktop-icon-image
   :style {:width desktop-icon-default-image-size
           :height desktop-icon-default-image-size
           :background {:fit :contain
                        :align :center}}
   :update (fn [state ctx]
             (do
               (if (keyword? (:image state))
                 (ui/style! (:view ctx)
                            {:background {:image (:image state)
                                          :fit :contain
                                          :align :center}
                             :hidden false})
                 (ui/style! (:view ctx)
                            {:background nil
                             :hidden true}))
               (ui/style! (:view ctx)
                          {:opacity (if (:dragging? state) 0.4 1.0)})
               state))})

(defcomponent ui/desktop-icon-label
  {:class :ui/desktop-icon-label
   :style {:width :fill
           :margin {:t 6}
           :padding {:l 3 :r 3}
           :layout {:align-items :center}
           :text {:align :center}}
   :update (fn [state ctx]
             (assoc state :selected (= (:selected state) true)))
   :children [{:class :ui/desktop-icon-label-box
               :style {:width :shrink
                       :layout {:align-items :center}
                       :text {:align :center}}
               :state {:value (ui/bind-state :label)
                       :selected (ui/bind-state :selected)}
               :update (fn [state ctx]
                         (assoc state :selected (= (:selected state) true)))
               :children [{:mode 'ui/text
                           :class :ui/desktop-icon-label-text
                           :style {:text {:align :center}}
                           :state {:value (ui/bind-state :value)}}]}]})

(defun desktop-icon-image-child [style]
  {:mode 'ui/desktop-icon-image
   :style (or style {})
   :state {:image (ui/bind-state :image)
           :dragging? (ui/bind-state :dragging?)}})

(defun desktop-icon-label-child [style]
  {:mode 'ui/desktop-icon-label
   :style (or style {})
   :state {:label (ui/bind-state :label)
           :selected (ui/bind-state :selected)}})

(defun desktop-icon-children [opts]
  [(or (:image-child opts)
       (desktop-icon-image-child (:image-style opts)))
   (or (:label-child opts)
       (desktop-icon-label-child (:label-style opts)))])

(defcomponent ui/desktop-icon
  {:extend 'ui/icon
   :class :ui/desktop-icon
   :style {:width :shrink
           :height :shrink
           :padding 6
           :layout {:align-items :center}}
   :update update-desktop-icon!
   :children (desktop-icon-children {})})

(defcomponent ui/desktop-icon-preview
  {:extend 'ui/icon-preview
   :class :ui/desktop-icon-preview
   :style {:width :shrink
           :height :shrink
           :padding 6
           :layout {:align-items :center}
           :hit-test false}
   :update update-desktop-icon!
   :children (desktop-icon-children {})})
