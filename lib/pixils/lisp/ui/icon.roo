(ns pixils.ui.icon
  (:require pixils
            [pixils.ui :as ui]))



;; Generic icon behavior

(defun icon-item [state]
  (:item state))

(defun icon-position [state]
  (or (:position state)
      (:position (icon-item state))))

(defun icon-hidden? [state]
  (nil? (icon-item state)))

(defun position-style-matches? [view pos]
  (let [style (:style view)]
    (and (= (:position style) :absolute)
         (= (:left style) (:x pos))
         (= (:top style) (:y pos)))))

(defun hidden-style-matches? [view hidden?]
  (= (-> view :style :visibility)
     (if hidden? :none :visible)))

(defcomponent ui/icon
  {:focusable true
   :update (fn [state ctx]
             (let [view (:view ctx)
                   hidden? (icon-hidden? state)]
               (unless (hidden-style-matches? view hidden?)
                 (ui/style! view {:hidden hidden?}))
               state))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/emit! (:view ctx)
                                :ui/icon-select
                                (icon-item state))
                      state))
   :on-click (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx)
                           :ui/icon-activate
                           (icon-item state))
                 state))})

(defcomponent ui/icon-preview
  {:style {:position :absolute
           :hit-test false}
   :update (fn [state ctx]
             (let [view (:view ctx)
                   pos (icon-position state)
                   hidden? (icon-hidden? state)]
               (when (and pos
                          (not (position-style-matches? view pos)))
                 (ui/style! view
                            {:position :absolute
                             :left (:x pos)
                             :top (:y pos)}))
               (unless (hidden-style-matches? view hidden?)
                 (ui/style! view {:hidden hidden?}))
               state))})
