(ns pixils.ui.text-input
  (:require pixils
            [pixils.clipboard :as clipboard]
            [pixils.color :as c]
            [pixils.keyboard :as kbd]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.internal.interaction :as k]))



;; Component state

(def TEXT-INPUT-UI-STATE-KEYS
  "Component-state keys owned by `ui/text-input`."
  [:value
   :text-value
   :disabled?
   :read-only?
   :auto-focus?
   :accept-value?
   :emit-change?
   :emit-blur?])

(def TEXT-INPUT-INNER-UI-STATE-KEYS
  "Component-state keys owned by the inner text editor."
  [:value
   :disabled?
   :read-only?
   :auto-focus?
   :cursor-index
   :selection-anchor
   :selection-start
   :selection-end
   :scroll-x
   :caret-x
   :cursor-y
   :cursor-h
   :selection-x
   :selection-w
   :show-caret?
   :focused?])

(def TEXT-INPUT-CARET-UI-STATE-KEYS
  "Component-state keys used to position and display the text-input caret."
  [:x :y :h :visible?])



;; Text editing

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun style-padding-side [style side]
  (get (:padding style) side 0))

(defun style-border-side-thickness [style side]
  (let [border (:border style)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun style-content-height [bounds style]
  (max 0
       (- (or (:h bounds) 0)
          (style-padding-side style :top)
          (style-padding-side style :bottom)
          (style-border-side-thickness style :top)
          (style-border-side-thickness style :bottom))))

(defun style-content-width [bounds style]
  (max 0
       (- (or (:w bounds) 0)
          (style-padding-side style :left)
          (style-padding-side style :right)
          (style-border-side-thickness style :left)
          (style-border-side-thickness style :right))))

(defun style-content-left [style]
  (+ (style-border-side-thickness style :left)
     (style-padding-side style :left)))

(defun insert-text-at [value cursor-index text]
  (str (substr value 0 cursor-index)
       text
       (substr value cursor-index)))

(defun remove-char-before [value cursor-index]
  (str (substr value 0 (dec cursor-index))
       (substr value cursor-index)))

(defun remove-char-after [value cursor-index]
  (str (substr value 0 cursor-index)
       (substr value (inc cursor-index))))

(defun remove-text-range [value start-index end-index]
  (str (substr value 0 start-index)
       (substr value end-index)))

(defun replace-text-range [value start-index end-index text]
  (str (substr value 0 start-index)
       text
       (substr value end-index)))

(defun text-input-accepts-value? [state value]
  (if-let [accept-value? (:accept-value? state)]
    (apply accept-value? [value state])
    true))

(defun text-input-change [state value cursor-index]
  (if (:read-only? state)
    state
    (-> state
        (assoc :value value)
        (assoc :cursor-index cursor-index)
        (assoc :selection-anchor nil)
        (assoc :selection-start nil)
        (assoc :selection-end nil))))

(defun text-input-has-selection? [state]
  (and (number? (:selection-start state))
       (number? (:selection-end state))
       (< (:selection-start state) (:selection-end state))))

(defun selection-anchor-index [state cursor-index]
  (if (nil? (:selection-anchor state))
    (if (nil? (:cursor-index state))
      cursor-index
      (:cursor-index state))
    (:selection-anchor state)))

(defun text-input-select-to [state cursor-index]
  (let [anchor (selection-anchor-index state cursor-index)
        start (min anchor cursor-index)
        end (max anchor cursor-index)]
    (if (= start end)
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor nil)
          (assoc :selection-start nil)
          (assoc :selection-end nil))
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor anchor)
          (assoc :selection-start start)
          (assoc :selection-end end)))))

(defun text-input-move-cursor [state cursor-index extend?]
  (let [cursor-index (clamp cursor-index 0 (count (:value state)))]
    (if extend?
      (text-input-select-to state cursor-index)
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor nil)
          (assoc :selection-start nil)
          (assoc :selection-end nil)))))

(defun text-input-place-cursor-for-drag [state cursor-index]
  (let [cursor-index (clamp cursor-index 0 (count (:value state)))]
    (-> state
        (assoc :cursor-index cursor-index)
        (assoc :selection-anchor cursor-index)
        (assoc :selection-start nil)
        (assoc :selection-end nil))))

(defun text-input-collapse-left [state]
  (if (text-input-has-selection? state)
    (:selection-start state)
    (dec (:cursor-index state))))

(defun text-input-collapse-right [state]
  (if (text-input-has-selection? state)
    (:selection-end state)
    (+ (:cursor-index state) 1)))

(defun text-input-delete-selection
  [{:keys [value selection-start selection-end] :as state}]
  (text-input-change state
                     (remove-text-range value selection-start selection-end)
                     selection-start))

(defun text-input-insert-text [state text]
  (let [value (:value state)
        cursor-index (:cursor-index state)]
    (if (text-input-has-selection? state)
      (let [start (:selection-start state)]
        (text-input-change state
                           (replace-text-range value
                                               start
                                               (:selection-end state)
                                               text)
                           (+ start (count text))))
      (text-input-change state
                         (insert-text-at value cursor-index text)
                         (+ cursor-index (count text))))))

(defun text-input-selected-text [state]
  (if (text-input-has-selection? state)
    (substr (:value state)
            (:selection-start state)
            (:selection-end state))
    ""))

(defun text-input-select-all [state]
  (let [value (or (:value state) "")
        end (count value)]
    (if (> end 0)
      (-> state
          (assoc :cursor-index end)
          (assoc :selection-anchor 0)
          (assoc :selection-start 0)
          (assoc :selection-end end))
      (text-input-move-cursor state 0 false))))

(defun text-input-shift? [event ctx]
  (or (k/held-shift? event)
      (k/held-shift? ctx)))

(defun text-input-ctrl? [event ctx]
  (or (k/held-ctrl? event)
      (k/held-ctrl? ctx)))

(defun key-matches? [event upper-key lower-key]
  (or (= upper-key (:key event))
      (= lower-key (:key event))))

(defun text-input-handle-shortcut [state event]
  (cond
    (key-matches? event :key/A :key/a)
    (text-input-select-all state)

    (key-matches? event :key/C :key/c)
    (do
      (when (text-input-has-selection? state)
        (clipboard/set-text! (text-input-selected-text state)))
      state)

    (key-matches? event :key/X :key/x)
    (cond
      (or (:read-only? state)
          (not (text-input-has-selection? state))) state
      (clipboard/set-text! (text-input-selected-text state))
      (text-input-delete-selection state)
      :default state)

    (key-matches? event :key/V :key/v)
    (if (:read-only? state)
      state
      (let [text (clipboard/get-text)]
        (cond-> state
          (not-empty? text) (text-input-insert-text text))))

    :default nil))

(defun text-input-key-transition [state event ctx]
  (let [value (:value state)
        cursor-index (:cursor-index state)
        extend? (text-input-shift? event ctx)]
    (if-let [shortcut-state (when (text-input-ctrl? event ctx)
                              (text-input-handle-shortcut state event))]
      shortcut-state
      (cond
        (= :key/backspace (:key event))
        (cond
          (text-input-has-selection? state)
          (text-input-delete-selection state)

          (> cursor-index 0)
          (text-input-change state
                             (remove-char-before value cursor-index)
                             (dec cursor-index))

          :default state)

        (= :key/delete (:key event))
        (cond
          (text-input-has-selection? state)
          (text-input-delete-selection state)

          (< cursor-index (count value))
          (text-input-change state
                             (remove-char-after value cursor-index)
                             cursor-index)

          :default state)

        (= :key/left (:key event))
        (text-input-move-cursor state
                                (if extend?
                                  (dec cursor-index)
                                  (text-input-collapse-left state))
                                extend?)

        (= :key/right (:key event))
        (text-input-move-cursor state
                                (if extend?
                                  (+ cursor-index 1)
                                  (text-input-collapse-right state))
                                extend?)

        (= :key/home (:key event))
        (text-input-move-cursor state 0 extend?)

        (= :key/end (:key event))
        (text-input-move-cursor state (count value) extend?)

        :default
        (if-let [text (kbd/event->text event)]
          (text-input-insert-text state text)
          state)))))

(defun measure-text-width [value text-opts]
  (or (:w (r/text-size value text-opts)) 0))

(defun text-input-content-size [_state ctx]
  (let [style (-> ctx :view :effective-style)
        text-opts (text-args style)
        value (or (-> ctx :view :ui-state :text-value) "")
        text-dim (r/text-size (if (not-empty? value) value "M") text-opts)
        line-dim (r/text-size "M" text-opts)]
    {:w (max 1 (or (:w text-dim) 0))
     :h (max 1 (or (:h line-dim) 0))}))

(defun text-index-at-x-loop [value text-opts target-x index previous-width]
  (if (>= index (count value))
    (count value)
    (let [next-index (+ index 1)
          next-width (measure-text-width (substr value 0 next-index)
                                         text-opts)
          midpoint (/ (+ previous-width next-width) 2)]
      (if (< target-x midpoint)
        index
        (text-index-at-x-loop value text-opts target-x next-index next-width)))))

(defun text-index-at-x [value local-x scroll-x style]
  (let [text-opts (text-args style)
        target-x (max 0 (+ (- (or local-x 0)
                              (style-content-left style))
                           (or scroll-x 0)))]
    (text-index-at-x-loop value text-opts target-x 0 0)))

(defun text-index-at-event [state event ctx]
  (text-index-at-x (or (:value state) "")
                   (-> event :position :x)
                   (:scroll-x state)
                   (-> ctx :view :effective-style)))

(defun text-input-mouse-move-cursor [state event ctx extend?]
  (let [cursor-index (text-index-at-event state event ctx)]
    (if extend?
      (text-input-move-cursor state cursor-index true)
      (text-input-place-cursor-for-drag state cursor-index))))

(defun clamp-scroll-x [scroll-x text-width content-width]
  (clamp (or scroll-x 0)
         0
         (max 0 (- (or text-width 0) (or content-width 0)))))

(defun scroll-x-for-cursor [scroll-x cursor-x text-width content-width]
  (let [content-width (or content-width 0)
        caret-width 1
        scrollable-width (+ (or text-width 0) caret-width)
        scroll-x (clamp-scroll-x scroll-x scrollable-width content-width)
        cursor-right (+ cursor-x caret-width)]
    (cond
      (<= content-width 0) 0
      (< cursor-x scroll-x) (clamp-scroll-x cursor-x scrollable-width content-width)
      (> cursor-right (+ scroll-x content-width))
      (clamp-scroll-x (- cursor-right content-width) scrollable-width content-width)
      :default scroll-x)))

(defun text-input-style-matches? [view style]
  (and (if (contains? style :position)
         (= (-> view :style :position) (:position style))
         true)
       (if (contains? style :left)
         (= (-> view :style :left) (:left style))
         true)
       (if (contains? style :top)
         (= (-> view :style :top) (:top style))
         true)
       (if (contains? style :height)
         (= (-> view :style :height) (:height style))
         true)
       (if (contains? style :visibility)
         (= (-> view :style :visibility) (:visibility style))
         true)))

(defun text-input-style-if-changed! [view style]
  (unless (text-input-style-matches? view style)
    (ui/style! view style)))

(defun text-input-sync-caret-style! [state ctx]
  (text-input-style-if-changed! (:view ctx)
                                {:position :absolute
                                 :left (or (:x state) 0)
                                 :top (or (:y state) 0)
                                 :height (or (:h state) 0)
                                 :visibility (if (:visible? state)
                                               :visible
                                               :none)}))

(defun sync-text-input-state* [state ctx emit-blur?]
  (let [value (or (:value state) "")
        style (-> ctx :view :effective-style)
        text-opts (text-args style)
        cursor-index (clamp (if (nil? (:cursor-index state))
                              (count value)
                              (:cursor-index state))
                            0
                            (count value))
        selection-anchor (unless (nil? (:selection-anchor state))
                           (clamp (:selection-anchor state) 0 (count value)))
        selection-start (unless (nil? selection-anchor)
                          (let [start (min selection-anchor cursor-index)
                                end (max selection-anchor cursor-index)]
                            (when (< start end) start)))
        selection-end (unless (nil? selection-anchor)
                        (let [start (min selection-anchor cursor-index)
                              end (max selection-anchor cursor-index)]
                          (when (< start end) end)))
        prefix (substr value 0 cursor-index)
        text-width (measure-text-width value text-opts)
        cursor-x (measure-text-width prefix text-opts)
        cursor-h (or (:h (r/text-size "M" text-opts)) 0)
        content-width (style-content-width (-> ctx :view :bounds)
                                           style)
        scroll-x (scroll-x-for-cursor (:scroll-x state)
                                      cursor-x
                                      text-width
                                      content-width)
        cursor-y (max 0
                      (int (/ (- (style-content-height
                                  (-> ctx :view :bounds)
                                  style)
                                cursor-h)
                             2)))
        show-caret? (and (not (:disabled? state))
                         (or (-> ctx :view :interaction :focused)
                             (-> ctx :view :interaction :focus-within)))
        selection-prefix-width (measure-text-width
                                 (substr value
                                         0
                                         (or selection-start 0))
                                 text-opts)
        selection-end-width (measure-text-width
                              (substr value
                                      0
                                      (or selection-end 0))
                              text-opts)
        selection-left (- selection-prefix-width scroll-x)
        selection-right (- selection-end-width scroll-x)
        selection-x (max 0 selection-left)
        selection-w (max 0 (- (min content-width selection-right)
                              selection-x))]
    (when (and emit-blur?
               (:focused? state)
               (not show-caret?))
      (ui/emit! (:view ctx) :text-input-inner/blur {:value value}))
    (-> state
        (assoc :value value)
        (assoc :cursor-index cursor-index)
        (assoc :selection-anchor selection-anchor)
        (assoc :selection-start selection-start)
        (assoc :selection-end selection-end)
        (assoc :scroll-x scroll-x)
        (assoc :caret-x (- cursor-x scroll-x))
        (assoc :cursor-y cursor-y)
        (assoc :cursor-h cursor-h)
        (assoc :selection-x selection-x)
        (assoc :selection-w selection-w)
        (assoc :show-caret? show-caret?)
        (assoc :focused? show-caret?))))



;; Components

(defcomponent ui/text-input-caret
  {:style {:width 1}
   :ui/state-keys TEXT-INPUT-CARET-UI-STATE-KEYS
   :init-ui (fn [ui-state _state ctx]
              (text-input-sync-caret-style! ui-state ctx)
              ui-state)
   :update-ui (fn [ui-state _state ctx]
                (text-input-sync-caret-style! ui-state ctx)
                ui-state)
   :render (fn [_state ctx]
             (let [ui-state (-> ctx :view :ui-state)]
               (r/rect! {:x 0
                         :y 0
                         :w 1
                         :h (or (:h ui-state)
                                (-> ctx :view :bounds :h)
                                0)}
                        {:fill true
                         :color (or (-> ctx :view :effective-style :background)
                                    (-> ctx :view :effective-style :text :color)
                                    c/BLACK)})))})

(defcomponent ui/text-input-inner
  {:focusable true
   :drag {:button :left
          :start :motion}
   :style {:width :fill
           :height :fill
           :clip true}
   :ui/state-keys TEXT-INPUT-INNER-UI-STATE-KEYS
   :init-ui (fn [ui-state _state ctx]
              (let [value (or (:value ui-state) "")]
                (when (and (:auto-focus? ui-state)
                           (not (:disabled? ui-state)))
                  (ui/focus! ctx))
                (-> ui-state
                    (assoc :value value)
                    (assoc :cursor-index (if (nil? (:cursor-index ui-state))
                                           (count value)
                                           (:cursor-index ui-state))))))
   :update-ui (fn [ui-state _state ctx]
                (sync-text-input-state* ui-state ctx true))
   :after-layout-ui (fn [ui-state _state ctx]
                      (sync-text-input-state* ui-state ctx true))
   :render (fn [_state ctx]
             (let [ui-state (-> ctx :view :ui-state)
                   style (-> ctx :view :effective-style)]
               (when (> (or (:selection-w ui-state) 0) 0)
                 (r/rect! {:x (or (:selection-x ui-state) 0)
                           :y (or (:cursor-y ui-state) 0)
                           :w (or (:selection-w ui-state) 0)
                           :h (or (:cursor-h ui-state) 0)}
                          {:fill true
                           :color (ui/theme-var ctx :selection-bg c/BLACK)}))
               (r/text! (or (:value ui-state) "")
                        {:x (* -1 (or (:scroll-x ui-state) 0))
                         :y (or (:cursor-y ui-state) 0)}
                        (text-args style))))
   :children [{:mode 'ui/text-input-caret
               :ui/state-policy :isolated
               :ui-state {:x (ui/project-state :caret-x)
                          :y (ui/project-state :cursor-y)
                          :h (ui/project-state :cursor-h)
                          :visible? (ui/project-state :show-caret?)}}]
   :on-key-down (fn [state event ctx]
                  (let [ui-state (-> ctx :view :ui-state)]
                    (unless (:disabled? ui-state)
                      (let [next-ui-state (text-input-key-transition ui-state
                                                                     event
                                                                     ctx)]
                        (unless (= ui-state next-ui-state)
                          (ui/set-ui-state! ctx next-ui-state)
                          (when (not= (:value ui-state)
                                      (:value next-ui-state))
                            (ui/emit! (:view ctx)
                                      :text-input-inner/change
                                      {:value (:value next-ui-state)})))))
                    state))
   :on-mouse-down (fn [state event ctx]
                    (let [ui-state (-> ctx :view :ui-state)]
                      (unless (:disabled? ui-state)
                        (ui/stop-propagation! event)
                        (ui/focus! ctx)
                        (ui/set-ui-state!
                         ctx
                         (text-input-mouse-move-cursor
                          ui-state
                          event
                          ctx
                          (text-input-shift? event ctx))))
                      state))
   :on-drag-start (fn [state event ctx]
                    (let [ui-state (-> ctx :view :ui-state)]
                      (unless (:disabled? ui-state)
                        (ui/set-ui-state! ctx
                                          (text-input-mouse-move-cursor ui-state
                                                                        event
                                                                        ctx
                                                                        true)))
                      state))
   :on-drag (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)]
                (unless (:disabled? ui-state)
                  (ui/set-ui-state! ctx
                                    (text-input-mouse-move-cursor ui-state
                                                                  event
                                                                  ctx
                                                                  true)))
                state))})

(defcomponent ui/text-input
  {:content-size text-input-content-size
   :ui/state-keys TEXT-INPUT-UI-STATE-KEYS
   :init-ui (fn [ui-state _state _ctx]
              (let [value (or (:value ui-state) "")]
                (assoc ui-state :value value :text-value value)))
   :update-ui (fn [ui-state _state _ctx]
                (assoc ui-state :text-value (or (:value ui-state) "")))
   :children [{:mode 'ui/text-input-inner
               :ui/state-policy :isolated
               :ui-state {:value (ui/project-state :text-value)
                          :disabled? (ui/project-state :disabled?)
                          :read-only? (ui/project-state :read-only?)
                          :auto-focus? (ui/project-state :auto-focus?)}}]
   :on {:text-input-inner/change
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                value (-> event :payload :value)]
            (if (text-input-accepts-value? ui-state value)
              (do
                (ui/set-ui-state! ctx (assoc ui-state
                                             :value value
                                             :text-value value))
                (when (not= (:emit-change? ui-state) false)
                  (ui/emit! (:view ctx) :text-input/change {:value value})))
              (ui/stop-propagation! event))
            state))
        :text-input-inner/blur
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)]
            (when (not= (:emit-blur? ui-state) false)
              (ui/emit! (:view ctx)
                        :text-input/blur
                        {:value (:value ui-state)}))
            state))}})
