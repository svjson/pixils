(ns pixils.ui.text-input
  (:require pixils
            [pixils.clipboard :as clipboard]
            [pixils.color :as c]
            [pixils.keyboard :as kbd]
            [pixils.render :as r]
            [pixils.ui :as ui]))

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun style-padding-side [style side]
  (or (get (:padding style) side) 0))

(defun style-border-side-thickness [style side]
  (let [border (:border style)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun style-content-height [bounds style]
  (max 0
       (- (or (:h bounds) 0)
          (style-padding-side style :top)
          (style-padding-side style :bottom)
          (style-border-side-thickness style :top)
          (style-border-side-thickness style :bottom))))

(defun style-content-width [bounds style]
  (max 0
       (- (or (:w bounds) 0)
          (style-padding-side style :left)
          (style-padding-side style :right)
          (style-border-side-thickness style :left)
          (style-border-side-thickness style :right))))

(defun style-content-left [style]
  (+ (style-border-side-thickness style :left)
     (style-padding-side style :left)))

(defun insert-text-at [value cursor-index text]
  (str (substr value 0 cursor-index)
       text
       (substr value cursor-index)))

(defun remove-char-before [value cursor-index]
  (str (substr value 0 (dec cursor-index))
       (substr value cursor-index)))

(defun remove-char-after [value cursor-index]
  (str (substr value 0 cursor-index)
       (substr value (inc cursor-index))))

(defun remove-text-range [value start-index end-index]
  (str (substr value 0 start-index)
       (substr value end-index)))

(defun replace-text-range [value start-index end-index text]
  (str (substr value 0 start-index)
       text
       (substr value end-index)))

(defun text-input-accepts-value? [state value]
  (if-let [accept-value? (:accept-value? state)]
    (apply accept-value? [value state])
    true))

(defun text-input-read-only? [state]
  (= (:read-only? state) true))

(defun value-or [value fallback]
  (if (nil? value) fallback value))

(defun text-input-change [state value cursor-index ctx]
  (if (and (not (text-input-read-only? state))
           (text-input-accepts-value? state value))
    (do
      (when (not= (:emit-change? state) false)
        (ui/emit! (:view ctx) :text-input/change {:value value}))
      (-> state
          (assoc :value value)
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor nil)
          (assoc :selection-start nil)
          (assoc :selection-end nil)))
    state))

(defun text-input-has-selection? [state]
  (and (not (nil? (:selection-start state)))
       (not (nil? (:selection-end state)))
       (< (:selection-start state) (:selection-end state))))

(defun selection-anchor-index [state cursor-index]
  (value-or (:selection-anchor state)
            (value-or (:cursor-index state) cursor-index)))

(defun text-input-select-to [state cursor-index]
  (let [anchor (selection-anchor-index state cursor-index)
        start (min anchor cursor-index)
        end (max anchor cursor-index)]
    (if (= start end)
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor nil)
          (assoc :selection-start nil)
          (assoc :selection-end nil))
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor anchor)
          (assoc :selection-start start)
          (assoc :selection-end end)))))

(defun text-input-move-cursor [state cursor-index extend?]
  (let [cursor-index (max 0 (min (count (:value state)) cursor-index))]
    (if extend?
      (text-input-select-to state cursor-index)
      (-> state
          (assoc :cursor-index cursor-index)
          (assoc :selection-anchor nil)
          (assoc :selection-start nil)
          (assoc :selection-end nil)))))

(defun text-input-place-cursor-for-drag [state cursor-index]
  (let [cursor-index (max 0 (min (count (:value state)) cursor-index))]
    (-> state
        (assoc :cursor-index cursor-index)
        (assoc :selection-anchor cursor-index)
        (assoc :selection-start nil)
        (assoc :selection-end nil))))

(defun text-input-collapse-left [state]
  (if (text-input-has-selection? state)
    (:selection-start state)
    (dec (:cursor-index state))))

(defun text-input-collapse-right [state]
  (if (text-input-has-selection? state)
    (:selection-end state)
    (+ (:cursor-index state) 1)))

(defun text-input-delete-selection [state ctx]
  (let [value (:value state)
        start (:selection-start state)
        end (:selection-end state)]
    (text-input-change state
                       (remove-text-range value start end)
                       start
                       ctx)))

(defun text-input-insert-text [state text ctx]
  (let [value (:value state)
        cursor-index (:cursor-index state)]
    (if (text-input-has-selection? state)
      (let [start (:selection-start state)
            end (:selection-end state)]
        (text-input-change state
                           (replace-text-range value start end text)
                           (+ start (count text))
                           ctx))
      (text-input-change state
                         (insert-text-at value cursor-index text)
                         (+ cursor-index (count text))
                         ctx))))

(defun text-input-selected-text [state]
  (if (text-input-has-selection? state)
    (substr (:value state)
            (:selection-start state)
            (:selection-end state))
    ""))

(defun text-input-select-all [state]
  (let [value (or (:value state) "")
        end (count value)]
    (if (> end 0)
      (-> state
          (assoc :cursor-index end)
          (assoc :selection-anchor 0)
          (assoc :selection-start 0)
          (assoc :selection-end end))
      (text-input-move-cursor state 0 false))))

(defun held-shift? [held-keys]
  (or (contains? (or held-keys []) :key/shift)
      (contains? (or held-keys []) :key/left-shift)
      (contains? (or held-keys []) :key/right-shift)))

(defun held-ctrl? [held-keys]
  (or (contains? (or held-keys []) :key/ctrl)
      (contains? (or held-keys []) :key/left-ctrl)
      (contains? (or held-keys []) :key/right-ctrl)))

(defun text-input-shift? [event ctx]
  (or (held-shift? (:held-keys event))
      (held-shift? (:held-keys ctx))))

(defun text-input-ctrl? [event ctx]
  (or (held-ctrl? (:held-keys event))
      (held-ctrl? (:held-keys ctx))))

(defun key-matches? [event upper-key lower-key]
  (or (= upper-key (:key event))
      (= lower-key (:key event))))

(defun text-input-handle-shortcut [state event ctx]
  (cond
    (key-matches? event :key/A :key/a)
    (text-input-select-all state)

    (key-matches? event :key/C :key/c)
    (do
      (when (text-input-has-selection? state)
        (clipboard/set-text! (text-input-selected-text state)))
      state)

    (key-matches? event :key/X :key/x)
    (if (or (text-input-read-only? state)
            (not (text-input-has-selection? state)))
      state
      (do
        (clipboard/set-text! (text-input-selected-text state))
        (text-input-delete-selection state ctx)))

    (key-matches? event :key/V :key/v)
    (if (text-input-read-only? state)
      state
      (let [text (clipboard/get-text)]
        (if (> (count text) 0)
          (text-input-insert-text state text ctx)
          state)))

    :default nil))

(defun measure-text-width [value text-opts]
  (or (:w (r/text-size value text-opts)) 0))

(defun text-input-content-size [state ctx]
  (let [style (-> ctx :view :effective-style)
        text-opts (text-args style)
        value (or (:value state) "")
        text-dim (r/text-size (if (> (count value) 0) value "M") text-opts)
        line-dim (r/text-size "M" text-opts)]
    {:w (max 1 (or (:w text-dim) 0))
     :h (max 1 (or (:h line-dim) 0))}))

(defun text-index-at-x-loop [value text-opts target-x index previous-width]
  (if (>= index (count value))
    (count value)
    (let [next-index (+ index 1)
          next-width (measure-text-width (substr value 0 next-index)
                                         text-opts)
          midpoint (/ (+ previous-width next-width) 2)]
      (if (< target-x midpoint)
        index
        (text-index-at-x-loop value text-opts target-x next-index next-width)))))

(defun text-index-at-x [value local-x scroll-x style]
  (let [text-opts (text-args style)
        target-x (max 0 (+ (- (or local-x 0)
                              (style-content-left style))
                           (or scroll-x 0)))]
    (text-index-at-x-loop value text-opts target-x 0 0)))

(defun text-index-at-event [state event ctx]
  (text-index-at-x (or (:value state) "")
                   (-> event :position :x)
                   (:scroll-x state)
                   (-> ctx :view :effective-style)))

(defun text-input-mouse-move-cursor [state event ctx extend?]
  (let [cursor-index (text-index-at-event state event ctx)]
    (if extend?
      (text-input-move-cursor state cursor-index true)
      (text-input-place-cursor-for-drag state cursor-index))))

(defun clamp-scroll-x [scroll-x text-width content-width]
  (max 0 (min (or scroll-x 0)
              (max 0 (- (or text-width 0) (or content-width 0))))))

(defun scroll-x-for-cursor [scroll-x cursor-x text-width content-width]
  (let [content-width (or content-width 0)
        caret-width 1
        scrollable-width (+ (or text-width 0) caret-width)
        scroll-x (clamp-scroll-x scroll-x scrollable-width content-width)
        cursor-right (+ cursor-x caret-width)]
    (cond
      (<= content-width 0) 0
      (< cursor-x scroll-x) (clamp-scroll-x cursor-x scrollable-width content-width)
      (> cursor-right (+ scroll-x content-width))
      (clamp-scroll-x (- cursor-right content-width) scrollable-width content-width)
      :default scroll-x)))

(defun position-text-input-children! [ctx scroll-x cursor-y]
  (let [children (ui/children ctx)]
    (do
      (when (> (count children) 0)
        (ui/style! (nth children 0)
                   {:position :absolute
                    :left (* -1 (or scroll-x 0))
                    :top (or cursor-y 0)})))))

(defcomponent ui/text-input-caret
  {:style {:width 1}
   :update (fn [state ctx]
             (do (assoc-in! ctx [:view :style :position] :absolute)
                 (assoc-in! ctx [:view :style :left] (:x state))
                 (assoc-in! ctx [:view :style :top] (:y state))
                 (assoc-in! ctx [:view :style :height] (or (:h state) 0))
                 (assoc-in! ctx
                            [:view :style :visibility]
                            (if (:visible? state) :visible :none))
                 state))
   :render (fn [state ctx]
             (r/rect! {:x 0 :y 0 :w 1 :h (or (:h state) 0)}
                      {:fill true
                       :color (or (-> ctx :view :effective-style :background)
                                  (-> ctx :view :effective-style :text :color)
                                  c/BLACK)}))})

(defcomponent ui/text-input-inner
  {:focusable true
   :drag {:button :left
          :start :motion}
   :style {:width :fill
           :height :fill
           :clip true}
   :init (fn [state ctx]
           (let [value (or (:value state) "")]
             (do
               (when (and (:auto-focus? state)
                          (not (:disabled? state)))
                 (ui/focus! ctx))
               (-> state
                   (assoc :value value)
                   (assoc :cursor-index (value-or (:cursor-index state)
                                                  (count value)))))))
   :update (fn [state ctx]
             (let [value (or (:value state) "")
                   style (-> ctx :view :effective-style)
                   text-opts (text-args style)
                   cursor-index (max 0 (min (count value)
                                            (value-or (:cursor-index state)
                                                      (count value))))
                   selection-anchor (if (nil? (:selection-anchor state))
                                      nil
                                      (max 0 (min (count value)
                                                  (:selection-anchor state))))
                   prefix (substr value 0 cursor-index)
                   text-width (measure-text-width value text-opts)
                   cursor-x (measure-text-width prefix text-opts)
                   cursor-h (or (:h (r/text-size "M" text-opts)) 0)
                   content-width (style-content-width (-> ctx :view :bounds)
                                                      style)
                   scroll-x (scroll-x-for-cursor (:scroll-x state)
                                                 cursor-x
                                                 text-width
                                                 content-width)
                   cursor-y (max 0
                                 (int (/ (- (style-content-height
                                             (-> ctx :view :bounds)
                                             style)
                                           cursor-h)
                                        2)))
                   show-caret? (and (not (:disabled? state))
                                    (or (-> ctx :view :interaction :focused)
                                        (-> ctx :view :interaction :focus-within)))
                   selection-prefix-width (measure-text-width
                                            (substr value
                                                    0
                                                    (or (:selection-start state)
                                                        0))
                                            text-opts)
                   selection-end-width (measure-text-width
                                         (substr value
                                                 0
                                                 (or (:selection-end state)
                                                     0))
                                         text-opts)
                   selection-x (- selection-prefix-width scroll-x)
                   selection-w (max 0 (- selection-end-width
                                         selection-prefix-width))]
               (do
                 (position-text-input-children! ctx
                                                scroll-x
                                                cursor-y)
                 (-> state
                     (assoc :value value)
                     (assoc :cursor-index cursor-index)
                     (assoc :selection-anchor selection-anchor)
                     (assoc :selection-start (if (nil? selection-anchor)
                                               nil
                                               (let [start (min selection-anchor
                                                                cursor-index)
                                                     end (max selection-anchor
                                                              cursor-index)]
                                                 (if (< start end) start nil))))
                     (assoc :selection-end (if (nil? selection-anchor)
                                             nil
                                             (let [start (min selection-anchor
                                                              cursor-index)
                                                   end (max selection-anchor
                                                            cursor-index)]
                                               (if (< start end) end nil))))
                     (assoc :scroll-x scroll-x)
                     (assoc :cursor-x cursor-x)
                     (assoc :caret-x (- cursor-x scroll-x))
                     (assoc :cursor-y cursor-y)
                     (assoc :cursor-h cursor-h)
                     (assoc :selection-x selection-x)
                     (assoc :selection-y cursor-y)
                     (assoc :selection-w selection-w)
                     (assoc :selection-h cursor-h)
                     (assoc :show-caret? show-caret?)))))
   :render (fn [state ctx]
             (when (> (or (:selection-w state) 0) 0)
               (r/rect! {:x (or (:selection-x state) 0)
                         :y (or (:selection-y state) 0)
                         :w (or (:selection-w state) 0)
                         :h (or (:selection-h state) 0)}
                        {:fill true
                         :color (ui/theme-var ctx :selection-bg c/BLACK)})))
   :children [{:mode 'ui/text
               :style {:text {:wrap :none}}
               :state {:value (ui/bind-state :value)}}
              {:mode 'ui/text-input-caret
               :state {:x (ui/bind-state :caret-x)
                       :y (ui/bind-state :cursor-y)
                       :h (ui/bind-state :cursor-h)
                       :visible? (ui/bind-state :show-caret?)}}]
   :on-key-down (fn [state event ctx]
                  (if (:disabled? state)
                    state
                    (let [value (:value state)
                          cursor-index (:cursor-index state)
                          extend? (text-input-shift? event ctx)]
                      (if-let [shortcut-state (when (text-input-ctrl? event ctx)
                                                (text-input-handle-shortcut state
                                                                            event
                                                                            ctx))]
                        shortcut-state
                        (cond
                        (= :key/backspace (:key event))
                        (if (text-input-has-selection? state)
                          (text-input-delete-selection state ctx)
                          (if (> cursor-index 0)
                            (text-input-change state
                                               (remove-char-before value cursor-index)
                                               (dec cursor-index)
                                               ctx)
                            state))

                        (= :key/delete (:key event))
                        (if (text-input-has-selection? state)
                          (text-input-delete-selection state ctx)
                          (if (< cursor-index (count value))
                            (text-input-change state
                                               (remove-char-after value cursor-index)
                                               cursor-index
                                               ctx)
                            state))

                        (= :key/left (:key event))
                        (text-input-move-cursor state
                                                (if extend?
                                                  (dec cursor-index)
                                                  (text-input-collapse-left state))
                                                extend?)

                        (= :key/right (:key event))
                        (text-input-move-cursor state
                                                (if extend?
                                                  (+ cursor-index 1)
                                                  (text-input-collapse-right state))
                                                extend?)

                        (= :key/home (:key event))
                        (text-input-move-cursor state 0 extend?)

                        (= :key/end (:key event))
                        (text-input-move-cursor state (count value) extend?)

                        :default
                        (if-let [text (kbd/event->text event)]
                          (text-input-insert-text state text ctx)
                          state))))))
   :on-mouse-down (fn [state event ctx]
                    (if (:disabled? state)
                      state
                      (do
                        (ui/stop-propagation! event)
                        (ui/focus! ctx)
                        (text-input-mouse-move-cursor
                         state
                         event
                         ctx
                         (text-input-shift? event ctx)))))
   :on-drag-start (fn [state event ctx]
                    (if (:disabled? state)
                      state
                      (text-input-mouse-move-cursor state event ctx true)))
   :on-drag (fn [state event ctx]
              (if (:disabled? state)
                state
                (text-input-mouse-move-cursor state event ctx true)))})

(defcomponent ui/text-input
  {:content-size text-input-content-size
   :children [{:mode 'ui/text-input-inner
               :state {:value (ui/bind-state :value)
                       :disabled? (ui/bind-state :disabled?)
                       :read-only? (ui/bind-state :read-only?)
                       :auto-focus? (ui/bind-state :auto-focus?)
                       :accept-value? (ui/bind-state :accept-value?)
                       :emit-change? (ui/bind-state :emit-change?)}}]})
