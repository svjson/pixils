(ns pixils.ui.combo-box
  (:require pixils
            [pixils.image :as img]
            [pixils.rect :as rect]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.internal.option-navigation :as navigation]
            [pixils.ui.option-item :as option]
            [pixils.ui.option-list :as option-list]
            [pixils.ui.option-selection :as selection]))



;; Internal selection management functions

(defun selected-option [options selected-index]
  (when selected-index
    (nth options selected-index)))

(defun selected-label [options selected-index]
  (if-let [option (selected-option options selected-index)]
    (option/label option)
    ""))

(defun selected-value [options selected-index]
  (when-let [option (selected-option options selected-index)]
    (option/value option)))

(defun selected-label-state-transition [_current candidate _changed-keys]
  {:selected-label (selected-label (:options candidate)
                                   (:selected-index candidate))})

(defun select-index [state index ctx]
  (if (nil? index)
    state
    (let [ui-state (-> ctx :view :ui-state)
          current-index (:selected-index ui-state)
          current (if (nil? current-index) [] [current-index])
          selected (selection/select (:options ui-state)
                                     current
                                     index
                                     ui-state)]
      (if (= current selected)
        state
        (let [index (head selected)
              value (selected-value (:options ui-state) index)]
          (ui/set-ui-state! ctx (assoc ui-state :selected-index index))
          (ui/emit! (:view ctx)
                    :combo-box/change
                    {:selected-index index
                     :value value})
          state)))))

(defun step-selection [state direction ctx]
  (let [ui-state (-> ctx :view :ui-state)]
    (if (:disabled? ui-state)
      state
      (let [options (:options ui-state)
            base (or (:selected-index ui-state)
                     (if (> direction 0) -1 (count options)))
            index (navigation/next-enabled-index-from options base direction)]
        (select-index state index ctx)))))



;; Internal render support

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun style-padding-side [style side]
  (get (:padding style) side 0))

(defun padding-side [padding side]
  (or (get padding side)
      (cond
        (= side :top) (:t padding)
        (= side :right) (:r padding)
        (= side :bottom) (:b padding)
        (= side :left) (:l padding)
        :default nil)
      0))

(defun combo-box-trigger-style [ctx]
  (let [children (ui/children ctx)
        trigger (when (not-empty? children)
                  (head children))]
    (or (-> trigger :effective-style)
        (-> trigger :style)
        {})))

(defun combo-box-text-height [ctx]
  (let [dim (r/text-size "M" (text-args (-> ctx :view :effective-style)))]
    (max 1 (or (:h dim) 0))))

(defun options-label-width [options text-opts]
  (reduce options
          0
          (fn [out option]
            (max out
                 (get (r/text-size (option/label option) text-opts) :w 0)))))

(defun combo-box-content-size [state ctx]
  (let [state (or (-> ctx :view :ui-state) state)
        style (-> ctx :view :effective-style)
        trigger-style (combo-box-trigger-style ctx)
        label (or (:selected-label state)
                  (selected-label (:options state) (:selected-index state))
                  "M")
        text-opts (text-args style)
        text-dim (r/text-size (if (not-empty? label) label "M")
                              text-opts)
        options-width (options-label-width (:options state) text-opts)
        line-height (combo-box-text-height ctx)
        vertical-padding (+ (style-padding-side trigger-style :top)
                            (style-padding-side trigger-style :bottom))]
    {:w (max 1 (+ (max (or (:w text-dim) 0)
                       options-width)
                  24))
     :h (max 1 (+ line-height vertical-padding))}))

(defun popup-anchor-geometry [ctx]
  (let [anchor-view (:view ctx)
        scale (or (:visual-scale anchor-view) 1)]
    {:width (max 1 (int (/ (-> anchor-view :visual-bounds :w) scale)))
     :scale scale}))


;; Popup/Expanded Mode

(defun popup-selected-indices [state]
  (if (:selected-index state)
    [(:selected-index state)]
    []))

(defun open-popup! [ctx]
  (let [state (-> ctx :view :ui-state)
        options (or (:options state) [])
        row-height (:row-height state)
        max-height (:max-height state)
        anchor (popup-anchor-geometry ctx)]
    (when (and (not (:disabled? state))
               (not-empty? options))
      (push-mode!
       'ui/combo-box-popup
       {:options options
        :selected-indices (popup-selected-indices state)
        :anchor-bounds (:visual-bounds (:view ctx))
        :row-height row-height
        :max-height max-height}
       (merge
        (when (> (:scale anchor) 1)
          {:style {:scale (:scale anchor)}})
        {:origin {:view (:view ctx)
                  :event :combo-box/select}
         :overlay {:anchor (:view ctx)
                   :placement :bottom-start
                   :fallback-placement :top-start}
         :children [{:mode 'ui/combo-box-popup-panel
                     :style (cond-> {:position :absolute
                                     :left 0
                                     :top 0
                                     :width :shrink
                                     :min-width (:width anchor)
                                     :height :shrink}

                                    max-height
                                    (assoc :max-height max-height))
                     :children [(option-list/make
                                 (cond-> {:options options
                                          :style {:width :shrink
                                                  :min-width (- (:width anchor) 2)
                                                  :height :fill
                                                  :border {:thickness 0}
                                                  :text (-> ctx
                                                            :view
                                                            :effective-style
                                                            :text)}
                                          :selected-indices []}

                                         max-height
                                         (assoc :max-height max-height)

                                         row-height
                                         (assoc :row-height row-height)))]}]})))))


(defmode ui/combo-box-popup
  {:on-mouse-down (fn [state event ctx]
                    (pop-mode! (if (rect/contains? (:anchor-bounds state)
                                                   (:global-position event))
                                 {:type :dismiss
                                  :anchor-click? true}
                                 {:type :dismiss}))
                    state)
   :on {:option-item/click (fn [state {:keys [payload] :as event} ctx]
                             (ui/stop-propagation! event)
                             (pop-mode! {:selected-indices [(:index payload)]
                                         :selected-values [(:value payload)]
                                         :value (:value payload)})
                             state)}
   :compose {:render :pass}})

(defcomponent ui/combo-box-popup-panel
  {:class :ui/combo-box-popup-panel})



;; Internal components


(defcomponent ui/combo-box-button
  {:ui/state-keys [:disabled? :pressed]
   :init-ui (fn [ui-state state ctx]
              (assoc ui-state
                     :pressed
                     (:pressed (if (contains? ui-state :pressed)
                                 ui-state
                                 state))))
   :update-ui (fn [ui-state state ctx]
                (assoc ui-state :pressed (and (not (:disabled? state))
                                              (contains? (-> ctx :view :interaction :pressed) :left)
                                              (-> ctx :view :interaction :hovered))))
   :render (fn [state ctx]
             (when-let [image (ui/theme-var ctx :combo-box-button-image nil)
                        dim (img/size image)]
               (r/image! image
                         {:target (rect/align {:x 0
                                               :y 0
                                               :w (-> ctx :view :bounds :w)
                                               :h (-> ctx :view :bounds :h)}
                                              {:w (:w dim)
                                               :h (:h dim)}
                                              0.5
                                              0.5)})))})

(defcomponent ui/combo-box-trigger
  {:style {:width :fill
           :height :fill}
   :children [{:mode 'ui/text
               :style {:width :fill
                       :text {:wrap :none}}
               :state {:value (ui/bind-state :selected-label)}}
              {:mode 'ui/combo-box-button
               :state {:component {:disabled? (ui/project-state :disabled?)}}}]})



;; Main component

(def COMBO-BOX-UI-STATE-KEYS
  [:options
   :selected-index
   :selected-value
   :selected-label
   :force-selection?
   :row-height
   :max-height
   :disabled?])

(defcomponent ui/combo-box
  {:focusable true
   :class :ui/combo-box
   :content-size combo-box-content-size
   :ui/state-keys COMBO-BOX-UI-STATE-KEYS
   :ui/models [(selection/single-model nil)
               {:owns [:selected-label]
                :depends-on [:options :selected-index]
                :transition selected-label-state-transition}]
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    (unless (-> ctx :view :ui-state :disabled?)
                      (open-popup! ctx))
                    state)
   :on-key-down (fn [state event ctx]
                  (if (-> ctx :view :ui-state :disabled?)
                    state
                    (case (:key event)
                      :key/up
                      (do
                        (ui/stop-propagation! event)
                        (step-selection state -1 ctx))

                      :key/down
                      (do
                        (ui/stop-propagation! event)
                        (step-selection state 1 ctx))

                      :default state)))
   :on {:combo-box/select (fn [state event ctx]
                            (let [payload (:payload event)
                                  index (head (:selected-indices payload))]
                              (ui/stop-propagation! event)
                              (ui/focus! ctx)
                              (if (:anchor-click? payload)
                                state
                                (select-index state index ctx))))}
   :children [{:mode 'ui/combo-box-trigger
               :state {:selected-label (ui/bind-state :selected-label)
                       :disabled? (ui/bind-state :disabled?)}}]})



;; Make functions

(defun make
  "Builds a ui/combo-box child entry.

  Options:

  ```roo
  {:options [{:value :small :label \"Small\"}]
   :selected-index nil
   :force-selection? false
   :disabled? false
   :row-height 20
   :max-height 160
   :class :settings/combo
   :style {...}
   :state {...}
   :ui-state {...}
   :state-policy :shared}
  ```

  Stock combo-box behavior values are written under `:state :component`.
  Static values, `ui/bind-state`, and `ui/project-state` are accepted for
  component entries. Ordinary :state entries remain available for caller
  application state. During migration, component keys supplied directly in
  :state are also copied into :component, and the default shared state policy
  keeps declared component keys visible in ordinary state."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [component (merge (select-keys state COMBO-BOX-UI-STATE-KEYS)
                         (:component state)
                         (select-keys opts COMBO-BOX-UI-STATE-KEYS))]
    (cond-> {:mode 'ui/combo-box
             :state (assoc state :component component)}
            (contains? opts :style) (assoc :style style)
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state)
            state-policy (assoc :ui/state-policy state-policy))))
