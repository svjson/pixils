(ns pixils.ui.combo-box
  (:require pixils
            pixils.ui.list-box
            [pixils.render :as r]
            [pixils.ui :as ui]))

(def default-row-height 20)
(def popup-panel-inset 2)

(defun option-label [option]
  (or (:label option)
      (:name option)
      (str (:value option))))

(defun option-value [option]
  (let [value (:value option)]
    (if (nil? value)
      (:id option)
      value)))

(defun option-disabled? [option]
  (= (:disabled? option) true))

(defun valid-option-index? [options index]
  (and (not (nil? index))
       (>= index 0)
       (< index (count options))))

(defun enabled-option-index? [options index]
  (and (valid-option-index? options index)
       (not (option-disabled? (nth options index)))))

(defun selected-option [options selected-index]
  (if (empty? options)
    nil
    (nth options (max 0 (min (dec (count options))
                             (or selected-index 0))))))

(defun selected-label [options selected-index]
  (let [option (selected-option options selected-index)]
    (if option
      (option-label option)
      "")))

(defun selected-value [options selected-index]
  (let [option (selected-option options selected-index)]
    (if option
      (option-value option)
      nil)))

(defun next-enabled-index-from [options index direction]
  (let [next-index (+ index direction)]
    (cond
      (or (< next-index 0)
          (>= next-index (count options)))
      nil

      (enabled-option-index? options next-index)
      next-index

      :default
      (next-enabled-index-from options next-index direction))))

(defun next-enabled-index [options selected-index direction]
  (next-enabled-index-from (or options [])
                           (or selected-index 0)
                           direction))

(defun select-index [state index ctx]
  (if (nil? index)
    state
    (let [option (selected-option (:options state) index)
          value (selected-value (:options state) index)]
      (if (or (nil? option)
              (option-disabled? option))
        state
        (do
          (ui/emit! (:view ctx)
                    :combo-box/change
                    {:selected-index index
                     :value value})
          (assoc (assoc (assoc state
                               :selected-index index)
                        :selected-value value)
                 :selected-label
                 (selected-label (:options state) index)))))))

(defun step-selection [state direction ctx]
  (if (:disabled? state)
    state
    (let [index (next-enabled-index (:options state)
                                    (:selected-index state)
                                    direction)]
      (select-index state index ctx))))

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun style-padding-side [style side]
  (or (get (:padding style) side) 0))

(defun padding-side [padding side]
  (or (get padding side)
      (cond
        (= side :top) (get padding :t)
        (= side :right) (get padding :r)
        (= side :bottom) (get padding :b)
        (= side :left) (get padding :l)
        :default nil)
      0))

(defun combo-box-trigger-style [ctx]
  (let [children (ui/children ctx)
        trigger (if (> (count children) 0)
                  (nth children 0)
                  nil)]
    (or (-> trigger :effective-style)
        (-> trigger :style)
        {})))

(defun combo-box-text-height [ctx]
  (let [dim (r/text-size "M" (text-args (-> ctx :view :effective-style)))]
    (max 1 (or (:h dim) 0))))

(defun combo-box-measured-row-height [ctx]
  (max default-row-height
       (+ (combo-box-text-height ctx) 6)))

(defun combo-box-row-height [state ctx]
  (or (:row-height state)
      (when ctx (combo-box-measured-row-height ctx))
      default-row-height))

(defun option-label-width [option text-opts]
  (or (:w (r/text-size (option-label option) text-opts)) 0))

(defun options-label-width [options text-opts]
  (reduce (or options [])
          0
          (fn [out option]
            (max out (option-label-width option text-opts)))))

(defun combo-box-content-size [state ctx]
  (let [style (-> ctx :view :effective-style)
        trigger-style (combo-box-trigger-style ctx)
        label (or (:selected-label state)
                  (selected-label (:options state) (:selected-index state))
                  "M")
        text-opts (text-args style)
        text-dim (r/text-size (if (> (count label) 0) label "M")
                              text-opts)
        options-width (options-label-width (:options state) text-opts)
        line-height (combo-box-text-height ctx)
        vertical-padding (+ (style-padding-side trigger-style :top)
                            (style-padding-side trigger-style :bottom))]
    {:w (max 1 (+ (max (or (:w text-dim) 0)
                       options-width)
                  24))
     :h (max 1 (+ line-height vertical-padding))}))

(defun popup-list-content-width [options ctx]
  (let [text-opts (text-args (-> ctx :view :effective-style))
        padding (or (ui/theme-var ctx :list-box-item-padding nil)
                    {:t 3 :r 5 :b 3 :l 5})
        label-width (options-label-width options text-opts)]
    (max 1 (+ label-width
              (padding-side padding :left)
              (padding-side padding :right)))))

(defun popup-anchor-geometry [ctx]
  (let [anchor-view (:view ctx)
        bounds (:visual-bounds anchor-view)
        scale (or (:visual-scale anchor-view) 1)]
    {:width (max 1 (int (/ (:w bounds) scale)))
     :scale scale}))

(defun point-in-rect? [point rect]
  (and (not (nil? point))
       (not (nil? rect))
       (>= (:x point) (:x rect))
       (>= (:y point) (:y rect))
       (< (:x point) (+ (:x rect) (:w rect)))
       (< (:y point) (+ (:y rect) (:h rect)))))

(defun popup-selected-indices [state]
  [(or (:selected-index state) 0)])

(defun open-popup! [state ctx]
  (let [options (or (:options state) [])
        row-height (combo-box-row-height state ctx)
        max-height (:max-height state)
        anchor (popup-anchor-geometry ctx)
        content-width (max 1
                           (max (- (:width anchor) 2)
                                (popup-list-content-width options ctx)))]
    (when (and (not (:disabled? state))
               (not (empty? options)))
      (push-mode!
       'ui/combo-box-popup
       {:options options
        :selected-indices (popup-selected-indices state)
        :anchor-bounds (:visual-bounds (:view ctx))
        :row-height row-height
        :max-height max-height}
       (merge
        (if (> (:scale anchor) 1)
          {:style {:scale (:scale anchor)}}
          {})
        {:origin {:view (:view ctx)
                  :event :combo-box/select}
         :overlay {:anchor (:view ctx)
                   :placement :bottom-start
                   :fallback-placement :top-start}
         :children [{:mode 'ui/combo-box-popup-panel
                     :style (merge {:position :absolute
                                     :left 0
                                     :top 0
                                     :width :shrink
                                     :min-width (:width anchor)
                                     :height :shrink}
                                    (if (nil? max-height)
                                      {}
                                      {:max-height max-height}))
                     :children [(pixils.ui.list-box/make
                                 (merge
                                  {:options options
                                   :style {:width :fill
                                           :height :fill
                                           :border {:thickness 0}}
                                   :content-width content-width
                                   :selected-indices []
                                   :hover-highlight? true
                                   :toggle-selected? false}
                                  (if (nil? max-height)
                                    {}
                                    {:max-height max-height})
                                  (if (nil? (:row-height state))
                                    {}
                                    {:row-height row-height})))]}]})))))

(defcomponent ui/combo-box-trigger
  {:style {:width :fill
           :height :fill}
   :children [{:mode 'ui/text
               :style {:width :fill
                       :text {:wrap :none}}
               :state {:value (ui/bind-state :selected-label)}}
              {:mode 'ui/combo-box-button
               :state {:axis :y
                       :part :end
                       :disabled? (ui/bind-state :disabled?)}}]})

(defcomponent ui/combo-box
  {:focusable true
   :class :ui/combo-box
   :style {:width :fill
           :min-height 22}
   :content-size combo-box-content-size
   :init (fn [state ctx]
           (assoc (assoc state
                         :selected-index (or (:selected-index state) 0))
                  :selected-label
                  (selected-label (:options state)
                                  (or (:selected-index state) 0))))
   :update (fn [state ctx]
             (assoc state
                    :selected-label
                    (selected-label (:options state)
                                    (:selected-index state))))
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    (cond
                      (:disabled? state)
                      state

                      (:suppress-next-open? state)
                      (assoc state :suppress-next-open? false)

                      :default
                      (do
                        (open-popup! state ctx)
                        state)))
   :on-key-down (fn [state event ctx]
                  (if (:disabled? state)
                    state
                    (case (:key event)
                      :key/up
                      (do
                        (ui/stop-propagation! event)
                        (step-selection state -1 ctx))

                      :key/down
                      (do
                        (ui/stop-propagation! event)
                        (step-selection state 1 ctx))

                      :default state)))
   :on {:combo-box/select (fn [state event ctx]
                            (let [payload (:payload event)
                                  index (head (:selected-indices payload))]
                              (ui/stop-propagation! event)
                              (ui/focus! ctx)
                              (if (:anchor-click? payload)
                                (assoc state :suppress-next-open? true)
                                (select-index state index ctx))))}
   :children [{:mode 'ui/combo-box-trigger
               :state {:selected-label (ui/bind-state :selected-label)
                       :disabled? (ui/bind-state :disabled?)}}]})

(defmode ui/combo-box-popup
  {:on-mouse-down (fn [state event ctx]
                    (pop-mode! (if (point-in-rect? (:global-position event)
                                                   (:anchor-bounds state))
                                 {:type :dismiss
                                  :anchor-click? true}
                                 {:type :dismiss}))
                    state)
   :on {:list-box/change (fn [state event ctx]
                           (ui/stop-propagation! event)
                           (pop-mode! (:payload event))
                           state)}
   :compose {:render :pass}})

(defcomponent ui/combo-box-popup-panel
  {:class :ui/combo-box-popup-panel})

(defun make [{:keys [options class style selected-index row-height max-height disabled?]}]
  (merge {:mode 'ui/combo-box
          :style (or style {})
          :state {:options (or options [])
                  :selected-index selected-index
                  :disabled? disabled?
                  :row-height row-height
                  :max-height max-height}}
         (if class {:class class} {})))
