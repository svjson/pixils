(ns pixils.ui.dialog
  (:require pixils
            pixils.ui.window
            [pixils.ui :as ui]))

(def dialog-button-presets
  {:dialog/ok [:dialog/ok]
   :dialog/ok-cancel [:dialog/ok :dialog/cancel]
   :dialog/yes-no [:dialog/yes :dialog/no]
   :dialog/yes-no-cancel [:dialog/yes :dialog/no :dialog/cancel]})

(def dialog-button-labels
  {:dialog/ok "OK"
   :dialog/cancel "Cancel"
   :dialog/yes "Yes"
   :dialog/no "No"
   :dialog/dismiss "Dismiss"})

(defcomponent ui/dialog-body
  {})

(defcomponent ui/dialog-button-row
  {})

(defun option-classes [classes]
  (cond
    (nil? classes) []
    (keyword? classes) [classes]
    :default classes))

(defun merge-classes [base extra]
  (concat (option-classes base)
          (option-classes extra)))

(defun dialog-button-type-class [type]
  (case type
    :dialog/ok :ui/dialog-button-ok
    :dialog/cancel :ui/dialog-button-cancel
    :dialog/yes :ui/dialog-button-yes
    :dialog/no :ui/dialog-button-no
    :dialog/dismiss :ui/dialog-button-dismiss
    :default :ui/dialog-button-custom))

(defun button-label [type]
  (or (get dialog-button-labels type)
      (str type)))

(defun normalize-button [button]
  (if (keyword? button)
    {:type button
     :label (button-label button)}
    (let [type (or (:type button)
                   (:id button)
                   :dialog/ok)]
      (merge {:type type
              :label (button-label type)}
             button))))

(defun normalize-buttons [buttons]
  (let [raw (or buttons :dialog/ok)
        entries (if (keyword? raw)
                  (or (get dialog-button-presets raw)
                      [raw])
                  raw)]
    (map entries normalize-button)))

(defun body-children [body]
  (cond
    (nil? body)
    []

    (= (type-of body) "string")
    [body]

    (or (:mode body)
        (:children body)
        (:style body))
    [body]

    :default
    body))

(defun dialog-result [state choice]
  {:choice choice
   :payload (:dialog/payload state)})

(defun stop-dialog-window-mouse-down [state event ctx]
  (ui/stop-propagation! event)
  state)

(defun make-dialog-button [button]
  (let [button (normalize-button button)
        type (:type button)]
    {:mode 'ui/button
     :class (merge-classes [:ui/dialog-button
                            (dialog-button-type-class type)]
                           (:class button))
     :style (or (:style button) {})
     :state (merge (or (:state button) {})
                   {:choice type
                    :label (:label button)})
     :on-click (fn [state event ctx]
                 (ui/emit! (:view ctx)
                           :dialog/button
                           {:choice (:choice state)})
                 state)}))

(defun make-dialog-button-row [buttons style class]
  {:mode 'ui/dialog-button-row
   :class (merge-classes [:ui/dialog-button-row] class)
   :style (or style {})
   :children (map (normalize-buttons buttons)
                  make-dialog-button)})

(defun make-dialog-body [{:keys [body buttons body-style button-row-style
                                 body-class button-row-class state]}]
  {:mode 'ui/dialog-body
   :class (merge-classes [:ui/content :ui/dialog-body] body-class)
   :style (or body-style {})
   :state (or state {})
   :children (concat (body-children body)
                     [(make-dialog-button-row buttons
                                              button-row-style
                                              button-row-class)])})

(defun make-dialog-window [{:keys [title title-bar position state style body auto-focus auto-focus?]
                            :as opts}]
  (let [window-opts (merge {:title-bar (or title-bar {:title (or title "Dialog")})
                            :class (merge-classes [:ui/dialog-window]
                                                  (:class opts))
                            :style (or style {})
                            :state (or state {})
                            :auto-focus (if (contains? opts :auto-focus)
                                          auto-focus
                                          (if (contains? opts :auto-focus?)
                                            (if auto-focus?
                                              :first-body
                                              false)
                                            :first-body))
                            :body (body-children body)}
                           (if (contains? opts :position)
                             {:position position}
                             {}))]
    (merge
     (pixils.ui.window/make window-opts)
     {:on-mouse-down stop-dialog-window-mouse-down})))

(defun make-confirm [{:keys [title] :as opts}]
  (make-dialog-window (merge opts
                             {:title (or title "Confirm")
                              :body (make-dialog-body opts)})))

(defun dismiss-dialog! [state]
  (when (:dialog/dismissable state)
    (pop-mode! (dialog-result state :dialog/dismiss))))

(defun make-result-handler [handler]
  (fn [state event ctx]
    (ui/stop-propagation! event)
    (pop-mode! (apply handler [state event ctx]))
    state))

(defun make-result-handlers [results]
  (reduce (keys (or results {}))
          {}
          (fn [handlers event-key]
            (assoc handlers
                   event-key
                   (make-result-handler (get results event-key))))))

(defmode ui/dialog-frame
  {:focusable true
   :style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (ui/focus! ctx)
           state)
   :on-key-down (fn [state event ctx]
                  (case (:key event)
                    :key/escape
                    (do
                      (ui/stop-propagation! event)
                      (dismiss-dialog! state)
                      state)

                    :default
                    state))
   :on-mouse-down (fn [state event ctx]
                    (ui/preserve-focus! event)
                    (ui/stop-propagation! event)
                    (dismiss-dialog! state)
                    state)
   :on {:dialog/button (fn [state event ctx]
                         (ui/stop-propagation! event)
                         (pop-mode! (dialog-result state
                                                   (-> event :payload :choice)))
                         state)}
   :compose {:render :pass}})

(defun open-confirm! [ctx opts]
  (open-dialog!
   ctx
   (merge opts
          {:title (or (:title opts) "Confirm")
           :body (make-dialog-body opts)
           :results {:dialog/button
                     (fn [state event ctx]
                       (dialog-result state
                                      (-> event :payload :choice)))}})))

(defun open-dialog! [ctx opts]
  (push-mode! 'ui/dialog-frame
              (merge (or (:state opts) {})
                     {:dialog/payload (:payload opts)
                      :dialog/dismissable (or (:dismissable opts) false)
                      :dialog/modal (if (nil? (:modal opts))
                                      true
                                      (:modal opts))})
              {:origin {:view (:view ctx)
                        :event (or (:result-event opts)
                                   :dialog/result)}
               :class (:overlay-class opts)
               :on (make-result-handlers (:results opts))
               :children [(make-dialog-window opts)]})
  nil)
