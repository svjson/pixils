(ns pixils.ui.menu-bar
  (:require pixils
            [pixils.rect :as rect]
            [pixils.ui :as ui]
            [pixils.ui.menu-bar-item :as menu-bar-item]
            [pixils.ui.menu-model :as model]
            [pixils.ui.popup-menu :as popup]))



;; Menu-bar state

(defun view-scale
  "Read the effective scale inherited by a view.

  Args:
  - `view`: Menu-bar view.

  Returns:
  The effective or directly supplied scale."
  [view]
  (or (-> view :effective-style :scale)
      (-> view :style :scale)))

(defun child-index-at-point
  "Find the menu-bar child containing a global point.

  Args:
  - `view`: Menu-bar view.
  - `point`: Global point with `:x` and `:y` coordinates.

  Returns:
  The matching child index, or `nil`."
  [view point]
  (when point
    (find-index (ui/children view)
                (fn [child]
                  (rect/contains? (:visual-bounds child) point)))))

(defun set-active-index!
  "Set the active menu-bar item and refresh every item highlight.

  Args:
  - `ctx`: Menu-bar hook context.
  - `active-index`: Active top-level item index, or `nil`.

  Returns:
  `nil` after updating the menu bar and its item views."
  [ctx active-index]
  (ui/update-ui-state! ctx assoc :active-index active-index)
  (doseq [child (-> ctx :view ui/children)]
    (let [ui-state (assoc (:ui-state child) :active-index active-index)]
      (ui/set-ui-state! child
                        (assoc ui-state
                               :highlighted
                               (menu-bar-item/highlighted?
                                ui-state
                                (-> child :interaction :hovered)))))))

(defun open-popup-at-index!
  "Open an enabled top-level submenu by index.

  Args:
  - `ui-state`: Current menu-bar UI state.
  - `state`: Current application state.
  - `ctx`: Menu-bar hook context.
  - `index`: Candidate top-level item index.
  - `input-source`: Input source that opened the popup.

  Returns:
  The pushed popup result, or `nil` when the item cannot open."
  [ui-state state ctx index input-source]
  (let [node (nth (-> ui-state :menu :items) index)
        child-view (nth (-> ctx :view ui/children) index)]
    (when (and node
               child-view
               (not (:disabled? node)))
      (set-active-index! ctx index)
      (popup/open-at-view! node
                           (merge state
                                  ui-state
                                  {:input-source input-source})
                           child-view
                           :below))))

(defun open-pending-popup
  "Open and clear a deferred top-level popup request.

  Args:
  - `ui-state`: Current menu-bar UI state.
  - `state`: Current application state.
  - `ctx`: Menu-bar hook context.

  Returns:
  UI state with any pending request cleared."
  [ui-state state ctx]
  (if-let [index (:pending-open-index ui-state)]
    (do
      (open-popup-at-index! ui-state
                            state
                            ctx
                            index
                            (or (:pending-open-input-source ui-state)
                                :keyboard))
      (merge ui-state
             {:pending-open-index nil
              :pending-open-input-source nil}))
    ui-state))



;; Menu-bar component

(def UI-STATE-KEYS
  "Canonical UI-state keys owned by `ui/menu-bar`."
  [:menu
   :menu-scale
   :active-index
   :pending-open-index
   :pending-open-input-source])

(defcomponent ui/menu-bar
  {:style {:width :fill
           :layout {:direction :row}}
   :ui/state-keys UI-STATE-KEYS
   :update-ui open-pending-popup
   :after-layout-ui (fn [ui-state _state ctx]
                      (let [scale (view-scale (:view ctx))]
                        (if (or (nil? scale)
                                (= scale (:menu-scale ui-state)))
                          ui-state
                          (assoc ui-state :menu-scale scale))))

   :on {:menu/open
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                index (-> event :payload :menu-index)]
            (ui/stop-propagation! event)
            (open-popup-at-index! ui-state state ctx index :mouse)
            state))
        :menu/navigate-top
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)
                items (-> ui-state :menu :items)
                direction (case (:direction payload)
                            :left -1
                            :default 1)
                next-index (model/move-highlight-index
                            items
                            (:menu-index payload)
                            direction)]
            (ui/stop-propagation! event)
            (set-active-index! ctx next-index)
            (ui/update-ui-state! ctx merge
                                 {:pending-open-index next-index
                                  :pending-open-input-source :keyboard})
            state))
        :menu/dismiss
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)
                clicked-index (child-index-at-point
                               (:view ctx)
                               (:global-position payload))
                clicked-node (when clicked-index
                               (nth (-> ui-state :menu :items)
                                    clicked-index))]
            (ui/stop-propagation! event)
            (if (and (some? clicked-index)
                     (not= clicked-index (:menu-index payload))
                     (not (:disabled? clicked-node))
                     (model/submenu-node? clicked-node))
              (do
                (set-active-index! ctx clicked-index)
                (ui/update-ui-state! ctx merge
                                     {:pending-open-index clicked-index
                                      :pending-open-input-source :mouse}))
              (do
                (set-active-index! ctx nil)
                (ui/update-ui-state! ctx merge
                                     {:pending-open-index nil
                                      :pending-open-input-source nil})))
            state))
        :menu/select
        (fn [state _event ctx]
          (set-active-index! ctx nil)
          (ui/update-ui-state!
           ctx
           merge
           {:pending-open-index nil
            :pending-open-input-source nil})
          state)}})



;; Construction

(defun component-state
  "Build canonical menu-bar component state from constructor options.

  Args:
  - `opts`: Menu constructor options.

  Returns:
  Normalized component state using canonical input precedence."
  [opts]
  (let [state (or (:state opts) {})
        normalized-menu (model/normalize (:menu-definition opts)
                                         (:keymap opts))]
    (merge {:menu-scale (-> opts :style :scale)
            :active-index nil
            :pending-open-index nil
            :pending-open-input-source nil}
           (select-keys state UI-STATE-KEYS)
           (:component state)
           (select-keys opts UI-STATE-KEYS)
           {:menu normalized-menu})))

(defun make-node
  "Build a `ui/menu-bar` view specification from canonical options.

  Args:
  - `opts`: Menu constructor options.

  Returns:
  A menu-bar view specification with normalized component state."
  [opts]
  (let [class (:class opts)
        ui-state (:ui-state opts)
        component (component-state opts)]
    (cond->
      {:mode 'ui/menu-bar
       :state (assoc (:state opts) :component component)
       :ui/state-policy (or (:state-policy opts) :isolated)
       :children
       (for-indexed [index item (-> component :menu :items)]
         (menu-bar-item/make item
                             index
                             (ui/project-state :active-index)))}
      (contains? opts :style) (assoc :style (:style opts))
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state))))

(defun make
  "Build a menu-bar view specification.

  Args:
  - `options`: Constructor options or legacy application-state map.
  - `menu-definition`: Declarative menu tree and optional settings.
  - `keymap`: Action bindings used to resolve displayed shortcuts.

  Returns:
  An isolated `ui/menu-bar` view specification. Pass `:state-policy :shared`
  only when compatibility code reads intrinsic menu fields from ordinary
  state."
  [options menu-definition keymap]
  (make-node (merge (if (or (contains? options :state)
                            (contains? options :style)
                            (contains? options :class)
                            (contains? options :ui-state)
                            (contains? options :state-policy))
                      options
                      {:state options})
                    {:menu-definition menu-definition
                     :keymap keymap})))
