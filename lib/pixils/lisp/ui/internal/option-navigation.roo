(ns pixils.ui.internal.option-navigation)



;; Option Index Resolution

(defun valid-index? [options index]
  (and (number? index)
       (>= index 0)
       (< index (count options))))

(defun enabled-index? [options index]
  (and (valid-index? options index)
       (not (:disabled? (nth options index)))))

(defun first-enabled-index [options]
  (find-index options
              (fn [item]
                (not (:disabled? item)))))

(defun next-enabled-index-from [options index direction]
  (let [next-index (+ index direction)]
    (cond
      (or (< next-index 0)
          (>= next-index (count options)))
      nil

      (enabled-index? options next-index)
      next-index

      :default
      (next-enabled-index-from options next-index direction))))

(defun last-enabled-index [options]
  (next-enabled-index-from options (count options) -1))
