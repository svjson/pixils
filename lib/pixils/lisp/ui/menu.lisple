(ns pixils.ui.menu
  (:require pixils
            [pixils.keyboard :as kbd]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.ui :as ui]))



;; Internal menu model

(def default-menu-settings
  {:mnemonics {:enabled true
               :marker "&"
               :render-marker "@"
               :trigger :alt
               :style :underline}
   :shortcuts {:render true}})

(def generated-menu-option-checkmark :pixils-ui/menu-option-checkmark)

(def generated-menu-submenu-chevron-windows-3
  :pixils-ui/windows-3-submenu-chevron)

(def generated-menu-submenu-chevron-windows-3-highlighted
  :pixils-ui/windows-3-submenu-chevron-highlighted)

(def generated-menu-submenu-chevron-windows-95
  :pixils-ui/windows-95-submenu-chevron)

(def generated-menu-submenu-chevron-windows-95-highlighted
  :pixils-ui/windows-95-submenu-chevron-highlighted)

(def generated-menu-option-checkmark-color {:r 0x00 :g 0x00 :b 0x00})

(def generated-menu-highlight-color {:r 0xff :g 0xff :b 0xff})

(defun generated-menu-image-exists? [id]
  (not (nil? (head (filter (res/list-images :pixils-ui)
                           (fn [resource]
                             (= (:id resource)
                                id)))))))

(defun draw-generated-menu-option-checkmark! []
  (let [color generated-menu-option-checkmark-color]
    (do
      (r/line! {:x 7 :y 0} {:x 7 :y 1} color)
      (r/line! {:x 6 :y 2} {:x 7 :y 2} color)
      (r/line! {:x 6 :y 3} {:x 6 :y 3} color)
      (r/line! {:x 5 :y 4} {:x 6 :y 4} color)
      (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
      (r/line! {:x 5 :y 5} {:x 5 :y 5} color)
      (r/line! {:x 1 :y 6} {:x 2 :y 6} color)
      (r/line! {:x 4 :y 6} {:x 5 :y 6} color)
      (r/line! {:x 2 :y 7} {:x 2 :y 7} color)
      (r/line! {:x 4 :y 7} {:x 4 :y 7} color)
      (r/line! {:x 2 :y 8} {:x 4 :y 8} color)
      (r/line! {:x 3 :y 9} {:x 3 :y 9} color))))

(defun ensure-generated-menu-option-checkmark! []
  (do
    (res/create-bundle! :pixils-ui)
    (when (not (generated-menu-image-exists? generated-menu-option-checkmark))
      (res/create-image! generated-menu-option-checkmark
                         {:size {:w 8 :h 10}}
                         draw-generated-menu-option-checkmark!))))

(defun draw-generated-windows-3-submenu-chevron-with-color! [color]
  (do
    (r/line! {:x 2 :y 2} {:x 2 :y 2} color)
    (r/line! {:x 2 :y 3} {:x 3 :y 3} color)
    (r/line! {:x 2 :y 4} {:x 4 :y 4} color)
    (r/line! {:x 2 :y 5} {:x 5 :y 5} color)
    (r/line! {:x 2 :y 6} {:x 4 :y 6} color)
    (r/line! {:x 2 :y 7} {:x 3 :y 7} color)
    (r/line! {:x 2 :y 8} {:x 2 :y 8} color)))

(defun draw-generated-windows-3-submenu-chevron! []
  (draw-generated-windows-3-submenu-chevron-with-color!
   generated-menu-option-checkmark-color))

(defun draw-generated-windows-3-submenu-chevron-highlighted! []
  (draw-generated-windows-3-submenu-chevron-with-color!
   generated-menu-highlight-color))

(defun draw-generated-windows-95-submenu-chevron-with-color! [color]
  (do
    (r/line! {:x 2 :y 2} {:x 2 :y 2} color)
    (r/line! {:x 2 :y 3} {:x 3 :y 3} color)
    (r/line! {:x 2 :y 4} {:x 4 :y 4} color)
    (r/line! {:x 2 :y 5} {:x 5 :y 5} color)
    (r/line! {:x 2 :y 6} {:x 4 :y 6} color)
    (r/line! {:x 2 :y 7} {:x 3 :y 7} color)
    (r/line! {:x 2 :y 8} {:x 2 :y 8} color)))

(defun draw-generated-windows-95-submenu-chevron! []
  (draw-generated-windows-95-submenu-chevron-with-color!
   generated-menu-option-checkmark-color))

(defun draw-generated-windows-95-submenu-chevron-highlighted! []
  (draw-generated-windows-95-submenu-chevron-with-color!
   generated-menu-highlight-color))

(defun ensure-generated-menu-submenu-chevron-pair! [image highlighted-image draw! draw-highlighted!]
  (do
    (res/create-bundle! :pixils-ui)
    (when (not (generated-menu-image-exists? image))
      (res/create-image! image
                         {:size {:w 8 :h 10}}
                         draw!))
    (when (not (generated-menu-image-exists? highlighted-image))
      (res/create-image! highlighted-image
                         {:size {:w 8 :h 10}}
                         draw-highlighted!))))

(defun ensure-generated-menu-submenu-chevron! [kind]
  (cond
    (= kind :windows-3)
    (ensure-generated-menu-submenu-chevron-pair!
     generated-menu-submenu-chevron-windows-3
     generated-menu-submenu-chevron-windows-3-highlighted
     draw-generated-windows-3-submenu-chevron!
     draw-generated-windows-3-submenu-chevron-highlighted!)

    (= kind :windows-95)
    (ensure-generated-menu-submenu-chevron-pair!
     generated-menu-submenu-chevron-windows-95
     generated-menu-submenu-chevron-windows-95-highlighted
     draw-generated-windows-95-submenu-chevron!
     draw-generated-windows-95-submenu-chevron-highlighted!)

    :default
    nil))

(def shortcut-key-names
  {:key/alt "Alt"
   :key/left-alt "Alt"
   :key/right-alt "Alt"
   :key/ctrl "Ctrl"
   :key/left-ctrl "Ctrl"
   :key/right-ctrl "Ctrl"
   :key/shift "Shift"
   :key/left-shift "Shift"
   :key/right-shift "Shift"
   :key/super "Super"
   :key/left-super "Super"
   :key/right-super "Super"
   :key/enter "Enter"
   :key/escape "Esc"
   :key/delete "Del"
   :key/backspace "Backspace"
   :key/space "Space"
   :key/home "Home"
   :key/end "End"
   :key/pageup "PgUp"
   :key/pagedown "PgDn"
   :key/left "Left"
   :key/right "Right"
   :key/up "Up"
   :key/down "Down"
   :key/f1 "F1"
   :key/f2 "F2"
   :key/f3 "F3"
   :key/f4 "F4"
   :key/f5 "F5"
   :key/f6 "F6"
   :key/f7 "F7"
   :key/f8 "F8"
   :key/f9 "F9"
   :key/f10 "F10"
   :key/f11 "F11"
   :key/f12 "F12"})

(defun merge-menu-settings [parent local]
  (let [local (or local {})
        merged (merge parent local)]
    (-> merged
        (assoc :mnemonics (merge (:mnemonics parent)
                                 (or (:mnemonics local) {})))
        (assoc :shortcuts (merge (:shortcuts parent)
                                 (or (:shortcuts local) {}))))))

(defun item-settings [item]
  (let [settings (or (:settings item) {})]
    (if (contains? item :render-shortcut?)
      (assoc-in settings [:shortcuts :render] (:render-shortcut? item))
      settings)))

(defun parse-mnemonic-label [label marker trigger style index out mnemonic]
  (if (>= index (count label))
    {:text out
     :mnemonic mnemonic}
    (let [ch (nth label index)]
      (if (not= (str ch) marker)
        (parse-mnemonic-label label
                              marker
                              trigger
                              style
                              (inc index)
                              (str out ch)
                              mnemonic)
        (if (= index (dec (count label)))
          (parse-mnemonic-label label
                                marker
                                trigger
                                style
                                (inc index)
                                (str out ch)
                                mnemonic)
          (let [next-ch (nth label (inc index))]
            (if (= (str next-ch) marker)
              (parse-mnemonic-label label
                                    marker
                                    trigger
                                    style
                                    (+ index 2)
                                    (str out marker)
                                    mnemonic)
              (parse-mnemonic-label label
                                    marker
                                    trigger
                                    style
                                    (+ index 2)
                                    (str out next-ch)
                                    (or mnemonic
                                        {:char next-ch
                                         :index (count out)
                                         :trigger trigger
                                         :style style})))))))))

(defun normalize-label [item settings]
  (let [label (or (:label item) "")]
    (if (contains? item :mnemonic)
      {:text label
       :mnemonic (if (= false (:mnemonic item))
                   nil
                   (:mnemonic item))}
      (if (-> settings :mnemonics :enabled)
        (parse-mnemonic-label label
                              (-> settings :mnemonics :marker)
                              (-> settings :mnemonics :trigger)
                              (-> settings :mnemonics :style)
                              0
                              ""
                              nil)
        {:text label
         :mnemonic nil}))))

(defun mnemonic-display-text [text mnemonic render-marker]
  (if (or (nil? mnemonic)
          (nil? render-marker))
    text
    (let [index (:index mnemonic)]
      (str (substr text 0 index)
           render-marker
           (substr text index 1)
           render-marker
           (substr text (inc index))))))

(defun action-binding-action [binding]
  (cond
    (keyword? binding)
    binding

    (:action binding)
    (:action binding)

    :default
    nil))

(defun first-shortcut-for-action [action keymap]
  (if (or (nil? action)
          (empty? keymap))
    nil
    (reduce-kv keymap
               nil
               (fn [match shortcut-or-index binding]
                 (if match
                   match
                   (if (= (action-binding-action binding) action)
                     (if (:shortcut binding)
                       (:shortcut binding)
                       shortcut-or-index)
                     nil))))))

(defun shortcut-key-name [key]
  (if-let [name (get shortcut-key-names key)]
    name
    (let [raw (str key)
          value (if (= ":key/" (substr raw 0 5))
                  (substr raw 5)
                  raw)]
      (if (= 1 (count value))
        (upper-case value)
        value))))

(defun format-shortcut-parts [parts]
  (if (empty? parts)
    ""
    (let [head-text (shortcut-key-name (head parts))
          tail-parts (tail parts)]
      (if (empty? tail-parts)
        head-text
        (str head-text "+" (format-shortcut-parts tail-parts))))))

(defun format-shortcut [shortcut]
  (cond
    (nil? shortcut)
    nil

    (keyword? shortcut)
    (shortcut-key-name shortcut)

    :default
    (format-shortcut-parts shortcut)))

(defun normalize-menu-item [item inherited-settings keymap]
  (if (= :separator item)
    {:node-type :separator
     :settings inherited-settings}
    (let [settings (merge-menu-settings inherited-settings (item-settings item))
          label-data (normalize-label item settings)
          action (:action item)
          shortcut (if (contains? item :shortcut)
                     (:shortcut item)
                     (first-shortcut-for-action action keymap))
          shortcut-text (if (and (-> settings :shortcuts :render)
                                 (not (nil? shortcut)))
                          (format-shortcut shortcut)
                          nil)]
      {:node-type :item
       :item-type (or (:type item) :action)
       :action action
       :payload (:payload item)
       :disabled? (:disabled? item)
       :value (or (:value item) (:selected-value item))
       :label (:label item)
       :text (:text label-data)
       :display-text (mnemonic-display-text (:text label-data)
                                            (:mnemonic label-data)
                                            (-> settings :mnemonics :render-marker))
       :mnemonic (:mnemonic label-data)
       :settings settings
       :selected-path (:selected-path item)
       :resolved-shortcut shortcut
       :shortcut-text shortcut-text
       :items (for [child (or (:items item) [])]
                    (normalize-menu-item child settings keymap))})))

(defun normalize-menu [menu-definition keymap]
  {:node-type :root
   :settings (merge-menu-settings default-menu-settings
                                  (:settings menu-definition))
   :items (for [item (:items menu-definition)]
            (normalize-menu-item item
                                 (merge-menu-settings default-menu-settings
                                                      (:settings menu-definition))
                                 keymap))})

(defun selectable-item? [node]
  (and (not= :separator (:node-type node))
       (not (:disabled? node))))

(defun first-selectable-index [items]
  (let [indexed (for-indexed [index item items]
                  {:index index
                   :item item})
        selected (head (filter indexed (fn [entry]
                                         (selectable-item? (:item entry)))))]
    (if selected
      (:index selected)
      0)))

(defun selectable-indices [items]
  (map (filter (for-indexed [index item items]
                 {:index index
                  :item item})
               (fn [entry]
                 (selectable-item? (:item entry))))
       :index))

(defun highlighted-item [items highlighted-index]
  (if (and highlighted-index
           (>= highlighted-index 0)
           (< highlighted-index (count items)))
    (nth items highlighted-index)
    nil))

(defun normalized-mnemonic-char [value]
  (if (or (nil? value)
          (empty? value))
    nil
    (upper-case (substr value 0 1))))

(defun event-mnemonic-char [event]
  (if-let [text (kbd/event->text event)]
    (normalized-mnemonic-char text)
    nil))

(defun find-mnemonic-index [items mnemonic-char]
  (let [indexed (for-indexed [index item items]
                  {:index index
                   :item item})
        match (head (filter indexed (fn [entry]
                                      (and (selectable-item? (:item entry))
                                           (= mnemonic-char (-> entry
                                                                :item
                                                                :mnemonic
                                                                :char
                                                                str
                                                                upper-case))))))]
    (if match
      (:index match)
      nil)))

(defun child-view-at [view index]
  (let [children (ui/children view)]
    (when (and (>= index 0)
               (< index (count children)))
      (nth children index))))

(defun top-menu-item-at [menu index]
  (let [items (:items menu)]
    (when (and (>= index 0)
               (< index (count items)))
      (nth items index))))

(defun wrap-index [index count]
  (cond
    (< index 0)
    (+ index count)

    (>= index count)
    (- index count)

    :default
    index))

(defun move-highlight-index [items highlighted-index direction]
  (let [indices (selectable-indices items)]
    (if (empty? indices)
      highlighted-index
      (let [current-pos (find-index indices (fn [idx] (= idx highlighted-index)))
            fallback-pos 0
            start-pos (if (or (nil? current-pos)
                              (< current-pos 0))
                        fallback-pos
                        current-pos)
            next-pos (wrap-index (+ start-pos direction) (count indices))]
        (nth indices next-pos)))))

(defun activate-menu-index! [state ctx index]
  (let [node (highlighted-item (:items state) index)
        child-view (child-view-at (:view ctx) index)]
    (cond
      (and node
           child-view
           (not (:disabled? node))
           (not (empty? (:items node))))
      (do
        (open-submenu! node state child-view)
        state)

      (and node
           (not (:disabled? node))
           (empty? (:items node))
           (:action node))
      (do
        (ui/emit! (:view ctx)
                  :menu/select
                  {:type :action
                   :action (:action node)
                   :payload (:payload node)})
        state)

      :default
      state)))

(defun make-menu-node [{:keys [state menu-definition keymap style] :as opts}]
  (let [normalized-menu (normalize-menu menu-definition keymap)]
    {:mode 'ui/menu-bar
     :style (or style {})
     :state (merge (or state {})
                   {:menu normalized-menu
                    :menu-scale (or (:menu-scale state)
                                    (:scale style))
                    :active-index nil
                    :pending-open-index nil})
     :children (for-indexed [index item (:items normalized-menu)]
                 {:mode 'ui/menu-bar-item
                  :style {:padding [2 8]}
                  :state {:node item
                          :menu-index index
                          :disabled? (:disabled? item)
                          :active-index (ui/bind-state :active-index)
                          :pending-open-index (ui/bind-state :pending-open-index)
                          :text (:display-text item)
                          :menu-scale (ui/bind-state :menu-scale)
                          :option-state (ui/bind-state :option-state)
                          :game (ui/bind-state :game)
                          :preferences (ui/bind-state :preferences)}})}))

(defun make-menu-options [options menu-definition keymap]
  (merge (if (or (contains? options :state)
                 (contains? options :style))
           options
           {:state options})
         {:menu-definition menu-definition
          :keymap keymap}))

(defun make-menu [options menu-definition keymap]
  (make-menu-node (make-menu-options options menu-definition keymap)))

(defun item-selected? [node state]
  (let [selected-path (:selected-path node)
        selected-value (get-in state selected-path)]
    (cond
      (= (:item-type node) :toggle)
      selected-value

      (= (:item-type node) :option)
      (= selected-value (:value node))

      :default
      false)))

(defun popup-item-state [node state]
  {:node node
   :index (:index state)
   :highlighted-index (:highlighted-index state)
   :input-source (:input-source state)
   :menu-depth (:menu-depth state)
   :text (:display-text node)
   :shortcut-text (:shortcut-text node)
   :disabled? (:disabled? node)
   :has-submenu (not (empty? (:items node)))
   :option-state (:option-state state)
   :game (:game state)
   :preferences (:preferences state)})

(defun popup-option-item-state [node state]
  (merge (popup-item-state node state)
         {:selected (item-selected? node state)}))

(defun popup-item-child [node state]
  (cond
    (= :separator (:node-type node))
    {:mode 'ui/menu-separator}

    (or (= (:item-type node) :option)
        (= (:item-type node) :toggle))
    {:mode 'ui/popup-menu-option-item
     :state (popup-option-item-state node state)}

    :default
    {:mode 'ui/popup-menu-item
     :state (popup-item-state node state)}))

(defun popup-position [anchor-view placement]
  (let [bounds (:bounds anchor-view)]
    (case placement
      :right {:left (+ (:x bounds) (:w bounds))
              :top (:y bounds)}
      :default {:left (:x bounds)
                :top (+ (:y bounds) (:h bounds))})))

(defun view-scale [view]
  (or (-> view :effective-style :scale)
      (-> view :style :scale)))

(defun popup-menu-children [items state position]
  [{:mode 'ui/popup-menu-outer
    :state {:items (ui/bind-state :items)
            :highlighted-index (ui/bind-state :highlighted-index)
            :input-source (ui/bind-state :input-source)
            :menu-depth (ui/bind-state :menu-depth)
            :menu-scale (ui/bind-state :menu-scale)
            :option-state (ui/bind-state :option-state)
            :game (ui/bind-state :game)
            :preferences (ui/bind-state :preferences)}
    :style {:position :absolute
            :width :shrink
            :height :shrink
            :left (:left position)
            :top (:top position)}
    :children [{:mode 'ui/popup-menu-inner
                :state {:items (ui/bind-state :items)
                        :highlighted-index (ui/bind-state :highlighted-index)
                        :input-source (ui/bind-state :input-source)
                        :menu-depth (ui/bind-state :menu-depth)
                        :menu-scale (ui/bind-state :menu-scale)
                        :option-state (ui/bind-state :option-state)
                        :game (ui/bind-state :game)
                        :preferences (ui/bind-state :preferences)}
                :children (for-indexed [index item items]
                            (merge (popup-item-child item {:node item
                                                           :index index
                                                           :highlighted-index (ui/bind-state :highlighted-index)
                                                           :input-source (ui/bind-state :input-source)
                                                           :menu-depth (ui/bind-state :menu-depth)
                                                           :menu-scale (ui/bind-state :menu-scale)
                                                           :option-state (ui/bind-state :option-state)
                                                           :game (ui/bind-state :game)
                                                           :preferences (ui/bind-state :preferences)})
                                   {:style {:width :fill}}))}]}])

(defun open-popup-at-position! [items state origin-view position]
  (when (not (empty? items))
    (push-mode!
     (or (:popup-mode state) 'ui/popup-menu)
     {:items items
      :highlighted-index (first-selectable-index items)
      :input-source :mouse
      :menu-depth (or (:menu-depth state) 0)
      :menu-scale (:menu-scale state)
      :option-state (:option-state state)
      :game (:game state)
      :preferences (:preferences state)}
     {:origin {:view origin-view :event :menu/select}
      :style {:scale (:menu-scale state)}
      :children (popup-menu-children items state position)})))

(defun open-popup-at-view! [node state anchor-view placement]
  (when-let [items (:items node)]
    (when (not (empty? items))
      (let [position (popup-position anchor-view placement)]
        (open-popup-at-position! items state anchor-view position)))))

(defun open-context-menu! [menu-definition position state ctx]
  (let [menu (normalize-menu menu-definition (:keymap state))]
    (open-popup-at-position! (:items menu)
                             (assoc state :popup-mode 'ui/context-menu)
                             (:view ctx)
                             {:left (:x position)
                              :top (:y position)})))

(defun open-popup! [node state ctx]
  (open-popup-at-view! node state (:view ctx) :below))

(defun open-submenu! [node state anchor-view]
  (open-popup-at-view! node
                       (assoc state :menu-depth (inc (or (:menu-depth state) 0)))
                       anchor-view
                       :right))



;; Menu components

(defcomponent ui/menu-bar-item
  {:class :menu/item
   :update (fn [state ctx]
             (let [hovered (-> ctx :view :interaction :hovered)
                   highlighted (and (not (:disabled? state))
                                    (if (nil? (:active-index state))
                                      hovered
                                      (= (:menu-index state) (:active-index state))))]
               (assoc state :highlighted highlighted)))
   :on-mouse-down (fn [state event ctx]
                    (let [node (:node state)]
                      (ui/stop-propagation! event)
                      (cond
                        (and node
                             (not (:disabled? node))
                             (not (empty? (:items node))))
                        (assoc (assoc state
                                      :active-index
                                      (:menu-index state))
                               :pending-open-index
                               (:menu-index state))

                        (and node
                             (not (:disabled? node))
                             (:action node))
                        (do
                          (ui/emit! (:view ctx)
                                    (:action node)
                                    (:payload node))
                          state)

                        :default
                        state)))
   :on {:menu/select (fn [state event ctx]
                       (let [payload (:payload event)]
                         (cond
                           (= :navigate-top (:type payload))
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :menu/navigate-top
                                       {:direction (:direction payload)
                                        :menu-index (:menu-index state)})
                             state)

                           (and (= :action (:type payload))
                                (not (:disabled? state)))
                           (do
                             (ui/emit! (:view ctx)
                                       (:action payload)
                                       (:payload payload))
                             state)

                           :default
                           state)))}
   :children [{:mode 'ui/text
               :state {:value (ui/bind-state :text)}}]})

(defcomponent ui/popup-menu-item
  {:class :menu/item
   :style {:layout {:direction :row}}
   :update (fn [state ctx]
             (let [hovered (-> ctx :view :interaction :hovered)
                   highlighted (and (not (:disabled? state))
                                    (if (= :mouse (:input-source state))
                                      hovered
                                      (= (:index state) (:highlighted-index state))))]
               (assoc state :highlighted highlighted)))
   :on-mouse-motion (fn [state event ctx]
                      (if (:disabled? state)
                        state
                        (assoc (assoc state :input-source :mouse)
                               :highlighted-index (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (when (not (:disabled? state))
                        (open-submenu! (:node state) state (:view ctx)))
                      (ui/stop-propagation! event)
                      state))
   :on-mouse-up (fn [state event ctx]
                 (let [node (:node state)]
                    (when (and (not (:disabled? state))
                               (empty? (:items node)))
                      (ui/emit! (:view ctx)
                                :menu/select
                                {:type :action
                                 :action (:action node)
                                 :payload (:payload node)})))
                  state)
   :on {:menu/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (when (not (:disabled? state))
                         (ui/emit! (:view ctx) :menu/select (:payload event)))
                       state)}
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :text)}}
              {:mode 'ui/text
               :class :menu/shortcut-column
               :state {:value (ui/bind-state :shortcut-text)}}
              {:mode 'ui/menu-submenu-indicator
               :state {:has-submenu (ui/bind-state :has-submenu)
                       :highlighted (ui/bind-state :highlighted)}}]})

(defun render-menu-submenu-indicator! [state ctx]
  (let [indicator (ui/theme-var ctx :menu-submenu-indicator {})
        highlighted (:highlighted state)
        text (if (:has-submenu state)
               (or (if highlighted (:highlighted-text indicator) nil)
                   (:text indicator)
                   "")
               "")
        image (if (:has-submenu state)
                (or (if highlighted (:highlighted-image indicator) nil)
                    (:image indicator))
                nil)
        text-args (menu-option-indicator-text-args (-> ctx :view :effective-style))]
    (do
      (when (and (:has-submenu state)
                 (:generated-chevron indicator))
        (ensure-generated-menu-submenu-chevron! (:generated-chevron indicator)))
      (when image
        (r/image! image {:x 0 :y 0}))
      (when (not (empty? text))
        (r/text! text {:x 0 :y 0} text-args)))))

(defcomponent ui/menu-submenu-indicator
  {:class :menu/submenu-indicator
   :render render-menu-submenu-indicator!})

(defun menu-option-indicator-text [state indicator]
  (if (:selected state)
    (or (:selected-text indicator) "")
    (or (:unselected-text indicator) "")))

(defun menu-option-indicator-image [state indicator]
  (if (:selected state)
    (:selected-image indicator)
    nil))

(defun menu-option-indicator-text-args [style]
  (reduce-kv (or (:text style) {})
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k (if (= k :font)
                                    (if (keyword? v)
                                      v
                                      (keyword v))
                                    v)})))))

(defun render-menu-option-indicator! [state ctx]
  (let [indicator (ui/theme-var ctx :menu-option-indicator {})
        image (menu-option-indicator-image state indicator)
        text (menu-option-indicator-text state indicator)
        text-args (menu-option-indicator-text-args (-> ctx :view :effective-style))]
    (do
      (when (and (:selected state)
                 (:ensure-generated-checkmark? indicator))
        (ensure-generated-menu-option-checkmark!))
      (when image
        (r/image! image {:x 0 :y 0}))
      (when (not (empty? text))
        (r/text! text {:x 0 :y 0} text-args)))))

(defcomponent ui/menu-option-indicator
  {:class :menu/option-indicator
   :render render-menu-option-indicator!})

(defcomponent ui/popup-menu-option-item
  {:class :menu/item
   :style {:layout {:direction :row}}
   :update (fn [state ctx]
             (let [hovered (-> ctx :view :interaction :hovered)
                   highlighted (and (not (:disabled? state))
                                    (if (= :mouse (:input-source state))
                                      hovered
                                      (= (:index state) (:highlighted-index state))))]
               (assoc (assoc state
                             :highlighted
                             highlighted)
                      :selected
                      (item-selected? (:node state) state))))
   :on-mouse-motion (fn [state event ctx]
                      (if (:disabled? state)
                        state
                        (assoc (assoc state :input-source :mouse)
                               :highlighted-index (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    state)
   :on-mouse-up (fn [state event ctx]
                  (let [node (:node state)]
                    (when (not (:disabled? state))
                      (ui/emit! (:view ctx)
                                :menu/select
                                {:type :action
                                 :action (:action node)
                                 :payload (:payload node)})))
                  state)
   :children [{:mode 'ui/menu-option-indicator
               :state {:selected (ui/bind-state :selected)}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :text)}}
              {:mode 'ui/text
               :state {:value (ui/bind-state :shortcut-text)}}]})

(defcomponent ui/menu-separator {})



;; Menu bar and popup menu modes

(defcomponent ui/menu-bar
  {:update (fn [state ctx]
             (let [state (assoc state
                                :menu-scale
                                (or (view-scale (:view ctx))
                                    (:menu-scale state)))
                   pending-open-index (:pending-open-index state)]
               (if (nil? pending-open-index)
                 state
                 (let [menu (:menu state)
                       next-node (top-menu-item-at menu pending-open-index)
                       next-view (child-view-at (:view ctx) pending-open-index)]
                   (when (and next-node next-view)
                     (open-popup-at-view! next-node state next-view :below))
                   (assoc state :pending-open-index nil)))))
   :style {:width :fill
           :layout {:direction :row}}
   :on {:menu/navigate-top (fn [state event ctx]
                             (let [payload (:payload event)]
                               (let [menu (:menu state)
                                     items (:items menu)
                                     current-index (:menu-index payload)
                                     direction (if (= :left (:direction payload)) -1 1)
                                     next-index (wrap-index (+ current-index direction)
                                                            (count items))
                                     next-state (assoc (assoc state
                                                              :active-index next-index)
                                                       :pending-open-index next-index)]
                                 (ui/stop-propagation! event)
                                 next-state)))
        :menu/select (fn [state event ctx]
                       (assoc (assoc state :active-index nil)
                              :pending-open-index nil))}})

(defmode ui/popup-menu
  {:on-mouse-down (fn [state event ctx]
                    (pop-mode! {:type :dismiss})
                    state)
   :on {:menu/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (pop-mode! (:payload event))
                       state)}
   :compose {:render :pass}})

(defmode ui/context-menu
  {:on-mouse-down (fn [state event ctx]
                    (pop-mode! {:type :dismiss})
                    state)
   :on {:menu/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (pop-mode! (:payload event))
                       state)}
   :compose {:render :pass}})

(defcomponent ui/popup-menu-outer {})

(defcomponent ui/popup-menu-inner
  {:focusable true
   :init (fn [state ctx]
           (ui/focus! ctx)
           state)
   :on-key-down (fn [state event ctx]
                  (case (:key event)
                    :key/right
                    (let [index (:highlighted-index state)]
                      (ui/stop-propagation! event)
                      (let [next-state (assoc state :input-source :keyboard)]
                        (let [node (highlighted-item (:items next-state) index)
                              child-view (child-view-at (:view ctx) index)]
                          (when (and node
                                     child-view
                                     (not (empty? (:items node))))
                            (open-submenu! node next-state child-view))
                          (if (and (= 0 (:menu-depth next-state))
                                   (or (nil? node)
                                       (empty? (:items node))))
                          (do
                            (pop-mode! {:type :navigate-top
                                        :direction :right})
                            next-state)
                          next-state))))

                    :key/left
                    (let [next-state (assoc state :input-source :keyboard)]
                      (ui/stop-propagation! event)
                      (if (= 0 (:menu-depth next-state))
                        (do
                          (pop-mode! {:type :navigate-top
                                      :direction :left})
                          next-state)
                        (do
                          (pop-mode!)
                          next-state)))

                    :key/down
                    (do
                      (ui/stop-propagation! event)
                      (assoc (assoc state
                                    :input-source :keyboard)
                             :highlighted-index
                             (move-highlight-index (:items state)
                                                   (:highlighted-index state)
                                                   1)))

                    :key/up
                    (do
                      (ui/stop-propagation! event)
                      (assoc (assoc state
                                    :input-source :keyboard)
                             :highlighted-index
                             (move-highlight-index (:items state)
                                                   (:highlighted-index state)
                                                   -1)))

                    :key/escape
                    (do
                      (ui/stop-propagation! event)
                      (if (= 0 (:menu-depth state))
                        (pop-mode! {:type :dismiss})
                        (pop-mode!))
                      (assoc state :input-source :keyboard))

                    :key/enter
                    (let [index (:highlighted-index state)
                          next-state (assoc state :input-source :keyboard)]
                      (ui/stop-propagation! event)
                      (activate-menu-index! next-state ctx index))

                    :default
                    (let [mnemonic-char (event-mnemonic-char event)
                          next-state (assoc state :input-source :keyboard)
                          index (find-mnemonic-index (:items next-state)
                                                     mnemonic-char)]
                      (cond
                        (not (nil? index))
                        (do
                          (ui/stop-propagation! event)
                          (activate-menu-index! (assoc next-state
                                                       :highlighted-index index)
                                               ctx
                                               index))

                        :default
                        state))))})
