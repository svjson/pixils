(ns pixils.ui.window
  (:require pixils
            [pixils.point :as pt]
            pixils.ui.button
            [pixils.ui :as ui]))

(defun emit-window-move! [event ctx]
  (ui/emit! (:view ctx) :window/move-by (:delta event)))

(def default-window-capabilities
  {:movable? true
   :minimizable? true
   :system-menu? true
   :closable? false
   :resizable? false
   :maximizable? false})

(def fixed-frame-capabilities
  {:movable? false
   :minimizable? false
   :system-menu? false
   :closable? false
   :resizable? false
   :maximizable? false})

(defun normalize-window-kind [kind]
  (or kind :window))

(defun default-window-chrome [kind]
  (case kind
    :panel :none
    :frame :frame
    :dialog-frame :dialog-frame
    :default :standard))

(defun normalize-window-chrome [kind chrome]
  (or chrome (default-window-chrome kind)))

(defun chrome-default-capabilities [chrome]
  (case chrome
    :standard default-window-capabilities
    :default fixed-frame-capabilities))

(defun normalize-window-capabilities [chrome capabilities]
  (merge (chrome-default-capabilities chrome)
         (or capabilities {})))

(defun window-movable? [state]
  (not= (-> state :window/capabilities :movable?) false))

(defun window-minimizable? [capabilities]
  (not= (:minimizable? capabilities) false))

(defun window-system-menu? [capabilities]
  (not= (:system-menu? capabilities) false))

(defun option-classes [classes]
  (cond
    (nil? classes) []
    (keyword? classes) [classes]
    :default classes))

(defun window-chrome-class [chrome]
  (case chrome
    :none :window/chrome-none
    :frame :window/chrome-frame
    :dialog-frame :window/chrome-dialog-frame
    :default :window/chrome-standard))

(defun window-kind-class [kind]
  (case kind
    :panel :window/kind-panel
    :frame :window/kind-frame
    :dialog-frame :window/kind-dialog-frame
    :dialog :window/kind-dialog
    :default :window/kind-window))

(defun window-classes [kind chrome classes]
  (concat [(window-kind-class kind)
           (window-chrome-class chrome)]
          (option-classes classes)))

(defun known-window-size-axis [external-bounds style bounds style-key bounds-key]
  (let [external-value (get (or external-bounds {}) bounds-key)
        style-value (get (or style {}) style-key)
        bounds-value (get (or bounds {}) bounds-key)]
    (cond
      (and (number? external-value) (> external-value 0)) external-value
      (number? style-value) style-value
      (and (number? bounds-value) (> bounds-value 0)) bounds-value
      :default nil)))

(defun clamp [value low high]
  (max low (min high value)))

(defun known-window-size [ctx]
  (let [external-bounds (-> ctx :view :external-bounds)
        style (-> ctx :view :style)
        bounds (-> ctx :view :bounds)]
    {:w (known-window-size-axis external-bounds style bounds :width :w)
     :h (known-window-size-axis external-bounds style bounds :height :h)}))

(def pending-window-position {:x -100000 :y -100000})

(defun normalize-window-auto-focus [opts auto-focus auto-focus?]
  (cond
    (contains? opts :auto-focus)
    (if (= auto-focus true)
      :window
      auto-focus)

    (contains? opts :auto-focus?)
    (if auto-focus?
      :window
      false)

    :default
    :window))

(defun layout-frame-size [ctx]
  (let [buffer (:buffer-size ctx)]
    {:w (or (:available-width ctx) (:w buffer))
     :h (or (:available-height ctx) (:h buffer))}))

(defun layout-frame-region [ctx]
  (merge {:x 0 :y 0}
         (layout-frame-size ctx)))

(defun window-size-axis [size axis]
  (case axis
    :x (:w size)
    :y (:h size)
    :default nil))

(defun region-axis [region axis]
  (case axis
    :x (:x region)
    :y (:y region)
    :default nil))

(defun region-size-axis [region axis]
  (case axis
    :x (:w region)
    :y (:h region)
    :default nil))

(defun position-axis [pos axis]
  (case axis
    :x (:x pos)
    :y (:y pos)
    :default nil))

(defun set-position-axis [pos axis value]
  (case axis
    :x (assoc pos :x value)
    :y (assoc pos :y value)
    :default pos))

(defun centered-window-axis-in-region [ctx axis region]
  (let [size (known-window-size ctx)
        frame-size (region-size-axis region axis)
        window-size (window-size-axis size axis)]
    (when (and (number? frame-size)
               (number? window-size))
      (int (+ (region-axis region axis)
              (/ (- frame-size window-size) 2))))))

(defun centered-window-axis [ctx axis]
  (centered-window-axis-in-region ctx axis (layout-frame-region ctx)))

(defun centered-window-position [ctx]
  (let [x (centered-window-axis ctx :x)
        y (centered-window-axis ctx :y)]
    (when (and (number? x) (number? y))
      {:x x :y y})))

(defun contained-window-axis [value ctx axis region]
  (let [window-size (window-size-axis (known-window-size ctx) axis)
        region-start (region-axis region axis)
        region-size (region-size-axis region axis)]
    (if (and (number? value)
             (number? window-size)
             (number? region-start)
             (number? region-size))
      (clamp value region-start (max region-start
                                     (- (+ region-start region-size)
                                        window-size)))
      value)))

(defun constrained-window-position [pos ctx region]
  (if (not (nil? pos))
    {:x (contained-window-axis (:x pos) ctx :x region)
     :y (contained-window-axis (:y pos) ctx :y region)}
    pos))

(defun window-constraint-region [constraints ctx]
  (let [bounds (:bounds constraints)]
    (cond
      (= (type-of bounds) "map") (merge {:x 0 :y 0} bounds)
      (= bounds :parent) (layout-frame-region ctx)
      (nil? bounds) (layout-frame-region ctx)
      :default (layout-frame-region ctx))))

(defun window-constraint-axis [constraints axis]
  (or (get constraints axis) :allow))

(defun window-axis-overflows? [value ctx axis region]
  (let [window-size (window-size-axis (known-window-size ctx) axis)
        region-start (region-axis region axis)
        region-size (region-size-axis region axis)]
    (and (number? value)
         (number? window-size)
         (number? region-start)
         (number? region-size)
         (or (< value region-start)
             (> (+ value window-size) (+ region-start region-size))))))

(defun apply-window-constraint-axis [pos ctx constraints axis]
  (let [policy (window-constraint-axis constraints axis)
        region (window-constraint-region constraints ctx)
        value (position-axis pos axis)]
    (case policy
      :contain (set-position-axis pos
                                  axis
                                  (contained-window-axis value ctx axis region))
      :center-on-overflow
      (if (window-axis-overflows? value ctx axis region)
        (set-position-axis pos axis (centered-window-axis-in-region ctx axis region))
        pos)

      :default pos)))

(defun apply-window-constraints [pos ctx constraints]
  (if (and (not (nil? pos)) (not (nil? constraints)))
    (apply-window-constraint-axis
     (apply-window-constraint-axis pos ctx constraints :x)
     ctx
     constraints
     :y)
    pos))

(defun axis-placement-policy [placement phase axis default]
  (or (get (or (get (or placement {}) phase) {}) axis)
      default))

(defun placed-window-axis [state ctx phase axis]
  (let [explicit-or-moved? (or (:window/explicit-position? state)
                              (:window/moved? state))
        current (position-axis (or (:position state) {:x 0 :y 0}) axis)
        default (if explicit-or-moved? :keep :center)
        policy (cond
                 (and (= phase :initial) explicit-or-moved?) :keep
                 (= phase :initial) (axis-placement-policy (:window/placement state)
                                                           :initial
                                                           axis
                                                           :center)
                 (= phase :settled) :keep
                 :default (axis-placement-policy (:window/placement state)
                                                 :resize
                                                 axis
                                                 default))]
    (case policy
      :center (centered-window-axis ctx axis)
      :keep current
      :default current)))

(defun placed-window-position [state ctx phase]
  (let [x (placed-window-axis state ctx phase :x)
        y (placed-window-axis state ctx phase :y)]
    (when (and (number? x) (number? y))
      {:x x :y y})))

(defun window-size-changed? [state ctx]
  (not (= (:window/placed-size state)
          (known-window-size ctx))))

(defun window-position-phase [state ctx]
  (cond
    (not (:window/placed? state)) :initial
    (window-size-changed? state ctx) :resize
    :default :settled))

(defun managed-window-position [state ctx phase]
  (apply-window-constraints
   (placed-window-position state ctx phase)
   ctx
   (:window/constraints state)))

(defun window-position [state ctx]
  (if (:window/placement state)
    (managed-window-position state ctx (window-position-phase state ctx))
    (or (:position state)
        (let [centered (centered-window-position ctx)]
          (when centered
            (if (:window/constraints state)
              (apply-window-constraints centered ctx (:window/constraints state))
              (constrained-window-position centered ctx (layout-frame-region ctx))))))))

(defun sync-window-position-style! [view pos]
  (let [style (:style view)]
    (when (and (not (nil? pos))
               (or (nil? style)
                   (not (= (:position style) :absolute))
                   (not (= (:left style) (:x pos)))
                   (not (= (:top style) (:y pos)))))
      (ui/style! view
                 {:position :absolute
                  :left (:x pos)
                  :top (:y pos)}))))

(defun stabilize-window-position-after-layout [state ctx]
  (if (:window/placement state)
    (let [pos (managed-window-position state ctx (window-position-phase state ctx))]
      (if (nil? pos)
        state
        (let [next-state (assoc (assoc state :window/placed? true)
                                :window/placed-size
                                (known-window-size ctx))]
          (sync-window-position-style! (:view ctx) pos)
          (if (= pos (:position next-state))
            next-state
            (assoc next-state :position pos)))))
    (if (or (:window/explicit-position? state)
            (:window/moved? state))
      (let [pos (apply-window-constraints (:position state)
                                          ctx
                                          (:window/constraints state))]
        (if (or (nil? pos)
                (= pos (:position state)))
          state
          (let [next-state (assoc state :position pos)]
            (sync-window-position-style! (:view ctx) pos)
            next-state)))
      (let [centered (centered-window-position ctx)
            pos (if centered
                  (if (:window/constraints state)
                    (apply-window-constraints centered ctx (:window/constraints state))
                    (constrained-window-position centered ctx (layout-frame-region ctx)))
                  (:position state))]
        (if (nil? pos)
          state
          (let [next-state (if (= pos (:position state))
                             state
                             (assoc state :position pos))]
            (sync-window-position-style! (:view ctx) pos)
            next-state))))))

(defcomponent ui/window-control-button
  {})

(defcomponent ui/window-minimize-button
  {:extend 'ui/button
   :class :window/minimize-button})

(defcomponent ui/window-title-bar
  {:on-drag-start (fn [state event ctx]
                    (when (window-movable? state)
                      (emit-window-move! event ctx))
                    state)
   :on-drag (fn [state event ctx]
              (when (window-movable? state)
                (emit-window-move! event ctx))
              state)
   :children [{:mode 'ui/window-control-button}
              {:mode 'ui/text
               :style {:padding [3 2]}
               :state {:value (ui/bind-state :title)}}
              {:mode 'ui/window-minimize-button}]})

(defcomponent ui/window-body
  {})

(defcomponent ui/window
  {:focusable true
   :update (fn [state ctx]
             (let [pos (window-position state ctx)
                   draw-pos (or pos pending-window-position)
                   next-state (if (or (nil? pos)
                                      (= pos (:position state)))
                                state
                                (assoc state :position pos))
                   view (:view ctx)]
               (sync-window-position-style! view draw-pos)
               (if (:window/auto-focus-pending? next-state)
                 (let [focused-state (assoc next-state
                                            :window/auto-focus-pending?
                                            false)]
                   (case (:window/auto-focus next-state)
                     :first-body
                     (when (nil? (ui/focus-first! ctx 'ui/window-body))
                       (ui/focus! ctx))

                     :window
                     (ui/focus! ctx)

                     :default
                     nil)
                   focused-state)
                 next-state)))
   :after-layout stabilize-window-position-after-layout
   :on {:window/move-by (fn [state event ctx]
                          (ui/stop-propagation! event)
                          (if (window-movable? state)
                            (let [next-position (apply-window-constraints
                                                 (pt/+ (or (:position state)
                                                           (window-position state ctx))
                                                       (:payload event))
                                                 ctx
                                                 (:window/constraints state))]
                              (sync-window-position-style! (:view ctx) next-position)
                              (assoc state
                                     :position next-position
                                     :window/moved? true))
                            state))}
   :children [{:mode 'ui/window-title-bar}
              {:mode 'ui/window-body}]})


(defun window-init [auto-focus init]
  (fn [state ctx]
    (when (or (= auto-focus :window)
              (= auto-focus true))
      (ui/focus! ctx))
    (if init
      (apply init [state ctx])
      state)))

(defun title-bar-children [capabilities]
  (concat (if (window-system-menu? capabilities)
            [{:mode 'ui/window-control-button}]
            [])
          [{:mode 'ui/text
            :style {:padding [3 2]}
            :state {:value (ui/bind-state :title)}}]
          (if (window-minimizable? capabilities)
            [{:mode 'ui/window-minimize-button}]
            [])))

(defun window-title-bar-child [title-bar capabilities]
  {:mode 'ui/window-title-bar
   :state (merge (or title-bar {})
                 {:window/capabilities capabilities})
   :children (title-bar-children capabilities)})

(defun window-body-child [body body-style state]
  {:mode 'ui/window-body
   :style (or body-style {})
   :children body
   :state (or state {})})

(defun window-children [chrome title-bar capabilities body body-style state]
  (if (= chrome :standard)
    [(window-title-bar-child title-bar capabilities)
     (window-body-child body body-style state)]
    [(window-body-child body body-style state)]))

(defun make [{:keys [title-bar body body-style init state style position placement
                     constraints auto-focus auto-focus? class kind chrome capabilities]
              :as opts}]
  (let [explicit-position? (contains? opts :position)
        auto-focus (normalize-window-auto-focus opts auto-focus auto-focus?)
        kind (normalize-window-kind kind)
        chrome (normalize-window-chrome kind chrome)
        capabilities (normalize-window-capabilities chrome capabilities)
        window-state (merge (or state {})
                            {:window/explicit-position? explicit-position?
                             :window/kind kind
                             :window/chrome chrome
                             :window/capabilities capabilities
                             :window/placement placement
                             :window/constraints constraints
                             :window/auto-focus auto-focus
                             :window/auto-focus-pending? (= auto-focus :first-body)})
        window-state (if explicit-position?
                       (assoc window-state :position position)
                       window-state)]
    {:mode 'ui/window
     :init (window-init auto-focus init)
     :class (window-classes kind chrome class)
     :style (or style {})
     :state window-state
     :children (window-children chrome
                                title-bar
                                capabilities
                                body
                                body-style
                                state)}))
