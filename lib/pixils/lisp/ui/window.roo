(ns pixils.ui.window
  (:require pixils
            [pixils.point :as pt]
            pixils.ui.button
            [pixils.ui :as ui]))

(defun emit-window-move! [event ctx]
  (ui/emit! (:view ctx) :window/move-by (:delta event)))

(defun known-window-size-axis [external-bounds style bounds style-key bounds-key]
  (let [external-value (get (or external-bounds {}) bounds-key)
        style-value (get (or style {}) style-key)
        bounds-value (get (or bounds {}) bounds-key)]
    (cond
      (and (number? external-value) (> external-value 0)) external-value
      (number? style-value) style-value
      (and (number? bounds-value) (> bounds-value 0)) bounds-value
      :default nil)))

(defun clamp [value low high]
  (max low (min high value)))

(defun known-window-size [ctx]
  (let [external-bounds (-> ctx :view :external-bounds)
        style (-> ctx :view :style)
        bounds (-> ctx :view :bounds)]
    {:w (known-window-size-axis external-bounds style bounds :width :w)
     :h (known-window-size-axis external-bounds style bounds :height :h)}))

(defun centered-window-position [ctx]
  (let [buffer (:buffer-size ctx)
        size (known-window-size ctx)
        width (:w size)
        height (:h size)]
    (when (and (not (nil? buffer))
               (number? (:w buffer))
               (number? (:h buffer))
               (number? width)
               (number? height))
      {:x (int (/ (- (:w buffer) width) 2))
       :y (int (/ (- (:h buffer) height) 2))})))

(defun constrained-window-position [pos ctx]
  (let [buffer (:buffer-size ctx)
        size (known-window-size ctx)
        width (:w size)
        height (:h size)]
    (if (and (not (nil? pos))
             (not (nil? buffer))
             (number? (:w buffer))
             (number? (:h buffer))
             (number? width)
             (number? height))
      {:x (clamp (:x pos) 0 (max 0 (- (:w buffer) width)))
       :y (clamp (:y pos) 0 (max 0 (- (:h buffer) height)))}
      pos)))

(defun window-position [state ctx]
  (if (or (:window/explicit-position? state)
          (:window/moved? state))
    (or (:position state) {:x 0 :y 0})
    (constrained-window-position
     (or (centered-window-position ctx)
         (:position state)
         {:x 0 :y 0})
     ctx)))

(defcomponent ui/window-control-button
  {})

(defcomponent ui/window-minimize-button
  {:extend 'ui/button
   :class :window/minimize-button})

(defcomponent ui/window-title-bar
  {:on-drag-start (fn [state event ctx]
                    (emit-window-move! event ctx)
                    state)
   :on-drag (fn [state event ctx]
              (emit-window-move! event ctx)
              state)
   :children [{:mode 'ui/window-control-button}
              {:mode 'ui/text
               :style {:padding [3 2]}
               :state {:value (ui/bind-state :title)}}
              {:mode 'ui/window-minimize-button}]})

(defcomponent ui/window-body
  {})

(defcomponent ui/window
  {:focusable true
   :update (fn [state ctx]
             (let [pos (window-position state ctx)
                   next-state (if (= pos (:position state))
                                state
                                (assoc state :position pos))
                   view (:view ctx)
                   style (:style view)]
               (when (or (nil? style)
                         (not (= (:position style) :absolute))
                         (not (= (:left style) (:x pos)))
                         (not (= (:top style) (:y pos))))
                 (ui/style! view
                            {:position :absolute
                             :left (:x pos)
                             :top (:y pos)}))
               next-state))
   :on {:window/move-by (fn [state event ctx]
                          (ui/stop-propagation! event)
                          (assoc state
                                 :position (pt/+ (window-position state ctx)
                                                 (:payload event))
                                 :window/moved? true))}
   :children [{:mode 'ui/window-title-bar}
              {:mode 'ui/window-body}]})


(defun window-init [auto-focus? init]
  (fn [state ctx]
    (do
      (when auto-focus?
        (ui/focus! ctx))
      (if init
        (apply init [state ctx])
        state))))

(defun make [{:keys [title-bar body init state style position auto-focus?] :as opts}]
  (let [explicit-position? (contains? opts :position)
        auto-focus? (if (contains? opts :auto-focus?)
                      auto-focus?
                      true)
        window-state (merge (or state {})
                            {:window/explicit-position? explicit-position?})
        window-state (if explicit-position?
                       (assoc window-state :position position)
                       window-state)]
    {:mode 'ui/window
     :init (window-init auto-focus? init)
     :style (or style {})
     :state window-state
     :children [{:mode 'ui/window-title-bar
                 :state title-bar}
                {:mode 'ui/window-body
                 :children body
                 :state (or state {})}]}))
