(ns pixils.ui.scroll-pane
  (:require pixils
            [pixils.ui :as ui]))

(def default-scrollbar-size 14)

(defun scroll-pane-content-style [state]
  (let [size (get state :content-size {:w 0 :h 0})
        offset (get state :offset {:x 0 :y 0})]
    {:position :absolute
     :left (* -1 (or (:x offset) 0))
     :top (* -1 (or (:y offset) 0))
     :width (if (:content-width-explicit? state)
              (or (:w size) 0)
              :fill)
     :height (if (:content-height-explicit? state)
               (or (:h size) 0)
               :auto)}))


(defun scroll-pane-sync-content-style [ui-state state ctx]
  (let [children (ui/children ctx)]
    (when (not-empty? children)
      (ui/style! (head children)
                 (scroll-pane-content-style ui-state)))
    ui-state))


(defun scroll-pane-effective-vertical-scrollbar? [state]
  (cond
    (= (:scroll-y? state) false)
    false

    (= (:scroll-y? state) :auto)
    (:effective-scroll-y? state)

    :default
    true))

(defun scroll-pane-vertical-scrollbar-style [state]
  {:height :fill
   :hidden (not (scroll-pane-effective-vertical-scrollbar? state))})

(defun scroll-pane-corner-style [state]
  {:hidden (not (scroll-pane-effective-vertical-scrollbar? state))})


(defun scroll-pane-content-state-binding [key]
  (if (nil? key)
    (ui/bind-state :content-state)
    {key (ui/bind-state :content-state)}))

(defun scroll-pane-viewport-style [content-size scroll-x? scroll-y? content-width-explicit? content-height-explicit? viewport-fill-width? viewport-fill-height?]
  {:width (cond
            (not= scroll-x? false) :fill
            (and content-width-explicit?
                 (not viewport-fill-width?))
            (get content-size :w 0)
            :default :fill)
   :height (cond
             (not= scroll-y? false) :fill
             (and content-height-explicit?
                  (not viewport-fill-height?))
             (get content-size :h 0)
             :default :fill)})

(defun scroll-pane-viewport-child [content-size content-state-key children scroll-x? scroll-y? content-width-explicit? content-height-explicit? viewport-fill-width? viewport-fill-height?]
  {:mode 'ui/scroll-pane-viewport
   :ui/state-policy :isolated
   :style (scroll-pane-viewport-style content-size
                                       scroll-x?
                                       scroll-y?
                                       content-width-explicit?
                                       content-height-explicit?
                                       viewport-fill-width?
                                       viewport-fill-height?)
   :ui-state {:offset (ui/bind-state :offset)
              :content-size (ui/bind-state :content-size)
              :content-width-explicit? (ui/bind-state :content-width-explicit?)
              :content-height-explicit? (ui/bind-state :content-height-explicit?)
              :content-ui-state (ui/project-state :content-ui-state)}
   :state {:content-state (ui/bind-state :content-state)}
   :children [{:mode 'ui/scroll-pane-content
               :ui/state-policy :isolated
               :state (scroll-pane-content-state-binding content-state-key)
               :ui-state {:content-ui-state (ui/project-state :content-ui-state)}
               :children children}]})

(defun scroll-pane-vertical-scrollbar-child []
  {:mode 'ui/scrollbar
   :ui/state-policy :isolated
   :class :scroll-pane/vertical-scrollbar
   :style {:height :fill}
   :ui-state {:axis :y
              :value (ui/bind-state :offset :y)
              :step (ui/bind-state :step)
              :content-size (ui/bind-state :content-size :h)}})

(defun scroll-pane-horizontal-scrollbar-child []
  {:mode 'ui/scrollbar
   :ui/state-policy :isolated
   :class :scroll-pane/horizontal-scrollbar
   :style {:width :fill
           :height :fill}
   :ui-state {:axis :x
              :value (ui/bind-state :offset :x)
              :step (ui/bind-state :step)
              :content-size (ui/bind-state :content-size :w)}})

(defun scroll-pane-corner-child []
  {:mode 'ui/scrollbar-corner
   :ui/state-policy :isolated
   :class :scroll-pane/corner
   :style {}})

(defun scroll-pane-row-child [content-size content-state-key children scroll-x? scroll-y? effective-scroll-y? content-width-explicit? content-height-explicit? viewport-fill-width? viewport-fill-height?]
  (let [scroll-state {:scroll-y? scroll-y?
                      :effective-scroll-y? effective-scroll-y?}]
    {:mode 'ui/scroll-pane-row
     :id "row"
     :ui/state-policy :isolated
     :ui-state {:offset (ui/bind-state :offset)
                :content-size (ui/bind-state :content-size)
                :content-width-explicit? (ui/bind-state :content-width-explicit?)
                :content-height-explicit? (ui/bind-state :content-height-explicit?)
                :content-ui-state (ui/project-state :content-ui-state)
                :step (ui/bind-state :step)}
     :state {:content-state (ui/bind-state :content-state)}
     :children (concat [(scroll-pane-viewport-child content-size
                                                    content-state-key
                                                    children
                                                    scroll-x?
                                                    scroll-y?
                                                    content-width-explicit?
                                                    content-height-explicit?
                                                    viewport-fill-width?
                                                    viewport-fill-height?)]
                       (if (= scroll-y? false)
                         []
                         [(merge (scroll-pane-vertical-scrollbar-child)
                                 {:style (scroll-pane-vertical-scrollbar-style scroll-state)})]))}))

(defun scroll-pane-footer-child [scroll-y? effective-scroll-y?]
  (let [scroll-state {:scroll-y? scroll-y?
                      :effective-scroll-y? effective-scroll-y?}]
    {:mode 'ui/scroll-pane-footer
     :id "footer"
     :ui/state-policy :isolated
     :ui-state {:offset (ui/bind-state :offset)
                :content-size (ui/bind-state :content-size)
                :step (ui/bind-state :step)}
     :children (concat [(scroll-pane-horizontal-scrollbar-child)]
                       (if (= scroll-y? false)
                         []
                         [(merge (scroll-pane-corner-child)
                                 {:style (scroll-pane-corner-style scroll-state)})]))}))

(defun scroll-pane-style [style scroll-x? scroll-y?]
  (let [style (or style {})]
    (cond-> style
      (and (= scroll-x? false)
           (not (contains? style :width))) (assoc :width :auto)
      (and (= scroll-y? false)
           (not (contains? style :height))) (assoc :height :auto))))

(defun scroll-pane-content-axis-explicit? [content-size key]
  (and (some? content-size)
       (contains? content-size key)))

(defun scroll-pane-style-axis-explicit? [style key]
  (contains? (or style {}) key))

(defun scroll-pane-scroll-setting [value]
  (if (nil? value)
    true
    value))

(defun scroll-pane-initial-scrollbar? [value]
  (cond
    (= value false) false
    (= value :auto) false
    :default true))

(defun scroll-pane-available-row-height [state ctx]
  (let [bounds (-> ctx :view :bounds)
        height (or (:h bounds) 0)]
    (if (= (:scroll-x? state) false)
      height
      (max 0 (- height (ui/theme-var ctx :scrollbar-size default-scrollbar-size))))))

(defun scroll-pane-effective-scroll-y? [state ctx]
  (cond
    (= (:scroll-y? state) false)
    false

    (= (:scroll-y? state) :auto)
    (let [available-height (scroll-pane-available-row-height state ctx)
          content-height (get-in state [:content-size :h] 0)]
      (if (> available-height 0)
        (> content-height available-height)
        (:effective-scroll-y? state)))

    :default
    true))

(defun scroll-pane-preferred-scroll-y? [state ctx]
  (case (:scroll-y? state)
    :auto (let [available-height (:available-height ctx)
                content-height (get-in state [:content-size :h] 0)]
            (if available-height
              (> content-height available-height)
              (:effective-scroll-y? state)))
    :default (scroll-pane-initial-scrollbar? (:scroll-y? state))))

(defun scroll-pane-preferred-size [state ctx]
  (let [state (get-in ctx [:view :ui-state] state)
        size (get state :content-size {:w 0 :h 0})
        width (or (:w size) 0)
        height (if (:viewport-fill-height? state)
                 0
                 (:h size))
        scrollbar-size (ui/theme-var ctx :scrollbar-size default-scrollbar-size)]
    {:w (+ width (if (scroll-pane-preferred-scroll-y? state ctx)
                   scrollbar-size
                   0))
     :h (+ height (if (= (:scroll-x? state) false)
                    0
                    scrollbar-size))}))

(defun scroll-pane-row-view [ctx]
  (head (ui/children ctx)))

(defun scroll-pane-viewport-view [ctx]
  (if-let [row (scroll-pane-row-view ctx)]
    (head (ui/children row))))

(defun scroll-pane-vertical-scrollbar-view [ctx]
  (if-let [row (scroll-pane-row-view ctx)]
    (nth (ui/children row) 1)))

(defun scroll-pane-footer-view [ctx]
  (nth (ui/children ctx) 1))

(defun scroll-pane-corner-view [ctx]
  (if-let [footer (scroll-pane-footer-view ctx)]
    (nth (ui/children footer) 1)))

(defun scroll-pane-content-view [ctx]
  (if-let [viewport (scroll-pane-viewport-view ctx)]
    (head (ui/children viewport))))

(defun scroll-pane-viewport-size-from-view [ctx]
  (let [viewport (scroll-pane-viewport-view ctx)
        bounds (when viewport (:bounds viewport))]
    {:w (or (:w bounds) 0)
     :h (or (:h bounds) 0)}))

(defun scroll-pane-measure-descendants [children origin-x origin-y]
  (reduce children
          {:w 0 :h 0}
          (fn [size child]
            (let [bounds (:bounds child)
                  x (or (:x bounds) origin-x)
                  y (or (:y bounds) origin-y)
                  w (or (:w bounds) 0)
                  h (or (:h bounds) 0)
                  child-size {:w (max (or (:w size) 0)
                                      (- (+ x w) origin-x))
                              :h (max (or (:h size) 0)
                                      (- (+ y h) origin-y))}
                  descendant-size (scroll-pane-measure-descendants (ui/children child)
                                                                   origin-x
                                                                   origin-y)]
              {:w (max (or (:w child-size) 0)
                       (or (:w descendant-size) 0))
               :h (max (or (:h child-size) 0)
                       (or (:h descendant-size) 0))}))))

(defun scroll-pane-measured-content-size [ctx]
  (let [content (scroll-pane-content-view ctx)
        bounds (when content (:bounds content))
        origin-x (or (:x bounds) 0)
        origin-y (or (:y bounds) 0)]
    (when content
      (scroll-pane-measure-descendants (ui/children content) origin-x origin-y))))

(defun scroll-pane-measured-axis [state measured key explicit-key]
  (if (get state explicit-key)
    (get-in state [:content-size key] 0)
    (get measured key 0)))

(defun scroll-pane-clamped-offset [offset content-size viewport-size]
  {:x (clamp (or (:x offset) 0)
             0
             (max 0 (- (or (:w content-size) 0)
                       (or (:w viewport-size) 0))))
   :y (clamp (or (:y offset) 0)
             0
             (max 0 (- (or (:h content-size) 0)
                       (or (:h viewport-size) 0))))})

(defun scroll-pane-wheel-axis-offset [value delta step max-value enabled?]
  (if (and enabled?
           (not= delta 0)
           (> max-value 0))
    (clamp (- (or value 0)
              (* delta step))
           0
           max-value)
    (or value 0)))

(defun scroll-pane-wheel-scroll-y? [state]
  (cond
    (= (:scroll-y? state) false)
    false

    (= (:scroll-y? state) :auto)
    (:effective-scroll-y? state)

    :default
    true))

(defun scroll-pane-wheel-offset [state event ctx]
  (let [offset (get state :offset {:x 0 :y 0})
        content-size (get state :content-size {:w 0 :h 0})
        viewport-size (scroll-pane-viewport-size-from-view ctx)
        max-x (max 0 (- (or (:w content-size) 0)
                        (or (:w viewport-size) 0)))
        max-y (max 0 (- (or (:h content-size) 0)
                        (or (:h viewport-size) 0)))
        step (or (:wheel-step state)
                 (:step state)
                 16)
        next-offset {:x (scroll-pane-wheel-axis-offset (:x offset)
                                                       (:x event)
                                                       step
                                                       max-x
                                                       (not= (:scroll-x? state) false))
                     :y (scroll-pane-wheel-axis-offset (:y offset)
                                                       (:y event)
                                                       step
                                                       max-y
                                                       (scroll-pane-wheel-scroll-y? state))}]
    (scroll-pane-clamped-offset next-offset
                                content-size
                                viewport-size)))

(defun scroll-pane-mouse-wheel [state event ctx]
  (let [ui-state (-> ctx :view :ui-state)
        offset (get ui-state :offset {:x 0 :y 0})
        next-offset (scroll-pane-wheel-offset ui-state event ctx)]
    (when (not= next-offset offset)
      (ui/stop-propagation! event)
      (ui/set-ui-state! ctx (assoc ui-state :offset next-offset)))
    state))

(defun scroll-pane-bottom-offset-y [content-size viewport-size]
  (max 0 (- (or (:h content-size) 0)
            (or (:h viewport-size) 0))))

(defun scroll-pane-content-height-grew? [old-size new-size]
  (> (or (:h new-size) 0)
     (or (:h old-size) 0)))

(defun scroll-pane-auto-scroll-offset [state old-content-size content-size viewport-size offset]
  (cond-> offset
    (and (= (:auto-scroll-y state) :bottom)
         (scroll-pane-content-height-grew? old-content-size content-size))
    (assoc :y (scroll-pane-bottom-offset-y content-size viewport-size))))

(defun scroll-pane-apply-measured-content-size [state ctx]
  (if-let [measured-size (scroll-pane-measured-content-size ctx)]
    (let [old-content-size (get state :content-size {:w 0 :h 0})
          content-size {:w (scroll-pane-measured-axis state
                                                      measured-size
                                                      :w
                                                      :content-width-explicit?)
                        :h (scroll-pane-measured-axis state
                                                      measured-size
                                                      :h
                                                      :content-height-explicit?)}
          viewport-size (scroll-pane-viewport-size-from-view ctx)
          offset (scroll-pane-auto-scroll-offset
                  state
                  old-content-size
                  content-size
                  viewport-size
                  (scroll-pane-clamped-offset (get state :offset {:x 0 :y 0})
                                              content-size
                                              viewport-size))]
      (assoc state
             :content-size content-size
             :offset offset))
    state))

(defun scroll-pane-sync-scrollbar-visibility! [state ctx]
  (let [vertical-scrollbar (scroll-pane-vertical-scrollbar-view ctx)
        corner (scroll-pane-corner-view ctx)]
    (when vertical-scrollbar
      (ui/style! vertical-scrollbar
                 (scroll-pane-vertical-scrollbar-style state)))
    (when corner
      (ui/style! corner
                 (scroll-pane-corner-style state)))))

(defun scroll-pane-sync-auto-managed [state ctx]
  (if (:auto-managed? state)
    (let [measured-state (scroll-pane-apply-measured-content-size state ctx)]
      (let [effective-scroll-y? (scroll-pane-effective-scroll-y? measured-state ctx)]
        (if (= effective-scroll-y? (:effective-scroll-y? measured-state))
          measured-state
          (let [synced-state (assoc measured-state :effective-scroll-y? effective-scroll-y?)]
            (scroll-pane-sync-scrollbar-visibility! synced-state ctx)
            synced-state))))
    state))


;; Internal Components

(defcomponent ui/scroll-pane-content
  {:ui/state-keys [:content-ui-state]})


(defcomponent ui/scroll-pane-viewport
  {:ui/state-keys [:offset
                   :content-size
                   :content-width-explicit?
                   :content-height-explicit?
                   :content-ui-state]
   :style {:width :fill
           :height :fill
           :clip true}
   :init-ui scroll-pane-sync-content-style
   :update-ui scroll-pane-sync-content-style
   :children [{:mode 'ui/scroll-pane-content
               :ui/state-policy :isolated
               :ui-state {:content-ui-state (ui/project-state :content-ui-state)}}]})


(defcomponent ui/scroll-pane-row
  {:ui/state-keys [:offset
                   :content-size
                   :content-width-explicit?
                   :content-height-explicit?
                   :content-ui-state
                   :step]
   :style {:width :fill
           :height :fill
           :layout {:direction :row}}
   :children [{:mode 'ui/scroll-pane-viewport
               :ui/state-policy :isolated
               :ui-state {:offset (ui/bind-state :offset)
                          :content-size (ui/bind-state :content-size)
                          :content-width-explicit?
                          (ui/bind-state :content-width-explicit?)
                          :content-height-explicit?
                          (ui/bind-state :content-height-explicit?)
                          :content-ui-state (ui/project-state :content-ui-state)}
               :state {:content-state (ui/bind-state :content-state)}}
              {:mode 'ui/scrollbar
               :ui/state-policy :isolated
               :class :scroll-pane/vertical-scrollbar
               :style {:height :fill}
               :ui-state {:axis :y
                          :value (ui/bind-state :offset :y)
                          :step (ui/bind-state :step)
                          :content-size (ui/bind-state :content-size :h)}}]})

(defcomponent ui/scroll-pane-footer
  {:ui/state-keys [:offset
                   :content-size
                   :step]
   :style {:width :fill
           :layout {:direction :row}}
   :content-size (fn [state ctx]
                   {:w 0
                    :h (ui/theme-var ctx
                                     :scrollbar-size
                                     default-scrollbar-size)})
   :children [{:mode 'ui/scrollbar
               :ui/state-policy :isolated
               :class :scroll-pane/horizontal-scrollbar
               :style {:width :fill
                       :height :fill}
               :ui-state {:axis :x
                          :value (ui/bind-state :offset :x)
                          :step (ui/bind-state :step)
                          :content-size (ui/bind-state :content-size :w)}}
              {:mode 'ui/scrollbar-corner
               :ui/state-policy :isolated
               :class :scroll-pane/corner
               :style {}}]})



;; Main Component

(def SCROLL-PANE-UI-STATE-KEYS
  "Keys owned by the ui/scroll-pane component state."
  [:offset
   :content-size
   :content-width-explicit?
   :content-height-explicit?
   :viewport-fill-width?
   :viewport-fill-height?
   :content-ui-state
   :scroll-x?
   :scroll-y?
   :effective-scroll-y?
   :auto-managed?
   :auto-scroll-y
   :step])

(defcomponent ui/scroll-pane
  {:ui/state-keys SCROLL-PANE-UI-STATE-KEYS
   :style {:width :fill
           :height :fill
           :layout {:direction :column}}
   :content-size scroll-pane-preferred-size
   :init-ui (fn [ui-state state ctx]
              (merge {:offset {:x 0 :y 0}
                      :content-size {:w 0 :h 0}
                      :content-width-explicit? false
                      :content-height-explicit? false
                      :viewport-fill-width? true
                      :viewport-fill-height? true
                      :content-ui-state {}
                      :scroll-x? true
                      :scroll-y? true
                      :effective-scroll-y? true
                      :auto-managed? false
                      :auto-scroll-y nil
                      :step 16}
                     ui-state))
   :update-ui (fn [ui-state state ctx]
                (scroll-pane-sync-auto-managed ui-state ctx))
   :after-layout-ui (fn [ui-state state ctx]
                      (scroll-pane-sync-auto-managed ui-state ctx))
   :on-mouse-wheel scroll-pane-mouse-wheel
   :children [{:mode 'ui/scroll-pane-row
               :ui/state-policy :isolated
               :ui-state {:offset (ui/bind-state :offset)
                          :content-size (ui/bind-state :content-size)
                          :content-ui-state (ui/project-state :content-ui-state)
                          :step (ui/bind-state :step)}
               :state {:content-state (ui/bind-state :content-state)}}
              {:mode 'ui/scroll-pane-footer
               :ui/state-policy :isolated
               :ui-state {:offset (ui/bind-state :offset)
                          :content-size (ui/bind-state :content-size)
                          :step (ui/bind-state :step)}}]})


;; Make function

(defun make [{:keys [auto-scroll-y children class content-size content-state content-state-key content-width-explicit? content-height-explicit? offset scroll-x? scroll-y? state step style ui-state]}]
  (let [scroll-x? (scroll-pane-scroll-setting scroll-x?)
        scroll-y? (scroll-pane-scroll-setting scroll-y?)
        effective-scroll-y? (scroll-pane-initial-scrollbar? scroll-y?)
        content-width-explicit? (if (nil? content-width-explicit?)
                                  (scroll-pane-content-axis-explicit? content-size :w)
                                  content-width-explicit?)
        content-height-explicit? (if (nil? content-height-explicit?)
                                   (scroll-pane-content-axis-explicit? content-size :h)
                                   content-height-explicit?)
        viewport-fill-width? (scroll-pane-style-axis-explicit? style :width)
        viewport-fill-height? (scroll-pane-style-axis-explicit? style :height)
        component (merge {:offset (or offset {:x 0 :y 0})
                          :content-size (or content-size {:w 0 :h 0})
                          :content-width-explicit? content-width-explicit?
                          :content-height-explicit? content-height-explicit?
                          :viewport-fill-width? viewport-fill-width?
                          :viewport-fill-height? viewport-fill-height?
                          :scroll-x? scroll-x?
                          :scroll-y? scroll-y?
                          :effective-scroll-y? effective-scroll-y?
                          :auto-managed? true
                          :auto-scroll-y auto-scroll-y
                          :step (or step 16)}
                         (select-keys state SCROLL-PANE-UI-STATE-KEYS)
                         (:component state))
        application-state (merge (reduce SCROLL-PANE-UI-STATE-KEYS
                                         (dissoc (or state {}) :component)
                                         (fn [out key]
                                           (dissoc out key)))
                                 {:content-state (or content-state
                                                     (:content-state state)
                                                     {})})]
    (cond-> {:mode 'ui/scroll-pane
             :style (scroll-pane-style style scroll-x? scroll-y?)
             :ui/state-policy :isolated
             :state (assoc application-state :component component)
             :children (concat [(scroll-pane-row-child content-size
                                                       content-state-key
                                                       children
                                                       scroll-x?
                                                       scroll-y?
                                                       effective-scroll-y?
                                                       content-width-explicit?
                                                       content-height-explicit?
                                                       viewport-fill-width?
                                                       viewport-fill-height?)]
                               (if (= scroll-x? false)
                                 []
                                 [(scroll-pane-footer-child scroll-y?
                                                            effective-scroll-y?)]))}
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state))))
