(ns pixils.ui.slider
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]))

(def default-track-color {:r 0x99 :g 0x99 :b 0x99})
(def default-handle-color {:r 0xff :g 0xff :b 0xff})
(def default-border-color {:r 0x00 :g 0x00 :b 0x00})
(def default-limit-track-color {:r 0x66 :g 0x66 :b 0x66})
(def default-slider-theme
  {:thumb-shape :rect
   :track-layout :full
   :track-shape :rect
   :track-thickness 3
   :track-border? false})

(defun clamp [value low high]
  (max low (min high value)))

(defun slider-min [state]
  (or (:min state) 0))

(defun slider-max [state]
  (or (:max state) 100))

(defun slider-limits-enabled? [state]
  (not= (:limits-enabled? state) false))

(defun slider-limit-min [state]
  (let [min-value (slider-min state)
        max-value (slider-max state)
        raw-low (clamp (if (slider-limits-enabled? state)
                         (or (:limit-min state) min-value)
                         min-value)
                       min-value
                       max-value)
        raw-high (clamp (if (slider-limits-enabled? state)
                          (or (:limit-max state) max-value)
                          max-value)
                        min-value
                        max-value)]
    (min raw-low raw-high)))

(defun slider-limit-max [state]
  (let [min-value (slider-min state)
        max-value (slider-max state)
        raw-low (clamp (if (slider-limits-enabled? state)
                         (or (:limit-min state) min-value)
                         min-value)
                       min-value
                       max-value)
        raw-high (clamp (if (slider-limits-enabled? state)
                          (or (:limit-max state) max-value)
                          max-value)
                        min-value
                        max-value)]
    (max raw-low raw-high)))

(defun slider-value [state]
  (clamp (or (:value state) (slider-min state))
         (slider-limit-min state)
         (slider-limit-max state)))

(defun slider-style [ctx]
  (or (-> ctx :view :effective-style)
      (-> ctx :view :style)))

(defun slider-theme [ctx]
  (merge default-slider-theme
         (if (= (type-of ctx) "map")
           (or (:slider-theme ctx)
               (-> ctx :view :slider-theme)
               {})
           (ui/theme-var ctx :slider {}))))

(defun slider-border-side-thickness [ctx side]
  (let [border (-> (slider-style ctx) :border)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun slider-padding-side [ctx side]
  (or (get (-> (slider-style ctx) :padding) side)
      0))

(defun slider-content-origin-inset [ctx side]
  (+ (slider-border-side-thickness ctx side)
     (slider-padding-side ctx side)))

(defun slider-content-width [ctx]
  (let [bounds (-> ctx :view :bounds)]
    (max 1 (- (:w bounds)
              (slider-content-origin-inset ctx :left)
              (slider-content-origin-inset ctx :right)))))

(defun slider-content-height [ctx]
  (let [bounds (-> ctx :view :bounds)]
    (max 1 (- (:h bounds)
              (slider-content-origin-inset ctx :top)
              (slider-content-origin-inset ctx :bottom)))))

(defun slider-axis-size [state ctx]
  (if (= (:axis state) :y)
    (slider-content-height ctx)
    (slider-content-width ctx)))

(defun slider-cross-size [state ctx]
  (if (= (:axis state) :y)
    (slider-content-width ctx)
    (slider-content-height ctx)))

(defun slider-event-coord [state event ctx]
  (let [pos (:position event)]
    (if (= (:axis state) :y)
      (- (:y pos) (if ctx (slider-content-origin-inset ctx :top) 0))
      (- (:x pos) (if ctx (slider-content-origin-inset ctx :left) 0)))))

(defun slider-handle-size [state ctx]
  (max 8
       (or (:thumb-length state)
           (-> (slider-theme ctx) :thumb-length)
           (slider-cross-size state ctx))))

(defun slider-thumb-point-size [state ctx]
  (max 1
       (or (:thumb-point-size state)
           (-> (slider-theme ctx) :thumb-point-size)
           (int (/ (slider-handle-size state ctx) 2)))))

(defun slider-track-thickness [state ctx]
  (min (or (:track-thickness state)
           (-> (slider-theme ctx) :track-thickness)
           3)
       (max 1 (slider-cross-size state ctx))))

(defun slider-track-span [state ctx]
  (max 1 (- (slider-axis-size state ctx)
            (slider-handle-size state ctx))))

(defun slider-value-span [state]
  (- (slider-max state) (slider-min state)))

(defun slider-value-ratio [state]
  (let [span (slider-value-span state)]
    (if (> span 0)
      (/ (- (slider-value state) (slider-min state)) span)
      0)))

(defun slider-visual-ratio [state value]
  (let [span (slider-value-span state)]
    (if (> span 0)
      (/ (- (clamp value (slider-min state) (slider-max state))
            (slider-min state))
         span)
      0)))

(defun slider-handle-pos [state ctx]
  (int (* (slider-value-ratio state)
          (slider-track-span state ctx))))

(defun nearest-stepped-value [state raw]
  (let [min-value (slider-min state)
        step (:step state)]
    (if (and step (> step 0))
      (+ min-value
         (* step
            (int (+ (/ (- raw min-value) step)
                    0.5))))
      raw)))

(defun slider-value-at [state event ctx]
  (let [handle (slider-handle-size state ctx)
        coord (clamp (- (slider-event-coord state event ctx) (/ handle 2))
                     0
                     (slider-track-span state ctx))
        ratio (/ coord (slider-track-span state ctx))
        raw (+ (slider-min state)
               (* ratio (slider-value-span state)))]
    (clamp (nearest-stepped-value state raw)
           (slider-limit-min state)
           (slider-limit-max state))))

(defun slider-thumb-shape [state ctx]
  (or (:thumb-shape state)
      (-> (slider-theme ctx) :thumb-shape)
      :rect))

(defun slider-windows-style? [state ctx]
  (= (slider-thumb-shape state ctx) :windows))

(defun slider-track-layout [state ctx]
  (or (:track-layout state)
      (-> (slider-theme ctx) :track-layout)
      :full))

(defun slider-track-border? [state ctx]
  (= (or (:track-border? state)
         (-> (slider-theme ctx) :track-border?))
     true))

(defun slider-track-shape [state ctx]
  (or (:track-shape state)
      (-> (slider-theme ctx) :track-shape)
      :rect))

(defun slider-track-color [state ctx]
  (or (:track-color state)
      (-> (slider-theme ctx) :track-color)
      (-> (slider-style ctx) :border :color)
      default-track-color))

(defun slider-limit-track-color [state ctx]
  (or (:limit-track-color state)
      (-> (slider-theme ctx) :limit-track-color)
      default-limit-track-color))

(defun slider-track-bevel [state ctx]
  (let [bevel (-> (slider-theme ctx) :track-bevel)]
    {:outer-top-color (or (:outer-top-color bevel)
                          (slider-track-top-color state ctx))
     :outer-bottom-color (or (:outer-bottom-color bevel)
                             (slider-track-bottom-color state ctx))
     :inner-top-color (or (:inner-top-color bevel)
                          (slider-track-top-color state ctx))
     :inner-bottom-color (or (:inner-bottom-color bevel)
                             (slider-track-bottom-color state ctx))}))

(defun slider-thumb-bevel [state ctx]
  (let [bevel (-> (slider-theme ctx) :thumb-bevel)]
    {:outer-top-color (or (:outer-top-color bevel)
                          (slider-border-top-color state ctx))
     :outer-bottom-color (or (:outer-bottom-color bevel)
                             (slider-border-bottom-color state ctx))
     :inner-top-color (or (:inner-top-color bevel)
                          (slider-border-top-color state ctx))
     :inner-bottom-color (or (:inner-bottom-color bevel)
                             (slider-border-bottom-color state ctx))}))

(defun slider-handle-color [state ctx]
  (or (:handle-color state)
      (-> (slider-theme ctx) :thumb-color)
      (-> (slider-style ctx) :background)
      default-handle-color))

(defun slider-border-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :color)
      default-border-color))

(defun slider-border-top-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :top :color)
      (slider-border-color state ctx)))

(defun slider-border-bottom-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :bottom :color)
      (-> (slider-style ctx) :border :right :color)
      (slider-border-color state ctx)))

(defun slider-track-top-color [state ctx]
  (or (:track-border-top-color state)
      (-> (slider-theme ctx) :track-border-top-color)
      (:track-border-color state)
      (-> (slider-theme ctx) :track-border-color)
      (slider-border-bottom-color state ctx)))

(defun slider-track-bottom-color [state ctx]
  (or (:track-border-bottom-color state)
      (-> (slider-theme ctx) :track-border-bottom-color)
      (:track-border-color state)
      (-> (slider-theme ctx) :track-border-color)
      (slider-border-top-color state ctx)))

(defun slider-border-thickness [ctx]
  (or (-> (slider-style ctx) :border :thickness)
      1))

(defun slider-bevel? [ctx]
  (or (= (-> (slider-style ctx) :border :line-style) :bevel)
      (-> (slider-style ctx) :border :top :color)
      (-> (slider-style ctx) :border :right :color)
      (-> (slider-style ctx) :border :bottom :color)
      (-> (slider-style ctx) :border :left :color)))

(defun draw-slider-bevel! [rect tl-color br-color thickness]
  (dotimes [n thickness]
    (do
      (r/line! {:x (+ (:x rect) n)
                :y (+ (:y rect) n)}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (+ (:y rect) n)}
               tl-color)
      (r/line! {:x (+ (:x rect) n)
                :y (+ (:y rect) n)}
               {:x (+ (:x rect) n)
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               tl-color)
      (r/line! {:x (+ (:x rect) n)
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               br-color)
      (r/line! {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (+ (:y rect) n)}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               br-color))))

(defun draw-slider-handle-border! [state ctx rect]
  (if (slider-bevel? ctx)
    (draw-slider-bevel! rect
                        (slider-border-top-color state ctx)
                        (slider-border-bottom-color state ctx)
                        (slider-border-thickness ctx))
    (r/rect! rect {:color (slider-border-color state ctx)})))

(defun draw-slider-track-border! [state ctx rect]
  (if (slider-bevel? ctx)
    (draw-slider-bevel! rect
                        (slider-track-top-color state ctx)
                        (slider-track-bottom-color state ctx)
                        1)
    (r/rect! rect {:color (slider-border-color state ctx)})))

(defun inset-rect [rect amount]
  {:x (+ (:x rect) amount)
   :y (+ (:y rect) amount)
   :w (max 1 (- (:w rect) (* amount 2)))
   :h (max 1 (- (:h rect) (* amount 2)))})

(defun draw-slider-double-bevel! [rect bevel]
  (do
    (draw-slider-bevel! rect
                        (:outer-top-color bevel)
                        (:outer-bottom-color bevel)
                        1)
    (when (and (> (:w rect) 2)
               (> (:h rect) 2))
      (draw-slider-bevel! (inset-rect rect 1)
                          (:inner-top-color bevel)
                          (:inner-bottom-color bevel)
                          1))))

(defun slider-standard-track-rect [state ctx]
  (let [axis (slider-axis-size state ctx)
        cross (slider-cross-size state ctx)
        thickness (slider-track-thickness state ctx)]
    (if (= (:axis state) :y)
      {:x (int (/ (- cross thickness) 2))
       :y 0
       :w thickness
       :h axis}
      {:x 0
       :y (int (/ (- cross thickness) 2))
       :w axis
       :h thickness})))

(defun slider-windows-track-rect [state ctx]
  (let [cross (slider-cross-size state ctx)
        handle (slider-handle-size state ctx)
        span (slider-track-span state ctx)
        thickness (slider-track-thickness state ctx)]
    (if (= (:axis state) :y)
      {:x (int (/ (- cross thickness) 2))
       :y (int (/ handle 2))
       :w thickness
       :h span}
      {:x (int (/ handle 2))
       :y (int (/ (- cross thickness) 2))
       :w span
       :h thickness})))

(defun slider-track-rect [state ctx]
  (if (= (slider-track-layout state ctx) :handle-travel)
    (slider-windows-track-rect state ctx)
    (slider-standard-track-rect state ctx)))

(defun slider-track-axis-length [state rect]
  (if (= (:axis state) :y)
    (:h rect)
    (:w rect)))

(defun slider-track-pos-for-value [state rect value]
  (int (* (slider-visual-ratio state value)
          (slider-track-axis-length state rect))))

(defun slider-limit-background-segment-rect [state ctx rect start length]
  (if (= (:axis state) :y)
    {:x 0
     :y (+ (:y rect) start)
     :w (slider-content-width ctx)
     :h length}
    {:x (+ (:x rect) start)
     :y 0
     :w length
     :h (slider-content-height ctx)}))

(defun slider-limit-track-rects [state ctx]
  (let [track (slider-track-rect state ctx)
        axis-length (slider-track-axis-length state track)
        low (slider-limit-min state)
        high (slider-limit-max state)
        low-pos (clamp (slider-track-pos-for-value state track low) 0 axis-length)
        high-pos (clamp (slider-track-pos-for-value state track high) 0 axis-length)]
    {:lower (if (> low (slider-min state))
              (slider-limit-background-segment-rect state ctx track 0 low-pos))
     :upper (if (< high (slider-max state))
              (slider-limit-background-segment-rect state
                                                    ctx
                                                    track
                                                    high-pos
                                                    (max 1 (- axis-length high-pos))))}))

(defun slider-handle-rect [state ctx]
  (let [pos (slider-handle-pos state ctx)
        handle (slider-handle-size state ctx)
        cross (slider-cross-size state ctx)]
    (if (= (:axis state) :y)
      {:x 0
       :y pos
       :w cross
       :h handle}
      {:x pos
       :y 0
       :w handle
       :h cross})))

(defun draw-slider-horizontal-windows-handle! [state ctx rect]
  (let [point-height (min (slider-thumb-point-size state ctx)
                          (max 1 (- (:h rect) 2)))
        body-height (max 1 (- (:h rect) point-height))
        color (slider-handle-color state ctx)
        bevel (slider-thumb-bevel state ctx)
        outer-tl-color (:outer-top-color bevel)
        outer-br-color (:outer-bottom-color bevel)
        inner-tl-color (:inner-top-color bevel)
        inner-br-color (:inner-bottom-color bevel)
        x (:x rect)
        y (:y rect)
        right (- (+ x (:w rect)) 1)
        body-bottom (- (+ y body-height) 1)
        bottom (- (+ y (:h rect)) 1)
        center-x (int (/ (+ x right) 2))
        inner-y (inc y)
        inner-x (inc x)
        inner-right (dec right)
        inner-bottom (dec bottom)]
    (do
      (r/rect! {:x x :y y :w (:w rect) :h body-height}
               {:fill true :color color})
      (dotimes [n point-height]
        (let [inset n
              row-width (max 1 (- (:w rect) (* 2 inset)))]
          (r/rect! {:x (+ x (int (/ (- (:w rect) row-width) 2)))
                    :y (+ y body-height n)
                    :w row-width
                    :h 1}
                   {:fill true :color color})))
      (r/line! {:x x :y y} {:x right :y y} outer-tl-color)
      (r/line! {:x x :y y} {:x x :y body-bottom} outer-tl-color)
      (r/line! {:x x :y body-bottom} {:x center-x :y bottom} outer-tl-color)
      (r/line! {:x right :y y} {:x right :y body-bottom} outer-br-color)
      (r/line! {:x right :y body-bottom} {:x center-x :y bottom} outer-br-color)
      (when (and (> (:w rect) 4)
                 (> (:h rect) 4))
        (do
          (r/line! {:x inner-x :y inner-y}
                   {:x inner-right :y inner-y}
                   inner-tl-color)
          (r/line! {:x inner-x :y inner-y}
                   {:x inner-x :y body-bottom}
                   inner-tl-color)
          (r/line! {:x inner-x :y body-bottom}
                   {:x center-x :y inner-bottom}
                   inner-tl-color)
          (r/line! {:x inner-right :y inner-y}
                   {:x inner-right :y body-bottom}
                   inner-br-color)
          (r/line! {:x inner-right :y body-bottom}
                   {:x center-x :y inner-bottom}
                   inner-br-color))))))

(defun draw-slider-vertical-windows-handle! [state ctx rect]
  (let [point-width (min (slider-thumb-point-size state ctx)
                         (max 1 (- (:w rect) 2)))
        body-width (max 1 (- (:w rect) point-width))
        color (slider-handle-color state ctx)
        bevel (slider-thumb-bevel state ctx)
        outer-tl-color (:outer-top-color bevel)
        outer-br-color (:outer-bottom-color bevel)
        inner-tl-color (:inner-top-color bevel)
        inner-br-color (:inner-bottom-color bevel)
        x (:x rect)
        y (:y rect)
        right (- (+ x (:w rect)) 1)
        body-right (- (+ x body-width) 1)
        bottom (- (+ y (:h rect)) 1)
        center-y (int (/ (+ y bottom) 2))
        inner-x (inc x)
        inner-y (inc y)
        inner-right (dec right)
        inner-bottom (dec bottom)]
    (do
      (r/rect! {:x x :y y :w body-width :h (:h rect)}
               {:fill true :color color})
      (dotimes [n point-width]
        (let [inset n
              column-height (max 1 (- (:h rect) (* 2 inset)))]
          (r/rect! {:x (+ x body-width n)
                    :y (+ y (int (/ (- (:h rect) column-height) 2)))
                    :w 1
                    :h column-height}
                   {:fill true :color color})))
      (r/line! {:x x :y y} {:x body-right :y y} outer-tl-color)
      (r/line! {:x x :y y} {:x x :y bottom} outer-tl-color)
      (r/line! {:x body-right :y y} {:x right :y center-y} outer-tl-color)
      (r/line! {:x x :y bottom} {:x body-right :y bottom} outer-br-color)
      (r/line! {:x body-right :y bottom} {:x right :y center-y} outer-br-color)
      (when (and (> (:w rect) 4)
                 (> (:h rect) 4))
        (do
          (r/line! {:x inner-x :y inner-y}
                   {:x body-right :y inner-y}
                   inner-tl-color)
          (r/line! {:x inner-x :y inner-y}
                   {:x inner-x :y inner-bottom}
                   inner-tl-color)
          (r/line! {:x body-right :y inner-y}
                   {:x inner-right :y center-y}
                   inner-tl-color)
          (r/line! {:x inner-x :y inner-bottom}
                   {:x body-right :y inner-bottom}
                   inner-br-color)
          (r/line! {:x body-right :y inner-bottom}
                   {:x inner-right :y center-y}
                   inner-br-color))))))

(defun draw-slider-windows-handle! [state ctx rect]
  (if (= (:axis state) :y)
    (draw-slider-vertical-windows-handle! state ctx rect)
    (draw-slider-horizontal-windows-handle! state ctx rect)))

(defun draw-slider-handle! [state ctx]
  (let [rect (slider-handle-rect state ctx)]
    (if (slider-windows-style? state ctx)
      (draw-slider-windows-handle! state ctx rect)
      (do
        (r/rect! rect
                 {:fill true
                  :color (slider-handle-color state ctx)})
        (draw-slider-handle-border! state ctx rect)))))

(defun draw-slider-track! [state ctx]
  (let [rect (slider-track-rect state ctx)]
    (if (= (slider-track-shape state ctx) :windows-track)
      (draw-slider-double-bevel! rect (slider-track-bevel state ctx))
      (do
        (r/rect! rect
                 {:fill true
                  :color (slider-track-color state ctx)})
        (if (slider-track-border? state ctx)
          (draw-slider-track-border! state ctx rect))))))

(defun draw-slider-limit-track! [state ctx]
  (let [rects (slider-limit-track-rects state ctx)
        color (slider-limit-track-color state ctx)]
    (do
      (if (:lower rects)
        (r/rect! (:lower rects) {:fill true :color color}))
      (if (:upper rects)
        (r/rect! (:upper rects) {:fill true :color color})))))

(defun slider-set-value [state event ctx]
  (let [value (slider-value-at state event ctx)]
    (do
      (ui/emit! (:view ctx) :slider/change value)
      (assoc state :value value))))

(defcomponent ui/slider
  {:focusable true
   :class :ui/slider
   :style {}
   :init (fn [state ctx]
           (assoc state :value (slider-value state)))
   :update (fn [state ctx]
             (assoc state :value (slider-value state)))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (slider-set-value state event ctx)))
   :on-drag (fn [state event ctx]
              (slider-set-value state event ctx))
   :render (fn [state ctx]
             (do
               (draw-slider-limit-track! state ctx)
               (draw-slider-track! state ctx)
               (draw-slider-handle! state ctx)))})

(defun make [{:keys [style value min max limit-min limit-max limits-enabled? step axis thumb-shape thumb-length thumb-point-size track-layout track-shape track-thickness track-border? limit-track-color]}]
  {:mode 'ui/slider
   :style (or style {})
   :state {:value value
           :min min
           :max max
           :limit-min limit-min
           :limit-max limit-max
           :limits-enabled? limits-enabled?
           :step step
           :axis (or axis :x)
           :thumb-shape thumb-shape
           :thumb-length thumb-length
           :thumb-point-size thumb-point-size
           :track-layout track-layout
           :track-shape track-shape
           :track-thickness track-thickness
           :track-border? track-border?
           :limit-track-color limit-track-color}})
