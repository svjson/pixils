(ns pixils.ui.slider
  (:require pixils
            [pixils.render :as r]
            [pixils.ui :as ui]))

(def default-track-color {:r 0x99 :g 0x99 :b 0x99})
(def default-handle-color {:r 0xff :g 0xff :b 0xff})
(def default-border-color {:r 0x00 :g 0x00 :b 0x00})

(defun clamp [value low high]
  (max low (min high value)))

(defun slider-min [state]
  (or (:min state) 0))

(defun slider-max [state]
  (or (:max state) 100))

(defun slider-step [state]
  (or (:step state) 1))

(defun slider-value [state]
  (clamp (or (:value state) (slider-min state))
         (slider-min state)
         (slider-max state)))

(defun slider-style [ctx]
  (or (-> ctx :view :effective-style)
      (-> ctx :view :style)))

(defun slider-border-side-thickness [ctx side]
  (let [border (-> (slider-style ctx) :border)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun slider-padding-side [ctx side]
  (or (get (-> (slider-style ctx) :padding) side)
      0))

(defun slider-content-origin-inset [ctx side]
  (+ (slider-border-side-thickness ctx side)
     (slider-padding-side ctx side)))

(defun slider-content-width [ctx]
  (let [bounds (-> ctx :view :bounds)]
    (max 1 (- (:w bounds)
              (slider-content-origin-inset ctx :left)
              (slider-content-origin-inset ctx :right)))))

(defun slider-content-height [ctx]
  (let [bounds (-> ctx :view :bounds)]
    (max 1 (- (:h bounds)
              (slider-content-origin-inset ctx :top)
              (slider-content-origin-inset ctx :bottom)))))

(defun slider-axis-size [state ctx]
  (if (= (:axis state) :y)
    (slider-content-height ctx)
    (slider-content-width ctx)))

(defun slider-cross-size [state ctx]
  (if (= (:axis state) :y)
    (slider-content-width ctx)
    (slider-content-height ctx)))

(defun slider-event-coord [state event ctx]
  (let [pos (:position event)]
    (if (= (:axis state) :y)
      (- (:y pos) (if ctx (slider-content-origin-inset ctx :top) 0))
      (- (:x pos) (if ctx (slider-content-origin-inset ctx :left) 0)))))

(defun slider-handle-size [state ctx]
  (max 8 (slider-cross-size state ctx)))

(defun slider-track-thickness [state ctx]
  (min 4 (max 1 (slider-cross-size state ctx))))

(defun slider-standard-track-thickness [state ctx]
  (min 3 (max 1 (slider-cross-size state ctx))))

(defun slider-track-span [state ctx]
  (max 1 (- (slider-axis-size state ctx)
            (slider-handle-size state ctx))))

(defun slider-value-ratio [state]
  (let [span (max 1 (- (slider-max state) (slider-min state)))]
    (/ (- (slider-value state) (slider-min state)) span)))

(defun slider-handle-pos [state ctx]
  (int (* (slider-value-ratio state)
          (slider-track-span state ctx))))

(defun nearest-stepped-value [state raw]
  (let [min-value (slider-min state)
        step (slider-step state)]
    (+ min-value
       (* step
          (int (/ (+ (- raw min-value)
                     (/ step 2))
                  step))))))

(defun slider-value-at [state event ctx]
  (let [handle (slider-handle-size state ctx)
        coord (clamp (- (slider-event-coord state event ctx) (/ handle 2))
                     0
                     (slider-track-span state ctx))
        ratio (/ coord (slider-track-span state ctx))
        raw (+ (slider-min state)
               (* ratio (- (slider-max state) (slider-min state))))]
    (clamp (nearest-stepped-value state raw)
           (slider-min state)
           (slider-max state))))

(defun slider-thumb-shape [state ctx]
  (or (:thumb-shape state)
      (if (= (-> (slider-style ctx) :border :line-style) :bevel)
        :windows
        :rect)))

(defun slider-windows-style? [state ctx]
  (= (slider-thumb-shape state ctx) :windows))

(defun slider-track-color [state ctx]
  (or (:track-color state)
      (if (slider-windows-style? state ctx)
        (-> (slider-style ctx) :background)
        (-> (slider-style ctx) :border :color))
      default-track-color))

(defun slider-handle-color [state ctx]
  (or (:handle-color state)
      (-> (slider-style ctx) :background)
      default-handle-color))

(defun slider-border-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :color)
      default-border-color))

(defun slider-border-top-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :top :color)
      (slider-border-color state ctx)))

(defun slider-border-bottom-color [state ctx]
  (or (:border-color state)
      (-> (slider-style ctx) :border :bottom :color)
      (-> (slider-style ctx) :border :right :color)
      (slider-border-color state ctx)))

(defun slider-track-top-color [state ctx]
  (or (:track-border-color state)
      (slider-border-bottom-color state ctx)))

(defun slider-track-bottom-color [state ctx]
  (or (:track-border-color state)
      (slider-border-top-color state ctx)))

(defun slider-border-thickness [ctx]
  (or (-> (slider-style ctx) :border :thickness)
      1))

(defun slider-bevel? [ctx]
  (or (= (-> (slider-style ctx) :border :line-style) :bevel)
      (-> (slider-style ctx) :border :top :color)
      (-> (slider-style ctx) :border :right :color)
      (-> (slider-style ctx) :border :bottom :color)
      (-> (slider-style ctx) :border :left :color)))

(defun draw-slider-bevel! [rect tl-color br-color thickness]
  (dotimes [n thickness]
    (do
      (r/line! {:x (+ (:x rect) n)
                :y (+ (:y rect) n)}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (+ (:y rect) n)}
               tl-color)
      (r/line! {:x (+ (:x rect) n)
                :y (+ (:y rect) n)}
               {:x (+ (:x rect) n)
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               tl-color)
      (r/line! {:x (+ (:x rect) n)
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               br-color)
      (r/line! {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (+ (:y rect) n)}
               {:x (- (+ (:x rect) (:w rect)) (+ 1 n))
                :y (- (+ (:y rect) (:h rect)) (+ 1 n))}
               br-color))))

(defun draw-slider-handle-border! [state ctx rect]
  (if (slider-bevel? ctx)
    (draw-slider-bevel! rect
                        (slider-border-top-color state ctx)
                        (slider-border-bottom-color state ctx)
                        (slider-border-thickness ctx))
    (r/rect! rect {:color (slider-border-color state ctx)})))

(defun draw-slider-track-border! [state ctx rect]
  (if (slider-bevel? ctx)
    (draw-slider-bevel! rect
                        (slider-track-top-color state ctx)
                        (slider-track-bottom-color state ctx)
                        1)
    (r/rect! rect {:color (slider-border-color state ctx)})))

(defun slider-standard-track-rect [state ctx]
  (let [axis (slider-axis-size state ctx)
        cross (slider-cross-size state ctx)
        thickness (slider-standard-track-thickness state ctx)]
    (if (= (:axis state) :y)
      {:x (int (/ (- cross thickness) 2))
       :y 0
       :w thickness
       :h axis}
      {:x 0
       :y (int (/ (- cross thickness) 2))
       :w axis
       :h thickness})))

(defun slider-windows-track-rect [state ctx]
  (let [cross (slider-cross-size state ctx)
        handle (slider-handle-size state ctx)
        span (slider-track-span state ctx)
        thickness (slider-track-thickness state ctx)]
    (if (= (:axis state) :y)
      {:x (int (/ (- cross thickness) 2))
       :y (int (/ handle 2))
       :w thickness
       :h span}
      {:x (int (/ handle 2))
       :y (int (/ (- cross thickness) 2))
       :w span
       :h thickness})))

(defun slider-track-rect [state ctx]
  (if (slider-windows-style? state ctx)
    (slider-windows-track-rect state ctx)
    (slider-standard-track-rect state ctx)))

(defun slider-handle-rect [state ctx]
  (let [pos (slider-handle-pos state ctx)
        handle (slider-handle-size state ctx)
        cross (slider-cross-size state ctx)]
    (if (= (:axis state) :y)
      {:x 0
       :y pos
       :w cross
       :h handle}
      {:x pos
       :y 0
       :w handle
       :h cross})))

(defun draw-slider-horizontal-windows-handle! [state ctx rect]
  (let [point-height (min 6 (max 4 (int (/ (:h rect) 3))))
        body-height (max 1 (- (:h rect) point-height))
        color (slider-handle-color state ctx)
        tl-color (slider-border-top-color state ctx)
        br-color (slider-border-bottom-color state ctx)
        x (:x rect)
        y (:y rect)
        right (- (+ x (:w rect)) 1)
        body-bottom (- (+ y body-height) 1)
        bottom (- (+ y (:h rect)) 1)
        center-x (int (/ (+ x right) 2))]
    (do
      (r/rect! {:x x :y y :w (:w rect) :h body-height}
               {:fill true :color color})
      (dotimes [n point-height]
        (let [inset (* n 2)
              row-width (max 1 (- (:w rect) (* 2 inset)))]
          (r/rect! {:x (+ x (int (/ (- (:w rect) row-width) 2)))
                    :y (+ y body-height n)
                    :w row-width
                    :h 1}
                   {:fill true :color color})))
      (r/line! {:x x :y y} {:x right :y y} tl-color)
      (r/line! {:x x :y y} {:x x :y body-bottom} tl-color)
      (r/line! {:x x :y body-bottom} {:x center-x :y bottom} tl-color)
      (r/line! {:x right :y y} {:x right :y body-bottom} br-color)
      (r/line! {:x right :y body-bottom} {:x center-x :y bottom} br-color))))

(defun draw-slider-vertical-windows-handle! [state ctx rect]
  (let [point-width (min 6 (max 4 (int (/ (:w rect) 3))))
        body-width (max 1 (- (:w rect) point-width))
        color (slider-handle-color state ctx)
        tl-color (slider-border-top-color state ctx)
        br-color (slider-border-bottom-color state ctx)
        x (:x rect)
        y (:y rect)
        right (- (+ x (:w rect)) 1)
        body-right (- (+ x body-width) 1)
        bottom (- (+ y (:h rect)) 1)
        center-y (int (/ (+ y bottom) 2))]
    (do
      (r/rect! {:x x :y y :w body-width :h (:h rect)}
               {:fill true :color color})
      (dotimes [n point-width]
        (let [inset (* n 2)
              column-height (max 1 (- (:h rect) (* 2 inset)))]
          (r/rect! {:x (+ x body-width n)
                    :y (+ y (int (/ (- (:h rect) column-height) 2)))
                    :w 1
                    :h column-height}
                   {:fill true :color color})))
      (r/line! {:x x :y y} {:x body-right :y y} tl-color)
      (r/line! {:x x :y y} {:x x :y bottom} tl-color)
      (r/line! {:x body-right :y y} {:x right :y center-y} tl-color)
      (r/line! {:x x :y bottom} {:x body-right :y bottom} br-color)
      (r/line! {:x body-right :y bottom} {:x right :y center-y} br-color))))

(defun draw-slider-windows-handle! [state ctx rect]
  (if (= (:axis state) :y)
    (draw-slider-vertical-windows-handle! state ctx rect)
    (draw-slider-horizontal-windows-handle! state ctx rect)))

(defun draw-slider-handle! [state ctx]
  (let [rect (slider-handle-rect state ctx)]
    (if (slider-windows-style? state ctx)
      (draw-slider-windows-handle! state ctx rect)
      (do
        (r/rect! rect
                 {:fill true
                  :color (slider-handle-color state ctx)})
        (draw-slider-handle-border! state ctx rect)))))

(defun draw-slider-track! [state ctx]
  (let [rect (slider-track-rect state ctx)]
    (do
      (r/rect! rect
               {:fill true
                :color (slider-track-color state ctx)})
      (if (slider-windows-style? state ctx)
        (draw-slider-track-border! state ctx rect)))))

(defun slider-set-value [state event ctx]
  (let [value (slider-value-at state event ctx)]
    (do
      (ui/emit! (:view ctx) :slider/change value)
      (assoc state :value value))))

(defcomponent ui/slider
  {:focusable true
   :class :ui/slider
   :style {:width :fill
           :height 18}
   :init (fn [state ctx]
           (assoc state :value (slider-value state)))
   :update (fn [state ctx]
             (assoc state :value (slider-value state)))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (slider-set-value state event ctx)))
   :on-drag (fn [state event ctx]
              (slider-set-value state event ctx))
   :render (fn [state ctx]
             (do
               (draw-slider-track! state ctx)
               (draw-slider-handle! state ctx)))})

(defun make [{:keys [style value min max step axis thumb-shape]}]
  {:mode 'ui/slider
   :style (or style {})
   :state {:value value
           :min min
           :max max
           :step step
           :axis (or axis :x)
           :thumb-shape thumb-shape}})
