(ns pixils.ui.number-input
  (:require pixils
            [roo.string :as string]
            [pixils.ui :as ui]
            pixils.ui.text-input))



;; Component state

(def NUMBER-INPUT-UI-STATE-KEYS
  "Component-state keys accepted by `ui/number-input`."
  [:value
   :text-value
   :disabled?
   :read-only?
   :auto-focus?
   :emit-change?
   :emit-blur?
   :min
   :max
   :step
   :allow-negative?
   :allow-fractions?
   :commit-on
   :committed-value])



;; Numeric text policy

(defun allows-negative? [state]
  (or (:allow-negative? state)
      (nil? (:min state))
      (< (:min state) 0)))

(defun partial-fraction-text? [text state]
  (or (= text ".")
      (and (= text "-.") (allows-negative? state))
      (string/ends-with? text ".")))

(defun number-text-digit? [text]
  (and (= 1 (count text))
       (some? (int text))))

(defun editable-number-character? [text state]
  (or (number-text-digit? text)
      (and (= text "-") (allows-negative? state))
      (and (= text ".") (:allow-fractions? state))))

(defun editable-number-text? [text state]
  (not (any? (or text "")
             (fn [char]
               (not (editable-number-character? (str char) state))))))

(defun parsed-number [text state]
  (if (and (:allow-fractions? state)
           (contains? text '.'))
    (float text)
    (int text)))

(defun integer-text? [value state]
  (let [text (or value "")
        parsed (parsed-number text state)]
    (cond
      (= text "") true
      (= text "-") (allows-negative? state)
      (and (:allow-fractions? state)
           (partial-fraction-text? text state))
      true
      (nil? parsed) false
      (string/starts-with? text "-") (allows-negative? state)
      :default true)))

(defun number-input-accepts-text? [text state]
  (case (:commit-on state)
    :blur (editable-number-text? text state)
    :default (integer-text? text state)))

(defun clamp-number [value state]
  (let [min-value (:min state)
        max-value (:max state)
        low (if (nil? min-value) value (max min-value value))]
    (if (nil? max-value) low (min max-value low))))

(defun number-input-text [value]
  (if (nil? value) "" (str value)))

(defun committed-value-state-transition
  "Returns the committed numeric value for an actual value transition."
  [current candidate changed-keys]
  {:committed-value
   (cond
     (contains? changed-keys :committed-value) (:committed-value candidate)
     (contains? changed-keys :value) (:value candidate)
     :default (:committed-value current))})

(defun commit-number-input-value [state value ctx]
  (let [clamped (unless (nil? value)
                  (clamp-number value state))
        text (number-input-text clamped)]
    (ui/emit! (:view ctx) :number-input/change {:value clamped
                                                :text text})
    (merge state {:value clamped
                  :committed-value clamped
                  :text-value text})))

(defun commit-number-input-text [state text ctx]
  (let [parsed (parsed-number text state)
        value (unless (nil? parsed) (clamp-number parsed state))
        normalized-text (cond
                          (nil? value) text
                          (and (:allow-fractions? state)
                               (contains? text '.')
                               (= value parsed)) text
                          :default (number-input-text value))]
    (ui/emit! (:view ctx) :number-input/change {:value value
                                                :text normalized-text})
    (merge state {:value value
                  :committed-value value
                  :text-value normalized-text})))

(defun revert-number-input-text [state]
  (let [value (:committed-value state)
        text (number-input-text value)]
    (merge state {:value value
                  :text-value text})))

(defun finalize-number-input-text [state ctx]
  (let [text (or (:text-value state) "")
        parsed (parsed-number text state)]
    (cond
      (= text "")
      (commit-number-input-value state nil ctx)

      (nil? parsed)
      (revert-number-input-text state)

      :default
      (commit-number-input-value state parsed ctx))))

(defun step-number-input [state direction ctx]
  (let [step (or (:step state) 1)
        base (or (:value state) 0)]
    (commit-number-input-value state (+ base (* direction step)) ctx)))



;; Component

(defcomponent ui/number-input
  {:extend 'ui/text-input
   :ui/state-keys NUMBER-INPUT-UI-STATE-KEYS
   :ui/models [{:owns [:committed-value]
                :depends-on [:value]
                :transition committed-value-state-transition}]
   :init-ui (fn [{:keys [value] :as ui-state} _state _ctx]
              (merge ui-state
                     {:text-value (number-input-text value)
                      :committed-value value}))
   :on {:text-input-inner/change
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)
                text (-> event :payload :value)]
            (when (number-input-accepts-text? text ui-state)
              (ui/set-ui-state!
               ctx
               (case (:commit-on ui-state)
                 :blur
                 (do
                   (ui/emit! (:view ctx)
                             :number-input/text-change
                             {:value text
                              :text text})
                   (assoc ui-state :text-value text))

                 :default
                 (commit-number-input-text ui-state text ctx))))
            state))
        :text-input-inner/blur
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)]
            (when (= :blur (:commit-on ui-state))
              (ui/set-ui-state! ctx
                                (finalize-number-input-text ui-state ctx)))
            state))}
   :on-key-down (fn [state event ctx]
                  (let [ui-state (-> ctx :view :ui-state)]
                    (unless (:disabled? ui-state)
                      (let [next-ui-state
                            (cond
                              (= :key/up (:key event))
                              (do
                                (ui/stop-propagation! event)
                                (step-number-input ui-state 1 ctx))

                              (= :key/down (:key event))
                              (do
                                (ui/stop-propagation! event)
                                (step-number-input ui-state -1 ctx))

                              (= :key/enter (:key event))
                              (do
                                (ui/stop-propagation! event)
                                (case (:commit-on ui-state)
                                  :blur (finalize-number-input-text ui-state ctx)
                                  :default ui-state))

                              :default
                              ui-state)]
                        (ui/set-ui-state! ctx next-ui-state)))
                    state))})



;; Make function

(defun make
  "Builds an isolated `ui/number-input` component.

  Numeric behavior options are stored under `:state :component`; ordinary
  `:state` entries remain application state. Component keys supplied directly
  in `:state` remain accepted for migration compatibility."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [component (merge (select-keys state NUMBER-INPUT-UI-STATE-KEYS)
                         (:component state)
                         (select-keys opts NUMBER-INPUT-UI-STATE-KEYS))]
    (cond-> {:mode 'ui/number-input
             :state (assoc state :component component)
             :ui/state-policy (or state-policy :isolated)}
      (contains? opts :style) (assoc :style style)
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state))))
