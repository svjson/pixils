(ns pixils.ui.number-input
  (:require pixils
            [pixils.ui :as ui]
            pixils.ui.text-input))

(defun allows-negative? [state]
  (or (= (:allow-negative? state) true)
      (nil? (:min state))
      (< (:min state) 0)))

(defun allows-fractions? [state]
  (= (:allow-fractions? state) true))

(defun partial-fraction-text? [text state]
  (or (= text ".")
      (and (= text "-.") (allows-negative? state))
      (= (substr text (- (count text) 1) 1) ".")))

(defun text-contains? [text needle index]
  (cond
    (> (+ index (count needle)) (count text)) false
    (= (substr text index (count needle)) needle) true
    :default (text-contains? text needle (inc index))))

(defun fraction-text? [text]
  (text-contains? text "." 0))

(defun parsed-number [text state]
  (if (and (allows-fractions? state)
           (fraction-text? text))
    (float text)
    (int text)))

(defun integer-text? [value state]
  (let [text (or value "")
        parsed (parsed-number text state)]
    (cond
      (= text "") true
      (= text "-") (allows-negative? state)
      (and (allows-fractions? state)
           (partial-fraction-text? text state))
      true
      (nil? parsed) false
      (= (substr text 0 1) "-") (allows-negative? state)
      :default true)))

(defun clamp-number [value state]
  (let [min-value (:min state)
        max-value (:max state)
        low (if (nil? min-value) value (max min-value value))]
    (if (nil? max-value) low (min max-value low))))

(defun number-input-text [value]
  (if (nil? value) "" (str value)))

(defun normalize-number-input-state [state]
  (let [value (:value state)]
    (if (or (nil? (:text-value state))
            (not= value (:committed-value state)))
      (let [text (number-input-text value)]
        (-> state
            (assoc :text-value text)
            (assoc :last-text-value text)
            (assoc :committed-value value)))
      state)))

(defun commit-number-input-value [state value ctx]
  (let [clamped (clamp-number value state)
        text (number-input-text clamped)]
    (do
      (ui/emit! (:view ctx) :number-input/change {:value clamped
                                                  :text text})
      (-> state
          (assoc :value clamped)
          (assoc :committed-value clamped)
          (assoc :text-value text)
          (assoc :last-text-value text)
          (assoc :invalid? false)))))

(defun commit-number-input-text [state text ctx]
  (let [parsed (parsed-number text state)
        value (when (not (nil? parsed)) (clamp-number parsed state))
        normalized-text (if (nil? value)
                          text
                          (if (and (allows-fractions? state)
                                   (fraction-text? text)
                                   (= value parsed))
                            text
                            (number-input-text value)))]
    (do
      (ui/emit! (:view ctx) :number-input/change {:value value
                                                  :text normalized-text})
      (-> state
          (assoc :value value)
          (assoc :committed-value value)
          (assoc :text-value normalized-text)
          (assoc :last-text-value normalized-text)
          (assoc :invalid? (and (> (count text) 0)
                                (nil? value)))))))

(defun commit-number-input-text-if-changed [state ctx]
  (let [text (or (:text-value state) "")]
    (if (= text (:last-text-value state))
      state
      (commit-number-input-text state text ctx))))

(defun step-number-input [state direction ctx]
  (let [step (or (:step state) 1)
        base (or (:value state) 0)]
    (commit-number-input-value state (+ base (* direction step)) ctx)))

(defcomponent ui/number-input
  {:init (fn [state ctx]
           (normalize-number-input-state state))
   :update (fn [state ctx]
             (normalize-number-input-state state))
   :children [{:mode 'ui/text-input-inner
               :state {:value (ui/bind-state :text-value)
                       :disabled? (ui/bind-state :disabled?)
                       :auto-focus? (ui/bind-state :auto-focus?)
                       :accept-value? integer-text?
                       :emit-change? false
                       :allow-negative? (ui/bind-state :allow-negative?)
                       :allow-fractions? (ui/bind-state :allow-fractions?)
                       :min (ui/bind-state :min)
                       :max (ui/bind-state :max)}}]
   :on {:text-input/change (fn [state event ctx]
                             (do
                               (ui/stop-propagation! event)
                               (commit-number-input-text state
                                                         (-> event :payload :value)
                                                         ctx)))}
   :on-key-down (fn [state event ctx]
                  (if (:disabled? state)
                    state
                    (cond
                      (= :key/up (:key event))
                      (do
                        (ui/stop-propagation! event)
                        (step-number-input state 1 ctx))

                      (= :key/down (:key event))
                      (do
                        (ui/stop-propagation! event)
                        (step-number-input state -1 ctx))

                      :default
                      (commit-number-input-text-if-changed state ctx))))})

(defun make [{:keys [style value min max step allow-negative? allow-fractions? disabled? auto-focus?]}]
  {:mode 'ui/number-input
   :style (or style {})
   :state {:value value
           :min min
           :max max
           :step step
           :allow-negative? allow-negative?
           :allow-fractions? allow-fractions?
           :disabled? disabled?
           :auto-focus? auto-focus?}})
