(ns pixils.ui.number-input
  (:require pixils
            [roo.string :as string]
            [pixils.ui :as ui]
            pixils.ui.text-input))



;; Component state

(def NUMBER-INPUT-UI-STATE-KEYS
  "Component-state keys accepted by `ui/number-input`."
  [:value
   :text-value
   :disabled?
   :read-only?
   :auto-focus?
   :emit-change?
   :emit-blur?
   :min
   :max
   :step
   :allow-negative?
   :allow-fractions?
   :commit-on
   :committed-value])



;; Numeric text policy

(defun allows-negative? [state]
  (or (:allow-negative? state)
      (nil? (:min state))
      (< (:min state) 0)))

(defun editable-text? [text state]
  (not (any? (or text "")
             (fn [character]
               (not (or (digit? character)
                        (and (= character '-') (allows-negative? state))
                        (and (= character '.') (:allow-fractions? state))))))))

(defun incomplete-text? [text state]
  (or (blank? text)
      (and (= text "-")
           (allows-negative? state))
      (and (:allow-fractions? state)
           (or (= text ".")
               (and (= text "-.")
                    (allows-negative? state))))))

(defun accepts-text? [text state]
  (or (incomplete-text? text state)
      (and (editable-text? text state)
           (some? (number text)))))

(defun text-for-value [value]
  (if (nil? value) "" (str value)))

(defun committed-value-state-transition
  "Returns the committed numeric value for an actual value transition."
  [current candidate changed-keys]
  {:committed-value
   (cond
     (contains? changed-keys :committed-value) (:committed-value candidate)
     (contains? changed-keys :value) (:value candidate)
     :default (:committed-value current))})

(defun commit-value [state value ctx]
  (let [clamped (clamp value (:min state) (:max state))
        text (text-for-value clamped)]
    (ui/emit! (:view ctx) :number-input/change {:value clamped
                                                :text text})
    (merge state {:value clamped
                  :committed-value clamped
                  :text-value text})))

(defun commit-text [state text ctx]
  (let [parsed (number text)
        value (clamp parsed (:min state) (:max state))
        normalized-text (cond
                          (nil? value) text
                          (and (float? parsed)
                               (= value parsed)) text
                          :default (text-for-value value))]
    (ui/emit! (:view ctx) :number-input/change {:value value
                                                :text normalized-text})
    (merge state {:value value
                  :committed-value value
                  :text-value normalized-text})))

(defun revert-text [state]
  (let [value (:committed-value state)
        text (text-for-value value)]
    (merge state {:value value
                  :text-value text})))

(defun finalize-text [state ctx]
  (let [text (or (:text-value state) "")
        parsed (number text)]
    (cond
      (= text "")
      (commit-value state nil ctx)

      (nil? parsed)
      (revert-text state)

      :default
      (commit-value state parsed ctx))))

(defun content-policy
  "Applies an editor content operation to number-input UI state.

  `operation` is `:edit` for a candidate numeric string or `:commit` when
  editing finishes. Returns the next UI state, or `nil` when an edit is
  rejected."
  [state operation text ctx]
  (case operation
    :edit
    (when (accepts-text? text state)
      (case (:commit-on state)
        :blur
        (do
          (ui/emit! (:view ctx)
                    :number-input/text-change
                    {:value text
                     :text text})
          (assoc state :text-value text))

        :default
        (commit-text state text ctx)))

    :commit
    (case (:commit-on state)
      :blur (finalize-text state ctx)
      :default state)

    :default state))

(defun step-value [state direction ctx]
  (let [step (or (:step state) 1)
        base (or (:value state) 0)]
    (commit-value state (+ base (* direction step)) ctx)))



;; Component

(defcomponent ui/number-input
  {:extend 'ui/text-input
   :ui/state-keys NUMBER-INPUT-UI-STATE-KEYS
   :ui/models [{:owns [:committed-value]
                :depends-on [:value]
                :transition committed-value-state-transition}]
   :action-map {:key/up {:action :number-input/step
                         :payload {:direction 1}}
                :key/down {:action :number-input/step
                           :payload {:direction -1}}
                :key/enter :number-input/commit}
   :init-ui (fn [{:keys [value] :as ui-state} _state _ctx]
              (merge ui-state
                     {:text-value (text-for-value value)
                      :committed-value value
                      :content-policy (or (:content-policy ui-state)
                                          content-policy)}))
   :on {:number-input/step
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)]
            (unless (:disabled? ui-state)
              (ui/set-ui-state! ctx
                                (step-value ui-state
                                            (-> event :payload :direction)
                                            ctx)))
            state))
        :number-input/commit
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)]
            (unless (:disabled? ui-state)
              (ui/set-ui-state!
               ctx
               (apply (:content-policy ui-state)
                      [ui-state :commit nil ctx])))
            state))}})



;; Make function

(defun make
  "Builds an isolated `ui/number-input` component.

  Numeric behavior options are stored under `:state :component`; ordinary
  `:state` entries remain application state. Component keys supplied directly
  in `:state` remain accepted for migration compatibility."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [component (merge (select-keys state NUMBER-INPUT-UI-STATE-KEYS)
                         (:component state)
                         (select-keys opts NUMBER-INPUT-UI-STATE-KEYS))]
    (cond-> {:mode 'ui/number-input
             :state (assoc state :component component)
             :ui/state-policy (or state-policy :isolated)}
      (contains? opts :style) (assoc :style style)
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state))))
