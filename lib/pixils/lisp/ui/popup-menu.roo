(ns pixils.ui.popup-menu
  (:require pixils
            [pixils.color :as c]
            [pixils.image :as img]
            [pixils.rect :as rect]
            [pixils.render :as r]
            [pixils.ui :as ui]
            [pixils.ui.menu-model :as model]
            [pixils.ui.option-list :as option-list]))



;; Popup model and construction

(defun child-view-at
  "Resolve a popup row view by index.

  Args:
  - `view`: Parent view.
  - `index`: Candidate child index.

  Returns:
  The child view, or `nil` for an invalid index."
  [view index]
  (let [content (head (ui/children view))
        children (when content (ui/children content))]
    (when (and (some? index)
               (>= index 0)
               (< index (count children)))
      (nth children index))))

(defun item-checked?
  "Derive whether an option or toggle menu node is checked.

  Args:
  - `node`: Normalized menu node.
  - `state`: Application state containing the node's selection path.

  Returns:
  The derived checked value."
  [node state]
  (case (:item-type node)
    :toggle (get-in state (:selected-path node))
    :option (= (get-in state (:selected-path node))
               (:value node))
    :default false))

(defun item-view
  "Return the popup row component for a normalized node.

  Args:
  - `index`: Row index.
  - `node`: Normalized menu node.

  Returns:
  A separator, option row, or standard row declaration."
  [_index node]
  (cond
    (= :separator (:node-type node))
    {:component 'ui/menu-separator}

    (or (= (:item-type node) :option)
        (= (:item-type node) :toggle))
    {:component 'ui/popup-menu-option-item}

    :default
    {:component 'ui/popup-menu-item}))

(defun decorate-item
  "Add popup-specific state to an option-list row declaration.

  Args:
  - `application-state`: Application values retained by popup rows.
  - `child`: Option-list row declaration.
  - `option-list-state`: Popup option-list UI state.
  - `index`: Row index.
  - `node`: Normalized menu node.

  Returns:
  The decorated popup row declaration."
  [application-state child _option-list-state _index node]
  (let [has-submenu (model/submenu-node? node)]
    (-> child
        (option-list/merge-item-state
         {:node node
          :label (:display-text node)
          :trailing-shortcut-text (if has-submenu "" (:shortcut-text node))
          :has-submenu has-submenu
          :checked? (item-checked? node application-state)
          :show-marker (or (= (:item-type node) :option)
                           (= (:item-type node) :toggle))})
        (update :state
                (fn [row-state]
                  (merge row-state
                         (select-keys application-state
                                      [:option-state :game :preferences])))))))

(defun children
  "Build the outer and inner popup view specifications.

  Args:
  - `items`: Normalized menu nodes.
  - `state`: Popup and application inputs.

  Returns:
  Popup child specifications."
  [items state]
  (let [component
        (merge (option-list/component-state
                {:options items
                 :active-index (:active-index state)
                 :auto-row-height? false
                 :item=> item-view})
               {:input-source (:input-source state)
                :nested? (:nested? state)
                :decorate-item
                (fn [child option-list-state index node]
                  (decorate-item state
                                 child
                                 option-list-state
                                 index
                                 node))})]
    [{:mode 'ui/popup-menu-outer
      :style {:position :absolute
              :width :shrink
              :height :shrink
              :left 0
              :top 0}
      :children
      [{:mode 'ui/popup-menu-inner
        :ui/state-policy :isolated
        :state {:component component}
        :children [{:mode 'ui/popup-menu-content
                    :ui/state-policy :isolated
                    :ui-state
                    {:content-ui-state
                     (ui/project-state :content-state)}
                    :children (option-list/item-children component)}]}]}]))

(defun open-with-overlay!
  "Open a popup using post-layout overlay placement.

  Args:
  - `items`: Normalized menu nodes.
  - `state`: Popup and application inputs.
  - `origin-view`: View that receives the popup result.
  - `overlay`: Anchor and preferred/fallback placement metadata.

  Returns:
  The pushed mode result, or `nil` for an empty item list."
  [items state origin-view overlay]
  (let [input-source (or (:input-source state) :mouse)
        popup-state {:items items
                     :active-index
                     (when (not= :mouse input-source)
                       (model/first-selectable-index items))
                     :input-source input-source
                     :nested? (or (:nested? state) false)
                     :menu-scale (:menu-scale state)
                     :option-state (:option-state state)
                     :game (:game state)
                     :preferences (:preferences state)}]
    (when (not-empty? items)
      (push-mode!
       (or (:popup-mode state) 'ui/popup-menu)
       popup-state
       {:origin {:view origin-view
                 :event (or (:result-event state) :menu/select)}
        :overlay overlay
        :style {:scale (:menu-scale state)}
        :children (children items (merge state popup-state))}))))

(defun open-at-position!
  "Open a popup overlay for normalized items at an absolute position.

  Args:
  - `items`: Normalized menu nodes.
  - `state`: Popup and application inputs, including an optional
    `:input-source` that defaults to `:mouse`.
  - `origin-view`: View that receives the popup result.
  - `position`: Absolute popup origin.

  Returns:
  The pushed mode result, or `nil` for an empty item list."
  [items state origin-view position]
  (open-with-overlay!
   items
   state
   origin-view
   {:anchor-bounds (rect/make-rect {:x (:left position)
                                    :y (:top position)
                                    :w 0
                                    :h 0})
    :placement :bottom-start
    :fallback-placement :top-start}))

(defun open-at-view!
  "Open a node's submenu relative to an anchor view.

  Args:
  - `node`: Enabled normalized node owning submenu items.
  - `state`: Popup and application inputs, including an optional input source.
  - `anchor-view`: View used for placement and result routing.
  - `placement`: Preferred overlay placement keyword.

  Returns:
  The pushed mode result, or `nil` when the node cannot open."
  [node state anchor-view placement]
  (when (and (not (:disabled? node))
             (model/submenu-node? node))
    (open-with-overlay!
     (:items node)
     (assoc state
            :menu-scale
            (or (:visual-scale anchor-view)
                (:menu-scale state)))
     anchor-view
     {:anchor anchor-view
      :placement placement
      :fallback-placement
      (case placement
        :right-start :left-start
        :default :top-start)})))

(defun open-context!
  "Normalize and open a context-menu overlay.

  Args:
  - `menu-definition`: Declarative menu tree and optional settings.
  - `position`: Global popup origin with `:x` and `:y` coordinates.
  - `state`: Application and popup inputs, including an optional keymap.
  - `ctx`: Hook context whose view receives the popup result.

  Returns:
  The pushed context-menu mode result, or `nil` for an empty menu."
  [menu-definition position state ctx]
  (let [menu (model/normalize menu-definition (:keymap state))]
    (open-at-position! (:items menu)
                             (merge state
                                    {:popup-mode 'ui/context-menu
                                     :input-source :mouse})
                             (:view ctx)
                             {:left (:x position)
                              :top (:y position)})))

(defun open!
  "Open a node's popup below the current hook view.

  Args:
  - `node`: Normalized node owning submenu items.
  - `state`: Popup and application inputs.
  - `ctx`: Hook context containing the anchor view.

  Returns:
  The pushed popup mode result, or `nil`."
  [node state ctx]
  (open-at-view! node state (:view ctx) :bottom-start))

(defun open-submenu!
  "Open a nested popup to the right of an item view.

  Args:
  - `node`: Normalized node owning submenu items.
  - `state`: Parent popup and application inputs.
  - `anchor-view`: Item view used for placement and result routing.

  Returns:
  The pushed popup mode result, or `nil`."
  [node state anchor-view]
  (open-at-view! node
                 (assoc state
                        :nested? true
                        :result-event :popup-menu/submenu-result)
                 anchor-view
                 :right-start))

(defun activate-index!
  "Activate the logical popup item at an index.

  Args:
  - `state`: Popup UI and application state.
  - `ctx`: Popup-inner hook context.
  - `index`: Candidate item index.

  Returns:
  The unchanged shared state after opening or emitting."
  [state ctx index]
  (let [node (model/highlighted-item (:options state) index)
        submenu? (and node (model/submenu-node? node))
        child-view (when submenu?
                     (child-view-at (:view ctx) index))]
    (cond
      (or (nil? node) (:disabled? node))
      state

      (and submenu? child-view)
      (do
        (open-submenu! node state child-view)
        state)

      (and (not submenu?) (:action node))
      (do
        (ui/emit! (:view ctx)
                  :menu/select
                  {:type :action
                   :action (:action node)
                   :payload (:payload node)})
        state)

      :default
      state)))



;; Popup item state

(def ITEM-UI-STATE-KEYS
  "Canonical UI-state keys owned by `ui/popup-menu-item`."
  [:node
   :trailing-shortcut-text
   :has-submenu
   :checked?
   :show-marker
   :highlighted])

(def INNER-UI-STATE-KEYS
  "Additional UI-state keys owned by `ui/popup-menu-inner`."
  [:input-source
   :nested?])

(defun set-navigation!
  "Apply an intrinsic popup navigation transition.

  Args:
  - `ctx`: Popup-inner hook context.
  - `updates`: New input source and optional active index."
  [ctx updates]
  (let [ui-state (merge (-> ctx :view :ui-state) updates)]
    (ui/set-ui-state!
     ctx
     (assoc-in ui-state
               [:content-state :active-index]
               (:active-index ui-state)))))



;; Popup item components

(defcomponent ui/popup-menu-item
  {:extend 'ui/option-item
   :class :menu/item
   :style {:layout {:direction :row
                    :align-items :center}}
   :ui/state-keys ITEM-UI-STATE-KEYS
   :ui/models [{:owns [:highlighted]
                :depends-on [:index :active-index :disabled? :active?]
                :transition (fn [_current candidate _changed-keys]
                              {:highlighted (:active? candidate)})}]
   :update-ui nil
   :on-mouse-motion (fn [state _event ctx]
                      (let [ui-state (-> ctx :view :ui-state)]
                        (unless (:disabled? ui-state)
                          (ui/emit! (:view ctx)
                                    :popup-menu/hover
                                    {:index (:index ui-state)})))
                      state)
   :on-mouse-down (fn [state event ctx]
                    (let [ui-state (-> ctx :view :ui-state)]
                      (when (and (not (:disabled? ui-state))
                                 (:has-submenu ui-state))
                        (open-submenu! (:node ui-state)
                                       (merge state
                                              ui-state
                                              {:input-source :mouse})
                                       (:view ctx)))
                      (ui/stop-propagation! event)
                      state))
   :on {:menu/select (fn [state event ctx]
                       (let [ui-state (-> ctx :view :ui-state)]
                         (ui/stop-propagation! event)
                         (unless (:disabled? ui-state)
                           (ui/emit! (:view ctx) :menu/select (:payload event)))
                         state))
        :popup-menu/submenu-result (fn [state {:keys [payload] :as event} ctx]
                                     (ui/stop-propagation! event)
                                     (when (and payload
                                                (not= :navigate-parent (:type payload)))
                                       (ui/emit! (:view ctx) :menu/select payload))
                                     state)}
   :children [{:mode 'ui/menu-option-indicator
               :state {:checked? (ui/project-state :checked?)
                       :show-marker (ui/project-state :show-marker)}}
              {:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/project-state :label)}}
              {:mode 'ui/menu-item-trailing
               :state {:has-submenu (ui/project-state :has-submenu)
                       :highlighted (ui/project-state :highlighted)
                       :shortcut-text (ui/project-state :trailing-shortcut-text)}}]})

(defcomponent ui/popup-menu-option-item
  {:extend 'ui/popup-menu-item})

(defcomponent ui/menu-separator {})



;; Popup item rendering

(defun option-indicator-text-args
  "Normalize themed text arguments for menu indicators.

  Args:
  - `style`: Effective indicator style.

  Returns:
  Render-ready text arguments."
  [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map key value]
               (if (nil? value)
                 arg-map
                 (assoc arg-map
                        key
                        (case key
                          :font (if (keyword? value)
                                  value
                                  (keyword value))
                          :default value))))))

(defun render-submenu-indicator!
  "Render the themed submenu indicator for a popup row.

  Args:
  - `state`: Shared compatibility state.
  - `ctx`: Render hook context."
  [_state ctx]
  (let [ui-state (-> ctx :view :ui-state)
        indicator (ui/theme-var ctx :menu-submenu-indicator {})
        highlighted (:highlighted ui-state)
        text (if (:has-submenu ui-state)
               (or (when highlighted (:highlighted-text indicator))
                   (:text indicator)
                   "")
               "")
        image (when (:has-submenu ui-state)
                (or (when highlighted (:highlighted-image indicator))
                    (:image indicator)))
        text-args (option-indicator-text-args
                   (-> ctx :view :effective-style))]
    (when image
      (let [dim (img/size image)
            y (if dim
                (int (/ (- (-> ctx :view :bounds :h) (:h dim)) 2))
                0)]
        (r/image! image {:x 0 :y y})))
    (unless (empty? text)
      (r/text! text {:x 0 :y 0} text-args))))

(defcomponent ui/menu-submenu-indicator
  {:class :menu/submenu-indicator
   :ui/state-keys [:has-submenu :highlighted]
   :render render-submenu-indicator!})

(defcomponent ui/menu-item-trailing
  {:class :menu/trailing-column
   :style {:layout {:direction :row
                    :align-items :center}}
   :ui/state-keys [:has-submenu :highlighted :shortcut-text]
   :children [{:mode 'ui/text
               :class :menu/shortcut-text
               :state {:value (ui/project-state :shortcut-text)}}
              {:mode 'ui/menu-submenu-indicator
               :state {:has-submenu (ui/project-state :has-submenu)
                       :highlighted (ui/project-state :highlighted)}}]})

(defun draw-option-checkmark-symbol!
  "Draw the built-in pixel checkmark symbol.

  Args:
  - `x`: Left drawing coordinate.
  - `y`: Top drawing coordinate.
  - `color`: Checkmark color."
  [x y color]
  (r/line! {:x (+ x 7) :y y} {:x (+ x 7) :y (+ y 1)} color)
  (r/line! {:x (+ x 6) :y (+ y 2)} {:x (+ x 7) :y (+ y 2)} color)
  (r/line! {:x (+ x 6) :y (+ y 3)} {:x (+ x 6) :y (+ y 3)} color)
  (r/line! {:x (+ x 5) :y (+ y 4)} {:x (+ x 6) :y (+ y 4)} color)
  (r/line! {:x x :y (+ y 5)} {:x (+ x 1) :y (+ y 5)} color)
  (r/line! {:x (+ x 5) :y (+ y 5)} {:x (+ x 5) :y (+ y 5)} color)
  (r/line! {:x (+ x 1) :y (+ y 6)} {:x (+ x 2) :y (+ y 6)} color)
  (r/line! {:x (+ x 4) :y (+ y 6)} {:x (+ x 5) :y (+ y 6)} color)
  (r/line! {:x (+ x 2) :y (+ y 7)} {:x (+ x 2) :y (+ y 7)} color)
  (r/line! {:x (+ x 4) :y (+ y 7)} {:x (+ x 4) :y (+ y 7)} color)
  (r/line! {:x (+ x 2) :y (+ y 8)} {:x (+ x 4) :y (+ y 8)} color)
  (r/line! {:x (+ x 3) :y (+ y 9)} {:x (+ x 3) :y (+ y 9)} color))

(defun render-option-indicator-symbol!
  "Render a built-in option-indicator symbol.

  Args:
  - `symbol`: Symbol keyword to render.
  - `text-args`: Render arguments supplying symbol color.
  - `ctx`: Render hook context."
  [symbol text-args ctx]
  (case symbol
    :checkmark (draw-option-checkmark-symbol!
                (int (/ (- (-> ctx :view :bounds :w) 8) 2))
                (int (/ (- (-> ctx :view :bounds :h) 10) 2))
                (or (:color text-args) c/BLACK))
    :default nil))

(defun render-option-indicator!
  "Render the themed option indicator for a popup row.

  Args:
  - `state`: Shared compatibility state.
  - `ctx`: Render hook context."
  [_state ctx]
  (let [ui-state (-> ctx :view :ui-state)
        indicator (ui/theme-var ctx :menu-option-indicator {})
        show-marker? (get ui-state :show-marker true)
        checked? (:checked? ui-state)
        image (when (and checked? show-marker?)
                (:selected-image indicator))
        symbol (when (and checked? show-marker?)
                 (:selected-symbol indicator))
        text (if show-marker?
               (if checked?
                 (or (:selected-text indicator) "")
                 (or (:unselected-text indicator) ""))
               "")
        text-args (option-indicator-text-args
                   (-> ctx :view :effective-style))]
    (when image
      (let [dim (img/size image)
            x (if dim
                (int (/ (- (-> ctx :view :bounds :w) (:w dim)) 2))
                0)
            y (if dim
                (int (/ (- (-> ctx :view :bounds :h) (:h dim)) 2))
                0)]
        (r/image! image {:x x :y y})))
    (when symbol
      (render-option-indicator-symbol! symbol text-args ctx))
    (unless (empty? text)
      (let [dim (r/text-size text text-args)
            x (if dim
                (int (/ (- (-> ctx :view :bounds :w) (:w dim)) 2))
                0)
            y (if dim
                (int (/ (- (-> ctx :view :bounds :h) (:h dim)) 2))
                0)]
        (r/text! text {:x x :y y} text-args)))))

(defcomponent ui/menu-option-indicator
  {:class :menu/option-indicator
   :ui/state-keys [:checked? :show-marker]
   :render render-option-indicator!})



;; Popup modes and keyboard navigation

(defmode ui/popup-menu
  {:on-mouse-down (fn [state event _ctx]
                    (pop-mode! {:type :dismiss
                                :global-position (:global-position event)})
                    state)
   :on {:menu/select (fn [state event _ctx]
                       (ui/stop-propagation! event)
                       (pop-mode! (:payload event))
                       state)}
   :compose {:render :pass}})

(defmode ui/context-menu
  {:on-mouse-down (fn [state _event _ctx]
                    (pop-mode! {:type :dismiss})
                    state)
   :on {:menu/select (fn [state event _ctx]
                       (ui/stop-propagation! event)
                       (pop-mode! (:payload event))
                       state)}
   :compose {:render :pass}})

(defcomponent ui/popup-menu-outer {})

(defcomponent ui/popup-menu-content
  {:ui/state-keys [:content-ui-state]
   :style {:layout {:direction :column}}})

(defcomponent ui/popup-menu-inner
  {:extend 'ui/option-list
   :focusable true
   :content-size nil
   :style {:layout {:direction :column}}
   :ui/state-keys INNER-UI-STATE-KEYS
   :init-ui (fn [ui-state state ctx]
              (ui/focus! ctx)
              (-> ui-state
                  (assoc :content-state
                         (option-list/content-state ui-state state))
                  (option-list/sync-rendered-items-in
                   (head (ui/children ctx)))))
   :update-ui nil
   :after-layout-ui nil
   :on-key-down
   (fn [state event ctx]
     (let [ui-state (-> ctx :view :ui-state)]
       (case (:key event)
         :key/right (let [index (:active-index ui-state)
                          next-state (assoc ui-state :input-source :keyboard)
                          node (model/highlighted-item (:options next-state) index)
                          child-view (child-view-at (:view ctx) index)]
                      (ui/stop-propagation! event)
                      (when (and node child-view (model/submenu-node? node))
                        (open-submenu! node (merge state next-state) child-view))
                      (when (and (not (:nested? next-state))
                                 (or (nil? node)
                                     (not (model/submenu-node? node))))
                        (pop-mode! {:type :navigate-top
                                    :direction :right}))
                      (set-navigation! ctx {:input-source :keyboard})
                      state)

         :key/left (do (ui/stop-propagation! event)
                       (if (:nested? ui-state)
                         (pop-mode! {:type :navigate-parent})
                         (pop-mode! {:type :navigate-top
                                     :direction :left}))
                       state)

         :key/down (do (ui/stop-propagation! event)
                       (set-navigation!
                        ctx
                        {:input-source :keyboard
                         :active-index (model/move-highlight-index
                                        (:options ui-state)
                                        (:active-index ui-state)
                                        1)})
                       state)

         :key/up (do (ui/stop-propagation! event)
                     (set-navigation!
                      ctx
                      {:input-source :keyboard
                       :active-index (model/move-highlight-index
                                      (:options ui-state)
                                      (:active-index ui-state)
                                      -1)})
                     state)

         :key/escape (do (ui/stop-propagation! event)
                         (pop-mode! {:type :dismiss})
                         state)

         :key/enter (do (ui/stop-propagation! event)
                        (activate-index! (merge state
                                                ui-state
                                                {:input-source :keyboard})
                                         ctx
                                         (:active-index ui-state)))

         :default (if-let [index (model/find-mnemonic-index (:options ui-state)
                                                         (model/event-mnemonic-char event))]
                    (do (ui/stop-propagation! event)
                        (activate-index! (merge state
                                                ui-state
                                                {:input-source :keyboard
                                                 :active-index index})
                                         ctx
                                         index))
                    state))))
   :on {:popup-menu/hover
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (set-navigation! ctx
                           {:input-source :mouse
                            :active-index (-> event :payload :index)})
          state)
        :option-item/click
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (let [ui-state (-> ctx :view :ui-state)]
            (activate-index! (merge state ui-state)
                             ctx
                             (-> event :payload :index))))}})
