(ns pixils.ui.menu
  "Deprecated compatibility facade.

   New code should require pixils.ui.menu-model, pixils.ui.menu-bar, or
   pixils.ui.popup-menu directly."
  (:require [pixils.ui.menu-bar :as menu-bar]
            [pixils.ui.menu-model :as menu-model]
            [pixils.ui.popup-menu :as popup-menu]))



;; Compatibility facade

(def default-menu-settings
  "Compatibility alias for the default menu normalization settings.

  Deprecated:
  Use `pixils.ui.menu-model/default-settings` instead."
  menu-model/default-settings)

(defun normalize-menu
  "Normalize a menu definition through the compatibility facade.

  Args:
  - `menu-definition`: Declarative menu tree and optional settings.
  - `keymap`: Action bindings used to resolve displayed shortcuts.

  Returns:
  A normalized menu root.

  Deprecated:
  Use `pixils.ui.menu-model/normalize` instead."
  [menu-definition keymap]
  (menu-model/normalize menu-definition keymap))

(defun make-menu
  "Build a menu-bar view specification through the compatibility facade.

  Args:
  - `options`: Constructor options or the legacy application-state map.
  - `menu-definition`: Declarative menu tree and optional settings.
  - `keymap`: Action bindings used to resolve displayed shortcuts.

  Returns:
  A `ui/menu-bar` view specification.

  Deprecated:
  Use `pixils.ui.menu-bar/make` instead."
  [options menu-definition keymap]
  (menu-bar/make options menu-definition keymap))

(defun open-context-menu!
  "Open a context-menu overlay through the compatibility facade.

  Args:
  - `menu-definition`: Declarative menu tree and optional settings.
  - `position`: Global popup origin with `:x` and `:y` coordinates.
  - `state`: Application and component inputs passed to the popup.
  - `ctx`: Hook context whose view receives the popup result.

  Returns:
  The result of opening the popup mode, or `nil` for an empty menu.

  Deprecated:
  Use `pixils.ui.popup-menu/open-context!` instead."
  [menu-definition position state ctx]
  (popup-menu/open-context! menu-definition position state ctx))
