(ns pixils.ui.dialog
  (:require pixils
            [pixils.ui :as ui]))

(def dialog-button-presets
  {:dialog/ok [:dialog/ok]
   :dialog/ok-cancel [:dialog/ok :dialog/cancel]
   :dialog/yes-no [:dialog/yes :dialog/no]
   :dialog/yes-no-cancel [:dialog/yes :dialog/no :dialog/cancel]})

(def dialog-button-labels
  {:dialog/ok "OK"
   :dialog/cancel "Cancel"
   :dialog/yes "Yes"
   :dialog/no "No"
   :dialog/dismiss "Dismiss"})

(def default-window-position {:x 220 :y 140})

(def default-dialog-body-style
  {:width 260
   :height :shrink
   :padding 10
   :layout {:direction :column
            :gap 10}})

(def default-dialog-button-row-style
  {:width :fill
   :height 24
   :layout {:direction :row
            :gap :space-between}})

(def default-dialog-button-style
  {:width 78
   :height 24})

(defcomponent ui/dialog-body
  {})

(defcomponent ui/dialog-button-row
  {})

(defun button-label [type]
  (or (get dialog-button-labels type)
      (str type)))

(defun normalize-button [button]
  (if (keyword? button)
    {:type button
     :label (button-label button)}
    (let [type (or (:type button)
                   (:id button)
                   :dialog/ok)]
      (merge {:type type
              :label (button-label type)}
             button))))

(defun normalize-buttons [buttons]
  (let [raw (or buttons :dialog/ok)
        entries (if (keyword? raw)
                  (or (get dialog-button-presets raw)
                      [raw])
                  raw)]
    (map entries normalize-button)))

(defun body-children [body]
  (cond
    (nil? body)
    []

    (or (:mode body)
        (:children body)
        (:style body))
    [body]

    :default
    body))

(defun dialog-result [state choice]
  {:choice choice
   :payload (:payload state)})

(defun stop-dialog-window-mouse-down [state event ctx]
  (do
    (ui/stop-propagation! event)
    state))

(defun make-dialog-button [button]
  (let [button (normalize-button button)
        type (:type button)]
    {:mode 'ui/button
     :style (merge default-dialog-button-style
                   (or (:style button) {}))
     :state (merge (or (:state button) {})
                   {:choice type
                    :label (:label button)})
     :on-click (fn [state event ctx]
                 (do
                   (ui/emit! (:view ctx)
                             :dialog/button
                             {:choice (:choice state)})
                   state))}))

(defun make-dialog-button-row [buttons style]
  {:mode 'ui/dialog-button-row
   :style (merge default-dialog-button-row-style
                 (or style {}))
   :children (map (normalize-buttons buttons)
                  make-dialog-button)})

(defun make-dialog-body [{:keys [body buttons body-style button-row-style state]}]
  {:mode 'ui/dialog-body
   :class :ui/content
   :style (merge default-dialog-body-style
                 (or body-style {}))
   :state (or state {})
   :children (concat (body-children body)
                     [(make-dialog-button-row buttons button-row-style)])})

(defun make-confirm [{:keys [title position state style] :as opts}]
  (merge
   (pixils.ui.window/make
    {:position (or position default-window-position)
     :title-bar {:title (or title "Confirm")}
     :style (or style {})
     :state (or state {})
     :body [(make-dialog-body opts)]})
   {:on-mouse-down stop-dialog-window-mouse-down}))

(defun dismiss-dialog! [state]
  (when (:dismissable state)
    (pop-mode! (dialog-result state :dialog/dismiss))))

(defmode ui/dialog-frame
  {:focusable true
   :style {:width :fill
           :height :fill}
   :init (fn [state ctx]
           (do
             (ui/focus! ctx)
             state))
   :on-key-down (fn [state event ctx]
                  (case (:key event)
                    :key/escape
                    (do
                      (ui/stop-propagation! event)
                      (dismiss-dialog! state)
                      state)

                    :default
                    state))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (dismiss-dialog! state)
                      state))
   :on {:dialog/button (fn [state event ctx]
                         (do
                           (ui/stop-propagation! event)
                           (pop-mode! (dialog-result state
                                                     (-> event :payload :choice)))
                           state))}
   :compose {:render :pass}})

(defun open-confirm! [ctx opts]
  (do
    (push-mode! 'ui/dialog-frame
                {:payload (:payload opts)
                 :dismissable (or (:dismissable opts) false)
                 :modal (if (nil? (:modal opts))
                          true
                          (:modal opts))}
                {:origin {:view (:view ctx)
                          :event (or (:result-event opts)
                                     :dialog/result)}
                 :children [(make-confirm opts)]})
    nil))
