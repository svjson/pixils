(ns pixils.ui.icon
  (:require pixils
            [pixils.ui :as ui]))



;; Generic icon behavior

(defun icon-item [state]
  (:item state))

(defun icon-position [state]
  (or (:position state)
      (:position (icon-item state))))

(defun icon-hidden? [state]
  (nil? (icon-item state)))

(defcomponent ui/icon
  {:focusable true
   :update (fn [state ctx]
             (do
               (ui/style! (:view ctx)
                          {:hidden (icon-hidden? state)})
               state))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/emit! (:view ctx)
                                :ui/icon-select
                                (icon-item state))
                      state))
   :on-click (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx)
                           :ui/icon-activate
                           (icon-item state))
                 state))})

(defcomponent ui/icon-preview
  {:style {:position :absolute
           :hit-test false}
   :update (fn [state ctx]
             (let [pos (icon-position state)]
               (do
                 (when pos
                   (ui/style! (:view ctx)
                              {:position :absolute
                               :left (:x pos)
                               :top (:y pos)}))
                 (ui/style! (:view ctx)
                            {:hidden (icon-hidden? state)})
                 state)))})
