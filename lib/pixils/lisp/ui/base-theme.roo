(ns pixils.ui.base-theme
  (:require pixils
            [pixils.render :as r]
            [pixils.ui.theme-assets :as theme-assets]))

(def theme-bundle :base-theme)
(def menu-option-checkmark :base-theme/menu-option-checkmark)
(def scrollbar-arrow-up :base-theme/scrollbar-arrow-up)
(def scrollbar-arrow-down :base-theme/scrollbar-arrow-down)
(def scrollbar-arrow-left :base-theme/scrollbar-arrow-left)
(def scrollbar-arrow-right :base-theme/scrollbar-arrow-right)
(def menu-option-checkmark-color {:r 0x00 :g 0x00 :b 0x00})
(def scrollbar-arrow-color {:r 0x00 :g 0x00 :b 0x00})

(defun draw-menu-option-checkmark! []
 (let [color menu-option-checkmark-color]
   (r/line! {:x 7 :y 0} {:x 7 :y 1} color)
   (r/line! {:x 6 :y 2} {:x 7 :y 2} color)
   (r/line! {:x 6 :y 3} {:x 6 :y 3} color)
   (r/line! {:x 5 :y 4} {:x 6 :y 4} color)
   (r/line! {:x 0 :y 5} {:x 1 :y 5} color)
   (r/line! {:x 5 :y 5} {:x 5 :y 5} color)
   (r/line! {:x 1 :y 6} {:x 2 :y 6} color)
   (r/line! {:x 4 :y 6} {:x 5 :y 6} color)
   (r/line! {:x 2 :y 7} {:x 2 :y 7} color)
   (r/line! {:x 4 :y 7} {:x 4 :y 7} color)
   (r/line! {:x 2 :y 8} {:x 4 :y 8} color)
   (r/line! {:x 3 :y 9} {:x 3 :y 9} color)))

(defun draw-outline-scrollbar-arrow-up-with-color! [color]
 (r/line! {:x 4 :y 0} {:x 4 :y 0} color)
 (r/line! {:x 3 :y 1} {:x 3 :y 1} color)
 (r/line! {:x 5 :y 1} {:x 5 :y 1} color)
 (r/line! {:x 2 :y 2} {:x 2 :y 2} color)
 (r/line! {:x 6 :y 2} {:x 6 :y 2} color)
 (r/line! {:x 1 :y 3} {:x 1 :y 3} color)
 (r/line! {:x 7 :y 3} {:x 7 :y 3} color)
 (r/line! {:x 0 :y 4} {:x 3 :y 4} color)
 (r/line! {:x 5 :y 4} {:x 8 :y 4} color)
 (r/line! {:x 3 :y 5} {:x 3 :y 7} color)
 (r/line! {:x 5 :y 5} {:x 5 :y 7} color)
 (r/line! {:x 3 :y 8} {:x 5 :y 8} color))

(defun draw-scrollbar-arrow-up! []
  (draw-outline-scrollbar-arrow-up-with-color! scrollbar-arrow-color))

(defun draw-scrollbar-arrow-down! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation 3.14159265}))

(defun draw-scrollbar-arrow-left! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation -1.57079633}))

(defun draw-scrollbar-arrow-right! []
  (r/image! scrollbar-arrow-up {:pos {:x 0 :y 0}
                                :rotation 1.57079633}))

(defun ensure-base-theme-assets! []
  (do
    (theme-assets/ensure-generated-image! theme-bundle
                                          menu-option-checkmark
                                          {:size {:w 8 :h 10}}
                                          draw-menu-option-checkmark!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-up
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-up!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-down
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-down!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-left
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-left!)
    (theme-assets/ensure-generated-image! theme-bundle
                                          scrollbar-arrow-right
                                          {:size {:w 9 :h 9}}
                                          draw-scrollbar-arrow-right!)))

(ensure-base-theme-assets!)

(def TEXT-INPUT-FRAME-STYLE
  {:width 80
   :min-height 22
   :background (var :field-bg)
   :border (var :inset-border-style)})

(def definition
  {:default-variant :base
   :vars {:base {:split-pane-resizer-size 6
                 :scrollbar-size 14
                 :surface {:r 0xff :g 0xff :b 0xff}
                 :panel-bg {:r 0xcc :g 0xcc :b 0xcc}
                 :field-bg {:r 0xff :g 0xff :b 0xff}
                 :highlight-color (var :selection-bg)
                 :button-bg (var :surface)
                 :button-hover-bg (var :selection-bg)
                 :button-pressed-bg (var :disabled-bg)
                 :button-disabled-bg (var :disabled-bg)
                 :text {:r 0x00 :g 0x00 :b 0x00}
                 :muted-text {:r 0x66 :g 0x66 :b 0x66}
                 :inactive-text {:r 0x88 :g 0x88 :b 0x88}
                 :border {:r 0x00 :g 0x00 :b 0x00}
                 :border-light (var :border)
                 :border-dark (var :border)
                 :border-inset-top-left (var :border-dark)
                 :border-inset-bottom-right (var :border-light)
                 :border-raised-top-left (var :border-light)
                 :border-raised-bottom-right (var :border-dark)
                 :inset-border-style {:color (var :border)
                                      :thickness 1
                                      :top {:color (var :border-inset-top-left)}
                                      :left {:color (var :border-inset-top-left)}
                                      :right {:color (var :border-inset-bottom-right)}
                                      :bottom {:color (var :border-inset-bottom-right)}}
                 :button-border-style (var :inset-border-style)
                 :button-hover-border-style (var :button-border-style)
                 :button-pressed-border-style (var :button-border-style)
                 :disabled-bg {:r 0xcc :g 0xcc :b 0xcc}
                 :disabled-text {:r 0x66 :g 0x66 :b 0x66}
                 :disabled-border {:r 0x66 :g 0x66 :b 0x66}
                 :disabled-border-light (var :disabled-border)
                 :disabled-border-dark (var :disabled-border)
                 :disabled-border-inset-top-left (var :disabled-border-dark)
                 :disabled-border-inset-bottom-right (var :disabled-border-light)
                 :disabled-inset-border-style {:color (var :disabled-border)
                                               :thickness 1
                                               :top {:color (var :disabled-border-inset-top-left)}
                                               :left {:color (var :disabled-border-inset-top-left)}
                                               :right {:color (var :disabled-border-inset-bottom-right)}
                                               :bottom {:color (var :disabled-border-inset-bottom-right)}}
                 :button-disabled-border-style (var :disabled-inset-border-style)
                 :selection-bg {:r 0x00 :g 0x00 :b 0x00}
                 :selection-text {:r 0xff :g 0xff :b 0xff}
                 :desktop-icon-label-padding 1
                 :list-box-item-padding {:t 3
                                         :r 5
                                         :b 3
                                         :l 5}
                 :option-box-indicator {:color {:r 0x00 :g 0x00 :b 0x00}
                                        :radius 5
                                        :inner-radius 2
                                        :pressed-thickness 2}
                 :slider {:thumb-shape :rect
                          :track-layout :full
                          :track-shape :rect
                          :track-thickness 3
                          :track-border? false
                          :limit-track-color (var :disabled-border)}
                 :menu-option-indicator {:selected-image :base-theme/menu-option-checkmark}
                 :menu-submenu-indicator {:text ">"}
                 :scrollbar-button-symbols {:up-image :base-theme/scrollbar-arrow-up
                                            :down-image :base-theme/scrollbar-arrow-down
                                            :left-image :base-theme/scrollbar-arrow-left
                                            :right-image :base-theme/scrollbar-arrow-right}}}
   :styles
   {:ui/app {:background (var :surface)
             :text {:color (var :text)}}

    :ui/panel {:background (var :panel-bg)
               :padding 4}

    :ui/title {:text {:color (var :text)}}

    :ui/muted {:text {:color (var :muted-text)}}

    :ui/disabled {:text {:color (var :disabled-text)}}

    :ui/accent {:text {:color (var :text)}}

    :ui/canvas {:background (var :field-bg)
                :border (var :inset-border-style)}

    :ui/content {:background (var :surface)
                 :border (var :inset-border-style)
                 :clip true}

    :ui/dialog-body {:width :fill
                     :min-width 260
                     :height :shrink
                     :padding 10
                     :layout {:direction :column
                              :gap 10}}

    :ui/dialog-button-row {:width :fill
                           :height 24
                           :layout {:direction :row
                                    :gap :space-between}}

    :ui/dialog-button {:width 78
                       :height 24}

    :ui/file-dialog-window {:width 420}

    :ui/file-dialog-body {:width :fill
                          :height :shrink
                          :padding 10
                          :layout {:direction :column
                                   :gap 8}}

    :ui/file-dialog-button-row {:width :fill
                                :height 24
                                :layout {:direction :row
                                         :gap :space-between}}

    'ui/tab-panel {:background {:r 0 :g 0 :b 0 :a 0}
                   :layout {:direction :column}}

    'ui/tab-strip {:background {:r 0 :g 0 :b 0 :a 0}
                   :layout {:direction :row}}

    'ui/tab {:padding [3 8]
             :background (var :panel-bg)
             :border (var :inset-border-style)
             :text {:color (var :text)}}

    '(ui/tab {:selected? true})
    {:background (var :surface)}

    'ui/tab:disabled
    {:background (var :disabled-bg)
     :text {:color (var :disabled-text)}}

    'ui/tab-panel-body {:width :fill
                        :height :fill
                        :background (var :surface)
                        :border (var :inset-border-style)}

    :ui/desktop-icon-label-box {:padding (var :desktop-icon-label-padding)
                                :text {:color (var :text)}}

    ['(:ui/desktop-icon {:selected true}) :ui/desktop-icon-label-box]
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    [:ui/desktop-icon:focus :ui/desktop-icon-label-box]
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    :ui/list-item {:padding (var :list-box-item-padding)
                   :text {:color (var :text)
                          :wrap :none}}

    :ui/list-item-hover:hover
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    [:ui/list-item-hover:hover 'ui/tree-view-disclosure]
    {:text {:color (var :selection-text)}}

    '(:ui/list-item {:selected true})
    {:background (var :selection-bg)
     :text {:color (var :selection-text)}}

    ['(:ui/list-item {:selected true}) 'ui/tree-view-disclosure]
    {:text {:color (var :selection-text)}}

    'ui/list-box {:background (var :field-bg)
                  :border (var :inset-border-style)}

    'ui/tree-view {:background (var :field-bg)
                   :border (var :inset-border-style)}

    'ui/tree-view-disclosure {:text {:color (var :text)}}

    'ui/combo-box {:background (var :field-bg)
                   :border (var :inset-border-style)}

    'ui/combo-box-trigger {:padding [3 5]
                           :layout {:direction :row
                                    :align-items :center
                                    :gap :space-between}}

    'ui/combo-box-button {:width 14
                          :max-width 14
                          :height :fill}

    'ui/combo-box-trigger:hover
    {:text {:color (var :selection-text)}
     :background (var :selection-bg)}

    'ui/combo-box-popup-panel {:background (var :field-bg)
                               :border (var :inset-border-style)}

    'ui/checkbox {:height 16
                  :layout {:direction :row
                           :align-items :center
                           :gap 4}
                  :text {:color (var :text)}}

    'ui/checkbox-box {:width 12
                      :max-width 12
                      :height 12
                      :max-height 12
                      :background (var :field-bg)
                      :border (var :inset-border-style)
                      :text {:color (var :text)}}

    '(ui/checkbox-box {:pressed true})
    {:background (var :disabled-bg)}

    'ui/option-box {:height 18
                    :text {:color (var :text)}}

    'ui/option-box-indicator {:width 12
                              :height 12}

    'ui/option-box:disabled
    {:text {:color (var :disabled-text)}}

    'ui/slider {:width :fill
                :height 18
                :max-height 18
                :background (var :field-bg)
                :border (var :inset-border-style)}

    'ui/progress-bar {:width 100
                      :height 12
                      :background (var :field-bg)
                      :border (var :inset-border-style)
                      :text {:color (var :highlight-color)}}

    :ui/split-pane-resizer {:border (var :inset-border-style)}

    '(:ui/split-pane-resizer {:axis :x})
    {:width (var :split-pane-resizer-size)
     :height :fill
     :cursor :resize-x}

    '(:ui/split-pane-resizer {:axis :y})
    {:width :fill
     :height (var :split-pane-resizer-size)
     :cursor :resize-y}

    'ui/scrollbar {:background (var :surface)
                   :text {:color (var :text)}}

    'ui/scrollbar-button {:background (var :surface)
                          :border (var :inset-border-style)
                          :text {:color (var :text)}}

    '(ui/scrollbar-button {:pressed true})
    {:background (var :disabled-bg)}

    'ui/scrollbar-button:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)
     :text {:color (var :disabled-text)}}

    'ui/scrollbar-track {:background (var :surface)}

    'ui/scrollbar-handle {:background (var :surface)
                          :border (var :inset-border-style)}

    '(ui/scrollbar-handle {:pressed true})
    {:background (var :disabled-bg)}

    'ui/scrollbar-corner {:background (var :surface)
                          :border (var :inset-border-style)}

    'ui/scroll-pane {:background (var :surface)}

    'ui/scroll-pane-viewport {:background (var :surface)}


    'ui/header-panel {:padding 0
                      :layout {:direction :column}}

    'ui/header-panel-header {:width :fill
                             :padding [2 4]
                             :layout {:direction :row}
                             :background (var :surface)
                             :border {:bottom {:color (var :border)
                                               :thickness 1}}}

    'ui/header-panel-body {:width :fill
                           :height :fill
                           :padding 4}

    'ui/group-box {:padding 0
                   :layout {:direction :column}
                   :text {:color (var :text)}}

    'ui/group-box-frame {:width :fill
                         :height :fill
                         :clip true
                         :margin {:t 6}
                         :padding {:t 9 :r 8 :b 8 :l 8}
                         :border (var :inset-border-style)}

    'ui/group-box-title {:position :absolute
                         :top 0
                         :left 8
                         :background (var :panel-bg)
                         :padding [0 3]
                         :text {:color (var :text)}}

    'ui/group-box-body {:width :fill
                        :height :fill}

    'ui/window {:border (var :inset-border-style)
                :text {:color (var :text)}}

    :window/chrome-none {:border {:thickness 0}}

    'ui/window-title-bar {:background (var :surface)
                          :text {:color (var :inactive-text)}
                          :border {:bottom {:color (var :border)
                                            :thickness 1}}
                          :width :fill
                          :height 19
                          :max-height 19
                          :padding 0
                          :layout {:direction :row
                                   :gap :space-between}}

    'ui/window-body {:width :fill}

    ['ui/window:focus-within 'ui/window-title-bar]
    {:text {:color (var :text)}}

    'ui/window-control-button {:hidden true
                               :width 18
                               :max-width 18
                               :height 18
                               :max-height 18}

    'ui/window-minimize-button {:hidden true
                                :width 18
                                :max-width 18
                                :height 18
                                :max-height 18}

    'ui/button-inner
    {:text {:color (var :text)}
     :background (var :button-bg)
     :layout {:direction :row
              :align-items :center}
     :border (var :button-border-style)}

    ['ui/button-inner 'ui/text]
    {:padding [3 6]
     :text {:wrap :none}}

    :ui/toolbar-button
    {:width 18
     :height 18}

    [:ui/toolbar-button 'ui/button-inner 'ui/text]
    {:padding [0 3]}

    'ui/button-inner:hover
    {:text {:color (var :selection-text)}
     :background (var :button-hover-bg)
     :layout {:direction :row
              :align-items :center}
     :border (var :button-hover-border-style)}

    '(ui/button-inner {:pressed true})
    {:background (var :button-pressed-bg)
     :border (var :button-pressed-border-style)}

    'ui/button-inner:disabled
    {:text {:color (var :disabled-text)}
     :background (var :button-disabled-bg)
     :border (var :button-disabled-border-style)}

    'ui/text-input TEXT-INPUT-FRAME-STYLE

    'ui/number-input TEXT-INPUT-FRAME-STYLE

    'ui/text-input-inner {:width :fill
                          :height :fill
                          :padding [0 4]
                          :layout {:direction :row
                                   :align-items :center}}

    'ui/text-input-inner:disabled
    {:text {:color (var :disabled-text)}
     :background (var :disabled-bg)}

    'ui/menu-bar {:background (var :surface)}

    'ui/popup-menu-item
    {:padding {:t 2 :r 12 :b 2 :l 2}}

    'ui/popup-menu-option-item
    {:padding {:t 2 :r 12 :b 2 :l 2}}

    :menu/shortcut-column
    {:margin {:l 16}}

    :menu/trailing-column
    {:margin {:l 16}}

    :menu/item
    {:text {:color (var :text)
            :marked-style {:enabled true
                           :marker "@"
                           :font-styles :underline}}}

    :menu/item:hover
    {:text {:color (var :selection-text)}
     :background (var :selection-bg)}

    :menu/item:disabled
    {:text {:color (var :disabled-text)
            :marked-style {:color (var :disabled-text)}}
     :background (var :surface)}

    :ui/list-item:disabled
    {:text {:color (var :disabled-text)}
     :background (var :surface)}

    'ui/combo-box-trigger:disabled
    {:text {:color (var :disabled-text)}
     :background (var :disabled-bg)}

    'ui/combo-box:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)}

    'ui/tree-view:disabled
    {:background (var :disabled-bg)
     :border (var :disabled-inset-border-style)}

    'ui/menu-option-item {:padding {:t 2 :r 12 :b 2 :l 2}}

    'ui/menu-option-indicator {:box-sizing :content-box
                               :width 12
                               :height 10}

    'ui/menu-submenu-indicator {:box-sizing :content-box
                                :width 8
                                :height 10}

    '(ui/menu-submenu-indicator {:has-submenu false})
    {:visibility :none}

    'ui/menu-separator
    {:height 1
     :max-height 1
     :margin {:t 3 :r 0 :b 2 :l 0}
     :border {:thickness 1
              :line-style :solid
              :color (var :border)
              :right {:thickness 0}
              :bottom {:thickness 0}
              :left {:thickness 0}}}

    'ui/popup-menu-inner
    {:text {:color (var :text)}
     :background (var :surface)
     :border (var :inset-border-style)}}})
