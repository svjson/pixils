(ns pixils.ui.scrollbar
  (:require pixils
            [pixils.image :as img]
            [pixils.rect :as rect]
            [pixils.render :as r]
            [pixils.ui :as ui]))



;; Internal support

(defun scrollbar-min-handle-size
  "Returns the minimum proportional handle size from the active theme. Fixed
  handle sizing wins when the theme defines it."
  [ctx]
  (or (ui/theme-var ctx :scrollbar-handle-size nil)
      (ui/theme-var ctx :scrollbar-min-handle-size nil)))

(defun scrollbar-constrained-button-size
  "Returns a scrollbar button size that leaves room for the minimum handle when
  the scrollbar is shorter than its normal button-track-button layout."
  [viewport cross ctx]
  (let [viewport (or viewport 0)
        cross (or cross 0)
        min-handle (or (scrollbar-min-handle-size ctx) 0)
        normal-required (+ (* 2 cross) min-handle)]
    (if (< viewport normal-required)
      (max 1 (clamp (int (/ (max 0 (- viewport min-handle)) 2)) 0 cross))
      cross)))

(defun scrollbar-proportional-handle-size
  "Returns the proportional handle length for a track, content size, and visible
  content span. The active theme controls the minimum handle length."
  [track content visible ctx]
  (let [track (or track 0)
        content (or content 0)
        visible (or visible 0)
        page (min visible content)]
    (if (<= content 0)
      track
      (max 1 (clamp (int (/ (* track page) content))
                    (min (or (scrollbar-min-handle-size ctx) 0) track)
                    track)))))

(defun scrollbar-geometry
  "Returns the current scrollbar geometry as axis values and local rects.

  The map contains:

  ```roo
  {:axis :y
   :axis-size 120
   :cross-size 14
   :max-value 80
   :start-button {:pos 0 :size 14 :rect {...}}
   :track {:pos 14 :size 92 :rect {...}}
   :handle {:pos 42 :offset 28 :size 32 :rect {...}}
   :end-button {:pos 106 :size 14 :rect {...}}}
  ```"
  [ctx]
  (let [ui-state (-> ctx :view :ui-state)
        axis (case (:axis ui-state)
               :x :x
               :default :y)
        theme-size (ui/theme-var ctx :scrollbar-size nil)
        axis-len (or (case axis
                       :x (-> ctx :view :bounds :w)
                       :default (-> ctx :view :bounds :h))
                     (case axis
                       :x (:available-width ctx)
                       :default (:available-height ctx))
                     theme-size
                     0)
        cross-len (or (case axis
                        :x (-> ctx :view :bounds :h)
                        :default (-> ctx :view :bounds :w))
                      (case axis
                        :x (:available-height ctx)
                        :default (:available-width ctx))
                      theme-size
                      0)
        button-size (scrollbar-constrained-button-size axis-len cross-len ctx)
        track-size (max 1 (- axis-len (* 2 button-size)))
        content-size (or (:content-size ui-state) 0)
        visible-size (or (:viewport-size ui-state) axis-len)
        max-value (max 0 (- content-size visible-size))
        rendered-handle-size (let [children (ui/children ctx)
                                   track (when (> (count children) 1)
                                           (nth children 1))
                                   track-children (or (when track
                                                        (ui/children track))
                                                      [])
                                   handle (head track-children)
                                   size (when handle
                                          (case axis
                                            :x (-> handle :bounds :w)
                                            :default (-> handle :bounds :h)))]
                               (when (> (or size 0) 0)
                                 size))
        fixed-handle-size (ui/theme-var ctx :scrollbar-handle-size nil)
        handle-size (or rendered-handle-size
                        (cond
                          fixed-handle-size
                          (clamp fixed-handle-size 1 track-size)

                          (> max-value 0)
                          (scrollbar-proportional-handle-size track-size
                                                               content-size
                                                               visible-size
                                                               ctx)

                          :default
                          track-size))
        span (max 1 (- track-size handle-size))
        value (clamp (or (:value ui-state) 0) 0 max-value)
        handle-offset (case max-value
                        0 0

                        :default (int (/ (* value span) max-value)))
        handle-pos (+ button-size handle-offset)
        end-pos (- axis-len button-size)]
    {:axis axis
     :axis-size axis-len
     :cross-size cross-len
     :max-value max-value
     :start-button {:pos 0
                    :size button-size
                    :rect (case axis
                            :x {:x 0 :y 0 :w button-size :h cross-len}
                            :default {:x 0 :y 0 :w cross-len :h button-size})}
     :track {:pos button-size
             :size track-size
             :rect (case axis
                     :x {:x button-size :y 0 :w track-size :h cross-len}
                     :default {:x 0 :y button-size :w cross-len :h track-size})}
     :handle {:pos handle-pos
              :offset handle-offset
              :size handle-size
              :rect (case axis
                      :x {:x handle-pos :y 0 :w handle-size :h cross-len}
                      :default {:x 0 :y handle-pos :w cross-len :h handle-size})}
     :end-button {:pos end-pos
                  :size button-size
                  :rect (case axis
                          :x {:x end-pos :y 0 :w button-size :h cross-len}
                          :default {:x 0 :y end-pos :w cross-len :h button-size})}}))

(defun scrollbar-value-at
  "Returns the scroll value for an axis coordinate and handle grab offset inside
  an existing scrollbar geometry map."
  [geometry coord grab-offset]
  (let [track (:track geometry)
        span (max 1 (- (:size track) (-> geometry :handle :size)))
        max-value (:max-value geometry)]
    (case max-value
      0 0

      :default
      (int (clamp (/ (* (- coord (:pos track) grab-offset) max-value) span)
                  0
                  max-value)))))

(defun scrollbar-step-value
  "Returns the scrollbar value after one button step in direction, clamped to
  the current scroll range."
  [state geometry direction]
  (clamp (+ (or (:value state) 0)
            (* direction (or (:step state) 1)))
         0
         (:max-value geometry)))

(defun scrollbar-content-size
  "Returns the scrollbar's default square size from the active theme."
  [state ctx]
  (let [size (ui/theme-var ctx :scrollbar-size nil)]
    {:w (or size 0)
     :h (or size 0)}))

(defun init-pressed-state
  "Returns initial :pressed UI state for scrollbar button-like parts. Authored
  :ui-state :pressed wins over ordinary :state :pressed."
  [ui-state state ctx]
  (assoc ui-state :pressed (get ui-state :pressed (:pressed state))))

(defun update-scrollbar-ui-state
  "Returns current scrollbar UI state and keeps its child layout direction in
  sync with the configured axis. A released pointer clears transient gesture
  state."
  [ui-state state ctx]
  (let [ui-state (merge (select-keys state
                                     [:axis
                                      :value
                                      :content-size
                                      :viewport-size
                                      :step
                                      :active-part
                                      :drag-kind
                                      :grab-offset])
                        ui-state)
        ui-state (cond-> ui-state
                   (and (:active-part ui-state)
                        (not (contains? (-> ctx :view :interaction :pressed) :left)))
                   (merge {:active-part nil
                           :drag-kind nil
                           :grab-offset nil}))
        direction (case (:axis ui-state)
                    :x :row
                    :default :column)]
    (when (not= (-> ctx :view :style :layout :direction) direction)
      (ui/style! ctx {:layout {:direction direction}}))
    ui-state))



;; Internal components

(defcomponent ui/scrollbar-button
  {:content-size (fn [state ctx]
                   (let [ui-state (-> ctx :view :ui-state)
                         axis (case (:axis ui-state)
                                :x :x
                                :default :y)
                         theme-size (ui/theme-var ctx :scrollbar-size nil)
                         cross (or (case axis
                                     :x (:available-height ctx)
                                     :default (:available-width ctx))
                                   (case axis
                                     :x (-> ctx :view :bounds :h)
                                     :default (-> ctx :view :bounds :w))
                                   theme-size
                                   0)
                         viewport (or (:viewport-size ui-state)
                                      (case axis
                                        :x (:available-width ctx)
                                        :default (:available-height ctx))
                                      (case axis
                                        :x (-> ctx :view :bounds :w)
                                        :default (-> ctx :view :bounds :h))
                                      cross
                                      0)
                         size (scrollbar-constrained-button-size viewport cross ctx)]
                     (case axis
                       :x {:w size :h cross}
                       :default {:w cross :h size})))
   :ui/state-keys [:axis :viewport-size :pressed]
   :init-ui init-pressed-state
   :update-ui (fn [ui-state state ctx]
                (assoc ui-state
                       :pressed
                       (and (not (:disabled? state))
                            (contains? (-> ctx :view :interaction :pressed) :left))))

   :render (fn [state ctx]
             (let [bounds {:x 0
                           :y 0
                           :w (-> ctx :view :bounds :w)
                           :h (-> ctx :view :bounds :h)}
                   border (-> ctx :view :effective-style :border)
                   left (or (-> border :left :thickness)
                            (:thickness border)
                            0)
                   top (or (-> border :top :thickness)
                           (:thickness border)
                           0)
                   right (or (-> border :right :thickness)
                             (:thickness border)
                             0)
                   bottom (or (-> border :bottom :thickness)
                              (:thickness border)
                              0)
                   symbol-rect {:x (+ (:x bounds) left)
                                :y (+ (:y bounds) top)
                                :w (max 0 (- (:w bounds) left right))
                                :h (max 0 (- (:h bounds) top bottom))}
                   symbols (ui/theme-var ctx :scrollbar-button-symbols nil)
                   image (case (-> ctx :view :ui-state :axis)
                           :x (case (:part state)
                                :start (:left-image symbols)
                                :default (:right-image symbols))
                           :default (case (:part state)
                                      :start (:up-image symbols)
                                      :default (:down-image symbols)))]
               (when image
                 (when-let [dim (img/size image)]
                   (r/image! image {:target (rect/align (rect/make-rect symbol-rect)
                                                        {:w (:w dim)
                                                         :h (:h dim)}
                                                        0.5
                                                        0.5)})))))})

(defcomponent ui/scrollbar-handle
  {:content-size (fn [state ctx]
                   (let [ui-state (-> ctx :view :ui-state)
                         axis (case (:axis ui-state)
                                :x :x
                                :default :y)
                         theme-size (ui/theme-var ctx :scrollbar-size nil)
                         track (or (case axis
                                     :x (:available-width ctx)
                                     :default (:available-height ctx))
                                   (case axis
                                     :x (-> ctx :view :bounds :w)
                                     :default (-> ctx :view :bounds :h))
                                   theme-size
                                   0)
                         cross (or (case axis
                                     :x (:available-height ctx)
                                     :default (:available-width ctx))
                                   (case axis
                                     :x (-> ctx :view :bounds :h)
                                     :default (-> ctx :view :bounds :w))
                                   theme-size
                                   0)
                         content (or (:content-size ui-state) 0)
                         viewport (or (:viewport-size ui-state)
                                      (+ track (* 2 cross)))
                         max-value (max 0 (- content viewport))
                         fixed (ui/theme-var ctx :scrollbar-handle-size nil)
                         handle (cond
                                  fixed
                                  (clamp fixed 1 (max 1 track))

                                  (> max-value 0)
                                  (scrollbar-proportional-handle-size track
                                                                       content
                                                                       viewport
                                                                       ctx)

                                  :default
                                  track)
                         border (-> ctx :view :effective-style :border)
                         left (or (-> border :left :thickness)
                                  (:thickness border)
                                  0)
                         top (or (-> border :top :thickness)
                                 (:thickness border)
                                 0)
                         right (or (-> border :right :thickness)
                                   (:thickness border)
                                   0)
                         bottom (or (-> border :bottom :thickness)
                                    (:thickness border)
                                    0)
                         handle-border (case axis
                                         :x (+ left right)
                                         :default (+ top bottom))
                         cross-border (case axis
                                        :x (+ top bottom)
                                        :default (+ left right))
                         handle-content (max 1 (- handle handle-border))
                         cross-content (max 1 (- cross cross-border))]
                     (case axis
                       :x {:w handle-content :h cross-content}
                       :default {:w cross-content :h handle-content})))
   :ui/state-keys [:axis :content-size :viewport-size :active-part :pressed]
   :init-ui init-pressed-state
   :update-ui (fn [ui-state state ctx]
                (assoc ui-state :pressed (= (:active-part ui-state) :handle)))})

(defcomponent ui/scrollbar-track
  {:ui/state-keys [:axis :content-size :viewport-size :active-part]
   :children [{:mode 'ui/scrollbar-handle
               :ui/state-policy :isolated
               :ui-state {:axis (ui/project-state :axis)
                          :content-size (ui/project-state :content-size)
                          :viewport-size (ui/project-state :viewport-size)
                          :active-part (ui/project-state :active-part)}}]})



;; Main component

(defcomponent ui/scrollbar
  {:focusable true
   :content-size scrollbar-content-size
   :ui/state-keys [:axis
                   :value
                   :content-size
                   :viewport-size
                   :step
                   :active-part
                   :drag-kind
                   :grab-offset]
   :after-layout-ui (fn [ui-state state ctx]
                      (let [geometry (scrollbar-geometry ctx)
                            children (ui/children ctx)
                            track (when (> (count children) 1)
                                    (nth children 1))
                            track-children (or (when track
                                                 (ui/children track))
                                               [])
                            handle (head track-children)
                            handle-offset (-> geometry :handle :offset)
                            style (case (:axis geometry)
                                    :x {:position :absolute
                                        :left handle-offset
                                        :top 0
                                        :height :fill}
                                    :default {:position :absolute
                                              :left 0
                                              :top handle-offset
                                              :width :fill})]
                        (when handle
                          (ui/style! handle style)))
                      ui-state)
   :init-ui update-scrollbar-ui-state
   :update-ui update-scrollbar-ui-state

   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    (let [geometry (scrollbar-geometry ctx)
                          coord (case (:axis geometry)
                                  :x (-> event :position :x)
                                  :default (-> event :position :y))]
                      (cond
                        (< coord (-> geometry :start-button :size))
                        (let [value (scrollbar-step-value (-> ctx :view :ui-state)
                                                           geometry
                                                           -1)]
                          (ui/set-ui-state! ctx
                                            (merge (-> ctx :view :ui-state)
                                                   {:active-part :start-button
                                                    :drag-kind :button
                                                    :grab-offset nil
                                                    :value value}))
                          state)

                        (>= coord (-> geometry :end-button :pos))
                        (let [value (scrollbar-step-value (-> ctx :view :ui-state)
                                                           geometry
                                                           1)]
                          (ui/set-ui-state! ctx
                                            (merge (-> ctx :view :ui-state)
                                                   {:active-part :end-button
                                                    :drag-kind :button
                                                    :grab-offset nil
                                                    :value value}))
                          state)

                        :default
                        (let [handle (:handle geometry)
                              handle-hit? (and (>= coord (:pos handle))
                                               (< coord (+ (:pos handle)
                                                           (:size handle))))
                              grab-offset (if handle-hit?
                                            (- coord (:pos handle))
                                            (/ (:size handle) 2))
                              value (if handle-hit?
                                      (-> ctx :view :ui-state :value)
                                      (scrollbar-value-at geometry
                                                          coord
                                                          grab-offset))]
                          (ui/set-ui-state! ctx
                                            (merge (-> ctx :view :ui-state)
                                                   {:active-part (if handle-hit?
                                                                   :handle
                                                                   :track)
                                                    :drag-kind :handle
                                                    :grab-offset grab-offset
                                                    :value value}))
                          state))))
   :on-mouse-up (fn [state event ctx]
                  (ui/stop-propagation! event)
                  (ui/set-ui-state! ctx
                                    (merge (-> ctx :view :ui-state)
                                           {:active-part nil
                                            :drag-kind nil
                                            :grab-offset nil}))
                  state)
   :on-drag-start (fn [state event ctx]
                    (case (-> ctx :view :ui-state :drag-kind)
                      :button state
                      :default (let [geometry (scrollbar-geometry ctx)
                                     coord (case (:axis geometry)
                                             :x (-> event :position :x)
                                             :default (-> event :position :y))
                                     grab-offset (or (-> ctx :view :ui-state :grab-offset)
                                                     (/ (-> geometry :handle :size) 2))
                                     value (scrollbar-value-at geometry
                                                               coord
                                                               grab-offset)]
                                 (ui/set-ui-state! ctx
                                                   (merge (-> ctx :view :ui-state)
                                                          {:value value}))
                                 state)))
   :on-drag (fn [state event ctx]
              (case (-> ctx :view :ui-state :drag-kind)
                :button state
                :default (let [geometry (scrollbar-geometry ctx)
                               coord (case (:axis geometry)
                                       :x (-> event :position :x)
                                       :default (-> event :position :y))
                               grab-offset (or (-> ctx :view :ui-state :grab-offset)
                                               (/ (-> geometry :handle :size) 2))
                               value (scrollbar-value-at geometry
                                                         coord
                                                         grab-offset)]
                           (ui/set-ui-state! ctx
                                             (merge (-> ctx :view :ui-state)
                                                    {:value value}))
                           state)))
   :on-drag-end (fn [state event ctx]
                  (ui/set-ui-state! ctx
                                    (merge (-> ctx :view :ui-state)
                                           {:active-part nil
                                            :drag-kind nil
                                            :grab-offset nil}))
                  state)
   :children [{:mode 'ui/scrollbar-button
               :ui/state-policy :isolated
               :ui-state {:axis (ui/project-state :axis)
                          :viewport-size (ui/project-state :viewport-size)}
               :state {:part :start}}
              {:mode 'ui/scrollbar-track
               :ui/state-policy :isolated
               :style {:width :fill
                       :height :fill}
               :ui-state {:axis (ui/project-state :axis)
                          :content-size (ui/project-state :content-size)
                          :viewport-size (ui/project-state :viewport-size)
                          :active-part (ui/project-state :active-part)}}
              {:mode 'ui/scrollbar-button
               :ui/state-policy :isolated
               :ui-state {:axis (ui/project-state :axis)
                          :viewport-size (ui/project-state :viewport-size)}
               :state {:part :end}}]})



;; Make functions

(defun make
  "Builds a ui/scrollbar child entry.

  Options:

  ```roo
  {:axis :y
   :value 0
   :content-size 400
   :viewport-size 100
   :step 12
   :class :panel/scrollbar
   :style {...}
   :state {...}
   :ui-state {...}
   :state-policy :shared}
  ```

  :axis, :value, :content-size, :viewport-size, and :step are placed under
  `:state :component`, which makes them component UI state inputs. A bound
  :value is synchronized back to the bound application state; projected values
  are read-only inputs. Ordinary :state entries remain available for caller
  application state. The default shared state policy keeps declared UI keys
  visible in ordinary state during migration."
  [{:keys [axis value content-size viewport-size step class style state ui-state
           state-policy init update on on-mouse-down on-mouse-up on-drag-start
           on-drag on-drag-end]}]
  (let [state (or state {})]
    (cond-> {:mode 'ui/scrollbar
             :style (or style {})
             :state (update state
                            :component
                            merge
                            {:axis axis
                             :value value
                             :content-size content-size
                             :viewport-size viewport-size
                             :step step})}
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state)
      state-policy (assoc :ui/state-policy state-policy)
      init (assoc :init init)
      update (assoc :update update)
      on (assoc :on on)
      on-mouse-down (assoc :on-mouse-down on-mouse-down)
      on-mouse-up (assoc :on-mouse-up on-mouse-up)
      on-drag-start (assoc :on-drag-start on-drag-start)
      on-drag (assoc :on-drag on-drag)
      on-drag-end (assoc :on-drag-end on-drag-end))))

(defcomponent ui/scrollbar-corner
  {:content-size scrollbar-content-size})
