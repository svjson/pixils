(ns pixils.ui.menu-bar-item
  "Handles top-level menu interaction and derives highlighted state."
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.menu-model :as model]))

(def UI-STATE-KEYS
  "Canonical UI-state inputs and intrinsic fields held by `ui/menu-bar-item`."
  [:node
   :menu-index
   :disabled?
   :active-index
   :highlighted])

(defun highlighted?
  "Determine whether a top-level menu item is highlighted.

  Args:
  - `ui-state`: Current menu-item UI state.
  - `hovered`: Whether native interaction state marks the item as hovered.

  Returns:
  `true` when pointer hover or the active menu index highlights the item."
  [ui-state hovered]
  (and (not (:disabled? ui-state))
       (if (nil? (:active-index ui-state))
         hovered
         (= (:menu-index ui-state)
            (:active-index ui-state)))))

(defun update-highlight
  "Update derived highlighting from menu and native interaction state.

  Args:
  - `ui-state`: Current menu-item UI state.
  - `state`: Ignored application state.
  - `ctx`: Menu-item update context.

  Returns:
  The original UI state when highlighting is unchanged, otherwise updated UI
  state."
  [ui-state _state ctx]
  (let [highlighted (highlighted?
                     ui-state
                     (-> ctx :view :interaction :hovered))]
    (if (= highlighted (:highlighted ui-state))
      ui-state
      (assoc ui-state :highlighted highlighted))))

(defcomponent ui/menu-bar-item
  {:class :menu/item
   :ui/state-keys UI-STATE-KEYS
   :update-ui update-highlight
   :on-mouse-down
   (fn [state event ctx]
     (let [ui-state (-> ctx :view :ui-state)
           node (:node ui-state)]
       (ui/stop-propagation! event)
       (cond
         (and node
              (not (:disabled? node))
              (model/submenu-node? node))
         (do
           (ui/emit! (:view ctx)
                     :menu/open
                     {:menu-index (:menu-index ui-state)})
           state)

         (and node
              (not (:disabled? node))
              (:action node))
         (do
           (ui/emit! (:view ctx) (:action node) (:payload node))
           state)

         :default
         state)))
   :on {:menu/select
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)]
            (cond
              (= :navigate-top (:type payload))
              (do
                (ui/stop-propagation! event)
                (ui/emit! (:view ctx)
                          :menu/navigate-top
                          {:direction (:direction payload)
                           :menu-index (:menu-index ui-state)})
                state)

              (and (= :action (:type payload))
                   (not (:disabled? ui-state)))
              (do
                (ui/emit! (:view ctx)
                          (:action payload)
                          (:payload payload))
                state)

              (= :dismiss (:type payload))
              (do
                (ui/stop-propagation! event)
                (ui/emit! (:view ctx)
                          :menu/dismiss
                          {:menu-index (:menu-index ui-state)
                           :global-position (:global-position payload)})
                state)

              :default
              state)))}})



;; Construction

(defun make
  "Build a top-level menu item view specification.

  Args:
  - `node`: Normalized menu item.
  - `index`: Item index within the menu bar.
  - `active-index`: Current active index or a parent-state projection.

  Returns:
  An isolated item with its stable label supplied directly to `ui/text`."
  [node index active-index]
  {:mode 'ui/menu-bar-item
   :style {:padding [2 8]}
   :ui/state-policy :isolated
   :ui-state {:node node
              :menu-index index
              :disabled? (:disabled? node)
              :active-index active-index}
   :children [{:mode 'ui/text
               :state {:value (:display-text node)}}]})
