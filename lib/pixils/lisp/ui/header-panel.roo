(ns pixils.ui.header-panel
  (:require pixils
            [pixils.ui :as ui]))

(defcomponent ui/header-panel
  {:class :ui/panel})

(defcomponent ui/header-panel-header
  {:children [{:mode 'ui/text
               :class :ui/title
               :style {:width :fill}
               :state {:value (ui/bind-state :title)}}]})

(defcomponent ui/header-panel-body
  {})

(defun header-title-child []
  {:mode 'ui/text
   :class :ui/title
   :style {:width :fill}
   :state {:value (ui/bind-state :title)}})

(defun header-children [title-child children]
  (concat [(or title-child (header-title-child))]
          (or children [])))

(defun make [{:keys [title init update on state class style header-style title-child header-children body-style body-state children]}]
  (let [panel-state (merge (or state {})
                           {:title title})]
    (merge {:mode 'ui/header-panel
            :style (or style {})
            :state panel-state
            :children [{:mode 'ui/header-panel-header
                        :style (or header-style {})
                        :state panel-state
                        :children (header-children title-child
                                                   header-children)}
                       {:mode 'ui/header-panel-body
                        :style (or body-style {})
                        :state (or body-state state {})
                        :children (or children [])}]}
           (if init {:init init} {})
           (if update {:update update} {})
           (if on {:on on} {})
           (if class {:class class} {}))))
