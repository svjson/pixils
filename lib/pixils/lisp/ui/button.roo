(ns pixils.ui.button
  (:require pixils
            [pixils.color :as c]
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.ui :as ui]))


;; Inner button

(defun button-border-side-thickness [ctx side]
  (let [border (-> ctx :view :effective-style :border)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun button-padding-side [ctx side]
  (or (get (-> ctx :view :effective-style :padding) side)
      0))

(defun button-content-origin-inset [ctx side]
  (+ (button-border-side-thickness ctx side)
     (button-padding-side ctx side)))

(defun button-pressed? [state ctx]
  (or (:pressed state)
      (-> ctx :view :state :pressed)))

(defun button-pressed-image-offset [state ctx]
  (if (button-pressed? state ctx)
    (ui/theme-var ctx :button-pressed-image-offset {:x 0 :y 0})
    {:x 0 :y 0}))

(defun button-image-key [image]
  (if (keyword? image)
    image
    (:image image)))

(defun button-image-source [image]
  (if (keyword? image)
    nil
    (or (:source image)
        (:src-rect image)
        (:src image))))

(defun button-image-offset [image]
  (if (keyword? image)
    {:x 0 :y 0}
    (or (:offset image) {:x 0 :y 0})))

(defun button-image-opacity [image]
  (if (keyword? image)
    nil
    (:opacity image)))

(defun button-style-image-opacity [ctx]
  (-> ctx :view :effective-style :image :opacity))

(defun button-style-image-scale [ctx]
  (or (-> ctx :view :effective-style :image :scale)
      1))

(defun button-image-scale [ctx image]
  (or (when (not (keyword? image))
        (:scale image))
      (button-style-image-scale ctx)
      1))

(defun button-image-pressed-offset [state ctx image]
  (if (and (not (keyword? image))
           (contains? (or image {}) :pressed-offset))
    (if (button-pressed? state ctx)
      (or (:pressed-offset image) {:x 0 :y 0})
      {:x 0 :y 0})
    (button-pressed-image-offset state ctx)))

(defun button-image-natural-dim [image]
  (let [source (button-image-source image)]
    (if (and source (:w source) (:h source))
      {:w (:w source)
       :h (:h source)}
      (img/size (button-image-key image)))))

(defun button-image-dim [ctx image]
  (let [dim (button-image-natural-dim image)
        scale (button-image-scale ctx image)]
    (if (and dim (:w dim) (:h dim))
      {:w (int (* (:w dim) scale))
       :h (int (* (:h dim) scale))}
      dim)))

(defun add-points [a b]
  {:x (+ (or (:x a) 0) (or (:x b) 0))
   :y (+ (or (:y a) 0) (or (:y b) 0))})

(defun button-image-position [state ctx image]
  (let [bounds (-> ctx :view :bounds)
        dim (button-image-dim ctx image)
        left (button-content-origin-inset ctx :left)
        top (button-content-origin-inset ctx :top)
        offset (add-points (button-image-offset image)
                           (button-image-pressed-offset state ctx image))]
    (if (and dim (:w dim) (:h dim))
      {:x (+ (- (int (/ (- (:w bounds) (:w dim)) 2)) left)
             (or (:x offset) 0))
       :y (+ (- (int (/ (- (:h bounds) (:h dim)) 2)) top)
             (or (:y offset) 0))}
      {:x 0
       :y 0})))

(defun button-image-render-opts [state ctx image]
  (let [source (button-image-source image)
        opacity (or (button-style-image-opacity ctx)
                    (button-image-opacity image))
        pos (button-image-position state ctx image)
        dim (button-image-dim ctx image)
        scale (button-image-scale ctx image)
        opts (if (and dim (not= scale 1))
               {:target {:x (:x pos)
                         :y (:y pos)
                         :w (:w dim)
                         :h (:h dim)}}
               {:pos pos})
        opts (if source
               (assoc opts :source source)
               opts)]
    (if opacity
      (assoc opts :opacity opacity)
      opts)))

(defcomponent ui/button-inner {:style {:width :fill
                                       :height :fill
                                       :clip true}
                               :children [{:mode 'ui/text
                                           :style {:width :fill
                                                   :text {:align :center}}
                                           :state {:value (ui/bind-state :label)}}]
                               :render (fn [state {:keys [view] :as ctx}]
                                         (when (button-image-key (:image state))
                                           (r/image! (button-image-key (:image state))
                                                     (button-image-render-opts
                                                      state
                                                      ctx
                                                      (:image state)))))})


;; Outer button component

(defun button-update [state {:keys [view] :as ctx}]
  "Update button state based on interaction state. The button is
  considered pressed if the left mouse button is currently pressed
  while hovering over the button, unless the :inhibit-pressed? flag is
  set in the state. The :force-pressed? flag can be used to force the
  button into a pressed state regardless of interaction."
  (assoc state :pressed
         (and (not (:disabled? state))
              (not (:inhibit-pressed? state))
              (or (:force-pressed? state)
                  (and (contains? (-> view :interaction :pressed) :left)
                       (-> view :interaction :hovered))))))

(defcomponent ui/button {:focusable true
                         :init (fn [state ctx]
                                 (update state :pressed (fn [pressed] pressed)))
                         :update button-update
                         :children [{:mode 'ui/button-inner
                                     :state {:pressed (ui/bind-state :pressed)
                                             :disabled? (ui/bind-state :disabled?)
                                             :image (ui/bind-state :image)
                                             :label (ui/bind-state :label)}}]})

(defun make [{:keys [label image disabled? value class style state init update on on-click]}]
  (merge {:mode 'ui/button
          :style (or style {})
          :state (merge (or state {})
                        {:label label
                         :image image
                         :disabled? disabled?
                         :value value})}
         (if class {:class class} {})
         (if init {:init init} {})
         (if update {:update update} {})
         (if on {:on on} {})
         (if on-click {:on-click on-click} {})))
