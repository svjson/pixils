(ns pixils.ui.button
  (:require pixils
            [pixils.color :as c]
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.ui :as ui]))



;; Internal geometry support

(defun button-content-origin-inset [ctx side]
  (+ (or (:thickness (-> ctx :view :effective-style :border (get side)))
         (:thickness (-> ctx :view :effective-style :border))
         0)
     (get (-> ctx :view :effective-style :padding) side 0)))

(defun button-interaction-pressed?
  "Returns the button's runtime interaction pressed value, respecting disabled,
  inhibit, and force flags from component state."
  [state ctx]
  (and (not (:disabled? state))
       (not (:inhibit-pressed? state))
       (or (:force-pressed? state)
           (and (contains? (-> ctx :view :interaction :pressed) :left)
                (-> ctx :view :interaction :hovered)))))

(defun button-pressed-image-offset [state ctx]
  (if (-> ctx :view :ui-state :pressed)
    (ui/theme-var ctx :button-pressed-image-offset {:x 0 :y 0})
    {:x 0 :y 0}))

(defun button-image-key [image]
  (if (keyword? image)
    image
    (:image image)))

(defun button-image-source
  "Returns the source rectangle for a button image map, accepting :source,
  :src-rect, and :src aliases. Keyword image references have no source rect."
  [image]
  (unless (keyword? image)
    (or (:source image)
        (:src-rect image)
        (:src image))))

(defun button-image-opacity
  "Returns the per-image opacity override from a button image map, or nil for a
  plain keyword image reference."
  [image]
  (unless (keyword? image)
    (:opacity image)))

(defun button-image-scale
  "Returns the rendered scale for a button image map, preferring an image-level
  :scale override, then effective button image style, then 1."
  [ctx image]
  (or (:scale image)
      (-> ctx :view :effective-style :image :scale)
      1))

(defun button-image-pressed-offset [state ctx image]
  (if (and (not (keyword? image))
           (contains? (or image {}) :pressed-offset))
    (if (-> ctx :view :ui-state :pressed)
      (or (:pressed-offset image) {:x 0 :y 0})
      {:x 0 :y 0})
    (button-pressed-image-offset state ctx)))

(defun button-image-natural-dim [image]
  (if-let [source (button-image-source image)
           w (:w source)
           h (:h source)]
    {:w w
     :h h}
    (img/size (button-image-key image))))

(defun button-image-dim [ctx image]
  (let [dim (button-image-natural-dim image)
        scale (button-image-scale ctx image)]
    (if (and dim (:w dim) (:h dim))
      {:w (int (* (:w dim) scale))
       :h (int (* (:h dim) scale))}
      dim)))

(defun add-points [a b]
  {:x (+ (or (:x a) 0) (or (:x b) 0))
   :y (+ (or (:y a) 0) (or (:y b) 0))})

(defun button-image-position [state ctx image]
  (let [bounds (-> ctx :view :bounds)
        dim (button-image-dim ctx image)
        left (button-content-origin-inset ctx :left)
        top (button-content-origin-inset ctx :top)
        offset (add-points (if (keyword? image)
                             {:x 0 :y 0}
                             (or (:offset image) {:x 0 :y 0}))
                           (button-image-pressed-offset state ctx image))]
    (if (and dim (:w dim) (:h dim))
      {:x (+ (- (int (/ (- (:w bounds) (:w dim)) 2)) left)
             (or (:x offset) 0))
       :y (+ (- (int (/ (- (:h bounds) (:h dim)) 2)) top)
             (or (:y offset) 0))}
      {:x 0
       :y 0})))

(defun button-image-render-opts [state ctx image]
  (let [source (button-image-source image)
        opacity (get-in ctx [:view :effective-style :image :opacity]
                        (button-image-opacity image))
        pos (button-image-position state ctx image)
        dim (button-image-dim ctx image)
        scale (button-image-scale ctx image)]
    (cond-> (if (and dim (not= scale 1))
              {:target {:x (:x pos)
                        :y (:y pos)
                        :w (:w dim)
                        :h (:h dim)}}
              {:pos pos})
      source (assoc :source source)
      opacity (assoc :opacity opacity))))



;; UI State hooks

(defun init-component-state
  "Returns initial button component state. Authored component :pressed wins over
  legacy ordinary :state :pressed when both are present."
  [ui-state state ctx]
  (assoc ui-state
         :pressed
         (if (contains? ui-state :pressed)
           (:pressed ui-state)
           (:pressed state))))

(defun update-component-state
  "Returns button UI state with :pressed derived from runtime interaction and
  component button flags."
  [ui-state state ctx]
  (assoc ui-state :pressed (button-interaction-pressed? state ctx)))



;; Inner button


(defcomponent ui/button-inner {:style {:width :fill
                                       :height :fill
                                       :clip true}
                               :ui/state-keys [:label
                                               :image
                                               :disabled?
                                               :force-pressed?
                                               :inhibit-pressed?
                                               :pressed]
                               :init-ui init-component-state
                               :update-ui update-component-state
                               :children [{:mode 'ui/text
                                           :style {:width :fill
                                                   :text {:align :center}}
                                           :state {:value (ui/project-state :label)}}]
                               :render (fn [state {:keys [view] :as ctx}]
                                         (when (button-image-key (:image state))
                                           (r/image! (button-image-key (:image state))
                                                     (button-image-render-opts
                                                      state
                                                      ctx
                                                      (:image state)))))})



;; Outer button component

(defcomponent ui/button {:focusable true
                         :ui/state-keys [:label
                                         :image
                                         :disabled?
                                         :value
                                         :force-pressed?
                                         :inhibit-pressed?
                                         :pressed]
                         :init-ui init-component-state
                         :update-ui update-component-state
                         :children [{:mode 'ui/button-inner
                                     :state {:component {:pressed (ui/project-state :pressed)
                                                         :disabled? (ui/project-state
                                                                     :disabled?)
                                                         :force-pressed? (ui/project-state
                                                                          :force-pressed?)
                                                         :inhibit-pressed? (ui/project-state
                                                                            :inhibit-pressed?)
                                                         :image (ui/project-state :image)
                                                         :label (ui/project-state :label)}}}]})



;; Make functions

(defun make
  "Builds a ui/button child entry from common button options. :state contains
  caller application state; button behavior values are written under
  `:state :component`.

  Options:

  ```roo
  {:label \"Run\"
   :image :icons/run
   :disabled? false
   :value :run
   :state {:clicks 0}
   :state-policy :shared}
  ```

  Static values, `ui/bind-state`, and `ui/project-state` are accepted for
  component entries. For example:

  ```roo
  (pixils.ui.button/make
    {:label \"Save\"
     :disabled? (ui/project-state :form-invalid?)
     :state {:clicks (ui/bind-state :save-clicks)}})
  ```

  During migration, component keys supplied directly in :state are also copied
  into :component, and the default shared state policy keeps declared component
  keys visible in ordinary state."
  [{:keys [label image disabled? value class style state ui-state state-policy
           init update on on-click]}]
  (cond-> {:mode 'ui/button
           :style (or style {})
           :state (assoc state
                         :component
                         (merge (select-keys state
                                             [:label
                                              :image
                                              :disabled?
                                              :value
                                              :force-pressed?
                                              :inhibit-pressed?
                                              :pressed])
                                (:component state)
                                {:label label
                                 :image image
                                 :disabled? disabled?
                                 :value value}))}
          class (assoc :class class)
          ui-state (assoc :ui-state ui-state)
          state-policy (assoc :ui/state-policy state-policy)
          init (assoc :init init)
          update (assoc :update update)
          on (assoc :on on)
          on-click (assoc :on-click on-click)))
