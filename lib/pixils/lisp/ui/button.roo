(ns pixils.ui.button
  (:require pixils
            [pixils.color :as c]
            [pixils.image :as img]
            [pixils.render :as r]
            [pixils.ui :as ui]))


;; Inner button

(defun button-border-side-thickness [ctx side]
  (let [border (-> ctx :view :effective-style :border)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun button-padding-side [ctx side]
  (or (get (-> ctx :view :effective-style :padding) side)
      0))

(defun button-content-origin-inset [ctx side]
  (+ (button-border-side-thickness ctx side)
     (button-padding-side ctx side)))

(defun button-image-position [state ctx image]
  (let [bounds (-> ctx :view :bounds)
        dim (img/size image)
        left (button-content-origin-inset ctx :left)
        top (button-content-origin-inset ctx :top)]
    (if (and dim (:w dim) (:h dim))
      {:x (- (int (/ (- (:w bounds) (:w dim)) 2)) left)
       :y (- (int (/ (- (:h bounds) (:h dim)) 2)) top)}
      {:x 0
       :y 0})))

(defcomponent ui/button-inner {:style {:width :fill
                                       :height :fill}
                               :children [{:mode 'ui/text
                                           :style {:width :fill
                                                   :text {:align :center}}
                                           :state {:value (ui/bind-state :label)}}]
                               :render (fn [state {:keys [view] :as ctx}]
                                         (when (keyword? (:image state))
                                           (r/image! (:image state)
                                                     {:pos (button-image-position
                                                            state
                                                            ctx
                                                            (:image state))})))})


;; Outer button component

(defun button-update [state {:keys [view] :as ctx}]
  "Update button state based on interaction state. The button is
  considered pressed if the left mouse button is currently pressed
  while hovering over the button, unless the :inhibit-pressed? flag is
  set in the state. The :force-pressed? flag can be used to force the
  button into a pressed state regardless of interaction."
  (assoc state :pressed
         (and (not (:disabled? state))
              (not (:inhibit-pressed? state))
              (or (:force-pressed? state)
                  (and (contains? (-> view :interaction :pressed) :left)
                       (-> view :interaction :hovered))))))

(defun button-content-size [state ctx]
  (if-let [label (:label state)]
    (let [text (str label)]
      {:w (+ (* (count text) 8) 14)
       :h 22})
    nil))

(defcomponent ui/button {:focusable true
                         :init (fn [state ctx]
                                 (update state :pressed (fn [pressed] pressed)))
                         :content-size button-content-size
                         :update button-update
                         :children [{:mode 'ui/button-inner
                                     :state {:pressed (ui/bind-state :pressed)
                                             :disabled? (ui/bind-state :disabled?)
                                             :image (ui/bind-state :image)
                                             :label (ui/bind-state :label)}}]})
