(ns pixils.ui.file-tree
  (:require pixils
            [roo.io :as io]
            [pixils.ui.tree-view :as tree-view]))

(def default-path (io/current-directory!))

(defun accessible-directory? [path]
  (and (not (nil? path))
       (not (empty? path))
       (io/directory? path)))

(defun safe-list-directory [path opts]
  (if (accessible-directory? path)
    (let [opts (or opts {})
          file-opts (if-let [filter (:filter opts)]
                      {:directories? false :filter filter}
                      {:directories? false})]
      (concat (if (= (:directories? opts) false)
                []
                (io/list-directory! path {:files? false}))
              (if (= (:files? opts) false)
                []
                (io/list-directory! path file-opts))))
    []))

(defun path-label [path fallback]
  (or fallback
      (let [name (io/basename path)]
        (if (empty? name)
          path
          name))
      path))

(defun path-node [path label]
  {:id path
   :path path
   :name (path-label path label)
   :label (path-label path label)
   :type (if (accessible-directory? path)
           :directory
           :file)})

(defun entry-node [parent entry]
  (let [path (or (:path entry)
                 (if (or (nil? (:name entry))
                         (empty? (:name entry)))
                   parent
                   (io/join-path parent (:name entry))))
        name (or (:name entry)
                 (path-label path nil))]
    (merge entry
           {:id path
            :path path
            :name name
            :label name})))

(defun file-system-adapter [opts]
  {:id (fn [node] (:path node))
   :value (fn [node] (:path node))
   :label (fn [node] (:label node))
   :expandable? (fn [node] (= (:type node) :directory))
   :children (fn [node]
               (map (safe-list-directory (:path node) (or opts {}))
                    (fn [entry]
                      (entry-node (:path node) entry))))})

(defun make [{:keys [roots adapter] :as opts}]
  (tree-view/make
   (merge opts
          {:roots (or roots
                      [(path-node (or (:path opts) default-path)
                                  (:root-label opts))])
           :adapter (or adapter
                        (file-system-adapter opts))})))
