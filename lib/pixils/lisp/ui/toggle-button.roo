(ns pixils.ui.toggle-button
  (:require pixils
            [pixils.ui :as ui]
            pixils.ui.button))


;; Toggle button

(defun toggled? [state]
  (= (:toggled? state) true))

(defun toggle-button-selection-required? [state]
  (or (= (:selection-required? state) true)
      (= (:force-selection? state) true)))

(defun toggle-button-update [state {:keys [view] :as ctx}]
  (let [active-press (and (contains? (-> view :interaction :pressed) :left)
                          (-> view :interaction :hovered))
        pressed (and (not (:disabled? state))
                     (not (:inhibit-pressed? state))
                     (or (:force-pressed? state)
                         (toggled? state)
                         active-press))]
    (assoc state :pressed pressed)))

(defcomponent ui/toggle-button
  {:extend 'ui/button
   :init (fn [state ctx]
           (assoc (update state :pressed (fn [pressed] pressed))
                  :toggled? (toggled? state)))
   :update toggle-button-update
   :on-click (fn [state event ctx]
               (let [next-toggled? (if (and (toggled? state)
                                            (toggle-button-selection-required? state))
                                      true
                                      (not (toggled? state)))]
                 (do
                   (ui/emit! (:view ctx)
                             :toggle-button/change
                             {:toggled? next-toggled?
                              :value (:value state)
                              :index (:index state)})
                   (assoc state :toggled? next-toggled?))))})


;; Toggle button group

(defun toggle-button-id [button index]
  (or (:id button)
      (:value button)
      index))

(defun toggle-button-label [button]
  (or (:label button)
      (:title button)
      (str (:value button))))

(defun toggle-button-disabled? [button]
  (= (:disabled? button) true))

(defun selectable-toggle-button? [button]
  (and (not (nil? button))
       (not (toggle-button-disabled? button))))

(defun first-selectable-toggle-button [buttons]
  (head (filter (or buttons []) selectable-toggle-button?)))

(defun toggle-button-by-value [buttons value]
  (head (filter (or buttons [])
                (fn [button]
                  (= (:value button) value)))))

(defun toggle-button-index-by-value [buttons value]
  (find-index (or buttons [])
              (fn [button]
                (= (:value button) value))))

(defun toggle-button-group-selection-required? [state]
  (or (= (:selection-required? state) true)
      (= (:force-selection? state) true)))

(defun toggle-button-group-selected-value [buttons selected selection-required?]
  (let [selected-button (toggle-button-by-value buttons selected)]
    (if (selectable-toggle-button? selected-button)
      selected
      (if selection-required?
        (:value (first-selectable-toggle-button buttons))
        nil))))

(defun toggle-button-group-child [index button selected selection-required?]
  {:mode 'ui/toggle-button
   :id (str "toggle-button-" (toggle-button-id button index))
   :class (:class button)
   :style (or (:style button) {})
   :state (merge (or (:state button) {})
                 {:index index
                  :value (:value button)
                  :label (toggle-button-label button)
                  :image (:image button)
                  :disabled? (toggle-button-disabled? button)
                  :toggled? (= (:value button) selected)
                  :selection-required? selection-required?})})

(defun toggle-button-group-buttons-child [buttons selected selection-required? style]
  {:mode 'ui/toggle-button-group-buttons
   :id "buttons"
   :style (or style {})
   :children (for-indexed [index button (or buttons [])]
               (toggle-button-group-child index
                                          button
                                          selected
                                          selection-required?))})

(defcomponent ui/toggle-button-group-buttons
  {})

(defcomponent ui/toggle-button-group
  {:init (fn [state ctx]
           (let [buttons (or (:buttons state) [])
                 selection-required? (toggle-button-group-selection-required? state)
                 selected (toggle-button-group-selected-value buttons
                                                              (:selected state)
                                                              selection-required?)]
             (assoc state :selected selected)))
   :update (fn [state ctx]
             (let [buttons (or (:buttons state) [])
                   selection-required? (toggle-button-group-selection-required? state)
                   selected (toggle-button-group-selected-value buttons
                                                                (:selected state)
                                                                selection-required?)]
               (do
                 (when (or (not= buttons (:rendered-buttons state))
                           (not= selected (:rendered-selected state)))
                   (ui/replace-child! (:view ctx)
                                      "buttons"
                                      (toggle-button-group-buttons-child
                                       buttons
                                       selected
                                       selection-required?
                                       (:button-row-style state))))
                 (assoc (assoc (assoc state
                                       :selected selected)
                                :rendered-selected selected)
                        :rendered-buttons buttons))))
   :on {:toggle-button/change (fn [state event ctx]
                                (let [payload (:payload event)
                                      buttons (or (:buttons state) [])
                                      selection-required? (toggle-button-group-selection-required? state)
                                      clicked (:value payload)
                                      toggled? (:toggled? payload)
                                      selected (cond
                                                 toggled? clicked
                                                 (= clicked (:selected state))
                                                 (if selection-required?
                                                   (:selected state)
                                                   nil)
                                                 :default
                                                 (:selected state))
                                      selected (toggle-button-group-selected-value
                                                buttons
                                                selected
                                                selection-required?)
                                      index (toggle-button-index-by-value buttons selected)]
                                  (do
                                    (ui/stop-propagation! event)
                                    (when (not= selected (:selected state))
                                      (ui/emit! (:view ctx)
                                                :toggle-button-group/change
                                                {:selected selected
                                                 :value selected
                                                 :index index}))
                                    (assoc state :selected selected))))}})

(defun make [{:keys [label value toggled? selection-required? force-selection? class style state]}]
  (merge {:mode 'ui/toggle-button
          :style (or style {})
          :state (merge (or state {})
                        {:label label
                         :value value
                         :toggled? toggled?
                         :selection-required? selection-required?
                         :force-selection? force-selection?})}
         (if class {:class class} {})))

(defun make-group [{:keys [buttons selected selection-required? force-selection? class style button-row-style state]}]
  (let [buttons (or buttons [])
        selected (or selected (:selected state))
        selection-required? (or selection-required?
                                force-selection?
                                (:selection-required? state)
                                (:force-selection? state))
        button-row-style (or button-row-style (:button-row-style state))]
    (merge {:mode 'ui/toggle-button-group
            :style (or style {})
            :state (merge (or state {})
                          {:buttons buttons
                           :selected selected
                           :selection-required? selection-required?
                           :button-row-style button-row-style})
            :children [(toggle-button-group-buttons-child buttons
                                                          selected
                                                          selection-required?
                                                          button-row-style)]}
           (if class {:class class} {}))))
