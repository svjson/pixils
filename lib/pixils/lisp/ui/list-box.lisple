(ns pixils.ui.list-box
  (:require pixils
            pixils.ui.scroll-pane
            [pixils.ui :as ui]))

(def default-row-height 20)
(def default-visible-rows 5)
(def default-reorder-drag-threshold 3)

(defun option-label [option]
  (or (:label option)
      (:name option)
      (str (:value option))))

(defun option-value [option]
  (let [value (:value option)]
    (if (nil? value)
      (:id option)
      value)))

(defun option-disabled? [option]
  (= (:disabled? option) true))

(defun option-at [options index]
  (nth options index))

(defun option-value-at [options index]
  (option-value (option-at options index)))

(defun selected-values-for [options indices]
  (map indices (fn [index]
                 (option-value-at options index))))

(defun first-enabled-index [options]
  (let [match (head (filter (for-indexed [index option (or options [])]
                              {:index index
                               :option option})
                            (fn [entry]
                              (not (option-disabled? (:option entry))))))]
    (when match
      (:index match))))

(defun add-index [indices index]
  (if (contains? indices index)
    indices
    (concat indices [index])))

(defun remove-index [indices index]
  (filter indices (fn [item]
                    (not= item index))))

(defun index-range-up [from to]
  (if (> from to)
    []
    (concat [from] (index-range-up (inc from) to))))

(defun index-range [from to]
  (index-range-up (min from to) (max from to)))

(defun add-indices [indices items]
  (reduce items indices (fn [out index]
                          (add-index out index))))

(defun held-shift? [ctx]
  (or (contains? (:held-keys ctx) :key/shift)
      (contains? (:held-keys ctx) :key/left-shift)
      (contains? (:held-keys ctx) :key/right-shift)))

(defun held-ctrl? [ctx]
  (or (contains? (:held-keys ctx) :key/ctrl)
      (contains? (:held-keys ctx) :key/left-ctrl)
      (contains? (:held-keys ctx) :key/right-ctrl)))

(defun forced-selection? [state]
  (= (:force-selection? state) true))

(defun multi-select? [state]
  (= (:multi-select? state) true))

(defun toggle-selected? [state]
  (= (:toggle-selected? state) true))

(defun reorderable? [state]
  (= (:reorderable? state) true))

(defun preserve-forced-selection [state indices previous]
  (if (and (forced-selection? state)
           (empty? indices))
    previous
    indices))

(defun single-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (and (contains? selected index)
             (toggle-selected? state))
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      [index])))

(defun ctrl-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (contains? selected index)
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      (add-index selected index))))

(defun shift-click-selection [state index ctrl?]
  (let [selected (or (:selected-indices state) [])
        anchor (or (:anchor-index state) index)
        range (index-range anchor index)]
    (if ctrl?
      (add-indices selected range)
      range)))

(defun list-box-click-selection [state payload]
  (let [index (:index payload)]
    (if (multi-select? state)
      (cond
        (:shift? payload)
        (shift-click-selection state index (:ctrl? payload))

        (:ctrl? payload)
        (ctrl-click-selection state index)

        :default
        (single-click-selection state index))
      (single-click-selection state index))))

(defun selection-changed? [previous selected]
  (not= (or previous []) (or selected [])))

(defun list-box-content-height [options row-height]
  (* (count options) row-height))

(defun list-box-visible-height [options row-height visible-rows max-height]
  (min (or max-height (* row-height visible-rows))
       (list-box-content-height options row-height)))

(defun list-box-preferred-height [state]
  (list-box-visible-height (:options state)
                           (or (:row-height state) default-row-height)
                           (or (:visible-rows state) default-visible-rows)
                           (:max-height state)))

(defun list-box-content-state [state]
  (merge (reduce (or (:item-state-keys state) [])
                 {}
                 (fn [out key]
                   (merge out {key (get state key)})))
         {:selected-indices (or (:selected-indices state) [])
          :active-index (:active-index state)}))

(defun list-box-content-size [state ctx]
  {:w (or (:content-width state) 160)
   :h (list-box-preferred-height state)})

(defun list-box-stretches-items? [style]
  (let [width (:width (or style {}))]
    (and (not (nil? width))
         (not= width :shrink)
         (not= width :auto))))

(defun list-box-scroll-content-size [state]
  (let [content-height (list-box-content-height (:options state)
                                                (or (:row-height state)
                                                    default-row-height))]
    (if (:stretch-items? state)
      {:h content-height}
      {:w (or (:content-width state) 160)
       :h content-height})))

(defun list-box-scroll-pane-child [state children]
  (let [row-height (or (:row-height state) default-row-height)
        content-size (list-box-scroll-content-size state)]
    (merge {:id "scroll-pane"}
           (pixils.ui.scroll-pane/make
            {:style {:width :fill
                     :height :fill}
             :content-size content-size
             :state {:offset (ui/bind-state :offset)
                     :content-state (ui/bind-state :content-state)}
             :scroll-x? false
             :scroll-y? :auto
             :step row-height
             :children children}))))

(defun valid-option-index? [options index]
  (and (not (nil? index))
       (>= index 0)
       (< index (count options))))

(defun list-box-reorder-drag-policy [threshold]
  {:start {:mode :threshold
           :distance (or threshold default-reorder-drag-threshold)}
   :payload (fn [state event ctx]
              {:kind :list-box/reorder-item
               :index (:reorder-index state)
               :value (:reorder-value state)
               :option (:reorder-option state)})})

(defun list-box-reorderable-child [child threshold]
  (let [child (assoc child
                     :drag
                     (merge (or (:drag child) {})
                            (list-box-reorder-drag-policy threshold)))]
    (if (contains? child :on-drag-start)
      child
      (assoc child
             :on-drag-start
             (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx)
                           :list-box/reorder-drag-start
                           {:index (:reorder-index state)
                            :value (:reorder-value state)
                            :option (:reorder-option state)
                            :start-global-position (:start-global-position event)})
                 state))))))

(defun list-box-drop-index [state event]
  (let [row-height (or (:row-height state) default-row-height)
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (-> event :position :y) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (max 0 (min (count (:options state)) raw))))

(defun list-box-reorder-target-index [from-index drop-index options]
  (let [target (if (> drop-index from-index)
                 (dec drop-index)
                 drop-index)]
    (max 0 (min (dec (count options)) target))))

(defun same-point? [a b]
  (and (= (:x a) (:x b))
       (= (:y a) (:y b))))

(defun list-box-reorder-drag-for-drop [state event]
  (let [payload (:payload event)]
    (if (= (:kind payload) :list-box/reorder-item)
      payload
      (let [drag (:reorder-drag state)]
        (if (and drag
                 (same-point? (:start-global-position drag)
                              (:start-global-position event)))
          drag
          nil)))))

(defun list-box-reorder-event-payload [state event drag]
  (let [from-index (:index drag)
        options (:options state)
        drop-index (list-box-drop-index state event)
        to-index (list-box-reorder-target-index from-index drop-index options)
        option (option-at options from-index)]
    {:from-index from-index
     :to-index to-index
     :drop-index drop-index
     :value (option-value option)
     :option option}))

(defcomponent ui/list-box-item
  {:class [:ui/list-item :ui/list-box-item]
   :style {:width :fill
           :height default-row-height
           :padding [3 5]
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-click (fn [state event ctx]
               (do
                 (when (not (:disabled? state))
                   (ui/emit! (:view ctx)
                             :list-box/item-click
                             {:index (:index state)
                              :value (:value state)
                              :shift? (held-shift? ctx)
                              :ctrl? (held-ctrl? ctx)}))
                 state))
   :on-double-click (fn [state event ctx]
                      (do
                        (when (not (:disabled? state))
                          (ui/emit! (:view ctx)
                                    :list-box/item-activate
                                    {:index (:index state)
                                     :value (:value state)
                                     :shift? (held-shift? ctx)
                                     :ctrl? (held-ctrl? ctx)}))
                        state))
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defcomponent ui/list-box
  {:focusable true
   :class :ui/list-box
   :content-size list-box-content-size
   :init (fn [state ctx]
           (let [selected (or (:selected-indices state)
                              (if (forced-selection? state)
                                (if-let [index (first-enabled-index (:options state))]
                                  [index]
                                  [])
                                []))]
             (assoc (assoc (assoc (assoc state
                                          :selected-indices selected)
                                   :anchor-index (or (:anchor-index state)
                                                     (head selected)))
                            :content-state
                            (list-box-content-state (assoc state
                                                          :selected-indices
                                                          selected)))
                    :scroll-y?
                    :auto)))
   :update (fn [state ctx]
             (assoc state
                    :content-state
                    (list-box-content-state state)))
   :on {:list-box/item-click (fn [state event ctx]
                              (if (:reorder-drag state)
                                (do
                                  (ui/stop-propagation! event)
                                  state)
                                (let [payload (:payload event)
                                      option (option-at (:options state) (:index payload))
                                      disabled? (or (:disabled? state)
                                                    (option-disabled? option))
                                      selected (if disabled?
                                                 (:selected-indices state)
                                                 (list-box-click-selection state payload))
                                      changed? (selection-changed?
                                                (:selected-indices state)
                                                selected)
                                      next-state (assoc (assoc state
                                                               :selected-indices selected)
                                                        :anchor-index (:index payload))
                                      values (selected-values-for (:options next-state)
                                                                  selected)]
                                  (do
                                    (ui/stop-propagation! event)
                                    (when (and (not disabled?) changed?)
                                      (ui/emit! (:view ctx)
                                                :list-box/change
                                                {:selected-indices selected
                                                 :selected-values values
                                                 :value (:value payload)}))
                                    (assoc next-state
                                           :selected-values values)))))
        :list-box/item-activate (fn [state event ctx]
                                  (let [payload (:payload event)
                                        option (option-at (:options state) (:index payload))
                                        disabled? (or (:disabled? state)
                                                      (option-disabled? option))
                                        selected (if disabled?
                                                   (:selected-indices state)
                                                   (list-box-click-selection state payload))
                                        values (selected-values-for (:options state)
                                                                    selected)]
                                    (do
                                      (ui/stop-propagation! event)
                                      (when (not disabled?)
                                        (ui/emit! (:view ctx)
                                                  :list-box/activate
                                                  (merge payload
                                                         {:selected-indices selected
                                                          :selected-values values})))
                                      state)))
        :list-box/reorder-drag-start (fn [state event ctx]
                                       (do
                                         (ui/stop-propagation! event)
                                         (assoc state
                                                :reorder-drag
                                                (:payload event))))}
   :on-drop (fn [state event ctx]
              (let [drag (list-box-reorder-drag-for-drop state event)
                    from-index (:index drag)]
                (if (and (reorderable? state)
                         drag
                         (valid-option-index? (:options state) from-index)
                         (not (option-disabled? (option-at (:options state)
                                                           from-index))))
                  (let [event-payload (list-box-reorder-event-payload state event drag)]
                    (do
                      (ui/stop-propagation! event)
                      (when (not= (:from-index event-payload)
                                  (:to-index event-payload))
                        (ui/emit! (:view ctx)
                                  :list-box/reorder
                                  event-payload))
                      (assoc state :reorder-drag nil)))
                  state)))})

(defun stretch-list-box-item [child]
  (assoc child
         :style
         (merge (or (:style child) {})
                {:width :fill})))

(defun make-item-child [item-child index option row-height hover-highlight? stretch-items? parent-disabled? reorderable? reorder-drag-threshold]
  (let [disabled? (or parent-disabled?
                      (option-disabled? option))]
    (let [child (if item-child
                  (item-child index option)
                  {:mode 'ui/list-box-item
                   :class (if hover-highlight?
                            :ui/list-item-hover
                            [])
                   :style {:height row-height}
                   :state {:index index
                           :value (option-value option)
                           :label (option-label option)
                           :disabled? disabled?
                           :selected-indices (ui/bind-state :selected-indices)}})]
      (let [child (assoc child
                         :state
                         (merge (or (:state child) {})
                                {:disabled? disabled?
                                 :reorderable? reorderable?
                                 :reorder-index index
                                 :reorder-value (option-value option)
                                 :reorder-option option}))
            child (if reorderable?
                    (list-box-reorderable-child child reorder-drag-threshold)
                    child)]
        (if stretch-items?
          (stretch-list-box-item child)
          child)))))

(defun make [{:keys [options style row-height visible-rows max-height content-width selected-indices multi-select? force-selection? toggle-selected? hover-highlight? item-child item-state-keys state disabled? reorderable? reorder-drag-threshold]}]
  (let [row-height (or row-height default-row-height)
        visible-rows (or visible-rows default-visible-rows)
        options (or options [])
        disabled? (or disabled? (:disabled? state))
        content-width (or content-width 160)
        content-height (list-box-content-height options row-height)
        height (list-box-visible-height options row-height visible-rows max-height)
        final-style (merge {:height height
                            :width :shrink}
                           (or style {}))
        stretch-items? (list-box-stretches-items? final-style)]
    {:mode 'ui/list-box
     :style final-style
     :state (merge (or state {})
                   {:options options
                    :item-state-keys item-state-keys
                    :row-height row-height
                    :visible-rows visible-rows
                    :max-height max-height
                    :content-width content-width
                    :stretch-items? stretch-items?
                    :disabled? disabled?
                    :reorderable? reorderable?
                    :reorder-drag-threshold reorder-drag-threshold
                    :item-children (for-indexed [index option options]
                                     (make-item-child item-child
                                                      index
                                                      option
                                                      row-height
                                                      hover-highlight?
                                                      stretch-items?
                                                      disabled?
                                                      reorderable?
                                                      reorder-drag-threshold))
                    :selected-indices selected-indices
                    :multi-select? multi-select?
                    :force-selection? force-selection?
                    :toggle-selected? toggle-selected?})
     :children [(list-box-scroll-pane-child {:row-height row-height
                                             :content-width content-width
                                             :options options
                                             :stretch-items? stretch-items?}
                                            (for-indexed [index option options]
                                              (make-item-child item-child
                                                               index
                                                               option
                                                               row-height
                                                               hover-highlight?
                                                               stretch-items?
                                                               disabled?
                                                               reorderable?
                                                               reorder-drag-threshold)))]}))
