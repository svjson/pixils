(ns pixils.ui.option-box-group
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.option-box :as option-box]))



;; Internal support functions

(defun selectable-option? [option]
  (and (some? option)
       (not (option-box/option-disabled? option))))

(defun option-by-value [options value]
  (find-first options
              (fn [option]
                (= (option-box/option-value option) value))))

(defun state-selection-required? [state]
  (not (or (= (:selection-required? state) false)
           (= (:force-selection? state) false))))

(defun selected-value [options selected required?]
  (let [selected-option (option-by-value options selected)]
    (if (selectable-option? selected-option)
      selected
      (when required?
        (option-box/option-value (find-first options selectable-option?))))))

(defun options-child [options selected required? style]
  {:mode 'ui/option-box-group-options
   :id "options"
   :style (or style {})
   :children (for-indexed [index option options]
               (assoc (option-box/make
                       {:index index
                        :value (option-box/option-value option)
                        :label (option-box/option-label option)
                        :disabled? (option-box/option-disabled? option)
                        :selected? (= (option-box/option-value option)
                                      selected)
                        :selection-required? required?
                        :class (:class option)
                        :style (or (:style option) {})
                        :state (:state option)
                        :ui-state (:ui-state option)
                        :state-policy (:state-policy option)})
                      :id
                      (str "option-box-" (or (:id option)
                                             (option-box/option-value option)
                                             index))))})



;; Inner components

(defcomponent ui/option-box-group-options
  {:style {:layout {:direction :column
                    :gap 2}}})



;; Main component

(defcomponent ui/option-box-group
  {:ui/state-keys [:options
                   :selected
                   :selection-required?
                   :force-selection?
                   :option-column-style
                   :rendered-selected
                   :rendered-options]
   :init-ui (fn [ui-state state ctx]
              (let [options (or (:options ui-state) [])
                    required? (state-selection-required? ui-state)
                    selected (selected-value options
                                             (:selected ui-state)
                                             required?)]
                (assoc ui-state
                       :selected selected
                       :rendered-selected selected
                       :rendered-options options)))
   :update-ui (fn [ui-state state ctx]
             (let [options (or (:options ui-state) [])
                 required? (state-selection-required? ui-state)
                 selected (selected-value options
                                          (:selected ui-state)
                                          required?)]
               (when (or (not= options (:rendered-options ui-state))
                         (not= selected (:rendered-selected ui-state)))
                 (ui/replace-child! (:view ctx)
                                    "options"
                                    (options-child options
                                                   selected
                                                   required?
                                                   (:option-column-style ui-state))))
               (assoc ui-state
                      :selected selected
                      :rendered-selected selected
                      :rendered-options options)))
   :on {:option-box/change (fn [state event ctx]
                             (let [ui-state (-> ctx :view :ui-state)
                                   payload (:payload event)
                                   options (or (:options ui-state) [])
                                   required? (state-selection-required? ui-state)
                                   clicked (:value payload)
                                   selected (cond
                                              (:selected? payload) clicked
                                              (= clicked (:selected ui-state))
                                              (when required?
                                                (:selected ui-state))
                                              :default
                                              (:selected ui-state))
                                   selected (selected-value options
                                                            selected
                                                            required?)
                                   index (find-index options
                                                     (fn [option]
                                                       (= (option-box/option-value option)
                                                          selected)))
                                   option (option-by-value options selected)]
                               (ui/stop-propagation! event)
                               (when (not= selected (:selected ui-state))
                                 (ui/set-ui-state! ctx
                                                   (assoc ui-state :selected selected))
                                 (ui/emit! (:view ctx)
                                           :option-box-group/change
                                           {:selected selected
                                            :value selected
                                            :index index
                                            :option option}))
                               (assoc state :selected selected)))}})



;; Make functions

(defun make
  "Builds a ui/option-box-group child entry.

  Options:

  ```roo
  {:options [{:label \"Tiles\" :value :tiles}
             {:label \"Terrain\" :value :terrain}]
   :selected :tiles
   :selection-required? true
   :force-selection? true
   :class :settings/options
   :style {...}
   :option-column-style {...}
   :state {...}}
  ```

  Stock group behavior values are written under `:state :component`. A bound
  :selected value is synchronized back to the bound application state when the
  group changes selection. Ordinary :state entries remain available for caller
  application state."
  [{:keys [options selected selection-required? force-selection? class style
           option-column-style state ui-state state-policy] :as opts}]
  (let [state (or state {})
        component (cond-> (merge (select-keys state
                                              [:options
                                               :selected
                                               :selection-required?
                                               :force-selection?
                                               :option-column-style])
                                 (or (:component state) {}))
                    (contains? opts :options) (assoc :options options)
                    (contains? opts :selected) (assoc :selected selected)
                    (contains? opts :selection-required?) (assoc :selection-required?
                                                                 selection-required?)
                    (contains? opts :force-selection?) (assoc :force-selection?
                                                              force-selection?)
                    (contains? opts :option-column-style) (assoc :option-column-style
                                                                 option-column-style))
        options (or (:options component) [])
        required? (state-selection-required? component)
        selected (selected-value options (:selected component) required?)
        option-column-style (:option-column-style component)
        component (assoc component
                         :selected selected
                         :selection-required? required?
                         :option-column-style option-column-style)]
    (cond-> {:mode 'ui/option-box-group
             :style (or style {})
             :state (assoc state :component component)
             :children [(options-child options
                                       selected
                                       required?
                                       option-column-style)]}
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state)
      state-policy (assoc :ui/state-policy state-policy))))
