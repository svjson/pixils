(ns pixils.ui.option-box-group
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.option-item :as option]
            [pixils.ui.option-box :as option-box]))



;; Internal support functions

(defun selectable-option? [option]
  (and (some? option)
       (not (:disabled? option))))

(defun option-by-value [options value]
  (find-first options
              (fn [option]
                (= (option/value option) value))))

(defun state-selection-required? [state]
  (not (or (= (:selection-required? state) false)
           (= (:force-selection? state) false))))

(defun selected-value [options selected required?]
  (if (selectable-option? (option-by-value options selected))
    selected
    (when required?
      (option/value (find-first options selectable-option?)))))

(defun options-child [options selected required? style]
  (cond-> {:mode 'ui/option-box-group-options
           :id "options"
           :children (for-indexed [index option options]
                       (assoc (option-box/make
                               (merge
                                (select-keys option
                                             [:class
                                              :style
                                              :state
                                              :ui-state
                                              :state-policy])
                                {:index index
                                 :value (option/value option)
                                 :label (option/label option)
                                 :disabled? (:disabled? option)
                                 :selected? (= (option/value option)
                                               selected)
                                 :selection-required? required?}))
                              :id
                              (str "option-box-" (or (:id option)
                                                     (option/value option)
                                                     index))))}
    style (assoc :style style)))



;; Inner components

(defcomponent ui/option-box-group-options {})



;; Main component

(def OPTION-BOX-GROUP-UI-STATE-KEYS
  [:options
   :selected
   :selection-required?
   :force-selection?
   :option-column-style
   :rendered-selected
   :rendered-options])

(defcomponent ui/option-box-group
  {:ui/state-keys OPTION-BOX-GROUP-UI-STATE-KEYS
   :init-ui (fn [ui-state state ctx]
              (let [options (or (:options ui-state) [])
                    required? (state-selection-required? ui-state)
                    selected (selected-value options
                                             (:selected ui-state)
                                             required?)]
                (assoc ui-state
                       :selected selected
                       :rendered-selected selected
                       :rendered-options options)))
   :update-ui (fn [ui-state state ctx]
             (let [options (or (:options ui-state) [])
                 required? (state-selection-required? ui-state)
                 selected (selected-value options
                                          (:selected ui-state)
                                          required?)]
               (when (or (not= options (:rendered-options ui-state))
                         (not= selected (:rendered-selected ui-state)))
                 (ui/replace-child! (:view ctx)
                                    "options"
                                    (options-child options
                                                   selected
                                                   required?
                                                   (:option-column-style ui-state))))
               (assoc ui-state
                      :selected selected
                      :rendered-selected selected
                      :rendered-options options)))
   :on {:option-box/change (fn [state event ctx]
                             (let [ui-state (-> ctx :view :ui-state)
                                   payload (:payload event)
                                   options (or (:options ui-state) [])
                                   required? (state-selection-required? ui-state)
                                   clicked (:value payload)
                                   selected (cond
                                              (:selected? payload) clicked
                                              (= clicked (:selected ui-state))
                                              (when required?
                                                (:selected ui-state))
                                              :default
                                              (:selected ui-state))
                                   selected (selected-value options
                                                            selected
                                                            required?)
                                   index (find-index options
                                                     (fn [option]
                                                       (= (option/value option)
                                                          selected)))
                                   option (option-by-value options selected)]
                               (ui/stop-propagation! event)
                               (when (not= selected (:selected ui-state))
                                 (ui/set-ui-state! ctx
                                                   (assoc ui-state :selected selected))
                                 (ui/emit! (:view ctx)
                                           :option-box-group/change
                                           {:selected selected
                                            :value selected
                                            :index index
                                            :option option}))
                               (assoc state :selected selected)))}})



;; Make functions

(defun make
  "Builds a ui/option-box-group child entry.

  Options:

  ```roo
  {:options [{:label \"Tiles\" :value :tiles}
             {:label \"Terrain\" :value :terrain}]
   :selected :tiles
   :selection-required? true
   :force-selection? true
   :class :settings/options
   :style {...}
   :option-column-style {...}
   :state {...}}
  ```

  Stock group behavior values are written under `:state :component`. A bound
  :selected value is synchronized back to the bound application state when the
  group changes selection. Ordinary :state entries remain available for caller
  application state."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [supplied-component
        (merge (select-keys state OPTION-BOX-GROUP-UI-STATE-KEYS)
               (:component state)
               (select-keys opts OPTION-BOX-GROUP-UI-STATE-KEYS))
        options (or (:options supplied-component) [])
        required? (state-selection-required? supplied-component)
        selected (selected-value options
                                 (:selected supplied-component)
                                 required?)
        component (merge supplied-component
                         {:options options
                          :selected selected
                          :selection-required? required?})]
    (cond-> {:mode 'ui/option-box-group
             :state (assoc state :component component)
             :children [(options-child options
                                       selected
                                       required?
                                       (:option-column-style component))]}
      (contains? opts :style) (assoc :style style)
      class (assoc :class class)
      ui-state (assoc :ui-state ui-state)
      state-policy (assoc :ui/state-policy state-policy))))
