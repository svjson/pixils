(ns pixils.ui.tab-panel
  (:require pixils
            [pixils.ui :as ui]))

(defun tab-id [tab]
  (or (:id tab)
      (:value tab)))

(defun tab-label [tab]
  (or (:label tab)
      (:title tab)
      (str (tab-id tab))))

(defun tab-disabled? [tab]
  (= (:disabled? tab) true))

(defun selectable-tab? [tab]
  (and (not (nil? tab))
       (not (tab-disabled? tab))))

(defun first-selectable-tab [tabs]
  (head (filter (or tabs []) selectable-tab?)))

(defun tab-by-id [tabs id]
  (head (filter (or tabs [])
                (fn [tab]
                  (= (tab-id tab) id)))))

(defun tab-render-signature [tab]
  {:id (tab-id tab)
   :label (tab-label tab)
   :disabled? (tab-disabled? tab)})

(defun tabs-render-signature [tabs]
  (map (or tabs []) tab-render-signature))

(defun tab-index-by-id [tabs id]
  (find-index (or tabs [])
              (fn [tab]
                (= (tab-id tab) id))))

(defun selected-tab-id [tabs selected-tab]
  (let [selected (tab-by-id tabs selected-tab)]
    (if (selectable-tab? selected)
      selected-tab
      (tab-id (first-selectable-tab tabs)))))

(defun selected-tab [tabs selected-tab]
  (tab-by-id tabs (selected-tab-id tabs selected-tab)))

(defun tab-body-child [tab]
  (or (:child tab)
      (:body tab)
      {:mode 'ui/tab-panel-empty}))

(defcomponent ui/tab-panel-empty
  {})

(defcomponent ui/tab
  {:class :ui/tab
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      (when (not (:disabled? state))
                        (ui/emit! (:view ctx)
                                  :tab-panel/select
                                  {:tab (:tab-id state)
                                   :index (:index state)}))
                      state))
   :on-mouse-up (fn [state event ctx]
                  (do
                    (ui/stop-propagation! event)
                    state))
   :children [{:mode 'ui/text
               :state {:value (ui/bind-state :label)}}]})

(defcomponent ui/tab-strip
  {:class :ui/tab-strip})

(defcomponent ui/tab-panel-body
  {:class :ui/tab-panel-body})

(defun tab-child [index tab selected-tab]
  {:mode 'ui/tab
   :state {:index index
           :tab-id (tab-id tab)
           :label (tab-label tab)
           :disabled? (tab-disabled? tab)
           :selected? (= (tab-id tab) selected-tab)}})

(defun tab-strip-child [tabs selected-tab]
  {:mode 'ui/tab-strip
   :id "tab-strip"
   :children (for-indexed [index tab (or tabs [])]
               (tab-child index tab selected-tab))})

(defun body-child [tabs selected-tab body-state]
  {:mode 'ui/tab-panel-body
   :id "body"
   :state (or body-state (ui/bind-state))
   :children [(tab-body-child (selected-tab tabs selected-tab))]})

(defun replacement-body-state []
  (ui/bind-state))

(defun rendered-body-state-marker [body-state]
  (if (nil? body-state)
    nil
    (merge {} body-state)))

(defcomponent ui/tab-panel
  {:class :ui/tab-panel
   :init (fn [state ctx]
           (let [tabs (or (:tabs state) [])
                 selected (selected-tab-id tabs (:selected-tab state))]
             (assoc (assoc (assoc (assoc state
                                          :selected-tab selected)
                                   :rendered-tab (or (:rendered-tab state)
                                                     selected))
                            :rendered-tabs-signature
                            (tabs-render-signature tabs))
                    :rendered-body-state
                    (rendered-body-state-marker state))))
   :update (fn [state ctx]
             (let [tabs (or (:tabs state) [])
                   tabs-signature (tabs-render-signature tabs)
                   selected (selected-tab-id tabs (:selected-tab state))
                   body-replaced? (not= selected (:rendered-tab state))]
               (do
                 (when body-replaced?
                   (ui/replace-child! (:view ctx)
                                      "tab-strip"
                                      (tab-strip-child tabs selected)))
                 (when body-replaced?
                   (ui/replace-child! (:view ctx)
                                      "body"
                                      (body-child tabs
                                                  selected
                                                  (replacement-body-state))))
                 (assoc (assoc (assoc state
                                       :selected-tab selected)
                                :rendered-tab selected)
                        :rendered-tabs tabs
                        :rendered-tabs-signature tabs-signature
                        :rendered-body-state (if body-replaced?
                                               (rendered-body-state-marker
                                                state)
                                               (:rendered-body-state state))))))
   :on {:tab-panel/select (fn [state event ctx]
                            (let [payload (:payload event)
                                  tabs (or (:tabs state) [])
                                  tab (:tab payload)
                                  selected (selected-tab-id tabs tab)
                                  index (tab-index-by-id tabs selected)]
                              (do
                                (ui/stop-propagation! event)
                                (when (not= selected (:selected-tab state))
                                  (ui/replace-child! (:view ctx)
                                                     "body"
                                                     (body-child tabs
                                                                 selected
                                                                 (replacement-body-state)))
                                  (ui/emit! (:view ctx)
                                            :tab-panel/change
                                            {:tab selected
                                             :index index}))
                                (assoc state :selected-tab selected))))}})

(defun make [{:keys [tabs selected-tab class state style]}]
  (let [tabs (or tabs [])
        selected (selected-tab-id tabs selected-tab)
        initial-selected (or selected-tab
                             (:selected-tab state)
                             selected)
        rendered-selected (selected-tab-id tabs initial-selected)]
    (merge {:mode 'ui/tab-panel
            :style (or style {})
            :state (merge (or state {})
                          {:tabs tabs
                           :selected-tab initial-selected
                           :rendered-tab rendered-selected})
            :children [(tab-strip-child tabs rendered-selected)
                       (body-child tabs rendered-selected state)]}
           (if class {:class class} {}))))
