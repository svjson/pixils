(ns pixils.ui.tab-panel
  (:require pixils
            [pixils.ui :as ui]))

(defun tab-id [tab]
  (or (:id tab)
      (:value tab)))

(defun tab-label [tab]
  (or (:label tab)
      (:title tab)
      (str (tab-id tab))))

(defun selectable-tab? [tab]
  (and (some? tab)
       (not (:disabled? tab))))

(defun first-selectable-tab [tabs]
  (find-first tabs selectable-tab?))

(defun tab-by-id [tabs id]
  (find-first tabs
              (fn [tab]
                (= (tab-id tab) id))))

(defun tab-render-signature [tab]
  {:id (tab-id tab)
   :label (tab-label tab)
   :disabled? (:disabled? tab)})

(defun tabs-render-signature [tabs]
  (map tabs tab-render-signature))

(defun tab-index-by-id [tabs id]
  (find-index tabs
              (fn [tab]
                (= (tab-id tab) id))))

(defun selected-tab-id [tabs requested-tab-id]
  (let [selected (tab-by-id tabs requested-tab-id)]
    (if (selectable-tab? selected)
      requested-tab-id
      (tab-id (first-selectable-tab tabs)))))

(defun selected-tab [tabs requested-tab-id]
  (tab-by-id tabs (selected-tab-id tabs requested-tab-id)))

(defun tab-body-child [tab]
  (or (:child tab)
      (:body tab)
      {:mode 'ui/tab-panel-empty}))

(defcomponent ui/tab-panel-empty
  {})

(defcomponent ui/tab
  {:class :ui/tab
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    (unless (:disabled? state)
                      (ui/emit! (:view ctx)
                                :tab-panel/select
                                {:tab (:tab-id state)
                                 :index (:index state)}))
                    state)
   :on-mouse-up (fn [state event ctx]
                  (ui/stop-propagation! event)
                  state)
   :children [{:mode 'ui/text
               :state {:value (ui/bind-state :label)}}]})

(defcomponent ui/tab-strip
  {:class :ui/tab-strip})

(defcomponent ui/tab-panel-body
  {:class :ui/tab-panel-body})

(defun tab-child [index tab selected-tab]
  {:mode 'ui/tab
   :state {:index index
           :tab-id (tab-id tab)
           :label (tab-label tab)
           :disabled? (:disabled? tab)
           :selected? (= (tab-id tab) selected-tab)}})

(defun tab-strip-child [tabs requested-tab-id]
  {:mode 'ui/tab-strip
   :id "tab-strip"
   :children (for-indexed [index tab (or tabs [])]
               (tab-child index tab requested-tab-id))})

(defun body-child [tabs requested-tab-id body-state]
  {:mode 'ui/tab-panel-body
   :id "body"
   :state (or body-state (ui/bind-state))
   :children [(tab-body-child (selected-tab tabs requested-tab-id))]})

(defun replacement-body-state [state]
  (if (nil? (:body-state (or state {})))
    (ui/bind-state)
    (ui/bind-state :body-state)))

(defun rendered-body-state-marker [body-state]
  (unless (nil? body-state)
    (merge {} body-state)))

(defcomponent ui/tab-panel
  {:class :ui/tab-panel
   :init (fn [state ctx]
           (let [tabs (or (:tabs state) [])
                 selected (selected-tab-id tabs (:selected-tab state))]
             (assoc (assoc (assoc (assoc state
                                          :selected-tab selected)
                                   :rendered-tab (or (:rendered-tab state)
                                                     selected))
                            :rendered-tabs-signature
                            (tabs-render-signature tabs))
                    :rendered-body-state
                    (rendered-body-state-marker state))))
   :update (fn [state ctx]
             (let [tabs (or (:tabs state) [])
                   tabs-signature (tabs-render-signature tabs)
                   selected (selected-tab-id tabs (:selected-tab state))
                   body-replaced? (not= selected (:rendered-tab state))]
               (when body-replaced?
                 (ui/replace-child! (:view ctx)
                                    "tab-strip"
                                    (tab-strip-child tabs selected)))
               (when body-replaced?
                 (ui/replace-child! (:view ctx)
                                    "body"
                                    (body-child tabs
                                                selected
                                                (replacement-body-state
                                                 state))))
               (assoc (assoc (assoc state
                                     :selected-tab selected)
                              :rendered-tab selected)
                      :rendered-tabs tabs
                      :rendered-tabs-signature tabs-signature
                      :rendered-body-state (if body-replaced?
                                             (rendered-body-state-marker state)
                                             (:rendered-body-state state)))))
   :on {:tab-panel/select (fn [state {:keys [payload] :as event} ctx]
                            (let [tabs (or (:tabs state) [])
                                  selected (selected-tab-id tabs (:tab payload))
                                  index (tab-index-by-id tabs selected)]
                              (ui/stop-propagation! event)
                              (when (not= selected (:selected-tab state))
                                (ui/replace-child! (:view ctx)
                                                   "body"
                                                   (body-child tabs
                                                               selected
                                                               (replacement-body-state
                                                                state)))
                                (ui/emit! (:view ctx)
                                          :tab-panel/change
                                          {:tab selected
                                           :index index}))
                              (assoc state :selected-tab selected)))}})

(defun make [{:keys [tabs selected-tab class state body-state style] :as opts}]
  (let [tabs (or tabs [])
        has-body-state? (and (contains? opts :body-state)
                             (some? body-state))
        selected (selected-tab-id tabs selected-tab)
        initial-selected (or selected-tab
                             (:selected-tab state)
                             selected)
        rendered-selected (selected-tab-id tabs initial-selected)
        state (cond-> (or state {})
                has-body-state? (assoc :body-state body-state))
        tab-body-state (if has-body-state?
                         (ui/bind-state :body-state)
                         state)]
    (cond-> {:mode 'ui/tab-panel
             :style (or style {})
             :state (merge (or state {})
                           {:tabs tabs
                            :selected-tab initial-selected
                            :rendered-tab rendered-selected})
             :children [(tab-strip-child tabs rendered-selected)
                        (body-child tabs
                                    rendered-selected
                                    tab-body-state)]}
      class (assoc :class class))))
