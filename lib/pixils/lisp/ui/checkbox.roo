(ns pixils.ui.checkbox
  (:require pixils
            [pixils.point :as pt]
            [pixils.rect :as rect]
            [pixils.render :as r]
            [pixils.ui :as ui]))



;; Internal support functions

(defun checkbox-mark-color
  "Returns the color used for the rendered checkbox mark. :mark-color in state
  wins, then resolved text color, then authored text color, then black."
  [state ctx]
  (or (:mark-color state)
      (-> ctx :view :effective-style :text :color)
      (-> ctx :view :style :text :color)
      {:r 0x00 :g 0x00 :b 0x00}))

(defun checkbox-image
  "Returns the themed checkbox box image for state. Pressed state prefers
  :pressed-image, checked state prefers :checked-image, and both fall back to
  :image."
  [state ctx]
  (let [theme (ui/theme-var ctx :checkbox-box {})]
    (cond
      (:pressed state)
      (or (:pressed-image theme)
          (:checked-image theme)
          (:image theme))

      (:checked? state)
      (or (:checked-image theme)
          (:image theme))

      :default
      (:image theme))))

(defun render-checkbox-image!
  "Renders a themed checkbox box image stretched to the current checkbox box
  bounds. Does nothing when image is nil."
  [image bounds]
  (when image
    (r/image! image
              {:target {:x 0
                        :y 0
                        :w (:w bounds)
                        :h (:h bounds)}})))

(defun checkbox-mark-rect
  "Returns the square drawing rect for the built-in checkbox mark inside bounds."
  [bounds]
  (let [w (max 4 (- (or (:w bounds) 0) 2))
        h (max 4 (- (or (:h bounds) 0) 2))
        size (min w h)]
    {:x (int (/ (- w size) 2))
     :y (int (/ (- h size) 2))
     :w size
     :h size}))

(defun render-checkbox-mark!
  "Renders one pass of the built-in checkbox mark through three points."
  [p1 p2 p3 color]
  (r/line! p1 p2 color)
  (r/line! p2 p3 color))

(defun checkbox-mark-passes
  "Returns two point triples for the built-in checkbox mark. The second pass is
  offset one pixel horizontally to give the mark a thicker stroke."
  [bounds]
  (let [mark (checkbox-mark-rect bounds)
        p1 (pt/int (rect/normalize-point mark 0.18 0.55))
        p2 (pt/int (rect/normalize-point mark 0.42 0.80))
        p3 (pt/int (rect/normalize-point mark 0.86 0.18))]
    [[p1 p2 p3]
     [(pt/translate p1 1 0)
      (pt/translate p2 1 0)
      (pt/translate p3 1 0)]]))



;; Inner components

(defcomponent ui/checkbox-box
  {:ui/state-keys [:checked? :mark-color :pressed]
   :render (fn [state ctx]
             (let [bounds (-> ctx :view :bounds)
                   image (checkbox-image state ctx)]
               (if image
                 (render-checkbox-image! image bounds)
                 (when (:checked? state)
                   (let [color (checkbox-mark-color state ctx)
                         passes (checkbox-mark-passes bounds)
                         pass1 (head passes)
                         pass2 (nth passes 1)]
                     (render-checkbox-mark! (head pass1)
                                            (nth pass1 1)
                                            (nth pass1 2)
                                            color)
                     (render-checkbox-mark! (head pass2)
                                            (nth pass2 1)
                                            (nth pass2 2)
                                            color))))))})

(defcomponent ui/checkbox-label
  {:children [{:mode 'ui/text
               :state {:value (ui/project-state :label)}}]})



;; Main component

(defcomponent ui/checkbox
  {:focusable true
   :class :ui/checkbox
   :ui/state-keys [:label
                   :checked?
                   :value
                   :disabled?
                   :mark-color
                   :pressed]
   :init-ui (fn [ui-state state ctx]
              (assoc ui-state
                     :pressed
                     (if (contains? ui-state :pressed)
                       (:pressed ui-state)
                       (:pressed state))))
   :update-ui (fn [ui-state state ctx]
                (assoc ui-state
                       :pressed
                       (and (not (get ui-state :disabled? (:disabled? state)))
                                              (contains? (-> ctx :view :interaction :pressed) :left)
                                              (-> ctx :view :interaction :hovered))))
   :on-click (fn [state event ctx]
               (let [ui-state (-> ctx :view :ui-state)
                     disabled? (get ui-state :disabled? (:disabled? state))
                     checked? (not (:checked? ui-state))]
                 (if disabled?
                   state
                   (do
                     (ui/set-ui-state! ctx
                                       (assoc ui-state :checked? checked?))
                     (ui/emit! (:view ctx)
                               :checkbox/change
                               {:checked? checked?
                                :value (get ui-state :value (:value state))})
                     (assoc state :checked? checked?)))))
   :children [{:mode 'ui/checkbox-box
               :state {:component {:checked? (ui/project-state :checked?)
                                    :mark-color (ui/project-state :mark-color)
                                    :pressed (ui/project-state :pressed)}}}
              {:mode 'ui/checkbox-label
               :state {:label (ui/project-state :label)}}]})



;; Make functions

(defun make
  "Builds a ui/checkbox child entry.

  Options:

  ```roo
  {:label \"Show grid\"
   :checked? true
   :value :show-grid
   :disabled? false
   :mark-color {:r 0 :g 0 :b 0}
   :class :settings/checkbox
   :style {...}
   :box-style {...}
   :label-style {...}
   :state {...}
   :ui-state {...}
   :state-policy :shared}
  ```

  Stock checkbox behavior values are written under `:state :component`. Static
  values, `ui/bind-state`, and `ui/project-state` are accepted for component
  entries. Ordinary :state entries remain available for caller application
  state. During migration, component keys supplied directly in :state are also
  copied into :component, and the default shared state policy keeps declared
  component keys visible in ordinary state."
  [{:keys [label checked? value disabled? mark-color class style box-style
           label-style state ui-state state-policy] :as opts}]
  (let [state (or state {})
        component (cond-> (merge (select-keys state
                                              [:label
                                               :checked?
                                               :value
                                               :disabled?
                                               :mark-color
                                               :pressed])
                                 (or (:component state) {}))
                          label (assoc :label label)
                          checked? (assoc :checked? checked?)
                          value (assoc :value value)
                          disabled? (assoc :disabled? disabled?)
                          mark-color (assoc :mark-color mark-color))]
    (cond-> {:mode 'ui/checkbox
             :style (or style {})
             :state (assoc state :component component)
             :children [{:mode 'ui/checkbox-box
                         :style (or box-style {})
                         :state {:component {:checked? (ui/project-state :checked?)
                                             :mark-color (ui/project-state :mark-color)
                                             :pressed (ui/project-state :pressed)}}}
                        {:mode 'ui/checkbox-label
                         :style (or label-style {})
                         :state {:label (ui/project-state :label)}}]}
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state)
            state-policy (assoc :ui/state-policy state-policy))))
