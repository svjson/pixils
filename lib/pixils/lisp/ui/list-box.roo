(ns pixils.ui.list-box
  (:require pixils
            [pixils.point :as pt]
            [pixils.ui :as ui]
            [pixils.ui.internal.option-navigation :as navigation]
            [pixils.ui.option-item :as option]
            [pixils.ui.option-list :as option-list]))



;; Interaction support

(defun reorder-visual-strategy [state]
  (or (:reorder-visual-strategy state)
      :placeholder))

(defun reorder-placeholder-strategy? [state]
  (let [strategy (reorder-visual-strategy state)]
    (or (= strategy :placeholder)
        (= strategy :move-with-hole))))

(defun preserve-forced-selection [state indices previous]
  (if (and (:force-selection? state)
           (empty? indices))
    previous
    indices))

(defun click-selection [{:keys [multi-select?
                                selected-indices
                                toggle-selected?] :as state}
                        {:keys [index shift? ctrl?]}]
  (let [selected? (contains? selected-indices index)]
    (cond
      (and multi-select? shift?)
      (let [anchor (or (:anchor-index state) index)]
        (range (min anchor index) (max anchor index)))

      (and ctrl? multi-select? (not selected?))
      (append selected-indices index)

      (and selected?
           (or toggle-selected? multi-select?))
      (preserve-forced-selection state
                                 (remove selected-indices (fn [n] (= n index)))
                                 selected-indices)

      :default
      [index])))

(defun navigation-base-index [state direction]
  (or (:anchor-index state)
      (head (or (:selected-indices state) []))
      (if (> direction 0)
        -1
        (count (:options state)))))

(defun keyboard-target-index [state key]
  (let [{:keys [options]} state]
    (case key
      :key/down
      (navigation/next-enabled-index-from
       options
       (navigation-base-index state 1)
       1)

      :key/up
      (navigation/next-enabled-index-from
       options
       (navigation-base-index state -1)
       -1)

      :key/home
      (navigation/first-enabled-index options)

      :key/end
      (navigation/last-enabled-index options)

      :default nil)))

(defun apply-keyboard-selection [{:keys [options selected-indices] :as state}
                                 index
                                 {:keys [view] :as ctx}]
  (cond
    (navigation/enabled-index? options index)
    (let [selected [index]
          next-state (assoc state
                            :selected-indices selected
                            :anchor-index index
                            :offset (option-list/scroll-offset-for-index
                                     next-state
                                     ctx
                                     index))]
      (when (not= selected-indices selected)
        (ui/emit! view :list-box/change {:selected-indices selected
                                         :selected-values (option-list/values-at-indices
                                                           (:options next-state) selected)
                                         :value (option/value (nth options index))}))
      next-state)

    true
    state))

(defun reorder-drag-policy [threshold]
  {:start {:mode :threshold
           :distance (or threshold 3)}
   :payload (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)]
                {:kind :list-box/reorder-item
                 :index (:reorder-index ui-state)
                 :value (:reorder-value ui-state)
                 :option (:reorder-option ui-state)}))})

(defun reorderable-child [child threshold]
  (assoc child
         :drag
         (merge (or (:drag child) {})
                (reorder-drag-policy threshold))))

(defun drop-index [state event]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state))
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (-> event :position :y) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (clamp raw 0 (count (:options state)))))

(defun drop-index-from-local-y [state local-y]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state))
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (or local-y 0) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (clamp raw 0 (count (:options state)))))

(defun reorder-target-index [from-index drop-index options]
  (clamp (cond-> drop-index
           (> drop-index from-index) dec)
         0
         (dec (count options))))

(defun reorder-drag-for-drop [state event]
  (let [{:keys [payload]} event]
    (case (:kind payload)
      :list-box/reorder-item
      payload

      :default
      (let [drag (:reorder-drag state)]
        (when (and drag
                   (pt/+ (:start-global-position drag)
                         (:start-global-position event)))
          drag)))))

(defun reorder-event-payload [state event drag]
  (let [from-index (:index drag)
        options (:options state)
        drop-index (drop-index state event)
        to-index (reorder-target-index from-index drop-index options)
        option (nth options from-index)]
    {:from-index from-index
     :to-index to-index
     :drop-index drop-index
     :value (option/value option)
     :option option}))

(defun flow-item-style [margin-top margin-bottom]
  {:position :flow
   :margin {:t margin-top
            :r 0
            :b margin-bottom
            :l 0}})

(defun absolute-item-style [row-height top]
  {:position :absolute
   :left 0
   :top top
   :width :fill
   :height row-height
   :margin {:t 0
            :r 0
            :b 0
            :l 0}})

(defun preview-target-index [state]
  (reorder-target-index (:index (:reorder-drag state))
                                 (drop-index-from-local-y
                                  state
                                  (-> state :reorder-drag :position :y))
                                 (:options state)))

(defun compact-item-index [index from-index]
  (cond-> index
    (> index from-index) dec))

(defun placeholder-before? [index from-index target-index]
  (and (not= index from-index)
       (= (compact-item-index index from-index)
          target-index)))

(defun placeholder-after? [index item-count from-index target-index]
  (and (not= index from-index)
       (= target-index (dec item-count))
       (= (compact-item-index index from-index)
          (- item-count 2))))

(defun reorder-item-style [state index]
  (let [drag (:reorder-drag state)
        from-index (:index drag)
        row-height (or (:computed-row-height state)
                       (:row-height state))
        target-index (preview-target-index state)
        local-y (-> state :reorder-drag :position :y)
        drag-top (+ (* from-index row-height)
                    (- (or local-y 0)
                       (or (:y (:start-position drag)) 0)))]
    (if (= index from-index)
      (absolute-item-style row-height drag-top)
      (flow-item-style (if (placeholder-before? index
                                                                   from-index
                                                                   target-index)
                                  row-height
                                  0)
                                (if (placeholder-after? index
                                                                 (count (:options state))
                                                                 from-index
                                                                 target-index)
                                  row-height
                                  0)))))

(defun apply-reorder-visuals-indexed! [state items index]
  (unless (empty? items)
    (ui/style! (head items)
               (if (and (:reorderable? state)
                        (:reorder-drag state)
                        (reorder-placeholder-strategy? state))
                 (reorder-item-style state index)
                 (flow-item-style 0 0)))
    (apply-reorder-visuals-indexed! state (tail items) (inc index))))

(defun apply-reorder-visuals! [state ctx]
  (let [content (option-list/content-view ctx)]
    (when content
      (apply-reorder-visuals-indexed! state
                                               (ui/children content)
                                               0))
    state))



;; Internal UI state management

(defun derive-selected-values
  "Updates a list-box UI state with values derived from its current selection."
  [state]
  (assoc state
         :selected-values
         (option-list/values-at-indices (:options state)
                                        (:selected-indices state))))



;; Components

(def LIST-BOX-UI-STATE-KEYS
  [:options
   :item-state-keys
   :row-height
   :explicit-row-height?
   :computed-row-height
   :auto-row-height?
   :visible-rows
   :computed-visible-rows
   :max-height
   :fixed-visible-rows?
   :content-width
   :computed-content-width
   :auto-content-width?
   :managed-height?
   :stretch-items?
   :disabled?
   :item-mode
   :decorate-item
   :render-state-keys
   :reorderable?
   :reorder-drag-threshold
   :reorder-visual-strategy
   :item-child
   :hover-highlight?
   :selected-indices
   :active-index
   :selected-values
   :multi-select?
   :force-selection?
   :toggle-selected?
   :anchor-index
   :content-state
   :offset
   :scroll-y?
   :rendered-render-key
   :reorder-drag
   :reorder-drag-ended?])


(defcomponent ui/list-box-item
  {:extend 'ui/option-item
   :class [:ui/list-item :ui/list-box-item]
   :ui/state-keys [:index
                   :value
                   :label
                   :disabled?
                   :selected
                   :selected-indices
                   :reorderable?
                   :reorder-index
                   :reorder-value
                   :reorder-option]
   :on-click (fn [state event ctx]
               (let [ui-state (-> ctx :view :ui-state)]
                 (unless (:disabled? ui-state)
                   (ui/emit! (:view ctx)
                             :list-box/item-click
                             (option/event-payload ui-state ctx))))
               state)
   :on-double-click (fn [state event ctx]
                      (let [ui-state (-> ctx :view :ui-state)]
                        (unless (:disabled? ui-state)
                          (ui/emit! (:view ctx)
                                    :list-box/item-activate
                                    (option/event-payload ui-state ctx))))
                      state)})

(defcomponent ui/list-box
  {:extend 'ui/option-list
   :focusable true
   :class :ui/list-box
   :ui/state-keys LIST-BOX-UI-STATE-KEYS
   :init-ui (fn [ui-state state ctx]
              (let [selected (or (when-let [sel-ind (:selected-indices ui-state)]
                                   (when (not-empty? sel-ind)
                                     sel-ind))
                                 (if (:force-selection? ui-state)
                                   (if-let [index (navigation/first-enabled-index
                                                   (:options ui-state))]
                                     [index]
                                     [])
                                   []))]
                (let [ui-state (derive-selected-values
                                (assoc ui-state
                                       :selected-indices selected
                                       :anchor-index (or (:anchor-index ui-state)
                                                         (head selected))
                                       :scroll-y? :auto))
                      ui-state (assoc ui-state
                                      :content-state
                                      (option-list/content-state ui-state state))]
                  (option-list/sync-rendered-options ui-state ctx))))
   :update-ui (fn [ui-state state ctx]
                (let [ui-state (derive-selected-values ui-state)]
                  (apply-reorder-visuals!
                   (option-list/sync-rendered-options
                    (assoc ui-state
                           :content-state
                           (option-list/content-state ui-state state))
                    ctx)
                   ctx)))
   :after-layout-ui (fn [ui-state state ctx]
                      (cond-> (apply-reorder-visuals!
                               (option-list/sync-rendered-options
                                (assoc ui-state
                                       :content-state
                                       (option-list/content-state ui-state state))
                                ctx)
                               ctx)
                        (:reorder-drag-ended? ui-state) (assoc :reorder-drag nil
                                                              :reorder-drag-ended?
                                                              false)))
   :on-key-down (fn [state event ctx]
                  (let [ui-state (-> ctx :view :ui-state)]
                    (if (:disabled? ui-state)
                      state
                      (if-let [index (keyboard-target-index ui-state (:key event))]
                        (do
                          (ui/stop-propagation! event)
                          (let [next-ui-state (apply-keyboard-selection ui-state index ctx)]
                            (ui/set-ui-state! ctx next-ui-state)
                            (assoc state
                                   :selected-indices (:selected-indices next-ui-state)
                                   :anchor-index (:anchor-index next-ui-state)
                                   :offset (:offset next-ui-state))))
                        state))))
   :on-drag-start (fn [state event ctx]
                    (case (-> event :payload :kind)
                      :list-box/reorder-item
                      (let [ui-state (-> ctx :view :ui-state)]
                        (ui/set-ui-state! ctx
                                          (assoc ui-state
                                                 :reorder-drag
                                                 (assoc (:payload event)
                                                        :position
                                                        (:position event)
                                                        :start-position
                                                        (:start-position event)
                                                        :start-global-position
                                                        (:start-global-position event))
                                                 :reorder-drag-ended?
                                                 false))
                        state)

                      :default state))
   :on-drag (fn [state event ctx]
              (case (-> event :payload :kind)
                :list-box/reorder-item
                (let [ui-state (-> ctx :view :ui-state)]
                  (ui/set-ui-state! ctx
                                    (assoc ui-state
                                           :reorder-drag
                                           (assoc (or (:reorder-drag ui-state)
                                                      (:payload event))
                                                  :position
                                                  (:position event))
                                           :reorder-drag-ended?
                                           false))
                  state)

                :default state))
   :on-drag-end (fn [state event ctx]
                  (ui/set-ui-state! ctx
                                    (assoc (-> ctx :view :ui-state)
                                           :reorder-drag-ended?
                                           true))
                  state)
   :on {:list-box/item-click (fn [state event ctx]
                               (let [ui-state (-> ctx :view :ui-state)]
                                 (if (:reorder-drag ui-state)
                                   (do
                                     (ui/stop-propagation! event)
                                     state)
                                   (let [payload (:payload event)
                                         option (nth (:options ui-state) (:index payload))
                                         disabled? (or (:disabled? ui-state)
                                                       (:disabled? option))
                                         selected (if disabled?
                                                    (:selected-indices ui-state)
                                                    (click-selection ui-state payload))
                                         next-ui-state (assoc ui-state
                                                              :selected-indices selected
                                                              :anchor-index (:index payload))
                                         values (option-list/values-at-indices
                                                 (:options ui-state)
                                                 selected)]
                                     (ui/stop-propagation! event)
                                     (ui/set-ui-state! ctx next-ui-state)
                                     (when (and (not disabled?)
                                                (not= (:selected-indices ui-state)
                                                      selected))
                                       (ui/emit! (:view ctx)
                                                 :list-box/change
                                                 {:selected-indices selected
                                                  :selected-values values
                                                  :value (:value payload)}))
                                     (assoc state
                                            :selected-indices selected
                                            :anchor-index (:index payload))))))
        :list-box/item-activate (fn [state event ctx]
                                  (let [ui-state (-> ctx :view :ui-state)
                                        payload (:payload event)
                                        option (nth (:options ui-state) (:index payload))
                                        disabled? (or (:disabled? ui-state)
                                                      (:disabled? option))
                                        selected (if disabled?
                                                   (:selected-indices ui-state)
                                                   (click-selection ui-state payload))
                                        values (option-list/values-at-indices
                                                (:options ui-state)
                                                selected)]
                                    (ui/stop-propagation! event)
                                    (unless disabled?
                                    (ui/emit! (:view ctx)
                                              :list-box/activate
                                              (merge payload
                                                     {:selected-indices selected
                                                      :selected-values values})))
                                    state))}
   :on-drop (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)
                    drag (reorder-drag-for-drop ui-state event)
                    from-index (:index drag)]
                (if (and (:reorderable? ui-state)
                         drag
                         (navigation/valid-index? (:options ui-state) from-index)
                         (not (:disabled? (nth (:options ui-state)
                                               from-index))))
                  (let [event-payload (reorder-event-payload ui-state event drag)]
                    (ui/stop-propagation! event)
                    (when (not= (:from-index event-payload)
                                (:to-index event-payload))
                      (ui/emit! (:view ctx)
                                :list-box/reorder
                                event-payload))
                    (ui/set-ui-state! ctx
                                      (assoc ui-state
                                             :reorder-drag nil
                                             :reorder-drag-ended? false))
                    (assoc state
                           :reorder-drag nil
                           :reorder-drag-ended? false))
                  state)))})



;; Make functions

(defun make
  "Builds a ui/list-box child entry.

  Options:

  ```roo
  {:options [{:value :a :label \"Alpha\"}]
   :selected-indices [0]
   :multi-select? false
   :force-selection? false
   :toggle-selected? false
   :row-height 20
   :visible-rows 5
   :max-height 120
   :content-width 100
   :hover-highlight? true
   :reorderable? false
   :class :settings/list
   :style {...}
   :state {...}
   :ui-state {...}
   :state-policy :shared}
  ```

  Stock list-box behavior values are written under `:state :component`.
  Static values, `ui/bind-state`, and `ui/project-state` are accepted for
  component entries. Ordinary :state entries remain available for caller
  application state. During migration, component keys supplied directly in
  :state are also copied into :component, and the default shared state policy
  keeps declared component keys visible in ordinary state."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [supplied-component (merge (select-keys state LIST-BOX-UI-STATE-KEYS)
                                   (:component state)
                                   (select-keys opts LIST-BOX-UI-STATE-KEYS))
        component (merge supplied-component
                         {:options (or (:options supplied-component) [])
                          :explicit-row-height? (some? (:row-height supplied-component))
                          :computed-row-height (:row-height supplied-component)
                          :auto-row-height? (nil? (:row-height supplied-component))
                          :computed-visible-rows (:visible-rows supplied-component)
                          :computed-content-width (or (:content-width supplied-component) 1)
                          :auto-content-width? (nil? (:content-width supplied-component))
                          :managed-height? (not (and style
                                                     (contains? style :height)))
                          :stretch-items? (option-list/stretches-items? style)
                          :item-mode 'ui/list-box-item
                          :decorate-item (fn [child state index item]
                                           (let [child (option-list/merge-item-state
                                                        child
                                                        {:reorderable? (:reorderable? state)
                                                         :reorder-index index
                                                         :reorder-value (option/value item)
                                                         :reorder-option item})]
                                             (cond-> child
                                               (:reorderable? state)
                                               (reorderable-child
                                                (:reorder-drag-threshold state)))))
                          :render-state-keys [:reorderable?
                                              :reorder-drag-threshold]})]
    (cond-> {:mode 'ui/list-box
             :state (assoc state :component component)
             :children [(option-list/scroll-pane-for-state component)]}
            (contains? opts :style) (assoc :style style)
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state)
            state-policy (assoc :ui/state-policy state-policy))))
