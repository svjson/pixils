(ns pixils.ui.list-box
  (:require pixils
            pixils.ui.scroll-pane
            [pixils.point :as pt]
            [pixils.render :as r]
            [pixils.ui :as ui]))



;; To be removed

(def default-row-height 20)
(def default-visible-rows 5)



;; Internal option management functions

(defun option-label [option]
  (or (:label option)
      (:name option)
      (str (:value option))))

(defun option-value [{:keys [value id]}]
  (or value id))

(defun option-disabled? [option]
  (= (:disabled? option) true))

(defun option-at [options index]
  (nth options index))



;; Internal selection management functions

(defun selected-values-for [options indices]
  (for [index indices]
    (-> options (option-at index) option-value)))

(defun resolved-selected-indices [indices]
  (unless (or (nil? indices)
              (= indices {}))
    indices))

(defun selected-index? [indices index]
  (let [indices (or (resolved-selected-indices indices) [])]
    (if (empty? indices)
      false
      (or (= (head indices) index)
          (selected-index? (tail indices) index)))))

(defun add-index [indices index]
  (if (contains? indices index)
    indices
    (append indices index)))

(defun first-enabled-index [options]
  (when-let [match (find-first (for-indexed [index option options]
                                 {:index index
                                  :option option})
                               (fn [entry]
                                 (not (option-disabled? (:option entry)))))]
    (:index match)))

(defun valid-option-index? [options index]
  (and (number? index)
       (>= index 0)
       (< index (count options))))

(defun enabled-option-index? [options index]
  (and (valid-option-index? options index)
       (not (option-disabled? (option-at options index)))))

(defun next-enabled-index-from [options index direction]
  (let [next-index (+ index direction)]
    (cond
      (or (< next-index 0)
          (>= next-index (count options)))
      nil

      (enabled-option-index? options next-index)
      next-index

      :default
      (next-enabled-index-from options next-index direction))))

(defun last-enabled-index [options]
  (next-enabled-index-from options (count options) -1))

(defun remove-index [indices index]
  (filter indices (fn [item]
                    (not= item index))))

(defun index-range-up [from to]
  (if (> from to)
    []
    (concat [from] (index-range-up (inc from) to))))

(defun index-range [from to]
  (index-range-up (min from to) (max from to)))

(defun add-indices [indices items]
  (reduce items indices (fn [out index]
                          (add-index out index))))


;; Interaction support

(defun held-shift? [ctx]
  (or (contains? (:held-keys ctx) :key/shift)
      (contains? (:held-keys ctx) :key/left-shift)
      (contains? (:held-keys ctx) :key/right-shift)))

(defun held-ctrl? [ctx]
  (or (contains? (:held-keys ctx) :key/ctrl)
      (contains? (:held-keys ctx) :key/left-ctrl)
      (contains? (:held-keys ctx) :key/right-ctrl)))

(defun forced-selection? [state]
  (= (:force-selection? state) true))

(defun multi-select? [state]
  (= (:multi-select? state) true))

(defun toggle-selected? [state]
  (= (:toggle-selected? state) true))

(defun reorderable? [state]
  (= (:reorderable? state) true))

(defun reorder-visual-strategy [state]
  (or (:reorder-visual-strategy state)
      :placeholder))

(defun reorder-placeholder-strategy? [state]
  (let [strategy (reorder-visual-strategy state)]
    (or (= strategy :placeholder)
        (= strategy :move-with-hole))))

(defun preserve-forced-selection [state indices previous]
  (if (and (forced-selection? state)
           (empty? indices))
    previous
    indices))

(defun single-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (and (contains? selected index)
             (toggle-selected? state))
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      [index])))

(defun ctrl-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (contains? selected index)
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      (add-index selected index))))

(defun shift-click-selection [state index ctrl?]
  (let [selected (or (:selected-indices state) [])
        anchor (or (:anchor-index state) index)
        range (index-range anchor index)]
    (if ctrl?
      (add-indices selected range)
      range)))

(defun list-box-click-selection [state {:keys [index shift? ctrl?]}]
  (if (multi-select? state)
    (cond
      shift?
      (shift-click-selection state index ctrl?)

      ctrl?
      (ctrl-click-selection state index)

      :default
      (single-click-selection state index))
    (single-click-selection state index)))

(defun selection-changed? [previous selected]
  (not= (or previous []) (or selected [])))



;; Render geometry support

(defun list-box-content-height [options row-height]
  (* (count options) row-height))

(defun list-box-visible-height [options row-height visible-rows max-height fixed-visible-rows?]
  (let [visible-height (* row-height visible-rows)
        target-height (if fixed-visible-rows?
                        visible-height
                        (min visible-height
                             (list-box-content-height options row-height)))]
    (min (or max-height target-height)
         target-height)))

(defun list-box-style [ctx]
  (or (-> ctx :view :effective-style)
      (-> ctx :view :style)))

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun list-box-item-padding [ctx]
  (ui/theme-var ctx :list-box-item-padding nil))

(defun list-box-item-padding-side [padding side]
  (case side
    :top (or (:top padding) (:t padding) 0)
    :right (or (:right padding) (:r padding) 0)
    :bottom (or (:bottom padding) (:b padding) 0)
    :left (or (:left padding) (:l padding) 0)
    :default 0))

(defun list-box-measured-row-height [ctx]
  (let [dim (r/text-size "M" (text-args (list-box-style ctx)))
        padding (list-box-item-padding ctx)]
    (max (ui/theme-var ctx :list-box-row-height nil)
         (+ (get dim :h 0)
            (list-box-item-padding-side padding :top)
            (list-box-item-padding-side padding :bottom)))))

(defun option-label-width [option text-opts]
  (or (:w (r/text-size (option-label option) text-opts)) 0))

(defun list-box-measured-content-width [state ctx]
  (let [text-opts (text-args (list-box-style ctx))
        padding (list-box-item-padding ctx)
        label-width (reduce (:options state)
                            0
                            (fn [out option]
                              (max out
                                   (option-label-width option text-opts))))]
    (max 1 (+ label-width
              (list-box-item-padding-side padding :left)
              (list-box-item-padding-side padding :right)))))

(defun list-box-row-height [state ctx]
  (or (:row-height state)
      (when ctx (list-box-measured-row-height ctx))
      (:computed-row-height state)
      default-row-height))

(defun list-box-content-width [state ctx]
  (or (:content-width state)
      (when ctx (list-box-measured-content-width state ctx))
      (:computed-content-width state)
      1))

(defun list-box-preferred-height [state ctx]
  (list-box-visible-height (:options state)
                           (list-box-row-height state ctx)
                           (or (:visible-rows state) default-visible-rows)
                           (:max-height state)
                           (:fixed-visible-rows? state)))

(defun list-box-content-state [ui-state state]
  (merge (reduce (:item-state-keys ui-state)
                 {}
                 (fn [out key]
                   (merge out {key (get state key)})))
         {:selected-indices (or (:selected-indices ui-state) [])
          :active-index (:active-index ui-state)}))

(defun list-box-content-size [state ctx]
  (let [state (get-in ctx [:view :ui-state] state)]
    {:w (list-box-content-width state ctx)
     :h (list-box-preferred-height state ctx)}))

(defun list-box-stretches-items? [{:keys [width]}]
  (and (some? width)
       (not= width :shrink)
       (not= width :auto)))

(defun list-box-scroll-content-size [state]
  (let [content-height (list-box-content-height (:options state)
                                                (or (:computed-row-height state)
                                                    (:row-height state)
                                                    default-row-height))]
    (if (:stretch-items? state)
      {:h content-height}
      {:w (list-box-content-width state nil)
       :h content-height})))

(defun list-box-scroll-pane-child [state children]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        content-size (list-box-scroll-content-size state)]
    (merge {:id "scroll-pane"}
           (pixils.ui.scroll-pane/make
            {:style {:width :fill
                     :height :fill}
             :content-size content-size
             :content-height-explicit? (:explicit-row-height? state)
             :state {:offset (ui/bind-state :offset)
                     :content-state (ui/bind-state :content-state)}
             :scroll-x? false
             :scroll-y? :auto
             :step row-height
             :children children}))))

(defun list-box-style-padding-side [style side]
  (get (:padding style) side 0))

(defun list-box-style-border-side-thickness [style side]
  (let [border (:border style)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun list-box-vertical-content-inset [ctx]
  (let [style (list-box-style ctx)]
    (+ (list-box-style-padding-side style :top)
       (list-box-style-padding-side style :bottom)
       (list-box-style-border-side-thickness style :top)
       (list-box-style-border-side-thickness style :bottom))))

(defun list-box-managed-height [state ctx]
  (let [content-height (list-box-preferred-height state ctx)]
    (case (-> (list-box-style ctx) :box-sizing)
      :content-box content-height
      :default
      (+ content-height (list-box-vertical-content-inset ctx)))))

(defun list-box-managed-style [state ctx]
  (if (:managed-height? state)
    {:height (list-box-managed-height state ctx)}
    {}))

(defun list-box-can-sync-managed-height? [ctx]
  (> (or (-> ctx :view :bounds :h) 0) 0))

(defun child-at [children index]
  (when (and (>= index 0)
             (< index (count children)))
    (nth children index)))

(defun list-box-content-view [ctx]
  (let [scroll-pane (child-at (ui/children ctx) 0)
        row (when scroll-pane
              (child-at (ui/children scroll-pane) 0))
        viewport (when row
                   (child-at (ui/children row) 0))]
    (when viewport
      (child-at (ui/children viewport) 0))))

(defun list-box-navigation-base-index [state direction]
  (or (:anchor-index state)
      (head (or (:selected-indices state) []))
      (if (> direction 0)
        -1
        (count (:options state)))))

(defun list-box-keyboard-target-index [state key]
  (let [{:keys [options]} state]
    (case key
      :key/down
      (next-enabled-index-from
       options
       (list-box-navigation-base-index state 1)
       1)

      :key/up
      (next-enabled-index-from
       options
       (list-box-navigation-base-index state -1)
       -1)

      :key/home
      (first-enabled-index options)

      :key/end
      (last-enabled-index options)

      :default nil)))

(defun list-box-visible-content-height [state ctx]
  (if-let [height (-> ctx :view :bounds :h)]
    (case (-> (list-box-style ctx) :box-sizing)
      :content-box height
      :default (max 0 (- height (list-box-vertical-content-inset ctx))))
    (or (list-box-preferred-height state ctx)
        0)))

(defun list-box-scroll-offset-for-index [state ctx index]
  (let [row-height (list-box-row-height state ctx)
        visible-height (list-box-visible-content-height state ctx)
        content-height (list-box-content-height (:options state) row-height)
        offset (or (:offset state) {:x 0 :y 0})
        offset-y (or (:y offset) 0)
        row-top (* index row-height)
        row-bottom (+ row-top row-height)
        visible-bottom (+ offset-y visible-height)
        max-offset (max 0 (- content-height visible-height))
        next-y (cond
                 (< row-top offset-y)
                 row-top

                 (> row-bottom visible-bottom)
                 (- row-bottom visible-height)

                 :default
                 offset-y)]
    (assoc offset :y (clamp next-y 0 max-offset))))

(defun list-box-change-payload [{:keys [option] :as state} selected index]
  {:selected-indices selected
   :selected-values (selected-values-for (:options state) selected)
   :value (-> options (option-at index) option-value)})

(defun list-box-apply-keyboard-selection [state index ctx]
  (if (enabled-option-index? (:options state) index)
    (let [selected [index]
          changed? (selection-changed? (:selected-indices state) selected)
          payload (list-box-change-payload state selected index)
          next-state (assoc (assoc (assoc state
                                          :selected-indices selected)
                                   :selected-values (:selected-values payload))
                            :anchor-index index)
          next-state (assoc next-state
                            :offset
                            (list-box-scroll-offset-for-index
                             next-state
                             ctx
                             index))]
      (when changed?
        (ui/emit! (:view ctx) :list-box/change payload))
      next-state)
    state))

(defun list-box-on-key-down [state event ctx]
  (let [ui-state (-> ctx :view :ui-state)]
    (if (:disabled? ui-state)
      state
      (if-let [index (list-box-keyboard-target-index ui-state (:key event))]
        (do
          (ui/stop-propagation! event)
          (let [next-ui-state (list-box-apply-keyboard-selection ui-state index ctx)]
            (ui/set-ui-state! ctx next-ui-state)
            (assoc state
                   :selected-indices (:selected-indices next-ui-state)
                   :selected-values (:selected-values next-ui-state)
                   :anchor-index (:anchor-index next-ui-state)
                   :offset (:offset next-ui-state))))
        state))))

(defun list-box-reorder-drag-policy [threshold]
  {:start {:mode :threshold
           :distance (or threshold 3)}
   :payload (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)]
                {:kind :list-box/reorder-item
                 :index (:reorder-index ui-state)
                 :value (:reorder-value ui-state)
                 :option (:reorder-option ui-state)}))})

(defun list-box-reorderable-child [child threshold]
  (assoc child
         :drag
         (merge (or (:drag child) {})
                (list-box-reorder-drag-policy threshold))))

(defun list-box-drop-index [state event]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (-> event :position :y) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (clamp raw 0 (count (:options state)))))

(defun list-box-drop-index-from-local-y [state local-y]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (or local-y 0) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (clamp raw 0 (count (:options state)))))

(defun list-box-reorder-target-index [from-index drop-index options]
  (clamp (cond-> drop-index
           (> drop-index from-index) dec)
         0
         (dec (count options))))

(defun list-box-reorder-drag-for-drop [state event]
  (let [{:keys [payload]} event]
    (case (:kind payload)
      :list-box/reorder-item
      payload

      :default
      (let [drag (:reorder-drag state)]
        (when (and drag
                   (pt/+ (:start-global-position drag)
                         (:start-global-position event)))
          drag)))))

(defun list-box-reorder-event-payload [state event drag]
  (let [from-index (:index drag)
        options (:options state)
        drop-index (list-box-drop-index state event)
        to-index (list-box-reorder-target-index from-index drop-index options)
        option (option-at options from-index)]
    {:from-index from-index
     :to-index to-index
     :drop-index drop-index
     :value (option-value option)
     :option option}))

(defun list-box-flow-item-style [margin-top margin-bottom]
  {:position :flow
   :margin {:t margin-top
            :r 0
            :b margin-bottom
            :l 0}})

(defun list-box-absolute-item-style [row-height top]
  {:position :absolute
   :left 0
   :top top
   :width :fill
   :height row-height
   :margin {:t 0
            :r 0
            :b 0
            :l 0}})

(defun list-box-preview-target-index [state]
  (list-box-reorder-target-index (:index (:reorder-drag state))
                                 (list-box-drop-index-from-local-y
                                  state
                                  (-> state :reorder-drag :position :y))
                                 (:options state)))

(defun list-box-compact-item-index [index from-index]
  (cond-> index
    (> index from-index) dec))

(defun list-box-placeholder-before? [index from-index target-index]
  (and (not= index from-index)
       (= (list-box-compact-item-index index from-index)
          target-index)))

(defun list-box-placeholder-after? [index item-count from-index target-index]
  (and (not= index from-index)
       (= target-index (dec item-count))
       (= (list-box-compact-item-index index from-index)
          (- item-count 2))))

(defun list-box-reorder-item-style [state index]
  (let [drag (:reorder-drag state)
        from-index (:index drag)
        row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        target-index (list-box-preview-target-index state)
        local-y (-> state :reorder-drag :position :y)
        drag-top (+ (* from-index row-height)
                    (- (or local-y 0)
                       (or (:y (:start-position drag)) 0)))]
    (if (= index from-index)
      (list-box-absolute-item-style row-height drag-top)
      (list-box-flow-item-style (if (list-box-placeholder-before? index
                                                                   from-index
                                                                   target-index)
                                  row-height
                                  0)
                                (if (list-box-placeholder-after? index
                                                                 (count (:options state))
                                                                 from-index
                                                                 target-index)
                                  row-height
                                  0)))))

(defun list-box-apply-reorder-visuals-indexed! [state items index]
  (unless (empty? items)
    (ui/style! (head items)
               (if (and (reorderable? state)
                        (:reorder-drag state)
                        (reorder-placeholder-strategy? state))
                 (list-box-reorder-item-style state index)
                 (list-box-flow-item-style 0 0)))
    (list-box-apply-reorder-visuals-indexed! state (tail items) (inc index))))

(defun list-box-apply-reorder-visuals! [state ctx]
  (let [content (list-box-content-view ctx)]
    (do
      (when content
        (list-box-apply-reorder-visuals-indexed! state
                                                 (ui/children content)
                                                 0))
      state)))

(defun stretch-list-box-item [child]
  (assoc child
         :style
         (merge (or (:style child) {})
                {:width :fill})))

(defun make-item-child [state item-child index option row-height selected-indices hover-highlight? stretch-items? parent-disabled? reorderable? reorder-drag-threshold]
  (let [disabled? (or parent-disabled?
                      (option-disabled? option))]
    (let [child (if item-child
                  (item-child index option)
                  {:mode 'ui/list-box-item
                   :class (if hover-highlight?
                            :ui/list-item-hover
                            [])
                   :style {:height row-height}
                   :state {:component {:index index
                                        :value (option-value option)
                                        :label (option-label option)
                                        :disabled? disabled?
                                        :selected (selected-index? selected-indices index)
                                        :selected-indices (ui/bind-state :selected-indices)}}})]
      (let [item-state {:disabled? disabled?
                        :selected (selected-index? selected-indices index)
                        :reorderable? reorderable?
                        :reorder-index index
                        :reorder-value (option-value option)
                        :reorder-option option}
            child (if (-> child :state :component)
                    (update child :state
                            (fn [state]
                              (update state :component
                                      (fn [component]
                                        (merge component item-state)))))
                    (assoc child
                           :state
                           (merge (or (:state child) {})
                                  item-state)))
            child (cond-> child
                    reorderable? (list-box-reorderable-child reorder-drag-threshold))]
        (cond-> child
          stretch-items? stretch-list-box-item)))))

(defun list-box-item-children [state]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        options (or (:options state) [])]
    (for-indexed [index option options]
      (make-item-child state
                       (:item-child state)
                       index
                       option
                       row-height
                       (or (:selected-indices state) [])
                       (:hover-highlight? state)
                       (:stretch-items? state)
                       (:disabled? state)
                       (:reorderable? state)
                       (:reorder-drag-threshold state)))))

(defun list-box-render-key [state]
  (select-keys state
               [:options
                :row-height
                :computed-row-height
                :content-width
                :computed-content-width
                :stretch-items?
                :disabled?
                :reorderable?
                :reorder-drag-threshold
                :hover-highlight?]))

(defun list-box-scroll-pane-for-state [state]
  (list-box-scroll-pane-child state
                              (list-box-item-children state)))

(defun list-box-sync-rendered-options [state ctx]
  (let [computed-row-height (if (:auto-row-height? state)
                              (list-box-measured-row-height ctx)
                              (:row-height state))
        computed-content-width (if (:auto-content-width? state)
                                 (list-box-measured-content-width state ctx)
                                 (:content-width state))
        state (assoc state :computed-row-height computed-row-height)
        state (assoc state :computed-content-width computed-content-width)
        render-key (list-box-render-key state)]
    (when (not= render-key (:rendered-render-key state))
      (ui/replace-child! (:view ctx)
                         "scroll-pane"
                         (list-box-scroll-pane-for-state state)))
    (when (and (:managed-height? state)
               (list-box-can-sync-managed-height? ctx))
      (ui/style! (:view ctx)
                 (list-box-managed-style state ctx)))
    (assoc state :rendered-render-key render-key)))



;; Internal components


(defcomponent ui/list-box-item
  {:class [:ui/list-item :ui/list-box-item]
   :ui/state-keys [:index
                   :value
                   :label
                   :disabled?
                   :selected
                   :selected-indices
                   :reorderable?
                   :reorder-index
                   :reorder-value
                   :reorder-option]
   :style {:width :fill
           :height default-row-height
           :clip true
           :layout {:direction :row
                    :align-items :center}}
   :init-ui (fn [ui-state state ctx]
              (assoc ui-state
                     :selected
                     (if (nil? (:selected-indices ui-state))
                       (:selected ui-state)
                       (selected-index? (:selected-indices ui-state)
                                        (:index ui-state)))))
   :update-ui (fn [ui-state state ctx]
                (assoc ui-state
                       :selected
                       (if (nil? (:selected-indices ui-state))
                         (:selected ui-state)
                         (selected-index? (:selected-indices ui-state)
                                          (:index ui-state)))))
   :on-mouse-down (fn [state event ctx]
                    (ui/stop-propagation! event)
                    state)
   :on-click (fn [state event ctx]
               (let [ui-state (-> ctx :view :ui-state)]
                 (unless (:disabled? ui-state)
                   (ui/emit! (:view ctx)
                             :list-box/item-click
                             {:index (:index ui-state)
                              :value (:value ui-state)
                              :shift? (held-shift? ctx)
                              :ctrl? (held-ctrl? ctx)})))
               state)
   :on-double-click (fn [state event ctx]
                      (let [ui-state (-> ctx :view :ui-state)]
                        (unless (:disabled? ui-state)
                          (ui/emit! (:view ctx)
                                    :list-box/item-activate
                                    {:index (:index ui-state)
                                     :value (:value ui-state)
                                     :shift? (held-shift? ctx)
                                     :ctrl? (held-ctrl? ctx)})))
                      state)
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defcomponent ui/list-box
  {:focusable true
   :class :ui/list-box
   :ui/state-keys [:options
                   :item-state-keys
                   :row-height
                   :explicit-row-height?
                   :computed-row-height
                   :auto-row-height?
                   :visible-rows
                   :max-height
                   :fixed-visible-rows?
                   :content-width
                   :computed-content-width
                   :auto-content-width?
                   :managed-height?
                   :stretch-items?
                   :disabled?
                   :reorderable?
                   :reorder-drag-threshold
                   :reorder-visual-strategy
                   :item-child
                   :hover-highlight?
                   :selected-indices
                   :selected-values
                   :multi-select?
                   :force-selection?
                   :toggle-selected?
                   :anchor-index
                   :content-state
                   :offset
                   :scroll-y?
                   :rendered-render-key
                   :reorder-drag
                   :reorder-drag-ended?]
   :content-size list-box-content-size
   :init-ui (fn [ui-state state ctx]
           (let [selected (or (resolved-selected-indices (:selected-indices ui-state))
                              (if (forced-selection? ui-state)
                                (if-let [index (first-enabled-index (:options ui-state))]
                                  [index]
                                  [])
                                []))]
             (let [ui-state (assoc (assoc (assoc (assoc ui-state
                                                          :selected-indices selected)
                                                   :anchor-index (or (:anchor-index ui-state)
                                                                     (head selected)))
                                            :content-state
                                            (list-box-content-state
                                             (assoc ui-state
                                                    :selected-indices
                                                    selected)
                                             state))
                                   :scroll-y?
                                   :auto)]
               (list-box-sync-rendered-options ui-state ctx))))
   :update-ui (fn [ui-state state ctx]
             (list-box-apply-reorder-visuals!
              (list-box-sync-rendered-options
               (assoc ui-state
                      :content-state
                      (list-box-content-state ui-state state))
               ctx)
              ctx))
   :after-layout-ui (fn [ui-state state ctx]
                   (cond-> (list-box-apply-reorder-visuals!
                            (list-box-sync-rendered-options
                             (assoc ui-state
                                    :content-state
                                    (list-box-content-state ui-state state))
                             ctx)
                            ctx)
                     (:reorder-drag-ended? ui-state) (assoc :reorder-drag nil
                                                            :reorder-drag-ended?
                                                            false)))
   :on-key-down list-box-on-key-down
   :on-drag-start (fn [state event ctx]
                    (case (-> event :payload :kind)
                      :list-box/reorder-item
                      (let [ui-state (-> ctx :view :ui-state)]
                        (ui/set-ui-state! ctx
                                          (assoc ui-state
                                                 :reorder-drag
                                                 (assoc (:payload event)
                                                        :position
                                                        (:position event)
                                                        :start-position
                                                        (:start-position event)
                                                        :start-global-position
                                                        (:start-global-position event))
                                                 :reorder-drag-ended?
                                                 false))
                        state)

                      :default state))
   :on-drag (fn [state event ctx]
              (case (-> event :payload :kind)
                :list-box/reorder-item
                (let [ui-state (-> ctx :view :ui-state)]
                  (ui/set-ui-state! ctx
                                    (assoc ui-state
                                           :reorder-drag
                                           (assoc (or (:reorder-drag ui-state)
                                                      (:payload event))
                                                  :position
                                                  (:position event))
                                           :reorder-drag-ended?
                                           false))
                  state)

                :default state))
   :on-drag-end (fn [state event ctx]
                  (ui/set-ui-state! ctx
                                    (assoc (-> ctx :view :ui-state)
                                           :reorder-drag-ended?
                                           true))
                  state)
   :on {:list-box/item-click (fn [state event ctx]
                              (let [ui-state (-> ctx :view :ui-state)]
                              (if (:reorder-drag ui-state)
                                (do
                                  (ui/stop-propagation! event)
                                  state)
                                (let [payload (:payload event)
                                      option (option-at (:options ui-state) (:index payload))
                                      disabled? (or (:disabled? ui-state)
                                                    (option-disabled? option))
                                      selected (if disabled?
                                                 (:selected-indices ui-state)
                                                 (list-box-click-selection ui-state payload))
                                      changed? (selection-changed?
                                                (:selected-indices ui-state)
                                                selected)
                                      next-ui-state (assoc (assoc ui-state
                                                                  :selected-indices selected)
                                                           :anchor-index (:index payload))
                                      values (selected-values-for (:options next-ui-state)
                                                                  selected)
                                      next-ui-state (assoc next-ui-state
                                                           :selected-values
                                                           values)]
                                  (ui/stop-propagation! event)
                                  (ui/set-ui-state! ctx next-ui-state)
                                  (when (and (not disabled?) changed?)
                                    (ui/emit! (:view ctx)
                                              :list-box/change
                                              {:selected-indices selected
                                               :selected-values values
                                               :value (:value payload)}))
                                  (assoc state
                                         :selected-indices selected
                                         :selected-values values
                                         :anchor-index (:index payload))))))
        :list-box/item-activate (fn [state event ctx]
                                  (let [ui-state (-> ctx :view :ui-state)
                                        payload (:payload event)
                                        option (option-at (:options ui-state) (:index payload))
                                        disabled? (or (:disabled? ui-state)
                                                      (option-disabled? option))
                                        selected (if disabled?
                                                   (:selected-indices ui-state)
                                                   (list-box-click-selection ui-state payload))
                                        values (selected-values-for (:options ui-state)
                                                                    selected)]
                                    (ui/stop-propagation! event)
                                    (unless disabled?
                                      (ui/emit! (:view ctx)
                                                :list-box/activate
                                                (merge payload
                                                       {:selected-indices selected
                                                        :selected-values values})))
                                    state))}
   :on-drop (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)
                    drag (list-box-reorder-drag-for-drop ui-state event)
                    from-index (:index drag)]
                (if (and (reorderable? ui-state)
                         drag
                         (valid-option-index? (:options ui-state) from-index)
                         (not (option-disabled? (option-at (:options ui-state)
                                                           from-index))))
                  (let [event-payload (list-box-reorder-event-payload ui-state event drag)]
                    (ui/stop-propagation! event)
                    (when (not= (:from-index event-payload)
                                (:to-index event-payload))
                      (ui/emit! (:view ctx)
                                :list-box/reorder
                                event-payload))
                    (ui/set-ui-state! ctx
                                      (assoc ui-state
                                             :reorder-drag nil
                                             :reorder-drag-ended? false))
                    (assoc state
                           :reorder-drag nil
                           :reorder-drag-ended? false))
                  state)))})



;; Make functions

(defun make
  "Builds a ui/list-box child entry.

  Options:

  ```roo
  {:options [{:value :a :label \"Alpha\"}]
   :selected-indices [0]
   :multi-select? false
   :force-selection? false
   :toggle-selected? false
   :row-height 20
   :visible-rows 5
   :max-height 120
   :content-width 100
   :hover-highlight? true
   :reorderable? false
   :class :settings/list
   :style {...}
   :state {...}
   :ui-state {...}
   :state-policy :shared}
  ```

  Stock list-box behavior values are written under `:state :component`.
  Static values, `ui/bind-state`, and `ui/project-state` are accepted for
  component entries. Ordinary :state entries remain available for caller
  application state. During migration, component keys supplied directly in
  :state are also copied into :component, and the default shared state policy
  keeps declared component keys visible in ordinary state."
  [{:keys [options class style row-height visible-rows max-height
           fixed-visible-rows? content-width selected-indices multi-select?
           force-selection? toggle-selected? hover-highlight? item-child
           item-state-keys state disabled? reorderable? reorder-drag-threshold
           reorder-visual-strategy ui-state state-policy] :as opts}]
  (let [state (or state {})
        component (cond-> (merge (select-keys state
                                              [:options
                                               :item-state-keys
                                               :row-height
                                               :visible-rows
                                               :max-height
                                               :fixed-visible-rows?
                                               :content-width
                                               :disabled?
                                               :reorderable?
                                               :reorder-drag-threshold
                                               :reorder-visual-strategy
                                               :item-child
                                               :hover-highlight?
                                               :selected-indices
                                               :multi-select?
                                               :force-selection?
                                               :toggle-selected?])
                                 (or (:component state) {}))
                          (contains? opts :options) (assoc :options options)
                          (contains? opts :item-state-keys) (assoc :item-state-keys
                                                                   item-state-keys)
                          (contains? opts :row-height) (assoc :row-height row-height)
                          (contains? opts :visible-rows) (assoc :visible-rows
                                                                visible-rows)
                          (contains? opts :max-height) (assoc :max-height max-height)
                          (contains? opts :fixed-visible-rows?) (assoc :fixed-visible-rows?
                                                                       fixed-visible-rows?)
                          (contains? opts :content-width) (assoc :content-width
                                                                 content-width)
                          (contains? opts :disabled?) (assoc :disabled? disabled?)
                          (contains? opts :reorderable?) (assoc :reorderable?
                                                                reorderable?)
                          (contains? opts :reorder-drag-threshold) (assoc :reorder-drag-threshold
                                                                          reorder-drag-threshold)
                          (contains? opts :reorder-visual-strategy) (assoc :reorder-visual-strategy
                                                                           reorder-visual-strategy)
                          (contains? opts :item-child) (assoc :item-child item-child)
                          (contains? opts :hover-highlight?) (assoc :hover-highlight?
                                                                    hover-highlight?)
                          (contains? opts :selected-indices) (assoc :selected-indices
                                                                    selected-indices)
                          (contains? opts :multi-select?) (assoc :multi-select?
                                                                 multi-select?)
                          (contains? opts :force-selection?) (assoc :force-selection?
                                                                    force-selection?)
                          (contains? opts :toggle-selected?) (assoc :toggle-selected?
                                                                    toggle-selected?))
        options (or (:options component) [])
        row-height (:row-height component)
        computed-row-height (or row-height default-row-height)
        visible-rows (or (:visible-rows component) default-visible-rows)
        content-width (:content-width component)
        computed-content-width (or content-width 1)
        managed-height? (not (contains? (or style {}) :height))
        height (list-box-visible-height options
                                        computed-row-height
                                        visible-rows
                                        (:max-height component)
                                        (:fixed-visible-rows? component))
        final-style (merge {:height (if managed-height?
                                      :shrink
                                      height)
                            :width :shrink}
                           (or style {}))
        component (assoc component
                         :options options
                         :row-height row-height
                         :explicit-row-height? (some? row-height)
                         :computed-row-height computed-row-height
                         :auto-row-height? (nil? row-height)
                         :visible-rows visible-rows
                         :content-width content-width
                         :computed-content-width computed-content-width
                         :auto-content-width? (nil? content-width)
                         :managed-height? managed-height?
                         :stretch-items? (list-box-stretches-items? final-style))]
    (cond-> {:mode 'ui/list-box
             :style final-style
             :state (assoc state :component component)
             :children [(list-box-scroll-pane-for-state component)]}
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state)
            state-policy (assoc :ui/state-policy state-policy))))
