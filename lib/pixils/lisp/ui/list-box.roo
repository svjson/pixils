(ns pixils.ui.list-box
  (:require pixils
            [pixils.point :as pt]
            [pixils.ui :as ui]
            [pixils.ui.internal.option-navigation :as navigation]
            [pixils.ui.popup-menu :as popup-menu]
            [pixils.ui.option-item :as option]
            [pixils.ui.option-list :as option-list]
            [pixils.ui.option-selection :as selection]))



;; Selection support

(defun click-selection [{:keys [multi-select?
                                selected-indices
                                toggle-selected?] :as state}
                        {:keys [button index shift? ctrl?]}]
  (let [selected? (contains? selected-indices index)]
    (cond
      (= button :right)
      (if selected?
        selected-indices
        (selection/select (:options state) selected-indices index state))

      (and multi-select? shift?)
      (let [anchor (or (:anchor-index state) index)]
        (selection/span (:options state) anchor index))

      (and ctrl? multi-select? (not selected?))
      (selection/add (:options state) selected-indices index state)

      (and selected?
           (or toggle-selected? multi-select?))
      (selection/deselect (:options state) selected-indices index state)

      :default
      (selection/select (:options state) selected-indices index state))))

(defun navigation-base-index [state direction]
  (or (:active-index state)
      (head (:selected-indices state))
      (if (> direction 0)
        -1
        (count (:options state)))))

(defun navigation-state-transition [current candidate _changed-keys]
  (let [options (:options candidate)
        selected-index (head (:selected-indices candidate))
        selected-changed? (not= (:selected-indices current)
                                (:selected-indices candidate))
        anchor-index (cond
                       (and (not= (:anchor-index current)
                                  (:anchor-index candidate))
                            (navigation/enabled-index? options
                                                       (:anchor-index candidate)))
                       (:anchor-index candidate)

                       (and (not= (:active-index current)
                                  (:active-index candidate))
                            (navigation/enabled-index? options
                                                       (:anchor-index candidate)))
                       (:anchor-index candidate)

                       selected-changed?
                       selected-index

                       (navigation/enabled-index? options
                                                  (:anchor-index candidate))
                       (:anchor-index candidate)

                       :default selected-index)
        active-index (cond
                       (and (not= (:active-index current)
                                  (:active-index candidate))
                            (navigation/enabled-index? options
                                                       (:active-index candidate)))
                       (:active-index candidate)

                       selected-changed?
                       selected-index

                       (navigation/enabled-index? options
                                                  (:active-index candidate))
                       (:active-index candidate)

                       :default selected-index)]
    {:anchor-index anchor-index
     :active-index active-index}))

(defun keyboard-target-index [state key]
  (let [{:keys [options]} state]
    (case key
      :key/down
      (navigation/next-enabled-index-from
       options
       (navigation-base-index state 1)
       1)

      :key/up
      (navigation/next-enabled-index-from
       options
       (navigation-base-index state -1)
       -1)

      :key/home
      (navigation/first-enabled-index options)

      :key/end
      (navigation/last-enabled-index options)

      :default nil)))

(defun apply-keyboard-selection [{:keys [options selected-indices] :as state}
                                 index
                                 ctx]
  (if (navigation/enabled-index? options index)
    (let [selected (selection/select options selected-indices index state)
          next-state (assoc state
                            :selected-indices selected
                            :anchor-index index
                            :active-index index)]
      (assoc next-state
             :offset
             (option-list/scroll-offset-for-index next-state ctx index)))
    state))


;; Reorder support

(defun reorder-drag-policy [threshold]
  {:start {:mode :threshold
           :distance (or threshold 3)}
   :payload (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)]
                {:kind :list-box/reorder-item
                 :index (:reorder-index ui-state)
                 :value (:reorder-value ui-state)
                 :option (:reorder-option ui-state)}))})

(defun reorder-target-index [from-index drag-top row-height item-count]
  (let [origin-top (* from-index row-height)
        required-overlap (* row-height 0.25)
        threshold-y (if (< drag-top origin-top)
                      (+ drag-top required-overlap)
                      (- (+ drag-top row-height)
                         required-overlap))]
    (clamp (int (/ threshold-y
                   row-height))
         0
         (dec item-count))))

(defun reorder-at-position [state reorder position]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state))
        geometry-key {:from-index (:index reorder)
                      :position-x (or (:x position) 0)
                      :position-y (or (:y position) 0)
                      :row-height row-height
                      :item-count (count (:options state))}]
    (if (= geometry-key (:geometry-key reorder))
      reorder
      (let [from-index (:index reorder)
            drag-top (+ (* from-index row-height)
                        (- (or (:y position) 0)
                           (or (-> reorder :start-position :y) 0)))
            target-index (reorder-target-index from-index
                                               drag-top
                                               row-height
                                               (count (:options state)))
            drop-index (cond-> target-index
                         (> target-index from-index) inc)]
        (assoc reorder
               :position position
               :geometry-key geometry-key
               :row-height row-height
               :drop-index drop-index
               :target-index target-index
               :drag-top drag-top)))))

(defun sync-reorder [state]
  (case (-> state :reorder :phase)
    :dragging (assoc state
                     :reorder
                     (reorder-at-position state
                                          (:reorder state)
                                          (-> state :reorder :position)))
    :default state))

(defun reorder-for-drop [state event]
  (let [{:keys [payload]} event
        reorder (:reorder state)
        tracked? (and (or (= :dragging (:phase reorder))
                          (= :ended (:phase reorder)))
                      (pt/= (:start-global-position reorder)
                            (:start-global-position event)))]
    (if tracked?
      reorder
      (case (:kind payload)
        :list-box/reorder-item
        (reorder-at-position state payload (:position event))

        :default nil))))

(defun reorder-event-payload [state reorder]
  (let [from-index (:index reorder)
        option (nth (:options state) from-index)]
    {:from-index from-index
     :to-index (:target-index reorder)
     :drop-index (:drop-index reorder)
     :value (option/value option)
     :option option}))

(defun flow-item-style [margin-top margin-bottom]
  {:position :flow
   :margin {:t margin-top
            :r 0
            :b margin-bottom
            :l 0}})

(defun absolute-item-style [row-height top]
  {:position :absolute
   :left 0
   :top top
   :width :fill
   :height row-height
   :margin {:t 0
            :r 0
            :b 0
            :l 0}})

(defun compact-item-index [index from-index]
  (cond-> index
    (> index from-index) dec))

(defun placeholder-before? [index from-index target-index]
  (and (not= index from-index)
       (= (compact-item-index index from-index)
          target-index)))

(defun placeholder-after? [index item-count from-index target-index]
  (and (not= index from-index)
       (= target-index (dec item-count))
       (= (compact-item-index index from-index)
          (- item-count 2))))

(defun reorder-item-style [state index]
  (let [reorder (:reorder state)
        from-index (:index reorder)
        row-height (:row-height reorder)
        target-index (:target-index reorder)]
    (if (= index from-index)
      (absolute-item-style row-height (:drag-top reorder))
      (flow-item-style (if (placeholder-before? index
                                                from-index
                                                target-index)
                         row-height
                         0)
                       (if (placeholder-after? index
                                               (count (:options state))
                                               from-index
                                               target-index)
                         row-height
                         0)))))

(defun apply-reorder-visuals! [state ctx]
  (let [content (option-list/content-view ctx)
        dragging? (and (:reorderable? state)
                       (= :dragging (-> state :reorder :phase))
                       (= (or (:reorder-visual-strategy state)
                              :placeholder)
                          :placeholder))
        ended? (= :ended (-> state :reorder :phase))]
    (when (and content (or dragging? ended?))
      (let [items (ui/children content)]
        (dotimes [index (count items)]
          (ui/style! (nth items index)
                     (if dragging?
                       (reorder-item-style state index)
                       (flow-item-style 0 0))))))
    state))



;; Inner Components

(defcomponent ui/list-box-item
  {:extend 'ui/option-item
   :class :ui/list-box-item
   :ui/state-keys [:reorderable?
                   :reorder-index
                   :reorder-value
                   :reorder-option]})



;; Main Component

(def LIST-BOX-UI-STATE-KEYS
  [:reorderable?
   :reorder-drag-threshold
   :reorder-visual-strategy
   :selected-values
   :multi-select?
   :force-selection?
   :toggle-selected?
   :selected-index
   :item-context-menu
   :context-target
   :anchor-index
   :reorder])

(defcomponent ui/list-box
  {:extend 'ui/option-list
   :focusable true
   :class :ui/list-box
   :ui/state-keys LIST-BOX-UI-STATE-KEYS
   :ui/models [(selection/model :list-box/selection-change)
               {:owns [:anchor-index :active-index]
                :depends-on [:options
                             :selected-indices
                             :multi-select?
                             :force-selection?]
                :transition navigation-state-transition}]
   :init-ui (fn [{:keys [selected-indices] :as ui-state} state ctx]
              (option-list/sync-ui (-> ui-state
                                       (update :anchor-index [or (head selected-indices)])
                                       (update :active-index [or (head selected-indices)])
                                       (assoc :reorder {:phase :idle}))
                                   state
                                   ctx))
   :update-ui (fn [ui-state state ctx]
                (apply-reorder-visuals! (sync-reorder
                                         (option-list/sync-ui ui-state state ctx))
                                        ctx))
   :after-layout-ui (fn [ui-state state ctx]
                      (cond-> (apply-reorder-visuals!
                               (sync-reorder
                                (-> ui-state
                                    (option-list/sync-layout ctx)
                                    (option-list/sync-rendered-items ctx)))
                               ctx)
                              (= :ended (-> ui-state :reorder :phase))
                              (assoc :reorder {:phase :idle})))
   :on-key-down (fn [state event ctx]
                  (let [{:keys [disabled?] :as ui-state} (-> ctx :view :ui-state)
                        target-index (keyboard-target-index ui-state (:key event))]
                    (when (and target-index (not disabled?))
                      (let [next-ui-state (apply-keyboard-selection ui-state
                                                                    target-index
                                                                    ctx)]
                        (ui/stop-propagation! event)
                        (ui/set-ui-state! ctx next-ui-state)))
                    state))
   :on-drag-start (fn [state event ctx]
                    (case (-> event :payload :kind)
                      :list-box/reorder-item
                      (let [ui-state (-> ctx :view :ui-state)]
                        (ui/set-ui-state! ctx
                                          (assoc ui-state
                                                 :reorder
                                                 (reorder-at-position
                                                  ui-state
                                                  (assoc (:payload event)
                                                         :phase
                                                         :dragging
                                                         :start-position
                                                         (:start-position event)
                                                         :start-global-position
                                                         (:start-global-position event))
                                                  (:position event))))
                        state)

                      :default state))
   :on-drag (fn [state event ctx]
              (case (-> event :payload :kind)
                :list-box/reorder-item
                (let [ui-state (-> ctx :view :ui-state)]
                  (ui/set-ui-state! ctx
                                    (assoc ui-state
                                           :reorder
                                           (reorder-at-position
                                            ui-state
                                            (:reorder ui-state)
                                            (:position event))))
                  state)

                :default state))
   :on-drag-end (fn [state event ctx]
                  (let [ui-state (-> ctx :view :ui-state)]
                    (when (= :dragging (-> ui-state :reorder :phase))
                      (ui/set-ui-state! ctx
                                        (assoc-in ui-state
                                                  [:reorder :phase]
                                                  :ended))))
                  state)
   :on {:option-item/click
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)
                disabled? (or (:disabled? ui-state)
                              (not (navigation/enabled-index?
                                    (:options ui-state)
                                    (:index payload))))]
            (cond
              (not= :idle (-> ui-state :reorder :phase))
              (do
                (ui/stop-propagation! event)
                state)

              disabled?
              (do
                (ui/stop-propagation! event)
                state)

              :default
              (let [button (or (:button payload) :left)
                    index (:index payload)
                    option (nth (:options ui-state) index)
                    menu-source (:item-context-menu ui-state)
                    context-menu (when (and (= button :right)
                                            menu-source)
                                   (if (fn? menu-source)
                                     (menu-source index option)
                                     menu-source))
                    context-menu (when (not-empty? (:items context-menu))
                                   context-menu)]
                (ui/stop-propagation! event)
                (if (or (= button :left) context-menu)
                  (let [selected (click-selection ui-state
                                                  (assoc payload
                                                         :button button))
                        next-ui-state
                        (cond-> (assoc ui-state
                                       :selected-indices selected
                                       :active-index index)
                                (not (and (:multi-select? ui-state)
                                          (:shift? payload)))
                                (assoc :anchor-index index)
                                context-menu
                                (assoc :context-target
                                       {:index index
                                        :value (option/value option)
                                        :option option}))]
                    (ui/set-ui-state! ctx next-ui-state)
                    (when context-menu
                      (popup-menu/open-context! context-menu
                                               (:global-position payload)
                                               state
                                               ctx))
                    state)
                  state)))))
        :menu/select
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)
                context-target (:context-target ui-state)]
            (when context-target
              (ui/stop-propagation! event)
              (ui/set-ui-state! ctx (assoc ui-state :context-target nil))
              (when (= :action (:type payload))
                (ui/emit! (:view ctx)
                          :list-box/context-action
                          (merge context-target
                                 {:action (:action payload)
                                  :payload (:payload payload)}
                                 (select-keys ui-state
                                              [:selected-indices
                                               :selected-values])))))
            state))
        :option-item/activate
        (fn [state event ctx]
          (let [ui-state (-> ctx :view :ui-state)
                payload (:payload event)
                disabled? (or (:disabled? ui-state)
                              (not (navigation/enabled-index?
                                    (:options ui-state)
                                    (:index payload))))]
            (ui/stop-propagation! event)
            (unless disabled?
            (ui/emit! (:view ctx)
                      :list-box/activate
                      (merge payload
                             (select-keys ui-state
                                          [:selected-indices
                                           :selected-values]))))
            state))}
   :on-drop (fn [state event ctx]
              (let [ui-state (-> ctx :view :ui-state)
                    reorder (reorder-for-drop ui-state event)
                    from-index (:index reorder)]
                (if (and (:reorderable? ui-state)
                         reorder
                         (navigation/valid-index? (:options ui-state) from-index)
                         (not (:disabled? (nth (:options ui-state)
                                               from-index))))
                  (let [event-payload (reorder-event-payload ui-state reorder)]
                    (ui/stop-propagation! event)
                    (when (not= (:from-index event-payload)
                                (:to-index event-payload))
                      (ui/emit! (:view ctx)
                                :list-box/reorder
                                event-payload))
                    (ui/set-ui-state! ctx
                                      (assoc ui-state
                                             :reorder (assoc reorder :phase :ended)))
                    state)
                  state)))})



;; Make functions

(defun make
  "Builds a ui/list-box child entry.

  Options:

  ```roo
  {:options [{:value :a :label \"Alpha\"}]
   :selected-indices [0]
   :selected-index 0
   :multi-select? false
   :force-selection? false
   :toggle-selected? false
   :row-height 20
   :item=> 'app/person-list-item
   :item-context-menu {:items [{:label \"Rename\"
                                :action :rename}]}
   :reorderable? false
   :class :settings/list
   :style {:visible-rows 5}
   :state {...}
   :ui-state {...}
   :state-policy :isolated}
  ```

  `:selected-index` is a scalar input for single-selection callers;
  `:selected-indices` remains the canonical component state.

  `:item=>` accepts a component symbol, a view declaration, or a function of
  item index and option. Functions are resolved repeatedly until they return a
  component symbol or view declaration. The default is `ui/list-box-item`.

  `:item-context-menu` accepts a menu definition or a function receiving an
  item index and option and returning a menu definition. Selecting an
  item-menu action emits
  `:list-box/context-action` with the item identity, action, menu payload, and
  current selection.

  Stock list-box behavior values are written under `:state :component`.
  Static values, `ui/bind-state`, and `ui/project-state` are accepted for
  component entries. Ordinary :state entries remain available for caller
  application state. During migration, component keys supplied directly in
  :state are also copied into :component. List boxes use isolated component
  state by default; pass `:state-policy :shared` only for compatibility with
  code that reads component keys from ordinary state.

  Args:
  - `opts`: List-box behavior, state, and styling.

  Returns:
  A `ui/list-box` child definition."
  [{:keys [class style state ui-state state-policy] :as opts}]
  (let [component (merge (option-list/component-state opts)
                         (select-keys state LIST-BOX-UI-STATE-KEYS)
                         (select-keys opts LIST-BOX-UI-STATE-KEYS)
                         {:decorate-item (fn [child
                                              {:keys [reorder-drag-threshold
                                                      reorderable?]}
                                              index
                                              item]
                                           (let [child
                                                 (option-list/merge-item-state
                                                  child
                                                  {:reorderable? reorderable?
                                                   :reorder-index index
                                                   :reorder-value (option/value item)
                                                   :reorder-option item})]
                                             (cond-> child
                                                     reorderable? (update
                                                                   :drag
                                                                   [merge
                                                                    (reorder-drag-policy
                                                                     reorder-drag-threshold)]))))
                          :render-state-keys [:reorderable?
                                              :reorder-drag-threshold]})
        component (update component :item=> [or 'ui/list-box-item])]
    (cond-> {:mode 'ui/list-box
             :state (assoc state :component component)
             :ui/state-policy (or state-policy :isolated)
             :children [(option-list/scroll-pane-for-state component)]}
            (contains? opts :style) (assoc :style style)
            class (assoc :class class)
            ui-state (assoc :ui-state ui-state))))
