(ns pixils.ui.list-box
  (:require pixils
            pixils.ui.scroll-pane
            [pixils.render :as r]
            [pixils.ui :as ui]))

(def default-row-height 20)
(def default-visible-rows 5)
(def default-reorder-drag-threshold 3)
(def default-reorder-visual-strategy :placeholder)
(def default-list-item-padding {:t 3
                                :r 5
                                :b 3
                                :l 5})

(defun option-label [option]
  (or (:label option)
      (:name option)
      (str (:value option))))

(defun option-value [option]
  (let [value (:value option)]
    (if (nil? value)
      (:id option)
      value)))

(defun option-disabled? [option]
  (= (:disabled? option) true))

(defun option-at [options index]
  (nth options index))

(defun option-value-at [options index]
  (option-value (option-at options index)))

(defun selected-values-for [options indices]
  (map indices (fn [index]
                 (option-value-at options index))))

(defun add-index [indices index]
  (if (contains? indices index)
    indices
    (concat indices [index])))

(defun first-enabled-index [options]
  (let [match (head (filter (for-indexed [index option (or options [])]
                              {:index index
                               :option option})
                            (fn [entry]
                              (not (option-disabled? (:option entry))))))]
    (when match
      (:index match))))

(defun valid-option-index? [options index]
  (and (not (nil? index))
       (>= index 0)
       (< index (count options))))

(defun enabled-option-index? [options index]
  (and (valid-option-index? options index)
       (not (option-disabled? (option-at options index)))))

(defun next-enabled-index-from [options index direction]
  (let [next-index (+ index direction)]
    (cond
      (or (< next-index 0)
          (>= next-index (count options)))
      nil

      (enabled-option-index? options next-index)
      next-index

      :default
      (next-enabled-index-from options next-index direction))))

(defun last-enabled-index [options]
  (next-enabled-index-from options (count options) -1))

(defun remove-index [indices index]
  (filter indices (fn [item]
                    (not= item index))))

(defun index-range-up [from to]
  (if (> from to)
    []
    (concat [from] (index-range-up (inc from) to))))

(defun index-range [from to]
  (index-range-up (min from to) (max from to)))

(defun add-indices [indices items]
  (reduce items indices (fn [out index]
                          (add-index out index))))

(defun held-shift? [ctx]
  (or (contains? (:held-keys ctx) :key/shift)
      (contains? (:held-keys ctx) :key/left-shift)
      (contains? (:held-keys ctx) :key/right-shift)))

(defun held-ctrl? [ctx]
  (or (contains? (:held-keys ctx) :key/ctrl)
      (contains? (:held-keys ctx) :key/left-ctrl)
      (contains? (:held-keys ctx) :key/right-ctrl)))

(defun forced-selection? [state]
  (= (:force-selection? state) true))

(defun multi-select? [state]
  (= (:multi-select? state) true))

(defun toggle-selected? [state]
  (= (:toggle-selected? state) true))

(defun reorderable? [state]
  (= (:reorderable? state) true))

(defun reorder-visual-strategy [state]
  (or (:reorder-visual-strategy state)
      default-reorder-visual-strategy))

(defun reorder-placeholder-strategy? [state]
  (let [strategy (reorder-visual-strategy state)]
    (or (= strategy :placeholder)
        (= strategy :move-with-hole))))

(defun preserve-forced-selection [state indices previous]
  (if (and (forced-selection? state)
           (empty? indices))
    previous
    indices))

(defun single-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (and (contains? selected index)
             (toggle-selected? state))
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      [index])))

(defun ctrl-click-selection [state index]
  (let [selected (or (:selected-indices state) [])]
    (if (contains? selected index)
      (preserve-forced-selection state
                                 (remove-index selected index)
                                 selected)
      (add-index selected index))))

(defun shift-click-selection [state index ctrl?]
  (let [selected (or (:selected-indices state) [])
        anchor (or (:anchor-index state) index)
        range (index-range anchor index)]
    (if ctrl?
      (add-indices selected range)
      range)))

(defun list-box-click-selection [state payload]
  (let [index (:index payload)]
    (if (multi-select? state)
      (cond
        (:shift? payload)
        (shift-click-selection state index (:ctrl? payload))

        (:ctrl? payload)
        (ctrl-click-selection state index)

        :default
        (single-click-selection state index))
      (single-click-selection state index))))

(defun selection-changed? [previous selected]
  (not= (or previous []) (or selected [])))

(defun clamp [value low high]
  (max low (min high value)))

(defun list-box-content-height [options row-height]
  (* (count options) row-height))

(defun list-box-visible-height [options row-height visible-rows max-height]
  (min (or max-height (* row-height visible-rows))
       (list-box-content-height options row-height)))

(defun list-box-style [ctx]
  (or (-> ctx :view :effective-style)
      (-> ctx :view :style)))

(defun text-args [style]
  (reduce-kv (:text style)
             {}
             (fn [arg-map k v]
               (if (nil? v)
                 arg-map
                 (merge arg-map {k v})))))

(defun list-box-item-padding [ctx]
  (or (ui/theme-var ctx :list-box-item-padding nil)
      default-list-item-padding))

(defun list-box-item-padding-side [padding side]
  (or (get padding side)
      (cond
        (= side :top) (get padding :t)
        (= side :right) (get padding :r)
        (= side :bottom) (get padding :b)
        (= side :left) (get padding :l)
        :default nil)
      0))

(defun list-box-measured-row-height [ctx]
  (let [dim (r/text-size "M" (text-args (list-box-style ctx)))
        padding (list-box-item-padding ctx)]
    (max default-row-height
         (+ (or (:h dim) 0)
            (list-box-item-padding-side padding :top)
            (list-box-item-padding-side padding :bottom)))))

(defun option-label-width [option text-opts]
  (or (:w (r/text-size (option-label option) text-opts)) 0))

(defun list-box-measured-content-width [state ctx]
  (let [text-opts (text-args (list-box-style ctx))
        padding (list-box-item-padding ctx)
        label-width (reduce (or (:options state) [])
                            0
                            (fn [out option]
                              (max out
                                   (option-label-width option text-opts))))]
    (max 1 (+ label-width
              (list-box-item-padding-side padding :left)
              (list-box-item-padding-side padding :right)))))

(defun list-box-row-height [state ctx]
  (or (:row-height state)
      (when ctx (list-box-measured-row-height ctx))
      (:computed-row-height state)
      default-row-height))

(defun list-box-content-width [state ctx]
  (or (:content-width state)
      (when ctx (list-box-measured-content-width state ctx))
      (:computed-content-width state)
      1))

(defun list-box-preferred-height [state ctx]
  (list-box-visible-height (:options state)
                           (list-box-row-height state ctx)
                           (or (:visible-rows state) default-visible-rows)
                           (:max-height state)))

(defun list-box-content-state [state]
  (merge (reduce (or (:item-state-keys state) [])
                 {}
                 (fn [out key]
                   (merge out {key (get state key)})))
         {:selected-indices (or (:selected-indices state) [])
          :active-index (:active-index state)}))

(defun list-box-content-size [state ctx]
  {:w (list-box-content-width state ctx)
   :h (list-box-preferred-height state ctx)})

(defun list-box-stretches-items? [style]
  (let [width (:width (or style {}))]
    (and (not (nil? width))
         (not= width :shrink)
         (not= width :auto))))

(defun list-box-scroll-content-size [state]
  (let [content-height (list-box-content-height (:options state)
                                                (or (:computed-row-height state)
                                                    (:row-height state)
                                                    default-row-height))]
    (if (:stretch-items? state)
      {:h content-height}
      {:w (list-box-content-width state nil)
       :h content-height})))

(defun list-box-scroll-pane-child [state children]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        content-size (list-box-scroll-content-size state)]
    (merge {:id "scroll-pane"}
           (pixils.ui.scroll-pane/make
            {:style {:width :fill
                     :height :fill}
             :content-size content-size
             :content-height-explicit? (:explicit-row-height? state)
             :state {:offset (ui/bind-state :offset)
                     :content-state (ui/bind-state :content-state)}
             :scroll-x? false
             :scroll-y? :auto
             :step row-height
             :children children}))))

(defun list-box-style-padding-side [style side]
  (or (get (:padding style) side) 0))

(defun list-box-style-border-side-thickness [style side]
  (let [border (:border style)
        side-style (get border side)]
    (or (:thickness side-style)
        (:thickness border)
        0)))

(defun list-box-vertical-content-inset [ctx]
  (let [style (list-box-style ctx)]
    (+ (list-box-style-padding-side style :top)
       (list-box-style-padding-side style :bottom)
       (list-box-style-border-side-thickness style :top)
       (list-box-style-border-side-thickness style :bottom))))

(defun list-box-managed-height [state ctx]
  (let [content-height (list-box-preferred-height state ctx)]
    (if (= (-> (list-box-style ctx) :box-sizing) :content-box)
      content-height
      (+ content-height (list-box-vertical-content-inset ctx)))))

(defun list-box-managed-style [state ctx]
  (if (:managed-height? state)
    {:height (list-box-managed-height state ctx)}
    {}))

(defun list-box-can-sync-managed-height? [ctx]
  (> (or (-> ctx :view :bounds :h) 0) 0))

(defun child-at [children index]
  (if (and (>= index 0)
           (< index (count children)))
    (nth children index)
    nil))

(defun left-mouse-held? [ctx]
  (contains? (or (:mouse-held ctx) []) :left))

(defun list-box-content-view [ctx]
  (let [scroll-pane (child-at (ui/children ctx) 0)
        row (if scroll-pane
              (child-at (ui/children scroll-pane) 0)
              nil)
        viewport (if row
                   (child-at (ui/children row) 0)
                   nil)]
    (if viewport
      (child-at (ui/children viewport) 0)
      nil)))

(defun list-box-preview-local-y [ctx]
  (let [pos (:mouse-pos ctx)
        bounds (-> ctx :view :bounds)]
    (when (and pos bounds)
      (- (:y pos) (:y bounds)))))

(defun list-box-navigation-base-index [state direction]
  (or (:anchor-index state)
      (head (or (:selected-indices state) []))
      (if (> direction 0)
        -1
        (count (:options state)))))

(defun list-box-keyboard-target-index [state key]
  (let [options (:options state)]
    (case key
      :key/down
      (next-enabled-index-from
       options
       (list-box-navigation-base-index state 1)
       1)

      :key/up
      (next-enabled-index-from
       options
       (list-box-navigation-base-index state -1)
       -1)

      :key/home
      (first-enabled-index options)

      :key/end
      (last-enabled-index options)

      :default nil)))

(defun list-box-visible-content-height [state ctx]
  (or (-> ctx :view :bounds :h)
      (list-box-preferred-height state ctx)
      0))

(defun list-box-scroll-offset-for-index [state ctx index]
  (let [row-height (list-box-row-height state ctx)
        visible-height (list-box-visible-content-height state ctx)
        content-height (list-box-content-height (:options state) row-height)
        offset (or (:offset state) {:x 0 :y 0})
        offset-y (or (:y offset) 0)
        row-top (* index row-height)
        row-bottom (+ row-top row-height)
        visible-bottom (+ offset-y visible-height)
        max-offset (max 0 (- content-height visible-height))
        next-y (cond
                 (< row-top offset-y)
                 row-top

                 (> row-bottom visible-bottom)
                 (- row-bottom visible-height)

                 :default
                 offset-y)]
    (assoc offset :y (clamp next-y 0 max-offset))))

(defun list-box-change-payload [state selected index]
  {:selected-indices selected
   :selected-values (selected-values-for (:options state) selected)
   :value (option-value-at (:options state) index)})

(defun list-box-apply-keyboard-selection [state index ctx]
  (if (enabled-option-index? (:options state) index)
    (let [selected [index]
          changed? (selection-changed? (:selected-indices state) selected)
          payload (list-box-change-payload state selected index)
          next-state (assoc (assoc (assoc state
                                          :selected-indices selected)
                                   :selected-values (:selected-values payload))
                            :anchor-index index)
          next-state (assoc next-state
                            :offset
                            (list-box-scroll-offset-for-index
                             next-state
                             ctx
                             index))]
      (do
        (when changed?
          (ui/emit! (:view ctx) :list-box/change payload))
        next-state))
    state))

(defun list-box-on-key-down [state event ctx]
  (if (:disabled? state)
    state
    (let [index (list-box-keyboard-target-index state (:key event))]
      (if (nil? index)
        state
        (do
          (ui/stop-propagation! event)
          (list-box-apply-keyboard-selection state index ctx))))))

(defun list-box-reorder-drag-policy [threshold]
  {:start {:mode :threshold
           :distance (or threshold default-reorder-drag-threshold)}
   :payload (fn [state event ctx]
              {:kind :list-box/reorder-item
               :index (:reorder-index state)
               :value (:reorder-value state)
               :option (:reorder-option state)})})

(defun list-box-reorderable-child [child threshold]
  (let [child (assoc child
                     :drag
                     (merge (or (:drag child) {})
                            (list-box-reorder-drag-policy threshold)))]
    (if (contains? child :on-drag-start)
      child
      (assoc child
             :on-drag-start
             (fn [state event ctx]
               (do
                 (ui/emit! (:view ctx)
                           :list-box/reorder-drag-start
                           {:index (:reorder-index state)
                            :value (:reorder-value state)
                            :option (:reorder-option state)
                            :start-global-position (:start-global-position event)})
                 state))))))

(defun list-box-drop-index [state event]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (-> event :position :y) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (max 0 (min (count (:options state)) raw))))

(defun list-box-drop-index-from-local-y [state local-y]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        offset (or (:offset state) {:x 0 :y 0})
        y (+ (or local-y 0) (or (:y offset) 0))
        raw (int (/ (+ y (int (/ row-height 2))) row-height))]
    (max 0 (min (count (:options state)) raw))))

(defun list-box-reorder-target-index [from-index drop-index options]
  (let [target (if (> drop-index from-index)
                 (dec drop-index)
                 drop-index)]
    (max 0 (min (dec (count options)) target))))

(defun same-point? [a b]
  (and (= (:x a) (:x b))
       (= (:y a) (:y b))))

(defun list-box-reorder-drag-for-drop [state event]
  (let [payload (:payload event)]
    (if (= (:kind payload) :list-box/reorder-item)
      payload
      (let [drag (:reorder-drag state)]
        (if (and drag
                 (same-point? (:start-global-position drag)
                              (:start-global-position event)))
          drag
          nil)))))

(defun list-box-reorder-event-payload [state event drag]
  (let [from-index (:index drag)
        options (:options state)
        drop-index (list-box-drop-index state event)
        to-index (list-box-reorder-target-index from-index drop-index options)
        option (option-at options from-index)]
    {:from-index from-index
     :to-index to-index
     :drop-index drop-index
     :value (option-value option)
     :option option}))

(defun list-box-flow-item-style [margin-top margin-bottom]
  {:position :flow
   :margin {:t margin-top
            :r 0
            :b margin-bottom
            :l 0}})

(defun list-box-absolute-item-style [row-height top]
  {:position :absolute
   :left 0
   :top top
   :width :fill
   :height row-height
   :margin {:t 0
            :r 0
            :b 0
            :l 0}})

(defun list-box-reset-item-visuals! [items]
  (if (empty? items)
    nil
    (do
      (ui/style! (head items) (list-box-flow-item-style 0 0))
      (list-box-reset-item-visuals! (tail items)))))

(defun list-box-preview-target-index [state local-y]
  (let [drag (:reorder-drag state)
        from-index (:index drag)
        drop-index (list-box-drop-index-from-local-y state local-y)]
    (list-box-reorder-target-index from-index drop-index (:options state))))

(defun list-box-compact-item-index [index from-index]
  (if (> index from-index)
    (dec index)
    index))

(defun list-box-placeholder-before? [index from-index target-index]
  (and (not= index from-index)
       (= (list-box-compact-item-index index from-index)
          target-index)))

(defun list-box-placeholder-after? [index item-count from-index target-index]
  (and (not= index from-index)
       (= target-index (dec item-count))
       (= (list-box-compact-item-index index from-index)
          (- item-count 2))))

(defun list-box-apply-placeholder-visuals! [state ctx items]
  (let [drag (:reorder-drag state)
        from-index (:index drag)
        row-height (list-box-row-height state ctx)
        item-count (count items)
        local-y (list-box-preview-local-y ctx)
        target-index (list-box-preview-target-index state local-y)
        mouse-pos (:mouse-pos ctx)
        start-pos (:start-global-position drag)
        drag-top (+ (* from-index row-height)
                    (- (or (:y mouse-pos) 0)
                       (or (:y start-pos) 0)))]
    (list-box-apply-placeholder-visuals-indexed! items
                                                 0
                                                 item-count
                                                 row-height
                                                 from-index
                                                 target-index
                                                 drag-top)))

(defun list-box-apply-placeholder-visuals-indexed! [items index item-count row-height from-index target-index drag-top]
  (if (empty? items)
    nil
    (let [style (if (= index from-index)
                  (list-box-absolute-item-style row-height drag-top)
                  (list-box-flow-item-style (if (list-box-placeholder-before? index
                                                                               from-index
                                                                               target-index)
                                              row-height
                                              0)
                                            (if (list-box-placeholder-after? index
                                                                             item-count
                                                                             from-index
                                                                             target-index)
                                              row-height
                                              0)))]
      (do
        (ui/style! (head items) style)
        (list-box-apply-placeholder-visuals-indexed! (tail items)
                                                     (inc index)
                                                     item-count
                                                     row-height
                                                     from-index
                                                     target-index
                                                     drag-top)))))

(defun list-box-apply-reorder-visuals! [state ctx]
  (let [content (list-box-content-view ctx)
        items (if content
                (ui/children content)
                [])]
    (cond
      (empty? items)
      nil

      (not (reorderable? state))
      nil

      (or (nil? (:reorder-drag state))
          (= (reorder-visual-strategy state) :none))
      (list-box-reset-item-visuals! items)

      (reorder-placeholder-strategy? state)
      (list-box-apply-placeholder-visuals! state ctx items)

      :default
      (list-box-reset-item-visuals! items))))

(defun list-box-update-reorder-visuals [state ctx]
  (let [state (if (and (:reorder-drag state)
                       (not (left-mouse-held? ctx)))
                (assoc state :reorder-drag nil)
                state)]
    (do
      (list-box-apply-reorder-visuals! state ctx)
      state)))

(defcomponent ui/list-box-item
  {:class [:ui/list-item :ui/list-box-item]
   :style {:width :fill
           :height default-row-height
           :clip true
           :layout {:direction :row
                    :align-items :center}}
   :update (fn [state ctx]
             (assoc state :selected (contains? (:selected-indices state)
                                               (:index state))))
   :on-mouse-down (fn [state event ctx]
                    (do
                      (ui/stop-propagation! event)
                      state))
   :on-click (fn [state event ctx]
               (do
                 (when (not (:disabled? state))
                   (ui/emit! (:view ctx)
                             :list-box/item-click
                             {:index (:index state)
                              :value (:value state)
                              :shift? (held-shift? ctx)
                              :ctrl? (held-ctrl? ctx)}))
                 state))
   :on-double-click (fn [state event ctx]
                      (do
                        (when (not (:disabled? state))
                          (ui/emit! (:view ctx)
                                    :list-box/item-activate
                                    {:index (:index state)
                                     :value (:value state)
                                     :shift? (held-shift? ctx)
                                     :ctrl? (held-ctrl? ctx)}))
                        state))
   :children [{:mode 'ui/text
               :style {:width :fill}
               :state {:value (ui/bind-state :label)}}]})

(defcomponent ui/list-box
  {:focusable true
   :class :ui/list-box
   :content-size list-box-content-size
   :init (fn [state ctx]
           (let [selected (or (:selected-indices state)
                              (if (forced-selection? state)
                                (if-let [index (first-enabled-index (:options state))]
                                  [index]
                                  [])
                                []))]
             (assoc (assoc (assoc (assoc state
                                          :selected-indices selected)
                                   :anchor-index (or (:anchor-index state)
                                                     (head selected)))
                            :content-state
                            (list-box-content-state (assoc state
                                                          :selected-indices
                                                          selected)))
                    :scroll-y?
                    :auto)))
   :update (fn [state ctx]
             (list-box-update-reorder-visuals
              (list-box-sync-rendered-options
               (assoc state
                      :content-state
                      (list-box-content-state state))
               ctx)
              ctx))
   :after-layout (fn [state ctx]
                   (list-box-sync-rendered-options
                    (assoc state
                           :content-state
                           (list-box-content-state state))
                    ctx))
   :on-key-down list-box-on-key-down
   :on {:list-box/item-click (fn [state event ctx]
                              (if (:reorder-drag state)
                                (do
                                  (ui/stop-propagation! event)
                                  state)
                                (let [payload (:payload event)
                                      option (option-at (:options state) (:index payload))
                                      disabled? (or (:disabled? state)
                                                    (option-disabled? option))
                                      selected (if disabled?
                                                 (:selected-indices state)
                                                 (list-box-click-selection state payload))
                                      changed? (selection-changed?
                                                (:selected-indices state)
                                                selected)
                                      next-state (assoc (assoc state
                                                               :selected-indices selected)
                                                        :anchor-index (:index payload))
                                      values (selected-values-for (:options next-state)
                                                                  selected)]
                                  (do
                                    (ui/stop-propagation! event)
                                    (when (and (not disabled?) changed?)
                                      (ui/emit! (:view ctx)
                                                :list-box/change
                                                {:selected-indices selected
                                                 :selected-values values
                                                 :value (:value payload)}))
                                    (assoc next-state
                                           :selected-values values)))))
        :list-box/item-activate (fn [state event ctx]
                                  (let [payload (:payload event)
                                        option (option-at (:options state) (:index payload))
                                        disabled? (or (:disabled? state)
                                                      (option-disabled? option))
                                        selected (if disabled?
                                                   (:selected-indices state)
                                                   (list-box-click-selection state payload))
                                        values (selected-values-for (:options state)
                                                                    selected)]
                                    (do
                                      (ui/stop-propagation! event)
                                      (when (not disabled?)
                                        (ui/emit! (:view ctx)
                                                  :list-box/activate
                                                  (merge payload
                                                         {:selected-indices selected
                                                          :selected-values values})))
                                      state)))
        :list-box/reorder-drag-start (fn [state event ctx]
                                       (do
                                         (ui/stop-propagation! event)
                                         (assoc state
                                                :reorder-drag
                                                (:payload event))))}
   :on-drop (fn [state event ctx]
              (let [drag (list-box-reorder-drag-for-drop state event)
                    from-index (:index drag)]
                (if (and (reorderable? state)
                         drag
                         (valid-option-index? (:options state) from-index)
                         (not (option-disabled? (option-at (:options state)
                                                           from-index))))
                  (let [event-payload (list-box-reorder-event-payload state event drag)]
                    (do
                      (ui/stop-propagation! event)
                      (when (not= (:from-index event-payload)
                                  (:to-index event-payload))
                        (ui/emit! (:view ctx)
                                  :list-box/reorder
                                  event-payload))
                      (assoc state :reorder-drag nil)))
                  state)))})

(defun stretch-list-box-item [child]
  (assoc child
         :style
         (merge (or (:style child) {})
                {:width :fill})))

(defun make-item-child [item-child index option row-height hover-highlight? stretch-items? parent-disabled? reorderable? reorder-drag-threshold]
  (let [disabled? (or parent-disabled?
                      (option-disabled? option))]
    (let [child (if item-child
                  (item-child index option)
                  {:mode 'ui/list-box-item
                   :class (if hover-highlight?
                            :ui/list-item-hover
                            [])
                   :style {:height row-height}
                   :state {:index index
                           :value (option-value option)
                           :label (option-label option)
                           :disabled? disabled?
                           :selected-indices (ui/bind-state :selected-indices)}})]
      (let [child (assoc child
                         :state
                         (merge (or (:state child) {})
                                {:disabled? disabled?
                                 :reorderable? reorderable?
                                 :reorder-index index
                                 :reorder-value (option-value option)
                                 :reorder-option option}))
            child (if reorderable?
                    (list-box-reorderable-child child reorder-drag-threshold)
                    child)]
        (if stretch-items?
          (stretch-list-box-item child)
          child)))))

(defun list-box-item-children [state]
  (let [row-height (or (:computed-row-height state)
                       (:row-height state)
                       default-row-height)
        options (or (:options state) [])]
    (for-indexed [index option options]
      (make-item-child (:item-child state)
                       index
                       option
                       row-height
                       (:hover-highlight? state)
                       (:stretch-items? state)
                       (:disabled? state)
                       (:reorderable? state)
                       (:reorder-drag-threshold state)))))

(defun list-box-render-key [state]
  {:options (:options state)
   :row-height (:row-height state)
   :computed-row-height (:computed-row-height state)
   :content-width (:content-width state)
   :computed-content-width (:computed-content-width state)
   :stretch-items? (:stretch-items? state)
   :disabled? (:disabled? state)
   :reorderable? (:reorderable? state)
   :reorder-drag-threshold (:reorder-drag-threshold state)
   :hover-highlight? (:hover-highlight? state)})

(defun list-box-scroll-pane-for-state [state]
  (list-box-scroll-pane-child state
                              (list-box-item-children state)))

(defun list-box-sync-rendered-options [state ctx]
  (let [computed-row-height (if (:auto-row-height? state)
                              (list-box-measured-row-height ctx)
                              (:row-height state))
        computed-content-width (if (:auto-content-width? state)
                                 (list-box-measured-content-width state ctx)
                                 (:content-width state))
        state (assoc state :computed-row-height computed-row-height)
        state (assoc state :computed-content-width computed-content-width)
        render-key (list-box-render-key state)]
    (do
      (when (not= render-key (:rendered-render-key state))
        (ui/replace-child! (:view ctx)
                           "scroll-pane"
                           (list-box-scroll-pane-for-state state)))
      (when (and (:managed-height? state)
                 (list-box-can-sync-managed-height? ctx))
        (ui/style! (:view ctx)
                   (list-box-managed-style state ctx)))
      (assoc state :rendered-render-key render-key))))

(defun make [{:keys [options style row-height visible-rows max-height content-width selected-indices multi-select? force-selection? toggle-selected? hover-highlight? item-child item-state-keys state disabled? reorderable? reorder-drag-threshold reorder-visual-strategy]}]
  (let [computed-row-height (or row-height default-row-height)
        visible-rows (or visible-rows default-visible-rows)
        options (or options [])
        disabled? (or disabled? (:disabled? state))
        computed-content-width (or content-width 1)
        explicit-row-height? (not (nil? row-height))
        managed-height? (not (contains? (or style {}) :height))
        content-height (list-box-content-height options computed-row-height)
        height (list-box-visible-height options computed-row-height visible-rows max-height)
        final-style (merge {:height (if managed-height?
                                      :shrink
                                      height)
                            :width :shrink}
                           (or style {}))
        stretch-items? (list-box-stretches-items? final-style)]
    {:mode 'ui/list-box
     :style final-style
     :state (merge (or state {})
                   {:options options
                    :item-state-keys item-state-keys
                    :row-height row-height
                    :explicit-row-height? explicit-row-height?
                    :computed-row-height computed-row-height
                    :auto-row-height? (nil? row-height)
                    :visible-rows visible-rows
                    :max-height max-height
                    :content-width content-width
                    :computed-content-width computed-content-width
                    :auto-content-width? (nil? content-width)
                    :managed-height? managed-height?
                    :stretch-items? stretch-items?
                    :disabled? disabled?
                    :reorderable? reorderable?
                    :reorder-drag-threshold reorder-drag-threshold
                    :reorder-visual-strategy reorder-visual-strategy
                    :item-child item-child
                    :hover-highlight? hover-highlight?
                    :selected-indices selected-indices
                    :multi-select? multi-select?
                    :force-selection? force-selection?
                    :toggle-selected? toggle-selected?})
     :children [(list-box-scroll-pane-for-state
                 {:row-height row-height
                  :computed-row-height computed-row-height
                  :explicit-row-height? explicit-row-height?
                  :content-width content-width
                  :computed-content-width computed-content-width
                  :options options
                  :stretch-items? stretch-items?
                  :disabled? disabled?
                  :reorderable? reorderable?
                  :reorder-drag-threshold reorder-drag-threshold
                  :item-child item-child
                  :hover-highlight? hover-highlight?})]}))
