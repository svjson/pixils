(ns pixils.ui.group-box
  (:require pixils
            [pixils.ui :as ui]))

(defcomponent ui/group-box
  {:class :ui/panel})

(defcomponent ui/group-box-frame
  {})

(defcomponent ui/group-box-body
  {})

(defcomponent ui/group-box-title
  {:children [{:mode 'ui/text
               :state {:value (ui/bind-state :title)}}]})

(defun group-box-title-child [panel-state title-style]
  (when (:title panel-state)
    {:mode 'ui/group-box-title
     :style (or title-style {})
     :state panel-state}))

(defun group-box-children [panel-state frame-style title-style body-style body-state children]
  (let [title-child (group-box-title-child panel-state title-style)]
    (concat [{:mode 'ui/group-box-frame
              :style (or frame-style {})
              :state panel-state
              :children [{:mode 'ui/group-box-body
                          :style (or body-style {})
                          :state (if (nil? body-state)
                                   panel-state
                                   body-state)
                          :children (or children [])}]}]
            (if title-child [title-child] []))))

(defun make [{:keys [title init update on state style class frame-style title-style body-style body-state children]}]
  (let [panel-state (merge (or state {})
                           {:title title})]
    (merge {:mode 'ui/group-box
            :style (or style {})
            :state panel-state
            :children (group-box-children panel-state
                                          frame-style
                                          title-style
                                          body-style
                                          body-state
                                          children)}
           (if class {:class class} {})
           (if init {:init init} {})
           (if update {:update update} {})
           (if on {:on on} {}))))
