(ns pixils.ui.group-box
  (:require pixils
            [pixils.ui :as ui]))

(defcomponent ui/group-box
  {:class :ui/panel})

(defcomponent ui/group-box-frame
  {})

(defcomponent ui/group-box-body
  {})

(defcomponent ui/group-box-title
  {:children [{:mode 'ui/text
               :state {:value (ui/bind-state :title)}}]})

(defun class-map [class]
  (if class {:class class} {}))

(defun group-box-title-child [panel-state title-style title-class]
  (when (:title panel-state)
    (merge {:mode 'ui/group-box-title
            :style (or title-style {})
            :state panel-state}
           (class-map title-class))))

(defun group-box-children [panel-state frame-style frame-class title-style title-class
                           body-style body-class body-state children]
  (let [title-child (group-box-title-child panel-state
                                           title-style
                                           title-class)]
    (concat [(merge {:mode 'ui/group-box-frame
                     :style (or frame-style {})
                     :state panel-state
                     :children [(merge
                                 {:mode 'ui/group-box-body
                                  :style (or body-style {})
                                  :state (if (nil? body-state)
                                           panel-state
                                           body-state)
                                  :children (or children [])}
                                 (class-map body-class))]}
                    (class-map frame-class))]
            (if title-child [title-child] []))))

(defun make [{:keys [title init update on state style class
                     frame-style frame-class title-style title-class
                     body-style body-class body-state children]}]
  (let [panel-state (merge (or state {})
                           {:title title})]
    (merge {:mode 'ui/group-box
            :style (or style {})
            :state panel-state
            :children (group-box-children panel-state
                                          frame-style
                                          frame-class
                                          title-style
                                          title-class
                                          body-style
                                          body-class
                                          body-state
                                          children)}
           (if class {:class class} {})
           (if init {:init init} {})
           (if update {:update update} {})
           (if on {:on on} {}))))
