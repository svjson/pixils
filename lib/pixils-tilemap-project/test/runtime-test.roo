(ns pixils.tilemap.project.runtime-test
  (:require proof.core
            [pixils.tilemap.model :as tilemap]
            [pixils.tilemap.project.model :as model]
            [pixils.tilemap.project.runtime :as runtime]))

(deftest tilemap-pack-projects_selected_map_and_runtime_assets
  (let [document (runtime/tilemap-pack
                  {:format model/project-format
                   :resources {:bundles {:editor-assets {:images {:grid {}}}
                                         :game-assets {:dynamic? true
                                                       :images {:tiles
                                                                {:file-name
                                                                 "tiles.png"}}}}}
                   :tilesets [{:id :game
                               :tiles [{:id :wall
                                        :type :sprite
                                        :source {:x 0 :y 0}}]}]
                   :tile-substitution-rules [{:tileset :game
                                               :tile :floor
                                               :choices [{:tile :floor}
                                                         {:tile :floor-crack}]}]
                   :selected-map :map/cave
                   :maps [{:id :map/overworld
                           :layers []}
                          {:id :map/cave
                           :width 2
                           :height 1
                           :tile-size 16
                           :layers [{:id :scene/level
                                     :tileset :game
                                     :tiles [[:wall nil]]}]}]})]
    (is (= runtime/pack-format (:format document)))
    (is (= runtime/pack-format-version (:version document)))
    (is (= :map/cave (:selected-map document)))
    (is (= [{:id :game
	             :tiles [{:id :wall
	                      :type :sprite
	                      :source {:x 0 :y 0 :w 16 :h 16}}]
	             :tile-size {:w 16 :h 16}}]
	           (:tilesets document)))
    (is (= {:bundles {:game-assets {:images {:tiles
                                             {:file-name "tiles.png"}}}}}
           (:resources document)))
    (is (= :floor-crack
           (get-in document
                   [:tile-substitution-rules 0 :choices 1 :tile])))
    (is (= :scene/level
           (get-in (runtime/selected-runtime-map document)
                   [:layers 0 :id])))))

(deftest render-input-selects_project_map_without_extra_transform
  (let [input (runtime/render-input
               {:format model/project-format
                :tilesets [{:id :game
                            :tiles [{:id :wall}]}]
                :tile-substitution-rules [{:tileset :game
                                            :tile :floor
                                            :choices [{:tile :floor-crack}]}]
                :selected-map :map/main
                :maps [{:id :map/main
                        :width 3
                        :height 2
                        :layers [{:id :scene/level
                                  :tileset :game
                                  :tiles [[:wall nil nil]
                                          [nil nil :wall]]}]}]})]
    (is (= :map/main (get-in input [:tilemap :id])))
    (is (= 3 (get-in input [:tilemap :width])))
    (is (= :scene/level (get-in input [:layers 0 :id])))
    (is (= {:bundles {}}
           (:resources input)))
    (is (= :game (get-in input [:tilesets 0 :id])))
    (is (= :floor-crack
           (get-in input
                   [:tile-substitution-rules 0 :choices 0 :tile])))))

(deftest render-input-is_compatible_with_tilemap_model_lookup
  (let [input (runtime/render-input
               {:format model/project-format
                :tilesets [{:id :game
                            :tiles [{:id :wall}
                                    {:id :gem}]}]
                :maps [{:id :map/main
                        :width 1
                        :height 1
                        :layers [{:id :scene/level
                                  :tileset :game
                                  :tiles [[:gem]]}]}]})
        layer (head (:layers input))]
    (is (= :gem
           (:id (tilemap/layer-cell-tile (:tilesets input)
                                         (:terrain-sets input)
                                         layer
                                         :gem))))))

(deftest tilemap-pack-bakes_property_defaults_into_runtime_tiles
  (let [document (runtime/tilemap-pack
                  {:format model/project-format
                   :property-sets [{:id :movement
                                    :properties [{:id :blocked
                                                  :type :enum
                                                  :values [:yes :no]
                                                  :default :no}
                                                 {:id :cost
                                                  :type :number
                                                  :default 1}]}]
                   :tilesets [{:id :game
                               :property-sets [:movement]
                               :properties {:cost 2}
                               :tiles [{:id :floor}
                                       {:id :wall
                                        :properties {:blocked :yes}}]}]
                   :terrain-sets [{:id :materials
                                   :property-sets [:movement]
                                   :properties {:cost 3}
                                   :terrains [{:id :grass}
                                              {:id :water
                                               :properties {:blocked :yes}}]}]
                   :maps [{:id :map/main
                           :layers []}]})]
    (is (nil? (:property-sets document)))
    (is (= {:blocked :no
            :cost 2}
           (get-in document [:tilesets 0 :tiles 0 :properties])))
    (is (= {:blocked :yes
            :cost 2}
           (get-in document [:tilesets 0 :tiles 1 :properties])))
    (is (= {:blocked :no
            :cost 3}
           (get-in document [:terrain-sets 0 :terrains 0 :properties])))
    (is (= {:blocked :yes
            :cost 3}
           (get-in document [:terrain-sets 0 :terrains 1 :properties])))))
