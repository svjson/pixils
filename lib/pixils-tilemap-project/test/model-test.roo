(ns pixils.tilemap.project.model-test
  (:require proof.core
            [pixils.tilemap.project.model :as data]))

(deftest empty-project-document-does-not-invent-tilesets-or-layers
  (let [document (data/project-document {:tilesets []
                                         :brushes []
                                         :layers []})]
    (is (= [] (:tilesets document)))
    (is (= [] (:brushes document)))
    (is (= [] (:layer-profiles document)))
    (is (= [] (get-in document [:maps 0 :layers])))))

(deftest project-document-saves_only_project_owned_resources
  (let [document (data/project-document
                  {:resources {:bundles {:editor-assets
                                         {:images {:spritesheet
                                                   {:file-name "sprites.png"}}}
                                         :project-assets
                                         {:dynamic? true
                                          :images {:tiles
                                                   {:file-name "tiles.png"
                                                    :name "Tiles"}}}}}})]
    (is (= {:bundles {:project-assets
                      {:images {:tiles
                                {:file-name "tiles.png"
                                 :name "Tiles"}}}}}
           (:resources document)))))

(deftest normalize-project-resources-drops_app_static_bundles
  (is (= {:bundles {:terrain-assets {:images {}}}}
         (data/normalize-project-resources
          {:bundles {:editor-assets {:images {:spritesheet {}}}
                     :terrain-assets {:dynamic? true
                                      :images {}}}}))))

(deftest missing-tileset-has-no-tile-options
  (is (= [] (data/tile-options [] nil)))
  (is (nil? (data/tile-in [] nil 0)))
  (is (nil? (data/tile-id [] nil 0))))

(deftest tile-options-come-from-project-tilesets
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (= [{:value :grass
             :label "Grass"}]
           (data/tile-options tilesets :terrain)))
    (is (= :grass
           (data/tile-id tilesets :terrain 0)))))

(deftest nil-tile-ref-means_no_tile
  (let [tilesets [{:id :terrain
                   :label "Terrain"
                   :tiles [{:id :grass
                            :name "Grass"}]}]]
    (is (nil? (data/tile-in tilesets :terrain nil)))
    (is (nil? (data/tile-id tilesets :terrain nil)))))

(deftest normalize-project-document-adds_sprite_source_dimensions
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :tilesets [{:id :terrain
                               :tile-size 32
                               :tiles [{:id :grass
                                        :type :sprite
                                        :source {:x 8 :y 16}}]}]
                   :tilemap {:layers []}})]
    (is (= {:x 8 :y 16 :w 32 :h 32}
           (get-in document [:tilesets 0 :tiles 0 :source])))))

(deftest normalize-project-document-adds_rectangular_sprite_source_dimensions
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :tilesets [{:id :terrain
                               :tile-size {:w 22 :h 18}
                               :tiles [{:id :grass
                                        :type :sprite
                                        :source {:x 8 :y 16}}]}]
                   :tilemap {:layers []}})]
    (is (= {:x 8 :y 16 :w 22 :h 18}
           (get-in document [:tilesets 0 :tiles 0 :source])))))

(deftest project-document-saves_property_sets
  (let [document (data/project-document
                  {:property-sets [{:id :movement
                                    :label "Movement"
                                    :properties [{:id :walkable
                                                  :label "Walkable"
                                                  :type :enum
                                                  :values [:yes :no]
                                                  :default :yes}
                                                 {:id :cost
                                                  :label "Cost"
                                                  :type :number
                                                  :default 1}]}]
                   :tilesets []
                   :terrain-sets []
                   :rulesets []
                   :layers []
                   :maps []})]
    (is (= [{:id :movement
             :label "Movement"
             :properties [{:id :walkable
                           :label "Walkable"
                           :type :enum
                           :values [:yes :no]
                           :default :yes}
                          {:id :cost
                           :label "Cost"
                           :type :number
                           :default 1}]}]
           (:property-sets document)))))

(deftest project-document-saves_target_property_values_as_properties
  (let [document (data/project-document
                  {:property-sets []
                   :tilesets [{:id :terrain
                               :property-sets [:movement]
                               :properties {:cost 2}
                               :tiles [{:id :grass
                                        :properties {:walkable :yes}}]}]
                   :terrain-sets [{:id :overworld
                                   :property-sets [:movement]
                                   :properties {:cost 3}
                                   :terrains [{:id :grass
                                               :properties {:walkable :no}}]}]
                   :rulesets []
                   :layers []
                   :maps []})]
    (is (= {:cost 2}
           (get-in document [:tilesets 0 :properties])))
    (is (= {:walkable :yes}
           (get-in document [:tilesets 0 :tiles 0 :properties])))
    (is (= {:cost 3}
           (get-in document [:terrain-sets 0 :properties])))
    (is (= {:walkable :no}
           (get-in document [:terrain-sets 0 :terrains 0 :properties])))))

(deftest effective-property-values-use_set_defaults_target_defaults_and_overrides
  (let [property-sets [{:id :movement
                        :properties [{:id :walkable
                                      :type :enum
                                      :values [:yes :no]
                                      :default :yes}
                                     {:id :cost
                                      :type :number
                                      :default 1}]}]]
    (is (= {:walkable :no
            :cost 3}
           (data/effective-property-values property-sets
                                           [:movement]
                                           {:cost 3}
                                           {:walkable :no})))
    (is (= {}
           (data/sparse-property-values property-sets
                                        [:movement]
                                        {:walkable :yes
                                         :cost 3}
                                        {:walkable :yes
                                         :cost 3})))))

(deftest project-document-saves_map_tile_size
  (let [document (data/project-document
                  {:map-width 2
                   :map-height 1
                   :tile-size 32
                   :layers []})]
    (is (= {:w 32 :h 32} (get-in document [:maps 0 :tile-size])))))

(deftest normalize-project-document-normalizes_ruleset_stamp_nil_cells
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :rulesets [{:id :overworld-rules
                               :rules [{:id :rule
                                        :output {:layers [{:id :stamp
                                                          :tileset :terrain
                                                          :tiles [[nil
                                                                   :grass]]}]}}]}]
                   :layer-profiles [{:id :default
                                     :layers [{:id :scene/terrain
                                               :role :source
                                               :data-kind :tile-ref
                                               :tileset :terrain}]}]
                   :tilemap {:layers []}})]
    (is (= nil
           (get-in document
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles 0 0])))))

(deftest normalize-project-document-trims_stamp_output_to_terrain_unit
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :terrain-sets [{:id :overworld
                                   :terrains [{:id :grass}]}]
                   :rulesets [{:id :overworld-rules
                               :kind :terrain-stamp
                               :terrain-set :overworld
                               :rules [{:id :rule
                                        :terrain :grass
                                        :output {:anchor {:x 1 :y 1}
                                                 :layers
                                                 [{:id :stamp
                                                   :tileset :terrain
                                                   :tiles [[:a :b :c]
                                                           [:d :e :f]
                                                           [:g :h :i]]
                                                   :terrain-signatures
                                                   [[{:center :a}
                                                     {:center :b}
                                                     {:center :c}]
                                                    [{:center :d}
                                                     {:center :e}
                                                     {:center :f}]
                                                    [{:center :g}
                                                     {:center :h}
                                                     {:center :i}]]}]}}]}]
                   :tilemap {:layers []}})]
    (is (= {:x 0 :y 0}
           (get-in document [:rulesets 0 :rules 0 :output :anchor])))
    (is (= [[:e]]
           (get-in document [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[{:center :e}]]
           (get-in document
                   [:rulesets
                    0
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures])))))

(deftest normalize-project-document-preserves_populated_single_cell_with_stale_anchor
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :terrain-sets [{:id :overworld
                                   :terrains [{:id :grass}]}]
                   :rulesets [{:id :overworld-rules
                               :kind :terrain-stamp
                               :terrain-set :overworld
                               :rules [{:id :rule
                                        :terrain :grass
                                        :output {:anchor {:x 0 :y 0}
                                                 :layers
                                                 [{:id :stamp
                                                   :tileset :terrain
                                                   :tiles [[nil nil nil]
                                                           [nil :shore nil]
                                                           [nil nil nil]]
                                                   :terrain-signatures
                                                   [[nil nil nil]
                                                    [nil {:center :grass} nil]
                                                    [nil nil nil]]}]}}]}]
                   :tilemap {:layers []}})]
    (is (= {:x 0 :y 0}
           (get-in document [:rulesets 0 :rules 0 :output :anchor])))
    (is (= [[:shore]]
           (get-in document [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[{:center :grass}]]
           (get-in document
                   [:rulesets
                    0
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures])))))

(deftest normalize-project-document-trims_stamp_output_to_two_by_two_unit
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :terrain-sets [{:id :mountains
                                   :terrain-unit {:w 2 :h 2}
                                   :terrains [{:id :mountain}]}]
                   :rulesets [{:id :mountain-rules
                               :kind :terrain-stamp
                               :terrain-set :mountains
                               :rules [{:id :rule
                                        :terrain :mountain
                                        :output {:anchor {:x 1 :y 1}
                                                 :layers
                                                 [{:id :stamp
                                                   :tileset :mountains
                                                   :tiles [[:a :b :c]
                                                           [:d :e :f]
                                                           [:g :h :i]]
                                                   :terrain-signatures
                                                   [[{:center :a}
                                                     {:center :b}
                                                     {:center :c}]
                                                    [{:center :d}
                                                     {:center :e}
                                                     {:center :f}]
                                                    [{:center :g}
                                                     {:center :h}
                                                     {:center :i}]]}]}}]}]
                   :tilemap {:layers []}})]
    (is (= {:x 0 :y 0}
           (get-in document [:rulesets 0 :rules 0 :output :anchor])))
    (is (= [[:e :f]
            [:h :i]]
           (get-in document [:rulesets 0 :rules 0 :output :layers 0 :tiles])))
    (is (= [[{:center :e} {:center :f}]
            [{:center :h} {:center :i}]]
           (get-in document
                   [:rulesets
                    0
                    :rules
                    0
                    :output
                    :layers
                    0
                    :terrain-signatures])))))

(deftest terrain-options-come-from_project_terrain_sets
  (let [terrain-sets [{:id :overworld
                       :label "Overworld"
                       :tileset :terrain
                       :terrains [{:id :grass
                                   :label "Grass"
                                   :tile :grass}
                                  {:id :water
                                   :label "Water"
                                   :tile :water}]}]]
    (is (= [{:value :grass
             :label "Grass"}
            {:value :water
             :label "Water"}]
           (data/terrain-options terrain-sets :overworld)))
    (is (= :grass
           (data/terrain-id terrain-sets :overworld 0)))))

(deftest terrain-preview-resolves_to_tileset_tile
  (let [tilesets [{:id :terrain
                   :tiles [{:id :grass
                            :name "Grass"
                            :type :color}]}]
        terrain-sets [{:id :overworld
                       :tileset :terrain
                       :terrains [{:id :grass
                                   :label "Grass"
                                   :tile :grass}]}]]
    (is (= :grass
           (:id (data/terrain-tile-in tilesets
                                      terrain-sets
                                      :overworld
                                      :grass))))))

(deftest default-project-layered-map-is-empty
  (is (= [] (data/make-layered-map))))

(deftest empty-map-uses-project-dimensions
  (let [tilemap (data/make-empty-map)]
    (is (= data/map-height (count tilemap)))
    (is (= data/map-width (count (head tilemap))))
    (is (= nil (get-in tilemap [0 0])))))

(deftest normalize-layer-adds_source_tile_ref_defaults
  (let [layer (data/normalize-layer {:id :scene/ground
                                     :label "Ground"
                                     :tileset :terrain
                                     :tiles [[:grass nil]]})]
    (is (= :tile (:kind layer)))
    (is (= :source (:role layer)))
    (is (= :tile-ref (:data-kind layer)))
    (is (= [[:grass nil]] (:tiles layer)))))

(deftest project-document-creates_default_layer_profile_from_layers
  (let [document (data/project-document
                  {:tilesets []
                   :brushes []
                   :layers [{:id :scene/ground
                             :label "Ground"
                             :kind :tile
                             :tileset :terrain
                             :tiles [[:grass nil]]}]})]
    (is (= data/default-map-id (:selected-map document)))
    (is (= data/default-layer-profile-id
           (get-in document [:maps 0 :layer-profile])))
    (is (= [{:id data/default-layer-profile-id
             :label data/default-layer-profile-label
             :layers [{:id :scene/ground
                       :label "Ground"
                       :kind :tile
                       :tileset :terrain
                       :role :source
                       :data-kind :tile-ref}]}]
           (:layer-profiles document)))))

(deftest project-document-saves_current_map_dimensions
  (let [document (data/project-document
                  {:selected-map-id :map/overworld
                   :selected-map-label "Overworld"
                   :map-width 96
                   :map-height 64
                   :tilesets []
                   :brushes []
                   :layers []})]
    (is (= :map/overworld (:selected-map document)))
    (is (= :map/overworld (get-in document [:maps 0 :id])))
    (is (= "Overworld" (get-in document [:maps 0 :label])))
    (is (= 96 (get-in document [:maps 0 :width])))
    (is (= 64 (get-in document [:maps 0 :height])))))

(deftest normalize-project-document-selects_one_map_from_multi_map_document
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :selected-map :map/cave
                   :maps [{:id :map/overworld
                           :label "Overworld"
                           :width 40
                           :height 28
                           :layers []}
                          {:id :map/cave
                           :label "Cave"
                           :width 12
                           :height 9
                           :layers [{:id :scene/cave
                                     :tileset :terrain
                                     :tiles [[:rock]]}]}]})]
    (is (= :map/cave (:selected-map document)))
    (is (= 2 (count (:maps document))))
    (is (= 12 (get-in document [:maps 1 :width])))
    (is (= :scene/cave
           (get-in document [:maps 1 :layers 0 :id])))))

(deftest project-document-saves_terrain_sets
  (let [document (data/project-document
                  {:terrain-sets [{:id :overworld
                                   :terrains [{:id :grass
                                               :tile :grass}]}]
                   :layers []})]
    (is (= [{:id :overworld
             :terrains [{:id :grass
                         :tile :grass}]}]
           (:terrain-sets document)))))

(deftest project-document-saves_terrain_semantic_setup_visibility
  (let [document (data/project-document
                  {:terrain-sets [{:id :overworld
                                   :terrains [{:id :grass
                                               :visible-terrain-standard-setups
                                               [:island-3x3]}]}]
                   :layers []})]
    (is (= [:island-3x3]
           (get-in document
                   [:terrain-sets 0 :terrains 0
                    :visible-terrain-standard-setups])))))

(deftest project-document-saves_rulesets
  (let [document (data/project-document
                  {:rulesets [{:id :grass-marching
                               :kind :marching-4
                               :rules [{:id :grass-edge
                                        :terrain :grass
                                        :exclusive? true}]}]
                   :layers []})]
    (is (= [{:id :grass-marching
             :kind :marching-4
             :rules [{:id :grass-edge
                      :terrain :grass
                      :exclusive? true}]}]
           (:rulesets document)))))

(deftest normalize-project-document-preserves_ruleset_exclusive_flag
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :rulesets [{:id :overworld-rules
                               :kind :terrain-stamp
                               :rules [{:id :rule
                                        :terrain :grass
                                        :exclusive? true}]}]
                   :tilemap {:layers []}})]
    (is (= true
           (get-in document [:rulesets 0 :rules 0 :exclusive?])))))

(deftest selected-layer-profile-id-falls_back_to_existing_profile
  (is (= :overworld
         (data/selected-layer-profile-id [{:id :overworld}]
                                         :missing))))

(deftest normalize-project-document-defaults_legacy_layers_to_profile
  (let [document (data/normalize-project-document
                  {:format data/project-format
                   :tilemap {:layers [{:id :scene/ground
                                       :label "Ground"
                                       :tileset :terrain
                                       :tiles [[:grass nil]]}]}})]
    (is (= data/default-map-id
           (:selected-map document)))
    (is (= data/default-layer-profile-id
           (get-in document [:maps 0 :layer-profile])))
    (is (= :source
           (get-in document [:maps 0 :layers 0 :role])))
    (is (= :tile-ref
           (get-in document [:maps 0 :layers 0 :data-kind])))
    (is (= :scene/ground
           (get-in document [:layer-profiles 0 :layers 0 :id])))))

(deftest normalize-project-document-normalizes_brush_pattern_layers
  (let [document (data/normalize-project-document
                  {:brushes [{:id :brush
                              :kind :pattern
                              :pattern {:layers [{:id :stamp
                                                   :tileset :terrain
                                                   :tiles [[:grass nil]]}]}}]
                   :layer-profiles [{:id :default
                                     :layers [{:id :scene/terrain
                                               :role :source
                                               :data-kind :tile-ref
                                               :tileset :terrain}]}]
                   :tilemap {:layers []}})]
    (is (= [[:grass nil]]
           (get-in document
                   [:brushes 0 :pattern :layers 0 :tiles])))
    (is (= :scene/terrain
           (get-in document
                   [:brushes 0 :pattern :layers 0 :target-layer])))))

(deftest normalize-project-document-does_not_assign_ruleset_output_targets
  (let [document (data/normalize-project-document
                  {:rulesets [{:id :terrain-rules
                               :kind :terrain-stamp
                               :terrain-set :world
                               :rules [{:id :edge
                                        :terrain :grass
                                        :match {:n :none}
                                        :output {:layers [{:id :layer
                                                          :tileset :terrain
                                                          :tiles [[:shore]]}]}}]}]
                   :layer-profiles [{:id :default
                                     :layers [{:id :scene/water
                                               :role :source
                                               :data-kind :tile-ref
                                               :tileset :terrain}
                                              {:id :scene/terrain
                                               :role :source
                                               :data-kind :terrain
                                               :terrain-set :world}]}]
                   :tilemap {:layers []}})]
    (is (nil? (get-in document
                      [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))))

(deftest normalize-project-document-normalizes_ruleset_serialized_nil_metadata
  (let [document (data/normalize-project-document
                  {:rulesets [{:id :terrain-rules
                               :kind :terrain-stamp
                               :terrain-set :world
                               :source-layer 'nil
                               :rules [{:id :edge
                                        :terrain :grass
                                        :match {:n :same}
                                        :output {:layers [{:id :layer
                                                          :target-layer 'nil
                                                          :tiles [[nil]]}]}}]}]
                   :layer-profiles [{:id :default
                                     :layers [{:id :scene/terrain
                                               :data-kind :terrain
                                               :terrain-set :world}]}]
                   :tilemap {:layers []}})]
    (is (nil? (get-in document [:rulesets 0 :source-layer])))
    (is (nil? (get-in document
                      [:rulesets 0 :rules 0 :output :layers 0 :target-layer])))
    (is (= [[nil]]
           (get-in document
                   [:rulesets 0 :rules 0 :output :layers 0 :tiles])))))
