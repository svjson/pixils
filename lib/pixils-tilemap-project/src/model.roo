(ns pixils.tilemap.project.model
  (:require [pixils.tilemap.model :as tilemap]))

(def tile-size 16)
(def tile-dim {:w tile-size :h tile-size})
(def map-width 40)
(def map-height 28)
(def default-map-id :map/main)
(def default-map-label "Map 1")
(def min-map-dimension 1)
(def max-map-dimension 4096)

(def project-format :pixils.tilemap-editor/project)
(def project-format-version 1)

(def project-resources
  {:bundles {}})

(def project-brushes [])
(def project-terrain-sets [])
(def project-property-sets [])
(def project-rulesets [])
(def project-tile-substitution-rules [])

(def default-tile-substitution-algorithm :weighted-random)
(def default-layer-profile-id :default)
(def default-layer-profile-label "Default")

(def app-static-bundle-ids [:editor-assets])

(def property-type-options tilemap/property-type-options)

(def default-property-type tilemap/default-property-type)

(defun app-static-bundle-id? [bundle-id]
  (contains? app-static-bundle-ids bundle-id))

(defun project-resource-bundle? [bundle-id]
  (not (app-static-bundle-id? bundle-id)))

(defun project-resource-bundle-document [bundle]
  (dissoc (or bundle {}) :dynamic?))

(defun normalize-project-resources [resources]
  {:bundles (reduce-kv (or (:bundles resources) {})
                       {}
                       (fn [result bundle-id bundle]
                         (if (project-resource-bundle? bundle-id)
                           (assoc result
                                  bundle-id
                                  (project-resource-bundle-document bundle))
                           result)))})

(defun tileset-options [tilesets]
  (for-indexed [index tileset (or tilesets [])]
    {:value index
     :label (:label tileset)}))

(defun tileset-key [tilesets index]
  (let [items (or tilesets [])]
    (when (> (count items) 0)
      (:id (nth items (or index 0))))))

(defun tileset-index [tilesets tileset]
  (let [match (find-index (or tilesets [])
                          (fn [item]
                            (= (:id item) tileset)))]
    (or match 0)))

(defun tileset-definition [tilesets tileset]
  (head (filter (or tilesets [])
                (fn [item]
                  (= (:id item) tileset)))))

(defun tileset-label [tilesets tileset]
  (let [items (or tilesets [])]
    (if (> (count items) 0)
      (or (:label (nth items (tileset-index tilesets tileset))) "")
      "")))

(defun tileset-tiles [tilesets tileset]
  (or (:tiles (tileset-definition tilesets tileset)) []))

(defun bounded-dimension [value default-value]
  (max min-map-dimension
       (min max-map-dimension (or value default-value))))

(defun map-tile-dim [value]
  (if (= (type-of value) "map")
    {:w (bounded-dimension (:w value) tile-size)
     :h (bounded-dimension (:h value) tile-size)}
    (let [size (bounded-dimension value tile-size)]
      {:w size :h size})))

(defun map-tile-size [value]
  (map-tile-dim value))

(defun default-tile-source [tile-size]
  (let [tile-dim (map-tile-dim tile-size)]
    {:x 0
     :y 0
     :w (:w tile-dim)
     :h (:h tile-dim)}))

(defun normalize-sprite-source [source source-size]
  (let [source-size (map-tile-dim source-size)
        source (merge (default-tile-source source-size)
                      (or source {}))]
    (assoc source
           :w (or (:w source) (:w source-size))
           :h (or (:h source) (:h source-size)))))

(defun normalize-tileset-tile [tile tile-size]
  (if (= (:type tile) :sprite)
    (assoc tile :source (normalize-sprite-source (:source tile) tile-size))
    tile))

(defun normalize-tileset [tileset]
  (let [tile-size (map-tile-dim (:tile-size tileset))]
    (assoc tileset
           :tile-size tile-size
           :tiles (map (or (:tiles tileset) [])
                       (fn [tile]
                         (normalize-tileset-tile tile tile-size))))))

(defun normalize-tilesets [tilesets]
  (map (or tilesets []) normalize-tileset))

(defun normalize-terrain [terrain]
  terrain)

(defun normalize-terrain-set [terrain-set]
  (assoc terrain-set
         :terrains (map (or (:terrains terrain-set) [])
                        normalize-terrain)))

(defun normalize-terrain-sets [terrain-sets]
  (map (or terrain-sets []) normalize-terrain-set))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun property-type [property]
  (tilemap/property-type property))

(defun first-enum-value [property]
  (tilemap/first-enum-value property))

(defun normalize-number-property-value [value property]
  (tilemap/normalize-number-property-value value property))

(defun normalize-enum-property-value [value property]
  (tilemap/normalize-enum-property-value value property))

(defun normalize-property-value [value property]
  (tilemap/normalize-property-value value property))

(defun property-default-value [property]
  (tilemap/property-default-value property))

(defun normalize-property-definition [property]
  (let [id (or (:id property)
               (keyword (kebab-case (or (:label property) "property"))))
        type (property-type property)
        property (assoc property
                        :id id
                        :label (or (:label property)
                                   (:name property)
                                   (keyword-label id))
                        :type type)
        property (if (= type :enum)
                   (assoc property :values (or (:values property) []))
                   property)]
    (if (contains? property :default)
      (assoc property :default (property-default-value property))
      property)))

(defun normalize-property-set [property-set]
  (let [id (or (:id property-set)
               (keyword (kebab-case (or (:label property-set)
                                         "property-set"))))]
    (assoc property-set
           :id id
           :label (or (:label property-set)
                      (:name property-set)
                      (keyword-label id))
           :properties (map (or (:properties property-set) [])
                            normalize-property-definition))))

(defun normalize-property-sets [property-sets]
  (map (or property-sets []) normalize-property-set))

(defun property-set-definition [property-sets property-set-id]
  (tilemap/property-set-definition property-sets property-set-id))

(defun property-set-definitions [property-sets property-set-ids]
  (tilemap/property-set-definitions property-sets property-set-ids))

(defun property-definitions [property-sets property-set-ids]
  (tilemap/property-definitions property-sets property-set-ids))

(defun property-definition-by-id [property-sets property-set-ids property-id]
  (tilemap/property-definition-by-id property-sets property-set-ids property-id))

(defun property-set-default-values [property-sets property-set-ids]
  (tilemap/property-set-default-values property-sets property-set-ids))

(defun normalize-property-values [property-sets property-set-ids values]
  (tilemap/normalize-property-values property-sets property-set-ids values))

(defun effective-property-values [property-sets property-set-ids default-values overrides]
  (tilemap/effective-property-values property-sets
                                     property-set-ids
                                     default-values
                                     overrides))

(defun sparse-property-values [property-sets property-set-ids baseline values]
  (let [values (normalize-property-values property-sets property-set-ids values)
        baseline (effective-property-values property-sets
                                            property-set-ids
                                            baseline
                                            {})]
    (reduce-kv values
               {}
               (fn [result property-id value]
                 (if (= value (get baseline property-id))
                   result
                   (assoc result property-id value))))))

(defun tile-count [tilesets tileset]
  (count (tileset-tiles tilesets tileset)))

(defun clamp-tile-index [tilesets tileset index]
  (let [count (tile-count tilesets tileset)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun serialized-nil? [value]
  (and (= (type-of value) "symbol")
       (= (str value) "nil")))

(defun absent-tile-ref? [tile-ref]
  (or (nil? tile-ref)
      (serialized-nil? tile-ref)))

(defun tile-index [tilesets tileset tile-ref]
  (if (keyword? tile-ref)
    (let [match (find-index (tileset-tiles tilesets tileset)
                            (fn [tile]
                              (= (:id tile) tile-ref)))]
      (or match 0))
    (clamp-tile-index tilesets tileset tile-ref)))

(defun tile-id [tilesets tileset tile-ref]
  (when (not (absent-tile-ref? tile-ref))
    (let [tiles (tileset-tiles tilesets tileset)]
      (when (> (count tiles) 0)
        (:id (nth tiles (tile-index tilesets tileset tile-ref)))))))

(defun tile-options [tilesets tileset]
  (for-indexed [index tile (tileset-tiles tilesets tileset)]
    {:value (:id tile)
     :label (:name tile)}))

(defun tile-in [tilesets tileset tile-ref]
  (when (not (absent-tile-ref? tile-ref))
    (let [tiles (tileset-tiles tilesets tileset)]
      (when (> (count tiles) 0)
        (nth tiles (tile-index tilesets tileset tile-ref))))))

(defun tile-label [tilesets tileset tile-ref]
  (let [tile (tile-in tilesets tileset tile-ref)]
    (if tile
      (str "Selected: " (:name tile) " (" (:type tile) ")")
      "")))

(defun terrain-set-options [terrain-sets]
  (for-indexed [index terrain-set (or terrain-sets [])]
    {:value index
     :label (or (:label terrain-set) (:name terrain-set) (str (:id terrain-set)))}))

(defun terrain-set-key [terrain-sets index]
  (let [items (or terrain-sets [])]
    (when (> (count items) 0)
      (:id (nth items (or index 0))))))

(defun terrain-set-index [terrain-sets terrain-set]
  (let [match (find-index (or terrain-sets [])
                          (fn [item]
                            (= (:id item) terrain-set)))]
    (or match 0)))

(defun terrain-set-definition [terrain-sets terrain-set]
  (head (filter (or terrain-sets [])
                (fn [item]
                  (= (:id item) terrain-set)))))

(def default-terrain-unit {:w 1 :h 1})

(defun terrain-unit [definition]
  (let [unit (or (:terrain-unit definition)
                 (when (or (:w definition) (:h definition))
                   definition)
                 default-terrain-unit)]
    {:w (max 1 (or (:w unit) 1))
     :h (max 1 (or (:h unit) 1))}))

(defun terrain-unit-for-set [terrain-sets terrain-set]
  (terrain-unit (terrain-set-definition terrain-sets terrain-set)))

(defun terrain-definitions [terrain-sets terrain-set]
  (or (:terrains (terrain-set-definition terrain-sets terrain-set)) []))

(defun terrain-count [terrain-sets terrain-set]
  (count (terrain-definitions terrain-sets terrain-set)))

(defun clamp-terrain-index [terrain-sets terrain-set index]
  (let [count (terrain-count terrain-sets terrain-set)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun terrain-index [terrain-sets terrain-set terrain-ref]
  (if (keyword? terrain-ref)
    (let [match (find-index (terrain-definitions terrain-sets terrain-set)
                            (fn [terrain]
                              (= (:id terrain) terrain-ref)))]
      (or match 0))
    (clamp-terrain-index terrain-sets terrain-set terrain-ref)))

(defun terrain-id [terrain-sets terrain-set terrain-ref]
  (let [terrains (terrain-definitions terrain-sets terrain-set)]
    (when (> (count terrains) 0)
      (:id (nth terrains (terrain-index terrain-sets terrain-set terrain-ref))))))

(defun terrain-in [terrain-sets terrain-set terrain-ref]
  (let [terrains (terrain-definitions terrain-sets terrain-set)]
    (when (> (count terrains) 0)
      (nth terrains (terrain-index terrain-sets terrain-set terrain-ref)))))

(defun terrain-options [terrain-sets terrain-set]
  (for-indexed [index terrain (terrain-definitions terrain-sets terrain-set)]
    {:value (:id terrain)
     :label (or (:label terrain) (:name terrain) (str (:id terrain)))}))

(defun terrain-preview-tileset [terrain-set terrain]
  (or (:tileset terrain)
      (:tileset terrain-set)))

(defun terrain-preview-tile [terrain]
  (or (:tile terrain)
      (:preview-tile terrain)
      (:preview terrain)))

(defun terrain-tile-in [tilesets terrain-sets terrain-set terrain-ref]
  (let [terrain-set-definition (terrain-set-definition terrain-sets terrain-set)
        terrain (terrain-in terrain-sets terrain-set terrain-ref)]
    (when terrain
      (tile-in tilesets
               (terrain-preview-tileset terrain-set-definition terrain)
               (terrain-preview-tile terrain)))))

(defun terrain-label [terrain-sets terrain-set terrain-ref]
  (let [terrain (terrain-in terrain-sets terrain-set terrain-ref)]
    (if terrain
      (str "Selected: "
           (or (:label terrain) (:name terrain) (str (:id terrain)))
           " (terrain)")
      "")))

(defun source-layer-value-id [tilesets terrain-sets layer value]
  (if (= (:data-kind layer) :terrain)
    (terrain-id terrain-sets (:terrain-set layer) value)
    (tile-id tilesets (:tileset layer) value)))

(defun source-layer-value-label [tilesets terrain-sets layer value]
  (if (= (:data-kind layer) :terrain)
    (terrain-label terrain-sets (:terrain-set layer) value)
    (tile-label tilesets (:tileset layer) value)))

(defun map-dimension [value default-value]
  (max min-map-dimension
       (min max-map-dimension (or value default-value))))

(defun make-empty-row-for [width]
  (dotimes [x (map-dimension width map-width)]
    nil))

(defun make-empty-row []
  (make-empty-row-for map-width))

(defun make-empty-map-for [width height]
  (dotimes [y (map-dimension height map-height)]
    (make-empty-row-for width)))

(defun make-empty-map []
  (make-empty-map-for map-width map-height))

(defun make-layered-map []
  [])

(defun normalize-tile-ref [tile-ref]
  (if (serialized-nil? tile-ref)
    nil
    tile-ref))

(defun normalize-tile-row [row]
  (map row normalize-tile-ref))

(defun normalize-layer-tiles [layer]
  (update layer :tiles (fn [tiles]
                         (map (or tiles [])
                              normalize-tile-row))))

(defun normalize-layer [layer]
  (assoc (normalize-layer-tiles layer)
         :kind (or (:kind layer) :tile)
         :role (or (:role layer) :source)
         :data-kind (or (:data-kind layer) :tile-ref)))

(defun normalize-layers [layers]
  (map (or layers []) normalize-layer))

(defun layer-profile-layer-definition [layer]
  (dissoc (assoc (or layer {})
                 :kind (or (:kind layer) :tile)
                 :role (or (:role layer) :source)
                 :data-kind (or (:data-kind layer) :tile-ref))
          :tiles))

(defun source-layer-definitions [layers]
  (map (filter (or layers [])
               (fn [layer]
                 (not= (:role layer) :derived)))
       layer-profile-layer-definition))

(defun normalize-layer-profile-layer [layer]
  (layer-profile-layer-definition layer))

(defun normalize-layer-profile [profile]
  (assoc (or profile {})
         :id (or (:id profile) default-layer-profile-id)
         :label (or (:label profile) default-layer-profile-label)
         :layers (map (or (:layers profile) [])
                      normalize-layer-profile-layer)))

(defun normalize-layer-profiles [profiles]
  (map (or profiles []) normalize-layer-profile))

(defun default-layer-profile [layers]
  {:id default-layer-profile-id
   :label default-layer-profile-label
   :layers (source-layer-definitions layers)})

(defun default-layer-profiles [layers]
  (if (empty? (or layers []))
    []
    [(default-layer-profile layers)]))

(defun first-layer-profile-id [profiles]
  (:id (head (or profiles []))))

(defun layer-profile-id-exists? [profiles profile-id]
  (> (count (filter (or profiles [])
                    (fn [profile]
                      (= (:id profile) profile-id))))
     0))

(defun selected-layer-profile-id [profiles requested-id]
  (if (layer-profile-id-exists? profiles requested-id)
    requested-id
    (first-layer-profile-id profiles)))

(defun derived-layer-definition? [layer]
  (= (:role layer) :derived))

(defun layer-profile-derived-layers [profile]
  (filter (or (:layers profile) []) derived-layer-definition?))

(defun layer-profile-by-id [profiles profile-id]
  (or (head (filter (or profiles [])
                    (fn [profile]
                      (= (:id profile) profile-id))))
      (head (or profiles []))))

(defun layer-profile-layer-by-id [profile layer-id]
  (head (filter (or (:layers profile) [])
                (fn [layer]
                  (= (:id layer) layer-id)))))

(defun layer-profile-layer-by-tileset [profile tileset]
  (head (filter (or (:layers profile) [])
                (fn [layer]
                  (= (:tileset layer) tileset)))))

(defun target-layer-for-tileset [profile tileset]
  (:id (layer-profile-layer-by-tileset profile tileset)))

(defun tileset-for-target-layer [profile target-layer]
  (:tileset (layer-profile-layer-by-id profile target-layer)))

(defun sync-layer-profile [profile layers]
  (assoc profile
         :layers
         (concat (source-layer-definitions layers)
                 (layer-profile-derived-layers profile))))

(defun sync-layer-profiles [profiles profile-id layers]
  (let [profiles (normalize-layer-profiles profiles)
        profile-id (selected-layer-profile-id profiles profile-id)]
    (cond
      (empty? profiles) (default-layer-profiles layers)
      (nil? profile-id) profiles
      :default (map profiles
                    (fn [profile]
                      (if (= (:id profile) profile-id)
                        (sync-layer-profile profile layers)
                        profile))))))

(defun normalize-pattern-layer-target [profile layer]
  (let [target-layer (:target-layer layer)
        tileset (:tileset layer)
        profile-tileset (tileset-for-target-layer profile target-layer)
        profile-target-layer (target-layer-for-tileset profile tileset)
        layer (normalize-layer-tiles layer)
        layer (if profile-tileset
                (assoc layer :tileset profile-tileset)
                layer)]
    (if (and (nil? target-layer) profile-target-layer)
      (assoc layer :target-layer profile-target-layer)
      layer)))

(defun normalize-brush-value [value profile]
  (case (type-of value)
    "vector" (map value (fn [item]
                          (normalize-brush-value item profile)))
    "map" (let [normalized (if (and (:tiles value)
                                    (or (:tileset value)
                                        (:target-layer value)))
                             (normalize-pattern-layer-target profile value)
                             value)]
            (reduce-kv normalized
                       {}
                       (fn [result key item]
                         (assoc result
                                key
                                (normalize-brush-value item profile)))))
    :default (if (serialized-nil? value)
               nil
               value)))

(defun normalize-brushes [brushes profile]
  (normalize-brush-value (or brushes []) profile))

(defun normalize-ruleset-value [value]
  (case (type-of value)
    "vector" (map value normalize-ruleset-value)
    "map" (reduce-kv value
                     {}
                     (fn [result key item]
                       (assoc result key (normalize-ruleset-value item))))
    :default (if (serialized-nil? value)
               nil
               value)))

(defun terrain-unit-output-anchor [unit]
  {:x 0 :y 0})

(defun matrix-cell [matrix x y]
  (nth (or (nth (or matrix []) y) []) x))

(defun terrain-unit-single-cell? [unit]
  (and (= (:w unit) 1)
       (= (:h unit) 1)))

(defun first-populated-matrix-position [matrix]
  (head (apply concat
               (for-indexed [y row (or matrix [])]
                 (filter (for-indexed [x value (or row [])]
                           {:x x
                            :y y
                            :value value})
                         (fn [entry]
                           (not (nil? (:value entry)))))))))

(defun normalize-stamp-layer-anchor [layer old-anchor unit]
  (let [anchor (terrain-unit-output-anchor unit)]
    (if (terrain-unit-single-cell? unit)
      (cond
        (not (nil? (matrix-cell (:tiles layer) (:x old-anchor) (:y old-anchor))))
        old-anchor

        (not (nil? (matrix-cell (:tiles layer) (:x anchor) (:y anchor))))
        anchor

        :default
        (or (first-populated-matrix-position (:tiles layer))
            old-anchor))
      old-anchor)))

(defun normalize-stamp-matrix [matrix old-anchor unit]
  (dotimes [y (:h unit)]
    (dotimes [x (:w unit)]
      (matrix-cell matrix
                   (+ (:x old-anchor) x)
                   (+ (:y old-anchor) y)))))

(defun normalize-output-layer-stamp [layer old-anchor unit]
  (let [old-anchor (normalize-stamp-layer-anchor layer old-anchor unit)
        layer (if (:tiles layer)
                (assoc layer
                       :tiles
                       (normalize-stamp-matrix (:tiles layer)
                                               old-anchor
                                               unit))
                layer)]
    (if (:terrain-signatures layer)
      (assoc layer
             :terrain-signatures
             (normalize-stamp-matrix (:terrain-signatures layer)
                                     old-anchor
                                     unit))
      layer)))

(defun normalize-rule-stamp-output [rule unit]
  (let [output (or (:output rule) {})
        old-anchor (or (:anchor output)
                       (terrain-unit-output-anchor unit))
        anchor (terrain-unit-output-anchor unit)]
    (assoc rule
           :output
           (assoc output
                  :anchor anchor
                  :layers
                  (map (or (:layers output) [])
                       (fn [layer]
                         (normalize-output-layer-stamp layer
                                                       old-anchor
                                                       unit)))))))

(defun normalize-terrain-stamp-ruleset [terrain-sets ruleset]
  (let [terrain-set (terrain-set-definition terrain-sets (:terrain-set ruleset))]
    (if (and (= (:kind ruleset) :terrain-stamp)
             terrain-set)
      (let [unit (terrain-unit terrain-set)]
        (assoc ruleset
               :rules
               (map (or (:rules ruleset) [])
                    (fn [rule]
                      (normalize-rule-stamp-output rule unit)))))
      ruleset)))

(defun normalize-rulesets [rulesets profile terrain-sets]
  (let [rulesets (normalize-ruleset-value (or rulesets []))]
    (map rulesets
         (fn [ruleset]
           (normalize-terrain-stamp-ruleset terrain-sets ruleset)))))

(defun normalize-tile-substitution-rule [rule]
  (assoc rule
         :algorithm
         (or (:algorithm rule) default-tile-substitution-algorithm)))

(defun normalize-tile-substitution-rules [rules]
  (map (normalize-ruleset-value (or rules []))
       normalize-tile-substitution-rule))

(defun fallback-map-id [index]
  (if (= (or index 0) 0)
    default-map-id
    (keyword (str "map/" (inc index)))))

(defun normalize-map-document [map-document index]
  (let [map-document (or map-document {})
        layers (normalize-layers (:layers map-document))]
    (assoc map-document
           :id (or (:id map-document) (fallback-map-id index))
           :label (or (:label map-document)
                      (if (= (or index 0) 0)
                        default-map-label
                        (str "Map " (inc index))))
           :width (map-dimension (:width map-document) map-width)
           :height (map-dimension (:height map-document) map-height)
           :tile-size (map-tile-dim (:tile-size map-document))
           :layers layers)))

(defun normalize-map-documents [maps]
  (map (for-indexed [index map-document (or maps [])]
         {:index index
          :map-document map-document})
       (fn [entry]
         (normalize-map-document (:map-document entry) (:index entry)))))

(defun project-map-input-documents [project]
  (let [maps (:maps project)]
    (if (empty? (or maps []))
      [(or (:tilemap project) {})]
      maps)))

(defun map-id-exists? [maps map-id]
  (> (count (filter (or maps [])
                    (fn [map-document]
                      (= (:id map-document) map-id))))
     0))

(defun selected-map-id [maps requested-id]
  (if (map-id-exists? maps requested-id)
    requested-id
    (:id (head (or maps [])))))

(defun selected-map-document [maps requested-id]
  (let [map-id (selected-map-id maps requested-id)]
    (or (head (filter (or maps [])
                      (fn [map-document]
                        (= (:id map-document) map-id))))
        (head (or maps [])))))

(defun normalize-project-document [project]
  (let [maps (normalize-map-documents (project-map-input-documents project))
        selected-map-id (selected-map-id maps (or (:selected-map project)
                                                  (-> project :tilemap :id)))
        selected-map (selected-map-document maps selected-map-id)
        layers (:layers selected-map)
        layer-profiles (let [profiles (normalize-layer-profiles
                                       (:layer-profiles project))]
                         (if (empty? profiles)
                           (default-layer-profiles layers)
                           profiles))
        layer-profile-id (selected-layer-profile-id
                          layer-profiles
                          (:layer-profile selected-map))
        selected-map (assoc selected-map :layer-profile layer-profile-id)
        maps (replace-map-document maps selected-map)
        layer-profile (layer-profile-by-id layer-profiles layer-profile-id)
        tilesets (normalize-tilesets (:tilesets project))
        property-sets (normalize-property-sets (:property-sets project))
        terrain-sets (normalize-terrain-sets (or (:terrain-sets project)
                                                 project-terrain-sets))]
    (assoc project
           :maps maps
           :selected-map selected-map-id
           :tilesets tilesets
           :property-sets property-sets
           :layer-profiles layer-profiles
           :terrain-sets terrain-sets
           :rulesets (normalize-rulesets (:rulesets project)
                                         layer-profile
                                         terrain-sets)
           :tile-substitution-rules
           (normalize-tile-substitution-rules
            (or (:tile-substitution-rules project)
                project-tile-substitution-rules))
           :brushes (normalize-brushes (:brushes project) layer-profile))))

(defun tilemap-document [state layers layer-profile-id]
  (let [document {:id (or (:selected-map-id state) default-map-id)
                  :label (or (:selected-map-label state) default-map-label)
                  :width (map-dimension (:map-width state) map-width)
                  :height (map-dimension (:map-height state) map-height)
                  :tile-size (map-tile-dim (:tile-size state))
                  :layers layers}]
    (if layer-profile-id
      (assoc document :layer-profile layer-profile-id)
      document)))

(defun replace-map-document [maps map-document]
  (let [maps (or maps [])
        map-id (:id map-document)
        replaced (map maps
                      (fn [existing]
                        (if (= (:id existing) map-id)
                          map-document
                          existing)))]
    (if (map-id-exists? maps map-id)
      replaced
      (concat replaced [map-document]))))

(defun project-document [state]
  (let [layers (normalize-layers (:layers state))
        layer-profiles (sync-layer-profiles (:layer-profiles state)
                                            (:selected-layer-profile-id state)
                                            layers)
        layer-profile-id (selected-layer-profile-id
                          layer-profiles
                          (:selected-layer-profile-id state))
        layer-profile (layer-profile-by-id layer-profiles layer-profile-id)
        terrain-sets (normalize-terrain-sets (or (:terrain-sets state)
                                                 project-terrain-sets))
        map-document (tilemap-document state layers layer-profile-id)
        maps (replace-map-document (:maps state) map-document)]
    {:format project-format
     :version project-format-version
     :resources (normalize-project-resources (or (:resources state)
                                                 project-resources))
     :tilesets (normalize-tilesets (:tilesets state))
     :property-sets (normalize-property-sets (or (:property-sets state)
                                                 project-property-sets))
     :terrain-sets terrain-sets
     :rulesets (normalize-rulesets (:rulesets state)
                                   layer-profile
                                   terrain-sets)
     :tile-substitution-rules
     (normalize-tile-substitution-rules
      (or (:tile-substitution-rules state) project-tile-substitution-rules))
     :layer-profiles layer-profiles
     :brushes (normalize-brushes (or (:brushes state) project-brushes)
                                 layer-profile)
     :selected-map (:id map-document)
     :maps (normalize-map-documents maps)}))
