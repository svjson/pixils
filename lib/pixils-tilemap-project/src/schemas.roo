(ns pixils.tilemap.project.schemas
  (:require [pixils.tilemap.project.model :as model]))

(def mask-size-schema
  "Form schema for editing a project mask-size map with `:w` and `:h` values."
  {:width {:type :integer
           :path [:w]
           :min model/min-map-dimension
           :max model/max-map-dimension}
   :height {:type :integer
            :path [:h]
            :min model/min-map-dimension
            :max model/max-map-dimension}})
