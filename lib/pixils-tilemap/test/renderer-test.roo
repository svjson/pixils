(ns pixils.tilemap.renderer-test
  (:require proof.core
            [pixils.tilemap.render :as render]
            [pixils.tilemap.renderer :as renderer]))

(deftest fit-scale-uses-smallest-axis-ratio
  (is (= 2
         (renderer/fit-scale 16
                             8
                             {:x 0
                              :y 0
                              :w 40
                              :h 16}))))

(deftest tile-draw-target-applies_scaled_draw_offset_and_size
  (is (= {:x 10
          :y -12
          :w 32
          :h 64}
         (renderer/tile-draw-target {:draw-offset {:x 0 :y -16}
                                     :draw-size {:w 16 :h 32}}
                                    {:x 10 :y 20 :w 32 :h 32}
                                    {:w 16 :h 32}
                                    2))))

(deftest draw-range-padding-includes_explicit_sprite_bounds
  (is (= {:left 0
          :right 0
          :top 1
          :bottom 0}
         (renderer/draw-range-padding-for-tile
          {:type :sprite
           :image :tiles/wall
           :source {:x 0 :y 0 :w 16 :h 32}
           :draw-offset {:x 0 :y -16}}
          {:w 16 :h 16}))))

(deftest valid-dim-requires-positive-dimensions
  (is (= true (renderer/valid-dim? {:w 1 :h 1})))
  (is (= false (renderer/valid-dim? {:w 0 :h 1})))
  (is (= false (renderer/valid-dim? {:w 1 :h 0}))))

(deftest tile-mask-rect-supports_edge_masks
  (let [rect {:x 10 :y 20 :w 60 :h 30}]
    (is (= {:x 10 :y 30 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :edges :part :w}}
                                    rect)))
    (is (= {:x 50 :y 30 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :edges :part :e}}
                                    rect)))
    (is (= {:x 30 :y 20 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :edges :part :n}}
                                    rect)))
    (is (= {:x 30 :y 40 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :edges :part :s}}
                                    rect)))))

(deftest tile-mask-rect-supports_corner_masks
  (let [rect {:x 10 :y 20 :w 60 :h 30}]
    (is (= {:x 10 :y 20 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :corners :part :nw}}
                                    rect)))
    (is (= {:x 50 :y 20 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :corners :part :ne}}
                                    rect)))
    (is (= {:x 10 :y 40 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :corners :part :sw}}
                                    rect)))
    (is (= {:x 50 :y 40 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :corners :part :se}}
                                    rect)))))

(deftest tile-mask-rect-supports_center_masks
  (let [rect {:x 10 :y 20 :w 60 :h 30}]
    (is (= {:x 30 :y 30 :w 20 :h 10}
           (renderer/tile-mask-rect {:mask {:kind :center :part :center}}
                                    rect)))))

(deftest tile-mask-rect-supports_quadrant_masks
  (let [rect {:x 10 :y 20 :w 60 :h 30}]
    (is (= {:x 10 :y 20 :w 30 :h 15}
           (renderer/tile-mask-rect {:mask {:kind :quadrants :part :nw}}
                                    rect)))
    (is (= {:x 40 :y 20 :w 30 :h 15}
           (renderer/tile-mask-rect {:mask {:kind :quadrants :part :ne}}
                                    rect)))
    (is (= {:x 10 :y 35 :w 30 :h 15}
           (renderer/tile-mask-rect {:mask {:kind :quadrants :part :sw}}
                                    rect)))
    (is (= {:x 40 :y 35 :w 30 :h 15}
           (renderer/tile-mask-rect {:mask {:kind :quadrants :part :se}}
                                    rect)))))

(deftest tile-mask-rect-keeps_edges_and_corners_disjoint
  (let [rect {:x 10 :y 20 :w 60 :h 30}
        bottom-left (renderer/tile-mask-rect {:mask {:kind :corners :part :sw}} rect)
        bottom-edge (renderer/tile-mask-rect {:mask {:kind :edges :part :s}} rect)]
    (is (= 30 (+ (:x bottom-left) (:w bottom-left))))
    (is (= 30 (:x bottom-edge)))
    (is (= (:y bottom-left) (:y bottom-edge)))
    (is (= (:h bottom-left) (:h bottom-edge)))))

(deftest render-options-uses-single-tileset
  (is (= {:tilesets [{:id :br :tiles []}]}
         (renderer/render-options {:id :br :tiles []} nil))))

(deftest render-options-preserves-renderer-directives
  (let [opts (renderer/render-options {:id :br :tiles []}
                                      {:offset {:x 1 :y 2}})]
    (is (= [{:id :br :tiles []}] (:tilesets opts)))
    (is (= {:x 1 :y 2} (:offset opts)))))

(deftest prepared-tilesets-resolve-keyword-tile-refs
  (let [tile {:id :dirt :type :sprite}
        prepared (renderer/prepared-tilesets [{:id :br
                                               :tiles [tile]}])
        resolved (renderer/prepared-tile-ref (get prepared :br) :dirt)]
    (is (= tile resolved))))

(deftest prepared-tilesets-preserve-first-duplicate-id
  (let [first-tile {:id :dirt :type :sprite}
        second-tile {:id :dirt :type :color}
        prepared (renderer/prepared-tilesets [{:id :br
                                               :tiles [first-tile]}
                                              {:id :br
                                               :tiles [second-tile]}])
        resolved (renderer/prepared-tile-ref (get prepared :br) :dirt)]
    (is (= first-tile resolved))))

(deftest render-prepared-tilesets-uses-supplied-lookup
  (let [prepared {:br {:tiles []
                       :tile-by-id {:dirt {:id :prepared-dirt}}}}]
    (is (= prepared
           (renderer/render-prepared-tilesets
            {:tilesets [{:id :br
                         :tiles [{:id :source-dirt}]}]
             :prepared-tilesets prepared})))))

(deftest render-prepared-tilesets-falls-back-to-tilesets
  (let [tile {:id :dirt}
        prepared (renderer/render-prepared-tilesets
                  {:tilesets [{:id :br
                               :tiles [tile]}]})]
    (is (= tile
           (renderer/prepared-tile-ref (get prepared :br)
                                       :dirt)))))

(deftest render-prepared-tilesets-for-tilemap-includes_generated_transition_tilesets
  (let [transition-tile {:id :transition-grass-water
                         :type :transition-mask}
        prepared (renderer/render-prepared-tilesets-for-tilemap
                  {:tilesets [{:id :pixils-transition-tiles
                               :tiles [transition-tile]}]}
                  {:tilesets [{:id :world
                               :tiles [{:id :grass-fill}]}]})
        layer (renderer/stack-ref-layer
               prepared
               {:tileset :world
                :data-kind :tile-ref}
               {:tileset :pixils-transition-tiles
                :tile :transition-grass-water})]
    (is (= transition-tile
           (renderer/prepared-tile-ref (:prepared-tileset layer)
                                       :transition-grass-water)))))

(deftest prepared-tile-ref-clamps-numeric-tile-refs
  (let [first-tile {:id :dirt}
        second-tile {:id :wall}
        prepared (renderer/prepared-tileset {:id :br
                                             :tiles [first-tile second-tile]})]
    (is (= first-tile (renderer/prepared-tile-ref prepared -1)))
    (is (= second-tile (renderer/prepared-tile-ref prepared 9)))))

(deftest image-render-opts-wraps-point-like-opts
  (is (= {:pos {:x 4
                :y 5}}
         (renderer/image-render-opts {:x 4
                                      :y 5}))))

(deftest image-render-opts-preserves-empty-option-maps
  (is (= {}
         (renderer/image-render-opts {}))))

(deftest image-render-opts-preserves-image-option-maps
  (is (= {:pos {:x 4
                :y 5}
          :scale 2
          :opacity 0.5}
         (renderer/image-render-opts {:pos {:x 4
                                            :y 5}
                                      :scale 2
                                      :opacity 0.5}))))

(deftest sprite-tile-render-opts-applies-tile-source
  (is (= {:pos {:x 4
                :y 5}
          :scale 2
          :source {:x 16
                   :y 0
                   :w 8
                   :h 8}}
         (renderer/sprite-tile-render-opts {:source {:x 16
                                                     :y 0
                                                     :w 8
                                                     :h 8}}
                                           {:pos {:x 4
                                                  :y 5}
                                            :scale 2
                                            :source {:x 0
                                                     :y 0
                                                     :w 1
                                                     :h 1}}))))

(deftest sprite-tile-render-opts-preserves-empty-option-maps
  (is (= {:source {:x 16
                   :y 0
                   :w 8
                   :h 8}}
         (renderer/sprite-tile-render-opts {:source {:x 16
                                                     :y 0
                                                     :w 8
                                                     :h 8}}
                                           {}))))

(deftest sprite-tile-render-opts-omits-source-when-tile-uses-whole-image
  (is (= {:pos {:x 4
                :y 5}
          :scale 2}
         (renderer/sprite-tile-render-opts {:image :items/red-potion}
                                           {:pos {:x 4
                                                  :y 5}
                                            :scale 2
                                            :source {:x 0
                                                     :y 0
                                                     :w 1
                                                     :h 1}}))))

(deftest tile-bang-noops-for-missing-tile-refs
  (is (nil? (renderer/tile! {:id :br
                             :tiles []}
                            :missing
                            {:pos {:x 0
                                   :y 0}})))
  (is (nil? (render/tile! {:id :br
                           :tiles []}
                          :missing
                          {:pos {:x 0
                                 :y 0}}))))

(deftest prepared-layer-cell-tile-applies-tile_substitutions
  (let [player {:id :player-default}
        walking {:id :player-walk-1}
        tileset {:id :br
                 :tiles [player walking]}
        prepared-tilesets (renderer/prepared-tilesets [tileset])
        layer (renderer/prepared-layer prepared-tilesets
                                       {:tileset :br
                                        :data-kind :tile-ref})
        result (renderer/prepared-layer-cell-tile [tileset]
                                                  []
                                                  layer
                                                  :player-default
                                                  {:player-default :player-walk-1})]
    (is (= walking result))))

(deftest prepared-layer-cell-tile-accepts_substitution_maps
  (let [player {:id :player-default}
        walking {:id :player-walk-1}
        tileset {:id :br
                 :tiles [player walking]}
        prepared-tilesets (renderer/prepared-tilesets [tileset])
        layer (renderer/prepared-layer prepared-tilesets
                                       {:tileset :br
                                        :data-kind :tile-ref})
        substitution {:tile :player-walk-1
                      :render-opts {:flip-x? true}}]
    (is (= walking
           (renderer/prepared-layer-cell-tile [tileset]
                                              []
                                              layer
                                              :player-default
                                              {:player-default substitution})))
    (is (= {:flip-x? true}
           (renderer/substitution-render-opts substitution {})))))

(deftest tile-stack-layer-checks_layer_kind
  (is (= true
         (renderer/tile-stack-layer? {:kind :tile-stack})))
  (is (= false
         (renderer/tile-stack-layer? {:kind :tile}))))

(deftest prepared-tile-stack-layer-checks_layer_kind
  (is (= true
         (renderer/prepared-tile-stack-layer? {:kind :prepared-tile-stack})))
  (is (= false
         (renderer/prepared-tile-stack-layer? {:kind :tile-stack}))))

(deftest tile-stack-refs-treats_nil_and_empty_vector_as_empty
  (is (= []
         (renderer/tile-stack-refs nil)))
  (is (= []
         (renderer/tile-stack-refs []))))

(deftest tile-stack-refs_accepts_multiple_tile_refs
  (is (= [:floor :item :actor]
         (renderer/tile-stack-refs [:floor :item :actor]))))

(deftest tile-stack-refs_wraps_single_tile_ref
  (is (= [:floor]
         (renderer/tile-stack-refs :floor))))

(deftest prepared-tile-stack-tiles-treats_nil_as_empty
  (is (= []
         (renderer/prepared-tile-stack-tiles nil))))

(deftest prepared-tile-stack-tiles-treats_non_sequences_as_empty
  (is (= []
         (renderer/prepared-tile-stack-tiles :missing-tile))))

(deftest prepared-tile-stack-tiles-uses_stack_as_is
  (let [tile {:id :floor
              :type :sprite}]
    (is (= [tile]
           (renderer/prepared-tile-stack-tiles [tile])))))

(deftest stack-ref-layer-uses_per_ref_tileset
  (let [barrel {:id :barrel}
        prepared (renderer/prepared-tilesets [{:id :objects
                                               :tiles [barrel]}])
        layer (renderer/stack-ref-layer prepared
                                        {:tileset :base
                                         :data-kind :tile-ref}
                                        {:tileset :objects
                                         :tile :barrel})]
    (is (= :objects (:tileset layer)))
    (is (= barrel
           (renderer/prepared-tile-ref (:prepared-tileset layer)
                                       :barrel)))))

(deftest stack-ref-tile-uses_per_ref_tile
  (is (= :barrel
         (renderer/stack-ref-tile {:tileset :objects
                                   :tile :barrel})))
  (is (= :floor
         (renderer/stack-ref-tile :floor))))

(deftest substitution-render-opts-accepts-executable-render-opts
  (let [substitution {:render-opts (fn [ctx]
                                     {:target (:rect ctx)
                                      :clip-rect (:rect ctx)
                                      :repeat-y? true})}
        rect {:x 4 :y 8 :w 16 :h 16}]
    (is (= {:target rect
            :clip-rect rect
            :repeat-y? true}
           (renderer/substitution-render-opts substitution
                                             {:rect rect})))))

(deftest map-render-rect-uses_scaled_map_size
  (is (= {:x 0
          :y 0
          :w 160
          :h 96}
         (renderer/map-render-rect {:width 10
                                    :height 6
                                    :tile-size 8}
                                   2))))

(deftest render-ranges-defaults_to_full_map_target
  (is (= {:x {:start 0
              :end 10}
          :y {:start 0
              :end 6}}
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 nil
                                 1
                                 nil))))

(deftest render-ranges-culls_to_target_rect
  (is (= {:x {:start 0
              :end 2}
          :y {:start 0
              :end 3}}
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 nil
                                 1
                                 {:x 4
                                  :y 8
                                  :w 12
                                  :h 24}))))

(deftest render-ranges-treats_target_rect_position_as_local_origin
  (is (= (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 nil
                                 1
                                 {:x 0
                                  :y 0
                                  :w 12
                                  :h 24})
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 nil
                                 1
                                 {:x 90
                                  :y 60
                                  :w 12
                                  :h 24}))))

(deftest render-ranges-applies_offset_before_culling
  (is (= {:x {:start 2
              :end 4}
          :y {:start 0
              :end 3}}
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 {:x 16
                                  :y 0}
                                 1
                                 {:x 0
                                  :y 0
                                  :w 16
                                  :h 24}))))

(deftest render-ranges-includes_tiles_partially_visible_before_origin
  (is (= {:x {:start 1
              :end 3}
          :y {:start 0
              :end 2}}
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 {:x 9
                                  :y 0}
                                 1
                                 {:x 0
                                  :y 0
                                  :w 8
                                  :h 16}))))

(deftest target-render-offset-translates_drawing_to_target_rect
  (is (= {:x -84
          :y -42}
         (renderer/target-render-offset {:x 16
                                         :y 8}
                                        {:x 100
                                         :y 50
                                         :w 32
                                         :h 24}))))

(deftest target-render-offset-preserves_offset_without_target_rect
  (is (= {:x 16
          :y 8}
         (renderer/target-render-offset {:x 16
                                         :y 8}
                                        nil))))

(deftest grid-line-position-keeps_internal_boundaries_on_tile_edges
  (is (= 8
         (renderer/grid-line-position 2 10 8 8)))
  (is (= -1
         (renderer/grid-line-position 1 10 8 9))))

(deftest grid-line-position-keeps_final_map_edge_inside_bounds
  (is (= 79
         (renderer/grid-line-position 10 10 8 0)))
  (is (= 70
         (renderer/grid-line-position 10 10 8 9))))

(deftest grid-line-span-uses_inclusive_draw_endpoints
  (is (= {:start 0
          :end 23}
         (renderer/grid-line-span {:start 0
                                   :end 3}
                                  3
                                  8
                                  0)))
  (is (= {:start -1
          :end 15}
         (renderer/grid-line-span {:start 1
                                   :end 3}
                                  10
                                  8
                                  9))))

(deftest render-ranges-clamps_off_map_targets_to_empty_ranges
  (is (= {:x {:start 10
              :end 10}
          :y {:start 6
              :end 6}}
         (renderer/render-ranges {:width 10
                                  :height 6
                                  :tile-size 8}
                                 {:x 90
                                  :y 60}
                                 1
                                 {:x 0
                                  :y 0
                                  :w 10
                                  :h 10}))))
