                     :tile-substitution-rules [{:tileset :world
                                                :tile :floor
                                                :seed 0
                                                :choices [{:tile :floor-crack
                                                           :weight 1}]}]
                     :layers [{:id :base
                               :data-kind :terrain
                               :terrain-set :terrain
                               :tiles [[:grass]]}]})]
    (is (= :floor-crack
           (get-in render-map [:layers 0 :tiles 0 0])))))

(deftest materialize-render-map-applies-tile-defined-substitutions-after-terrain
  (let [render-map (materialize/materialize-render-map
                    {:width 1
