(deftest materialize-render-map-scopes-tile-substitution-rules-by-tileset
  (let [render-map (materialize/materialize-render-map
                    {:width 1
                     :height 1
                     :tile-substitution-rules [{:tileset :world
                                                :tile :floor
                                                :seed 0
                                                :choices [{:tile :floor-crack
                                                           :weight 1}]}]
                     :layers [{:id :world-base
                               :tileset :world
                               :tiles [[:floor]]}
                              {:id :ui-base
                               :tileset :ui
                               :tiles [[:floor]]}]})]
    (is (= :floor-crack
           (get-in render-map [:layers 0 :tiles 0 0])))
    (is (= :floor
           (get-in render-map [:layers 1 :tiles 0 0])))))

(deftest materialize-render-rect-uses-source-coordinates-for-tile-substitutions
  (let [tilemap {:width 4
                 :height 2
                 :tile-substitution-rules [{:tileset :world
                                            :tile :floor
                                            :seed 7
                                            :choices [{:tile :floor
                                                       :weight 4}
                                                      {:tile :floor-crack
                                                       :weight 1}]}]
                 :layers [{:id :base
                           :tileset :world
                           :tiles [[:floor :floor :floor :floor]
                                   [:floor :floor :floor :floor]]}]}
        full (materialize/materialize-render-map tilemap)
        rect (materialize/materialize-render-rect tilemap
                                                  {:x 1 :y 1 :w 2 :h 1})]
    (is (= [[(get-in full [:layers 0 :tiles 1 1])
             (get-in full [:layers 0 :tiles 1 2])]]
           (-> rect :layers (nth 0) :tiles)))))
