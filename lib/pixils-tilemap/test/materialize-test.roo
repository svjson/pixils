(deftest materialize-render-rect-clamps-to-map-bounds
  (let [render-map (materialize/materialize-render-rect
                    {:width 3
                     :height 2
                     :layers [{:id :base
                               :tileset :game
                               :tiles [[:a :b :c]
                                       [:d :e :f]]}]}
                    {:x 2 :y 1 :w 4 :h 4})]
    (is (= 1 (:width render-map)))
    (is (= 1 (:height render-map)))
    (is (= {:x 2 :y 1} (:origin render-map)))
    (is (= [[:f]]
           (-> render-map :layers (nth 0) :tiles)))))

(deftest materialize-render-map-applies-stable-weighted-tile-substitution-rules
  (let [render-map (materialize/materialize-render-map
                    {:width 5
                     :height 1
                     :tile-substitution-rules [{:tileset :world
                                                :tile :floor
                                                :algorithm :weighted-random
                                                :seed 7
                                                :choices [{:tile :floor
                                                           :weight 4}
                                                          {:tile :floor-crack
                                                           :weight 1}]}]
                     :layers [{:id :base
                               :tileset :world
                               :tiles [[:floor :floor :floor :floor :floor]]}]})]
    (is (= [[:floor :floor :floor-crack :floor :floor-crack]]
           (-> render-map :layers (nth 0) :tiles)))))

(deftest materialize-render-map-ignores-unknown-tile-substitution-algorithms
  (let [render-map (materialize/materialize-render-map
                    {:width 1
                     :height 1
                     :tile-substitution-rules [{:tileset :world
                                                :tile :floor
                                                :algorithm :unknown
                                                :choices [{:tile :floor-crack
                                                           :weight 1}]}]
                     :layers [{:id :base
                               :tileset :world
                               :tiles [[:floor]]}]})]
    (is (= [[:floor]]
           (-> render-map :layers (nth 0) :tiles)))))

(deftest materialize-render-map-mixes-equal-weight-substitutions-by-position
  (let [render-map (materialize/materialize-render-map
                    {:width 9
                     :height 1
                     :tile-substitution-rules [{:tileset :world
                                                :tile :floor
                                                :seed 0
                                                :choices [{:tile :floor-a
                                                           :weight 1}
                                                          {:tile :floor-b
                                                           :weight 1}
                                                          {:tile :floor-c
                                                           :weight 1}]}]
                     :layers [{:id :base
                               :tileset :world
                               :tiles [[:floor :floor :floor
                                        :floor :floor :floor
                                        :floor :floor :floor]]}]})]
    (is (= [[:floor-b :floor-c :floor-c
             :floor-a :floor-c :floor-c
             :floor-a :floor-c :floor-c]]
           (-> render-map :layers (nth 0) :tiles)))
    (is (not= [[:floor-a :floor-b :floor-c
                :floor-a :floor-b :floor-c
                :floor-a :floor-b :floor-c]]
              (-> render-map :layers (nth 0) :tiles)))))

(deftest materialize-render-map-applies-tile-substitution-rules-after-terrain
  (let [render-map (materialize/materialize-render-map
                    {:width 1
                     :height 1
                     :terrain-sets [{:id :terrain
