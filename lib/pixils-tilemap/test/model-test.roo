(ns pixils.tilemap.model-test
  (:require proof.core
            [pixils.tilemap.model :as tm]))

(deftest tile-rect-uses_tile_size_zoom_and_offset
  (is (= {:x 24 :y 56 :w 32 :h 32}
         (tm/tile-rect {:tile-size 16}
                       1
                       2
                       {:x 8 :y 8}
                       2))))

(deftest tile-rect-uses_rectangular_tile_size
  (is (= {:x 84 :y 103 :w 44 :h 36}
         (tm/tile-rect {:tile-size {:w 22 :h 18}}
                       2
                       3
                       {:x 4 :y 5}
                       2))))

(deftest map-rect-uses_map_dimensions
  (let [rect (tm/map-rect {:width 4 :height 3})]
    (is (= 0 (:x rect)))
    (is (= 0 (:y rect)))
    (is (= 4 (:w rect)))
    (is (= 3 (:h rect)))))

(deftest in-bounds-checks_map_rect
  (let [tilemap {:width 4 :height 3}]
    (is (= true (tm/in-bounds? tilemap {:x 0 :y 0})))
    (is (= true (tm/in-bounds? tilemap {:x 3 :y 2})))
    (is (= false (tm/in-bounds? tilemap {:x 4 :y 2})))
    (is (= false (tm/in-bounds? tilemap {:x 3 :y 3})))
    (is (= false (tm/in-bounds? tilemap {:x -1 :y 0})))))

(deftest filled-layer-creates-tile-ref-layer-matching-map-size
  (is (= {:id :cover
          :tileset :game
          :kind :tile
          :data-kind :tile-ref
          :tiles [[:wall :wall :wall]
                  [:wall :wall :wall]]}
         (tm/filled-layer {:width 3
                           :height 2}
                          {:id :cover
                           :tileset :game
                           :tile :wall}))))

(deftest add-set-and-remove-layer-updates-map-layers
  (let [tilemap {:width 2
                 :height 1
                 :layers [{:id :source
                           :tiles [[:empty :empty]]}]}
        cover (tm/filled-layer tilemap
                               {:id :cover
                                :tileset :game
                                :tile :wall})
        tilemap (tm/add-layer tilemap cover)
        tilemap (tm/set-layer-cell tilemap :cover {:x 1 :y 0} nil)]
    (is (= [:source :cover]
           (map (:layers tilemap) :id)))
    (is (= [[:wall nil]]
           (-> tilemap :layers (nth 1) :tiles)))
    (is (= [:source]
           (map (:layers (tm/remove-layer tilemap :cover)) :id)))))

(deftest layer-cell-reads-existing-layer-cells
  (let [tilemap {:width 2
                 :height 2
                 :layers [{:id :ground
                           :tiles [[:floor :wall]
                                   [:water :floor]]}]}]
    (is (= :wall
           (tm/layer-cell tilemap :ground {:x 1 :y 0})))
    (is (nil? (tm/layer-cell tilemap :missing {:x 1 :y 0})))
    (is (nil? (tm/layer-cell tilemap :ground {:x 2 :y 0})))))

(deftest apply-layer-patch-updates-cells
  (let [tilemap {:width 3
                 :height 2
                 :layers [{:id :ground
                           :tiles [[:floor :floor :floor]
                                   [:floor :floor :floor]]}
                          {:id :cover
                           :tiles [[nil nil nil]
                                   [nil nil nil]]}]}
        tilemap (tm/apply-layer-patch
                  tilemap
                  {:layer-id :ground
                   :cells [{:pos {:x 1 :y 0}
                            :tile :wall}
                           {:pos {:x 0 :y 1}
                            :value :water}
                           {:pos {:x 3 :y 0}
                            :tile :ignored}]})
        tilemap (tm/apply-layer-patches
                  tilemap
                  [{:layer-id :cover
                    :cells [{:pos {:x 2 :y 1}
                             :tile :shade}]}
                   {:layer-id :missing
                    :cells [{:pos {:x 0 :y 0}
                             :tile :ignored}]}])]
    (is (= [[:floor :wall :floor]
            [:water :floor :floor]]
           (-> tilemap :layers head :tiles)))
    (is (= [[nil nil nil]
            [nil nil :shade]]
           (-> tilemap :layers (nth 1) :tiles)))))

(deftest missing-tileset-has-no_tile
  (is (nil? (tm/tile-in [] nil 0)))
  (is (nil? (tm/tile-id [] nil 0))))

(deftest tile-refs-resolve_by_id_or_index
  (let [tilesets [{:id :game
                   :tiles [{:id :wall}
                           {:id :dirt}]}]]
    (is (= :wall (:id (tm/tile-in tilesets :game 0))))
    (is (= :dirt (:id (tm/tile-in tilesets :game :dirt))))
    (is (= :dirt (tm/tile-id tilesets :game 1)))))

(deftest missing-keyword-tile-refs-do-not-fall-back-to-first-tile
  (let [tilesets [{:id :game
                   :tiles [{:id :wall}
                           {:id :dirt}]}]]
    (is (nil? (tm/tile-in tilesets :game :missing)))
    (is (nil? (tm/tile-id tilesets :game :missing)))))

(deftest nil_tile_ref_means_no_tile
  (let [tilesets [{:id :game
                   :tiles [{:id :wall}]}]]
    (is (nil? (tm/tile-in tilesets :game nil)))
    (is (nil? (tm/tile-id tilesets :game nil)))))

(deftest terrain_tile_resolves_to_preview_tile
  (let [tilesets [{:id :game
                   :tiles [{:id :dirt
                            :type :color}]}]
        terrain-sets [{:id :materials
                       :tileset :game
                       :terrains [{:id :earth
                                   :tile :dirt}]}]]
    (is (= :dirt
           (:id (tm/terrain-tile-in tilesets
                                    terrain-sets
                                    :materials
                                    :earth))))))

(deftest terrain_tile_returns_nil_for_missing_preview_tile
  (let [tilesets [{:id :game
                   :tiles [{:id :dirt
                            :type :color}]}]
        terrain-sets [{:id :materials
                       :tileset :game
                       :terrains [{:id :earth
                                   :tile :missing}]}]]
    (is (nil? (tm/terrain-tile-in tilesets
                                  terrain-sets
                                  :materials
                                  :earth)))))

(deftest layer_cell_tile_uses_layer_data_kind
  (let [tilesets [{:id :game
                   :tiles [{:id :dirt}
                           {:id :gem}]}]
        terrain-sets [{:id :materials
                       :tileset :game
                       :terrains [{:id :earth
                                   :tile :dirt}]}]]
    (is (= :gem
           (:id (tm/layer-cell-tile tilesets
                                    terrain-sets
                                    {:data-kind :tile-ref
                                     :tileset :game}
                                    :gem))))
    (is (= :dirt
           (:id (tm/layer-cell-tile tilesets
                                    terrain-sets
                                    {:data-kind :terrain
                                     :terrain-set :materials}
                                    :earth))))))

(deftest apply_tileset_property_defaults_writes_effective_values_to_tiles
  (let [property-sets [{:id :movement
                        :properties [{:id :walkable
                                      :type :enum
                                      :values [:yes :no]
                                      :default :yes}
                                     {:id :cost
                                      :type :number
                                      :default 1}
                                     {:id :note
                                      :type :any
                                      :default "open"}]}]
        tileset {:id :game
                 :property-sets [:movement]
                 :properties {:cost 2
                              :walkable :no}
                 :tiles [{:id :floor}
                         {:id :wall
                          :properties {:walkable :yes
                                       :cost "bad"
                                       :unknown true}}]}
        tileset (tm/apply-tileset-property-defaults property-sets tileset)]
    (is (= {:walkable :no
            :cost 2
            :note "open"}
           (get-in tileset [:tiles 0 :properties])))
    (is (= {:walkable :yes
            :cost 1
            :note "open"}
           (get-in tileset [:tiles 1 :properties])))))

(deftest apply_terrain_set_property_defaults_writes_effective_values_to_terrains
  (let [property-sets [{:id :movement
                        :properties [{:id :blocked
                                      :type :enum
                                      :values [:yes :no]
                                      :default :no}
                                     {:id :cost
                                      :type :number
                                      :default 1}]}]
        terrain-set {:id :materials
                     :property-sets [:movement]
                     :properties {:cost 3}
                     :terrains [{:id :grass}
                                {:id :water
                                 :properties {:blocked :yes}}]}
        terrain-set (tm/apply-terrain-set-property-defaults property-sets
                                                            terrain-set)]
    (is (= {:blocked :no
            :cost 3}
           (get-in terrain-set [:terrains 0 :properties])))
    (is (= {:blocked :yes
            :cost 3}
           (get-in terrain-set [:terrains 1 :properties])))))
