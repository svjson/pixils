(ns pixils.tilemap.ops-test
  (:require proof.core
            [pixils.tilemap.ops :as ops]))

(def test-tilemap
  {:width 3
   :height 2
   :layers [{:id :base
             :role :source
             :data-kind :tile-ref
             :tiles [[:floor :door nil]
                     [:wall :floor :door]]}
            {:id :objects
             :role :source
             :data-kind :tile-ref
             :tiles [[nil :chest nil]
                     [:door nil nil]]}
            {:id :render
             :role :render
             :data-kind :tile-ref
             :tiles [[:door nil nil]
                     [nil nil nil]]}]})

(deftest find-layer-cells-filters-by-role-data-kind-and-tile_refs
  (is (= [{:position {:x 1 :y 0}
           :x 1
           :y 0
           :layer-id :base
           :layer-index 0
           :tile-ref :door}
          {:position {:x 2 :y 1}
           :x 2
           :y 1
           :layer-id :base
           :layer-index 0
           :tile-ref :door}
          {:position {:x 0 :y 1}
           :x 0
           :y 1
           :layer-id :objects
           :layer-index 1
           :tile-ref :door}]
         (ops/find-layer-cells test-tilemap
                               {:role :source
                                :data-kind :tile-ref
                                :tile-refs {:door true}}))))

(deftest find-layer-cells-selects-layers-by-id-or-index
  (is (= [:base :base :render]
         (map (ops/find-layer-cells test-tilemap
                                    {:layers [:base 2]
                                     :tile-refs [:door]})
              :layer-id))))

(deftest live-base-tilemap-tags-base-and-masks-overlay-cells
  (let [tilemap (ops/live-base-tilemap
                 test-tilemap
                 {:base-layer-id :base
                  :masked-positions [{:x 1 :y 0}]
                  :masked-tile-refs {:door true}
                  :tilemap-props {:atlas/legacy-source? true}
                  :base-layer-props {:atlas/legacy-base? true}
                  :overlay-layer-defaults {:atlas/render-position :under-actors}})
        layers (:layers tilemap)]
    (is (= true
           (:atlas/legacy-source? tilemap)))
    (is (= true
           (-> layers head :atlas/legacy-base?)))
    (is (= [[:floor :door nil]
            [:wall :floor :door]]
           (-> layers head :tiles)))
    (is (= [[nil nil nil]
            [nil nil nil]]
           (-> layers (nth 1) :tiles)))
    (is (= :under-actors
           (-> layers (nth 1) :atlas/render-position)))))

(deftest live-base-tilemap-keeps-existing-overlay-default_keys
  (let [tilemap (ops/live-base-tilemap
                 (assoc-in test-tilemap
                           [:layers 1 :atlas/render-position]
                           :over-actors)
                 {:base-layer-id :base
                  :overlay-layer-defaults {:atlas/render-position :under-actors}})
        layer (-> tilemap :layers (nth 1))]
    (is (= :over-actors
           (:atlas/render-position layer)))))

(def brush-test-tilemap
  {:width 5
   :height 4
   :layers [{:id :ground
             :role :source
             :data-kind :terrain
             :terrain-set :outdoors
             :tiles [[:grass :grass :grass :grass :grass]
                     [:grass :grass :grass :grass :grass]
                     [:grass :grass :grass :grass :grass]
                     [:grass :grass :grass :grass :grass]]}
            {:id :objects
             :role :source
             :data-kind :tile-ref
             :tileset :village
             :tiles [[nil nil nil nil nil]
                     [nil nil nil nil nil]
                     [nil nil nil nil nil]
                     [nil nil nil nil nil]]}]})

(def object-hut-brush
  {:id :hut
   :kind :pattern
   :pattern {:size {:w 3 :h 2}
             :anchor {:x 1 :y 1}
             :layers [{:id :hut
                       :target-layer :objects
                       :data-kind :tile-ref
                       :tileset :village
                       :tiles [[:roof-left :roof-center :roof-right]
                               [nil :door nil]]}]}})

(deftest apply-pattern-brush-stamps-object-tiles-by-target-layer
  (let [tilemap (ops/apply-pattern-brush brush-test-tilemap
                                         object-hut-brush
                                         {:position {:x 2 :y 2}})]
    (is (= [[nil nil nil nil nil]
            [nil :roof-left :roof-center :roof-right nil]
            [nil nil :door nil nil]
            [nil nil nil nil nil]]
           (get-in tilemap [:layers 1 :tiles])))))

(deftest apply-pattern-brush-skips-incompatible-target-layer
  (let [brush (assoc-in object-hut-brush
                        [:pattern :layers 0 :tileset]
                        :other-tileset)
        tilemap (ops/apply-pattern-brush brush-test-tilemap
                                         brush
                                         {:position {:x 2 :y 2}})]
    (is (= (get-in brush-test-tilemap [:layers 1 :tiles])
           (get-in tilemap [:layers 1 :tiles])))))

(deftest apply-pattern-brush-stamps-terrain-layer-by-terrain-set
  (let [brush {:id :pond
               :kind :pattern
               :pattern {:size {:w 2 :h 2}
                         :anchor {:x 0 :y 0}
                         :layers [{:id :water
                                   :target-layer :ground
                                   :data-kind :terrain
                                   :terrain-set :outdoors
                                   :tiles [[:water :water]
                                           [:water nil]]}]}}
        tilemap (ops/apply-pattern-brush brush-test-tilemap
                                         brush
                                         {:position {:x 1 :y 1}})]
    (is (= [[:grass :grass :grass :grass :grass]
            [:grass :water :water :grass :grass]
            [:grass :water :grass :grass :grass]
            [:grass :grass :grass :grass :grass]]
           (get-in tilemap [:layers 0 :tiles])))))

(deftest clear-pattern-brush-clears-target-layer-footprint
  (let [painted (ops/apply-pattern-brush brush-test-tilemap
                                         object-hut-brush
                                         {:position {:x 2 :y 2}})
        cleared (ops/clear-pattern-brush painted
                                         object-hut-brush
                                         {:position {:x 2 :y 2}})]
    (is (= (get-in brush-test-tilemap [:layers 1 :tiles])
           (get-in cleared [:layers 1 :tiles])))))
