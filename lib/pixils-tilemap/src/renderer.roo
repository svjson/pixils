(ns pixils.tilemap.renderer
  (:require [pixils.image :as img]
            [pixils.render :as r]
            [pixils.resource :as res]
            [pixils.tilemap.model :as tm]
            [pixils.tilemap.render-impl :as render-impl]))

(def transition-cache-bundle :pixils-transition-cache)

(defun centered-pos [rect width height]
  {:x (+ (:x rect) (/ (- (:w rect) width) 2))
   :y (+ (:y rect) (/ (- (:h rect) height) 2))})

(defun fit-scale [source-width source-height rect]
  (min (/ (:w rect) source-width)
       (/ (:h rect) source-height)))

(defun valid-dim? [dim]
  (and dim
       (:w dim)
       (:h dim)
       (> (:w dim) 0)
       (> (:h dim) 0)))

(defun sprite-tile-dim [tile]
  (let [source (:source tile)]
    (if (valid-dim? source)
      source
      (img/size (:image tile)))))

(defun draw-missing-tile! [rect]
  (r/rect! rect {:fill true
                 :color tm/default-missing-tile-color}))

(defun light-mask-grid [rect]
  (let [left-w (/ (:w rect) 3)
        right-w (/ (:w rect) 3)
        middle-w (- (- (:w rect) left-w) right-w)
        top-h (/ (:h rect) 3)
        bottom-h (/ (:h rect) 3)
        middle-h (- (- (:h rect) top-h) bottom-h)]
    {:left-w left-w
     :middle-w middle-w
     :right-w right-w
     :top-h top-h
     :middle-h middle-h
     :bottom-h bottom-h
     :middle-x (+ (:x rect) left-w)
     :right-x (+ (+ (:x rect) left-w) middle-w)
     :middle-y (+ (:y rect) top-h)
     :bottom-y (+ (+ (:y rect) top-h) middle-h)}))

(defun light-mask-edge-rect [part rect]
  (let [grid (light-mask-grid rect)]
    (cond
      (= part :w)
      {:x (:x rect) :y (:middle-y grid) :w (:left-w grid) :h (:middle-h grid)}

      (= part :e)
      {:x (:right-x grid) :y (:middle-y grid) :w (:right-w grid) :h (:middle-h grid)}

      (= part :n)
      {:x (:middle-x grid) :y (:y rect) :w (:middle-w grid) :h (:top-h grid)}

      (= part :s)
      {:x (:middle-x grid) :y (:bottom-y grid) :w (:middle-w grid) :h (:bottom-h grid)}

      :default
      rect)))

(defun light-mask-corner-rect [part rect]
  (let [grid (light-mask-grid rect)]
    (cond
      (= part :nw)
      {:x (:x rect) :y (:y rect) :w (:left-w grid) :h (:top-h grid)}

      (= part :ne)
      {:x (:right-x grid) :y (:y rect) :w (:right-w grid) :h (:top-h grid)}

      (= part :sw)
      {:x (:x rect) :y (:bottom-y grid) :w (:left-w grid) :h (:bottom-h grid)}

      (= part :se)
      {:x (:right-x grid) :y (:bottom-y grid) :w (:right-w grid) :h (:bottom-h grid)}

      :default
      rect)))

(defun light-mask-center-rect [part rect]
  (let [grid (light-mask-grid rect)]
    (if (= part :center)
      {:x (:middle-x grid) :y (:middle-y grid) :w (:middle-w grid) :h (:middle-h grid)}
      rect)))

(defun light-mask-quadrant-rect [part rect]
  (let [left-w (/ (:w rect) 2)
        right-w (- (:w rect) left-w)
        top-h (/ (:h rect) 2)
        bottom-h (- (:h rect) top-h)
        right-x (+ (:x rect) left-w)
        bottom-y (+ (:y rect) top-h)]
    (cond
      (= part :nw)
      {:x (:x rect) :y (:y rect) :w left-w :h top-h}

      (= part :ne)
      {:x right-x :y (:y rect) :w right-w :h top-h}

      (= part :sw)
      {:x (:x rect) :y bottom-y :w left-w :h bottom-h}

      (= part :se)
      {:x right-x :y bottom-y :w right-w :h bottom-h}

      :default
      rect)))

(defun tile-mask-rect [tile rect]
  (let [mask (:mask tile)
        kind (:kind mask)
        part (:part mask)]
    (cond
      (= kind :edges)
      (light-mask-edge-rect part rect)

      (= kind :corners)
      (light-mask-corner-rect part rect)

      (= kind :center)
      (light-mask-center-rect part rect)

      (= kind :quadrants)
      (light-mask-quadrant-rect part rect)

      :default
      rect)))

(defun draw-color-tile! [tile rect]
  (r/rect! (tile-mask-rect tile rect)
           {:fill true
            :color (:color tile)}))

(defun explicit-draw-geometry? [tile]
  (or (:draw-offset tile)
      (:draw-size tile)))

(defun tile-draw-offset [tile]
  (or (:draw-offset tile) {:x 0 :y 0}))

(defun tile-draw-size [tile dim]
  (let [size (or (:draw-size tile) dim)]
    {:w (or (:w size) (:w dim))
     :h (or (:h size) (:h dim))}))

(defun tile-draw-target [tile rect dim zoom]
  (let [offset (tile-draw-offset tile)
        size (tile-draw-size tile dim)
        scale (or zoom 1)]
    {:x (+ (:x rect) (* (or (:x offset) 0) scale))
     :y (+ (:y rect) (* (or (:y offset) 0) scale))
     :w (* (:w size) scale)
     :h (* (:h size) scale)}))

(defun draw-explicit-image-tile! [tile rect render-opts dim zoom opts]
  (r/image! (:image tile)
            (merge {:target (tile-draw-target tile rect dim zoom)}
                   opts
                   (or render-opts {}))))

(defun draw-explicit-sprite-tile! [tile rect render-opts zoom]
  (let [dim (sprite-tile-dim tile)]
    (if (valid-dim? dim)
      (draw-explicit-image-tile! tile
                                 rect
                                 nil
                                 dim
                                 zoom
                                 (sprite-tile-render-opts tile render-opts))
      (draw-missing-tile! rect))))

(defun draw-sprite-tile! [tile rect render-opts zoom]
  (if (explicit-draw-geometry? tile)
    (draw-explicit-sprite-tile! tile rect render-opts zoom)
    (let [dim (sprite-tile-dim tile)]
      (if (valid-dim? dim)
        (let [scale (fit-scale (:w dim) (:h dim) rect)
              width (* (:w dim) scale)
              height (* (:h dim) scale)]
          (r/image! (:image tile)
                    (merge {:pos (centered-pos rect width height)
                            :scale scale}
                           (sprite-tile-render-opts tile render-opts))))
        (draw-missing-tile! rect)))))

(defun draw-image-tile! [tile rect render-opts zoom]
  (let [dim (img/size (:image tile))]
    (if (valid-dim? dim)
      (if (explicit-draw-geometry? tile)
        (do (r/rect! rect {:fill true
                           :color tm/default-image-tile-background-color})
            (draw-explicit-image-tile! tile
                                       rect
                                       render-opts
                                       dim
                                       zoom
                                       {}))
        (let [scale (fit-scale (:w dim) (:h dim) rect)
              width (* (:w dim) scale)
              height (* (:h dim) scale)]
          (r/rect! rect {:fill true
                         :color tm/default-image-tile-background-color})
          (r/image! (:image tile)
                    (merge {:pos (centered-pos rect width height)
                            :scale scale}
                           (or render-opts {})))))
      (draw-missing-tile! rect))))

(defun transition-image-exists? [image]
  (not (nil? (head (filter (res/list-images transition-cache-bundle)
                           (fn [resource]
                             (= (:id resource) image)))))))

(defun transition-tile-size [tile rect zoom]
  (let [size (or (:size tile)
                 (-> tile :mask-source :size)
                 {:w (/ (:w rect) (or zoom 1))
                  :h (/ (:h rect) (or zoom 1))})]
    {:w (or (:w size) (:w rect))
     :h (or (:h size) (:h rect))}))

(defun transition-source-tile-dim [tile fallback]
  (cond
    (= (:type tile) :sprite)
    (sprite-tile-dim tile)

    (= (:type tile) :image)
    (img/size (:image tile))

    :default
    fallback))

(defun draw-transition-image-source! [tile rect opts]
  (cond
    (= (:type tile) :sprite)
    (let [dim (sprite-tile-dim tile)]
      (when (valid-dim? dim)
        (r/image! (:image tile)
                  (merge {:target rect}
                         (sprite-tile-render-opts tile opts)))))

    (= (:type tile) :image)
    (r/image! (:image tile)
              (merge {:target rect}
                     (or opts {})))

    :default
    nil))

(defun draw-transition-mask-source-item! [item size]
  (let [tile (:tile-definition item)
        offset (or (:offset item) {:x 0 :y 0})
        dim (transition-source-tile-dim tile size)]
    (when tile
      (draw-transition-image-source!
       tile
       {:x (or (:x offset) 0)
        :y (or (:y offset) 0)
        :w (:w dim)
        :h (:h dim)}
       {:blend-mode :erase-alpha}))))

(defun draw-transition-overlay-image! [tile size]
  (let [overlay (-> tile :overlay :tile-definition)]
    (when overlay
      (draw-tile! overlay {:x 0 :y 0 :w (:w size) :h (:h size)} nil 1))
    (for [item (or (-> tile :mask-source :tiles) [])]
      (draw-transition-mask-source-item! item size))))

(defun ensure-transition-overlay-image! [tile size]
  (let [image (:image tile)]
    (when (and image
               (res/can-create-images?))
      (res/create-bundle! transition-cache-bundle)
      (when (not (transition-image-exists? image))
        (res/create-image! image
                           {:size size}
                           (fn []
                             (draw-transition-overlay-image! tile size)))))
    image))

(defun draw-transition-mask-tile! [tile rect render-opts zoom]
  (let [base (-> tile :base :tile-definition)
        overlay (-> tile :overlay :tile-definition)
        size (transition-tile-size tile rect zoom)
        image (ensure-transition-overlay-image! tile size)]
    (when base
      (draw-tile! base rect nil zoom))
    (if (and image
             (res/can-create-images?)
             (transition-image-exists? image))
      (r/image! image (merge {:target rect} (or render-opts {})))
      (when overlay
        (draw-tile! overlay rect (merge {:opacity 0.5} (or render-opts {})) zoom)))))

(defun draw-tile! [tile rect render-opts zoom]
  (cond
    (= (:type tile) :color)
    (draw-color-tile! tile rect)

    (= (:type tile) :image)
    (draw-image-tile! tile rect render-opts zoom)

    (= (:type tile) :sprite)
    (draw-sprite-tile! tile rect render-opts zoom)

    (= (:type tile) :transition-mask)
    (draw-transition-mask-tile! tile rect render-opts zoom)

    :default
    (draw-missing-tile! rect)))

(defun layer-cell [tiles x y]
  (nth (or (nth (or tiles []) y) []) x))

(defun tile-by-id [tiles]
  (reduce (or tiles [])
          {}
          (fn [out tile]
            (assoc out (:id tile) tile))))

(defun empty-prepared-tileset []
  {:tiles []
   :tile-by-id {}})

(defun prepared-tileset [tileset]
  (let [tiles (or (:tiles tileset) [])]
    {:tiles tiles
     :tile-by-id (tile-by-id tiles)}))

(defun prepared-tilesets [tilesets]
  (reduce (or tilesets [])
          {}
          (fn [out tileset]
            (if (contains? out (:id tileset))
              out
              (assoc out (:id tileset) (prepared-tileset tileset))))))

(defun render-tilesets [tilemap opts]
  (concat (or (:tilesets tilemap) [])
          (or (:tilesets opts) [])))

(defun render-prepared-tilesets [opts]
  (or (:prepared-tilesets opts)
      (prepared-tilesets (or (:tilesets opts) []))))

(defun render-prepared-tilesets-for-tilemap [tilemap opts]
  (or (:prepared-tilesets opts)
      (prepared-tilesets (render-tilesets tilemap opts))))

(defun clamp-index [items index]
  (let [count (count items)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun prepared-tile-ref [prepared-tileset tile-ref]
  (when (not (tm/absent-tile-ref? tile-ref))
    (let [tiles (:tiles prepared-tileset)]
      (if (keyword? tile-ref)
        (get (:tile-by-id prepared-tileset) tile-ref)
        (when (> (count tiles) 0)
          (nth tiles (clamp-index tiles tile-ref)))))))

(defun point-render-opts? [render-opts]
  (and (= (type-of render-opts) "map")
       (contains? render-opts :x)
       (contains? render-opts :y)))

(defun image-render-opts [render-opts]
  (cond
    (nil? render-opts)
    {}

    (and (= (type-of render-opts) "map")
         (contains? render-opts :pos))
    render-opts

    (point-render-opts? render-opts)
    {:pos render-opts}

    (= (type-of render-opts) "map")
    render-opts

    :default
    {:pos render-opts}))

(defun sprite-tile-render-opts [tile render-opts]
  (let [opts (image-render-opts render-opts)
        source (:source tile)]
    (if (valid-dim? source)
      (assoc opts :source source)
      (dissoc opts :source))))

(defun tile! [tileset tile-ref render-opts]
  (let [tile (prepared-tile-ref (prepared-tileset tileset) tile-ref)]
    (cond
      (and tile
           (= (:type tile) :sprite)
           (valid-dim? (sprite-tile-dim tile)))
      (r/image! (:image tile)
                (sprite-tile-render-opts tile render-opts))

      (and tile
           (= (:type tile) :image))
      (r/image! (:image tile)
                (image-render-opts render-opts))

      :default
      nil)))

(defun prepared-terrain-ref [tilesets terrain-sets terrain-ref tile-ref]
  (tm/layer-cell-tile tilesets
                      terrain-sets
                      {:data-kind :terrain
                       :terrain-set terrain-ref}
                      tile-ref))

(defun prepared-layer [prepared-tilesets layer]
  (assoc layer
         :prepared-tileset (or (get prepared-tilesets (:tileset layer))
                               (empty-prepared-tileset))))

(defun substitution-tile [tile-ref substitution]
  (if (= (type-of substitution) "map")
    (or (:tile substitution) tile-ref)
    (or substitution tile-ref)))

(defun substitution-render-opts [substitution render-ctx]
  (if (= (type-of substitution) "map")
    (let [render-opts (:render-opts substitution)]
      (if (= (type-of render-opts) "executable")
        (apply render-opts [render-ctx])
        (or render-opts {})))
    {}))

(defun prepared-layer-cell-tile [tilesets terrain-sets layer tile-ref tile-substitutions]
  (let [tile-ref (substitution-tile tile-ref
                                    (get (or tile-substitutions {}) tile-ref))]
    (if (= (:data-kind layer) :terrain)
      (prepared-terrain-ref tilesets terrain-sets (:terrain-set layer) tile-ref)
      (prepared-tile-ref (:prepared-tileset layer) tile-ref))))

(defun tile-stack-layer? [layer]
  (= :tile-stack (:kind layer)))

(defun prepared-tile-stack-layer? [layer]
  (= :prepared-tile-stack (:kind layer)))

(defun tile-stack-refs [cell]
  (cond
    (tm/absent-tile-ref? cell)
    []

    (= "vector" (type-of cell))
    cell

    (= "list" (type-of cell))
    cell

    :default
    [cell]))

(defun prepared-tile-stack-tiles [cell]
  (cond
    (tm/absent-tile-ref? cell)
    []

    (or (= "vector" (type-of cell))
        (= "list" (type-of cell)))
    cell

    :default
    []))

(defun stack-ref-layer [prepared-tilesets layer tile-ref]
  (if (= "map" (type-of tile-ref))
    (let [layer (merge layer
                       (select-keys tile-ref [:tileset :data-kind :terrain-set]))]
      (assoc layer
             :prepared-tileset
             (or (get prepared-tilesets (:tileset layer))
                 (empty-prepared-tileset))))
    layer))

(defun stack-ref-tile [tile-ref]
  (if (= "map" (type-of tile-ref))
    (or (:tile tile-ref)
        (:tile-ref tile-ref))
    tile-ref))

(defun map-render-rect [tilemap zoom]
  (let [size (tm/scaled-tile-size tilemap zoom)]
    {:x 0
     :y 0
     :w (* (tm/map-width tilemap) (:w size))
     :h (* (tm/map-height tilemap) (:h size))}))

(defun ceil-positive-div [value divisor]
  (let [value (max 0 value)
        q (int (/ value divisor))]
    (if (= (* q divisor) value)
      q
      (inc q))))

(defun render-axis-range [size offset tile-size max-count]
  (if (or (not size)
          (<= size 0)
          (<= tile-size 0)
          (<= max-count 0))
    {:start 0
     :end 0}
    (let [offset (or offset 0)
          start (max 0
                     (min max-count
                          (int (/ (max 0 offset) tile-size))))
          end (max 0
                   (min max-count
                        (ceil-positive-div (+ size offset) tile-size)))]
      {:start start
       :end (max start end)})))

(def empty-draw-range-padding
  {:left 0
   :right 0
   :top 0
   :bottom 0})

(defun max-draw-range-padding [a b]
  {:left (max (:left a) (:left b))
   :right (max (:right a) (:right b))
   :top (max (:top a) (:top b))
   :bottom (max (:bottom a) (:bottom b))})

(defun draw-range-padding-for-tile [tile tile-size]
  (if (and (explicit-draw-geometry? tile)
           (or (= (:type tile) :sprite)
               (= (:type tile) :image)))
    (let [dim (if (:draw-size tile)
                (:draw-size tile)
                (if (= (:type tile) :sprite)
                  (sprite-tile-dim tile)
                  (img/size (:image tile))))]
      (if (valid-dim? dim)
        (let [offset (tile-draw-offset tile)
              size (tile-draw-size tile dim)
              x (or (:x offset) 0)
              y (or (:y offset) 0)
              spill-left (max 0 (- 0 x))
              spill-top (max 0 (- 0 y))
              spill-right (max 0 (- (+ x (:w size)) (:w tile-size)))
              spill-bottom (max 0 (- (+ y (:h size)) (:h tile-size)))]
          {:left (ceil-positive-div spill-left (:w tile-size))
           :right (ceil-positive-div spill-right (:w tile-size))
           :top (ceil-positive-div spill-top (:h tile-size))
           :bottom (ceil-positive-div spill-bottom (:h tile-size))})
        empty-draw-range-padding))
    empty-draw-range-padding))

(defun draw-range-padding-for-tilesets [tilesets tile-size]
  (reduce (or tilesets [])
          empty-draw-range-padding
          (fn [padding tileset]
            (reduce (or (:tiles tileset) [])
                    padding
                    (fn [padding tile]
                      (max-draw-range-padding
                       padding
                       (draw-range-padding-for-tile tile tile-size)))))))

(defun draw-range-padding-for-prepared-layer [layer tile-size]
  (if (prepared-tile-stack-layer? layer)
    (reduce (or (:tiles layer) [])
            empty-draw-range-padding
            (fn [padding row]
              (reduce (or row [])
                      padding
                      (fn [padding cell]
                        (reduce (prepared-tile-stack-tiles cell)
                                padding
                                (fn [padding tile]
                                  (max-draw-range-padding
                                   padding
                                   (draw-range-padding-for-tile tile tile-size))))))))
    empty-draw-range-padding))

(defun draw-range-padding [tilesets layers tilemap]
  (let [tile-size (tm/tile-size tilemap)]
    (max-draw-range-padding
     (draw-range-padding-for-tilesets tilesets tile-size)
     (reduce (or layers [])
             empty-draw-range-padding
             (fn [padding layer]
               (max-draw-range-padding
                padding
                (draw-range-padding-for-prepared-layer layer tile-size)))))))

(defun pad-axis-range [range before after max-count]
  {:start (max 0 (- (:start range) before))
   :end (min max-count (+ (:end range) after))})

(defun pad-render-ranges [ranges padding tilemap]
  {:x (pad-axis-range (:x ranges)
                      (:left padding)
                      (:right padding)
                      (tm/map-width tilemap))
   :y (pad-axis-range (:y ranges)
                      (:top padding)
                      (:bottom padding)
                      (tm/map-height tilemap))})

(defun render-ranges [tilemap offset zoom target-rect]
  (let [offset (or offset tm/default-offset)
        rect (or target-rect (map-render-rect tilemap zoom))
        size (tm/scaled-tile-size tilemap zoom)]
    {:x (render-axis-range (:w rect)
                           (:x offset)
                           (:w size)
                           (tm/map-width tilemap))
     :y (render-axis-range (:h rect)
                           (:y offset)
                           (:h size)
                           (tm/map-height tilemap))}))

(defun target-render-offset [offset target-rect]
  (let [offset (or offset tm/default-offset)]
    (if target-rect
      {:x (- (:x offset) (or (:x target-rect) 0))
       :y (- (:y offset) (or (:y target-rect) 0))}
      offset)))

(defun grid-line-position [index max-count tile-size offset]
  (let [position (- (* index tile-size) (or offset 0))]
    (if (= index max-count)
      (dec position)
      position)))

(defun grid-line-span [range max-count tile-size offset]
  {:start (grid-line-position (:start range) max-count tile-size offset)
   :end (grid-line-position (:end range) max-count tile-size offset)})

(defun render-tile-ref! [tilemap tilesets prepared-tilesets terrain-sets layer offset zoom tile-substitutions x y tile-ref]
  (let [stack-layer (stack-ref-layer prepared-tilesets layer tile-ref)
        stack-tile-ref (stack-ref-tile tile-ref)
        substitution (get (or tile-substitutions {}) stack-tile-ref)
        tile (prepared-layer-cell-tile tilesets
                                       terrain-sets
                                       stack-layer
                                       stack-tile-ref
                                       tile-substitutions)
        rect (tm/tile-rect tilemap x y offset zoom)]
    (when tile
      (draw-tile! tile
                  rect
                  (substitution-render-opts substitution
                                            {:rect rect
                                             :x x
                                             :y y
                                             :tile-ref stack-tile-ref
                                             :stack-ref tile-ref
                                             :tile tile
                                             :layer stack-layer
                                             :offset offset
                                             :zoom zoom})
                  zoom))))

(defun render-prepared-tile-stack-cell! [tilemap offset zoom x y cell]
  (when (not (tm/absent-tile-ref? cell))
    (let [rect (tm/tile-rect tilemap x y offset zoom)]
      (for [tile (prepared-tile-stack-tiles cell)]
        (draw-tile! tile rect nil zoom)))))

(defun render-layer-cell! [tilemap tilesets prepared-tilesets terrain-sets layer offset zoom tile-substitutions x y cell]
  (cond
    (prepared-tile-stack-layer? layer)
    (render-prepared-tile-stack-cell! tilemap offset zoom x y cell)

    (tile-stack-layer? layer)
    (for [tile-ref (tile-stack-refs cell)]
      (render-tile-ref! tilemap
                        tilesets
                        prepared-tilesets
                        terrain-sets
                        layer
                        offset
                        zoom
                        tile-substitutions
                        x
                        y
                        tile-ref))

    :default
    (when (not (tm/absent-tile-ref? cell))
      (render-tile-ref! tilemap
                        tilesets
                        prepared-tilesets
                        terrain-sets
                        layer
                        offset
                        zoom
                        tile-substitutions
                        x
                        y
                        cell))))

(defun render-layer! [tilemap tilesets prepared-tilesets terrain-sets layer offset zoom tile-substitutions ranges]
  (let [layer (prepared-layer prepared-tilesets layer)
        tiles (:tiles layer)
        x-range (:x ranges)
        y-range (:y ranges)
        x-start (:start x-range)
        y-start (:start y-range)]
    (dotimes [dy (- (:end y-range) y-start)]
      (let [y (+ y-start dy)]
        (dotimes [dx (- (:end x-range) x-start)]
          (let [x (+ x-start dx)
                cell (layer-cell tiles x y)]
            (render-layer-cell! tilemap
                                tilesets
                                prepared-tilesets
                                terrain-sets
                                layer
                                offset
                                zoom
                                tile-substitutions
                                x
                                y
                                cell)))))))

(defun render-grid-overlay! [tilemap offset zoom ranges]
  (let [x-range (:x ranges)
        y-range (:y ranges)
        x-start (:start x-range)
        y-start (:start y-range)
        x-count (- (:end x-range) x-start)
        y-count (- (:end y-range) y-start)
        tile-size (tm/scaled-tile-size tilemap zoom)
        offset (or offset tm/default-offset)
        x-span (grid-line-span x-range
                               (tm/map-width tilemap)
                               (:w tile-size)
                               (:x offset))
        y-span (grid-line-span y-range
                               (tm/map-height tilemap)
                               (:h tile-size)
                               (:y offset))]
    (when (and (> x-count 0)
               (> y-count 0))
      (dotimes [dx (inc x-count)]
        (let [x-index (+ x-start dx)
              x (grid-line-position x-index
                                    (tm/map-width tilemap)
                                    (:w tile-size)
                                    (:x offset))]
          (r/line! {:x x :y (:start y-span)}
                   {:x x :y (:end y-span)}
                   tm/default-grid-color)))
      (dotimes [dy (inc y-count)]
        (let [y-index (+ y-start dy)
              y (grid-line-position y-index
                                    (tm/map-height tilemap)
                                    (:h tile-size)
                                    (:y offset))]
          (r/line! {:x (:start x-span) :y y}
                   {:x (:end x-span) :y y}
                   tm/default-grid-color))))))

(defun render-visible-layers! [tilemap tilesets tileset-lookup terrain-sets layers hidden-layer-indices offset zoom tile-substitutions show-grid? ranges]
  (for-indexed [index layer layers]
    (when (not (contains? hidden-layer-indices index))
      (render-layer! tilemap tilesets tileset-lookup terrain-sets layer offset zoom tile-substitutions ranges)))
  (when show-grid?
    (render-grid-overlay! tilemap offset zoom ranges)))

(defun roo-render-layers! [tilemap opts]
  (let [tilesets (render-tilesets tilemap opts)
        tileset-lookup (render-prepared-tilesets-for-tilemap tilemap opts)
        terrain-sets (or (:terrain-sets opts) [])
        layers (or (:layers opts) (:layers tilemap) [])
        hidden-layer-indices (or (:hidden-layer-indices opts) [])
        tile-substitutions (or (:tile-substitutions opts) {})
        offset (or (:offset opts) tm/default-offset)
        zoom (or (:zoom opts) tm/default-zoom)
        target-rect (:target-rect opts)
        render-offset (target-render-offset offset target-rect)
        ranges (pad-render-ranges
                (render-ranges tilemap offset zoom target-rect)
                (draw-range-padding tilesets layers tilemap)
                tilemap)]
    (if target-rect
      (r/with-clip-rect target-rect
        (render-visible-layers! tilemap
                                tilesets
                                tileset-lookup
                                terrain-sets
                                layers
                                hidden-layer-indices
                                render-offset
                                zoom
                                tile-substitutions
                                (:show-grid? opts)
                                ranges))
      (render-visible-layers! tilemap
                              tilesets
                              tileset-lookup
                              terrain-sets
                              layers
                              hidden-layer-indices
                              render-offset
                              zoom
                              tile-substitutions
                              (:show-grid? opts)
                              ranges))))

(defun render-layers! [tilemap opts]
  (let [native-rendered? (render-impl/render-layers! tilemap opts)]
    (when (not native-rendered?)
      (roo-render-layers! tilemap opts))))

(defun render-options [tileset opts]
  (assoc (or opts {}) :tilesets [tileset]))

(defun render-map! [tilemap tileset opts]
  (render-layers! tilemap (render-options tileset opts)))
