(ns pixils.tilemap.materialize
  (:require [pixils.tilemap.materialize-impl :as materialize-impl]))

(defun transition-tile-definition [request]
  (materialize-impl/transition-tile-definition request))

(defun transition-mask-diagnostics [tilemap & opts]
  (materialize-impl/transition-mask-diagnostics tilemap (or (head opts) {})))

(defun render-map [tilemap & opts]
  (materialize-impl/render-map tilemap (or (head opts) {})))

(defun render-rect [tilemap rect & opts]
  (materialize-impl/render-rect tilemap rect (or (head opts) {})))
