(ns pixils.tilemap.materialize
  (:require [pixils.tilemap.materialize-impl :as materialize-impl]
            [pixils.tilemap.model :as tm]))

(defun id-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun render-layer-id [source-layer tileset]
  (keyword (str (id-label (:id source-layer))
                "/"
                (id-label tileset))))

(def transition-tileset-id :pixils-transition-tiles)

(def transition-tile-cache-bundle :pixils-transition-cache)

(defun materialized-tilemap-base [tilemap]
  {:width (tm/map-width tilemap)
   :height (tm/map-height tilemap)
   :tile-size (tm/tile-size tilemap)})

(defun materialization-rect [tilemap rect]
  (let [map-width (tm/map-width tilemap)
        map-height (tm/map-height tilemap)
        x (max 0 (min map-width (or (:x rect) 0)))
        y (max 0 (min map-height (or (:y rect) 0)))
        w (max 0 (min (- map-width x) (or (:w rect) map-width)))
        h (max 0 (min (- map-height y) (or (:h rect) map-height)))]
    {:x x :y y :w w :h h}))

(defun materialized-tilemap-rect-base [tilemap rect]
  {:width (:w rect)
   :height (:h rect)
   :tile-size (tm/tile-size tilemap)
   :origin {:x (:x rect)
            :y (:y rect)}
   :source-rect rect})

(defun layer-cell [layer x y]
  (nth (or (nth (or (:tiles layer) []) y) []) x))

(def terrain-stamp-directions
  {:nw {:dx -1 :dy -1}
   :n {:dx 0 :dy -1}
   :ne {:dx 1 :dy -1}
   :w {:dx -1 :dy 0}
   :e {:dx 1 :dy 0}
   :sw {:dx -1 :dy 1}
   :s {:dx 0 :dy 1}
   :se {:dx 1 :dy 1}})

(defun terrain-stamp-source-layer? [ruleset layer]
  (and (= (:kind ruleset) :terrain-stamp)
       (or (= (:source-layer ruleset) (:id layer))
           (contains? (or (:source-layers ruleset) []) (:id layer))
           (and (nil? (:source-layer ruleset))
                (empty? (or (:source-layers ruleset) []))
                (= (:data-kind layer) :terrain)
                (= (:terrain-set ruleset) (:terrain-set layer))))))

(defun terrain-stamp-rulesets-for-layer [terrain-sets rulesets layer]
  (map (filter (or rulesets [])
               (fn [ruleset]
                 (terrain-stamp-source-layer? ruleset layer)))
       (fn [ruleset]
         (assoc ruleset
                :terrain-unit
                (tm/terrain-unit-for-set terrain-sets
                                         (or (:terrain-set layer)
                                             (:terrain-set ruleset)))))))

(defun terrain-unit-anchor-x [unit x]
  (* (:w unit) (int (/ x (:w unit)))))

(defun terrain-unit-anchor-y [unit y]
  (* (:h unit) (int (/ y (:h unit)))))

(defun terrain-unit-anchor-position? [unit x y]
  (and (= x (terrain-unit-anchor-x unit x))
       (= y (terrain-unit-anchor-y unit y))))

(defun terrain-unit-cell-positions [unit x y]
  (apply concat
         (dotimes [dy (:h unit)]
           (dotimes [dx (:w unit)]
             {:x (+ x dx)
              :y (+ y dy)}))))

(defun consistent-terrain-value [values]
  (let [state (reduce (or values [])
                      {:initialized? false
                       :value nil
                       :mixed? false}
                      (fn [state value]
                        (if (:mixed? state)
                          state
                          (if (:initialized? state)
                            (if (= value (:value state))
                              state
                              (assoc state :mixed? true))
                            {:initialized? true
                             :value value
                             :mixed? false}))))]
    (if (:mixed? state)
      :terrain/unknown
      (:value state))))

(defun terrain-unit-direction-offset [unit direction]
  (let [offset (get terrain-stamp-directions direction)]
    (if offset
      {:dx (* (:dx offset) (:w unit))
       :dy (* (:dy offset) (:h unit))}
      {:dx 0 :dy 0})))

(defun terrain-unit-target-position [unit direction x y]
  (let [anchor-x (terrain-unit-anchor-x unit x)
        anchor-y (terrain-unit-anchor-y unit y)
        offset (terrain-unit-direction-offset unit direction)]
    {:x (+ anchor-x (:dx offset))
     :y (+ anchor-y (:dy offset))}))

(defun terrain-unit-value-at [source-layer unit x y]
  (consistent-terrain-value
   (map (terrain-unit-cell-positions unit x y)
        (fn [pos]
          (layer-cell source-layer (:x pos) (:y pos))))))

(defun terrain-value-at-for-ruleset [source-layer ruleset direction x y]
  (let [unit (or (:terrain-unit ruleset) tm/default-terrain-unit)
        direction (or direction :center)]
    (if (and (= (:w unit) 1)
             (= (:h unit) 1))
      (if-let [offset (get terrain-stamp-directions direction)]
        (layer-cell source-layer (+ x (:dx offset)) (+ y (:dy offset)))
        (layer-cell source-layer x y))
      (if (and (= direction :center)
               (not (terrain-unit-anchor-position? unit x y)))
        nil
        (let [target (terrain-unit-target-position unit direction x y)]
          (terrain-unit-value-at source-layer unit (:x target) (:y target)))))))

(defun terrain-match-center [rule]
  (or (:terrain rule)
      (-> rule :match :center :terrain)))

(defun known-terrain-value? [value]
  (and (not (nil? value))
       (not= value :terrain/unknown)))

(defun terrain-in-condition-value? [condition value]
  (contains? (or (:terrain-in condition) []) value))

(defun terrain-match-condition-value? [center-terrain condition value]
  (case condition
    :ignore true
    :same (= value center-terrain)
    :none (nil? value)
    :any-terrain (known-terrain-value? value)
    :not-same (and (known-terrain-value? value)
                   (not= value center-terrain))
    :other-terrain (and (known-terrain-value? value)
                        (not= value center-terrain))
    :default
    (if (= (type-of condition) "map")
      (if (contains? condition :terrain-in)
        (terrain-in-condition-value? condition value)
        (= value (:terrain condition)))
      true)))

(defun terrain-stamp-rule-matches? [source-layer ruleset rule x y]
  (let [center-terrain (terrain-match-center rule)
        match (or (:match rule) {})]
    (and (= (terrain-value-at-for-ruleset source-layer
                                          ruleset
                                          :center
                                          x
                                          y)
            center-terrain)
         (reduce-kv terrain-stamp-directions
                    true
                    (fn [matched? direction offset]
                      (if (not matched?)
                        false
                        (let [condition (get match direction)]
                          (if (or (nil? condition)
                                  (= condition :ignore))
                            true
                            (terrain-match-condition-value?
                             center-terrain
                             condition
                             (terrain-value-at-for-ruleset source-layer
                                                           ruleset
                                                           direction
                                                           x
                                                           y))))))))))

(defun terrain-stamp-rules-by-center [rules]
  (reduce (or rules [])
          {}
          (fn [result rule]
            (let [center (terrain-match-center rule)]
              (assoc result
                     center
                     (concat (or (get result center) []) [rule]))))))

(defun terrain-stamp-index-ruleset [ruleset]
  (assoc ruleset
         :rules-by-center
         (or (:rules-by-center ruleset)
             (terrain-stamp-rules-by-center (:rules ruleset)))))

(defun terrain-stamp-candidate-rules [source-layer ruleset x y]
  (or (get (:rules-by-center ruleset)
           (terrain-value-at-for-ruleset source-layer ruleset :center x y))
      []))

(defun empty-tile-row [tilemap]
  (dotimes [x (tm/map-width tilemap)]
    nil))

(defun empty-tile-map [tilemap]
  (dotimes [y (tm/map-height tilemap)]
    (empty-tile-row tilemap)))

(defun output-anchor [output]
  (or (:anchor output) {:x 0 :y 0}))

(defun output-layer-tile-entries [output-layer]
  (apply concat
         (for-indexed [tile-y row (or (:tiles output-layer) [])]
           (for-indexed [tile-x tile (or row [])]
             {:x tile-x
              :y tile-y
              :tile tile
              :mask-ref (nth (or (nth (or (:transition-masks output-layer) [])
                                      tile-y) [])
                             tile-x)}))))

(defun output-layer-anchor-entry [output output-layer]
  (let [anchor (output-anchor output)]
    {:x (:x anchor)
     :y (:y anchor)
     :tile (nth (or (nth (or (:tiles output-layer) []) (:y anchor)) [])
                (:x anchor))
     :mask-ref (nth (or (nth (or (:transition-masks output-layer) [])
                             (:y anchor)) [])
                    (:x anchor))}))

(defun terrain-stamp-output-entries [ruleset output output-layer]
  (let [unit (or (:terrain-unit ruleset) tm/default-terrain-unit)]
    (if (and (= (:w unit) 1)
             (= (:h unit) 1))
      [(output-layer-anchor-entry output output-layer)]
      (output-layer-tile-entries output-layer))))

(defun terrain-stamp-output-layer-generates-layer? [ruleset output output-layer]
  (not
   (empty?
    (filter (terrain-stamp-output-entries ruleset output output-layer)
            (fn [entry]
              (not (:mask-ref entry)))))))

(defun terrain-stamp-output-tileset [ruleset output-layer]
  (or (:tileset output-layer)
      (:output-tileset ruleset)))

(defun known-tilesets? [tilemap]
  (not (nil? (:tilesets tilemap))))

(defun tile-ref-resolves? [tilemap tileset tile-ref]
  (not (nil? (tm/tile-in (:tilesets tilemap) tileset tile-ref))))

(defun terrain-stamp-output-entry-resolves? [tilemap ruleset output-layer entry]
  (if (and (not (:mask-ref entry))
           (:tile entry)
           (known-tilesets? tilemap))
    (tile-ref-resolves? tilemap
                        (terrain-stamp-output-tileset ruleset output-layer)
                        (:tile entry))
    true))

(defun terrain-stamp-output-entry-occupies-source?
  [tilemap ruleset output-layer entry]
  (let [unit (or (:terrain-unit ruleset) tm/default-terrain-unit)]
    (and (terrain-stamp-output-entry-resolves? tilemap
                                               ruleset
                                               output-layer
                                               entry)
         (if (or (:tile entry)
                 (:mask-ref entry)
                 (not (and (= (:w unit) 1)
                           (= (:h unit) 1))))
           true
           false))))

(defun mask-set-by-id [mask-sets mask-set-id]
  (head (filter (or mask-sets [])
                (fn [mask-set]
                  (= (:id mask-set) mask-set-id)))))

(defun mask-by-id [mask-set mask-id]
  (head (filter (or (:masks mask-set) [])
                (fn [mask]
                  (= (:id mask) mask-id)))))

(defun transition-mask-definition [mask-sets mask-ref]
  (let [mask-set (mask-set-by-id mask-sets (:mask-set mask-ref))
        mask (mask-by-id mask-set (:mask mask-ref))]
    (when (and mask-set mask)
      {:mask-set mask-set
       :mask mask})))

(defun transition-mask-source [mask-sets mask-ref]
  (when-let [definition (transition-mask-definition mask-sets mask-ref)]
    {:size (:mask-size (:mask-set definition))
     :source (:source (:mask definition))}))

(defun terrain-preview-tile-ref [terrain-sets terrain-set-id terrain-ref]
  (let [terrain-set (tm/terrain-set-definition terrain-sets terrain-set-id)
        terrain (tm/terrain-in terrain-sets terrain-set-id terrain-ref)]
    (when terrain
      {:tileset (tm/terrain-preview-tileset terrain-set terrain)
       :tile (tm/terrain-preview-tile terrain)})))

(defun transition-condition-terrains [condition]
  (cond
    (and (= (type-of condition) "map")
         (contains? condition :terrain-in))
    (:terrain-in condition)

    (and (= (type-of condition) "map")
         (contains? condition :terrain))
    [(:terrain condition)]

    :default
    []))

(defun first-opposing-terrain [rule]
  (let [center (terrain-match-center rule)
        match (or (:match rule) {})]
    (head
     (filter
      (apply concat
             (map [:nw :n :ne :w :e :sw :s :se]
                  (fn [direction]
                    (transition-condition-terrains (get match direction)))))
      (fn [terrain]
        (and terrain
             (not= terrain center)))))))

(defun first-opposing-terrain-at [source-layer ruleset rule x y]
  (let [center (terrain-match-center rule)
        match (or (:match rule) {})]
    (or
     (head
      (filter
       (map [:nw :n :ne :w :e :sw :s :se]
            (fn [direction]
              (let [condition (get match direction)
                    terrain (terrain-value-at-for-ruleset source-layer
                                                          ruleset
                                                          direction
                                                          x
                                                          y)]
                (when (and condition
                           (not= condition :ignore)
                           (terrain-match-condition-value? center
                                                           condition
                                                           terrain)
                           (known-terrain-value? terrain)
                           (not= terrain center))
                  terrain))))
       (fn [terrain]
         (not (nil? terrain)))))
     (first-opposing-terrain rule))))

(defun resolved-mask-source-tiles [tilemap source]
  (map (or (:tiles source) [])
       (fn [item]
         (assoc item
                :tile-definition
                (tm/tile-in (:tilesets tilemap)
                            (:tileset source)
                            (:tile item))))))

(defun resolved-transition-mask-source [tilemap mask-sets mask-ref]
  (when-let [mask-source (transition-mask-source mask-sets mask-ref)]
    (let [source (:source mask-source)]
      (assoc source
             :size (:size mask-source)
             :tiles (resolved-mask-source-tiles tilemap source)))))

(defun transition-tile-id [base-ref overlay-ref mask-ref]
  (keyword (str "transition-"
                (id-label (:tileset base-ref))
                "-"
                (id-label (:tile base-ref))
                "-"
                (id-label (:tileset overlay-ref))
                "-"
                (id-label (:tile overlay-ref))
                "-"
                (id-label (:mask-set mask-ref))
                "-"
                (id-label (:mask mask-ref)))))

(def default-transition-mask-polarity :solid-is-current)

(defun transition-mask-polarity [mask-ref]
  (if (= (:polarity mask-ref) :solid-is-opposing)
    :solid-is-opposing
    default-transition-mask-polarity))

(defun orient-transition-mask-tiles [base-ref overlay-ref mask-ref]
  (if (= (transition-mask-polarity mask-ref) :solid-is-opposing)
    {:base overlay-ref
     :overlay base-ref}
    {:base base-ref
     :overlay overlay-ref}))

(defun transition-cache-image [tile-id]
  (keyword (str (id-label transition-tile-cache-bundle)
                "/"
                (id-label tile-id))))

(defun transition-tile-definition [tilemap source-layer ruleset rule mask-ref source-x source-y]
  (let [terrain-set-id (:terrain-set ruleset)
        base-ref (terrain-preview-tile-ref (:terrain-sets tilemap)
                                           terrain-set-id
                                           (terrain-match-center rule))
        overlay-ref (terrain-preview-tile-ref (:terrain-sets tilemap)
                                              terrain-set-id
                                              (first-opposing-terrain-at source-layer
                                                                        ruleset
                                                                        rule
                                                                        source-x
                                                                        source-y))
        mask-source (resolved-transition-mask-source tilemap
                                                     (:mask-sets tilemap)
                                                     mask-ref)]
    (when (and base-ref overlay-ref mask-source)
      (let [oriented (orient-transition-mask-tiles base-ref
                                                   overlay-ref
                                                   mask-ref)
            base-ref (:base oriented)
            overlay-ref (:overlay oriented)
            tile-id (transition-tile-id base-ref overlay-ref mask-ref)]
        {:id tile-id
         :type :transition-mask
         :size (tm/tile-size tilemap)
         :base (assoc base-ref
                      :tile-definition
                      (tm/tile-in (:tilesets tilemap)
                                  (:tileset base-ref)
                                  (:tile base-ref)))
         :overlay (assoc overlay-ref
                         :tile-definition
                         (tm/tile-in (:tilesets tilemap)
                                     (:tileset overlay-ref)
                                     (:tile overlay-ref)))
         :mask mask-ref
         :mask-polarity (transition-mask-polarity mask-ref)
         :mask-source mask-source
         :image (transition-cache-image tile-id)}))))

(defun transition-diagnostic-reason-list
  [tilemap source-layer ruleset rule mask-ref source-x source-y]
  (let [terrain-set-id (:terrain-set ruleset)
        base-terrain (terrain-match-center rule)
        opposing-terrain (first-opposing-terrain-at source-layer
                                                   ruleset
                                                   rule
                                                   source-x
                                                   source-y)
        base-ref (terrain-preview-tile-ref (:terrain-sets tilemap)
                                           terrain-set-id
                                           base-terrain)
        overlay-ref (terrain-preview-tile-ref (:terrain-sets tilemap)
                                              terrain-set-id
                                              opposing-terrain)
        mask-definition (transition-mask-definition (:mask-sets tilemap) mask-ref)
        mask-source (resolved-transition-mask-source tilemap
                                                     (:mask-sets tilemap)
                                                     mask-ref)
        base-tile (when base-ref
                    (tm/tile-in (:tilesets tilemap)
                                (:tileset base-ref)
                                (:tile base-ref)))
        overlay-tile (when overlay-ref
                       (tm/tile-in (:tilesets tilemap)
                                   (:tileset overlay-ref)
                                   (:tile overlay-ref)))
        missing-mask-tiles (filter (or (:tiles mask-source) [])
                                   (fn [item]
                                     (nil? (:tile-definition item))))]
    (concat
     (if (nil? base-ref) [:missing-base-terrain-preview] [])
     (if (nil? opposing-terrain) [:missing-opposing-terrain] [])
     (if (nil? overlay-ref) [:missing-overlay-terrain-preview] [])
     (if (nil? mask-definition) [:missing-mask-definition] [])
     (if (nil? mask-source) [:missing-mask-source] [])
     (if (and mask-source (empty? (or (:tiles mask-source) [])))
       [:empty-mask-source]
       [])
     (if (and base-ref (nil? base-tile)) [:missing-base-tile-definition] [])
     (if (and overlay-ref (nil? overlay-tile))
       [:missing-overlay-tile-definition]
       [])
     (if (not (empty? missing-mask-tiles))
       [:missing-mask-source-tile-definition]
       []))))

(defun transition-mask-diagnostic-entry
  [tilemap source-layer ruleset rule entry source-x source-y]
  (let [mask-ref (:mask-ref entry)
        tile (transition-tile-definition tilemap
                                         source-layer
                                         ruleset
                                         rule
                                         mask-ref
                                         source-x
                                         source-y)
        reasons (transition-diagnostic-reason-list tilemap
                                                   source-layer
                                                   ruleset
                                                   rule
                                                   mask-ref
                                                   source-x
                                                   source-y)]
    {:source-layer (:id source-layer)
     :ruleset (:id ruleset)
     :rule (:id rule)
     :x source-x
     :y source-y
     :mask mask-ref
     :generated? (not (nil? tile))
     :generated-tile (when tile (transition-tile-ref tile))
     :reasons reasons}))

(defun transition-tile-ref [tile]
  {:tileset transition-tileset-id
   :tile (:id tile)})

(defun transition-tile-seen? [tiles tile-id]
  (not (nil? (head (filter (or tiles [])
                           (fn [tile]
                             (= (:id tile) tile-id)))))))

(defun ensure-transition-tile [state tile]
  (if (or (nil? tile)
          (transition-tile-seen? (:transition-tiles state) (:id tile)))
    state
    (update state :transition-tiles (fn [tiles]
                                      (concat (or tiles []) [tile])))))

(defun transition-entry-tile [state source-layer ruleset rule entry source-x source-y]
  (if (:mask-ref entry)
    (let [tile (transition-tile-definition (:tilemap state)
                                           source-layer
                                           ruleset
                                           rule
                                           (:mask-ref entry)
                                           source-x
                                           source-y)]
      {:state (ensure-transition-tile state tile)
       :tile (if tile (transition-tile-ref tile) (:tile entry))})
    {:state state
     :tile (:tile entry)}))

(defun same-position? [entry x y]
  (and (= (:x entry) x)
       (= (:y entry) y)))

(defun set-transition-replacement [state x y tile-ref]
  (if tile-ref
    (update state
            :transition-replacements
            (fn [replacements]
              (concat (filter (or replacements [])
                              (fn [entry]
                                (not (same-position? entry x y))))
                      [{:x x
                        :y y
                        :tile tile-ref}])))
    state))

(defun transition-replacement-at [layer x y]
  (:tile
   (head (filter (or (:transition-replacements layer) [])
                 (fn [entry]
                   (same-position? entry x y))))))

(defun stamp-output-position [source-x source-y output entry]
  (let [anchor (output-anchor output)]
    {:x (+ source-x (:x entry) (- (:x anchor)))
     :y (+ source-y (:y entry) (- (:y anchor)))}))

(defun terrain-stamp-output-layer-key [source-layer ruleset output-layer]
  (or (:target-layer output-layer)
      (keyword (str (id-label (:id source-layer))
                    "/"
                    (id-label (:id ruleset))
                    "/"
                    (id-label (or (:id output-layer)
                                  (:tileset output-layer)
                                  (:output-tileset ruleset)
                                  "output"))))))

(defun generated-layer-index [layers layer-id]
  (find-index (or layers [])
              (fn [layer]
                (= (:id layer) layer-id))))

(defun generated-layer-base [tilemap source-layer ruleset output-layer]
  (let [layer-id (terrain-stamp-output-layer-key source-layer
                                                 ruleset
                                                 output-layer)]
    {:id layer-id
     :label (or (:label output-layer) (:label ruleset) (str layer-id))
     :kind :tile
     :role :derived
     :data-kind :tile-ref
     :tileset (or (:tileset output-layer) (:output-tileset ruleset))
     :render-source-layer-id (:id source-layer)
     :ruleset (:id ruleset)
     :replaces-source? true
     :tiles (empty-tile-map tilemap)
     :source-mask (empty-tile-map tilemap)}))

(defun ensure-generated-layer [state tilemap source-layer ruleset output-layer]
  (let [layer-id (terrain-stamp-output-layer-key source-layer
                                                 ruleset
                                                 output-layer)]
    (if (nil? (generated-layer-index (:layers state) layer-id))
      (update state
              :layers
              (fn [layers]
                (concat (or layers [])
                        [(generated-layer-base tilemap
                                               source-layer
                                               ruleset
                                               output-layer)])))
      state)))

(defun set-generated-layer-cell [state layer-id x y tile source-mask?]
  (let [rect (:rect state)
        local-x (if rect (- x (:x rect)) x)
        local-y (if rect (- y (:y rect)) y)
        index (generated-layer-index (:layers state) layer-id)]
    (if (and (not (nil? index))
             (>= local-x 0)
             (< local-x (tm/map-width (:tilemap state)))
             (>= local-y 0)
             (< local-y (tm/map-height (:tilemap state))))
      (-> state
          (assoc-in [:layers index :tiles local-y local-x] tile)
          (assoc-in [:layers index :source-mask local-y local-x] source-mask?))
      state)))

(defun apply-terrain-stamp-output-entry
  [state source-layer ruleset rule output-layer entry source-x source-y]
  (let [pos (stamp-output-position source-x source-y (:output rule) entry)
        resolved (transition-entry-tile state
                                        source-layer
                                        ruleset
                                        rule
                                        entry
                                        source-x
                                        source-y)
        state (:state resolved)
        layer-id (terrain-stamp-output-layer-key source-layer
                                                 ruleset
                                                 output-layer)]
    (if (:mask-ref entry)
      (set-transition-replacement state
                                  (:x pos)
                                  (:y pos)
                                  (:tile resolved))
      (set-generated-layer-cell state
                                layer-id
                                (:x pos)
                                (:y pos)
                                (:tile resolved)
                                (terrain-stamp-output-entry-occupies-source?
                                 (:tilemap state)
                                 ruleset
                                 output-layer
                                 entry)))))

(defun apply-terrain-stamp-output-layer
  [state source-layer ruleset rule output-layer source-x source-y]
  (let [state (if (terrain-stamp-output-layer-generates-layer?
                   ruleset
                   (:output rule)
                   output-layer)
                (ensure-generated-layer state
                                        (:tilemap state)
                                        source-layer
                                        ruleset
                                        output-layer)
                state)]
    (reduce (terrain-stamp-output-entries ruleset (:output rule) output-layer)
            state
            (fn [out entry]
              (apply-terrain-stamp-output-entry out
                                                source-layer
                                                ruleset
                                                rule
                                                output-layer
                                                entry
                                                source-x
                                                source-y)))))

(defun apply-terrain-stamp-rule [state source-layer ruleset rule source-x source-y]
  (reduce (or (-> rule :output :layers) [])
          state
          (fn [out output-layer]
            (apply-terrain-stamp-output-layer out
                                              source-layer
                                              ruleset
                                              rule
                                              output-layer
                                              source-x
                                              source-y))))

(defun apply-terrain-stamp-rules-at [state source-layer ruleset x y]
  (:state
   (reduce (terrain-stamp-candidate-rules source-layer ruleset x y)
           {:state state
            :done? false}
           (fn [result rule]
             (if (:done? result)
               result
               (if (terrain-stamp-rule-matches? source-layer ruleset rule x y)
                 {:state (apply-terrain-stamp-rule (:state result)
                                                   source-layer
                                                   ruleset
                                                   rule
                                                   x
                                                   y)
                  :done? (= (:exclusive? rule) true)}
                 result))))))

(defun materialize-terrain-stamp-layers-for-ruleset [tilemap source-layer ruleset]
  (reduce (apply concat
                 (dotimes [y (tm/map-height tilemap)]
                   (dotimes [x (tm/map-width tilemap)]
                     {:x x :y y})))
          {:tilemap tilemap
           :layers []
           :transition-tiles []
           :transition-replacements []}
          (fn [state pos]
            (apply-terrain-stamp-rules-at state
                                          source-layer
                                          (terrain-stamp-index-ruleset ruleset)
                                          (:x pos)
                                          (:y pos)))))

(defun terrain-stamp-output-layer-seen? [layers layer-id]
  (not
   (nil?
    (head (filter (or layers [])
                  (fn [layer]
                    (= (:id layer) layer-id)))))))

(defun terrain-stamp-ruleset-output-layers [source-layer ruleset]
  (:layers
   (reduce (or (:rules ruleset) [])
           {:layers []}
           (fn [state rule]
             (reduce (or (-> rule :output :layers) [])
                     state
                     (fn [out output-layer]
                       (let [layer-id (terrain-stamp-output-layer-key source-layer
                                                                      ruleset
                                                                      output-layer)]
                         (if (or (not (terrain-stamp-output-layer-generates-layer?
                                       ruleset
                                       (:output rule)
                                       output-layer))
                                 (terrain-stamp-output-layer-seen? (:layers out)
                                                                   layer-id))
                           out
                           (update out
                                   :layers
                                   (fn [layers]
                                     (concat (or layers [])
                                             [output-layer])))))))))))

(defun ensure-generated-output-layers [state source-layer ruleset]
  (reduce (terrain-stamp-ruleset-output-layers source-layer ruleset)
          state
          (fn [out output-layer]
            (ensure-generated-layer out
                                    (:tilemap out)
                                    source-layer
                                    ruleset
                                    output-layer))))

(defun materialize-terrain-stamp-layers-for-ruleset-rect
  [tilemap source-layer ruleset rect]
  (reduce (apply concat
                 (dotimes [dy (:h rect)]
                   (dotimes [dx (:w rect)]
                     {:x (+ (:x rect) dx)
                      :y (+ (:y rect) dy)})))
          (ensure-generated-output-layers
           {:tilemap (assoc tilemap
                            :width (:w rect)
                            :height (:h rect)
                            :tile-size (tm/tile-size tilemap))
            :rect rect
            :layers []
            :transition-tiles []
            :transition-replacements []}
           source-layer
           ruleset)
          (fn [state pos]
            (apply-terrain-stamp-rules-at state
                                          source-layer
                                          (terrain-stamp-index-ruleset ruleset)
                                          (:x pos)
                                          (:y pos)))))

(defun materialize-terrain-stamp-layers [tilemap terrain-sets rulesets layer]
  (reduce (terrain-stamp-rulesets-for-layer terrain-sets rulesets layer)
          {:layers []
           :transition-tiles []
           :transition-replacements []}
          (fn [state ruleset]
            (let [result (materialize-terrain-stamp-layers-for-ruleset tilemap
                                                                       layer
                                                                       ruleset)]
              {:layers (concat (:layers state) (:layers result))
               :transition-tiles (concat (:transition-tiles state)
                                         (:transition-tiles result))
               :transition-replacements
               (concat (:transition-replacements state)
                       (:transition-replacements result))}))))

(defun materialize-terrain-stamp-layers-rect [tilemap terrain-sets rulesets layer rect]
  (reduce (terrain-stamp-rulesets-for-layer terrain-sets rulesets layer)
          {:layers []
           :transition-tiles []
           :transition-replacements []}
          (fn [state ruleset]
            (let [result (materialize-terrain-stamp-layers-for-ruleset-rect
                          tilemap
                          layer
                          ruleset
                          rect)]
              {:layers (concat (:layers state) (:layers result))
               :transition-tiles (concat (:transition-tiles state)
                                         (:transition-tiles result))
               :transition-replacements
               (concat (:transition-replacements state)
                       (:transition-replacements result))}))))

(defun generated-source-mask-cell? [generated-layers x y]
  (not
   (nil?
    (head (filter (or generated-layers [])
                  (fn [layer]
                    (= (get-in layer [:source-mask y x]) true)))))))

(defun mask-terrain-layer-row [generated-layers y row]
  (for-indexed [x terrain-ref (or row [])]
    (if (generated-source-mask-cell? generated-layers x y)
      nil
      terrain-ref)))

(defun mask-terrain-layer-with-generated [layer generated-layers transition-replacements]
  (if (= (:data-kind layer) :terrain)
    (assoc layer
           :transition-replacements transition-replacements
           :tiles (for-indexed [y row (or (:tiles layer) [])]
                    (mask-terrain-layer-row generated-layers y row)))
    layer))

(defun layer-rect-row [layer rect dy]
  (let [source-y (+ (:y rect) dy)]
    (dotimes [dx (:w rect)]
      (layer-cell layer (+ (:x rect) dx) source-y))))

(defun layer-rect-tiles [layer rect]
  (dotimes [dy (:h rect)]
    (layer-rect-row layer rect dy)))

(defun terrain-preview-ref [terrain-sets terrain-set terrain-ref]
  (when (not (tm/absent-tile-ref? terrain-ref))
    (let [terrain-set-definition (tm/terrain-set-definition terrain-sets
                                                            terrain-set)
          terrain (tm/terrain-in terrain-sets terrain-set terrain-ref)]
      (when terrain
        {:tileset (tm/terrain-preview-tileset terrain-set-definition terrain)
         :tile (tm/terrain-preview-tile terrain)}))))

(defun add-unique-tileset [tilesets tileset]
  (if (and tileset
           (not (contains? tilesets tileset)))
    (concat tilesets [tileset])
    tilesets))

(defun terrain-definition-preview-tilesets [terrain-sets terrain-set]
  (let [terrain-set-definition (tm/terrain-set-definition terrain-sets
                                                          terrain-set)]
    (reduce (tm/terrain-definitions terrain-sets terrain-set)
            []
            (fn [tilesets terrain]
              (add-unique-tileset
               tilesets
               (tm/terrain-preview-tileset terrain-set-definition terrain))))))

(defun terrain-layer-preview-tilesets [terrain-sets layer]
  (let [definition-tilesets (terrain-definition-preview-tilesets
                             terrain-sets
                             (:terrain-set layer))
        replacement-tilesets (if (empty? (or (:transition-replacements layer) []))
                               []
                               [transition-tileset-id])]
    (concat (if (not (empty? definition-tilesets))
              definition-tilesets
              (reduce (or (:tiles layer) [])
                      []
                      (fn [tilesets row]
                        (reduce (or row [])
                                tilesets
                                (fn [tilesets terrain-ref]
                                  (let [preview (terrain-preview-ref
                                                 terrain-sets
                                                 (:terrain-set layer)
                                                 terrain-ref)]
                                    (add-unique-tileset tilesets
                                                        (:tileset preview))))))))
            replacement-tilesets)))

(defun terrain-layer-row-for-tileset [terrain-sets layer tileset y row]
  (for-indexed [x terrain-ref (or row [])]
    (let [replacement (transition-replacement-at layer x y)
          preview (terrain-preview-ref terrain-sets
                                       (:terrain-set layer)
                                       terrain-ref)]
      (cond
        (= (:tileset replacement) tileset)
        replacement

        replacement
        nil

        (= (:tileset preview) tileset)
        (:tile preview)

        :default
        nil))))

(defun terrain-layer-rect-preview-tilesets [terrain-sets layer rect]
  (let [definition-tilesets (terrain-definition-preview-tilesets
                             terrain-sets
                             (:terrain-set layer))
        replacement-tilesets (if (empty? (or (:transition-replacements layer) []))
                               []
                               [transition-tileset-id])]
    (concat (if (not (empty? definition-tilesets))
              definition-tilesets
              (reduce (range 0 (dec (:h rect)))
                      []
                      (fn [tilesets dy]
                        (reduce (range 0 (dec (:w rect)))
                                tilesets
                                (fn [tilesets dx]
                                  (let [preview (terrain-preview-ref
                                                 terrain-sets
                                                 (:terrain-set layer)
                                                 (layer-cell layer
                                                             (+ (:x rect) dx)
                                                             (+ (:y rect) dy)))]
                                    (add-unique-tileset tilesets
                                                        (:tileset preview))))))))
            replacement-tilesets)))

(defun terrain-layer-rect-row-for-tileset [terrain-sets layer tileset rect dy]
  (let [source-y (+ (:y rect) dy)]
    (dotimes [dx (:w rect)]
      (let [source-x (+ (:x rect) dx)
            replacement (transition-replacement-at layer source-x source-y)
            preview (terrain-preview-ref terrain-sets
                                         (:terrain-set layer)
                                         (layer-cell layer
                                                     source-x
                                                     source-y))]
        (cond
          (= (:tileset replacement) tileset)
          replacement

          replacement
          nil

          (= (:tileset preview) tileset)
          (:tile preview)

          :default
          nil)))))

(defun terrain-layer-rect-tiles-for-tileset [terrain-sets layer tileset rect]
  (dotimes [dy (:h rect)]
    (terrain-layer-rect-row-for-tileset terrain-sets
                                        layer
                                        tileset
                                        rect
                                        dy)))

(defun materialize-terrain-layer-for-tileset [terrain-sets layer tileset split?]
  (assoc layer
         :id (if split?
               (render-layer-id layer tileset)
               (:id layer))
         :render-source-layer-id (:id layer)
         :data-kind :tile-ref
         :tileset tileset
         :tiles (for-indexed [y row (or (:tiles layer) [])]
                       (terrain-layer-row-for-tileset terrain-sets
                                                      layer
                                                      tileset
                                                      y
                                                      row))))

(defun materialize-terrain-layer [terrain-sets layer]
  (let [tilesets (terrain-layer-preview-tilesets terrain-sets layer)
        split? (> (count tilesets) 1)]
    (if (empty? tilesets)
      [(assoc layer
              :data-kind :tile-ref
              :tileset nil)]
      (map tilesets
           (fn [tileset]
             (materialize-terrain-layer-for-tileset terrain-sets
                                                    layer
                                                    tileset
                                                    split?))))))

(defun materialize-layer [terrain-sets layer]
  (if (= (:data-kind layer) :terrain)
    (materialize-terrain-layer terrain-sets layer)
    [(assoc layer
            :data-kind (or (:data-kind layer) :tile-ref))]))

(defun materialize-terrain-layer-rect-for-tileset [terrain-sets layer tileset rect split?]
  (assoc layer
         :id (if split?
               (render-layer-id layer tileset)
               (:id layer))
         :render-source-layer-id (:id layer)
         :render-source-rect rect
         :data-kind :tile-ref
         :tileset tileset
         :tiles (terrain-layer-rect-tiles-for-tileset terrain-sets
                                                      layer
                                                      tileset
                                                      rect)))

(defun materialize-terrain-layer-rect [terrain-sets layer rect]
  (let [tilesets (terrain-layer-rect-preview-tilesets terrain-sets layer rect)
        split? (> (count tilesets) 1)]
    (if (empty? tilesets)
      [(assoc layer
              :render-source-layer-id (:id layer)
              :render-source-rect rect
              :data-kind :tile-ref
              :tileset nil
              :tiles (layer-rect-tiles layer rect))]
      (map tilesets
           (fn [tileset]
             (materialize-terrain-layer-rect-for-tileset terrain-sets
                                                         layer
                                                         tileset
                                                         rect
                                                         split?))))))

(defun materialize-layer-rect [terrain-sets layer rect]
  (if (= (:data-kind layer) :terrain)
    (materialize-terrain-layer-rect terrain-sets layer rect)
    [(assoc layer
            :render-source-rect rect
            :data-kind (or (:data-kind layer) :tile-ref)
            :tiles (layer-rect-tiles layer rect))]))

(defun generated-source-mask-local-cell? [generated-layers x y]
  (not
   (nil?
    (head (filter (or generated-layers [])
                  (fn [layer]
                    (= (get-in layer [:source-mask y x]) true)))))))

(defun mask-terrain-layer-rect-row [layer generated-layers rect dy]
  (let [source-y (+ (:y rect) dy)]
    (dotimes [dx (:w rect)]
      (let [terrain-ref (layer-cell layer (+ (:x rect) dx) source-y)]
        (if (generated-source-mask-local-cell? generated-layers dx dy)
          nil
          terrain-ref)))))

(defun transition-replacement-in-rect? [replacement rect]
  (and (>= (:x replacement) (:x rect))
       (< (:x replacement) (+ (:x rect) (:w rect)))
       (>= (:y replacement) (:y rect))
       (< (:y replacement) (+ (:y rect) (:h rect)))))

(defun local-transition-replacement [replacement rect]
  (assoc replacement
         :x (- (:x replacement) (:x rect))
         :y (- (:y replacement) (:y rect))))

(defun local-transition-replacements [transition-replacements rect]
  (map (filter (or transition-replacements [])
               (fn [replacement]
                 (transition-replacement-in-rect? replacement rect)))
       (fn [replacement]
         (local-transition-replacement replacement rect))))

(defun mask-terrain-layer-rect [layer generated-layers transition-replacements rect]
  (assoc layer
         :render-source-rect rect
         :transition-replacements (local-transition-replacements
                                   transition-replacements
                                   rect)
         :tiles (dotimes [dy (:h rect)]
                  (mask-terrain-layer-rect-row layer
                                               generated-layers
                                               rect
                                               dy))))

(defun materialize-layer-with-rules-rect
  [tilemap terrain-sets rulesets show-rules? layer rect]
  (let [generated (if (and show-rules?
                           (= (:data-kind layer) :terrain))
                    (materialize-terrain-stamp-layers-rect tilemap
                                                           terrain-sets
                                                           rulesets
                                                           layer
                                                           rect)
                    {:layers []
                     :transition-tiles []})
        generated-layers (:layers generated)
        source-layer (if (= (:data-kind layer) :terrain)
                       (mask-terrain-layer-rect layer
                                                generated-layers
                                                (:transition-replacements generated)
                                                rect)
                       layer)]
    {:layers (concat (if (= (:data-kind layer) :terrain)
                       (map (materialize-layer terrain-sets source-layer)
                            (fn [layer]
                              (assoc layer :render-source-rect rect)))
                       (materialize-layer-rect terrain-sets source-layer rect))
                     generated-layers)
     :transition-tiles (:transition-tiles generated)}))

(defun materialize-layer-with-rules [tilemap terrain-sets rulesets show-rules? layer]
  (let [generated (if (and show-rules?
                           (= (:data-kind layer) :terrain))
                    (materialize-terrain-stamp-layers tilemap
                                                      terrain-sets
                                                      rulesets
                                                      layer)
                    {:layers []
                     :transition-tiles []})
        generated-layers (:layers generated)
        source-layer (mask-terrain-layer-with-generated
                      layer
                      generated-layers
                      (:transition-replacements generated))]
    {:layers (concat (materialize-layer terrain-sets source-layer)
                     generated-layers)
     :transition-tiles (:transition-tiles generated)}))

(defun transition-mask-diagnostics-for-rule
  [tilemap source-layer ruleset rule source-x source-y]
  (apply concat
         (map (or (-> rule :output :layers) [])
              (fn [output-layer]
                (map (filter (terrain-stamp-output-entries ruleset
                                                           (:output rule)
                                                           output-layer)
                             (fn [entry]
                               (not (nil? (:mask-ref entry)))))
                     (fn [entry]
                       (transition-mask-diagnostic-entry tilemap
                                                         source-layer
                                                         ruleset
                                                         rule
                                                         entry
                                                         source-x
                                                         source-y)))))))

(defun transition-mask-diagnostics-at [tilemap source-layer ruleset x y]
  (:entries
   (reduce (terrain-stamp-candidate-rules source-layer ruleset x y)
           {:entries []
            :done? false}
           (fn [state rule]
             (if (:done? state)
               state
               (if (terrain-stamp-rule-matches? source-layer ruleset rule x y)
                 {:entries (concat (:entries state)
                                   (transition-mask-diagnostics-for-rule
                                    tilemap
                                    source-layer
                                    ruleset
                                    rule
                                    x
                                    y))
                  :done? (= (:exclusive? rule) true)}
                 state))))))

(defun transition-mask-diagnostics-for-ruleset [tilemap source-layer ruleset]
  (apply concat
         (apply concat
                (dotimes [y (tm/map-height tilemap)]
                  (dotimes [x (tm/map-width tilemap)]
                    (transition-mask-diagnostics-at
                     tilemap
                     source-layer
                     (terrain-stamp-index-ruleset ruleset)
                     x
                     y))))))

(defun transition-mask-diagnostics-for-layer [tilemap terrain-sets rulesets layer]
  (apply concat
         (map (terrain-stamp-rulesets-for-layer terrain-sets rulesets layer)
              (fn [ruleset]
                (transition-mask-diagnostics-for-ruleset tilemap
                                                         layer
                                                         ruleset)))))

(defun transition-mask-diagnostic-summary [entries]
  {:matched-transition-entries (count entries)
   :generated-transition-entries
   (count (filter entries
                  (fn [entry]
                    (:generated? entry))))
   :failed-transition-entries
   (count (filter entries
                  (fn [entry]
                    (not (:generated? entry)))))
   :warning-transition-entries
   (count (filter entries
                  (fn [entry]
                    (not (empty? (:reasons entry))))))})

(defun transition-mask-diagnostics [tilemap & opts]
  (let [opts (or (head opts) {})
        source-tilemap (materialization-source-tilemap tilemap opts)
        layers (or (:layers opts) (:layers tilemap))
        terrain-sets (:terrain-sets source-tilemap)
        rulesets (:rulesets source-tilemap)
        entries (apply concat
                       (map (or layers [])
                            (fn [layer]
                              (if (= (:data-kind layer) :terrain)
                                (transition-mask-diagnostics-for-layer
                                 source-tilemap
                                 terrain-sets
                                 rulesets
                                 layer)
                                []))))]
    (assoc (transition-mask-diagnostic-summary entries)
           :has-transition-mask-rules?
           (materialization-has-transition-masks? tilemap opts)
           :entries entries)))

(defun materialize-layers [tilemap layers terrain-sets rulesets show-rules?]
  (reduce (or layers [])
          {:layers []
           :transition-tiles []}
          (fn [state layer]
            (let [result (materialize-layer-with-rules tilemap
                                                       terrain-sets
                                                       rulesets
                                                       show-rules?
                                                       layer)]
              {:layers (concat (:layers state) (:layers result))
               :transition-tiles (concat (:transition-tiles state)
                                         (:transition-tiles result))}))))

(defun tile-substitution-rule-source-tile [rule]
  (or (:tile rule)
      (:source rule)
      (:from rule)))

(defun tile-substitution-rule-choices [rule]
  (or (:choices rule)
      (:variants rule)
      (:tiles rule)
      []))

(defun tile-substitution-rule-algorithm [rule]
  (or (:algorithm rule) :weighted-random))

(defun tile-substitution-choice-tile [choice]
  (if (= (type-of choice) "map")
    (or (:tile choice)
        (:tile-ref choice))
    choice))

(defun tile-substitution-choice-weight [choice]
  (let [weight (if (= (type-of choice) "map")
                 (:weight choice)
                 1)]
    (max 0 (or weight 1))))

(defun tile-substitution-rule-matches? [layer tile-ref rule]
  (and (= (:tileset layer) (:tileset rule))
       (= tile-ref (tile-substitution-rule-source-tile rule))))

(defun tile-substitution-rules-for-cell [rules layer tile-ref]
  (filter (or rules [])
          (fn [rule]
            (tile-substitution-rule-matches? layer tile-ref rule))))

(defun weighted-tile-substitution-choices [rule]
  (filter (tile-substitution-rule-choices rule)
          (fn [choice]
            (and (not (tm/absent-tile-ref? (tile-substitution-choice-tile choice)))
                 (> (tile-substitution-choice-weight choice) 0)))))

(defun weighted-tile-substitution-total [choices]
  (reduce (or choices [])
          0
          (fn [total choice]
            (+ total (tile-substitution-choice-weight choice)))))

(defun positive-mod [value divisor]
  (mod (+ (mod value divisor) divisor) divisor))

(defun stable-tile-substitution-bucket [seed x y total]
  (let [hash-mod 1000003
        source (positive-mod (+ (* (+ (or seed 0) 1) 374761)
                                (* (+ x 1) 668263)
                                (* (+ y 1) 982451)
                                (* (+ x 3) (+ y 5) 154858))
                             hash-mod)
        mixed (positive-mod (+ (* source (+ source 127417))
                               (* (+ x 1) (+ x 7) 524287)
                               (* (+ y 1) (+ y 11) 8191))
                            hash-mod)]
    (positive-mod mixed total)))

(defun weighted-tile-substitution-choice [choices bucket]
  (:choice
   (reduce choices
           {:bucket bucket
            :choice nil}
           (fn [state choice]
             (if (:choice state)
               state
               (let [weight (tile-substitution-choice-weight choice)]
                 (if (< (:bucket state) weight)
                   (assoc state :choice choice)
                   (update state :bucket (fn [value] (- value weight))))))))))

(defun apply-weighted-random-tile-substitution-rule [rule tile-ref x y]
  (let [choices (weighted-tile-substitution-choices rule)
        total (weighted-tile-substitution-total choices)]
    (if (> total 0)
      (or (tile-substitution-choice-tile
           (weighted-tile-substitution-choice
            choices
            (stable-tile-substitution-bucket (:seed rule) x y total)))
          tile-ref)
      tile-ref)))

(defun apply-tile-substitution-rule [rule tile-ref x y]
  (case (tile-substitution-rule-algorithm rule)
    :weighted-random (apply-weighted-random-tile-substitution-rule
                      rule
                      tile-ref
                      x
                      y)
    :default tile-ref))

(defun apply-tile-substitution-rules-to-cell [rules layer tile-ref x y]
  (let [rule (head (tile-substitution-rules-for-cell rules layer tile-ref))]
    (if rule
      (apply-tile-substitution-rule rule tile-ref x y)
      tile-ref)))

(defun apply-tile-substitution-rules-to-row [rules layer origin y row]
  (for-indexed [x tile-ref (or row [])]
    (if (tm/absent-tile-ref? tile-ref)
      tile-ref
      (apply-tile-substitution-rules-to-cell rules
                                             layer
                                             tile-ref
                                             (+ (:x origin) x)
                                             (+ (:y origin) y)))))

(defun apply-tile-substitution-rules-to-layer [rules layer origin]
  (if (= (:data-kind layer) :tile-ref)
    (assoc layer
           :tiles (for-indexed [y row (or (:tiles layer) [])]
                    (apply-tile-substitution-rules-to-row rules
                                                          layer
                                                          origin
                                                          y
                                                          row)))
    layer))

(defun apply-tile-substitution-rules-to-layers [rules layers origin]
  (if (empty? (or rules []))
    layers
    (map (or layers [])
         (fn [layer]
           (apply-tile-substitution-rules-to-layer rules
                                                   layer
                                                   (or origin {:x 0 :y 0}))))))

(defun tile-substitution-config [tile]
  (or (:substitution tile)
      (:tile-substitution tile)
      (:substitutions tile)))

(defun tile-substitution-rule-from-tile [tileset tile]
  (let [config (tile-substitution-config tile)]
    (when (and (= (type-of config) "map")
               (not (empty? (tile-substitution-rule-choices config))))
      (assoc config
             :tileset (:id tileset)
             :tile (:id tile)))))

(defun tile-substitution-rules-from-tileset [tileset]
  (filter (map (or (:tiles tileset) [])
               (fn [tile]
                 (tile-substitution-rule-from-tile tileset tile)))
          (fn [rule]
            (not (nil? rule)))))

(defun tile-substitution-rules-from-tilesets [tilesets]
  (apply concat
         (map (or tilesets [])
              tile-substitution-rules-from-tileset)))

(defun materialize-tile-substitution-rules [tilemap opts]
  (concat (or (:tile-substitution-rules opts)
              (:tile-substitution-rules tilemap)
              [])
          (tile-substitution-rules-from-tilesets
           (or (:tilesets opts)
               (:tilesets tilemap)))))

(defun materialize-show-terrain-rules? [tilemap opts]
  (not= (if (contains? opts :show-terrain-rules?)
          (:show-terrain-rules? opts)
          (:show-terrain-rules? tilemap))
        false))

(defun transition-mask-rows-empty? [rows]
  (= 0
     (count (filter (apply concat (or rows []))
                    (fn [cell]
                      (not (nil? cell)))))))

(defun output-layer-has-transition-masks? [output-layer]
  (not (transition-mask-rows-empty? (:transition-masks output-layer))))

(defun rule-has-transition-masks? [rule]
  (not
   (nil?
    (head (filter (or (-> rule :output :layers) [])
                  output-layer-has-transition-masks?)))))

(defun ruleset-has-transition-masks? [ruleset]
  (not
   (nil?
    (head (filter (or (:rules ruleset) [])
                  rule-has-transition-masks?)))))

(defun materialization-has-transition-masks? [tilemap opts]
  (not
   (nil?
    (head (filter (or (:rulesets opts)
                      (:rulesets tilemap)
                      [])
                  ruleset-has-transition-masks?)))))

(defun unique-transition-tiles [tiles]
  (:tiles
   (reduce (or tiles [])
           {:ids []
            :tiles []}
           (fn [state tile]
             (if (contains? (:ids state) (:id tile))
               state
               {:ids (concat (:ids state) [(:id tile)])
                :tiles (concat (:tiles state) [tile])})))))

(defun generated-transition-tilesets [tiles]
  (let [tiles (unique-transition-tiles tiles)]
    (if (empty? tiles)
      []
      [{:id transition-tileset-id
        :label "Generated transition tiles"
        :tiles tiles}])))

(defun materialization-source-tilemap [tilemap opts]
  (assoc tilemap
         :tilesets (or (:tilesets opts) (:tilesets tilemap))
         :terrain-sets (or (:terrain-sets opts) (:terrain-sets tilemap))
         :rulesets (or (:rulesets opts) (:rulesets tilemap))
         :mask-sets (or (:mask-sets opts) (:mask-sets tilemap))
         :tile-substitution-rules (or (:tile-substitution-rules opts)
                                      (:tile-substitution-rules tilemap))))

(defun materialized-map-with-layers [base source-tilemap layers-result layers origin opts]
  (let [layers (apply-tile-substitution-rules-to-layers
                (materialize-tile-substitution-rules source-tilemap opts)
                layers
                origin)
        tilesets (generated-transition-tilesets
                  (:transition-tiles layers-result))]
    (assoc (if (empty? tilesets)
             base
             (assoc base :tilesets tilesets))
           :layers layers)))

(defun roo-materialize-render-map [tilemap & opts]
  (let [opts (or (head opts) {})
        source-tilemap (materialization-source-tilemap tilemap opts)
        layers-result (materialize-layers
                       source-tilemap
                       (or (:layers opts) (:layers tilemap))
                       (:terrain-sets source-tilemap)
                       (:rulesets source-tilemap)
                       (materialize-show-terrain-rules? tilemap opts))]
    (materialized-map-with-layers (materialized-tilemap-base tilemap)
                                  source-tilemap
                                  layers-result
                                  (:layers layers-result)
                                  {:x 0 :y 0}
                                  opts)))

(defun materialize-render-map [tilemap & opts]
  (let [opts (or (head opts) {})]
    (if (materialization-has-transition-masks? tilemap opts)
      (roo-materialize-render-map tilemap opts)
      (or (materialize-impl/materialize-render-map tilemap opts)
          (roo-materialize-render-map tilemap opts)))))

(defun materialize-render-rect [tilemap rect & opts]
  (let [opts (or (head opts) {})
        rect (materialization-rect tilemap rect)
        source-tilemap (materialization-source-tilemap tilemap opts)
        layers-result (reduce (or (:layers opts)
                                  (:layers tilemap))
                              {:layers []
                               :transition-tiles []}
                              (fn [state layer]
                                (let [result (materialize-layer-with-rules-rect
                                              source-tilemap
                                              (:terrain-sets source-tilemap)
                                              (:rulesets source-tilemap)
                                              (materialize-show-terrain-rules?
                                               tilemap
                                               opts)
                                              layer
                                              rect)]
                                  {:layers (concat (:layers state)
                                                   (:layers result))
                                   :transition-tiles
                                   (concat (:transition-tiles state)
                                           (:transition-tiles result))})))]
    (materialized-map-with-layers (materialized-tilemap-rect-base tilemap rect)
                                  source-tilemap
                                  layers-result
                                  (:layers layers-result)
                                  {:x (:x rect) :y (:y rect)}
                                  opts)))
