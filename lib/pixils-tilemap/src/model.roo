(ns pixils.tilemap.model
  (:require [pixils.point :as pt]
            [pixils.rect :as rect]))

(def default-tile-size 16)

(def default-offset
  {:x 0
   :y 0})

(def default-zoom 1)

(def default-missing-tile-color
  {:r 0xff
   :g 0x00
   :b 0xff})

(def default-image-tile-background-color
  {:r 0x12
   :g 0x15
   :b 0x18})

(def default-grid-color
  {:r 0x12
   :g 0x15
   :b 0x18})

(def default-terrain-unit
  {:w 1
   :h 1})

(def property-type-options [:any :enum :number])

(def default-property-type :any)

(defun serialized-nil? [value]
  (and (= (type-of value) "symbol")
       (= (str value) "nil")))

(defun absent-tile-ref? [tile-ref]
  (or (nil? tile-ref)
      (serialized-nil? tile-ref)))

(defun tile-size [tilemap]
  (or (:tile-size tilemap) default-tile-size))

(defun scaled-tile-size [tilemap zoom]
  (* (tile-size tilemap) (or zoom default-zoom)))

(defun map-width [tilemap]
  (or (:width tilemap) 0))

(defun map-height [tilemap]
  (or (:height tilemap) 0))

(defun filled-layer [tilemap opts]
  (let [tile-ref (:tile opts)]
    (dissoc (assoc opts
                   :kind (or (:kind opts) :tile)
                   :data-kind (or (:data-kind opts) :tile-ref)
                   :tiles (dotimes [y (map-height tilemap)]
                            (dotimes [x (map-width tilemap)]
                              tile-ref)))
            :tile)))

(defun add-layer [tilemap layer]
  (update tilemap :layers (fn [layers]
                            (concat (or layers []) [layer]))))

(defun layer-index [tilemap layer-id]
  (find-index (or (:layers tilemap) [])
              (fn [layer]
                (= (:id layer) layer-id))))

(defun layer [tilemap layer-id]
  (if-let [index (layer-index tilemap layer-id)]
    (nth (:layers tilemap) index)
    nil))

(defun layer-cell [tilemap layer-id pos]
  (when (in-bounds? tilemap pos)
    (if-let [layer (layer tilemap layer-id)]
      (get-in layer [:tiles (:y pos) (:x pos)])
      nil)))

(defun set-layer-cell [tilemap layer-id pos tile-ref]
  (if-let [index (layer-index tilemap layer-id)]
    (assoc-in tilemap [:layers index :tiles (:y pos) (:x pos)] tile-ref)
    tilemap))

(defun apply-layer-cell-patch [tilemap layer-id patch]
  (let [pos (:pos patch)]
    (if (in-bounds? tilemap pos)
      (set-layer-cell tilemap
                      layer-id
                      pos
                      (if (contains? patch :value)
                        (:value patch)
                        (:tile patch)))
      tilemap)))

(defun apply-layer-cell-patches [tilemap layer-id patches]
  (reduce (or patches [])
          tilemap
          (fn [tilemap patch]
            (apply-layer-cell-patch tilemap layer-id patch))))

(defun apply-layer-patch [tilemap patch]
  (apply-layer-cell-patches tilemap
                            (:layer-id patch)
                            (:cells patch)))

(defun apply-layer-patches [tilemap patches]
  (reduce (or patches [])
          tilemap
          (fn [tilemap patch]
            (apply-layer-patch tilemap patch))))

(defun remove-layer [tilemap layer-id]
  (update tilemap :layers (fn [layers]
                            (filter (or layers [])
                                    (fn [layer]
                                      (not= (:id layer) layer-id))))))

(defun map-rect [tilemap]
  (rect/make-rect {:x 0
                   :y 0
                   :w (map-width tilemap)
                   :h (map-height tilemap)}))

(defun map-point [pos]
  (if (= (type-of pos) "map")
    (pt/make-point pos)
    pos))

(defun in-bounds? [tilemap pos]
  (rect/inside? (map-rect tilemap)
                (map-point pos)))

(defun tile-rect [tilemap x y offset zoom]
  (let [offset (or offset default-offset)
        size (scaled-tile-size tilemap zoom)]
    {:x (- (* x size) (:x offset))
     :y (- (* y size) (:y offset))
     :w size
     :h size}))

(defun tileset-definition [tilesets tileset]
  (head (filter (or tilesets [])
                (fn [item]
                  (= (:id item) tileset)))))

(defun tileset-tiles [tilesets tileset]
  (or (:tiles (tileset-definition tilesets tileset)) []))

(defun tile-count [tilesets tileset]
  (count (tileset-tiles tilesets tileset)))

(defun clamp-tile-index [tilesets tileset index]
  (let [count (tile-count tilesets tileset)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun tile-index [tilesets tileset tile-ref]
  (if (keyword? tile-ref)
    (find-index (tileset-tiles tilesets tileset)
                (fn [tile]
                  (= (:id tile) tile-ref)))
    (clamp-tile-index tilesets tileset tile-ref)))

(defun tile-id [tilesets tileset tile-ref]
  (when (not (absent-tile-ref? tile-ref))
    (let [tiles (tileset-tiles tilesets tileset)]
      (if (keyword? tile-ref)
        (when (not (nil? (tile-index tilesets tileset tile-ref)))
          tile-ref)
        (when (> (count tiles) 0)
          (:id (nth tiles (tile-index tilesets tileset tile-ref))))))))

(defun tile-in [tilesets tileset tile-ref]
  (when (not (absent-tile-ref? tile-ref))
    (let [tiles (tileset-tiles tilesets tileset)]
      (if (keyword? tile-ref)
        (when-let [index (tile-index tilesets tileset tile-ref)]
          (nth tiles index))
        (when (> (count tiles) 0)
          (nth tiles (tile-index tilesets tileset tile-ref)))))))

(defun terrain-unit [definition]
  (let [unit (or (:terrain-unit definition)
                 (when (or (:w definition) (:h definition))
                   definition)
                 default-terrain-unit)]
    {:w (max 1 (or (:w unit) 1))
     :h (max 1 (or (:h unit) 1))}))

(defun terrain-set-definition [terrain-sets terrain-set]
  (head (filter (or terrain-sets [])
                (fn [item]
                  (= (:id item) terrain-set)))))

(defun terrain-unit-for-set [terrain-sets terrain-set]
  (terrain-unit (terrain-set-definition terrain-sets terrain-set)))

(defun terrain-definitions [terrain-sets terrain-set]
  (or (:terrains (terrain-set-definition terrain-sets terrain-set)) []))

(defun terrain-count [terrain-sets terrain-set]
  (count (terrain-definitions terrain-sets terrain-set)))

(defun clamp-terrain-index [terrain-sets terrain-set index]
  (let [count (terrain-count terrain-sets terrain-set)]
    (if (= count 0)
      0
      (max 0 (min (dec count) (or index 0))))))

(defun terrain-index [terrain-sets terrain-set terrain-ref]
  (if (keyword? terrain-ref)
    (let [match (find-index (terrain-definitions terrain-sets terrain-set)
                            (fn [terrain]
                              (= (:id terrain) terrain-ref)))]
      (or match 0))
    (clamp-terrain-index terrain-sets terrain-set terrain-ref)))

(defun terrain-id [terrain-sets terrain-set terrain-ref]
  (let [terrains (terrain-definitions terrain-sets terrain-set)]
    (when (> (count terrains) 0)
      (:id (nth terrains (terrain-index terrain-sets terrain-set terrain-ref))))))

(defun terrain-in [terrain-sets terrain-set terrain-ref]
  (let [terrains (terrain-definitions terrain-sets terrain-set)]
    (when (> (count terrains) 0)
      (nth terrains (terrain-index terrain-sets terrain-set terrain-ref)))))

(defun terrain-preview-tileset [terrain-set terrain]
  (or (:tileset terrain)
      (:tileset terrain-set)))

(defun terrain-preview-tile [terrain]
  (or (:tile terrain)
      (:preview-tile terrain)
      (:preview terrain)))

(defun terrain-tile-in [tilesets terrain-sets terrain-set terrain-ref]
  (let [terrain-set-definition (terrain-set-definition terrain-sets terrain-set)
        terrain (terrain-in terrain-sets terrain-set terrain-ref)]
    (when terrain
      (tile-in tilesets
               (terrain-preview-tileset terrain-set-definition terrain)
               (terrain-preview-tile terrain)))))

(defun layer-cell-tile [tilesets terrain-sets layer tile-ref]
  (if (= (:data-kind layer) :terrain)
    (terrain-tile-in tilesets
                     terrain-sets
                     (:terrain-set layer)
                     tile-ref)
    (tile-in tilesets
             (:tileset layer)
             tile-ref)))

(defun property-type [property]
  (let [type (:type property)]
    (if (contains? property-type-options type)
      type
      default-property-type)))

(defun first-enum-value [property]
  (head (or (:values property) [])))

(defun normalize-number-property-value [value property]
  (cond
    (number? value) value
    (number? (:default property)) (:default property)
    :default 0))

(defun normalize-enum-property-value [value property]
  (let [values (or (:values property) [])]
    (cond
      (contains? values value) value
      (contains? values (:default property)) (:default property)
      :default (first-enum-value property))))

(defun normalize-property-value [value property]
  (case (property-type property)
    :number (normalize-number-property-value value property)
    :enum (normalize-enum-property-value value property)
    :any value
    :default value))

(defun property-default-value [property]
  (normalize-property-value (:default property) property))

(defun property-set-definition [property-sets property-set-id]
  (head (filter (or property-sets [])
                (fn [property-set]
                  (= (:id property-set) property-set-id)))))

(defun property-set-definitions [property-sets property-set-ids]
  (filter (map (or property-set-ids [])
               (fn [property-set-id]
                 (property-set-definition property-sets property-set-id)))
          (fn [property-set]
            (not (nil? property-set)))))

(defun property-definitions [property-sets property-set-ids]
  (apply concat
         (map (property-set-definitions property-sets property-set-ids)
              (fn [property-set]
                (or (:properties property-set) [])))))

(defun property-definition-by-id [property-sets property-set-ids property-id]
  (head (filter (property-definitions property-sets property-set-ids)
                (fn [property]
                  (= (:id property) property-id)))))

(defun property-set-default-values [property-sets property-set-ids]
  (reduce (property-definitions property-sets property-set-ids)
          {}
          (fn [result property]
            (assoc result (:id property) (property-default-value property)))))

(defun normalize-property-values [property-sets property-set-ids values]
  (reduce-kv (or values {})
             {}
             (fn [result property-id value]
               (if-let [property (property-definition-by-id property-sets
                                                            property-set-ids
                                                            property-id)]
                 (assoc result
                        property-id
                        (normalize-property-value value property))
                 result))))

(defun effective-property-values [property-sets property-set-ids default-values overrides]
  (merge (property-set-default-values property-sets property-set-ids)
         (normalize-property-values property-sets property-set-ids default-values)
         (normalize-property-values property-sets property-set-ids overrides)))

(defun tileset-property-values [property-sets tileset tile]
  (effective-property-values property-sets
                             (:property-sets tileset)
                             (:properties tileset)
                             (:properties tile)))

(defun assoc-properties-when-present [target values]
  (if (> (count values) 0)
    (assoc target :properties values)
    target))

(defun apply-tileset-property-defaults [property-sets tileset]
  (assoc tileset
         :tiles (map (or (:tiles tileset) [])
                     (fn [tile]
                       (assoc-properties-when-present
                        tile
                        (tileset-property-values property-sets
                                                 tileset
                                                 tile))))))

(defun apply-tilesets-property-defaults [property-sets tilesets]
  (map (or tilesets [])
       (fn [tileset]
         (apply-tileset-property-defaults property-sets tileset))))

(defun terrain-property-values [property-sets terrain-set terrain]
  (effective-property-values property-sets
                             (:property-sets terrain-set)
                             (:properties terrain-set)
                             (:properties terrain)))

(defun apply-terrain-set-property-defaults [property-sets terrain-set]
  (assoc terrain-set
         :terrains (map (or (:terrains terrain-set) [])
                        (fn [terrain]
                          (assoc-properties-when-present
                           terrain
                           (terrain-property-values property-sets
                                                    terrain-set
                                                    terrain))))))

(defun apply-terrain-sets-property-defaults [property-sets terrain-sets]
  (map (or terrain-sets [])
       (fn [terrain-set]
         (apply-terrain-set-property-defaults property-sets terrain-set))))

(defun rnd-pos [level-map]
  {:x (rand-nth (range 0 (dec (:width level-map))))
   :y (rand-nth (range 0 (dec (:height level-map))))})
