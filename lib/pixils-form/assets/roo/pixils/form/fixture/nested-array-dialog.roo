(ns pixils.form.fixture.nested-array-dialog
  (:require pixils
            [pixils.form :as form]
            [pixils.ui :as ui]))

(def schema
  {:definitions
   {:number-range
    {:type :object
     :fields {:min {:type :number}
              :max {:type :number}}}
    :random-number-base
    {:type :object
     :fields {:type {:type :keyword
                     :valid-values [:fixed :random]}}}
    :fixed-number
    {:extends :random-number-base
     :fields {:value {:type :number}}}
    :random-number
    {:extends :random-number-base
     :fields {:range {:ref :number-range}}}
    :randomizable-number
    {:type :union
     :discriminator :type
     :base {:ref :random-number-base}
     :variants {:fixed {:ref :fixed-number}
                :random {:ref :random-number}}}
    :radius
    {:type :object
     :fields {:x {:ref :randomizable-number}
              :y {:ref :randomizable-number}}}
    :part-shape-base
    {:type :object
     :fields {:type {:type :keyword
                     :valid-values [:radial-polygon]}}}
    :part-radial-shape
    {:extends :part-shape-base
     :fields {:radius {:ref :radius}}}
    :part-shape
    {:type :union
     :discriminator :type
     :base {:ref :part-shape-base}
     :variants {:radial-polygon {:ref :part-radial-shape}}}
    :part
    {:type :object
     :fields {:id {:type :text}
              :shape {:ref :part-shape}}}
    :generator-shape-base
    {:type :object
     :fields {:type {:type :keyword
                     :valid-values [:merged-polygons]}}}
    :merged-shape
    {:extends :generator-shape-base
     :fields {:parts {:type :array
                      :item-label {:path [:id]}
                      :items {:ref :part}}}}
    :generator-shape
    {:type :union
     :discriminator :type
     :base {:ref :generator-shape-base}
     :variants {:merged-polygons {:ref :merged-shape}}}
    :generator
    {:type :object
     :fields {:id {:type :text}
              :shape {:ref :generator-shape}}}}
   :schema {:type :array
            :item-label {:path [:id]}
            :items {:ref :generator}}})

(def initial-generators
  [{:id "generator"
    :shape {:type :merged-polygons
            :parts [{:id "base"
                     :shape {:type :radial-polygon
                             :radius {:x {:type :random
                                         :range {:min nil :max nil}}
                                      :y {:type :random
                                          :range {:min nil :max nil}}}}}]}}])

(defmode nested-array-dialog-probe
  {:init (fn [_state _ctx]
           {:generators initial-generators})
   :children
   [(form/make {:schema schema
                :value (ui/bind-state :generators)
                :mode :live
                :field-label-style {:width 112 :height 18}
                :control-style {:width :fill :height 22}})]
   :on {:form/change
        (fn [state event _ctx]
          (ui/stop-propagation! event)
          (assoc state :generators (-> event :payload :form-value)))}})
