(ns pixils.form.base-theme
  (:require pixils))

(deftheme pixils-form/base
  {:styles
   {:pixils/form
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 8}}

    :pixils/form-body
    {:width :fill
     :height :shrink}

    :pixils/form-fields
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 8}}

    :pixils/form-field
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 3}}

    :pixils/form-label {:width :fill}

    :pixils/form-row
    {:width :fill
     :height :shrink
     :layout {:direction :row
              :align-items :start
              :gap 10}}

    :pixils/form-separator
    {:width :fill
     :height 1
     :background {:r 0x9a :g 0x9a :b 0x92}}

    :pixils/form-section
    {:width :fill
     :height :shrink}

    :pixils/form-section-body
    {:width :fill
     :height :shrink
     :padding 8
     :layout {:direction :column
              :gap 8}}

    :pixils/form-nested-section
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 4}}

    :pixils/form-nested-section-title
    {:width :fill
     :height 18}

    :pixils/form-nested-section-body
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 6}}

    :pixils/form-nested-label {:max-width 64}

    :pixils/form-action
    {:width 96
     :height 24}

    :pixils/form-action-button
    {:width :fill
     :height :fill}

    :pixils/form-checkbox-control
    {:width :fill
     :height 24}

    :pixils/form-number-control
    {:width :fill
     :height 24}

    :pixils/form-text-control
    {:width :fill
     :height 24}

    :pixils/form-select-control
    {:width :fill
     :height 24}

    :pixils/form-select-input
    {:width :fill
     :height :fill}

    :pixils/form-display-control
    {:width :fill
     :height 18}

    :pixils/form-slider-control
    {:width :fill
     :height 22
     :layout {:direction :row
              :align-items :center
              :gap 8}}

    :pixils/form-slider
    {:width :fill
     :min-width 220
     :height 18}

    :pixils/form-slider-value
    {:width 64
     :height 18}

    :pixils/form-keyword-control
    {:width :fill
     :height 24
     :layout {:direction :row
              :align-items :center
              :gap 4}}

    :pixils/form-keyword-prefix {:width :shrink}

    'pixils/form-keyword-input
    {:width :fill
     :height :fill}

    :pixils/form-object-control
    {:width :fill
     :height :shrink}

    :pixils/form-object-body
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 8}}

    :pixils/form-selection
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 4}}

    :pixils/form-selection-list-box {:width :fill}

    :pixils/form-selection-toolbar
    {:width :fill
     :height :shrink
     :layout {:direction :row
              :align-items :center
              :gap 6}}

    :pixils/form-selection-list-item
    {:width :fill
     :clip true
     :layout {:direction :row
              :align-items :center}}

    :pixils/form-selection-item-label {:width :fill}

    :pixils/form-array-control
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 8}}

    :pixils/form-array-content
    {:width :fill
     :height :shrink
     :layout {:direction :row
              :align-items :start
              :gap 8}}

    :pixils/form-array-list
    {:width 220
     :height 100}

    :pixils/form-array-list-box
    {:width :fill
     :height :fill}

    :pixils/form-array-summary
    {:width :fill
     :height :shrink
     :layout {:direction :column
              :gap 4}}

    :pixils/form-array-summary-row
    {:width :fill
     :height :shrink
     :layout {:direction :row
              :align-items :start
              :gap 6}}

    :pixils/form-array-summary-label {:width 90}

    :pixils/form-array-summary-value {:width :fill}

    :pixils/form-array-toolbar
    {:width :fill
     :height :shrink
     :layout {:direction :row
              :align-items :center
              :gap 6}}

    :pixils/form-array-dialog
    {:width 440
     :height :shrink}

    :pixils/form-selection-dialog
    {:width 440
     :height :shrink}

    :pixils/form-array-item-form
    {:width :fill
     :height :shrink}

    :pixils/form-array-dialog-body
    {:width :fill
     :height :shrink
     :padding 12
     :layout {:direction :column
              :gap 10}}

    :pixils/form-array-dialog-buttons
    {:width :fill
     :height 24
     :layout {:direction :row
              :gap :space-between}}

    :pixils/form-layout-item-editor
    {:width :fill
     :height :shrink}}})
