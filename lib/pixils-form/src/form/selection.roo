(ns pixils.form.selection)

(defun base-action [selection key]
  (case key
    :add
    {:key :add
     :id :form/new
     :label "Add"
     :disabled-when :new?}

    :save
    {:key :save
     :id :form/save-new
     :label "Save"
     :enabled-when [:and :new? :valid?]}

    :cancel
    {:key :cancel
     :id :form/cancel-new
     :label "Cancel"
     :enabled-when :new?}

    :edit
    (when (:activate-event selection)
      {:key :edit
       :id :form/activate-selection
       :label "Edit"
       :enabled-when [:and [:not :new?] :selected-index]})

    :delete
    {:key :delete
     :id :form/delete
     :label "Delete"
     :enabled-when [:and [:not :new?] :selected-index]}

    :move-up
    {:key :move-up
     :id :form/move-up
     :label "Up"
     :enabled-when [:and [:not :new?] :selected-index]}

    :move-down
    {:key :move-down
     :id :form/move-down
     :label "Down"
     :enabled-when [:and [:not :new?] :selected-index]}

    :default nil))

(defun configured-action [selection key config]
  (let [base (base-action selection key)]
    (cond
      (= false config)
      nil

      (nil? config)
      nil

      (= true config)
      base

      (map? config)
      (if base
        (merge base config)
        (merge {:key key} config))

      :default base)))

(defun actions-from-map [selection action-map]
  (keep [:add :save :cancel :edit :delete :move-up :move-down]
        (fn [key]
          (when (contains? action-map key)
            (configured-action selection
                               key
                               (get action-map key))))))

(defun actions-from-vector [selection action-list]
  (keep action-list
        (fn [action]
          (cond
            (keyword? action)
            (configured-action selection action true)

            (map? action)
            action

            :default nil))))

(defun actions [{:keys [actions editable?] :as selection}]
  (cond
      (= true actions)
      (actions-from-map selection
                        {:add true
                         :save true
                         :cancel true
                         :delete true})

      (map? actions)
      (actions-from-map selection actions)

      (sequential? actions)
      (actions-from-vector selection actions)

      (and (nil? actions)
           (= true editable?))
      (actions-from-map selection
                        {:add true
                         :save true
                         :cancel true
                         :delete true})

      :default []))

(defun action-presentation [{:keys [action-presentation]} action]
  (or (:presentation action)
        (when (map? action-presentation)
          (get action-presentation
               (:key action)
               (:default action-presentation)))
        (when (keyword? action-presentation)
          action-presentation)
        :toolbar))

(defun actions-for-presentation [selection presentation]
  (filter (actions selection)
          (fn [action]
            (= presentation
               (action-presentation selection action)))))
