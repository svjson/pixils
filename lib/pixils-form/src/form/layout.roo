(ns pixils.form.layout
  (:require pixils
            [pixils.ui :as ui]
            [pixils.ui.group-box :as group-box]))

(def LAYOUT-VECTOR-TYPES
  [:row :group :section :form :field :selection :action])

(defun layout-config? [layout]
  (and (map? layout)
       (or (contains? layout :root)
           (contains? layout :fragments))))

(defun root-layout [layout]
  (if (layout-config? layout)
    (:root layout)
    layout))

(defun layout-fragments [layout]
  (when (layout-config? layout)
    (:fragments layout)))

(defun class-list [class]
  (cond
    (nil? class) []
    (keyword? class) [class]
    :default class))

(defun classes [base class]
  (let [all (concat (class-list base)
                    (class-list class))]
    (cond
      (empty? all) nil
      (= 1 (count all)) (head all)
      :default all)))

(defun style-map [style]
  (if style {:style style} {}))

(defun resolve-view-result [provided options]
  "Resolves a value returned by a layout view provider.

  A returned function is called with the same options until it produces a
  component symbol or complete view declaration."
  (cond
    (fn? provided) (resolve-view-result (provided options) options)
    (= "symbol" (type-of provided)) (assoc options :component provided)
    :default provided))

(defun resolve-view [view=> options]
  "Resolves a layout view provider with its rendered container options.

  A component symbol receives the options as its declaration. A view
  declaration is extended by the options. Functions receive the options and
  may return another function, a component symbol, or a complete declaration."
  (if (map? view=>)
    (merge view=> options)
    (resolve-view-result view=> options)))

(defun keyword-label [value]
  (if (keyword? value)
    (if-let [qualifier (qualifier value)]
      (str qualifier "/" (name value))
      (name value))
    (str value)))

(defun text-index-of [text needle index]
  (cond
    (>= index (count text)) nil
    (= (substr text index 1) needle) index
    :default (text-index-of text needle (inc index))))

(defun layout-class-index [label]
  (or (text-index-of label "#" 0)
      (text-index-of label "." 0)))

(defun canonical-layout-type [type]
  (case type
    :button :action
    :default type))

(defun layout-token [token]
  (let [label (keyword-label token)
        class-index (layout-class-index label)]
    (if class-index
      {:type (canonical-layout-type
              (keyword (substr label 0 class-index)))
       :class (keyword (substr label (inc class-index)))}
      {:type (canonical-layout-type token)})))

(defun apply-layout-token [node token]
  (let [parsed (layout-token token)]
    (if (:class parsed)
      (assoc node
             :type (:type parsed)
             :class (:class parsed))
      (assoc node :type (:type parsed)))))

(defun layout-vector-type [item]
  (when (and (sequential? item)
             (not-empty? item)
             (keyword? (head item)))
    (:type (layout-token (head item)))))

(defun dsl-layout-vector? [item]
  (contains? LAYOUT-VECTOR-TYPES (layout-vector-type item)))

(defun vector-tail [items start]
  (if (>= start (count items))
    []
    (concat [(nth items start)]
            (vector-tail items (inc start)))))

(defun vector-option [items index]
  (when (and (< index (count items))
             (map? (nth items index)))
    (nth items index)))

(defun normalize-layout-item [item]
  (cond-> item
    (and (sequential? item) (dsl-layout-vector? item)) normalize-dsl-layout))

(defun normalize-layout-children [items]
  (map items normalize-layout-item))

(defun normalize-section-layout [item]
  (let [options (vector-option item 2)
        child-start (if options 3 2)]
    (merge (apply-layout-token
            {:title (nth item 1)
             :layout (normalize-layout-children
                      (vector-tail item child-start))}
            (head item))
           options)))

(defun normalize-dsl-layout [item]
  (let [token (head item)
        type (layout-vector-type item)]
    (case type
      :row
      (apply-layout-token {:children (normalize-layout-children
                                      (vector-tail item 1))}
                          token)

      :group
      (apply-layout-token {:children (normalize-layout-children
                                      (vector-tail item 1))}
                          token)

      :section
      (normalize-section-layout item)

      :form
      (apply-layout-token {:model (nth item 1)
                           :layout (nth item 2)}
                          token)

      :field
      (merge (apply-layout-token {:id (nth item 1)} token)
             (vector-option item 2))

      :selection
      (merge (apply-layout-token {:projection (nth item 1)}
                                 token)
             (vector-option item 2))

      :action
      (merge (apply-layout-token {:id (nth item 1)}
                                 token)
             (vector-option item 2))

      :default item)))

(defun layout-child-items [item]
  (or (:children item)
      (:layout item)))

(defun layout-item-projection [item]
  (let [item (normalize-layout-item item)]
    (cond
      (nil? item) nil
      (map? item) (or (:projection item)
                      (layout-projection (layout-child-items item)))
      (sequential? item) (layout-projection item)
      :default nil)))

(defun layout-projection [layout]
  (reduce layout
          nil
          (fn [projection item]
            (or projection
                (layout-item-projection item)))))

(defun layout-item-selection [item]
  (let [item (normalize-layout-item item)]
    (cond
      (nil? item) nil
      (map? item) (case (:type item)
                    :selection item
                    :default (layout-selection (layout-child-items item)))
      (sequential? item) (layout-selection item)
      :default nil)))

(defun layout-selection [layout]
  (reduce layout
          nil
          (fn [selection item]
            (or selection
                (layout-item-selection item)))))

(defun layout-item-form-layout [item]
  (let [item (normalize-layout-item item)]
    (cond
      (nil? item) nil
      (map? item) (case (:type item)
                    :form (:layout item)
                    :default (layout-form-layout (layout-child-items item)))
      (sequential? item) (layout-form-layout item)
      :default nil)))

(defun layout-form-layout [layout]
  (reduce layout
          nil
          (fn [form-layout item]
            (or form-layout
                (layout-item-form-layout item)))))

(defun layout-item-actions [item]
  (let [item (normalize-layout-item item)]
    (cond
      (nil? item) []

      (map? item)
      (case (:type item)
        :action [item]
        :default (layout-actions (layout-child-items item)))

      (sequential? item)
      (layout-actions item)

      :default [])))

(defun layout-actions [layout]
  (reduce layout
          []
          (fn [actions item]
            (concat actions (layout-item-actions item)))))

(defun section-depth [opts]
  (or (:form/section-depth opts) 0))

(defun section-child-opts [opts]
  (assoc opts :form/section-depth (inc (section-depth opts))))

(defun section-wrapper [item {:keys [section-wrappers] :as opts}]
  (or (:section-wrapper item)
      (get section-wrappers (section-depth opts))
      (:default section-wrappers)
      (case (section-depth opts)
        0 :group-box
        :default :plain)))

(defun group-box-section-view [item opts children state-binding]
  (group-box/make
   {:title (:title item)
    :class (classes :pixils.form/section (:class item))
    :style (or (:style item) (:section-style opts))
    :state state-binding
    :frame-class (classes :pixils.form/section-frame
                          (:frame-class item))
    :frame-style (if (contains? item :frame-style)
                   (:frame-style item)
                   (:section-frame-style opts))
    :title-class (classes :pixils.form/section-title
                          (:title-class item))
    :title-style (if (contains? item :title-style)
                   (:title-style item)
                   (:section-title-style opts))
    :body-class (classes :pixils.form/section-body
                         (:body-class item))
    :body-style (or (:body-style item) (:section-body-style opts))
    :body-state state-binding
    :children children}))

(defun plain-section-view [item opts children state-binding]
  (let [title (when-let [title (:title item)]
                {:mode 'ui/text
                 :class (classes
                         [:ui/muted :pixils.form/nested-section-title]
                         (:title-class item))
                 :style (or (:title-style item)
                            (:nested-section-title-style opts))
                 :state {:value title}})
        body {:class :pixils.form/nested-section-body
              :style (or (:body-style item)
                         (:nested-section-body-style opts))
              :state state-binding
              :children children}]
    (merge {:state state-binding
            :children (if title [title body] [body])}
           (style-map (or (:style item) (:nested-section-style opts)))
           {:class (classes :pixils.form/nested-section
                            (:class item))})))

(defun unwrapped-section-view [item opts children state-binding]
  (merge {:state state-binding
          :children children}
         (style-map (:style item))
         {:class (classes :pixils.form/section (:class item))}))

(defun section-view [item opts children state-binding]
  (case (section-wrapper item opts)
    :group-box (group-box-section-view item opts children state-binding)
    :none (unwrapped-section-view item opts children state-binding)
    :plain (plain-section-view item opts children state-binding)
    :default (plain-section-view item opts children state-binding)))
