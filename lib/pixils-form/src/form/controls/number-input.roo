(ns pixils.form.controls.number-input
  (:require [pixils.form.layout :as form-layout]
            [pixils.ui.number-input :as number-input]))

(defun for-field
  "Builds a number-input for a resolved form-field context."
  [{:keys [schema value disabled? options]}]
  (assoc (number-input/make
          (merge {:value value
                  :min (:min schema)
                  :max (:max schema)
                  :step (:step schema)
                  :allow-negative? (:allow-negative? schema)
                  :allow-fractions? (if (contains? schema :allow-fractions?)
                                      (:allow-fractions? schema)
                                      (= (:type schema) :number))
                  :disabled? disabled?
                  :auto-focus? (:auto-focus? schema)
                  :commit-on (if (contains? schema :commit-on)
                               (:commit-on schema)
                               :blur)}
                 (form-layout/style-map (:control-style options))))
         :class [:pixils.form/control :pixils.form/number-input]))
