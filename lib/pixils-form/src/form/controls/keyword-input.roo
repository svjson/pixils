(ns pixils.form.controls.keyword-input
  (:require pixils
            [pixils.form.layout :as form-layout]
            [pixils.form.controls.text-input :as text-input-control]
            [pixils.ui :as ui]))

(def default-style
  "Default dimensions for a form keyword-input editor."
  {:width :fill
   :height :fill})

(def default-control-style
  "Default layout for a keyword prefix and its editor."
  {:width :fill
   :height 24
   :layout {:direction :row
            :align-items :center
            :gap 4}})

(defun value->text
  "Returns the editable text representation of a keyword value."
  [value]
  (cond
    (nil? value) ""
    (keyword? value) (form-layout/keyword-label value)
    :default (str value)))


;; Component

(defcomponent pixils/form-keyword-input
  {:extend 'ui/text-input})


;; Make function

(defun make
  "Builds a form text-input specialized for keyword values."
  [{:keys [class style] :as opts}]
  (assoc (text-input-control/make
          (assoc opts
                 :class (form-layout/classes :pixils/form-keyword-input class)
                 :format-value value->text
                 :style (if (contains? opts :style) style default-style)))
         :mode 'pixils/form-keyword-input))

(defun for-field
  "Builds the prefixed keyword-input presentation for a form field."
  [{:keys [schema value options]}]
  {:class [:pixils/form-control :pixils/form-keyword-control]
   :style (or (form-layout/style-option options :control-style default-control-style) {})
   :state {:value value}
   :children [{:mode 'ui/text
               :class :ui/muted
               :style {:width :shrink}
               :state {:value ":"}}
              (make {:style default-style
                     :value (ui/project-state :value)
                     :auto-focus? (:auto-focus? schema)
                     :read-only? (:read-only? schema)})]})
