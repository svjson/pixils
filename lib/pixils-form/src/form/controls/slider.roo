(ns pixils.form.controls.slider
  (:require pixils
            [pixils.form.layout :as form-layout]
            [pixils.ui :as ui]
            [pixils.ui.slider :as slider]))

(def default-control-style
  "Default layout for a form slider and its value."
  {:width :fill
   :height 22
   :layout {:direction :row
            :gap 8
            :align-items :center}})

(def default-slider-style
  "Default dimensions for the slider within a form slider control."
  {:width :fill
   :min-width 220
   :height 18})

(def default-value-style
  "Default dimensions for a form slider's displayed value."
  {:width 64
   :height 18})

(defcomponent pixils/form-slider-control
  {:on {:slider/change
        (fn [state {:keys [payload] :as event} ctx]
          (let [value payload]
            (ui/stop-propagation! event)
            (unless (:read-only? state)
              (ui/emit! (:view ctx)
                        :form/control-change
                        {:value value
                         :commit? true}))
            (if (:read-only? state)
              state
              (assoc state :value value))))}
   :children [(slider/make
               {:style (ui/bind-state :slider-style)
                :value (ui/bind-state :value)
                :min (ui/bind-state :min)
                :max (ui/bind-state :max)
                :step (ui/bind-state :step)
                :axis (ui/bind-state :axis)})
              {:mode 'ui/text
               :class [:ui/muted :pixils/form-slider-value]
               :style (ui/bind-state :value-style)
               :state {:value (ui/bind-state :value)}}]})

(defun for-field
  "Builds a slider for a resolved form-field context."
  [{:keys [schema value options]}]
  {:mode 'pixils/form-slider-control
   :class [:pixils/form-control :pixils/form-slider-control]
   :style (or (:slider-control-style options)
              (:control-style options)
              default-control-style)
   :state {:value value
           :min (:min schema)
           :max (:max schema)
           :step (:step schema)
           :axis (or (:axis schema) :x)
           :read-only? (:read-only? schema)
           :slider-style (or (:slider-style options) default-slider-style)
           :value-style (or (:slider-value-style options) default-value-style)}})
