(ns pixils.form.controls.list-box
  (:require pixils
            [pixils.form.actions :as form-actions]
            [pixils.form.layout :as form-layout]
            [pixils.form.selection :as selection]
            [pixils.form.state :as form-state]
            [pixils.ui :as ui]
            [pixils.ui.list-box :as list-box]
            [pixils.ui.popup-menu :as popup-menu]
            [pixils.ui.option-item :as option]))

(defun item-action-payload
  "Adds the clicked selection item to a configured action payload."
  [state action]
  (merge (if (map? (:payload action)) (:payload action) {})
         (cond-> {:index (:index state)
                  :value (:value state)}
           (some? (:field-id state))
           (assoc :field-id (:field-id state)))))

(defun menu-item
  "Builds a context-menu item for a form selection action and clicked item."
  [state action]
  {:label (:label action)
   :action (form-actions/action-event-id action)
   :payload (item-action-payload state action)})

(defun context-menu
  "Builds a context menu for form selection actions."
  [state]
  {:items (for [action (:context-menu-actions state)]
            (menu-item state action))})

(defun open-context-menu!
  "Opens the configured item context menu for a right-button event."
  [ui-state state event ctx]
  (when (and (= (:button event) :right)
             (not (:disabled? ui-state))
             (not-empty? (:context-menu-actions ui-state)))
    (popup-menu/open-context!
     (context-menu ui-state)
     (:global-position event)
     state
     ctx)))

(defcomponent pixils/form-selection-list-item
  {:extend 'ui/list-box-item
   :class :pixils.form/list-item
   :ui/state-keys [:field-id :context-menu-actions]
   :on-mouse-up (fn [state event ctx]
                  (ui/stop-propagation! event)
                  (open-context-menu! (-> ctx :view :ui-state) state event ctx)
                  state)
   :on {:menu/select (fn [state {:keys [payload] :as event} ctx]
                       (ui/stop-propagation! event)
                       (when (= (:type payload) :action)
                         (ui/emit! (:view ctx)
                                   (:action payload)
                                   (:payload payload)))
                       state)}
   :children [{:mode 'ui/text
               :class :pixils.form/list-item-label
               :state {:value (ui/bind-state :label)}}]})

(defun item=>
  "Returns an item provider carrying the configured context-menu actions."
  [context-menu-actions field-id]
  (fn [index option]
    {:mode 'pixils/form-selection-list-item
     :state {:component
             {:index index
              :value (option/value option)
              :label (option/label option)
              :field-id field-id
              :selected-indices (ui/bind-state :selected-indices)
              :context-menu-actions context-menu-actions}}}))

(defun toolbar-view
  "Builds the toolbar presented alongside a form list box."
  [selection opts actions]
  (merge {:class :pixils.form/selection-toolbar
          :state {:form/action-disabled (ui/project-state :form/action-disabled)}
          :children (for [action actions]
                      (form-actions/action-view action opts))}
         (form-layout/style-map (:selection-toolbar-style opts))))

(defcomponent pixils/form-selection
  {:init (fn [state ctx]
           (if (:selection-options state)
             (assoc state :options (:selection-options state))
             (form-state/selection-derived-state state (:item-label state))))
   :on {:list-box/selection-change
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (if (:disabled? state)
            state
            (let [index (head (-> event :payload :selected-indices))]
              (ui/emit! (:view ctx) :form/select {:index index})
              state)))
        :list-box/activate
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (when-let [activate-event (:activate-event state)]
            (ui/emit! (:view ctx) activate-event (:payload event)))
          state)
        :list-box/reorder
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (ui/emit! (:view ctx) :form/reorder (:payload event))
          state)
        :form/activate-selection
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (when-let [activate-event (:activate-event state)]
            (ui/emit! (:view ctx)
                      activate-event
                      {:index (:selected-index state)
                       :value (:selected-index state)}))
          state)}})

(defun for-selection
  "Builds a form list-box control for a normalized selection declaration."
  [selection opts]
  (when selection
    (let [toolbar-actions (selection/actions-for-presentation selection :toolbar)
        context-menu-actions
        (selection/actions-for-presentation selection :context-menu)
        item-provider (unless (empty? context-menu-actions)
                        (item=> context-menu-actions (:field-id selection)))
        list-style (cond-> (or (:list-style selection)
                               (:selection-list-style opts)
                               {})
                           (contains? selection :visible-rows)
                           (assoc :visible-rows (:visible-rows selection)))
        list-box-view
        (list-box/make
         (merge {:class (form-layout/classes
                         :pixils.form/list-box
                         (:list-class selection))
                 :options (ui/bind-state :options)
                 :selected-indices (ui/bind-state :selected-indices)
                 :disabled? (ui/project-state :disabled?)
                 :force-selection? false
                 :row-height (:row-height selection)
                 :reorderable? (ui/bind-state :reorderable?)
                 :item=> item-provider}
                (form-layout/style-map list-style)))
        children (if (empty? toolbar-actions)
                   [list-box-view]
                   [list-box-view (toolbar-view selection opts toolbar-actions)])]
    (merge {:mode 'pixils/form-selection
            :state {:options (ui/project-state :selection-options)
                    :selection-options (ui/project-state :selection-options)
                    :selected-indices (ui/project-state :selected-indices)
                    :disabled? (:disabled? selection)
                    :form/action-disabled
                    (ui/project-state :form/action-disabled)
                    :item-label (:item-label selection)
                    :reorderable? (:reorderable? selection)
                    :activate-event (:activate-event selection)}
            :children children}
           (form-layout/style-map
            (or (:style selection) (:selection-style opts)))
           {:class (form-layout/classes :pixils.form/selection
                                        (:class selection))}))))
