(ns pixils.form.controls.display
  (:require [pixils.form.layout :as form-layout]))

(defun for-field
  "Builds display text for a resolved form-field context."
  [{:keys [value options]}]
  (merge {:mode 'ui/text
          :class [:pixils.form/control :pixils.form/display]
          :state {:value value}}
         (form-layout/style-map (:display-style options))))
