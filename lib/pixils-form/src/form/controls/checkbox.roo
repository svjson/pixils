(ns pixils.form.controls.checkbox
  (:require [pixils.form.layout :as form-layout]
            [pixils.ui.checkbox :as checkbox]))

(defun for-field
  "Builds a checkbox for a resolved form-field context."
  [{:keys [id value disabled? options]}]
  (assoc (checkbox/make
          (merge {:label ""
                  :checked? value
                  :disabled? disabled?
                  :value id}
                 (form-layout/style-map (:checkbox-style options))))
         :class [:pixils.form/control :pixils.form/checkbox]))
