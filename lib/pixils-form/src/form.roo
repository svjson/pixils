(ns pixils.form
  (:require pixils
            [pixils.form.actions :as form-actions]
            [pixils.form.controls.array-editor :as array-editor-control]
            [pixils.form.controls.checkbox :as checkbox-control]
            [pixils.form.controls.color-picker :as color-picker-control]
            [pixils.form.controls.combo-box :as combo-box-control]
            [pixils.form.controls.display :as display-control]
            [pixils.form.controls.keyword-input :as keyword-input-control]
            [pixils.form.controls.list-box :as list-box-control]
            [pixils.form.controls.number-input :as number-input-control]
            [pixils.form.controls.object-form :as object-form-control]
            [pixils.form.controls.slider :as slider-control]
            [pixils.form.controls.text-input :as text-input-control]
            [pixils.form.field :as form-field]
            [pixils.form.layout :as form-layout]
            [pixils.form.selection :as form-selection]
            [pixils.form.state :as form-state]
            [pixils.form.valid-values :as form-valid-values]
            [zoology.canonical :as model-canonical]
            [zoology.schema :as model-schema]
            [zoology.validation :as model-validation]
            [pixils.ui :as ui]
            [pixils.ui.dialog :as dialog]))

(def form-state-binding
  {:value (ui/project-state :value)
   :disabled? (ui/project-state :disabled?)})

(def form-body-id "form-body")

(def separator-token :------)

(def form-layout-state-binding
  {:value (ui/project-state :value)
   :disabled? (ui/project-state :disabled?)
   :new? (ui/project-state :new?)
   :valid? (ui/project-state :valid?)
   :form/item-editor-state (ui/project-state :form/item-editor-state)
   :selection-options (ui/project-state :selection-options)
   :selected-indices (ui/project-state :selected-indices)
   :form/action-disabled (ui/project-state :form/action-disabled)})

(defun child-models [entry]
  (or (:models entry)
      (:children entry)))

(defun model-entry-at [models path index]
  (let [entry (get models (nth path index))]
    (if (or (nil? entry)
            (= index (dec (count path))))
      entry
      (model-entry-at (child-models entry) path (inc index)))))

(defun model-entry [models model-id]
  (cond
    (nil? model-id) nil
    (= (type-of model-id) "vector") (model-entry-at models model-id 0)
    :default (get models model-id)))

(defun model-value [models model-id]
  (:value (or (model-entry models model-id) {})))

(defun model-schema [models model-id]
  (:schema (or (model-entry models model-id) {})))

(defun model-ref? [models value]
  (or (= (type-of value) "vector")
      (and (keyword? value)
           (contains? models value))))

(defun model-ref-value [models value]
  (if (model-ref? models value)
    (model-value models value)
    value))

(defun primary-model-id [opts projection]
  (or (:model opts)
      (:target projection)))

(defun projection-entry-at [models path index]
  (let [entry (get models (nth path index))]
    (cond
      (nil? entry)
      nil

      (= index (- (count path) 2))
      (get (:projections entry) (nth path (dec (count path))))

      :default
      (projection-entry-at (child-models entry) path (inc index)))))

(defun projection-entry [models projection]
  (cond
    (nil? projection) nil
    (map? projection) projection
    (= (type-of projection) "vector") (projection-entry-at models projection 0)
    :default projection))

(defun selection-value [models selection projection key]
  (model-ref-value models (get selection key (get projection key))))

(defun normalized-selection [models selection projection]
  (when (or selection projection)
    (assoc selection
           :items (selection-value models selection projection :items)
           :selected-index
           (selection-value models selection projection :selected-index)
           :new? (selection-value models selection projection :new?)
           :new-value
           (selection-value models selection projection :new-value)
           :new-value-fn
           (or (:new-value-fn selection)
               (:new-value-fn projection)))))

(defun normalized-form-state [{:keys [schema value valid? errors models context
                                      mode disabled?
                                      projection]
                               :as opts}
                              selection]
  (let [model-id (primary-model-id opts projection)]
    {:value (or value (model-value models model-id))
     :schema (or schema (model-schema models model-id))
     :context context
     :disabled? disabled?
     :form/mode (or mode :transient)
     :valid? valid?
     :errors errors
     :items (:items selection)
     :selected-index (:selected-index selection)
     :new? (:new? selection)
     :new-value (:new-value selection)
     :new-template (:new-value selection)
     :new-value-fn (:new-value-fn selection)}))

(defun validate-field [schema value field-id]
  (model-validation/validate-field schema value field-id))

(defun validation-errors [schema value]
  (model-validation/validation-errors schema value))

(defun validate [schema value]
  (model-validation/validate schema value))

(defun validate-with-context [schema value context]
  (model-validation/validate-with-context schema value context))

(defun emit-field-change! [state event ctx value commit?]
  (ui/stop-propagation! event)
  (unless (:disabled? state)
    (ui/emit! (:view ctx)
              :form/edit
              (assoc (form-field/change-payload-with-commit state value commit?)
                     :commit? commit?)))
  state)

(defun label-for [field-id text]
  (get text field-id (str field-id)))

(defun form-field-visible?
  "Returns whether a form field is visible for the current form value.

  Args:
  - `state`: Form-field state containing its schema, identity, and value.

  Returns:
  True for a scalar-root field or a visible named schema field."
  [state]
  (or (nil? (:field-id state))
      (model-schema/field-visible? (:schema state)
                                   (:field-id state)
                                   (:value state))))

(defun form-field-style [base-style visible?]
  (cond-> (or base-style {})
    (not visible?) (assoc :visibility :none)))

(defun sync-form-field-style! [state ctx]
  (ui/style! (:view ctx)
             (form-field-style (:base-style state)
                               (:visible? state))))

(defun form-field-visibility-key [state]
  (if (:dynamic-visibility? state)
    {:field-id (:field-id state)
     :visibility-value
     (model-schema/field-visibility-value (:schema state)
                                          (:value state))}
    {:field-id (:field-id state)}))

(defun cached-form-field-state [state]
  (let [state (assoc state :form-value (:value state))
        key (form-field-visibility-key state)]
    (if (= key (:visibility-key state))
      state
      (assoc state
             :visibility-key key
             :visible? (form-field-visible? state)))))

(defun sync-form-field-style-state! [state ctx]
  (let [style-key {:base-style (:base-style state)
                   :visible? (:visible? state)}]
    (if (= style-key (:style-key state))
      state
      (let [synced (sync-form-field-style! state ctx)]
        (assoc state :style-key style-key)))))

(defcomponent pixils/form-field
  {:init (fn [state ctx]
           (sync-form-field-style-state!
            (cached-form-field-state state)
            ctx))
   :on {:text-input/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              false))
        :text-input/blur
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              true))
        :number-input/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              true))
        :number-input/text-change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              false))
        :form/control-change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              (not= false
                                    (-> event :payload :commit?))))
        :checkbox/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :checked?)
                              true))
        :color-picker/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              true))}})

(def default-controls
  {:text text-input-control/for-field
   :string text-input-control/for-field
   :select combo-box-control/for-field
   :object object-form-control/for-field
   :union object-form-control/for-field
   :array array-editor-control/for-field
   :keyword keyword-input-control/for-field
   :integer number-input-control/for-field
   :number number-input-control/for-field
   :slider slider-control/for-field
   :boolean checkbox-control/for-field
   :color color-picker-control/for-field
   :display display-control/for-field})

(defun field-control-type [field-schema]
  (if (:valid-values field-schema)
    :select
    (:type field-schema)))

(defun field-control
  "Builds the configured control for a resolved form value.

  Args:
  - `field-id`: Named field identifier, or nil for the form root.
  - `field-schema`: Resolved schema for the presented value.
  - `field-label`: Human-readable label supplied to the control.
  - `value`: State projection containing the presented value.
  - `opts`: Form rendering options and control overrides.

  Returns:
  A form control view declaration."
  [field-id field-schema field-label value opts]
  (let [controls (merge default-controls (:controls opts))
        control (get controls
                     (field-control-type field-schema)
                     display-control/for-field)]
    (apply control [{:id field-id
                     :schema field-schema
                     :label field-label
                     :value value
                     :disabled? (if (:read-only? field-schema)
                                  true
                                  (ui/project-state :disabled?))
                     :options opts}])))

(defun field-label-class [opts]
  (form-layout/classes
   (if (:field-path-prefix opts)
     [:ui/muted :pixils.form/label :pixils.form/nested-label]
     [:ui/muted :pixils.form/label])
   (:field-label-class opts)))

(defun field-label-view [field-label opts]
  (merge {:mode 'ui/text
          :class (field-label-class opts)
          :state {:value field-label}}
         (form-layout/style-map (:field-label-style opts))))

(defun field-view [field-id opts]
  (let [schema (or (:schema opts) {})
        field-schema (model-schema/resolved-field-schema schema field-id)
        field-label (label-for field-id (:text opts))
        base-style (:field-style opts)
        local-field-path (form-field/path field-id field-schema)
        initial-visible? (model-schema/field-visible? schema
                                                      field-id
                                                      (:value opts))]
    (if field-schema
      (when initial-visible?
        (merge {:mode 'pixils/form-field
                :class :pixils.form/field
                :state {:value (ui/project-state :value)
                        :form-value (ui/project-state :value)
                        :form/item-editor-state
                        (ui/project-state :form/item-editor-state)
                        :schema schema
                        :field-id field-id
                        :field-path (form-field/event-path opts field-id field-schema)
                        :local-field-path local-field-path
                        :field-schema field-schema
                        :disabled? (if (:read-only? field-schema)
                                     true
                                     (ui/project-state :disabled?))
                        :base-style base-style
                        :dynamic-visibility?
                        (model-schema/dynamic-field-visibility? schema)
                        :visible? true}
                :children (cond-> []
                            (not= false (-> opts :field/layout :label))
                            (append (field-label-view field-label opts))
                            true (append (field-control field-id
                                                        field-schema
                                                        field-label
                                                        (form-field/projection
                                                         field-id
                                                         field-schema)
                                                        opts)))}
               (form-layout/style-map base-style)))
      {:mode 'ui/text
       :state {:value (str "Unknown form field " field-id)}})))

(defun root-field-view
  "Builds the form field that presents a scalar root value.

  Args:
  - `schema`: Prepared scalar-root schema document.
  - `opts`: Form rendering options containing any root field layout.

  Returns:
  A pathless form-field view whose control edits the complete form value."
  [schema opts]
  (let [field-schema (model-schema/resolved-root-schema schema)
        field-layout (form-layout/normalize-layout-item
                      (head (:form/layout opts)))
        field-label (:label field-layout)
        base-style (:field-style opts)]
    (merge {:mode 'pixils/form-field
            :class :pixils.form/field
            :state {:value (ui/project-state :value)
                    :form-value (ui/project-state :value)
                    :form/item-editor-state
                    (ui/project-state :form/item-editor-state)
                    :schema schema
                    :field-id nil
                    :field-path nil
                    :local-field-path nil
                    :field-schema field-schema
                    :disabled? (if (:read-only? field-schema)
                                 true
                                 (ui/project-state :disabled?))
                    :base-style base-style
                    :dynamic-visibility? false
                    :visible? true}
            :children (cond-> []
                        (and (some? field-label)
                             (not= false field-label))
                        (append (field-label-view field-label opts))
                        true
                        (append (field-control nil
                                               field-schema
                                               field-label
                                               (ui/project-state :value)
                                               opts)))}
           (form-layout/style-map base-style))))

(defun separator-view [opts]
  (merge {:class :pixils.form/separator}
         (form-layout/style-map (:separator-style opts))))

(defun row-view [items opts]
  (merge {:class :pixils.form/row
          :state form-state-binding
          :children (layout-item-views items opts)}
         (form-layout/style-map (:row-style opts))))

(defun model-layout-opts [opts item]
  (let [model-id (or (:model item)
                     (:model opts))
        entry (model-entry (:models opts) model-id)]
    (assoc opts
           :model model-id
           :schema (or (:schema item)
                       (:schema entry)
                       (:schema opts))
           :text (or (:text item)
                     (:text opts)))))

(defun form-layout-view [item opts]
  (let [item-layout (:layout item)
        item-root-layout (form-layout/root-layout item-layout)
        item-fragments (or (form-layout/layout-fragments item-layout)
                           (:layout/fragments opts))
        opts (assoc (model-layout-opts opts item)
                    :layout/fragments item-fragments)
        children (layout-item-views (or item-root-layout
                                        (default-layout (:schema opts) opts))
                                    opts)]
    (merge {:state form-layout-state-binding
            :children children}
           (form-layout/style-map (or (:style item) (:fields-style opts)))
           {:class (form-layout/classes :pixils.form/fields (:class item))})))

(defun selection-layout-view [item opts]
  (let [projection (projection-entry (:models opts)
                                     (:projection item))]
    (list-box-control/for-selection
     (if (or (:projection item)
             (contains? item :items)
             (contains? item :selected-index)
             (contains? item :new?)
             (contains? item :new-value)
             (contains? item :new-value-fn))
       (normalized-selection (:models opts) item projection)
       (merge (:form/selection opts) item))
     opts)))

(defun row-layout-view [item opts]
  (merge {:state form-layout-state-binding
          :children (layout-item-views
                     (or (:children item) (:layout item))
                     opts)}
         (form-layout/style-map
          (or (:style item) (:row-style opts)))
         {:class (form-layout/classes
                  (case (:type item)
                    :group [:pixils.form/row :pixils.form/group]
                    :default :pixils.form/row)
                  (:class item))}))

(defun section-layout-view [item opts]
  (form-layout/section-view
   item
   opts
   (layout-item-views (or (:layout item)
                          (:children item))
                      (form-layout/section-child-opts opts))
   form-layout-state-binding))

(defun container-layout-view [item opts]
  (let [children (layout-item-views (or (:children item) (:layout item)) opts)
        options (-> item
                    (dissoc :view=>)
                    (dissoc :type)
                    (dissoc :layout)
                    (assoc :state (merge (:state item) form-layout-state-binding)
                           :children children))]
    (form-layout/resolve-view (:view=> item) options)))

(defun map-layout-item-view [item opts]
  (if (:view=> item)
    (container-layout-view item opts)
    (case (:type item)
      :form (form-layout-view item opts)
      :field (field-view (:id item) (assoc opts :field/layout item))
      :selection (selection-layout-view item opts)
      :action (form-actions/action-view item opts)
      :section (section-layout-view item opts)
      :group (row-layout-view item opts)
      :row (row-layout-view item opts)
      :default (or (array-editor-control/layout-item-editor-view item opts)
                   {:mode 'ui/text
                    :state {:value (str "Unknown form layout item " item)}}))))

(defun layout-item-view [item opts]
  (let [item (form-layout/normalize-layout-item item)]
    (cond
      (= item separator-token) (separator-view opts)
      (= (type-of item) "vector") (row-view item opts)
      (map? item) (map-layout-item-view item opts)
      :default (field-view item opts))))

(defun layout-item-views [items opts]
  (keep items (fn [item] (layout-item-view item opts))))

(defun item-editor-layout-ref
  "Returns the named layout location configured for a field's item editor."
  [{:keys [item-editor]}]
  (when (map? item-editor)
    (:layout-ref item-editor)))

(defun add-referenced-item-editor
  "Adds an explicitly referenced array-field editor to `editors`."
  [editors item opts]
  (if-let [layout-ref (item-editor-layout-ref item)]
    (let [field-id (:id item)
          field-schema (model-schema/resolved-field-schema (:schema opts) field-id)
          item-schema (array-editor-control/array-item-schema field-schema opts)]
      (assoc editors
             layout-ref
             (cond->
              {:id layout-ref
               :field-id field-id
               :field-path (form-field/event-path opts field-id field-schema)
               :field-schema field-schema
               :schema item-schema
               :no-selection (get (:item-editor item) :no-selection :disabled)
               :new-value-fn (:new-value=> item)}
               (contains? item :new-value)
               (assoc :new-template (:new-value item)))))
    editors))

(defun collect-referenced-item-editors
  "Collects referenced array-field editors from one normalized layout branch."
  [editors item opts]
  (let [item (form-layout/normalize-layout-item item)]
    (cond
      (map? item)
      (let [editors (cond-> editors
                      (= (:type item) :field)
                      (add-referenced-item-editor item opts))]
        (reduce (form-layout/layout-child-items item)
                editors
                (fn [editors child]
                  (collect-referenced-item-editors editors child opts))))

      (= (type-of item) "vector")
      (reduce item
              editors
              (fn [editors child]
                (collect-referenced-item-editors editors child opts)))

      :default editors)))

(defun referenced-item-editors
  "Returns referenced array-field editor definitions declared by `layout`."
  [layout opts]
  (reduce (form-layout/root-layout layout)
          {}
          (fn [editors item]
            (collect-referenced-item-editors editors item opts))))

(defun initial-item-editor-state
  "Returns initial selection state for referenced array-field editors."
  [editors value]
  (reduce (keys editors)
          {}
          (fn [state id]
            (let [definition (get editors id)
                  items (get-in value (:field-path definition))
                  new? (and (empty? items)
                            (= :new (:no-selection definition)))
                  new-value (when new?
                              (form-state/new-form-value
                               (assoc definition :items items)))]
              (assoc state
                     id
                     (cond
                       (not-empty? items) {:phase :selected
                                           :selected-index 0}
                       new? {:phase :new :value new-value}
                       :default {:phase :empty}))))))

(defun default-layout [schema opts]
  (or (object-form-control/fragment-layout schema opts)
      (model-schema/active-schema-field-ids schema (:value opts))))

(defun form-state [state]
  (let [state (-> state
                  form-state/projection-state
                  form-state/validated-state)
        selection (:form/selection state)
        state (cond-> state
                selection (form-state/selection-derived-state
                           (:item-label selection)))]
    (form-actions/derived-state state (:form/actions state))))

(defun initialized-form-state
  "Derives value-dependent controller state after form bindings resolve."
  [state]
  (let [state (form-state state)]
    (assoc state
           :form/item-editor-state
           (initial-item-editor-state (:form/item-editors state)
                                      (:value state)))))

(defun changed-form-state [state payload]
  (let [base-value (cond
                     (and (:new? state) (some? (:projected-item state)))
                     (:projected-item state)

                     (and (not (:new? state)) (some? (:projected-index state)))
                     (:projected-item state)

                     :default
                     (:value state))
        next-value (if (:field-path payload)
                     (assoc-in base-value
                               (:field-path payload)
                               (:value payload))
                     (:form-value payload))
        state (cond
                (and (:new? state) (some? (:projected-item state)))
                (assoc state
                       :value next-value
                       :projected-item next-value)

                (and (not (:new? state)) (some? (:projected-index state)))
                (assoc state
                       :items (form-state/update-selected-item (:items state)
                                                    (:projected-index state)
                                                    next-value)
                       :selected-index (:projected-index state)
                       :value next-value
                       :projected-item next-value)

                :default
                (assoc state :value next-value))]
    (form-state state)))

(defun canonical-form-items [state]
  (unless (nil? (:items state))
    (for [item (:items state)]
      (model-canonical/canonical-value (:schema state) item))))

(defun form-state-draft-change-payload [next-state]
  (cond-> {:form-value (:value next-state)
           :value (:value next-state)}
    (:form/selection next-state)
    (assoc :items (:items next-state)
           :selected-index (:selected-index next-state)
           :new? (:new? next-state))))

(defun form-state-change-payload [next-state]
  (let [value (model-canonical/canonical-value (:schema next-state)
                                                (:value next-state))]
    (cond-> {:form-value value
             :value value}
      (:form/selection next-state)
      (assoc :items (canonical-form-items next-state)
             :selected-index (:selected-index next-state)
             :new? (:new? next-state)))))

(defun emit-form-state-change! [state next-state ctx]
  (when (not= state next-state)
    (ui/emit! (:view ctx)
              :form/change
              (form-state-change-payload next-state)))
  next-state)

(defcomponent pixils/form
  {:ui/state-keys [:form/item-editor-state]
   :init (fn [state ctx]
           (initialized-form-state state))
   :update (fn [state ctx]
             (form-state state))
   :on {:form/item-editor-state-change
        (fn [state event ctx]
          (ui/stop-propagation! event)
          (ui/set-ui-state!
           ctx
           (assoc-in (-> ctx :view :ui-state)
                     [:form/item-editor-state (-> event :payload :id)]
                     (-> event :payload :state)))
          state)
        :form/edit (fn [state event ctx]
                     (let [stopped (ui/stop-propagation! event)]
                       (if (:disabled? state)
                         state
                         (let [next-state
                               (changed-form-state state (:payload event))]
                           (unless (:new? next-state)
                             (ui/emit! (:view ctx)
                                       :form/draft-change
                                       (form-state-draft-change-payload
                                        next-state)))
                           (when (and (not (:new? next-state))
                                      (= :live (:form/mode state))
                                      (= true (-> event :payload :commit?)))
                             (ui/emit! (:view ctx)
                                       :form/change
                                       (form-state-change-payload
                                        next-state)))
                           next-state))))
        :form/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (let [{:keys [field-id index] :as payload} (:payload event)]
                         (if field-id
                           (do
                             (ui/emit! (:view ctx) :form/select payload)
                             state)
                           (let [next-state
                                 (form-state
                                  (assoc state
                                         :new? false
                                         :selected-index index))]
                             (ui/emit! (:view ctx)
                                       :form/select
                                       {:index index
                                        :value (:value next-state)})
                             next-state))))
        :form/new (fn [state event ctx]
                    (let [stopped (ui/stop-propagation! event)]
                      (let [add-action (form-action state :add)
                            dialog (selection-add-dialog-config state
                                                                add-action)]
                        (if dialog
                          (do
                            (open-selection-new-dialog! state ctx dialog)
                            state)
                          (let [next-state
                                (form-state (form-state/begin-new-state state))]
                            (replace-form-body! next-state ctx))))))
        :form/save-new (fn [state event ctx]
                         (let [stopped (ui/stop-propagation! event)]
                           (let [next-state (form-state (form-state/save-new-state state))]
                             (replace-form-body! next-state ctx)
                             (emit-form-state-change!
                              state
                              next-state
                              ctx))))
        :form/cancel-new (fn [state event ctx]
                           (let [stopped (ui/stop-propagation! event)]
                             (let [next-state
                                   (form-state (form-state/cancel-new-state state))]
                               (replace-form-body! next-state ctx))))
        :form/selection-dialog-result
        (fn [state event ctx]
          (let [stopped (ui/stop-propagation! event)]
            (let [next-state
                  (form-state
                   (array-editor-control/array-dialog-result-state
                    state
                    (:payload event)))]
              (when (not= state next-state)
                (replace-form-body! next-state ctx))
              (emit-form-state-change! state next-state ctx))))
        :form/delete (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (let [next-state (form-state (form-state/delete-state state))]
                           (replace-form-body! next-state ctx)
                           (emit-form-state-change!
                            state
                            next-state
                            ctx))))
        :form/move-up (fn [state event ctx]
                        (let [stopped (ui/stop-propagation! event)]
                          (let [next-state (form-state (form-state/move-up-state state))]
                            (replace-form-body! next-state ctx)
                            (emit-form-state-change!
                             state
                             next-state
                             ctx))))
        :form/move-down (fn [state event ctx]
                          (let [stopped (ui/stop-propagation! event)]
                            (let [next-state (form-state (form-state/move-down-state state))]
                              (replace-form-body! next-state ctx)
                              (emit-form-state-change!
                               state
                               next-state
                               ctx))))}})

(defun fields-view [children opts]
  (merge {:class :pixils.form/fields
          :state form-layout-state-binding
          :children children}
         (form-layout/style-map (:fields-style opts))))

(defun control-render-options
  "Adds generic form-rendering capabilities used by compound controls."
  [opts]
  (assoc opts
         :fields=> layout-item-views
         :form-body=> form-body-view
         :form=> make
         :selection=> list-box-control/for-selection))

(defun array-item-dialog-body
  "Builds an array-item dialog body through the extracted array editor."
  [item-schema opts]
  (array-editor-control/array-item-dialog-body
   item-schema
   (control-render-options opts)))

(defun array-control-view
  "Builds an array editor through the extracted array control module."
  [field-id field-schema opts items]
  (array-editor-control/array-control-view
   field-id
   field-schema
   (control-render-options opts)
   items))

(defun form-children [layout schema opts selection]
  (let [opts (control-render-options opts)
        root (model-schema/resolved-root-schema schema)]
    (case (:type root)
      :array [(array-editor-control/array-control-view
               nil root opts (ui/bind-state :value))]
      :default
      (let [defaulted-layout (or layout (default-layout schema opts))
            children (case (:type root)
                       :union [(object-form-control/root-view schema opts layout)]
                       :object (layout-item-views defaulted-layout opts)
                       nil (layout-item-views defaulted-layout opts)
                       :default [(root-field-view
                                  schema
                                  (assoc opts :form/layout layout))])
            fields (fields-view children opts)]
        (cond
          (nil? selection)
          [fields]

          (= (:placement selection) :right)
          [fields (list-box-control/for-selection selection opts)]

          :default
          [(list-box-control/for-selection selection opts) fields])))))

(defun form-body-view [layout schema opts selection]
  (merge {:id form-body-id
          :class :pixils.form/body
          :state form-layout-state-binding
          :children (form-children layout schema opts selection)}
         (form-layout/style-map (:body-style opts))))

(defun form-render-opts [state]
  (form-valid-values/with-options-cache
   (merge (:form/render-opts state)
          {:schema (model-schema/prepare-schema (:schema state))
           :value (:value state)
           :disabled? (:disabled? state)
           :context (:context state)})))

(defun form-body-from-state [state]
  (let [opts (form-render-opts state)]
    (form-body-view (:form/layout state)
                    (:schema state)
                    opts
                    (:form/render-selection state))))

(defun replace-form-body! [state ctx]
  (ui/replace-child! (:view ctx)
                     form-body-id
                     (form-body-from-state state))
  state)

(defun make [{:keys [schema text layout controls value style class
                     field-style field-label-style row-style separator-style
                     control-style valid? errors selection models projection]
              :as opts}]
  (let [layout-root (form-layout/root-layout layout)
        layout-fragments (or (form-layout/layout-fragments layout)
                             (:layout/fragments opts))
        projection (projection-entry models
                                     (or projection
                                         (form-layout/layout-projection
                                          layout-root)))
        layout-selection (form-layout/layout-selection layout-root)
        direct-state-selection
        (let [result (cond-> {}
                       (contains? opts :items) (assoc :items (:items opts))
                       (contains? opts :selected-index)
                       (assoc :selected-index (:selected-index opts))
                       (contains? opts :new?) (assoc :new? (:new? opts))
                       (contains? opts :new-value)
                       (assoc :new-value (:new-value opts))
                       (contains? opts :new-value-fn)
                       (assoc :new-value-fn (:new-value-fn opts))
                       (contains? opts :item-label)
                       (assoc :item-label (:item-label opts)))]
          (unless (empty? result)
            result))
        state-selection (merge layout-selection
                               (normalized-selection models selection projection)
                               direct-state-selection)
        state-selection
        (unless (empty? state-selection)
          (merge (:selection-defaults opts) state-selection))
        render-selection (when (or selection
                                   (and direct-state-selection
                                        (nil? layout-selection)))
                           state-selection)
        opts (assoc opts
                    :projection projection
                    :form/selection state-selection
                    :layout/fragments layout-fragments
                    :fragment-path (or (:fragment-path opts) []))
        state (normalized-form-state opts state-selection)
        schema (model-schema/prepare-schema (:schema state))
        item-editors (referenced-item-editors
                      (or layout-root
                          (default-layout schema
                                          (assoc opts
                                                 :schema schema
                                                 :value (:value state))))
                      (assoc opts :schema schema))
        item-editor-state (initial-item-editor-state item-editors (:value state))
        opts (form-valid-values/with-options-cache
               (assoc opts
                      :schema schema
                      :value (:value state)
                      :context (:context state)
                      :form/item-editors item-editors
                      :form/item-editor-state item-editor-state))
        state (assoc state
                     :schema schema
                     :form/item-editors item-editors
                     :form/item-editor-state item-editor-state
                     :form/selection state-selection
                     :form/render-selection render-selection
                     :form/actions
                     (concat (form-layout/layout-actions layout-root)
                             (form-selection/actions
                              (or state-selection {})))
                     :form/layout layout-root
                     :form/render-opts opts)]
    (merge {:mode 'pixils/form
            :state state
            :children [(form-body-view layout-root
                                       schema
                                       opts
                                       render-selection)]}
           (form-layout/style-map style)
           {:class (form-layout/classes :pixils.form/form class)})))
