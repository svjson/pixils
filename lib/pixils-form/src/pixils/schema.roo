(ns pixils.schema)

(def prepared-schema-key :pixils.schema/prepared?)

(defun prepared-schema? [schema]
  (and (= (type-of schema) "map")
       (= true (get schema prepared-schema-key))))

(defun blank-value? [value]
  (or (nil? value)
      (and (= (type-of value) "string")
           (= (count value) 0))))

(defun numeric-value? [value]
  (number? value))

(defun sequence-value? [value]
  (or (= (type-of value) "vector")
      (= (type-of value) "array")
      (= (type-of value) "list")))

(defun field-path [field-id field-schema]
  (let [path (:path field-schema)]
    (cond
      (nil? path) [field-id]
      (= (type-of path) "vector") path
      :default [path])))

(defun field-value [value field-id field-schema]
  (get-in (or value {}) (field-path field-id field-schema)))

(defun path-value [value path]
  (cond
    (nil? path) value
    (= (type-of path) "vector") (get-in (or value {}) path)
    :default (get (or value {}) path)))

(defun path-present-at? [value path index]
  (cond
    (>= index (count (or path []))) true

    (and (= (type-of value) "map")
         (contains? value (nth path index)))
    (path-present-at? (get value (nth path index))
                      path
                      (inc index))

    :default false))

(defun path-present? [value path]
  (path-present-at? value path 0))

(defun text-contains-at? [text needle index]
  (cond
    (> (+ index (count needle)) (count text)) false
    (= (substr text index (count needle)) needle) true
    :default (text-contains-at? text needle (inc index))))

(defun text-contains? [text needle]
  (text-contains-at? text needle 0))

(defun text-value [value]
  (if (nil? value) "" (str value)))

(defun canonical-keyword [value]
  (cond
    (nil? value)
    nil

    (keyword? value)
    value

    :default
    (let [text (keyword-label value)]
      (if (blank-value? text)
        nil
        (keyword text)))))

(defun canonical-number [value integer?]
  (cond
    (nil? value)
    nil

    (number? value)
    value

    (= (type-of value) "string")
    (let [text (text-value value)]
      (cond
        (blank-value? text)
        nil

        integer?
        (if (text-contains? text ".")
          nil
          (int text))

        :default
        (if (text-contains? text ".")
          (float text)
          (int text))))

    :default
    nil))

(defun schema-root [schema]
  (if (and (= (type-of schema) "map")
           (contains? schema :schema))
    (:schema schema)
    schema))

(defun schema-definitions [schema]
  (or (:definitions (or schema {})) {}))

(defun ref-seen? [seen-refs ref-id]
  (reduce (or seen-refs [])
          false
          (fn [found item]
            (or found (= item ref-id)))))

(defun ref-overrides [schema]
  (dissoc (or schema {}) :ref))

(defun merge-schema-nodes [base extension]
  (let [fields (merge (or (:fields base) {})
                      (or (:fields extension) {}))
        merged (merge base (dissoc extension :fields))]
    (if (empty? fields)
      merged
      (assoc merged :fields fields))))

(defun extension-base-schema [schema schema-node seen-refs]
  (let [extension (:extends schema-node)
        base-node (if (keyword? extension)
                    {:ref extension}
                    extension)]
    (resolve-schema-node schema base-node seen-refs)))

(defun resolve-variants [schema variants seen-refs]
  (reduce-kv (or variants {})
             {}
             (fn [resolved variant-key variant-schema]
               (assoc resolved
                      variant-key
                      (resolve-schema-node schema
                                           variant-schema
                                           seen-refs)))))

(defun resolve-fields [schema fields seen-refs]
  (reduce-kv (or fields {})
             {}
             (fn [resolved field-id field-schema]
               (assoc resolved
                      field-id
                      (resolve-schema-node schema
                                           field-schema
                                           seen-refs)))))

(defun resolve-nested-schema [schema resolved seen-refs]
  (cond
    (not (= (type-of resolved) "map"))
    resolved

    (= (:type resolved) :object)
    (assoc resolved
           :fields
           (resolve-fields schema (:fields resolved) seen-refs))

    (= (:type resolved) :array)
    (assoc resolved
           :items
           (resolve-schema-node schema (:items resolved) seen-refs))

    (= (:type resolved) :union)
    (assoc resolved
           :base
           (resolve-schema-node schema (:base resolved) seen-refs)
           :variants
           (resolve-variants schema (:variants resolved) seen-refs))

    :default resolved))

(defun resolve-schema-node [schema schema-node seen-refs]
  (cond
    (not (= (type-of schema-node) "map"))
    schema-node

    (contains? schema-node :ref)
    (let [ref-id (:ref schema-node)
          definition (get (schema-definitions schema) ref-id)
          next-seen-refs (concat (or seen-refs []) [ref-id])]
      (if (or (nil? definition)
              (ref-seen? seen-refs ref-id))
        schema-node
        (merge (resolve-schema-node schema
                                    definition
                                    next-seen-refs)
               (ref-overrides schema-node))))

    (contains? schema-node :extends)
    (resolve-nested-schema
     schema
     (merge-schema-nodes
      (extension-base-schema schema schema-node seen-refs)
      (dissoc schema-node :extends))
     seen-refs)

    :default
    (resolve-nested-schema schema schema-node seen-refs)))

(defun resolve-schema [schema schema-node]
  (resolve-schema-node schema schema-node []))

(defun resolved-root-schema [schema]
  (if (prepared-schema? schema)
    (schema-root schema)
    (resolve-schema schema (schema-root schema))))

(defun root-field-map? [root]
  (and (= (type-of root) "map")
       (not (keyword? (:type root)))
       (not (keyword? (:ref root)))
       (not (keyword? (:extends root)))
       (not (contains? root :schema))))

(defun prepare-root-schema [schema]
  (let [root (resolved-root-schema schema)]
    (if (root-field-map? root)
      (resolve-fields schema root [])
      root)))

(defun prepare-schema [schema]
  (if (or (nil? schema)
          (prepared-schema? schema))
    schema
    (let [root (prepare-root-schema schema)]
      (if (and (empty? (schema-definitions schema))
               (root-field-map? root))
        root
        (assoc {:definitions (schema-definitions schema)
                :schema root}
               prepared-schema-key
               true)))))

(defun schema-fields [schema]
  (let [root (resolved-root-schema schema)]
    (cond
      (= (:type root) :object)
      (or (:fields root) {})

      (= (:type root) :union)
      (union-fields schema root)

      :default
      (or root {}))))

(defun resolved-field-schema [schema field-id]
  (let [field-schema (get (schema-fields schema) field-id)]
    (if (prepared-schema? schema)
      field-schema
      (resolve-schema schema field-schema))))

(defun schema-field-ids [schema]
  (keys (schema-fields schema)))

(defun union-fields [schema union-schema]
  (reduce-kv (or (:variants union-schema) {})
             (schema-fields (schema-document-with-root
                             schema
                             (:base union-schema)))
             (fn [fields variant-key variant-schema]
               (merge fields
                      (schema-fields
                       (schema-document-with-root schema variant-schema))))))

(defun union-discriminator-value [union-schema value]
  (path-value value (:discriminator union-schema)))

(defun union-variant-schema [union-schema value]
  (get (or (:variants union-schema) {})
       (union-discriminator-value union-schema value)))

(defun active-schema-fields [schema value]
  (let [root (resolved-root-schema schema)]
    (cond
      (= (:type root) :object)
      (or (:fields root) {})

      (= (:type root) :union)
      (let [base-fields (schema-fields
                         (schema-document-with-root schema (:base root)))
            variant (union-variant-schema root value)]
        (if variant
          (merge base-fields
                 (schema-fields
                  (schema-document-with-root schema variant)))
          base-fields))

      :default
      (schema-fields schema))))

(defun active-schema-field-ids [schema value]
  (keys (active-schema-fields schema value)))

(defun active-schema-layout [schema value]
  (let [root (resolved-root-schema schema)]
    (cond
      (= (:type root) :object)
      (:layout root)

      (= (:type root) :union)
      (let [base-layout (-> (schema-document-with-root schema (:base root))
                            resolved-root-schema
                            :layout)
            variant (union-variant-schema root value)]
        (or (:layout variant)
            base-layout
            (:layout root)))

      :default nil)))

(defun field-visible? [schema field-id value]
  (contains? (active-schema-fields schema value) field-id))

(defun dynamic-field-visibility? [schema]
  (= (:type (resolved-root-schema schema)) :union))

(defun field-visibility-value [schema value]
  (let [root (resolved-root-schema schema)]
    (if (= (:type root) :union)
      (union-discriminator-value root value)
      nil)))

(defun schema-document-with-root [schema root]
  (cond
    (prepared-schema? schema)
    (assoc {:definitions (schema-definitions schema)
            :schema root}
           prepared-schema-key
           true)

    (empty? (schema-definitions schema))
    root

    :default
    {:definitions (schema-definitions schema)
     :schema root}))

(defun canonical-field [schema value field-id field-schema]
  (let [path (field-path field-id field-schema)]
    (if (path-present? value path)
      (assoc-in value
                path
                (canonical-value
                 (schema-document-with-root schema field-schema)
                 (get-in (or value {}) path)))
      value)))

(defun canonical-fields [schema fields value]
  (reduce-kv (or fields {})
             value
             (fn [result field-id field-schema]
               (canonical-field schema result field-id field-schema))))

(defun canonical-object [schema value]
  (if (= (type-of value) "map")
    (canonical-fields schema (active-schema-fields schema value) value)
    value))

(defun canonical-union [schema root value]
  (if (= (type-of value) "map")
    (let [base-value
          (canonical-value (schema-document-with-root schema (:base root))
                           value)]
      (canonical-fields schema
                        (active-schema-fields schema base-value)
                        base-value))
    value))

(defun canonical-array [schema root value]
  (if (sequence-value? value)
    (let [item-schema (schema-document-with-root schema (:items root))]
      (map value
           (fn [item]
             (canonical-value item-schema item))))
    value))

(defun canonical-value [schema value]
  (let [root (resolved-root-schema schema)]
    (case (:type root)
      :object
      (canonical-object schema value)

      :union
      (canonical-union schema root value)

      :array
      (canonical-array schema root value)

      :keyword
      (canonical-keyword value)

      :number
      (canonical-number value false)

      :integer
      (canonical-number value true)

      :default
      (if (root-field-map? root)
        (canonical-fields schema root value)
        value))))

(defun append-error [errors error]
  (if error
    (concat errors [error])
    errors))

(defun required-error [value field-schema]
  (when (and (= (:required field-schema) true)
             (blank-value? value))
    {:rule :required}))

(defun min-error [value field-schema]
  (let [min-value (:min field-schema)]
    (when (and (not (nil? min-value))
               (numeric-value? value)
               (< value min-value))
      {:rule :min
       :min min-value
       :actual value})))

(defun max-error [value field-schema]
  (let [max-value (:max field-schema)]
    (when (and (not (nil? max-value))
               (numeric-value? value)
               (> value max-value))
      {:rule :max
       :max max-value
       :actual value})))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun valid-values-map [valid-values]
  (if (= (type-of valid-values) "map")
    valid-values
    {}))

(defun source-field-value [value source]
  (path-value value (or (:field source)
                        (:path source))))

(defun valid-values-source-items [context value source]
  (cond
    (= (type-of source) "vector")
    (or (get-in (or context {}) source) [])

    (= (type-of source) "map")
    (let [source-key (source-field-value value source)
          source-path (get (or (:sources source) {}) source-key)]
      (if source-path
        (or (get-in (or context {}) source-path) [])
        []))

    :default []))

(defun valid-values-items [context valid-values value]
  (cond
    (nil? valid-values)
    []

    (= (type-of valid-values) "vector")
    valid-values

    (= (type-of valid-values) "map")
    (if (contains? valid-values :from)
      (valid-values-source-items context value (:from valid-values))
      (or (:values valid-values) []))

    :default []))

(defun option-value [item valid-values]
  (let [spec (valid-values-map valid-values)
        value-path (:value-path spec)]
    (cond
      value-path
      (get-in item value-path)

      (= (type-of item) "map")
      (if (contains? item :value)
        (:value item)
        (:id item))

      :default item)))

(defun option-label [item valid-values value]
  (let [spec (valid-values-map valid-values)
        label-path (:label-path spec)]
    (cond
      label-path
      (str (get-in item label-path))

      (= (type-of item) "map")
      (str (or (:label item)
               (:name item)
               (:id item)
               (:value item)
               value))

      :default
      (keyword-label value))))

(defun valid-value-option [valid-values item]
  (let [value (option-value item valid-values)]
    {:value value
     :label (option-label item valid-values value)}))

(defun valid-value-options-for-value [context field-schema value]
  (let [valid-values (:valid-values field-schema)]
    (map (valid-values-items context valid-values value)
         (fn [item]
           (valid-value-option valid-values item)))))

(defun valid-value-options [context field-schema]
  (valid-value-options-for-value context field-schema nil))

(defun valid-value-values [context field-schema value]
  (map (valid-value-options-for-value context field-schema value)
       (fn [option]
         (:value option))))

(defun value-in? [values value]
  (reduce (or values [])
          false
          (fn [found item]
            (or found (= item value)))))

(defun valid-value-error [context parent-value value field-schema]
  (let [valid-values (:valid-values field-schema)
        allowed (valid-value-values context field-schema parent-value)]
    (when (and valid-values
               (not (blank-value? value))
               (not (value-in? allowed value)))
      {:rule :valid-values
       :allowed allowed
       :actual value})))

(defun object-field-error [schema context value field-schema]
  (when (and (= (:type field-schema) :object)
             (not (blank-value? value)))
    (let [errors (validation-errors-with-context
                  (schema-document-with-root schema field-schema)
                  value
                  context)]
      (when (not (empty? (keys errors)))
        {:rule :object
         :errors errors}))))

(defun array-indexes [items]
  (if (empty? (or items []))
    []
    (range 0 (dec (count items)))))

(defun array-item-errors [schema context value field-schema]
  (let [item-schema (schema-document-with-root schema (:items field-schema))]
    (reduce (array-indexes value)
            {}
            (fn [errors index]
              (let [item-errors (validation-errors-with-context
                                 item-schema
                                 (nth value index)
                                 context)]
                (if (empty? (keys item-errors))
                  errors
                  (assoc errors index item-errors)))))))

(defun array-value-error [schema context value field-schema]
  (when (and (= (:type field-schema) :array)
             (not (blank-value? value)))
    (let [errors (array-item-errors schema context value field-schema)]
      (when (not (empty? (keys errors)))
        {:rule :array
         :errors errors}))))

(defun validate-field-with-context [schema value field-id context]
  (let [field-schema (resolved-field-schema schema field-id)
        field-value (field-value value field-id field-schema)
        errors (append-error [] (required-error field-value field-schema))
        errors (append-error errors (min-error field-value field-schema))
        errors (append-error errors (max-error field-value field-schema))
        errors (append-error errors
                             (valid-value-error context
                                                value
                                                field-value
                                                field-schema))
        errors (append-error errors
                             (object-field-error schema
                                                 context
                                                 field-value
                                                 field-schema))
        errors (append-error errors
                             (array-value-error schema
                                                context
                                                field-value
                                                 field-schema))]
    errors))

(defun validate-field [schema value field-id]
  (validate-field-with-context schema value field-id {}))

(defun validation-errors-with-context [schema value context]
  (let [root (resolved-root-schema schema)]
    (if (= (:type root) :array)
      (let [error (array-value-error schema context value root)]
        (if error {:value [error]} {}))
      (reduce-kv (active-schema-fields schema value)
                 {}
                 (fn [errors field-id field-schema]
                   (let [field-errors (validate-field-with-context schema
                                                                   value
                                                                   field-id
                                                                   context)]
                     (if (empty? field-errors)
                       errors
                       (assoc errors field-id field-errors))))))))

(defun validation-errors [schema value]
  (validation-errors-with-context schema value {}))

(defun validate-with-context [schema value context]
  (let [errors (validation-errors-with-context schema value context)]
    {:valid? (empty? (keys errors))
     :errors errors}))

(defun validate [schema value]
  (validate-with-context schema value {}))
