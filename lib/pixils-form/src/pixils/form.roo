(ns pixils.form
  (:require pixils
            [pixils.schema :as model-schema]
            [pixils.ui :as ui]
            pixils.ui.button
            [pixils.ui.checkbox :as checkbox]
            [pixils.ui.combo-box :as combo-box]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.list-box :as list-box]
            [pixils.ui.number-input :as number-input]))

(def default-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-field-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 3}})

(def default-field-label-style
  {:width :fill})

(def default-row-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 10}})

(def default-separator-style
  {:width :fill
   :height 1
   :background {:r 0x9a :g 0x9a :b 0x92}})

(def default-control-style
  {:width :fill
   :height 24})

(def default-keyword-control-style
  {:width :fill
   :height 24
   :layout {:direction :row
            :align-items :center
            :gap 4}})

(def checkbox-style
  {:width :fill
   :height 24})

(def default-display-style
  {:width :fill
   :height 18})

(def default-selection-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 4}})

(def default-selection-list-style
  {:width :fill})

(def default-fields-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-object-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-array-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-array-content-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 8}})

(def default-array-list-style
  {:width 220
   :height 100})

(def default-array-list-box-style
  {:width :fill
   :height :fill})

(def default-array-summary-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 4}})

(def default-array-toolbar-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :center
            :gap 6}})

(def default-array-summary-row-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 6}})

(def default-array-summary-label-style
  {:width 90})

(def default-array-summary-value-style
  {:width :fill})

(def default-array-dialog-style
  {:width 440
   :height :shrink})

(def default-array-dialog-body-style
  {:width :fill
   :height :shrink
   :padding 12
   :layout {:direction :column
            :gap 10}})

(def default-array-dialog-button-row-style
  {:width :fill
   :height 24
   :layout {:direction :row
            :gap :space-between}})

(def default-action-style
  {:width 96
   :height 24})

(def separator-token :------)

(def form-state-binding
  {:value (ui/bind-state :value)})

(defun class-map [class]
  (if class {:class class} {}))

(defun defaultable-style [style class default-style]
  (or style
      (when (nil? class) default-style)))

(defun style-map [style]
  (if style {:style style} {}))

(defun keyword-label [value]
  (let [text (str value)]
    (if (= ":" (substr text 0 1))
      (substr text 1)
      text)))

(defun text-index-of [text needle index]
  (cond
    (>= index (count text)) nil
    (= (substr text index 1) needle) index
    :default (text-index-of text needle (inc index))))

(defun layout-class-index [label]
  (or (text-index-of label "#" 0)
      (text-index-of label "." 0)))

(defun canonical-layout-type [type]
  (if (= type :button) :action type))

(defun layout-token [token]
  (let [label (keyword-label token)
        class-index (layout-class-index label)]
    (if class-index
      {:type (canonical-layout-type
              (keyword (substr label 0 class-index)))
       :class (keyword (substr label (inc class-index)))}
      {:type (canonical-layout-type token)})))

(defun apply-layout-token [node token]
  (let [parsed (layout-token token)]
    (if (:class parsed)
      (assoc node
             :type (:type parsed)
             :class (:class parsed))
      (assoc node :type (:type parsed)))))

(defun layout-vector-type [item]
  (when (and (= (type-of item) "vector")
             (> (count item) 0)
             (keyword? (nth item 0)))
    (:type (layout-token (nth item 0)))))

(defun dsl-layout-vector? [item]
  (let [type (layout-vector-type item)]
    (or (= type :row)
        (= type :group)
        (= type :form)
        (= type :selection)
        (= type :action))))

(defun vector-tail [items start]
  (if (>= start (count items))
    []
    (concat [(nth items start)]
            (vector-tail items (inc start)))))

(defun vector-option [items index]
  (when (and (< index (count items))
             (= (type-of (nth items index)) "map"))
    (nth items index)))

(defun normalize-layout-item [item]
  (cond
    (= (type-of item) "vector")
    (if (dsl-layout-vector? item)
      (normalize-dsl-layout item)
      item)

    :default item))

(defun normalize-layout-children [items]
  (map (or items []) normalize-layout-item))

(defun normalize-dsl-layout [item]
  (let [token (nth item 0)
        type (layout-vector-type item)]
    (case type
      :row
      (apply-layout-token {:children (normalize-layout-children
                                      (vector-tail item 1))}
                          token)

      :group
      (apply-layout-token {:children (normalize-layout-children
                                      (vector-tail item 1))}
                          token)

      :form
      (apply-layout-token {:model (nth item 1)
                           :layout (nth item 2)}
                          token)

      :selection
      (merge (apply-layout-token {:projection (nth item 1)}
                                 token)
             (or (vector-option item 2) {}))

      :action
      (merge (apply-layout-token {:id (nth item 1)}
                                 token)
             (or (vector-option item 2) {}))

      :default item)))

(defun child-models [entry]
  (or (:models entry)
      (:children entry)))

(defun model-entry-at [models path index]
  (let [entry (get (or models {}) (nth path index))]
    (if (or (nil? entry)
            (= index (dec (count path))))
      entry
      (model-entry-at (child-models entry) path (inc index)))))

(defun model-entry [models model-id]
  (cond
    (nil? model-id) nil
    (= (type-of model-id) "vector") (model-entry-at models model-id 0)
    :default (get (or models {}) model-id)))

(defun model-value [models model-id]
  (:value (or (model-entry models model-id) {})))

(defun model-schema [models model-id]
  (:schema (or (model-entry models model-id) {})))

(defun model-ref? [models value]
  (or (= (type-of value) "vector")
      (and (keyword? value)
           (contains? (or models {}) value))))

(defun model-ref-value [models value]
  (if (model-ref? models value)
    (model-value models value)
    value))

(defun primary-model-id [opts projection]
  (or (:model opts)
      (:target projection)))

(defun projection-entry-at [models path index]
  (let [entry (get (or models {}) (nth path index))]
    (cond
      (nil? entry)
      nil

      (= index (- (count path) 2))
      (get (or (:projections entry) {}) (nth path (dec (count path))))

      :default
      (projection-entry-at (child-models entry) path (inc index)))))

(defun projection-entry [models projection]
  (cond
    (nil? projection) nil
    (= (type-of projection) "map") projection
    (= (type-of projection) "vector") (projection-entry-at models projection 0)
    :default projection))

(defun selection-value [models selection projection key]
  (model-ref-value models (or (get selection key)
                              (get projection key))))

(defun normalized-selection [models selection projection]
  (when (or selection projection)
    (assoc (or selection {})
           :items (selection-value models selection projection :items)
           :selected-index
           (selection-value models selection projection :selected-index)
           :new? (selection-value models selection projection :new?)
           :new-value
           (selection-value models selection projection :new-value)
           :new-value-fn
           (or (:new-value-fn selection)
               (:new-value-fn projection)))))

(defun normalized-form-state [{:keys [schema value valid? errors models context
                                      projection]
                               :as opts}
                              selection]
  (let [model-id (primary-model-id opts projection)]
    {:value (or value (model-value models model-id))
     :schema (or schema (model-schema models model-id))
     :context context
     :valid? valid?
     :errors errors
     :items (:items selection)
     :selected-index (:selected-index selection)
     :new? (:new? selection)
     :new-value (:new-value selection)
     :new-template (:new-value selection)
     :new-value-fn (:new-value-fn selection)}))

(defun field-path [field-id field-schema]
  (model-schema/field-path field-id field-schema))

(defun field-value [value field-id field-schema]
  (model-schema/field-value value field-id field-schema))

(defun form-truthy? [value]
  (and (not (nil? value))
       (not (= false value))))

(defun condition-value [state condition]
  (cond
    (keyword? condition) (get state condition)

    (= (type-of condition) "vector")
    (let [op (nth condition 0)]
      (cond
        (= op :not)
        (not (form-truthy? (condition-value state (nth condition 1))))

        (= op :and)
        (and (form-truthy? (condition-value state (nth condition 1)))
             (form-truthy? (condition-value state (nth condition 2))))

        (= op :or)
        (or (form-truthy? (condition-value state (nth condition 1)))
            (form-truthy? (condition-value state (nth condition 2))))

        (= op :=)
        (= (condition-value state (nth condition 1))
           (nth condition 2))

        :default condition))

    :default condition))

(defun condition-true? [state condition]
  (form-truthy? (condition-value state condition)))

(defun action-disabled? [state]
  (let [form-state (:form-state state)]
    (or (condition-true? form-state (:disabled-when state))
        (and (not (nil? (:enabled-when state)))
             (not (condition-true? form-state
                                   (:enabled-when state)))))))

(defun validate-field [schema value field-id]
  (model-schema/validate-field schema value field-id))

(defun validation-errors [schema value]
  (model-schema/validation-errors schema value))

(defun validate [schema value]
  (model-schema/validate schema value))

(defun validate-with-context [schema value context]
  (model-schema/validate-with-context schema value context))

(defun selected-item [items index]
  (let [items (or items [])]
    (when (and (not (nil? index))
               (>= index 0)
               (< index (count items)))
      (nth items index))))

(defun default-item-label [item index]
  (or (:label item)
      (:name item)
      (:id item)
      (str "Item " (inc index))))

(defun path-value [item path]
  (cond
    (nil? path) item
    (= (type-of path) "vector") (get-in item path)
    :default (get item path)))

(defun value-text [value empty-text]
  (if (or (nil? value)
          (and (= (type-of value) "string")
               (= (count value) 0)))
    (or empty-text "")
    (str value)))

(defun configured-item-label [item index item-label]
  (cond
    (nil? item-label)
    (default-item-label item index)

    (= (type-of item-label) "vector")
    (value-text (path-value item item-label)
                (default-item-label item index))

    (= (type-of item-label) "map")
    (value-text (path-value item (:path item-label))
                (or (:empty item-label)
                    (default-item-label item index)))

    :default
    (item-label item index)))

(defun selection-option [item index item-label]
  {:value index
   :label (configured-item-label item index item-label)})

(defun selection-options [items item-label]
  (for-indexed [index item (or items [])]
    (selection-option item index item-label)))

(defun selected-indices [index]
  (if (nil? index) [] [index]))

(defun update-selected-item [items index value]
  (let [items (or items [])]
    (if (and (not (nil? index))
             (>= index 0)
             (< index (count items)))
      (assoc items index value)
      items)))

(defun new-form-value [state]
  (let [new-value-fn (:new-value-fn state)]
    (cond
      new-value-fn
      (apply new-value-fn [(count (or (:items state) []))])

      (not (nil? (:new-template state)))
      (:new-template state)

      :default {})))

(defun begin-new-state [state]
  (let [value (new-form-value state)]
    (assoc state
           :new? true
           :new-value value
           :value value
           :previous-selected-index (:selected-index state)
           :selected-index nil
           :projected-new? true
           :projected-index nil
           :projected-item value)))

(defun save-new-state [state]
  (let [items (or (:items state) [])
        index (count items)
        value (:value state)]
    (if (and (:new? state)
             (:valid? state))
      (assoc state
             :items (concat items [value])
             :selected-index index
             :new? false
             :new-value nil
             :previous-selected-index nil
             :projected-new? false
             :projected-index index
             :projected-item value)
      state)))

(defun remove-item-at-index [items index]
  (let [items (or items [])]
    (if (empty? items)
      []
      (reduce (range 0 (dec (count items)))
              []
              (fn [result item-index]
                (if (= item-index index)
                  result
                  (concat result [(nth items item-index)])))))))

(defun delete-state [state]
  (let [items (or (:items state) [])
        selected-index (:selected-index state)]
    (if (and (not (nil? selected-index))
             (>= selected-index 0)
             (< selected-index (count items)))
      (let [next-items (remove-item-at-index items selected-index)
            next-index (cond
                         (empty? next-items) nil
                         (< selected-index (count next-items)) selected-index
                         :default (dec (count next-items)))]
        (assoc state
               :items next-items
               :selected-index next-index
               :new? false
               :new-value nil
               :previous-selected-index nil
               :projected-new? false
               :projected-index nil
               :projected-item nil))
      state)))

(defun swap-item-indexes [items left-index right-index]
  (assoc (assoc items
                left-index
                (nth items right-index))
         right-index
         (nth items left-index)))

(defun move-selected-state [state offset]
  (let [items (or (:items state) [])
        selected-index (:selected-index state)
        next-index (when (not (nil? selected-index))
                     (+ selected-index offset))]
    (if (and (not (:new? state))
             (not (nil? selected-index))
             (>= selected-index 0)
             (< selected-index (count items))
             (>= next-index 0)
             (< next-index (count items)))
      (assoc state
             :items (swap-item-indexes items selected-index next-index)
             :selected-index next-index
             :projected-index nil
             :projected-item nil)
      state)))

(defun move-up-state [state]
  (move-selected-state state -1))

(defun move-down-state [state]
  (move-selected-state state 1))

(defun insert-item-at-index [items index item]
  (let [items (or items [])
        item-count (count items)
        index (max 0 (min item-count index))]
    (if (= index item-count)
      (concat items [item])
      (reduce (range 0 (dec item-count))
              []
              (fn [result item-index]
                (let [result (if (= item-index index)
                               (concat result [item])
                               result)]
                  (concat result [(nth items item-index)])))))))

(defun move-item-state [state from-index to-index]
  (let [items (or (:items state) [])
        item-count (count items)]
    (if (and (>= from-index 0)
             (< from-index item-count)
             (>= to-index 0)
             (< to-index item-count)
             (not= from-index to-index))
      (let [item (nth items from-index)
            next-items (insert-item-at-index
                        (remove-item-at-index items from-index)
                        to-index
                        item)]
        (assoc state
               :items next-items
               :selected-index to-index
               :projected-index nil
               :projected-item nil))
      state)))

(defun cancel-new-state [state]
  (assoc state
         :selected-index (:previous-selected-index state)
         :new? false
         :new-value nil
         :previous-selected-index nil
         :projected-new? false
         :projected-index nil
         :projected-item nil))

(defun projection-state [state]
  (let [new? (:new? state)
        items (:items state)
        selected-index (:selected-index state)
        selected (selected-item items selected-index)
        value (:value state)]
    (cond
      (nil? items)
      state

      new?
      (if (:projected-new? state)
        (assoc state :projected-item value)
        (assoc state
               :value (:new-value state)
               :projected-new? true
               :projected-index nil
               :projected-item (:new-value state)))

      (or (not= selected-index (:projected-index state))
          (not= selected (:projected-item state)))
      (assoc state
             :value selected
             :projected-new? false
             :projected-index selected-index
             :projected-item selected)

      (not= value selected)
      (assoc state
             :items (update-selected-item items selected-index value)
             :projected-item value)

      :default state)))

(defun field-binding [field-id field-schema]
  (apply ui/bind-state (concat [:value] (field-path field-id field-schema))))

(defun label-for [field-id text]
  (or (get (or text {}) field-id)
      (str field-id)))

(defun field-value-text [field-id field-schema]
  {:mode 'ui/text
   :style default-display-style
   :state {:value (field-binding field-id field-schema)}})

(defun text-control [field-id field-schema field-label opts]
  {:mode 'ui/text-input
   :style (or (:control-style opts) default-control-style)
   :state {:value (field-binding field-id field-schema)
           :auto-focus? (:auto-focus? field-schema)
           :read-only? (:read-only? field-schema)}})

(defcomponent pixils/form-keyword-input
  {:children [{:mode 'ui/text
               :class :ui/muted
               :style {:width :shrink}
               :state {:value ":"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height :fill}
               :state {:value (ui/bind-state :value)
                       :auto-focus? (ui/bind-state :auto-focus?)
                       :read-only? (ui/bind-state :read-only?)}}]})

(defun keyword-control [field-id field-schema field-label opts]
  {:mode 'pixils/form-keyword-input
   :style (merge default-keyword-control-style
                 (or (:control-style opts) {}))
   :state {:value (field-binding field-id field-schema)
           :auto-focus? (:auto-focus? field-schema)
           :read-only? (:read-only? field-schema)}})

(defun number-control [field-id field-schema field-label opts]
  (number-input/make {:style (or (:control-style opts) default-control-style)
                      :value (field-binding field-id field-schema)
                      :min (:min field-schema)
                      :max (:max field-schema)
                      :step (:step field-schema)
                      :allow-negative? (:allow-negative? field-schema)
                      :allow-fractions? (:allow-fractions? field-schema)
                      :disabled? (:read-only? field-schema)
                      :auto-focus? (:auto-focus? field-schema)}))

(defun boolean-control [field-id field-schema field-label opts]
  (checkbox/make {:style checkbox-style
                  :label ""
                  :checked? (field-binding field-id field-schema)
                  :value field-id}))

(defun display-control [field-id field-schema field-label opts]
  (field-value-text field-id field-schema))

(defcomponent pixils/form-object-control
  {})

(defun object-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts) field-schema))

(defun object-control [field-id field-schema field-label opts]
  (let [schema (object-schema field-schema opts)
        object-opts (assoc opts :schema schema)
        children (map (or (:layout field-schema)
                          (default-layout schema))
                      (fn [item]
                        (layout-item-view item object-opts)))]
    {:mode 'pixils/form-object-control
     :style (or (:object-style opts) default-object-style)
     :state {:value (field-binding field-id field-schema)}
     :children children}))

(defun array-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts) field-schema))

(defun array-item-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts)
                                         (:items field-schema)))

(defun selected-array-index? [state]
  (let [items (or (:items state) [])
        index (:selected-index state)]
    (and (not (nil? index))
         (>= index 0)
         (< index (count items)))))

(defun selected-array-index-above-first? [state]
  (and (selected-array-index? state)
       (> (:selected-index state) 0)))

(defun selected-array-index-below-last? [state]
  (let [items (or (:items state) [])]
    (and (selected-array-index? state)
         (< (:selected-index state) (dec (count items))))))

(defun ensure-array-selection-state [state]
  (if (and (not (:new? state))
           (nil? (:selected-index state))
           (not (empty? (or (:items state) []))))
    (assoc state :selected-index 0)
    state))

(defun array-editor-option [editor key default-value]
  (if (contains? (or editor {}) key)
    (get editor key)
    default-value))

(defun array-editor-mode [editor]
  (or (:edit-mode editor) :dialog))

(defun array-editor-dialog? [editor]
  (= (array-editor-mode editor) :dialog))

(defun array-actions-state [state]
  (let [editor (:array-editor state)
        read-only? (:read-only? state)
        can-select? (selected-array-index? state)
        dialog? (array-editor-dialog? editor)
        allow-add? (array-editor-option editor :allow-add? true)
        allow-edit? (array-editor-option editor :allow-edit? true)
        allow-delete? (array-editor-option editor :allow-delete? true)
        allow-reorder? (array-editor-option editor :allow-reorder? true)]
    (assoc state
           :can-add? (and (not read-only?)
                          dialog?
                          allow-add?)
           :can-edit? (and (not read-only?)
                           dialog?
                           allow-edit?
                           can-select?)
           :can-delete? (and (not read-only?)
                             allow-delete?
                             can-select?)
           :reorderable? (and (not read-only?)
                              allow-reorder?))))

(defun summary-spec-path [item-schema field-id]
  (model-schema/field-path field-id
                           (model-schema/resolved-field-schema item-schema
                                                               field-id)))

(defun summary-field-spec [item-schema field-id]
  {:label (str field-id)
   :path (summary-spec-path item-schema field-id)})

(defun inferred-summary-specs [item-schema]
  (let [root (model-schema/resolved-root-schema item-schema)]
    (if (= (:type root) :object)
      (map (model-schema/schema-field-ids item-schema)
           (fn [field-id]
             (summary-field-spec item-schema field-id)))
      [{:label "Value"}])))

(defun array-summary-specs [field-schema item-schema]
  (or (:item-summary field-schema)
      (inferred-summary-specs item-schema)))

(defun summary-entry-value [item spec]
  (value-text (path-value item (:path spec))
              (or (:empty spec) "")))

(defun summary-entry [item spec selected?]
  (if selected?
    {:label (:label spec)
     :value (summary-entry-value item spec)}
    {:label ""
     :value ""}))

(defun empty-summary-values [specs]
  (let [entry-count (max 1 (count specs))]
    (concat [{:label ""
              :value "No item selected"}]
            (map (range 1 (dec entry-count))
                 (fn [index]
                   {:label ""
                    :value ""})))))

(defun selected-summary-values [item specs]
  (let [selected? (not (nil? item))
        specs (or specs [])]
    (if selected?
      (map specs (fn [spec] (summary-entry item spec true)))
      (empty-summary-values specs))))

(defun summary-row-view [index]
  {:style default-array-summary-row-style
   :children [{:mode 'ui/text
               :class :ui/muted
               :style default-array-summary-label-style
               :state {:value (ui/bind-state :summary index :label)}}
              {:mode 'ui/text
               :style default-array-summary-value-style
               :state {:value (ui/bind-state :summary index :value)}}]})

(defcomponent pixils/form-array-summary
  {:update (fn [state ctx]
             (assoc state
                    :summary
                    (selected-summary-values (:item state)
                                             (:specs state))))})

(defun array-summary-view [summary-specs]
  {:mode 'pixils/form-array-summary
   :style default-array-summary-style
   :state {:item (ui/bind-state :value)
           :specs summary-specs}
   :children (map (range 0 (dec (max 1 (count summary-specs))))
                  summary-row-view)})

(defun array-validation-state [state]
  (let [validation (model-schema/validate-with-context
                   (:item-schema state)
                   (:value state)
                   (:context state))]
    (assoc state
           :valid? (:valid? validation)
           :errors (:errors validation))))

(defun array-control-state [state]
  (let [state (ensure-array-selection-state state)
        state (projection-state state)
        state (array-validation-state state)]
    (array-actions-state state)))

(defun array-toolbar []
  {:style default-array-toolbar-style
   :state (ui/bind-state)
   :children [(action-view {:id :form/add-item
                            :label "Add"
                            :enabled-when :can-add?})
              (action-view {:id :form/edit-item
                            :label "Edit"
                            :enabled-when :can-edit?})
              (action-view {:id :form/delete
                            :label "Delete"
                            :enabled-when :can-delete?})]})

(defun array-item-form-view [item-schema opts]
  (let [item-opts (assoc opts :schema item-schema)
        children (map (default-layout item-schema)
                      (fn [item]
                        (layout-item-view item item-opts)))]
    {:mode 'pixils/form
     :style default-fields-style
     :state {:value (ui/bind-state :value)
             :schema item-schema
             :context (:context opts)
             :valid? (ui/bind-state :valid?)
             :errors (ui/bind-state :errors)}
     :children children}))

(defun array-item-dialog-result [state event ctx]
  (let [choice (-> event :payload :choice)]
    (if (= choice :dialog/ok)
      {:type :confirm
       :index (:index state)
       :new? (:new? state)
       :value (:value state)}
      {:type :cancel})))

(defun array-item-dialog-button-handler [state event ctx]
  (do
    (ui/stop-propagation! event)
    (pop-mode! (array-item-dialog-result state event ctx))
    state))

(defun array-item-dialog-body [item-schema context]
  (assoc
   (dialog/make-dialog-body
    {:body [(array-item-form-view item-schema
                                  {:context context})]
     :buttons [:dialog/ok :dialog/cancel]
     :state {:value (ui/bind-state :value)
             :index (ui/bind-state :index)
             :new? (ui/bind-state :new?)
             :valid? (ui/bind-state :valid?)
             :errors (ui/bind-state :errors)}
     :body-style default-array-dialog-body-style
     :button-row-style default-array-dialog-button-row-style})
   :on {:dialog/button array-item-dialog-button-handler}))

(defun open-array-item-dialog! [state ctx new?]
  (let [index (:selected-index state)
        value (if new?
                (new-form-value state)
                (:value state))]
    (dialog/open-dialog! ctx
                         {:title (if new? "Add Item" "Edit Item")
                          :style default-array-dialog-style
                          :result-event :form/array-item-dialog-result
                          :state {:value value
                                  :index index
                                  :new? new?}
                          :body (array-item-dialog-body (:item-schema state)
                                                        (:context state))})))

(defun array-dialog-result-state [state payload]
  (if (= (:type payload) :confirm)
    (let [items (or (:items state) [])
          value (:value payload)
          index (:index payload)]
      (if (:new? payload)
        (assoc state
               :items (concat items [value])
               :selected-index (count items)
               :projected-index nil
               :projected-item nil)
        (assoc state
               :items (update-selected-item items index value)
               :selected-index index
               :projected-index nil
               :projected-item nil)))
    state))

(defcomponent pixils/form-array-control
  {:update (fn [state ctx]
             (array-control-state state))
   :on {:form/add-item (fn [state event ctx]
                         (do
                           (ui/stop-propagation! event)
                           (when (:can-add? state)
                             (open-array-item-dialog! state ctx true))
                           state))
        :form/edit-item (fn [state event ctx]
                          (do
                            (ui/stop-propagation! event)
                            (when (:can-edit? state)
                              (open-array-item-dialog! state ctx false))
                            state))
        :form/array-item-dialog-result (fn [state event ctx]
                                         (do
                                           (ui/stop-propagation! event)
                                           (array-dialog-result-state
                                            state
                                            (:payload event))))
        :form/delete (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (delete-state state)))
        :form/reorder (fn [state event ctx]
                        (do
                          (ui/stop-propagation! event)
                          (move-item-state state
                                           (-> event :payload :from-index)
                                           (-> event :payload :to-index))))}})

(defun array-control-view [field-schema opts items-binding]
  (let [item-schema (array-item-schema field-schema opts)
        summary-specs (array-summary-specs field-schema item-schema)]
    {:mode 'pixils/form-array-control
     :style (or (:array-style opts) default-array-style)
     :state {:items items-binding
             :item-schema item-schema
             :context (:context opts)
             :new-template (or (:new-template field-schema)
                               (:new-value field-schema)
                               {})
             :item-label (:item-label field-schema)
             :array-editor (:array-editor field-schema)
             :read-only? (:read-only? field-schema)}
     :children [{:style default-array-content-style
                 :state (ui/bind-state)
                 :children [(selection-control-view
                             {:item-label (:item-label field-schema)
                              :style default-array-list-style
                              :list-style default-array-list-box-style
                              :visible-rows 5
                              :fixed-visible-rows? true
                              :reorderable? (ui/bind-state :reorderable?)
                              :activate-event :form/edit-item})
                            (array-summary-view summary-specs)]}
                (array-toolbar)]}))

(defun array-control [field-id field-schema field-label opts]
  (array-control-view field-schema
                      opts
                      (field-binding field-id field-schema)))

(defun select-option-index-from [options value index]
  (cond
    (>= index (count options))
    nil

    (= (:value (nth options index)) value)
    index

    :default
    (select-option-index-from options value (inc index))))

(defun select-option-index [options value]
  (select-option-index-from (or options []) value 0))

(defun select-control-state [state]
  (assoc state
         :selected-index
         (select-option-index (:options state)
                              (:value state))))

(defun select-options [field-schema opts]
  (let [options (model-schema/valid-value-options (:context opts)
                                                  field-schema)]
    (if (= true (:required field-schema))
      options
      (concat [{:value nil
                :label ""}]
              options))))

(defcomponent pixils/form-select-control
  {:init (fn [state ctx]
           (select-control-state state))
   :update (fn [state ctx]
             (select-control-state state))
   :on {:combo-box/change (fn [state event ctx]
                            (let [payload (:payload event)]
                              (ui/stop-propagation! event)
                              (assoc (assoc state
                                            :value (:value payload))
                                     :selected-index
                                     (:selected-index payload))))}
   :children [(combo-box/make {:options (ui/bind-state :options)
                               :selected-index
                               (ui/bind-state :selected-index)
                               :style {:width :fill
                                       :height :fill}
                               :row-height (ui/bind-state :row-height)
                               :max-height (ui/bind-state :max-height)
                               :disabled?
                               (ui/bind-state :disabled?)})]})

(defun select-control [field-id field-schema field-label opts]
  {:mode 'pixils/form-select-control
   :style (or (:control-style opts) default-control-style)
   :state {:value (field-binding field-id field-schema)
           :options (select-options field-schema opts)
           :row-height (:row-height field-schema)
           :max-height (:max-height field-schema)
           :disabled? (:read-only? field-schema)}})

(def default-controls
  {:text text-control
   :string text-control
   :select select-control
   :object object-control
   :array array-control
   :keyword keyword-control
   :integer number-control
   :number number-control
   :boolean boolean-control
   :display display-control})

(defun field-control-type [field-schema]
  (if (:valid-values field-schema)
    :select
    (:type field-schema)))

(defun field-control [field-id field-schema field-label opts]
  (let [controls (merge default-controls (or (:controls opts) {}))
        control (get controls (field-control-type field-schema))]
    (if control
      (apply control [field-id field-schema field-label opts])
      (display-control field-id field-schema field-label opts))))

(defun field-view [field-id opts]
  (let [schema (or (:schema opts) {})
        text (:text opts)
        field-schema (model-schema/resolved-field-schema schema field-id)
        field-label (label-for field-id text)]
    (if field-schema
      {:style (or (:field-style opts) default-field-style)
       :state form-state-binding
       :children [{:mode 'ui/text
                   :class :ui/muted
                   :style (or (:field-label-style opts)
                              default-field-label-style)
                   :state {:value field-label}}
                  (field-control field-id field-schema field-label opts)]}
      {:mode 'ui/text
       :state {:value (str "Unknown form field " field-id)}})))

(defun separator-view [opts]
  {:style (or (:separator-style opts) default-separator-style)})

(defun row-view [items opts]
  {:style (or (:row-style opts) default-row-style)
   :state form-state-binding
   :children (map items (fn [item] (layout-item-view item opts)))})

(defun model-layout-opts [opts item]
  (let [models (:models opts)
        model-id (or (:model item)
                     (:model opts))
        entry (model-entry models model-id)]
    (assoc opts
           :model model-id
           :schema (or (:schema item)
                       (:schema entry)
                       (:schema opts))
           :text (or (:text item)
                     (:text opts)))))

(defun form-layout-view [item opts]
  (let [opts (model-layout-opts opts item)
        schema (:schema opts)
        children (map (or (:layout item)
                          (default-layout schema))
                      (fn [child]
                        (layout-item-view child opts)))]
    (merge {:state (ui/bind-state)
            :children children}
           (style-map (defaultable-style (:style item)
                                         (:class item)
                                         default-fields-style))
           (class-map (:class item)))))

(defun selection-layout-view [item opts]
  (let [projection (projection-entry (:models opts)
                                     (:projection item))]
    (selection-control-view (normalized-selection (:models opts)
                                                 item
                                                 projection))))

(defun row-layout-view [item opts]
  (merge {:state (ui/bind-state)
          :children (map (:children item)
                         (fn [child]
                           (layout-item-view child opts)))}
         (style-map (or (:style item)
                        (when (nil? (:class item))
                          (or (:row-style opts)
                              default-row-style))))
         (class-map (:class item))))

(defun map-layout-item-view [item opts]
  (cond
    (= (:type item) :form) (form-layout-view item opts)
    (= (:type item) :selection) (selection-layout-view item opts)
    (= (:type item) :action) (action-view item)
    (= (:type item) :group) (row-layout-view item opts)
    (= (:type item) :row) (row-layout-view item opts)
    :default {:mode 'ui/text
              :state {:value (str "Unknown form layout item " item)}}))

(defun layout-item-view [item opts]
  (let [item (normalize-layout-item item)]
    (cond
      (= item separator-token) (separator-view opts)
      (= (type-of item) "vector") (row-view item opts)
      (= (type-of item) "map") (map-layout-item-view item opts)
      :default (field-view item opts))))

(defun default-layout [schema]
  (model-schema/schema-field-ids schema))

(defcomponent pixils/form-selection
  {:update (fn [state ctx]
             (assoc state
                    :options (selection-options (:items state)
                                                (:item-label state))
                    :selected-indices
                    (selected-indices (:selected-index state))))
   :on {:list-box/change (fn [state event ctx]
                           (let [stopped (ui/stop-propagation! event)]
                             (assoc state
                                    :new? false
                                    :selected-index
                                    (-> event :payload :value))))
        :list-box/activate (fn [state event ctx]
                             (do
                               (ui/stop-propagation! event)
                               (when (:activate-event state)
                                 (ui/emit! (:view ctx)
                                           (:activate-event state)
                                           (:payload event)))
                               state))
        :list-box/reorder (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (ui/emit! (:view ctx)
                                        :form/reorder
                                        (:payload event))
                              state))}})

(defcomponent pixils/form-action
  {:update (fn [state ctx]
             (assoc state
                    :disabled?
                    (action-disabled? state)))
   :on-click (fn [state event ctx]
               (let [emitted (when (not (:disabled? state))
                               (ui/emit! (:view ctx)
                                         (:event state)
                                         (:payload state)))]
                 state))
   :children [{:mode 'ui/button
               :style {:width :fill
                       :height :fill}
               :state {:label (ui/bind-state :label)
                       :disabled? (ui/bind-state :disabled?)}}]})

(defcomponent pixils/form
  {:update (fn [state ctx]
             (let [state (projection-state state)
                   validation (model-schema/validate-with-context
                               (:schema state)
                               (:value state)
                               (:context state))]
               (assoc state
                      :valid? (:valid? validation)
                      :errors (:errors validation))))
   :on {:form/new (fn [state event ctx]
                    (let [stopped (ui/stop-propagation! event)]
                      (begin-new-state state)))
        :form/save-new (fn [state event ctx]
                         (let [stopped (ui/stop-propagation! event)]
                           (save-new-state state)))
        :form/cancel-new (fn [state event ctx]
                           (let [stopped (ui/stop-propagation! event)]
                             (cancel-new-state state)))
        :form/delete (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (delete-state state)))
        :form/move-up (fn [state event ctx]
                        (let [stopped (ui/stop-propagation! event)]
                          (move-up-state state)))
        :form/move-down (fn [state event ctx]
                          (let [stopped (ui/stop-propagation! event)]
                            (move-down-state state)))}})

(defun selection-control-view [selection]
  (when selection
    (merge {:mode 'pixils/form-selection
            :state {:items (ui/bind-state :items)
                    :selected-index (ui/bind-state :selected-index)
                    :new? (ui/bind-state :new?)
                    :item-label (:item-label selection)
                    :reorderable? (:reorderable? selection)
                    :activate-event (:activate-event selection)}
            :children [(list-box/make
                        {:options (ui/bind-state :options)
                         :selected-indices
                         (ui/bind-state :selected-indices)
                         :force-selection? false
                         :visible-rows (:visible-rows selection)
                         :fixed-visible-rows? (:fixed-visible-rows? selection)
                         :reorderable? (ui/bind-state :reorderable?)
                         :style (or (:list-style selection)
                                    default-selection-list-style)})]}
           (style-map (defaultable-style (:style selection)
                                         (:class selection)
                                         default-selection-style))
           (class-map (:class selection)))))

(defun action-view [action]
  (merge {:mode 'pixils/form-action
          :state {:form-state (ui/bind-state)
                  :label (:label action)
                  :event (or (:event action)
                             (:action action)
                             (:id action))
                  :payload (:payload action)
                  :enabled-when (:enabled-when action)
                  :disabled-when (:disabled-when action)}}
         (style-map (defaultable-style (:style action)
                                       (:class action)
                                       default-action-style))
         (class-map (:class action))))

(defun fields-view [children]
  {:style default-fields-style
   :state form-state-binding
   :children children})

(defun root-array-schema? [schema]
  (= (:type (model-schema/resolved-root-schema schema)) :array))

(defun root-array-view [schema opts]
  (array-control-view (model-schema/resolved-root-schema schema)
                      opts
                      (ui/bind-state :value)))

(defun form-children [layout schema opts selection]
  (if (root-array-schema? schema)
    [(root-array-view schema opts)]
    (let [children (map (or layout (default-layout schema))
                        (fn [item]
                          (layout-item-view item opts)))]
      (cond
        (nil? selection)
        children

        (= (:placement selection) :right)
        [(fields-view children) (selection-control-view selection)]

        :default
        (concat [(selection-control-view selection)] children)))))

(defun layout-item-projection [item]
  (let [item (normalize-layout-item item)]
    (cond
      (nil? item) nil
      (= (type-of item) "map")
      (or (:projection item)
          (layout-projection (:children item))
          (layout-projection (:layout item)))
      (= (type-of item) "vector") (layout-projection item)
      :default nil)))

(defun layout-projection [layout]
  (reduce (or layout [])
          nil
          (fn [projection item]
            (or projection
                (layout-item-projection item)))))

(defun make [{:keys [schema text layout controls value style class
                     field-style field-label-style row-style separator-style
                     control-style valid? errors selection models projection]
              :as opts}]
  (let [projection (projection-entry models
                                     (or projection
                                         (layout-projection layout)))
        state-selection (normalized-selection models selection projection)
        render-selection (when selection state-selection)
        opts (assoc opts :projection projection)
        state (normalized-form-state opts state-selection)
        schema (:schema state)
        opts (assoc opts :schema schema)]
    (merge {:mode 'pixils/form
            :state state
            :children (form-children layout schema opts render-selection)}
           (style-map (defaultable-style style class default-style))
           (class-map class))))
