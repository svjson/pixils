(ns pixils.form
  (:require pixils
            [pixils.form.actions :as form-actions]
            pixils.form.controls.slider
            [pixils.form.layout :as form-layout]
            [pixils.form.selection :as form-selection]
            [pixils.schema :as model-schema]
            [pixils.ui :as ui]
            [pixils.ui.checkbox :as checkbox]
            [pixils.ui.combo-box :as combo-box]
            [pixils.ui.dialog :as dialog]
            [pixils.ui.list-box :as list-box]
            [pixils.ui.number-input :as number-input]))

(def default-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-field-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 3}})

(def default-field-label-style
  {:width :fill})

(def default-nested-field-label-width 64)

(def default-row-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 10}})

(def default-separator-style
  {:width :fill
   :height 1
   :background {:r 0x9a :g 0x9a :b 0x92}})

(def default-control-style
  {:width :fill
   :height 24})

(def default-slider-control-style
  {:width :fill
   :height 22
   :layout {:direction :row
            :gap 8
            :align-items :center}})

(def default-keyword-control-style
  {:width :fill
   :height 24
   :layout {:direction :row
            :align-items :center
            :gap 4}})

(def checkbox-style
  {:width :fill
   :height 24})

(def default-display-style
  {:width :fill
   :height 18})

(def default-slider-style
  {:width 220
   :height 18})

(def default-slider-value-style
  {:width :fill
   :height 18})

(def default-selection-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 4}})

(def default-selection-list-style
  {:width :fill})

(def default-fields-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-object-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-object-control-style
  {:width :fill
   :height :shrink})

(def default-array-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-array-content-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 8}})

(def default-array-list-style
  {:width 220
   :height 100})

(def default-array-list-box-style
  {:width :fill
   :height :fill})

(def default-array-summary-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 4}})

(def default-array-toolbar-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :center
            :gap 6}})

(def default-array-summary-row-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 6}})

(def default-array-summary-label-style
  {:width 90})

(def default-array-summary-value-style
  {:width :fill})

(def default-array-dialog-style
  {:width 440
   :height :shrink})

(def default-array-dialog-body-style
  {:width :fill
   :height :shrink
   :padding 12
   :layout {:direction :column
            :gap 10}})

(def default-array-dialog-button-row-style
  {:width :fill
   :height 24
   :layout {:direction :row
            :gap :space-between}})

(def separator-token :------)

(def form-state-binding
  {:value (ui/project-state :value)})

(def form-body-id "form-body")
(def form-object-body-id "form-object-body")

(def form-layout-state-binding
  {:value (ui/project-state :value)
   :new? (ui/project-state :new?)
   :valid? (ui/project-state :valid?)
   :selection-options (ui/project-state :selection-options)
   :selected-indices (ui/project-state :selected-indices)
   :form/action-disabled (ui/project-state :form/action-disabled)})

(defun child-models [entry]
  (or (:models entry)
      (:children entry)))

(defun model-entry-at [models path index]
  (let [entry (get (or models {}) (nth path index))]
    (if (or (nil? entry)
            (= index (dec (count path))))
      entry
      (model-entry-at (child-models entry) path (inc index)))))

(defun model-entry [models model-id]
  (cond
    (nil? model-id) nil
    (= (type-of model-id) "vector") (model-entry-at models model-id 0)
    :default (get (or models {}) model-id)))

(defun model-value [models model-id]
  (:value (or (model-entry models model-id) {})))

(defun model-schema [models model-id]
  (:schema (or (model-entry models model-id) {})))

(defun model-ref? [models value]
  (or (= (type-of value) "vector")
      (and (keyword? value)
           (contains? (or models {}) value))))

(defun model-ref-value [models value]
  (if (model-ref? models value)
    (model-value models value)
    value))

(defun primary-model-id [opts projection]
  (or (:model opts)
      (:target projection)))

(defun projection-entry-at [models path index]
  (let [entry (get (or models {}) (nth path index))]
    (cond
      (nil? entry)
      nil

      (= index (- (count path) 2))
      (get (or (:projections entry) {}) (nth path (dec (count path))))

      :default
      (projection-entry-at (child-models entry) path (inc index)))))

(defun projection-entry [models projection]
  (cond
    (nil? projection) nil
    (= (type-of projection) "map") projection
    (= (type-of projection) "vector") (projection-entry-at models projection 0)
    :default projection))

(defun selection-value [models selection projection key]
  (model-ref-value models (or (get selection key)
                              (get projection key))))

(defun normalized-selection [models selection projection]
  (when (or selection projection)
    (assoc (or selection {})
           :items (selection-value models selection projection :items)
           :selected-index
           (selection-value models selection projection :selected-index)
           :new? (selection-value models selection projection :new?)
           :new-value
           (selection-value models selection projection :new-value)
           :new-value-fn
           (or (:new-value-fn selection)
               (:new-value-fn projection)))))

(defun normalized-form-state [{:keys [schema value valid? errors models context
                                      mode
                                      projection]
                               :as opts}
                              selection]
  (let [model-id (primary-model-id opts projection)]
    {:value (or value (model-value models model-id))
     :schema (or schema (model-schema models model-id))
     :context context
     :form/mode (or mode :transient)
     :valid? valid?
     :errors errors
     :items (:items selection)
     :selected-index (:selected-index selection)
     :new? (:new? selection)
     :new-value (:new-value selection)
     :new-template (:new-value selection)
     :new-value-fn (:new-value-fn selection)}))

(defun field-path [field-id field-schema]
  (model-schema/field-path field-id field-schema))

(defun field-value [value field-id field-schema]
  (model-schema/field-value value field-id field-schema))

(defun validate-field [schema value field-id]
  (model-schema/validate-field schema value field-id))

(defun validation-errors [schema value]
  (model-schema/validation-errors schema value))

(defun validate [schema value]
  (model-schema/validate schema value))

(defun validate-with-context [schema value context]
  (model-schema/validate-with-context schema value context))

(defun validated-state [state]
  (let [validation (model-schema/validate-with-context (:schema state)
                                                       (:value state)
                                                       (:context state))]
    (assoc state
           :valid? (:valid? validation)
           :errors (:errors validation))))

(defun selected-item [items index]
  (let [items (or items [])]
    (when (and (not (nil? index))
               (>= index 0)
               (< index (count items)))
      (nth items index))))

(defun default-item-label [item index]
  (or (:label item)
      (:name item)
      (:id item)
      (str "Item " (inc index))))

(defun path-value [item path]
  (cond
    (nil? path) item
    (= (type-of path) "vector") (get-in item path)
    :default (get item path)))

(defun value-text [value empty-text]
  (if (or (nil? value)
          (and (= (type-of value) "string")
               (= (count value) 0)))
    (or empty-text "")
    (str value)))

(defun configured-item-label [item index item-label]
  (cond
    (nil? item-label)
    (default-item-label item index)

    (= (type-of item-label) "vector")
    (value-text (path-value item item-label)
                (default-item-label item index))

    (= (type-of item-label) "map")
    (value-text (path-value item (:path item-label))
                (or (:empty item-label)
                    (default-item-label item index)))

    :default
    (item-label item index)))

(defun selection-option [item index item-label]
  {:value index
   :label (configured-item-label item index item-label)})

(defun selection-options [items item-label]
  (for-indexed [index item (or items [])]
    (selection-option item index item-label)))

(defun selected-indices [index]
  (if (nil? index) [] [index]))

(defun selection-derived-state [state item-label]
  (let [options (selection-options (:items state) item-label)]
    (assoc state
           :options options
           :selection-options options
           :selected-indices (selected-indices (:selected-index state)))))

(defun update-selected-item [items index value]
  (let [items (or items [])]
    (if (and (not (nil? index))
             (>= index 0)
             (< index (count items)))
      (assoc items index value)
      items)))

(defun new-form-value [state]
  (let [new-value-fn (:new-value-fn state)]
    (cond
      new-value-fn
      (apply new-value-fn [(count (or (:items state) []))])

      (not (nil? (:new-template state)))
      (:new-template state)

      :default {})))

(defun begin-new-state [state]
  (let [value (new-form-value state)]
    (assoc state
           :new? true
           :new-value value
           :value value
           :previous-selected-index (:selected-index state)
           :selected-index nil
           :projected-new? true
           :projected-index nil
           :projected-item value)))

(defun save-new-state [state]
  (let [items (or (:items state) [])
        index (count items)
        value (or (:projected-item state)
                  (:value state))
        validated (validated-state (assoc state :value value))]
    (if (and (:new? state)
             (:valid? validated))
      (assoc state
             :items (concat items [value])
             :selected-index index
             :value value
             :new? false
             :new-value nil
             :previous-selected-index nil
             :projected-new? false
             :projected-index index
             :projected-item value)
      state)))

(defun remove-item-at-index [items index]
  (let [items (or items [])]
    (if (empty? items)
      []
      (reduce (range 0 (dec (count items)))
              []
              (fn [result item-index]
                (if (= item-index index)
                  result
                  (concat result [(nth items item-index)])))))))

(defun delete-state [state]
  (let [items (or (:items state) [])
        selected-index (:selected-index state)]
    (if (and (not (nil? selected-index))
             (>= selected-index 0)
             (< selected-index (count items)))
      (let [next-items (remove-item-at-index items selected-index)
            next-index (cond
                         (empty? next-items) nil
                         (< selected-index (count next-items)) selected-index
                         :default (dec (count next-items)))]
        (assoc state
               :items next-items
               :selected-index next-index
               :new? false
               :new-value nil
               :previous-selected-index nil
               :projected-new? false
               :projected-index nil
               :projected-item nil))
      state)))

(defun swap-item-indexes [items left-index right-index]
  (assoc (assoc items
                left-index
                (nth items right-index))
         right-index
         (nth items left-index)))

(defun move-selected-state [state offset]
  (let [items (or (:items state) [])
        selected-index (:selected-index state)
        next-index (when (not (nil? selected-index))
                     (+ selected-index offset))]
    (if (and (not (:new? state))
             (not (nil? selected-index))
             (>= selected-index 0)
             (< selected-index (count items))
             (>= next-index 0)
             (< next-index (count items)))
      (assoc state
             :items (swap-item-indexes items selected-index next-index)
             :selected-index next-index
             :projected-index nil
             :projected-item nil)
      state)))

(defun move-up-state [state]
  (move-selected-state state -1))

(defun move-down-state [state]
  (move-selected-state state 1))

(defun insert-item-at-index [items index item]
  (let [items (or items [])
        item-count (count items)
        index (max 0 (min item-count index))]
    (if (= index item-count)
      (concat items [item])
      (reduce (range 0 (dec item-count))
              []
              (fn [result item-index]
                (let [result (if (= item-index index)
                               (concat result [item])
                               result)]
                  (concat result [(nth items item-index)])))))))

(defun move-item-state [state from-index to-index]
  (let [items (or (:items state) [])
        item-count (count items)]
    (if (and (>= from-index 0)
             (< from-index item-count)
             (>= to-index 0)
             (< to-index item-count)
             (not= from-index to-index))
      (let [item (nth items from-index)
            next-items (insert-item-at-index
                        (remove-item-at-index items from-index)
                        to-index
                        item)]
        (assoc state
               :items next-items
               :selected-index to-index
               :projected-index nil
               :projected-item nil))
      state)))

(defun cancel-new-state [state]
  (assoc state
         :selected-index (:previous-selected-index state)
         :new? false
         :new-value nil
         :previous-selected-index nil
         :projected-new? false
         :projected-index nil
         :projected-item nil))

(defun projection-state [state]
  (let [new? (:new? state)
        items (:items state)
        selected-index (:selected-index state)
        selected (selected-item items selected-index)
        value (:value state)]
    (cond
      (nil? items)
      state

      new?
      (if (:projected-new? state)
        (assoc state :projected-item value)
        (assoc state
               :value (:new-value state)
               :projected-new? true
               :projected-index nil
               :projected-item (:new-value state)))

      (or (not= selected-index (:projected-index state))
          (not= selected (:projected-item state)))
      (assoc state
             :value selected
             :projected-new? false
             :projected-index selected-index
             :projected-item selected)

      (not= value selected)
      (assoc state
             :items (update-selected-item items selected-index value)
             :projected-item value)

      :default state)))

(defun field-binding [field-id field-schema]
  (apply ui/project-state (concat [:value] (field-path field-id field-schema))))

(defun form-value-with-field-value [state value]
  (if (:field-path state)
    (assoc-in (or (:form-value state) {})
              (:field-path state)
              value)
    value))

(defun field-change-payload [state value]
  (let [old-value-path (or (:local-field-path state)
                           (:field-path state))]
    {:field-id (:field-id state)
     :field-path (:field-path state)
     :local-field-path (:local-field-path state)
     :field-schema (:field-schema state)
     :old-value (if old-value-path
                  (get-in (or (:form-value state) {})
                          old-value-path)
                  (:form-value state))
     :value value
     :form-value (form-value-with-field-value state value)}))

(defun emit-field-change! [state event ctx value commit?]
  (ui/stop-propagation! event)
  (ui/emit! (:view ctx)
            :form/edit
            (assoc (field-change-payload state value)
                   :commit? commit?))
  state)

(defun label-for [field-id text]
  (or (get (or text {}) field-id)
      (str field-id)))

(defun field-value-text [field-id field-schema opts]
  {:mode 'ui/text
   :class [:pixils/form-control :pixils/form-display-control]
   :style (or (form-layout/style-option opts :display-style default-display-style)
              {})
   :state {:value (field-binding field-id field-schema)}})

(defun form-field-visible? [state]
  (model-schema/field-visible? (:schema state)
                               (:field-id state)
                               (:value state)))

(defun form-field-style [base-style visible?]
  (assoc (or base-style {})
         :visibility (if visible?
                       :visible
                       :none)))

(defun sync-form-field-style! [state ctx]
  (ui/style! (:view ctx)
             (form-field-style (:base-style state)
                               (:visible? state))))

(defun form-field-visibility-key [state]
  (if (:dynamic-visibility? state)
    {:field-id (:field-id state)
     :visibility-value
     (model-schema/field-visibility-value (:schema state)
                                          (:value state))}
    {:field-id (:field-id state)}))

(defun cached-form-field-state [state]
  (let [state (assoc state :form-value (:value state))
        key (form-field-visibility-key state)]
    (if (= key (:visibility-key state))
      state
      (assoc state
             :visibility-key key
             :visible? (form-field-visible? state)))))

(defun sync-form-field-style-state! [state ctx]
  (let [style-key {:base-style (:base-style state)
                   :visible? (:visible? state)}]
    (if (= style-key (:style-key state))
      state
      (let [synced (sync-form-field-style! state ctx)]
        (assoc state :style-key style-key)))))

(defcomponent pixils/form-field
  {:init (fn [state ctx]
           (sync-form-field-style-state!
            (cached-form-field-state state)
            ctx))
   :on {:text-input/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              false))
        :text-input/blur
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              true))
        :number-input/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              true))
        :number-input/text-change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              false))
        :form/control-change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :value)
                              (not= false
                                    (-> event :payload :commit?))))
        :checkbox/change
        (fn [state event ctx]
          (emit-field-change! state
                              event
                              ctx
                              (-> event :payload :checked?)
                              true))}})

(defun text-control [field-id field-schema field-label opts]
  {:mode 'ui/text-input
   :class [:pixils/form-control :pixils/form-text-control]
   :style (or (form-layout/style-option opts :control-style default-control-style)
              {})
   :state {:value (field-value (:value opts)
                               field-id
                               field-schema)
           :auto-focus? (:auto-focus? field-schema)
           :emit-blur? true
           :read-only? (:read-only? field-schema)}})

(defcomponent pixils/form-keyword-input
  {:children [{:mode 'ui/text
               :class :ui/muted
               :style {:width :shrink}
               :state {:value ":"}}
              {:mode 'ui/text-input
               :style {:width :fill
                       :height :fill}
               :state {:value (ui/bind-state :value)
                       :auto-focus? (ui/bind-state :auto-focus?)
                       :emit-blur? (ui/bind-state :emit-blur?)
                       :read-only? (ui/bind-state :read-only?)}}]})

(defun keyword-control [field-id field-schema field-label opts]
  (let [value (field-value (:value opts)
                           field-id
                           field-schema)
        style (if (contains? opts :control-style)
                (merge default-keyword-control-style
                       (:control-style opts))
                (form-layout/style-option opts
                                          :control-style
                                          default-keyword-control-style))]
    {:mode 'pixils/form-keyword-input
     :class [:pixils/form-control :pixils/form-keyword-control]
     :style (or style {})
     :state {:value (cond
                      (nil? value) ""
                      (keyword? value) (form-layout/keyword-label value)
                      :default value)
             :auto-focus? (:auto-focus? field-schema)
             :emit-blur? true
             :read-only? (:read-only? field-schema)}}))

(defun number-control [field-id field-schema field-label opts]
  (assoc (number-input/make
          {:style (or (form-layout/style-option opts :control-style default-control-style)
                      {})
           :value (field-binding field-id field-schema)
           :min (:min field-schema)
           :max (:max field-schema)
           :step (:step field-schema)
           :allow-negative? (:allow-negative? field-schema)
           :allow-fractions? (if (contains? field-schema
                                             :allow-fractions?)
                               (:allow-fractions? field-schema)
                               (= (:type field-schema) :number))
           :disabled? (:read-only? field-schema)
           :auto-focus? (:auto-focus? field-schema)
           :commit-on (if (contains? field-schema :commit-on)
                        (:commit-on field-schema)
                        :blur)})
         :class
         [:pixils/form-control :pixils/form-number-control]))

(defun slider-control [field-id field-schema field-label opts]
  {:mode 'pixils/form-slider-control
   :class [:pixils/form-control :pixils/form-slider-control]
   :style (or (:slider-control-style opts)
              (:control-style opts)
              default-slider-control-style)
   :state {:value (field-binding field-id field-schema)
           :min (:min field-schema)
           :max (:max field-schema)
           :step (:step field-schema)
           :axis (or (:axis field-schema) :x)
           :read-only? (:read-only? field-schema)
           :slider-style (or (:slider-style opts)
                             default-slider-style)
           :value-style (or (:slider-value-style opts)
                            default-slider-value-style)}})

(defun boolean-control [field-id field-schema field-label opts]
  (assoc (checkbox/make
          {:style (or (form-layout/style-option opts :checkbox-style checkbox-style)
                      {})
           :label ""
           :checked? (field-binding field-id field-schema)
           :value field-id})
         :class
         [:pixils/form-control :pixils/form-checkbox-control]))

(defun display-control [field-id field-schema field-label opts]
  (field-value-text field-id field-schema opts))

(defun object-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts) field-schema))

(defun event-field-path [opts field-id field-schema]
  (concat (or (:field-path-prefix opts) [])
          (field-path field-id field-schema)))

(defun path-prefix-matches-at? [path prefix index]
  (cond
    (>= index (count prefix)) true
    (>= index (count path)) false
    (= (nth path index) (nth prefix index))
    (path-prefix-matches-at? path prefix (inc index))
    :default false))

(defun path-prefix-matches? [path prefix]
  (path-prefix-matches-at? (or path []) (or prefix []) 0))

(defun path-tail [path index]
  (if (>= index (count path))
    []
    (concat [(nth path index)]
            (path-tail path (inc index)))))

(defun path-without-prefix [path prefix]
  (if (path-prefix-matches? path prefix)
    (path-tail (or path []) (count (or prefix [])))
    path))

(defun direct-valid-value-options-cache-for-schema [cache schema context value]
  (reduce (model-schema/active-schema-field-ids schema value)
          cache
          (fn [field-cache field-id]
            (let [field-schema (model-schema/resolved-field-schema schema
                                                                    field-id)]
              (cache-field-valid-value-options field-cache
                                               context
                                               field-schema
                                               value)))))

(defun branch-render-key [schema value context]
  (let [schema (model-schema/prepare-schema schema)]
    {:fields (model-schema/active-schema-field-ids schema value)
     :valid-value-options-cache
     (direct-valid-value-options-cache-for-schema {} schema context value)}))

(defun nested-field-label-style [opts]
  (let [style (:field-label-style opts)
        configured (:nested-field-label-style opts)
        width (:width style)]
    (or configured
        (if (number? width)
          (assoc style :width (min width default-nested-field-label-width))
          style))))

(defun object-control-render-opts [state value]
  (with-valid-value-options-cache
   (assoc (form-layout/section-child-opts (:render-opts state))
          :schema (:schema state)
          :value value
          :context (:context state)
          :field-path-prefix (:field-path-prefix state)
          :field-label-style
          (nested-field-label-style (:render-opts state)))))

(defun object-control-body-view [state value]
  (let [opts (object-control-render-opts state value)
        layout (or (:layout state)
                   (default-layout (:schema state) opts))]
    {:id form-object-body-id
     :class :pixils/form-object-body
     :style (or (:object-style state) {})
     :state form-state-binding
     :children (layout-item-views layout opts)}))

(defun replace-object-control-body! [state ctx]
  (ui/replace-child! (:view ctx)
                     form-object-body-id
                     (object-control-body-view state (:value state)))
  state)

(defun object-control-next-value [state payload]
  (let [path (path-without-prefix (:field-path payload)
                                  (:field-path-prefix state))]
    (if path
      (assoc-in (or (:value state) {})
                path
                (:value payload))
      (:form-value payload))))

(defcomponent pixils/form-object-control
  {:on {:form/edit
        (fn [state event ctx]
          (let [next-value (object-control-next-value state (:payload event))
                next-state (assoc state :value next-value)]
            (when (not= (branch-render-key (:schema state)
                                           (:value state)
                                           (:context state))
                        (branch-render-key (:schema next-state)
                                           (:value next-state)
                                           (:context next-state)))
              (replace-object-control-body! next-state ctx))
            next-state))}})

(defun object-control [field-id field-schema field-label opts]
  (let [schema (object-schema field-schema opts)
        object-opts (assoc opts
                           :schema schema
                           :value (field-value (:value opts)
                                               field-id
                                               field-schema)
                           :field-path-prefix
                           (event-field-path opts field-id field-schema))
        state {:value (field-binding field-id field-schema)
               :schema schema
               :context (:context opts)
               :field-path-prefix (:field-path-prefix object-opts)
               :layout (:layout field-schema)
               :render-opts object-opts
               :object-style (form-layout/style-option opts
                                                       :object-style
                                                       default-object-style)}]
    {:mode 'pixils/form-object-control
     :class [:pixils/form-control :pixils/form-object-control]
     :style (or (form-layout/style-option opts
                                          :object-control-style
                                          default-object-control-style)
                {})
     :state state
     :children [(object-control-body-view state (:value object-opts))]}))

(defun array-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts) field-schema))

(defun array-item-schema [field-schema opts]
  (model-schema/schema-document-with-root (:schema opts)
                                         (:items field-schema)))

(defun selected-array-index? [state]
  (let [items (or (:items state) [])
        index (:selected-index state)]
    (and (not (nil? index))
         (>= index 0)
         (< index (count items)))))

(defun selected-array-index-above-first? [state]
  (and (selected-array-index? state)
       (> (:selected-index state) 0)))

(defun selected-array-index-below-last? [state]
  (let [items (or (:items state) [])]
    (and (selected-array-index? state)
         (< (:selected-index state) (dec (count items))))))

(defun ensure-array-selection-state [state]
  (if (and (not (:new? state))
           (nil? (:selected-index state))
           (not (empty? (or (:items state) []))))
    (assoc state :selected-index 0)
    state))

(defun array-editor-option [editor key default-value]
  (if (contains? (or editor {}) key)
    (get editor key)
    default-value))

(defun array-editor-mode [editor]
  (or (:edit-mode editor) :dialog))

(defun array-editor-dialog? [editor]
  (= (array-editor-mode editor) :dialog))

(defun array-actions-state [state]
  (let [editor (:array-editor state)
        read-only? (:read-only? state)
        can-select? (selected-array-index? state)
        dialog? (array-editor-dialog? editor)
        allow-add? (array-editor-option editor :allow-add? true)
        allow-edit? (array-editor-option editor :allow-edit? true)
        allow-delete? (array-editor-option editor :allow-delete? true)
        allow-reorder? (array-editor-option editor :allow-reorder? true)]
    (assoc state
           :can-add? (and (not read-only?)
                          dialog?
                          allow-add?)
           :can-edit? (and (not read-only?)
                           dialog?
                           allow-edit?
                           can-select?)
           :can-delete? (and (not read-only?)
                             allow-delete?
                             can-select?)
           :reorderable? (and (not read-only?)
                              allow-reorder?))))

(def array-toolbar-actions
  [{:id :form/add-item
    :label "Add"
    :enabled-when :can-add?}
   {:id :form/edit-item
    :label "Edit"
    :enabled-when :can-edit?}
   {:id :form/delete
    :label "Delete"
    :enabled-when :can-delete?}])

(defun summary-spec-path [item-schema field-id]
  (model-schema/field-path field-id
                           (model-schema/resolved-field-schema item-schema
                                                               field-id)))

(defun summary-field-spec [item-schema field-id]
  {:label (str field-id)
   :path (summary-spec-path item-schema field-id)})

(defun inferred-summary-specs [item-schema]
  (let [root (model-schema/resolved-root-schema item-schema)]
    (if (= (:type root) :object)
      (map (model-schema/schema-field-ids item-schema)
           (fn [field-id]
             (summary-field-spec item-schema field-id)))
      [{:label "Value"}])))

(defun array-summary-specs [field-schema item-schema]
  (or (:item-summary field-schema)
      (inferred-summary-specs item-schema)))

(defun summary-entry-value [item spec]
  (value-text (path-value item (:path spec))
              (or (:empty spec) "")))

(defun summary-entry [item spec selected?]
  (if selected?
    {:label (:label spec)
     :value (summary-entry-value item spec)}
    {:label ""
     :value ""}))

(defun empty-summary-values [specs]
  (let [entry-count (max 1 (count specs))]
    (concat [{:label ""
              :value "No item selected"}]
            (map (range 1 (dec entry-count))
                 (fn [index]
                   {:label ""
                    :value ""})))))

(defun selected-summary-values [item specs]
  (let [selected? (not (nil? item))
        specs (or specs [])]
    (if selected?
      (map specs (fn [spec] (summary-entry item spec true)))
      (empty-summary-values specs))))

(defun array-derived-state [state]
  (-> state
      (selection-derived-state (:item-label state))
      (assoc :summary
             (selected-summary-values (:value state)
                                      (:summary-specs state)))
      (form-actions/derived-state array-toolbar-actions)))

(defun summary-row-view [opts index]
  {:class :pixils/form-array-summary-row
   :style (or (form-layout/style-option opts
                                         :array-summary-row-style
                                         default-array-summary-row-style)
              {})
   :children [{:mode 'ui/text
               :class [:ui/muted :pixils/form-array-summary-label]
               :style (or (form-layout/style-option
                            opts
                            :array-summary-label-style
                            default-array-summary-label-style)
                          {})
               :state {:value (ui/bind-state :summary index :label)}}
              {:mode 'ui/text
               :class :pixils/form-array-summary-value
               :style (or (form-layout/style-option
                            opts
                            :array-summary-value-style
                            default-array-summary-value-style)
                          {})
               :state {:value (ui/bind-state :summary index :value)}}]})

(defcomponent pixils/form-array-summary
  {:init (fn [state ctx]
           (if (:summary state)
             state
             (assoc state
                    :summary
                    (selected-summary-values (:item state)
                                             (:specs state)))))})

(defun array-summary-view [opts summary-specs]
  {:mode 'pixils/form-array-summary
   :class :pixils/form-array-summary
   :style (or (form-layout/style-option opts
                                         :array-summary-style
                                         default-array-summary-style)
              {})
   :state {:item (ui/project-state :value)
           :summary (ui/project-state :summary)
           :specs summary-specs}
   :children (map (range 0 (dec (max 1 (count summary-specs))))
                  (fn [index] (summary-row-view opts index)))})

(defun array-control-state [state]
  (let [state (ensure-array-selection-state state)
        state (projection-state state)
        state (validated-state state)]
    (array-derived-state (array-actions-state state))))

(defun array-toolbar [opts]
  {:class :pixils/form-array-toolbar
   :style (or (form-layout/style-option opts
                                         :array-toolbar-style
                                         default-array-toolbar-style)
              {})
   :state {:form/action-disabled (ui/project-state :form/action-disabled)}
   :children (map array-toolbar-actions
                  (fn [action]
                    (form-actions/action-view action opts)))})

(defun array-item-form-view [item-schema opts]
  (let [item-opts (with-valid-value-options-cache
                    (assoc (form-layout/section-child-opts opts)
                           :schema item-schema
                           :value (:value opts)))
        children (layout-item-views
                  (or (:layout item-opts)
                      (default-layout item-schema item-opts))
                  item-opts)]
    {:mode 'pixils/form
     :class :pixils/form-array-item-form
     :style (or (form-layout/style-option opts :fields-style default-fields-style)
                {})
     :state {:value (ui/bind-state :value)
             :schema item-schema
             :context (:context opts)
             :valid? (ui/bind-state :valid?)
             :errors (ui/bind-state :errors)}
     :children children}))

(defun array-item-dialog-result [state event ctx]
  (let [choice (-> event :payload :choice)]
    (if (= choice :dialog/ok)
      {:type :confirm
       :index (:index state)
       :new? (:new? state)
       :value (:value state)}
      {:type :cancel})))

(defun array-item-dialog-button-handler [state event ctx]
  (do
    (ui/stop-propagation! event)
    (pop-mode! (array-item-dialog-result state event ctx))
    state))

(defun array-item-dialog-body [item-schema opts]
  (assoc
   (dialog/make-dialog-body
    {:body [(array-item-form-view item-schema
                                  opts)]
     :buttons [:dialog/ok :dialog/cancel]
     :state {:value (ui/bind-state :value)
             :index (ui/bind-state :index)
             :new? (ui/bind-state :new?)
             :valid? (ui/bind-state :valid?)
             :errors (ui/bind-state :errors)}
     :body-class :pixils/form-array-dialog-body
     :body-style (form-layout/style-option opts
                                           :array-dialog-body-style
                                           default-array-dialog-body-style)
     :button-row-class :pixils/form-array-dialog-buttons
     :button-row-style (form-layout/style-option opts
                                                 :array-dialog-button-row-style
                                                 default-array-dialog-button-row-style)})
   :on {:form/draft-change (fn [state event ctx]
                              (ui/stop-propagation! event)
                              (assoc state
                                     :value
                                     (-> event :payload :form-value)))
        :dialog/button array-item-dialog-button-handler}))

(defun open-array-item-dialog! [state ctx new?]
  (let [index (:selected-index state)
        value (if new?
                (new-form-value state)
                (:value state))
        item-opts (assoc (:item-opts state)
                         :context (:context state))]
    (dialog/open-dialog! ctx
                         {:title (if new? "Add Item" "Edit Item")
                          :class :pixils/form-array-dialog
                          :style (form-layout/style-option item-opts
                                                           :array-dialog-style
                                                           default-array-dialog-style)
                          :result-event :form/array-item-dialog-result
                          :state {:value value
                                  :index index
                                  :new? new?}
                          :body (array-item-dialog-body (:item-schema state)
                                                        (assoc item-opts
                                                               :value
                                                               value))})))

(defun form-action [state key]
  (head (filter (or (:form/actions state) [])
                (fn [action]
                  (= key (:key action))))))

(defun action-dialog-config [action]
  (let [dialog (:dialog action)]
    (cond
      (= true dialog) {}
      (= (type-of dialog) "map") dialog
      :default nil)))

(defun selection-add-dialog-config [state action]
  (let [dialog (action-dialog-config action)]
    (cond
      dialog dialog
      (contains? action :dialog) nil
      (or (form-action state :save)
          (form-action state :cancel)) nil
      (= :form/new (form-actions/action-event-id action)) {}
      :default nil)))

(defun open-selection-new-dialog! [state ctx dialog]
  (let [value (new-form-value state)
        opts (assoc (or (:form/render-opts state) {})
                    :schema (:schema state)
                    :value value
                    :context (:context state)
                    :layout (or (:layout dialog)
                                (form-layout/layout-form-layout
                                 (:form/layout state))))]
    (dialog/open-dialog! ctx
                         {:title (or (:title dialog) "Add Item")
                          :class :pixils/form-selection-dialog
                          :style (or (:style dialog)
                                     (form-layout/style-option
                                      opts
                                      :selection-dialog-style
                                      default-array-dialog-style))
                          :result-event :form/selection-dialog-result
                          :state {:value value
                                  :index (count (or (:items state) []))
                                  :new? true}
                          :body (array-item-dialog-body (:schema state)
                                                        opts)})))

(defun array-dialog-result-state [state payload]
  (if (= (:type payload) :confirm)
    (let [items (or (:items state) [])
          value (:value payload)
          index (:index payload)]
      (if (:new? payload)
        (assoc state
               :items (concat items [value])
               :selected-index (count items)
               :projected-index nil
               :projected-item nil)
        (assoc state
               :items (update-selected-item items index value)
               :selected-index index
               :projected-index nil
               :projected-item nil)))
    state))

(defun array-items-change-payload [state next-state]
  (when (not= (:items state) (:items next-state))
    (assoc (field-change-payload state (:items next-state))
           :commit? true)))

(defun emit-array-items-change! [state next-state ctx]
  (let [payload (array-items-change-payload state next-state)]
    (when payload
      (ui/emit! (:view ctx)
                :form/edit
                payload))
    next-state))

(defcomponent pixils/form-array-control
  {:init (fn [state ctx]
           (array-control-state state))
   :on {:form/select (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (array-control-state
                        (assoc state
                               :new? false
                               :selected-index
                               (-> event :payload :value))))
        :form/add-item (fn [state event ctx]
                         (ui/stop-propagation! event)
                         (when (:can-add? state)
                           (open-array-item-dialog! state ctx true))
                         state)
        :form/edit-item (fn [state event ctx]
                          (ui/stop-propagation! event)
                          (when (:can-edit? state)
                            (open-array-item-dialog! state ctx false))
                          state)
        :form/array-item-dialog-result (fn [state event ctx]
                                         (ui/stop-propagation! event)
                                         (let [next-state
                                               (array-dialog-result-state
                                                state
                                                (:payload event))]
                                           (emit-array-items-change!
                                            state
                                            (array-control-state next-state)
                                            ctx)))
        :form/delete (fn [state event ctx]
                       (ui/stop-propagation! event)
                       (let [next-state (array-control-state
                                         (delete-state state))]
                         (emit-array-items-change! state next-state ctx)))
        :form/reorder (fn [state event ctx]
                        (ui/stop-propagation! event)
                        (let [next-state
                              (array-control-state
                               (move-item-state state
                                                (-> event :payload :from-index)
                                                (-> event :payload :to-index)))]
                          (emit-array-items-change! state next-state ctx)))}})

(defun array-control-view [field-id field-schema opts items-binding]
  (let [item-schema (array-item-schema field-schema opts)
        summary-specs (array-summary-specs field-schema item-schema)]
    {:mode 'pixils/form-array-control
     :class [:pixils/form-control :pixils/form-array-control]
     :style (or (form-layout/style-option opts :array-style default-array-style)
                {})
     :state {:items items-binding
             :item-schema item-schema
             :field-id field-id
             :field-path (when field-id
                           (event-field-path opts field-id field-schema))
             :local-field-path (when field-id
                                 (field-path field-id field-schema))
             :field-schema field-schema
             :form-value (ui/bind-state :form-value)
             :context (:context opts)
             :item-opts {:context (:context opts)
                         :controls (:controls opts)
                         :text (:text opts)
                         :field-style (:field-style opts)
                         :field-label-style (:field-label-style opts)
                         :nested-field-label-style
                         (:nested-field-label-style opts)
                         :control-style (:control-style opts)
                         :object-style (:object-style opts)
                         :row-style (:row-style opts)
                         :separator-style (:separator-style opts)
                         :array-style (:array-style opts)
                         :array-content-style (:array-content-style opts)
                         :array-list-style (:array-list-style opts)
                         :array-list-box-style (:array-list-box-style opts)
                         :array-summary-style (:array-summary-style opts)
                         :array-summary-row-style
                         (:array-summary-row-style opts)
                         :array-summary-label-style
                         (:array-summary-label-style opts)
                         :array-summary-value-style
                         (:array-summary-value-style opts)
                         :array-toolbar-style (:array-toolbar-style opts)
                         :array-dialog-style (:array-dialog-style opts)
                         :array-dialog-body-style
                         (:array-dialog-body-style opts)
                         :array-dialog-button-row-style
                         (:array-dialog-button-row-style opts)
                         :theme-styles? (:theme-styles? opts)}
             :new-template (or (:new-template field-schema)
                               (:new-value field-schema)
                               {})
             :item-label (:item-label field-schema)
             :summary-specs summary-specs
             :array-editor (:array-editor field-schema)
             :read-only? (:read-only? field-schema)}
     :children [{:class :pixils/form-array-content
                 :style (or (form-layout/style-option
                              opts
                              :array-content-style
                              default-array-content-style)
                            {})
                 :state {:value (ui/project-state :value)
                         :selection-options
                         (ui/project-state :selection-options)
                         :selected-indices
                         (ui/project-state :selected-indices)
                         :summary (ui/project-state :summary)
                         :reorderable? (ui/project-state :reorderable?)}
                 :children [(selection-control-view
                             {:item-label (:item-label field-schema)
                              :class :pixils/form-array-list
                              :style (form-layout/style-option
                                      opts
                                      :array-list-style
                                      default-array-list-style)
                              :list-style (form-layout/style-option
                                           opts
                                           :array-list-box-style
                                           default-array-list-box-style)
                              :visible-rows 5
                              :fixed-visible-rows? true
                              :reorderable? (ui/bind-state :reorderable?)
                              :activate-event :form/edit-item}
                             opts)
                            (array-summary-view opts summary-specs)]}
                (array-toolbar opts)]}))

(defun array-control [field-id field-schema field-label opts]
  (array-control-view field-id
                      field-schema
                      opts
                      (field-binding field-id field-schema)))

(defun valid-values-cache-source-key [context parent-value source]
  (cond
    (= (type-of source) "vector")
    {:source-path source}

    (= (type-of source) "map")
    (let [source-key (model-schema/path-value parent-value
                                              (or (:field source)
                                                  (:path source)))
          source-path (get (or (:sources source) {}) source-key)]
      {:source-key source-key
       :source-path source-path})

    :default nil))

(defun valid-value-options-cache-key [context field-schema parent-value]
  (let [valid-values (:valid-values field-schema)]
    (when valid-values
      {:valid-values valid-values
       :source
       (if (and (= (type-of valid-values) "map")
                (contains? valid-values :from))
         (valid-values-cache-source-key context
                                        parent-value
                                        (:from valid-values))
         {:values valid-values})})))

(defun cache-field-valid-value-options [cache context field-schema parent-value]
  (let [key (valid-value-options-cache-key context field-schema parent-value)]
    (if key
      (if (contains? cache key)
        cache
        (assoc cache
               key
               (model-schema/valid-value-options-for-value context
                                                           field-schema
                                                           parent-value)))
      cache)))

(defun cache-schema-field-valid-value-options [cache schema context value field-id]
  (let [field-schema (model-schema/resolved-field-schema schema field-id)
        field-value (field-value value field-id field-schema)
        cache (cache-field-valid-value-options cache
                                               context
                                               field-schema
                                               value)]
    (cond
      (= (:type field-schema) :object)
      (valid-value-options-cache-for-schema
       cache
       (object-schema field-schema {:schema schema})
       context
       field-value)

      (= (:type field-schema) :union)
      (valid-value-options-cache-for-schema
       cache
       (object-schema field-schema {:schema schema})
       context
       field-value)

      (= (:type field-schema) :array)
      cache

      :default
      cache)))

(defun valid-value-options-cache-for-schema [cache schema context value]
  (let [root (model-schema/resolved-root-schema schema)]
    (cond
      (= (:type root) :array)
      cache

      :default
      (reduce (model-schema/active-schema-field-ids schema value)
              cache
              (fn [field-cache field-id]
                (cache-schema-field-valid-value-options field-cache
                                                        schema
                                                        context
                                                        value
                                                        field-id))))))

(defun valid-value-options-cache [schema value context]
  (valid-value-options-cache-for-schema
   {}
   (model-schema/prepare-schema schema)
   context
   value))

(defun with-valid-value-options-cache [opts]
  (let [schema (model-schema/prepare-schema (:schema opts))
        opts (assoc opts :schema schema)]
    (if (:valid-value-options-cache opts)
      opts
      (assoc opts
             :valid-value-options-cache
             (valid-value-options-cache-for-schema {}
                                                   schema
                                                   (:context opts)
                                                   (:value opts))))))

(defun select-option-index-from [options value index]
  (cond
    (>= index (count options))
    nil

    (= (:value (nth options index)) value)
    index

    :default
    (select-option-index-from options value (inc index))))

(defun select-option-index [options value]
  (select-option-index-from (or options []) value 0))

(defun select-control-options [state]
  (if (:field-schema state)
    (select-options-for-value (:field-schema state)
                              {:context (:context state)}
                              (:form-value state))
    (:options state)))

(defun select-source-key [state source]
  (cond
    (= (type-of source) "vector")
    {:source-path source}

    (= (type-of source) "map")
    (let [source-key (model-schema/path-value (:form-value state)
                                              (or (:field source)
                                                  (:path source)))
          source-path (get (or (:sources source) {}) source-key)]
      {:source-key source-key
       :source-path source-path})

    :default
    nil))

(defun select-options-key [state]
  (let [valid-values (-> state :field-schema :valid-values)]
    {:value (:value state)
     :valid-values valid-values
     :source
     (if (and (= (type-of valid-values) "map")
              (contains? valid-values :from))
       (select-source-key state (:from valid-values))
       {:valid-values valid-values})}))

(defun raw-select-options-for-value [field-schema opts value]
  (let [key (valid-value-options-cache-key (:context opts)
                                           field-schema
                                           value)
        cache (:valid-value-options-cache opts)]
    (if (and key (contains? (or cache {}) key))
      (get cache key)
      (model-schema/valid-value-options-for-value (:context opts)
                                                  field-schema
                                                  value))))

(defun select-options-for-value [field-schema opts value]
  (let [options (raw-select-options-for-value field-schema opts value)]
    (if (= true (:required field-schema))
      options
      (concat [{:value nil
                :label ""}]
              options))))

(defun select-options [field-schema opts]
  (select-options-for-value field-schema opts (:value opts)))

(defun select-control-state [state]
  (let [key (select-options-key state)]
    (if (= key (:select-options-key state))
      state
      (let [options (select-control-options state)]
        (assoc (assoc state
                      :select-options-key key
                      :options options)
               :selected-index
               (select-option-index options
                                    (:value state)))))))

(defcomponent pixils/form-select-control
  {:init (fn [state ctx]
           (select-control-state state))
   :on {:combo-box/change (fn [state event ctx]
                            (let [payload (:payload event)]
                              (ui/stop-propagation! event)
                              (ui/emit! (:view ctx)
                                        :form/edit
                                        (assoc
                                         (field-change-payload
                                          state
                                          (:value payload))
                                         :commit? true))
                              (-> state
                                  (assoc :value (:value payload))
                                  (assoc :form-value
                                         (form-value-with-field-value
                                          state
                                          (:value payload)))
                                  (assoc :selected-index
                                         (:selected-index payload)))))}
   :children [(combo-box/make {:options (ui/bind-state :options)
                               :selected-index
                               (ui/bind-state :selected-index)
                               :style {:width :fill
                                       :height :fill}
                               :row-height (ui/bind-state :row-height)
                               :max-height (ui/bind-state :max-height)
                               :disabled?
                               (ui/bind-state :disabled?)})]})

(defun select-control [field-id field-schema field-label opts]
  {:mode 'pixils/form-select-control
   :class [:pixils/form-control :pixils/form-select-control]
   :style (or (form-layout/style-option opts :control-style default-control-style)
              {})
   :state {:value (field-binding field-id field-schema)
           :form-value (ui/bind-state :form-value)
           :options (select-options field-schema opts)
           :field-id field-id
           :field-path (event-field-path opts field-id field-schema)
           :local-field-path (field-path field-id field-schema)
           :field-schema field-schema
           :context (:context opts)
           :valid-value-options-cache (:valid-value-options-cache opts)
           :row-height (:row-height field-schema)
           :max-height (:max-height field-schema)
           :disabled? (:read-only? field-schema)}})

(def default-controls
  {:text text-control
   :string text-control
   :select select-control
   :object object-control
   :union object-control
   :array array-control
   :keyword keyword-control
   :integer number-control
   :number number-control
   :slider slider-control
   :boolean boolean-control
   :display display-control})

(defun field-control-type [field-schema]
  (if (:valid-values field-schema)
    :select
    (:type field-schema)))

(defun field-control [field-id field-schema field-label opts]
  (let [controls (merge default-controls (or (:controls opts) {}))
        control (get controls (field-control-type field-schema))]
    (if control
      (apply control [field-id field-schema field-label opts])
      (display-control field-id field-schema field-label opts))))

(defun field-label-class [opts]
  (form-layout/classes
   (if (:field-path-prefix opts)
     [:ui/muted :pixils/form-label :pixils/form-nested-label]
     [:ui/muted :pixils/form-label])
   (:field-label-class opts)))

(defun field-view [field-id opts]
  (let [schema (or (:schema opts) {})
        text (:text opts)
        field-schema (model-schema/resolved-field-schema schema field-id)
        field-label (label-for field-id text)
        base-style (form-layout/style-option opts :field-style default-field-style)
        local-field-path (field-path field-id field-schema)
        initial-visible? (model-schema/field-visible? schema
                                                      field-id
                                                      (:value opts))]
    (if field-schema
      (when initial-visible?
        {:mode 'pixils/form-field
         :class :pixils/form-field
         :style (form-field-style base-style true)
         :state {:value (ui/project-state :value)
                 :form-value (ui/project-state :value)
                 :schema schema
                 :field-id field-id
                 :field-path (event-field-path opts field-id field-schema)
                 :local-field-path local-field-path
                 :field-schema field-schema
                 :base-style base-style
                 :dynamic-visibility?
                 (model-schema/dynamic-field-visibility? schema)
                 :visible? true}
         :children [{:mode 'ui/text
                     :class (field-label-class opts)
                     :style (or (form-layout/style-option
                                  opts
                                  :field-label-style
                                  default-field-label-style)
                                {})
                     :state {:value field-label}}
                    (field-control field-id field-schema field-label opts)]})
      {:mode 'ui/text
       :state {:value (str "Unknown form field " field-id)}})))

(defun separator-view [opts]
  {:class :pixils/form-separator
   :style (or (form-layout/style-option opts
                                         :separator-style
                                         default-separator-style)
              {})})

(defun row-view [items opts]
  {:class :pixils/form-row
   :style (or (form-layout/style-option opts :row-style default-row-style)
              {})
   :state form-state-binding
   :children (layout-item-views items opts)})

(defun model-layout-opts [opts item]
  (let [models (:models opts)
        model-id (or (:model item)
                     (:model opts))
        entry (model-entry models model-id)]
    (assoc opts
           :model model-id
           :schema (or (:schema item)
                       (:schema entry)
                       (:schema opts))
           :text (or (:text item)
                     (:text opts)))))

(defun form-layout-view [item opts]
  (let [opts (model-layout-opts opts item)
        schema (:schema opts)
        children (layout-item-views (or (:layout item)
                                        (default-layout schema opts))
                                    opts)]
    (merge {:state form-layout-state-binding
            :children children}
           (form-layout/style-map
           (form-layout/defaultable-style (:style item)
                                          (:class item)
                                          (form-layout/style-option
                                           opts
                                           :fields-style
                                           default-fields-style)))
           {:class (form-layout/classes :pixils/form-fields (:class item))})))

(defun selection-layout-view [item opts]
  (let [projection (projection-entry (:models opts)
                                     (:projection item))]
    (selection-control-view
     (if (or (:projection item)
             (contains? item :items)
             (contains? item :selected-index)
             (contains? item :new?)
             (contains? item :new-value)
             (contains? item :new-value-fn))
       (normalized-selection (:models opts) item projection)
       (merge (or (:form/selection opts) {}) item))
     opts)))

(defun row-layout-view [item opts]
  (merge {:state form-layout-state-binding
          :children (layout-item-views (:children item) opts)}
         (form-layout/style-map
          (or (:style item)
              (when (nil? (:class item))
                (form-layout/style-option opts :row-style default-row-style))))
         {:class (form-layout/classes
                  (if (= (:type item) :group)
                    [:pixils/form-row :pixils/form-group]
                    :pixils/form-row)
                  (:class item))}))

(defun section-layout-view [item opts]
  (form-layout/section-view
   item
   opts
   (layout-item-views (or (:layout item)
                          (:children item))
                      (form-layout/section-child-opts opts))
   form-layout-state-binding))

(defun map-layout-item-view [item opts]
  (cond
    (= (:type item) :form) (form-layout-view item opts)
    (= (:type item) :selection) (selection-layout-view item opts)
    (= (:type item) :action) (form-actions/action-view item opts)
    (= (:type item) :section) (section-layout-view item opts)
    (= (:type item) :group) (row-layout-view item opts)
    (= (:type item) :row) (row-layout-view item opts)
    :default {:mode 'ui/text
              :state {:value (str "Unknown form layout item " item)}}))

(defun layout-item-view [item opts]
  (let [item (form-layout/normalize-layout-item item)]
    (cond
      (= item separator-token) (separator-view opts)
      (= (type-of item) "vector") (row-view item opts)
      (= (type-of item) "map") (map-layout-item-view item opts)
      :default (field-view item opts))))

(defun layout-item-views [items opts]
  (filter (map (or items [])
               (fn [item]
                 (layout-item-view item opts)))
          (fn [child]
            (not (nil? child)))))

(defun default-layout [schema opts]
  (model-schema/active-schema-field-ids schema (:value opts)))

(defcomponent pixils/form-selection
  {:init (fn [state ctx]
           (if (:selection-options state)
             (assoc state :options (:selection-options state))
             (selection-derived-state state (:item-label state))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (ui/emit! (:view ctx)
                                       :form/select
                                       (:payload event))
                             (assoc state
                                    :new? false
                                    :selected-index
                                    (-> event :payload :value))))
        :list-box/activate (fn [state event ctx]
                             (do
                               (ui/stop-propagation! event)
                               (when (:activate-event state)
                                 (ui/emit! (:view ctx)
                                           (:activate-event state)
                                           (:payload event)))
                               state))
        :list-box/reorder (fn [state event ctx]
                            (do
                              (ui/stop-propagation! event)
                              (ui/emit! (:view ctx)
                                        :form/reorder
                                        (:payload event))
                              state))
        :form/activate-selection (fn [state event ctx]
                                   (do
                                     (ui/stop-propagation! event)
                                     (when (:activate-event state)
                                       (ui/emit! (:view ctx)
                                                 (:activate-event state)
                                                 {:index (:selected-index state)
                                                  :value (:selected-index state)}))
                                     state))}})

(defun form-state [state]
  (let [state (projection-state state)]
    (let [state (validated-state state)
          selection (:form/selection state)
          state (if selection
                  (selection-derived-state state (:item-label selection))
                  state)]
      (form-actions/derived-state state (:form/actions state)))))

(defun changed-form-state [state payload]
  (let [base-value (cond
                     (and (:new? state)
                          (not (nil? (:projected-item state))))
                     (:projected-item state)

                     (and (not (:new? state))
                          (not (nil? (:projected-index state))))
                     (:projected-item state)

                     :default
                     (:value state))
        next-value (if (:field-path payload)
                     (assoc-in (or base-value {})
                               (:field-path payload)
                               (:value payload))
                     (:form-value payload))
        state (cond
                (and (:new? state)
                     (not (nil? (:projected-item state))))
                (assoc state
                       :value next-value
                       :projected-item next-value)

                (and (not (:new? state))
                     (not (nil? (:projected-index state))))
                (assoc state
                       :items (update-selected-item (:items state)
                                                    (:projected-index state)
                                                    next-value)
                       :selected-index (:projected-index state)
                       :value next-value
                       :projected-item next-value)

                :default
                (assoc state :value next-value))]
    (form-state state)))

(defun form-state-change-payload [next-state]
  {:form-value (:value next-state)
   :value (:value next-state)
   :items (:items next-state)
   :selected-index (:selected-index next-state)
   :new? (:new? next-state)})

(defun emit-form-state-change! [state next-state ctx]
  (when (not= state next-state)
    (ui/emit! (:view ctx)
              :form/change
              (form-state-change-payload next-state)))
  next-state)

(defcomponent pixils/form
  {:init (fn [state ctx]
           (form-state state))
   :on {:form/edit (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (let [next-state
                               (changed-form-state state (:payload event))]
                           (when (form-body-replace-needed? state
                                                            next-state)
                             (replace-form-body! next-state ctx))
                           (when (not (:new? next-state))
                             (ui/emit! (:view ctx)
                                       :form/draft-change
                                       (form-state-change-payload
                                        next-state)))
                           (when (and (not (:new? next-state))
                                      (= :live (:form/mode state))
                                      (= true (-> event :payload :commit?)))
                             (ui/emit! (:view ctx)
                                       :form/change
                                       (form-state-change-payload
                                        next-state)))
                           next-state)))
        :form/select (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (let [next-state
                               (form-state
                                (assoc state
                                       :new? false
                                       :selected-index
                                       (-> event :payload :value)))]
                           (replace-form-body! next-state ctx)
                           (ui/emit! (:view ctx)
                                     :form/select
                                     (:payload event))
                           next-state)))
        :form/new (fn [state event ctx]
                    (let [stopped (ui/stop-propagation! event)]
                      (let [add-action (form-action state :add)
                            dialog (selection-add-dialog-config state
                                                                add-action)]
                        (if dialog
                          (do
                            (open-selection-new-dialog! state ctx dialog)
                            state)
                          (let [next-state
                                (form-state (begin-new-state state))]
                            (replace-form-body! next-state ctx))))))
        :form/save-new (fn [state event ctx]
                         (let [stopped (ui/stop-propagation! event)]
                           (let [next-state (form-state (save-new-state state))]
                             (replace-form-body! next-state ctx)
                             (emit-form-state-change!
                              state
                              next-state
                              ctx))))
        :form/cancel-new (fn [state event ctx]
                           (let [stopped (ui/stop-propagation! event)]
                             (let [next-state
                                   (form-state (cancel-new-state state))]
                               (replace-form-body! next-state ctx))))
        :form/selection-dialog-result
        (fn [state event ctx]
          (let [stopped (ui/stop-propagation! event)]
            (let [next-state
                  (form-state
                   (array-dialog-result-state state (:payload event)))]
              (when (not= state next-state)
                (replace-form-body! next-state ctx))
              (emit-form-state-change! state next-state ctx))))
        :form/delete (fn [state event ctx]
                       (let [stopped (ui/stop-propagation! event)]
                         (let [next-state (form-state (delete-state state))]
                           (replace-form-body! next-state ctx)
                           (emit-form-state-change!
                            state
                            next-state
                            ctx))))
        :form/move-up (fn [state event ctx]
                        (let [stopped (ui/stop-propagation! event)]
                          (let [next-state (form-state (move-up-state state))]
                            (replace-form-body! next-state ctx)
                            (emit-form-state-change!
                             state
                             next-state
                             ctx))))
        :form/move-down (fn [state event ctx]
                          (let [stopped (ui/stop-propagation! event)]
                            (let [next-state (form-state (move-down-state state))]
                              (replace-form-body! next-state ctx)
                              (emit-form-state-change!
                               state
                               next-state
                               ctx))))}})

(defun selection-control-view [selection opts]
  (when selection
    (let [toolbar-actions
          (form-selection/actions-for-presentation selection :toolbar)
          context-menu-actions
          (form-selection/actions-for-presentation selection :context-menu)
          item-child (when (not (empty? context-menu-actions))
                       (form-selection/list-item context-menu-actions))
          list-box-view
          (list-box/make
           {:options (ui/bind-state :options)
            :selected-indices
            (ui/bind-state :selected-indices)
            :force-selection? false
            :visible-rows (:visible-rows selection)
            :fixed-visible-rows? (:fixed-visible-rows? selection)
            :reorderable? (ui/bind-state :reorderable?)
            :item-child item-child
            :style (if (contains? selection :list-style)
                     (:list-style selection)
                     (form-layout/style-option
                      opts
                      :selection-list-style
                      default-selection-list-style))})
          children (if (empty? toolbar-actions)
                     [list-box-view]
                     [list-box-view
                      (form-selection/toolbar-view selection
                                                   opts
                                                   toolbar-actions)])]
      (merge {:mode 'pixils/form-selection
              :state {:options (ui/project-state :selection-options)
                      :selection-options (ui/project-state :selection-options)
                      :selected-indices (ui/project-state :selected-indices)
                      :form/action-disabled
                      (ui/project-state :form/action-disabled)
                      :item-label (:item-label selection)
                      :reorderable? (:reorderable? selection)
                      :activate-event (:activate-event selection)}
              :children children}
             (form-layout/style-map
             (form-layout/defaultable-style (:style selection)
                                            (:class selection)
                                            (form-layout/style-option
                                             opts
                                             :selection-style
                                             default-selection-style)))
             {:class (form-layout/classes :pixils/form-selection
                                          (:class selection))}))))

(defun fields-view [children opts]
  {:class :pixils/form-fields
   :style (or (form-layout/style-option opts :fields-style default-fields-style)
              {})
   :state form-state-binding
   :children children})

(defun root-array-schema? [schema]
  (= (:type (model-schema/resolved-root-schema schema)) :array))

(defun root-array-view [schema opts]
  (array-control-view nil
                      (model-schema/resolved-root-schema schema)
                      opts
                      (ui/bind-state :value)))

(defun form-children [layout schema opts selection]
  (if (root-array-schema? schema)
    [(root-array-view schema opts)]
    (let [children (layout-item-views (or layout (default-layout schema opts))
                                      opts)]
      (cond
        (nil? selection)
        children

        (= (:placement selection) :right)
        [(fields-view children opts) (selection-control-view selection opts)]

        :default
        (concat [(selection-control-view selection opts)] children)))))

(defun form-body-view [layout schema opts selection]
  {:id form-body-id
   :class :pixils/form-body
   :style (or (form-layout/style-option opts
                                         :body-style
                                         {:width :fill
                                          :height :shrink})
              {})
   :state form-layout-state-binding
   :children (form-children layout schema opts selection)})

(defun form-render-opts [state]
  (with-valid-value-options-cache
   (merge (or (:form/render-opts state) {})
          {:schema (model-schema/prepare-schema (:schema state))
           :value (:value state)
           :context (:context state)})))

(defun form-body-from-state [state]
  (let [opts (form-render-opts state)]
    (form-body-view (:form/layout state)
                    (:schema state)
                    opts
                    (:form/render-selection state))))

(defun replace-form-body! [state ctx]
  (ui/replace-child! (:view ctx)
                     form-body-id
                     (form-body-from-state state))
  state)

(defun form-body-replace-needed? [state next-state]
  (not= (branch-render-key (:schema state)
                           (:value state)
                           (:context state))
        (branch-render-key (:schema next-state)
                           (:value next-state)
                           (:context next-state))))

(defun make [{:keys [schema text layout controls value style class
                     field-style field-label-style row-style separator-style
                     control-style valid? errors selection models projection]
              :as opts}]
  (let [projection (projection-entry models
                                     (or projection
                                         (form-layout/layout-projection
                                          layout)))
        layout-selection (form-layout/layout-selection layout)
        direct-state-selection
        (let [result {}
              result (if (contains? opts :items)
                       (assoc result :items (:items opts))
                       result)
              result (if (contains? opts :selected-index)
                       (assoc result :selected-index (:selected-index opts))
                       result)
              result (if (contains? opts :new?)
                       (assoc result :new? (:new? opts))
                       result)
              result (if (contains? opts :new-value)
                       (assoc result :new-value (:new-value opts))
                       result)
              result (if (contains? opts :new-value-fn)
                       (assoc result :new-value-fn (:new-value-fn opts))
                       result)
              result (if (contains? opts :item-label)
                       (assoc result :item-label (:item-label opts))
                       result)]
          (when (not (empty? result))
            result))
        state-selection (merge (or layout-selection {})
                               (or (normalized-selection models
                                                         selection
                                                         projection)
                                   {})
                               (or direct-state-selection {}))
        state-selection
        (if (empty? state-selection)
          nil
          (merge (or (:selection-defaults opts) {})
                 state-selection))
        render-selection (when (or selection
                                   (and direct-state-selection
                                        (nil? layout-selection)))
                           state-selection)
        opts (assoc (assoc opts :projection projection)
                    :form/selection state-selection)
        state (normalized-form-state opts state-selection)
        schema (model-schema/prepare-schema (:schema state))
        opts (with-valid-value-options-cache
               (assoc opts
                      :schema schema
                      :value (:value state)
                      :context (:context state)))
        state (assoc (assoc state :schema schema)
                     :form/selection state-selection
                     :form/render-selection render-selection
                     :form/actions
                     (concat (form-layout/layout-actions layout)
                             (form-selection/actions
                              (or state-selection {})))
                     :form/layout layout
                     :form/render-opts opts)]
    (merge {:mode 'pixils/form
            :state state
            :children [(form-body-view layout schema opts render-selection)]}
           (form-layout/style-map
            (form-layout/defaultable-style
             style
             class
             (form-layout/style-option opts :style default-style)))
           {:class (form-layout/classes :pixils/form class)})))
