(ns pixils.form
  (:require pixils
            [pixils.schema :as model-schema]
            [pixils.ui :as ui]
            [pixils.ui.checkbox :as checkbox]
            [pixils.ui.list-box :as list-box]
            [pixils.ui.number-input :as number-input]))

(def default-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def default-field-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 3}})

(def default-field-label-style
  {:width :fill})

(def default-row-style
  {:width :fill
   :height :shrink
   :layout {:direction :row
            :align-items :start
            :gap 10}})

(def default-separator-style
  {:width :fill
   :height 1
   :background {:r 0x9a :g 0x9a :b 0x92}})

(def default-control-style
  {:width :fill
   :height 24})

(def checkbox-style
  {:width :fill
   :height 24})

(def default-display-style
  {:width :fill
   :height 18})

(def default-selection-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 4}})

(def default-selection-list-style
  {:width :fill})

(def default-fields-style
  {:width :fill
   :height :shrink
   :layout {:direction :column
            :gap 8}})

(def separator-token :------)

(def form-state-binding
  {:value (ui/bind-state :value)})

(defun model-entry [models model-id]
  (get (or models {}) model-id))

(defun model-value [models model-id]
  (:value (or (model-entry models model-id) {})))

(defun model-schema [models model-id]
  (:schema (or (model-entry models model-id) {})))

(defun model-ref? [models value]
  (and (keyword? value)
       (contains? (or models {}) value)))

(defun model-ref-value [models value]
  (if (model-ref? models value)
    (model-value models value)
    value))

(defun primary-model-id [opts projection]
  (or (:model opts)
      (:target projection)))

(defun selection-value [models selection projection key]
  (model-ref-value models (or (get selection key)
                              (get projection key))))

(defun normalized-selection [models selection projection]
  (when (or selection projection)
    (assoc (or selection {})
           :items (selection-value models selection projection :items)
           :selected-index
           (selection-value models selection projection :selected-index)
           :new? (selection-value models selection projection :new?)
           :new-value
           (selection-value models selection projection :new-value))))

(defun normalized-form-state [{:keys [schema value valid? errors models
                                      projection]
                               :as opts}
                              selection]
  (let [model-id (primary-model-id opts projection)]
    {:value (or value (model-value models model-id))
     :schema (or schema (model-schema models model-id))
     :valid? valid?
     :errors errors
     :items (:items selection)
     :selected-index (:selected-index selection)
     :new? (:new? selection)
     :new-value (:new-value selection)}))

(defun field-path [field-id field-schema]
  (model-schema/field-path field-id field-schema))

(defun field-value [value field-id field-schema]
  (model-schema/field-value value field-id field-schema))

(defun validate-field [schema value field-id]
  (model-schema/validate-field schema value field-id))

(defun validation-errors [schema value]
  (model-schema/validation-errors schema value))

(defun validate [schema value]
  (model-schema/validate schema value))

(defun selected-item [items index]
  (let [items (or items [])]
    (when (and (not (nil? index))
               (>= index 0)
               (< index (count items)))
      (nth items index))))

(defun default-item-label [item index]
  (or (:label item)
      (:name item)
      (:id item)
      (str item)))

(defun selection-option [item index item-label]
  {:value index
   :label (if item-label
            (item-label item index)
            (default-item-label item index))})

(defun selection-options [items item-label]
  (for-indexed [index item (or items [])]
    (selection-option item index item-label)))

(defun selected-indices [index]
  (if (nil? index) [] [index]))

(defun update-selected-item [items index value]
  (let [items (or items [])]
    (if (and (not (nil? index))
             (>= index 0)
             (< index (count items)))
      (assoc items index value)
      items)))

(defun projection-state [state]
  (let [new? (:new? state)
        items (:items state)
        selected-index (:selected-index state)
        selected (selected-item items selected-index)
        value (:value state)]
    (cond
      (nil? items)
      state

      new?
      (if (:projected-new? state)
        (assoc state :projected-item value)
        (assoc state
               :value (:new-value state)
               :projected-new? true
               :projected-index nil
               :projected-item (:new-value state)))

      (or (not= selected-index (:projected-index state))
          (not= selected (:projected-item state)))
      (assoc state
             :value selected
             :projected-new? false
             :projected-index selected-index
             :projected-item selected)

      (not= value selected)
      (assoc state
             :items (update-selected-item items selected-index value)
             :projected-item value)

      :default state)))

(defun field-binding [field-id field-schema]
  (apply ui/bind-state (concat [:value] (field-path field-id field-schema))))

(defun label-for [field-id text]
  (or (get (or text {}) field-id)
      (str field-id)))

(defun field-value-text [field-id field-schema]
  {:mode 'ui/text
   :style default-display-style
   :state {:value (field-binding field-id field-schema)}})

(defun text-control [field-id field-schema field-label opts]
  {:mode 'ui/text-input
   :style (or (:control-style opts) default-control-style)
   :state {:value (field-binding field-id field-schema)
           :auto-focus? (:auto-focus? field-schema)
           :read-only? (:read-only? field-schema)}})

(defun number-control [field-id field-schema field-label opts]
  (number-input/make {:style (or (:control-style opts) default-control-style)
                      :value (field-binding field-id field-schema)
                      :min (:min field-schema)
                      :max (:max field-schema)
                      :step (:step field-schema)
                      :allow-negative? (:allow-negative? field-schema)
                      :allow-fractions? (:allow-fractions? field-schema)
                      :disabled? (:read-only? field-schema)
                      :auto-focus? (:auto-focus? field-schema)}))

(defun boolean-control [field-id field-schema field-label opts]
  (checkbox/make {:style checkbox-style
                  :label ""
                  :checked? (field-binding field-id field-schema)
                  :value field-id}))

(defun display-control [field-id field-schema field-label opts]
  (field-value-text field-id field-schema))

(def default-controls
  {:text text-control
   :string text-control
   :integer number-control
   :number number-control
   :boolean boolean-control
   :display display-control})

(defun field-control [field-id field-schema field-label opts]
  (let [controls (merge default-controls (or (:controls opts) {}))
        control (get controls (:type field-schema))]
    (if control
      (apply control [field-id field-schema field-label opts])
      (display-control field-id field-schema field-label opts))))

(defun field-view [field-id opts]
  (let [schema (or (:schema opts) {})
        text (:text opts)
        field-schema (get schema field-id)
        field-label (label-for field-id text)]
    (if field-schema
      {:style (or (:field-style opts) default-field-style)
       :state form-state-binding
       :children [{:mode 'ui/text
                   :class :ui/muted
                   :style (or (:field-label-style opts)
                              default-field-label-style)
                   :state {:value field-label}}
                  (field-control field-id field-schema field-label opts)]}
      {:mode 'ui/text
       :state {:value (str "Unknown form field " field-id)}})))

(defun separator-view [opts]
  {:style (or (:separator-style opts) default-separator-style)})

(defun row-view [items opts]
  {:style (or (:row-style opts) default-row-style)
   :state form-state-binding
   :children (map items (fn [item] (layout-item-view item opts)))})

(defun layout-item-view [item opts]
  (cond
    (= item separator-token) (separator-view opts)
    (= (type-of item) "vector") (row-view item opts)
    :default (field-view item opts)))

(defun default-layout [schema]
  (keys (or schema {})))

(defcomponent pixils/form-selection
  {:style default-selection-style
   :update (fn [state ctx]
             (assoc state
                    :options (selection-options (:items state)
                                                (:item-label state))
                    :selected-indices
                    (selected-indices (:selected-index state))))
   :on {:list-box/change (fn [state event ctx]
                           (do
                             (ui/stop-propagation! event)
                             (assoc state
                                    :new? false
                                    :selected-index
                                    (-> event :payload :value))))}
   :children [(list-box/make {:options (ui/bind-state :options)
                              :selected-indices
                              (ui/bind-state :selected-indices)
                              :force-selection? false
                              :style default-selection-list-style})]})

(defcomponent pixils/form
  {:update (fn [state ctx]
             (let [state (projection-state state)
                   validation (model-schema/validate (:schema state)
                                                     (:value state))]
               (assoc state
                      :valid? (:valid? validation)
                      :errors (:errors validation))))})

(defun selection-view [selection]
  (when selection
    {:mode 'pixils/form-selection
     :style (or (:style selection) default-selection-style)
     :state {:items (ui/bind-state :items)
             :selected-index (ui/bind-state :selected-index)
             :new? (ui/bind-state :new?)
             :item-label (:item-label selection)}}))

(defun fields-view [children]
  {:style default-fields-style
   :state form-state-binding
   :children children})

(defun form-children [layout schema opts selection]
  (let [children (map (or layout (default-layout schema))
                      (fn [item]
                        (layout-item-view item opts)))]
    (cond
      (nil? selection)
      children

      (= (:placement selection) :right)
      [(fields-view children) (selection-view selection)]

      :default
      (concat [(selection-view selection)] children))))

(defun make [{:keys [schema text layout controls value style
                     field-style field-label-style row-style separator-style
                     control-style valid? errors selection models projection]
              :as opts}]
  (let [selection (normalized-selection models selection projection)
        state (normalized-form-state opts selection)
        schema (:schema state)
        opts (assoc opts :schema schema)]
    {:mode 'pixils/form
     :style (or style default-style)
     :state state
     :children (form-children layout schema opts selection)}))
