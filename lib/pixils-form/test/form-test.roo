                                         :valid-values [:a :b]}}
                         :value {:name "Ada"
                                 :count 1
                                 :enabled? false
                                 :role :a}})
        fields (form-children view)
        name-field (nth fields 0)
        count-field (nth fields 1)
        enabled-field (nth fields 2)
        role-field (nth fields 3)
        name-control (nth (:children name-field) 1)
        count-control (nth (:children count-field) 1)
        enabled-control (nth (:children enabled-field) 1)
        role-control (nth (:children role-field) 1)]
    (is (= :name (get-in name-field [:state :field-id])))
    (is (= [:name] (get-in name-field [:state :field-path])))
    (is (= 'ui/text-input (:mode name-control)))
    (is (= :count (get-in count-field [:state :field-id])))
    (is (= [:count] (get-in count-field [:state :field-path])))
    (is (= 'ui/number-input (:mode count-control)))
    (is (= :enabled? (get-in enabled-field [:state :field-id])))
    (is (= [:enabled?] (get-in enabled-field [:state :field-path])))
    (is (= 'ui/checkbox (:mode enabled-control)))
    (is (= 'pixils/form-select-control (:mode role-control)))
    (is (= :role (get-in role-control [:state :field-id])))))

