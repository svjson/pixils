(deftest make-supports-hierarchical-model-projection-layout
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0
                           :transient? true}
                          :new-person?
                          {:value false
                           :transient? true}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}
                           :transient? true}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :text {:field/name "Name"}
               :layout [{:type :row
                         :children [{:type :form
                                     :model [:register :person]
                                     :layout [:field/name]}
                                    {:type :selection
                                     :projection
                                     [:register :current-person]}]}]})
        state (:state view)
        row-view (form-child view 0)
        form-view (head (:children row-view))
        selection-view (nth (:children row-view) 1)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= 1 (count (form-children view))))
    (is (= 2 (count (:children row-view))))
    (is (contains? (:state row-view) :value))
    (is (contains? (:state form-view) :value))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))))

(deftest action-disabled-uses-form-state-conditions
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :disabled-when :new?})))
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :enabled-when [:and :new? :valid?]})))
  (is (= false
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? true}
           :enabled-when [:and :new? :valid?]}))))

(deftest make-supports-action-layout-nodes
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0}
                          :new-person?
                          {:value false}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :layout [{:type :selection
                         :projection [:register :current-person]}
                        {:type :row
                         :children [{:type :action
                                     :id :person/new
                                     :label "New"
                                     :disabled-when :new?}
                                    {:type :action
                                     :id :person/save
                                     :label "Save"
                                     :enabled-when
                                     [:and :new? :valid?]}]}]})
        action-row (form-child view 1)
        new-action (head (:children action-row))
        save-action (nth (:children action-row) 1)]
    (is (= 'pixils/form-action (:mode new-action)))
    (is (= :person/new (get-in new-action [:state :event])))
    (is (= "New" (get-in new-action [:state :label])))
    (is (= :new? (get-in new-action [:state :disabled-when])))
    (is (= [:and :new? :valid?]
           (get-in save-action [:state :enabled-when])))))

