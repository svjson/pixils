    (is (= 'ui/dialog-body (:mode body)))
    (is (contains? (:state body) :value))
    (is (contains? (:state body) :index))
    (is (contains? (:state body) :new?))
    (is (contains? (:on body) :dialog/button))
    (is (= 'pixils/form (:mode item-form)))
    (is (= 'ui/dialog-button-row (:mode button-row)))
    (is (= 2 (count (:children button-row))))))

(deftest array-item-dialog-body-preserves-custom-controls
  (let [custom-control (fn [field-id field-schema field-label opts]
                         {:mode 'test/custom-control
                          :state {:field-id field-id
                                  :label field-label}})
        body (form/array-item-dialog-body
              {:type :object
               :fields {:group {:type :group-membership}}}
              {:controls {:group-membership custom-control}
               :text {:group "Group"}})
        item-form (head (:children body))
        field-view (head (:children item-form))
        control (nth (:children field-view) 1)]
    (is (= 'test/custom-control (:mode control)))
    (is (= :group (-> control :state :field-id)))
    (is (= "Group" (-> control :state :label)))))

(deftest make-normalizes-combined-model-projection
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}
                                  :people
                                  {:value [{:field/name "Ada"
                                            :field/age 36}]}
                                  :selected-person-index
                                  {:value 0
                                   :transient? true}
                                  :new-person?
                                  {:value false
                                   :transient? true}
                                  :new-person
                                  {:value {:field/name ""
                                           :field/age 0}
                                   :transient? true}}
                         :projection {:target :person
                                      :items :people
                                      :selected-index
                                      :selected-person-index
                                      :new? :new-person?
                                      :new-value :new-person}
                         :layout [:field/name]
                         :selection {:items :people
                                     :selected-index
                                     :selected-person-index}})
        state (:state view)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= {:field/name ""
            :field/age 0}
           (:new-value state)))))

