(ns pixils.form-test
  (:require proof.core
            [pixils.form.controls.combo-box :as combo-box-control]
            [pixils.form.controls.array-editor :as array-editor-control]
            [pixils.form.controls.object-form :as object-form-control]
            [pixils.form.field :as form-field]
            [pixils.form.state :as form-state]
            [pixils.form.valid-values :as form-valid-values]
            [pixils.form :as form]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(defun empty-person [index]
  {:field/name ""
   :field/age 0
   :label (str "New Person " (inc index))})



;; pixils.form/normalized-form-state

(deftest normalized-form-state/defaults-to-transient-mode
  (is (= :transient
         (:form/mode
          (form/normalized-form-state
           {:schema person-schema
            :value {:field/name "Ada"}
            :context {}}
           nil)))))

(deftest normalized-form-state/preserves-live-mode
  (is (= :live
         (:form/mode
          (form/normalized-form-state
           {:schema person-schema
            :value {:field/name "Ada"}
            :context {}
            :mode :live}
           nil)))))



;; pixils.form-field/change-payload

(deftest field-change-payload/reports-field-and-next-form-value
  (is (= {:field-id :terrain-rule-exclusive
          :field-path [:exclusive?]
          :local-field-path [:exclusive?]
          :field-schema {:type :boolean
                         :path [:exclusive?]}
          :old-value false
          :value true
          :form-value {:exclusive? true
                       :label "Grass edge"}}
         (form-field/change-payload
          {:field-id :terrain-rule-exclusive
           :field-path [:exclusive?]
           :local-field-path [:exclusive?]
           :field-schema {:type :boolean
                          :path [:exclusive?]}
           :form-value {:exclusive? false
                        :label "Grass edge"}}
          true))))

(deftest field-change-payload/canonicalizes-keyword-field-values
  (is (= {:field-id :terrain-id
          :field-path [:id]
          :local-field-path [:id]
          :field-schema {:type :keyword}
          :old-value :terrain/old
          :value :terrain/new
          :form-value {:id :terrain/new}}
         (form-field/change-payload
          {:field-id :terrain-id
           :field-path [:id]
           :local-field-path [:id]
           :field-schema {:type :keyword}
           :form-value {:id :terrain/old}}
          "terrain/new"))))

(deftest field-change-payload/accepts-leading-colon-for-keywords
  (is (= :terrain/new
         (:value
          (form-field/change-payload
           {:field-id :terrain-id
            :field-path [:id]
            :local-field-path [:id]
            :field-schema {:type :keyword}
            :form-value {:id :terrain/old}}
           ":terrain/new")))))

(deftest field-change-payload/clears-blank-keyword-fields
  (is (= {:field-id :terrain-id
          :field-path [:id]
          :local-field-path [:id]
          :field-schema {:type :keyword}
          :old-value :terrain/old
          :value nil
          :form-value {:id nil}}
         (form-field/change-payload
          {:field-id :terrain-id
           :field-path [:id]
           :local-field-path [:id]
           :field-schema {:type :keyword}
           :form-value {:id :terrain/old}}
          ""))))

(deftest field-change-payload/keeps-number-draft-text
  (is (= {:field-id :duration
          :field-path [:duration]
          :local-field-path [:duration]
          :field-schema {:type :integer}
          :old-value 50
          :value "5"
          :form-value {:duration "5"}}
         (form-field/change-payload
          {:field-id :duration
           :field-path [:duration]
           :local-field-path [:duration]
           :field-schema {:type :integer}
           :form-value {:duration 50}}
          "5"))))

(deftest field-change-payload/reports-root-form-value
  (is (= {:field-id nil
          :field-path nil
          :local-field-path nil
          :field-schema nil
          :old-value [{:id :terrain/dirt}]
          :value [{:id :terrain/grass}]
          :form-value [{:id :terrain/grass}]}
         (form-field/change-payload
         {:form-value [{:id :terrain/dirt}]}
          [{:id :terrain/grass}]))))



;; pixils.form-field/change-payload-with-commit

(deftest field-change-payload-with-commit/accepts-color-values
  (is (= {:field-id :accent
          :field-path [:accent]
          :local-field-path [:accent]
          :field-schema {:type :color}
          :old-value {:r 0 :g 0 :b 0 :a 255}
          :value {:r 10 :g 20 :b 30 :a 255}
          :form-value {:accent {:r 10 :g 20 :b 30 :a 255}}}
         (form-field/change-payload-with-commit
          {:field-id :accent
           :field-path [:accent]
           :local-field-path [:accent]
           :field-schema {:type :color}
           :form-value {:accent {:r 0 :g 0 :b 0 :a 255}}}
          {:r 10 :g 20 :b 30 :a 255}
          true))))

(deftest field-change-payload-with-commit/canonicalizes-number-draft-text
  (is (= {:field-id :duration
          :field-path [:duration]
          :local-field-path [:duration]
          :field-schema {:type :integer}
          :old-value 50
          :value 5
          :form-value {:duration 5}}
         (form-field/change-payload-with-commit
          {:field-id :duration
           :field-path [:duration]
           :local-field-path [:duration]
           :field-schema {:type :integer}
           :form-value {:duration 50}}
          "5"
          true))))



;; pixils.form-valid-values/options

(deftest valid-value-options/resolve-labels-and-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}]}}]
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (form-valid-values/options context field-schema)))))

(deftest valid-value-options/can-depend-on-sibling-field-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}]
    (is (= [{:value :blackmere
             :label "Blackmere"}]
           (form-valid-values/options-for-value
            context
            field-schema
            {:source :terrain})))))



;; pixils.form-state/validated-state

(deftest validated-state/validates-current-value
  (is (= {:schema person-schema
          :value {:field/name ""
                  :field/age -1}
          :context {}
          :valid? false
          :errors {:field/name [{:rule :required}]
                   :field/age [{:rule :min
                                :min 0
                                :actual -1}]}}
         (form-state/validated-state
          {:schema person-schema
           :value {:field/name ""
                   :field/age -1}
           :context {}
           :valid? :stale
           :errors :stale-errors}))))



;; pixils.form/changed-form-state

(deftest changed-form-state/updates-value-and-validation-from-event-payload
  (is (= {:schema person-schema
          :value {:field/name ""
                  :field/age -1}
          :context {}
          :valid? false
          :errors {:field/name [{:rule :required}]
                   :field/age [{:rule :min
                                :min 0
                                :actual -1}]}
          :form/action-disabled {}}
         (form/changed-form-state
          {:schema person-schema
           :value {:field/name "Ada"
                   :field/age 36}
           :context {}
           :valid? true
           :errors {}}
          {:form-value {:field/name ""
                        :field/age -1}}))))

(deftest changed-form-state/keeps-deep-number-draft-text
  (is (= "1200"
         (-> (form/changed-form-state
              {:schema {:shape {:type :object
                                :fields {:radius
                                         {:type :object
                                          :fields {:x
                                                   {:type :object
                                                    :fields {:range
                                                             {:type :object
                                                              :fields
                                                              {:min
                                                               {:type
                                                                :number}}}}}}}}}}
               :value {:shape {:radius {:x {:type :random
                                             :range {:min nil}}}}}}
              {:field-path [:shape :radius :x :range :min]
               :value "1200"
               :commit? false})
             :value :shape :radius :x :range :min))))

(deftest changed-form-state/commits-deep-number-value
  (is (= 1200
         (-> (form/changed-form-state
              {:schema {:shape {:type :object
                                :fields {:radius
                                         {:type :object
                                          :fields {:x
                                                   {:type :object
                                                    :fields {:range
                                                             {:type :object
                                                              :fields
                                                              {:min
                                                               {:type
                                                                :number}}}}}}}}}}
               :value {:shape {:radius {:x {:type :random
                                             :range {:min "1200"}}}}}}
              {:field-path [:shape :radius :x :range :min]
               :value 1200
               :commit? true})
             :value :shape :radius :x :range :min))))



;; pixils.form/cached-form-field-state

(deftest cached-form-field-state/reuses-visibility-when-inputs-match
  (let [state {:schema person-schema
               :field-id :field/name
               :value {:field/name "Ada"
                       :field/age 36}}
        cached (form/cached-form-field-state state)
        reused (form/cached-form-field-state
                (assoc cached :visible? :cached))]
    (is (= true (:visible? cached)))
    (is (= :cached (:visible? reused)))))

(deftest cached-form-field-state/ignores-unrelated-object-value-changes
  (let [cached (form/cached-form-field-state
                {:schema person-schema
                 :field-id :field/name
                 :dynamic-visibility? false
                 :value {:field/name "Ada"
                         :field/age 36}})
        changed (form/cached-form-field-state
                 (assoc cached
                        :visible? :cached
                        :value {:field/name "Grace"
                                :field/age 37}))]
    (is (= true (:visible? cached)))
    (is (= :cached (:visible? changed)))))

(deftest cached-form-field-state/recomputes-visibility-when-value-changes
  (let [schema-doc {:definitions
                    {:rule-base {:type :object
                                 :fields {:type {:type :keyword}}}
                     :a-rule {:extends :rule-base
                              :fields {:a {:type :text}}}
                     :b-rule {:extends :rule-base
                              :fields {:b {:type :text}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :rule-base}
                             :variants {:a {:ref :a-rule}
                                        :b {:ref :b-rule}}}}
        cached (form/cached-form-field-state
                {:schema schema-doc
                 :field-id :a
                 :dynamic-visibility? true
                 :value {:type :a
                         :a "yes"}})
        changed (form/cached-form-field-state
                 (assoc cached
                        :visible? :cached
                        :value {:type :b
                                :b "no"}))]
    (is (= true (:visible? cached)))
    (is (= false (:visible? changed)))))



;; pixils.form/branch-render-key

(deftest branch-render-key/changes-for-active-branch-not-scalar-edits
  (let [schema-doc {:definitions
                    {:effect-base
                     {:type :object
                      :fields {:kind {:type :keyword
                                      :valid-values [:move :wait]}}}
                     :move-effect
                     {:extends :effect-base
                      :fields {:distance {:type :number}}}
                     :wait-effect
                     {:extends :effect-base
                      :fields {:duration {:type :integer}}}}
                    :schema {:type :union
                             :discriminator :kind
                             :base {:ref :effect-base}
                             :variants {:move {:ref :move-effect}
                                        :wait {:ref :wait-effect}}}}
        move-key (object-form-control/branch-render-key schema-doc
                                         {:kind :move
                                          :distance 1}
                                         {}
                                         {})
        edited-move-key (object-form-control/branch-render-key schema-doc
                                                {:kind :move
                                                 :distance 2}
                                                {}
                                                {})
        wait-key (object-form-control/branch-render-key schema-doc
                                         {:kind :wait
                                          :duration 5}
                                         {}
                                         {})]
    (is (= move-key edited-move-key))
    (is (not= move-key wait-key))))



;; pixils.combo-box-control/control-state

(deftest select-control-state/preselects-current-value
  (is (= {:options [{:value nil
                     :label ""}
                    {:value :sit
                     :label "sit"}
                    {:value :stand
                     :label "stand"}]
          :value :stand
          :select-options-key {:value :stand
                               :valid-values nil
                               :source {:valid-values nil}}
          :selected-index 2}
         (combo-box-control/control-state
          {:options [{:value nil
                      :label ""}
                     {:value :sit
                      :label "sit"}
                     {:value :stand
                      :label "stand"}]
           :value :stand}))))

(deftest select-control-state/reuses-options-when-inputs-match
  (let [state (combo-box-control/control-state
               {:options [{:value nil
                           :label ""}
                          {:value :sit
                           :label "sit"}]
                :value :sit})
        reused (combo-box-control/control-state
                (assoc state
                       :options :cached
                       :selected-index :cached))]
    (is (= 1 (:selected-index state)))
    (is (= :cached (:options reused)))
    (is (= :cached (:selected-index reused)))))

(deftest select-control-state/rebuilds-options-when-dependent-source-changes
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        state (combo-box-control/control-state
               {:field-schema field-schema
                :context {:landmarks [{:value :dawnkeep
                                       :label "Dawnkeep"}]
                          :terrain [{:value :blackmere
                                     :label "Blackmere"}]}
                :form-value {:source :landmarks}
                :value :dawnkeep})
        changed (combo-box-control/control-state
                 (assoc state
                        :options :cached
                        :selected-index :cached
                        :form-value {:source :terrain}
                        :value :blackmere))]
    (is (= :dawnkeep (-> state :options (nth 1) :value)))
    (is (= :blackmere (-> changed :options (nth 1) :value)))
    (is (= 1 (:selected-index changed)))))



;; pixils.form-valid-values/options-cache

(deftest valid-value-options-cache/deduplicates-repeated-context-sources
  (let [valid-values {:from [:vocabularies :places]
                      :value-path [:id]
                      :label-path [:label]}
        field-schema {:type :keyword
                      :valid-values valid-values}
        schema-doc {:schema {:type :object
                             :fields {:home field-schema
                                      :work field-schema}}}
        context {:vocabularies
                 {:places [{:id :dawnkeep
                            :label "Dawnkeep"}]}}
        cache (form-valid-values/options-cache schema-doc {} context)
        key (form-valid-values/options-cache-key context field-schema {})]
    (is (= 1 (count (keys cache))))
    (is (= [{:value :dawnkeep
             :label "Dawnkeep"}]
           (get cache key)))))

(deftest valid-value-options-cache/separates-dependent-sources
  (let [valid-values {:from {:field [:source]
                             :sources {:landmarks [:landmarks]
                                       :terrain [:terrain]}}
                      :value-path [:value]
                      :label-path [:label]}
        relation-schema {:type :object
                         :fields {:source {:type :keyword}
                                  :target {:type :keyword
                                           :valid-values valid-values}}}
        schema-doc {:schema {:type :object
                             :fields {:a relation-schema
                                      :b relation-schema}}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}
        cache (form-valid-values/options-cache
               schema-doc
               {:a {:source :landmarks}
                :b {:source :terrain}}
               context)]
    (is (= 2 (count (keys cache))))))



;; pixils.form-field/assoc-value

(deftest form-value-with-field-value/updates-nested-field-path
  (is (= {:target {:source :terrain
                   :id :dawnkeep}}
         (form-field/assoc-value
          {:form-value {:target {:source :landmarks
                                 :id :dawnkeep}}
           :field-path [:target :source]}
          :terrain))))

(deftest form-value-with-field-value/uses-root-value-without-field-path
  (is (= [{:id :terrain/grass}]
         (form-field/assoc-value
          {:form-value [{:id :terrain/dirt}]}
          [{:id :terrain/grass}]))))



;; pixils.form/form-state-change-payload

(deftest form-state-change-payload/canonicalizes-number-fields
  (is (= {:form-value {:id :terrain/forest
                       :count 12
                       :weight 0.5
                       :parts [{:offset 1.25}]}
          :value {:id :terrain/forest
                  :count 12
                  :weight 0.5
                  :parts [{:offset 1.25}]}}
         (form/form-state-change-payload
          {:schema {:type :object
                    :fields {:id {:type :keyword}
                             :count {:type :integer}
                             :weight {:type :number}
                             :parts {:type :array
                                     :items {:type :object
                                             :fields {:offset
                                                      {:type :number}}}}}}
           :value {:id "terrain/forest"
                   :count "12"
                   :weight "0.5"
                   :parts [{:offset "1.25"}]}}))))



;; pixils.form/form-state-draft-change-payload

(deftest form-state-draft-change-payload/preserves-number-draft-text
  (is (= {:form-value {:id "terrain/forest"
                       :count "12"
                       :weight "0.5"
                       :parts [{:offset "1.25"}]}
          :value {:id "terrain/forest"
                  :count "12"
                  :weight "0.5"
                  :parts [{:offset "1.25"}]}}
         (form/form-state-draft-change-payload
          {:schema {:type :object
                    :fields {:id {:type :keyword}
                             :count {:type :integer}
                             :weight {:type :number}
                             :parts {:type :array
                                     :items {:type :object
                                             :fields {:offset
                                                      {:type :number}}}}}}
           :value {:id "terrain/forest"
                   :count "12"
                   :weight "0.5"
                   :parts [{:offset "1.25"}]}}))))



;; pixils.form-state/projection-state

(deftest projection-state/selects-current-collection-item
  (let [state (form-state/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= {:name "Grace"} (:value state)))
    (is (= 1 (:projected-index state)))
    (is (= {:name "Grace"} (:projected-item state)))))

(deftest projection-state/writes-edited-value-back-to-collection
  (let [state (form-state/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}
                :value {:name "Grace Hopper"}})]
    (is (= [{:name "Ada"}
            {:name "Grace Hopper"}]
           (:items state)))
    (is (= {:name "Grace Hopper"} (:projected-item state)))))

(deftest projection-state/uses-transient-new-value-without-collection-write
  (let [state (form-state/projection-state
               {:items [{:name "Ada"}]
                :selected-index nil
                :new? true
                :new-value {:name ""}
                :value {:name "Ada"}})]
    (is (= {:name ""} (:value state)))
    (is (= true (:projected-new? state)))
    (is (= [{:name "Ada"}] (:items state)))))

(deftest projection-state/keeps-transient-edits-out-of-collection
  (let [state (form-state/projection-state
               {:items [{:name "Ada"}]
                :new? true
                :projected-new? true
                :projected-item {:name ""}
                :value {:name "New Person"}})]
    (is (= [{:name "Ada"}] (:items state)))
    (is (= {:name "New Person"} (:projected-item state)))))



;; pixils.form-state/begin-new-state

(deftest begin-new-state/uses-projection-factory
  (let [state (form-state/begin-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index 0
                :new-value-fn empty-person})]
    (is (= true (:new? state)))
    (is (nil? (:selected-index state)))
    (is (= 0 (:previous-selected-index state)))
    (is (= {:field/name ""
            :field/age 0
            :label "New Person 2"}
           (:value state)))
    (is (= (:value state) (:new-value state)))))



;; pixils.form-state/save-new-state

(deftest save-new-state/appends-and-selects-created-item
  (let [state (form-state/save-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index nil
                :new? true
                :valid? true
                :value {:field/name "Grace"
                        :field/age 85}})]
    (is (= [{:field/name "Ada"
             :field/age 36}
            {:field/name "Grace"
             :field/age 85}]
           (:items state)))
    (is (= 1 (:selected-index state)))
    (is (= false (:new? state)))
    (is (nil? (:new-value state)))))

(deftest save-new-state/canonicalizes-submitted-number-drafts
  (let [state (form-state/save-new-state
               {:schema {:type :object
                         :fields {:name {:type :text}
                                  :count {:type :integer}
                                  :weight {:type :number}}}
                :items []
                :selected-index nil
                :new? true
                :valid? true
                :value {:name "Sample"
                        :count "3"
                        :weight "2.5"}})]
    (is (= [{:name "Sample"
             :count 3
             :weight 2.5}]
           (:items state)))
    (is (= {:name "Sample"
            :count 3
            :weight 2.5}
           (:value state)))))



;; pixils.form-state/delete-state

(deftest delete-state/removes-selected-item-and-selects-next
  (let [state (form-state/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (nil? (:projected-index state)))
    (is (nil? (:projected-item state)))))

(deftest delete-state/selects-previous-when-last-item-is-removed
  (let [state (form-state/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= [{:name "Ada"}]
           (:items state)))
    (is (= 0
           (:selected-index state)))))

(deftest delete-state/clears-selection-when-collection-becomes-empty
  (let [state (form-state/delete-state
               {:items [{:name "Ada"}]
                :selected-index 0})]
    (is (= []
           (:items state)))
    (is (nil? (:selected-index state)))))

(deftest delete-state/is-a-no-op-without-a-selection
  (is (= {:items [{:name "Ada"}]
          :selected-index nil}
         (form-state/delete-state
          {:items [{:name "Ada"}]
           :selected-index nil}))))

(deftest delete-state/is-a-no-op-with-an-out-of-range-selection
  (is (= {:items [{:name "Ada"}]
          :selected-index 2}
         (form-state/delete-state
          {:items [{:name "Ada"}]
           :selected-index 2}))))



;; pixils.form-state/move-up-state

(deftest move-up-state/swaps-selected-item-with-previous
  (let [state (form-state/move-up-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 2
                :projected-index 2
                :projected-item {:name "Katherine"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}
            {:name "Grace"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (nil? (:projected-index state)))))

(deftest move-up-state/is-a-no-op-at-the-first-item
  (is (= {:items [{:name "Ada"}
                  {:name "Grace"}]
          :selected-index 0}
         (form-state/move-up-state
          {:items [{:name "Ada"}
                   {:name "Grace"}]
           :selected-index 0}))))



;; pixils.form-state/move-down-state

(deftest move-down-state/swaps-selected-item-with-next
  (let [state (form-state/move-down-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 0})]
    (is (= [{:name "Grace"}
            {:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))))

(deftest move-down-state/is-a-no-op-at-the-last-item
  (is (= {:items [{:name "Ada"}
                  {:name "Grace"}]
          :selected-index 1}
         (form-state/move-down-state
          {:items [{:name "Ada"}
                   {:name "Grace"}]
           :selected-index 1}))))

(deftest move-down-state/is-a-no-op-without-a-selection
  (is (= {:items [{:name "Ada"}]
          :selected-index nil}
         (form-state/move-down-state
          {:items [{:name "Ada"}]
           :selected-index nil}))))

(deftest move-down-state/is-a-no-op-during-a-new-session
  (is (= {:items [{:name "Ada"}]
          :selected-index 0
          :new? true}
         (form-state/move-down-state
          {:items [{:name "Ada"}]
           :selected-index 0
           :new? true}))))



;; pixils.form-state/cancel-new-state

(deftest cancel-new-state/restores-previous-selection
  (let [state (form-state/cancel-new-state
               {:selected-index nil
                :previous-selected-index 2
                :new? true
                :new-value {:field/name ""}})]
    (is (= 2 (:selected-index state)))
    (is (= false (:new? state)))
    (is (nil? (:new-value state)))))



;; pixils.form-state/selection-options

(deftest selection-options/support-data-driven-item-labels
  (let [options (form-state/selection-options
                 [{:place-id :place/dawnkeep-stables}
                  {:place-id :place/dawnkeep-smithy}]
                 {:path [:place-id]})]
    (is (= [{:value 0
             :label ":place/dawnkeep-stables"}
            {:value 1
             :label ":place/dawnkeep-smithy"}]
           options))))

(deftest selection-options/uses-scalar-values-as-default-labels
  (is (= [{:value 0 :label "grass"}
          {:value 1 :label ":water"}
          {:value 2 :label "42"}
          {:value 3 :label "false"}
          {:value 4 :label "Item 5"}
          {:value 5 :label "Item 6"}]
         (form-state/selection-options ["grass" :water 42 false nil ""] nil))))



;; pixils.array-editor-control/selection-add-dialog-config

(deftest selection-add-dialog-config/infers-default-dialog-for-add-only-actions
  (is (= {}
         (array-editor-control/selection-add-dialog-config
          {:form/actions [{:key :add
                           :id :form/new}
                          {:key :delete
                           :id :form/delete}]}
          {:key :add
           :id :form/new}))))

(deftest selection-add-dialog-config/keeps-editable-selection-inline
  (is (nil?
       (array-editor-control/selection-add-dialog-config
        {:form/actions [{:key :add
                         :id :form/new}
                        {:key :save
                         :id :form/save-new}
                        {:key :cancel
                         :id :form/cancel-new}]}
        {:key :add
         :id :form/new}))))

(deftest selection-add-dialog-config/returns-custom-dialog-configuration
  (is (= {:title "Add Person"
          :layout [:field/name]}
         (array-editor-control/selection-add-dialog-config
          {:form/actions []}
          {:key :add
           :id :form/new
           :dialog {:title "Add Person"
                    :layout [:field/name]}}))))

(deftest selection-add-dialog-config/respects-disabled-dialog-configuration
  (is (nil?
       (array-editor-control/selection-add-dialog-config
        {:form/actions []}
        {:key :add
         :id :form/new
         :dialog false}))))



;; pixils.array-editor-control/array-dialog-result-state

(deftest array-dialog-result-state/appends-confirmed-new-item
  (is (= {:items [{:name "Ada"}
                  {:name "Grace"}
                  {:name "Katherine"}]
          :selected-index 2
          :projected-index nil
          :projected-item nil}
         (array-editor-control/array-dialog-result-state
          {:items [{:name "Ada"}
                   {:name "Grace"}]
           :selected-index 0}
          {:type :confirm
           :new? true
           :value {:name "Katherine"}}))))

(deftest array-dialog-result-state/replaces-confirmed-existing-item
  (is (= {:items [{:name "Ada"}
                  {:name "Margaret"}]
          :selected-index 1
          :projected-index nil
          :projected-item nil}
         (array-editor-control/array-dialog-result-state
          {:items [{:name "Ada"}
                   {:name "Grace"}]
           :selected-index 0}
          {:type :confirm
           :new? false
           :index 1
           :value {:name "Margaret"}}))))

(deftest array-dialog-result-state/canonicalizes-submitted-number-drafts
  (let [schema {:type :object
                :fields {:id {:type :keyword}
                         :count {:type :integer}
                         :weight {:type :number}}}
        state {:item-schema schema
               :items []
               :selected-index nil}
        next-state (array-editor-control/array-dialog-result-state
                    state
                    {:type :confirm
                     :new? true
                     :value {:id "item/example"
                             :count "7"
                             :weight "1.5"}})]
    (is (= [{:id :item/example
             :count 7
             :weight 1.5}]
           (:items next-state)))))



;; pixils.array-editor-control/array-item-dialog-result

(deftest array-item-dialog-result/canonicalizes-submitted-number-drafts
  (let [result (array-editor-control/array-item-dialog-result
                {:schema {:type :object
                          :fields {:count {:type :integer}
                                   :weight {:type :number}}}
                 :index 1
                 :new? false
                 :value {:count "2"
                         :weight "0.75"}}
                {:payload {:choice :dialog/ok}}
                nil)]
    (is (= {:type :confirm
            :index 1
            :new? false
            :value {:count 2
                    :weight 0.75}}
           result))))



;; pixils.array-editor-control/array-items-change-payload

(deftest array-items-change-payload/reports-root-array-value
  (is (= {:field-id nil
          :field-path nil
          :local-field-path nil
          :field-schema nil
          :old-value nil
          :value [{:id :terrain/dirt}
                  {:id :terrain/grass}]
          :form-value [{:id :terrain/dirt}
                       {:id :terrain/grass}]
          :commit? true}
         (array-editor-control/array-items-change-payload
          {:items [{:id :terrain/dirt}]}
          {:items [{:id :terrain/dirt}
                   {:id :terrain/grass}]}))))

(deftest array-items-change-payload/returns-nil-when-items-are-unchanged
  (is (nil?
       (array-editor-control/array-items-change-payload
        {:items [{:id :terrain/grass}
                 {:id :terrain/dirt}]}
        {:items [{:id :terrain/grass}
                 {:id :terrain/dirt}]}))))



;; pixils.form-state/move-item-state

(deftest move-item-state/reorders-items-and-selected-index
  (let [state (form-state/move-item-state
               {:items [:a :b :c]
                :selected-index 0}
               0
               2)]
    (is (= [:b :c :a] (:items state)))
    (is (= 2 (:selected-index state)))))
