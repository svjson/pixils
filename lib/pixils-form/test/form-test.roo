(ns pixils.form-test
  (:require proof.core
            [pixils.form :as form]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(deftest validate-reports_required_and_range_errors
  (let [result (form/validate person-schema
                              {:field/name ""
                               :field/age -1
                               :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts_valid_values_and_field_paths
  (let [result (form/validate person-schema
                              {:field/name "Ada"
                               :field/age 36
                               :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))
