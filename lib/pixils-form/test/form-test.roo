(ns pixils.form-test
  (:require proof.core
            [pixils.form :as form]
            [pixils.schema :as schema]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(defun empty-person [index]
  {:field/name ""
   :field/age 0
   :label (str "New Person " (inc index))})

(defun form-body [view]
  (head (:children view)))

(defun form-children [view]
  (:children (form-body view)))

(defun form-child [view index]
  (nth (form-children view) index))

(deftest validate-reports-required-and-range-errors
  (let [result (schema/validate person-schema
                                {:field/name ""
                                 :field/age -1
                                 :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts-valid-values-and-field-paths
  (let [result (schema/validate person-schema
                                {:field/name "Ada"
                                 :field/age 36
                                 :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))

(deftest validate-rejects-values-outside-fixed-valid-values
  (let [role-schema {:field/role {:type :keyword
                                  :valid-values
                                  [:role/stable-lad
                                   :role/stable-master]}}
        result (schema/validate role-schema
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest validate-with-context-resolves-source-backed-valid-values
  (let [schema {:field/place {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}
                           {:id :place/dawnkeep-smithy
                            :label "Dawnkeep Smithy"}]}}
        valid-result (schema/validate-with-context
                      schema
                      {:field/place :place/dawnkeep-stables}
                      context)
        invalid-result (schema/validate-with-context
                        schema
                        {:field/place :place/dawnkeep-market}
                        context)]
    (is (= true (:valid? valid-result)))
    (is (= false (:valid? invalid-result)))
    (is (= [{:rule :valid-values
             :allowed [:place/dawnkeep-stables
                       :place/dawnkeep-smithy]
             :actual :place/dawnkeep-market}]
           (get-in invalid-result [:errors :field/place])))))

(deftest valid-value-options-resolve-labels-and-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}]}}]
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (schema/valid-value-options context field-schema)))))

(deftest valid-value-options-can-depend-on-sibling-field-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}]
    (is (= [{:value :blackmere
             :label "Blackmere"}]
           (schema/valid-value-options-for-value
            context
            field-schema
            {:source :terrain})))))

(deftest schema-resolves-object-definition-extensions
  (let [schema-doc {:definitions
                    {:base-rule
                     {:type :object
                      :fields {:type {:type :keyword}
                               :id {:type :keyword}}}
                     :point-rule
                     {:extends :base-rule
                      :fields {:point {:type :number}}}}
                    :schema {:ref :point-rule}}]
    (is (= [:type :id :point]
           (schema/schema-field-ids schema-doc)))))

(deftest validation-uses-active-discriminated-union-variant
  (let [schema-doc {:definitions
                    {:rule-base
                     {:type :object
                      :fields {:type {:type :keyword
                                      :required true
                                      :valid-values [:preferred-position
                                                     :edge]}}}
                     :preferred-position-rule
                     {:extends :rule-base
                      :fields {:point {:type :number
                                       :required true}}}
                     :edge-rule
                     {:extends :rule-base
                      :fields {:target {:type :keyword
                                        :required true}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :rule-base}
                             :variants
                             {:preferred-position
                              {:ref :preferred-position-rule}
                              :edge {:ref :edge-rule}}}}]
    (is (= true
           (:valid? (schema/validate
                     schema-doc
                     {:type :preferred-position
                      :point 10}))))
    (is (= true
           (:valid? (schema/validate
                     schema-doc
                     {:type :edge
                      :target :forest}))))
    (is (= {:target [{:rule :required}]}
           (:errors (schema/validate
                     schema-doc
                     {:type :edge}))))
    (is (= {:type [{:rule :valid-values
                    :allowed [:preferred-position :edge]
                    :actual :unknown}]}
           (:errors (schema/validate
                     schema-doc
                     {:type :unknown}))))))

(deftest validated-state-validates-current-value
  (let [value {:field/name ""
               :field/age -1}
        state (form/validated-state
               {:schema person-schema
                :value value
                :context {}
                :valid? :stale
                :errors :stale-errors})]
    (is (= false (:valid? state)))
    (is (= [{:rule :required}]
           (get-in state [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in state [:errors :field/age])))))

(deftest changed-form-state-updates-value-and-validation-from-event-payload
  (let [state (form/changed-form-state
               {:schema person-schema
                :value {:field/name "Ada"
                        :field/age 36}
                :context {}
                :valid? true
                :errors {}}
               {:form-value {:field/name ""
                             :field/age -1}})]
    (is (= {:field/name ""
            :field/age -1}
           (:value state)))
    (is (= false (:valid? state)))
    (is (= [{:rule :required}]
           (get-in state [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in state [:errors :field/age])))))

(deftest cached-form-field-state-reuses-visibility-when-inputs-match
  (let [state {:schema person-schema
               :field-id :field/name
               :value {:field/name "Ada"
                       :field/age 36}}
        cached (form/cached-form-field-state state)
        reused (form/cached-form-field-state
                (assoc cached :visible? :cached))]
    (is (= true (:visible? cached)))
    (is (= :cached (:visible? reused)))))

(deftest cached-form-field-state-ignores-unrelated-object-value-changes
  (let [cached (form/cached-form-field-state
                {:schema person-schema
                 :field-id :field/name
                 :dynamic-visibility? false
                 :value {:field/name "Ada"
                         :field/age 36}})
        changed (form/cached-form-field-state
                 (assoc cached
                        :visible? :cached
                        :value {:field/name "Grace"
                                :field/age 37}))]
    (is (= true (:visible? cached)))
    (is (= :cached (:visible? changed)))))

(deftest cached-form-field-state-recomputes-visibility-when-value-changes
  (let [schema-doc {:definitions
                    {:rule-base {:type :object
                                 :fields {:type {:type :keyword}}}
                     :a-rule {:extends :rule-base
                              :fields {:a {:type :text}}}
                     :b-rule {:extends :rule-base
                              :fields {:b {:type :text}}}}
                    :schema {:type :union
                             :discriminator :type
                             :base {:ref :rule-base}
                             :variants {:a {:ref :a-rule}
                                        :b {:ref :b-rule}}}}
        cached (form/cached-form-field-state
                {:schema schema-doc
                 :field-id :a
                 :dynamic-visibility? true
                 :value {:type :a
                         :a "yes"}})
        changed (form/cached-form-field-state
                 (assoc cached
                        :visible? :cached
                        :value {:type :b
                                :b "no"}))]
    (is (= true (:visible? cached)))
    (is (= false (:visible? changed)))))

(deftest select-control-state-preselects-current-value
  (let [state (form/select-control-state
               {:options [{:value nil
                           :label ""}
                          {:value :sit
                           :label "sit"}
                          {:value :stand
                           :label "stand"}]
                :value :stand})]
    (is (= 2 (:selected-index state)))))

(deftest select-control-state-reuses-options-when-inputs-match
  (let [state (form/select-control-state
               {:options [{:value nil
                           :label ""}
                          {:value :sit
                           :label "sit"}]
                :value :sit})
        reused (form/select-control-state
                (assoc state
                       :options :cached
                       :selected-index :cached))]
    (is (= 1 (:selected-index state)))
    (is (= :cached (:options reused)))
    (is (= :cached (:selected-index reused)))))

(deftest select-control-state-rebuilds-options-when-dependent-source-changes
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from {:field [:source]
                              :sources {:landmarks [:landmarks]
                                        :terrain [:terrain]}}
                       :value-path [:value]
                       :label-path [:label]}}
        state (form/select-control-state
               {:field-schema field-schema
                :context {:landmarks [{:value :dawnkeep
                                       :label "Dawnkeep"}]
                          :terrain [{:value :blackmere
                                     :label "Blackmere"}]}
                :form-value {:source :landmarks}
                :value :dawnkeep})
        changed (form/select-control-state
                 (assoc state
                        :options :cached
                        :selected-index :cached
                        :form-value {:source :terrain}
                        :value :blackmere))]
    (is (= :dawnkeep (-> state :options (nth 1) :value)))
    (is (= :blackmere (-> changed :options (nth 1) :value)))
    (is (= 1 (:selected-index changed)))))

(deftest valid-value-options-cache-deduplicates-repeated-context-sources
  (let [valid-values {:from [:vocabularies :places]
                      :value-path [:id]
                      :label-path [:label]}
        field-schema {:type :keyword
                      :valid-values valid-values}
        schema-doc {:schema {:type :object
                             :fields {:home field-schema
                                      :work field-schema}}}
        context {:vocabularies
                 {:places [{:id :dawnkeep
                            :label "Dawnkeep"}]}}
        cache (form/valid-value-options-cache schema-doc {} context)
        key (form/valid-value-options-cache-key context field-schema {})]
    (is (= 1 (count (keys cache))))
    (is (= [{:value :dawnkeep
             :label "Dawnkeep"}]
           (get cache key)))))

(deftest valid-value-options-cache-separates-dependent-sources
  (let [valid-values {:from {:field [:source]
                             :sources {:landmarks [:landmarks]
                                       :terrain [:terrain]}}
                      :value-path [:value]
                      :label-path [:label]}
        relation-schema {:type :object
                         :fields {:source {:type :keyword}
                                  :target {:type :keyword
                                           :valid-values valid-values}}}
        schema-doc {:schema {:type :object
                             :fields {:a relation-schema
                                      :b relation-schema}}}
        context {:landmarks [{:value :dawnkeep
                              :label "Dawnkeep"}]
                 :terrain [{:value :blackmere
                            :label "Blackmere"}]}
        cache (form/valid-value-options-cache
               schema-doc
               {:a {:source :landmarks}
                :b {:source :terrain}}
               context)]
    (is (= 2 (count (keys cache))))))

(deftest form-value-with-field-value-updates-nested-field-path
  (is (= {:target {:source :terrain
                   :id :dawnkeep}}
         (form/form-value-with-field-value
          {:form-value {:target {:source :landmarks
                                 :id :dawnkeep}}
           :field-path [:target :source]}
          :terrain))))

(deftest field-change-payload-reports-field-and-next-form-value
  (let [payload (form/field-change-payload
                 {:field-id :terrain-rule-exclusive
                  :field-path [:exclusive?]
                  :field-schema {:type :boolean
                                 :path [:exclusive?]}
                  :form-value {:exclusive? false
                               :label "Grass edge"}}
                 true)]
    (is (= :terrain-rule-exclusive (:field-id payload)))
    (is (= [:exclusive?] (:field-path payload)))
    (is (= false (:old-value payload)))
    (is (= true (:value payload)))
    (is (= {:exclusive? true
            :label "Grass edge"}
           (:form-value payload)))))

(deftest schema-resolves-named-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role
                                  :required true}}}]
    (is (= {:type :keyword
            :valid-values [:role/stable-lad
                           :role/stable-master]
            :required true}
           (schema/resolved-field-schema schema-doc :field/role)))))

(deftest schema-resolves-nested-definition-references
  (let [schema-doc {:definitions
                    {:place-relation
                     {:type :object
                      :fields {:relation {:type :keyword}
                               :place-id {:ref :place-id}}}
                     :place-id
                     {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}}
                    :schema
                    {:type :array
                     :items {:ref :place-relation}}}]
    (is (= {:type :array
            :items {:type :object
                    :fields {:relation {:type :keyword}
                             :place-id
                             {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}}}}}
           (schema/resolved-root-schema schema-doc)))))

(deftest validate-resolves-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role}}}
        result (schema/validate schema-doc
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest schema-field-ids-use-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation {:type :keyword}
                                      :place-id {:type :keyword}}}}]
    (is (= [:relation :place-id]
           (schema/schema-field-ids schema-doc)))))

(deftest validate-validates-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation
                                      {:type :keyword
                                       :required true}
                                      :priority
                                      {:type :integer
                                       :min 1}}}}
        result (schema/validate schema-doc
                                {:relation ""
                                 :priority 0})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :relation])))
    (is (= [{:rule :min
             :min 1
             :actual 0}]
           (get-in result [:errors :priority])))))

(deftest validate-validates-nested-object-fields
  (let [schema-doc {:field/location
                    {:type :object
                     :fields {:place-id {:type :keyword
                                         :required true}
                              :anchor {:type :keyword}}}}
        result (schema/validate schema-doc
                                {:field/location
                                 {:place-id ""
                                  :anchor :stable/aisle}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :object
             :errors {:place-id [{:rule :required}]}}]
           (get-in result [:errors :field/location])))))

(deftest validate-validates-root-array-items
  (let [schema-doc {:schema {:type :array
                             :items {:type :object
                                     :fields {:relation
                                              {:type :keyword
                                               :required true}
                                              :priority
                                              {:type :integer
                                               :min 1}}}}}
        result (schema/validate schema-doc
                                [{:relation ""
                                  :priority 0}])]
    (is (= false (:valid? result)))
    (is (= {:value
            [{:rule :array
              :errors {0 {:relation [{:rule :required}]
                          :priority [{:rule :min
                                      :min 1
                                      :actual 0}]}}}]}
           (:errors result)))))

(deftest validate-validates-nested-array-items
  (let [schema-doc {:field/relations
                    {:type :array
                     :items {:type :object
                             :fields {:place-id {:type :keyword
                                                 :required true}}}}}
        result (schema/validate schema-doc
                                {:field/relations
                                 [{:place-id :place/dawnkeep-stables}
                                  {:place-id ""}]})]
    (is (= false (:valid? result)))
    (is (= [{:rule :array
             :errors {1 {:place-id [{:rule :required}]}}}]
           (get-in result [:errors :field/relations])))))

(deftest form-projection-selects-current-collection-item
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= {:name "Grace"} (:value state)))
    (is (= 1 (:projected-index state)))
    (is (= {:name "Grace"} (:projected-item state)))))

(deftest form-projection-writes-edited-value-back-to-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}
                :value {:name "Grace Hopper"}})]
    (is (= [{:name "Ada"}
            {:name "Grace Hopper"}]
           (:items state)))
    (is (= {:name "Grace Hopper"} (:projected-item state)))))

(deftest form-projection-uses-transient-new-value-without-collection-write
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :selected-index nil
                :new? true
                :new-value {:name ""}
                :value {:name "Ada"}})]
    (is (= {:name ""} (:value state)))
    (is (= true (:projected-new? state)))
    (is (= [{:name "Ada"}] (:items state)))))

(deftest form-projection-keeps-transient-edits-out-of-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :new? true
                :projected-new? true
                :projected-item {:name ""}
                :value {:name "New Person"}})]
    (is (= [{:name "Ada"}] (:items state)))
    (is (= {:name "New Person"} (:projected-item state)))))

(deftest form-owned-new-session-uses-projection-factory
  (let [state (form/begin-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index 0
                :new-value-fn empty-person})]
    (is (= true (:new? state)))
    (is (= nil (:selected-index state)))
    (is (= 0 (:previous-selected-index state)))
    (is (= {:field/name ""
            :field/age 0
            :label "New Person 2"}
           (:value state)))
    (is (= (:value state) (:new-value state)))))

(deftest form-owned-save-new-appends-and-selects-created-item
  (let [state (form/save-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index nil
                :new? true
                :valid? true
                :value {:field/name "Grace"
                        :field/age 85}})]
    (is (= [{:field/name "Ada"
             :field/age 36}
            {:field/name "Grace"
             :field/age 85}]
           (:items state)))
    (is (= 1 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest form-owned-delete-removes-selected-item-and-selects-next
  (let [state (form/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (= nil
           (:projected-index state)))
    (is (= nil
           (:projected-item state)))))

(deftest form-owned-delete-selects-previous-when-last-item-is-removed
  (let [state (form/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= [{:name "Ada"}]
           (:items state)))
    (is (= 0
           (:selected-index state)))))

(deftest form-owned-delete-clears-selection-when-collection-becomes-empty
  (let [state (form/delete-state
               {:items [{:name "Ada"}]
                :selected-index 0})]
    (is (= []
           (:items state)))
    (is (= nil
           (:selected-index state)))))

(deftest form-owned-delete-without-valid-selection-is-no-op
  (let [state {:items [{:name "Ada"}]
               :selected-index nil}]
    (is (= state
           (form/delete-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index 2}]
    (is (= state
           (form/delete-state state)))))

(deftest form-owned-move-up-swaps-selected-item-with-previous
  (let [state (form/move-up-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 2
                :projected-index 2
                :projected-item {:name "Katherine"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}
            {:name "Grace"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (= nil
           (:projected-index state)))))

(deftest form-owned-move-down-swaps-selected-item-with-next
  (let [state (form/move-down-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 0})]
    (is (= [{:name "Grace"}
            {:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))))

(deftest form-owned-move-at-boundary-or-during-new-session-is-no-op
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 0}]
    (is (= state
           (form/move-up-state state))))
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 1}]
    (is (= state
           (form/move-down-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index nil}]
    (is (= state
           (form/move-down-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index 0
               :new? true}]
    (is (= state
           (form/move-down-state state)))))

(deftest form-owned-cancel-new-restores-previous-selection
  (let [state (form/cancel-new-state
               {:selected-index nil
                :previous-selected-index 2
                :new? true
                :new-value {:field/name ""}})]
    (is (= 2 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest selection-options-support-data-driven-item-labels
  (let [options (form/selection-options
                 [{:place-id :place/dawnkeep-stables}
                  {:place-id :place/dawnkeep-smithy}]
                 {:path [:place-id]})]
    (is (= [{:value 0
             :label ":place/dawnkeep-stables"}
            {:value 1
             :label ":place/dawnkeep-smithy"}]
           options))))

(deftest array-dialog-result-state-appends-and-replaces-items
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 0}
        appended (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? true
                   :value {:name "Katherine"}})
        replaced (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? false
                   :index 1
                   :value {:name "Margaret"}})]
    (is (= [{:name "Ada"}
            {:name "Grace"}
            {:name "Katherine"}]
           (:items appended)))
    (is (= 2 (:selected-index appended)))
    (is (= [{:name "Ada"}
            {:name "Margaret"}]
           (:items replaced)))
    (is (= 1 (:selected-index replaced)))))

(deftest array-dialog-result-state-replaces-existing-empty-item
  (let [state {:items [{}]
               :selected-index 0
               :projected-index 0
               :projected-item {}
               :value {}}
        replaced (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? false
                   :index 0
                   :value {:relation :place-relation/works-at
                           :place-id :workstation/stable-hand-post
                           :anchor :stand}})
        projected (form/projection-state replaced)]
    (is (= [{:relation :place-relation/works-at
             :place-id :workstation/stable-hand-post
             :anchor :stand}]
           (:items replaced)))
    (is (= {:relation :place-relation/works-at
            :place-id :workstation/stable-hand-post
            :anchor :stand}
           (:value projected)))))

(deftest move-item-state-reorders-items-and-selected-index
  (let [state (form/move-item-state
               {:items [:a :b :c]
                :selected-index 0}
               0
               2)]
