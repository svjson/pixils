(ns pixils.form-test
  (:require proof.core
            [pixils.form :as form]
            [pixils.schema :as schema]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(defun empty-person [index]
  {:field/name ""
   :field/age 0
   :label (str "New Person " (inc index))})

(deftest validate-reports-required-and-range-errors
  (let [result (schema/validate person-schema
                                {:field/name ""
                                 :field/age -1
                                 :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts-valid-values-and-field-paths
  (let [result (schema/validate person-schema
                                {:field/name "Ada"
                                 :field/age 36
                                 :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))

(deftest form-projection-selects-current-collection-item
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= {:name "Grace"} (:value state)))
    (is (= 1 (:projected-index state)))
    (is (= {:name "Grace"} (:projected-item state)))))

(deftest form-projection-writes-edited-value-back-to-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}
                :value {:name "Grace Hopper"}})]
    (is (= [{:name "Ada"}
            {:name "Grace Hopper"}]
           (:items state)))
    (is (= {:name "Grace Hopper"} (:projected-item state)))))

(deftest form-projection-uses-transient-new-value-without-collection-write
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :selected-index nil
                :new? true
                :new-value {:name ""}
                :value {:name "Ada"}})]
    (is (= {:name ""} (:value state)))
    (is (= true (:projected-new? state)))
    (is (= [{:name "Ada"}] (:items state)))))

(deftest form-projection-keeps-transient-edits-out-of-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :new? true
                :projected-new? true
                :projected-item {:name ""}
                :value {:name "New Person"}})]
    (is (= [{:name "Ada"}] (:items state)))
    (is (= {:name "New Person"} (:projected-item state)))))

(deftest form-owned-new-session-uses-projection-factory
  (let [state (form/begin-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index 0
                :new-value-fn empty-person})]
    (is (= true (:new? state)))
    (is (= nil (:selected-index state)))
    (is (= 0 (:previous-selected-index state)))
    (is (= {:field/name ""
            :field/age 0
            :label "New Person 2"}
           (:value state)))
    (is (= (:value state) (:new-value state)))))

(deftest form-owned-save-new-appends-and-selects-created-item
  (let [state (form/save-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index nil
                :new? true
                :valid? true
                :value {:field/name "Grace"
                        :field/age 85}})]
    (is (= [{:field/name "Ada"
             :field/age 36}
            {:field/name "Grace"
             :field/age 85}]
           (:items state)))
    (is (= 1 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest form-owned-cancel-new-restores-previous-selection
  (let [state (form/cancel-new-state
               {:selected-index nil
                :previous-selected-index 2
                :new? true
                :new-value {:field/name ""}})]
    (is (= 2 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest make-normalizes-combined-model-projection
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}
                                  :people
                                  {:value [{:field/name "Ada"
                                            :field/age 36}]}
                                  :selected-person-index
                                  {:value 0
                                   :transient? true}
                                  :new-person?
                                  {:value false
                                   :transient? true}
                                  :new-person
                                  {:value {:field/name ""
                                           :field/age 0}
                                   :transient? true}}
                         :projection {:target :person
                                      :items :people
                                      :selected-index
                                      :selected-person-index
                                      :new? :new-person?
                                      :new-value :new-person}
                         :layout [:field/name]
                         :selection {:items :people
                                     :selected-index
                                     :selected-person-index}})
        state (:state view)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= {:field/name ""
            :field/age 0}
           (:new-value state)))))

(deftest make-renders-combined-model-layout-from-resolved-schema
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}}
                         :text {:field/name "Name"}
                         :layout [:field/name]})
        field-view (head (:children view))]
    (is (= 2 (count (:children field-view))))
    (is (= "Name"
           (get-in field-view [:children 0 :state :value])))))

(deftest make-supports-hierarchical-model-projection-layout
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0
                           :transient? true}
                          :new-person?
                          {:value false
                           :transient? true}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}
                           :transient? true}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :text {:field/name "Name"}
               :layout [{:type :row
                         :children [{:type :form
                                     :model [:register :person]
                                     :layout [:field/name]}
                                    {:type :selection
                                     :projection
                                     [:register :current-person]}]}]})
        state (:state view)
        row-view (head (:children view))
        form-view (head (:children row-view))
        selection-view (nth (:children row-view) 1)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= 1 (count (:children view))))
    (is (= 2 (count (:children row-view))))
    (is (= {} (:state row-view)))
    (is (= {} (:state form-view)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))))

(deftest action-disabled-uses-form-state-conditions
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :disabled-when :new?})))
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :enabled-when [:and :new? :valid?]})))
  (is (= false
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? true}
           :enabled-when [:and :new? :valid?]}))))

(deftest make-supports-action-layout-nodes
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0}
                          :new-person?
                          {:value false}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :layout [{:type :selection
                         :projection [:register :current-person]}
                        {:type :row
                         :children [{:type :action
                                     :id :person/new
                                     :label "New"
                                     :disabled-when :new?}
                                    {:type :action
                                     :id :person/save
                                     :label "Save"
                                     :enabled-when
                                     [:and :new? :valid?]}]}]})
        action-row (nth (:children view) 1)
        new-action (head (:children action-row))
        save-action (nth (:children action-row) 1)]
    (is (= 'pixils/form-action (:mode new-action)))
    (is (= :person/new (get-in new-action [:state :event])))
    (is (= "New" (get-in new-action [:state :label])))
    (is (= :new? (get-in new-action [:state :disabled-when])))
    (is (= [:and :new? :valid?]
           (get-in save-action [:state :enabled-when])))))

(deftest make-supports-vector-layout-shorthand-with-classes
  (let [view (form/make
              {:class :person-register-form
               :models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0}
                          :new-person?
                          {:value false}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :layout [[:row.person-main-row
                         [:form [:register :person] [:field/name]]
                         [:group.person-list-column
                          [:selection.person-list
                           [:register :current-person]]
                          [:button.person-new
                           :person/new
                           {:label "New"
                            :disabled-when :new?}]]]]})
        row-view (head (:children view))
        form-view (head (:children row-view))
        group-view (nth (:children row-view) 1)
        selection-view (head (:children group-view))
        action-view (nth (:children group-view) 1)]
    (is (= :person-register-form (:class view)))
    (is (= :person-main-row (:class row-view)))
    (is (= :person-list-column (:class group-view)))
    (is (= :person-list (:class selection-view)))
    (is (= :person-new (:class action-view)))
    (is (= {} (:state form-view)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= 'pixils/form-action (:mode action-view)))
    (is (= :person/new (get-in action-view [:state :event])))
    (is (= :new? (get-in action-view [:state :disabled-when])))))
