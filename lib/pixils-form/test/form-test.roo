(ns pixils.form-test
  (:require proof.core
            [pixils.form :as form]
            [pixils.schema :as schema]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(defun empty-person [index]
  {:field/name ""
   :field/age 0
   :label (str "New Person " (inc index))})

(deftest validate-reports-required-and-range-errors
  (let [result (schema/validate person-schema
                                {:field/name ""
                                 :field/age -1
                                 :profile {:city "London"}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :field/name])))
    (is (= [{:rule :min
             :min 0
             :actual -1}]
           (get-in result [:errors :field/age])))
    (is (nil? (get-in result [:errors :field/city])))))

(deftest validate-accepts-valid-values-and-field-paths
  (let [result (schema/validate person-schema
                                {:field/name "Ada"
                                 :field/age 36
                                 :profile {:city "London"}})]
    (is (= true (:valid? result)))
    (is (= {} (:errors result)))))

(deftest validate-rejects-values-outside-fixed-valid-values
  (let [role-schema {:field/role {:type :keyword
                                  :valid-values
                                  [:role/stable-lad
                                   :role/stable-master]}}
        result (schema/validate role-schema
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest validate-with-context-resolves-source-backed-valid-values
  (let [schema {:field/place {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}
                           {:id :place/dawnkeep-smithy
                            :label "Dawnkeep Smithy"}]}}
        valid-result (schema/validate-with-context
                      schema
                      {:field/place :place/dawnkeep-stables}
                      context)
        invalid-result (schema/validate-with-context
                        schema
                        {:field/place :place/dawnkeep-market}
                        context)]
    (is (= true (:valid? valid-result)))
    (is (= false (:valid? invalid-result)))
    (is (= [{:rule :valid-values
             :allowed [:place/dawnkeep-stables
                       :place/dawnkeep-smithy]
             :actual :place/dawnkeep-market}]
           (get-in invalid-result [:errors :field/place])))))

(deftest valid-value-options-resolve-labels-and-values
  (let [field-schema {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}
        context {:vocabularies
                 {:places [{:id :place/dawnkeep-stables
                            :label "Dawnkeep Stables"}]}}]
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (schema/valid-value-options context field-schema)))))

(deftest select-control-state-preselects-current-value
  (let [state (form/select-control-state
               {:options [{:value nil
                           :label ""}
                          {:value :sit
                           :label "sit"}
                          {:value :stand
                           :label "stand"}]
                :value :stand})]
    (is (= 2 (:selected-index state)))))

(deftest schema-resolves-named-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role
                                  :required true}}}]
    (is (= {:type :keyword
            :valid-values [:role/stable-lad
                           :role/stable-master]
            :required true}
           (schema/resolved-field-schema schema-doc :field/role)))))

(deftest schema-resolves-nested-definition-references
  (let [schema-doc {:definitions
                    {:place-relation
                     {:type :object
                      :fields {:relation {:type :keyword}
                               :place-id {:ref :place-id}}}
                     :place-id
                     {:type :keyword
                      :valid-values
                      {:from [:vocabularies :places]
                       :value-path [:id]
                       :label-path [:label]}}}
                    :schema
                    {:type :array
                     :items {:ref :place-relation}}}]
    (is (= {:type :array
            :items {:type :object
                    :fields {:relation {:type :keyword}
                             :place-id
                             {:type :keyword
                              :valid-values
                              {:from [:vocabularies :places]
                               :value-path [:id]
                               :label-path [:label]}}}}}
           (schema/resolved-root-schema schema-doc)))))

(deftest validate-resolves-field-definition-references
  (let [schema-doc {:definitions
                    {:stable-role
                     {:type :keyword
                      :valid-values [:role/stable-lad
                                     :role/stable-master]}}
                    :schema
                    {:field/role {:ref :stable-role}}}
        result (schema/validate schema-doc
                                {:field/role :role/smith})]
    (is (= false (:valid? result)))
    (is (= [{:rule :valid-values
             :allowed [:role/stable-lad
                       :role/stable-master]
             :actual :role/smith}]
           (get-in result [:errors :field/role])))))

(deftest schema-field-ids-use-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation {:type :keyword}
                                      :place-id {:type :keyword}}}}]
    (is (= [:relation :place-id]
           (schema/schema-field-ids schema-doc)))))

(deftest validate-validates-object-root-fields
  (let [schema-doc {:schema {:type :object
                             :fields {:relation
                                      {:type :keyword
                                       :required true}
                                      :priority
                                      {:type :integer
                                       :min 1}}}}
        result (schema/validate schema-doc
                                {:relation ""
                                 :priority 0})]
    (is (= false (:valid? result)))
    (is (= [{:rule :required}]
           (get-in result [:errors :relation])))
    (is (= [{:rule :min
             :min 1
             :actual 0}]
           (get-in result [:errors :priority])))))

(deftest validate-validates-nested-object-fields
  (let [schema-doc {:field/location
                    {:type :object
                     :fields {:place-id {:type :keyword
                                         :required true}
                              :anchor {:type :keyword}}}}
        result (schema/validate schema-doc
                                {:field/location
                                 {:place-id ""
                                  :anchor :stable/aisle}})]
    (is (= false (:valid? result)))
    (is (= [{:rule :object
             :errors {:place-id [{:rule :required}]}}]
           (get-in result [:errors :field/location])))))

(deftest validate-validates-root-array-items
  (let [schema-doc {:schema {:type :array
                             :items {:type :object
                                     :fields {:relation
                                              {:type :keyword
                                               :required true}
                                              :priority
                                              {:type :integer
                                               :min 1}}}}}
        result (schema/validate schema-doc
                                [{:relation ""
                                  :priority 0}])]
    (is (= false (:valid? result)))
    (is (= {:value
            [{:rule :array
              :errors {0 {:relation [{:rule :required}]
                          :priority [{:rule :min
                                      :min 1
                                      :actual 0}]}}}]}
           (:errors result)))))

(deftest validate-validates-nested-array-items
  (let [schema-doc {:field/relations
                    {:type :array
                     :items {:type :object
                             :fields {:place-id {:type :keyword
                                                 :required true}}}}}
        result (schema/validate schema-doc
                                {:field/relations
                                 [{:place-id :place/dawnkeep-stables}
                                  {:place-id ""}]})]
    (is (= false (:valid? result)))
    (is (= [{:rule :array
             :errors {1 {:place-id [{:rule :required}]}}}]
           (get-in result [:errors :field/relations])))))

(deftest form-projection-selects-current-collection-item
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= {:name "Grace"} (:value state)))
    (is (= 1 (:projected-index state)))
    (is (= {:name "Grace"} (:projected-item state)))))

(deftest form-projection-writes-edited-value-back-to-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}
                :value {:name "Grace Hopper"}})]
    (is (= [{:name "Ada"}
            {:name "Grace Hopper"}]
           (:items state)))
    (is (= {:name "Grace Hopper"} (:projected-item state)))))

(deftest form-projection-uses-transient-new-value-without-collection-write
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :selected-index nil
                :new? true
                :new-value {:name ""}
                :value {:name "Ada"}})]
    (is (= {:name ""} (:value state)))
    (is (= true (:projected-new? state)))
    (is (= [{:name "Ada"}] (:items state)))))

(deftest form-projection-keeps-transient-edits-out-of-collection
  (let [state (form/projection-state
               {:items [{:name "Ada"}]
                :new? true
                :projected-new? true
                :projected-item {:name ""}
                :value {:name "New Person"}})]
    (is (= [{:name "Ada"}] (:items state)))
    (is (= {:name "New Person"} (:projected-item state)))))

(deftest form-owned-new-session-uses-projection-factory
  (let [state (form/begin-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index 0
                :new-value-fn empty-person})]
    (is (= true (:new? state)))
    (is (= nil (:selected-index state)))
    (is (= 0 (:previous-selected-index state)))
    (is (= {:field/name ""
            :field/age 0
            :label "New Person 2"}
           (:value state)))
    (is (= (:value state) (:new-value state)))))

(deftest form-owned-save-new-appends-and-selects-created-item
  (let [state (form/save-new-state
               {:items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index nil
                :new? true
                :valid? true
                :value {:field/name "Grace"
                        :field/age 85}})]
    (is (= [{:field/name "Ada"
             :field/age 36}
            {:field/name "Grace"
             :field/age 85}]
           (:items state)))
    (is (= 1 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest form-owned-delete-removes-selected-item-and-selects-next
  (let [state (form/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 1
                :projected-index 1
                :projected-item {:name "Grace"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (= nil
           (:projected-index state)))
    (is (= nil
           (:projected-item state)))))

(deftest form-owned-delete-selects-previous-when-last-item-is-removed
  (let [state (form/delete-state
               {:items [{:name "Ada"}
                        {:name "Grace"}]
                :selected-index 1})]
    (is (= [{:name "Ada"}]
           (:items state)))
    (is (= 0
           (:selected-index state)))))

(deftest form-owned-delete-clears-selection-when-collection-becomes-empty
  (let [state (form/delete-state
               {:items [{:name "Ada"}]
                :selected-index 0})]
    (is (= []
           (:items state)))
    (is (= nil
           (:selected-index state)))))

(deftest form-owned-delete-without-valid-selection-is-no-op
  (let [state {:items [{:name "Ada"}]
               :selected-index nil}]
    (is (= state
           (form/delete-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index 2}]
    (is (= state
           (form/delete-state state)))))

(deftest form-owned-move-up-swaps-selected-item-with-previous
  (let [state (form/move-up-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 2
                :projected-index 2
                :projected-item {:name "Katherine"}})]
    (is (= [{:name "Ada"}
            {:name "Katherine"}
            {:name "Grace"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))
    (is (= nil
           (:projected-index state)))))

(deftest form-owned-move-down-swaps-selected-item-with-next
  (let [state (form/move-down-state
               {:items [{:name "Ada"}
                        {:name "Grace"}
                        {:name "Katherine"}]
                :selected-index 0})]
    (is (= [{:name "Grace"}
            {:name "Ada"}
            {:name "Katherine"}]
           (:items state)))
    (is (= 1
           (:selected-index state)))))

(deftest form-owned-move-at-boundary-or-during-new-session-is-no-op
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 0}]
    (is (= state
           (form/move-up-state state))))
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 1}]
    (is (= state
           (form/move-down-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index nil}]
    (is (= state
           (form/move-down-state state))))
  (let [state {:items [{:name "Ada"}]
               :selected-index 0
               :new? true}]
    (is (= state
           (form/move-down-state state)))))

(deftest form-owned-cancel-new-restores-previous-selection
  (let [state (form/cancel-new-state
               {:selected-index nil
                :previous-selected-index 2
                :new? true
                :new-value {:field/name ""}})]
    (is (= 2 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= nil (:new-value state)))))

(deftest selection-options-support-data-driven-item-labels
  (let [options (form/selection-options
                 [{:place-id :place/dawnkeep-stables}
                  {:place-id :place/dawnkeep-smithy}]
                 {:path [:place-id]})]
    (is (= [{:value 0
             :label ":place/dawnkeep-stables"}
            {:value 1
             :label ":place/dawnkeep-smithy"}]
           options))))

(deftest array-dialog-result-state-appends-and-replaces-items
  (let [state {:items [{:name "Ada"}
                       {:name "Grace"}]
               :selected-index 0}
        appended (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? true
                   :value {:name "Katherine"}})
        replaced (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? false
                   :index 1
                   :value {:name "Margaret"}})]
    (is (= [{:name "Ada"}
            {:name "Grace"}
            {:name "Katherine"}]
           (:items appended)))
    (is (= 2 (:selected-index appended)))
    (is (= [{:name "Ada"}
            {:name "Margaret"}]
           (:items replaced)))
    (is (= 1 (:selected-index replaced)))))

(deftest array-dialog-result-state-replaces-existing-empty-item
  (let [state {:items [{}]
               :selected-index 0
               :projected-index 0
               :projected-item {}
               :value {}}
        replaced (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? false
                   :index 0
                   :value {:relation :place-relation/works-at
                           :place-id :workstation/stable-hand-post
                           :anchor :stand}})
        projected (form/projection-state replaced)]
    (is (= [{:relation :place-relation/works-at
             :place-id :workstation/stable-hand-post
             :anchor :stand}]
           (:items replaced)))
    (is (= {:relation :place-relation/works-at
            :place-id :workstation/stable-hand-post
            :anchor :stand}
           (:value projected)))))

(deftest move-item-state-reorders-items-and-selected-index
  (let [state (form/move-item-state
               {:items [:a :b :c]
                :selected-index 0}
               0
               2)]
    (is (= [:b :c :a] (:items state)))
    (is (= 2 (:selected-index state)))))

(deftest array-item-dialog-body-renders-form-and-buttons
  (let [body (form/array-item-dialog-body
              {:type :object
               :fields {:relation {:type :keyword}
                        :priority {:type :integer}}}
              {})
        item-form (head (:children body))
        button-row (nth (:children body) 1)]
    (is (= 'ui/dialog-body (:mode body)))
    (is (contains? (:state body) :value))
    (is (contains? (:state body) :index))
    (is (contains? (:state body) :new?))
    (is (contains? (:on body) :dialog/button))
    (is (= 'pixils/form (:mode item-form)))
    (is (= 'ui/dialog-button-row (:mode button-row)))
    (is (= 2 (count (:children button-row))))))

(deftest make-normalizes-combined-model-projection
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}
                                  :people
                                  {:value [{:field/name "Ada"
                                            :field/age 36}]}
                                  :selected-person-index
                                  {:value 0
                                   :transient? true}
                                  :new-person?
                                  {:value false
                                   :transient? true}
                                  :new-person
                                  {:value {:field/name ""
                                           :field/age 0}
                                   :transient? true}}
                         :projection {:target :person
                                      :items :people
                                      :selected-index
                                      :selected-person-index
                                      :new? :new-person?
                                      :new-value :new-person}
                         :layout [:field/name]
                         :selection {:items :people
                                     :selected-index
                                     :selected-person-index}})
        state (:state view)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= {:field/name ""
            :field/age 0}
           (:new-value state)))))

(deftest make-renders-combined-model-layout-from-resolved-schema
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}}
                         :text {:field/name "Name"}
                         :layout [:field/name]})
        field-view (head (:children view))]
    (is (= 2 (count (:children field-view))))
    (is (= "Name"
           (get-in field-view [:children 0 :state :value])))))

(deftest make-renders-keyword-fields-with-prefixed-input
  (let [view (form/make {:schema {:field/id {:type :keyword
                                             :required true
                                             :auto-focus? true}}
                         :text {:field/id "Id"}
                         :layout [:field/id]
                         :value {:field/id "scene/ground"}})
        field-view (head (:children view))
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-keyword-input (:mode control)))
    (is (contains? (:state control) :value))
    (is (= true (get-in control [:state :auto-focus?])))))

(deftest make-renders-valid-values-fields-with-select-control
  (let [view (form/make {:schema {:field/role
                                  {:type :keyword
                                   :valid-values
                                   [:role/stable-lad
                                    :role/stable-master]}}
                         :text {:field/role "Role"}
                         :layout [:field/role]
                         :value {:field/role :role/stable-lad}})
        field-view (head (:children view))
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value nil
             :label ""}
            {:value :role/stable-lad
             :label "role/stable-lad"}
            {:value :role/stable-master
             :label "role/stable-master"}]
           (get-in control [:state :options])))))

(deftest make-renders-context-backed-valid-values-fields-with-select-control
  (let [view (form/make {:schema {:field/place
                                  {:type :keyword
                                   :required true
                                   :valid-values
                                   {:from [:vocabularies :places]
                                    :value-path [:id]
                                    :label-path [:label]}}}
                         :context {:vocabularies
                                   {:places
                                    [{:id :place/dawnkeep-stables
                                      :label "Dawnkeep Stables"}]}}
                         :layout [:field/place]
                         :value {:field/place
                                 :place/dawnkeep-stables}})
        field-view (head (:children view))
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (get-in control [:state :options])))))

(deftest make-renders-fields-through-named-definition-references
  (let [view (form/make {:schema {:definitions
                                  {:stable-role
                                   {:type :keyword
                                    :valid-values
                                    [:role/stable-lad
                                     :role/stable-master]}}
                                  :schema
                                  {:field/role {:ref :stable-role}}}
                         :text {:field/role "Role"}
                         :layout [:field/role]
                         :value {:field/role :role/stable-lad}})
        field-view (head (:children view))
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value nil
             :label ""}
            {:value :role/stable-lad
             :label "role/stable-lad"}
            {:value :role/stable-master
             :label "role/stable-master"}]
           (get-in control [:state :options])))))

(deftest make-renders-object-root-fields-without-explicit-layout
  (let [view (form/make {:schema {:type :object
                                  :fields {:relation
                                           {:type :keyword
                                            :valid-values
                                            [:place-relation/works-at]}
                                           :priority
                                           {:type :integer
                                            :min 1}}}
                         :value {:relation :place-relation/works-at
                                 :priority 10}})
        relation-view (head (:children view))
        relation-control (nth (:children relation-view) 1)
        priority-view (nth (:children view) 1)
        priority-control (nth (:children priority-view) 1)]
    (is (= 2 (count (:children view))))
    (is (= 'pixils/form-select-control (:mode relation-control)))
    (is (= 'ui/number-input (:mode priority-control)))))

(deftest make-renders-nested-object-fields
  (let [view (form/make {:schema {:field/location
                                  {:type :object
                                   :fields {:place-id
                                            {:type :keyword
                                             :valid-values
                                             [:place/dawnkeep-stables]}
                                            :anchor
                                            {:type :keyword}}}}
                         :layout [:field/location]
                         :value {:field/location
                                 {:place-id
                                  :place/dawnkeep-stables
                                  :anchor :stable/aisle}}})
        location-view (head (:children view))
        object-control (nth (:children location-view) 1)
        place-view (head (:children object-control))
        place-control (nth (:children place-view) 1)
        anchor-view (nth (:children object-control) 1)
        anchor-control (nth (:children anchor-view) 1)]
    (is (= 'pixils/form-object-control (:mode object-control)))
    (is (= 2 (count (:children object-control))))
    (is (= 'pixils/form-select-control (:mode place-control)))
    (is (= 'pixils/form-keyword-input (:mode anchor-control)))))

(deftest make-renders-root-array-editor-for-object-items
  (let [view (form/make {:schema {:type :array
                                  :item-label {:path [:relation]}
                                  :item-summary [{:label "Relation"
                                                  :path [:relation]}
                                                 {:label "Priority"
                                                  :path [:priority]}]
                                  :items {:type :object
                                          :fields {:relation
                                                   {:type :keyword
                                                    :valid-values
                                                    [:place-relation/works-at]}
                                                   :priority
                                                   {:type :integer}}}}
                         :value [{:relation :place-relation/works-at
                                  :priority 10}]})
        array-control (head (:children view))
        content-row (head (:children array-control))
        selection-view (head (:children content-row))
        list-box (head (:children selection-view))
        summary-view (nth (:children content-row) 1)
        action-row (nth (:children array-control) 1)]
    (is (= 'pixils/form-array-control (:mode array-control)))
    (is (= 2 (count (:children array-control))))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= {:path [:relation]}
           (-> selection-view :state :item-label)))
    (is (= 5 (-> list-box :state :visible-rows)))
    (is (= true (-> list-box :state :fixed-visible-rows?)))
    (is (= {:height :fill
            :width :fill}
           (:style list-box)))
    (is (= 'pixils/form-array-summary (:mode summary-view)))
    (is (= [{:label "Relation"
             :path [:relation]}
            {:label "Priority"
             :path [:priority]}]
           (-> summary-view :state :specs)))
    (is (= 3 (count (:children action-row))))))

(deftest make-renders-nested-array-field-editor
  (let [view (form/make {:schema {:field/relations
                                  {:type :array
                                   :items {:type :object
                                           :fields {:place-id
                                                    {:type :keyword
                                                     :valid-values
                                                     [:place/dawnkeep-stables]}
                                                    :anchor
                                                    {:type :keyword}}}}}
                         :layout [:field/relations]
                         :value {:field/relations
                                 [{:place-id
                                   :place/dawnkeep-stables
                                   :anchor :stable/aisle}]}})
        relations-view (head (:children view))
        array-control (nth (:children relations-view) 1)
        content-row (head (:children array-control))
        selection-view (head (:children content-row))
        summary-view (nth (:children content-row) 1)
        action-row (nth (:children array-control) 1)]
    (is (= 'pixils/form-array-control (:mode array-control)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= :form/edit-item
           (-> selection-view :state :activate-event)))
    (is (= 'pixils/form-array-summary (:mode summary-view)))
    (is (= [{:label ":place-id"
             :path [:place-id]}
            {:label ":anchor"
             :path [:anchor]}]
           (-> summary-view :state :specs)))
    (is (= 3 (count (:children action-row))))))

(deftest make-supports-hierarchical-model-projection-layout
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0
                           :transient? true}
                          :new-person?
                          {:value false
                           :transient? true}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}
                           :transient? true}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :text {:field/name "Name"}
               :layout [{:type :row
                         :children [{:type :form
                                     :model [:register :person]
                                     :layout [:field/name]}
                                    {:type :selection
                                     :projection
                                     [:register :current-person]}]}]})
        state (:state view)
        row-view (head (:children view))
        form-view (head (:children row-view))
        selection-view (nth (:children row-view) 1)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= 1 (count (:children view))))
    (is (= 2 (count (:children row-view))))
    (is (= {} (:state row-view)))
    (is (= {} (:state form-view)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))))

(deftest action-disabled-uses-form-state-conditions
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :disabled-when :new?})))
  (is (= true
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? false}
           :enabled-when [:and :new? :valid?]})))
  (is (= false
         (form/action-disabled?
          {:form-state {:new? true
                        :valid? true}
           :enabled-when [:and :new? :valid?]}))))

(deftest make-supports-action-layout-nodes
  (let [view (form/make
              {:models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0}
                          :new-person?
                          {:value false}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :layout [{:type :selection
                         :projection [:register :current-person]}
                        {:type :row
                         :children [{:type :action
                                     :id :person/new
                                     :label "New"
                                     :disabled-when :new?}
                                    {:type :action
                                     :id :person/save
                                     :label "Save"
                                     :enabled-when
                                     [:and :new? :valid?]}]}]})
        action-row (nth (:children view) 1)
        new-action (head (:children action-row))
        save-action (nth (:children action-row) 1)]
    (is (= 'pixils/form-action (:mode new-action)))
    (is (= :person/new (get-in new-action [:state :event])))
    (is (= "New" (get-in new-action [:state :label])))
    (is (= :new? (get-in new-action [:state :disabled-when])))
    (is (= [:and :new? :valid?]
           (get-in save-action [:state :enabled-when])))))

(deftest make-supports-vector-layout-shorthand-with-classes
  (let [view (form/make
              {:class :person-register-form
               :models {:register
                        {:models
                         {:person
                          {:schema person-schema
                           :value {:field/name "Ada"
                                   :field/age 36}}
                          :people
                          {:value [{:field/name "Ada"
                                    :field/age 36}]}
                          :selected-person-index
                          {:value 0}
                          :new-person?
                          {:value false}
                          :new-person
                          {:value {:field/name ""
                                   :field/age 0}}}
                         :projections
                         {:current-person
                          {:target [:register :person]
                           :items [:register :people]
                           :selected-index
                           [:register :selected-person-index]
                           :new? [:register :new-person?]
                           :new-value [:register :new-person]}}}}
               :layout [[:row.person-main-row
                         [:form [:register :person] [:field/name]]
                         [:group.person-list-column
                          [:selection.person-list
                           [:register :current-person]]
                          [:button.person-new
                           :person/new
                           {:label "New"
                            :disabled-when :new?}]]]]})
        row-view (head (:children view))
        form-view (head (:children row-view))
        group-view (nth (:children row-view) 1)
        selection-view (head (:children group-view))
        action-view (nth (:children group-view) 1)]
    (is (= :person-register-form (:class view)))
    (is (= :person-main-row (:class row-view)))
    (is (= :person-list-column (:class group-view)))
    (is (= :person-list (:class selection-view)))
    (is (= :person-new (:class action-view)))
    (is (= {} (:state form-view)))
    (is (= 'pixils/form-selection (:mode selection-view)))
    (is (= 'pixils/form-action (:mode action-view)))
    (is (= :person/new (get-in action-view [:state :event])))
    (is (= :new? (get-in action-view [:state :disabled-when])))))
