(ns pixils.form.scenario-test
  (:require proof.core
            [pixils.form.actions :as form-actions]
            [pixils.form :as form]))

(def person-schema
  {:field/name {:type :text
                :required true}
   :field/age {:type :integer
               :required true
               :min 0
               :max 130}
   :field/city {:type :text
                :path [:profile :city]}})

(defun empty-person [index]
  {:field/name ""
   :field/age 0
   :label (str "New Person " (inc index))})

(defun form-body [view]
  (head (:children view)))

(defun form-children [view]
  (:children (form-body view)))

(defun form-child [view index]
  (nth (form-children view) index))

(defun class-list [{:keys [class]}]
  (cond
    (nil? class) []
    (keyword? class) [class]
    :default class))

(defun view-class? [view class]
  (contains? (class-list view) class))

(defun object-control-children [view]
  (:children (head (:children view))))

(defun group-box-body [view]
  (-> view :children head :children head))



;; pixils.form/make

(deftest make/keeps-component-mode-separate-from-form-mode
  (let [transient-view (form/make {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}})
        live-view (form/make {:schema person-schema
                              :value {:field/name "Ada"
                                      :field/age 36}
                              :mode :live})]
    (is (= 'pixils/form (:mode transient-view)))
    (is (= :transient
           (-> transient-view :state :form/mode)))
    (is (= 'pixils/form (:mode live-view)))
    (is (= :live
           (-> live-view :state :form/mode)))))

(deftest make/renders-fill-width-form-body
  (let [view (form/make {:schema person-schema
                         :value {:field/name "Ada"
                                 :field/age 36}})
        body (form-body view)]
    (is (= :pixils/form-body (:class body)))
    (is (= :fill (-> body :style :width)))
    (is (= :shrink (-> body :style :height)))))

(deftest make/renders-theme-backed-structural-classes
  (let [view (form/make {:schema person-schema
                         :value {:field/name "Ada"
                                 :field/age 36}
                         :theme-styles? true})
        body (form-body view)
        field (head (:children body))
        label (head (:children field))
        control (nth (:children field) 1)]
    (is (= :pixils/form (:class view)))
    (is (= :pixils/form-body (:class body)))
    (is (= :pixils/form-field (:class field)))
    (is (= {:visibility :visible} (:style field)))
    (is (= [:ui/muted :pixils/form-label] (:class label)))
    (is (= {} (:style label)))
    (is (= [:pixils/form-control :pixils/form-text-control]
           (:class control)))
    (is (= {} (:style control)))))

(deftest make/renders-slider-field-with-built-in-slider-control
  (let [view (form/make {:schema {:opacity {:type :slider
                                            :min 0
                                            :max 1
                                            :step 0.05}}
                         :value {:opacity 0.75}})
        field (form-child view 0)
        control (nth (:children field) 1)]
    (is (= 'pixils/form-slider-control
           (:mode control)))
    (is (= [:pixils/form-control :pixils/form-slider-control]
           (:class control)))
    (is (= :x
           (-> control :state :axis)))
    (is (= 0
           (-> control :state :min)))
    (is (= 1
           (-> control :state :max)))
    (is (= 0.05
           (-> control :state :step)))))

(deftest make/keeps-stable-dimensions-with-theme-styles
  (let [view (form/make {:schema {:zoom {:type :slider
                                         :min 1
                                         :max 4}}
                         :value {:zoom 2}
                         :theme-styles? true})
        field (form-child view 0)
        control (nth (:children field) 1)]
    (is (= form/default-slider-control-style
           (:style control)))
    (is (= form/default-slider-style
           (-> control :state :slider-style)))
    (is (= :fill
           (-> control :state :slider-style :width)))
    (is (= 220
           (-> control :state :slider-style :min-width)))
    (is (= form/default-slider-value-style
           (-> control :state :value-style)))))

(deftest make/renders-color-field-with-built-in-color-picker
  (let [view (form/make {:schema {:accent {:type :color}}
                         :value {:accent {:r 12 :g 34 :b 56 :a 255}}})
        field (form-child view 0)
        control (nth (:children field) 1)]
    (is (= 'ui/color-picker
           (:mode control)))
    (is (= [:pixils/form-control :pixils/form-color-control]
           (:class control)))
    (is (some? (-> control :state :value)))))

(deftest make/passes-color-picker-options
  (let [view (form/make {:schema {:accent {:type :color
                                           :read-only? true
                                           :allow-alpha? false
                                           :editor false
                                           :dialog-title "Accent Color"
                                           :swatch-class :paint/accent-swatch
                                           :swatch-style {:width 32
                                                          :height 18}}}
                         :value {:accent {:r 12 :g 34 :b 56}}})
        field (form-child view 0)
        control (nth (:children field) 1)
        swatch (head (:children control))]
    (is (= true
           (-> control :state :disabled?)))
    (is (= false
           (-> control :state :allow-alpha?)))
    (is (= false
           (-> control :state :editor)))
    (is (= "Accent Color"
           (-> control :state :dialog-title)))
    (is (= [:ui/color-picker-swatch :paint/accent-swatch]
           (:class swatch)))
    (is (= {:width 32
            :height 18}
           (:style swatch)))))

(deftest make/renders-top-level-layout-sections-as-group-boxes
  (let [view (form/make {:schema person-schema
                         :value {:field/name "Ada"
                                 :field/age 36
                                 :profile {:city "London"}}
                         :layout [{:type :section
                                   :title "Identity"
                                   :layout [:field/name
                                            :field/city]}]})
        section (form-child view 0)
        body (group-box-body section)]
    (is (= 'ui/group-box (:mode section)))
    (is (= :pixils/form-section (:class section)))
    (is (= "Identity"
           (-> section :state :title)))
    (is (= 'ui/group-box-body (:mode body)))
    (is (= :pixils/form-section-body (:class body)))
    (is (= 2 (count (:children body))))
    (is (= 'pixils/form-field
           (-> body :children head :mode)))))

(deftest make/renders-nested-layout-sections-as-plain-containers
  (let [view (form/make {:schema person-schema
                         :value {:field/name "Ada"
                                 :field/age 36}
                         :layout [{:type :section
                                   :title "Outer"
                                   :layout [{:type :section
                                             :title "Inner"
                                             :layout [:field/name]}]}]})
        outer (form-child view 0)
        outer-body (group-box-body outer)
        inner (head (:children outer-body))
        inner-title (head (:children inner))
        inner-body (nth (:children inner) 1)]
    (is (= 'ui/group-box (:mode outer)))
    (is (= :pixils/form-section (:class outer)))
    (is (nil? (:mode inner)))
    (is (= :pixils/form-nested-section (:class inner)))
    (is (= 'ui/text (:mode inner-title)))
    (is (= [:ui/muted :pixils/form-nested-section-title]
           (:class inner-title)))
    (is (= "Inner"
           (-> inner-title :state :value)))
    (is (= :pixils/form-nested-section-body
           (:class inner-body)))
    (is (= 'pixils/form-field
           (-> inner-body :children head :mode)))))

(deftest make/renders-selection-dialog-add-action
  (let [view (form/make
              {:schema person-schema
               :value {:field/name "Ada"
                       :field/age 36}
               :items [{:field/name "Ada"
                        :field/age 36}]
               :selected-index 0
               :new-value-fn empty-person
               :selection-defaults
               {:actions {:add true
                          :delete true}
                :action-presentation {:delete :context-menu}}
               :layout [[:row
                         {:type :selection
                          :item-label [:field/name]
                          :visible-rows 4}
                         {:type :form
                          :layout [:field/name]}]]})
        state (:state view)
        row-view (form-child view 0)
        selection-view (head (:children row-view))
        toolbar (nth (:children selection-view) 1)]
    (is (= 4
           (-> state :form/selection :visible-rows)))
    (is (= {:add true
            :delete true}
           (-> state :form/selection :actions)))
    (is (= {:delete :context-menu}
           (-> state :form/selection :action-presentation)))
    (is (= empty-person (:new-value-fn state)))
    (is (= [:form/new]
           (for [action (:children toolbar)]
             (-> action :state :event))))))

(deftest make/normalizes-combined-model-projection
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}
                                  :people
                                  {:value [{:field/name "Ada"
                                            :field/age 36}]}
                                  :selected-person-index
                                  {:value 0
                                   :transient? true}
                                  :new-person?
                                  {:value false
                                   :transient? true}
                                  :new-person
                                  {:value {:field/name ""
                                           :field/age 0}
                                   :transient? true}}
                         :projection {:target :person
                                      :items :people
                                      :selected-index
                                      :selected-person-index
                                      :new? :new-person?
                                      :new-value :new-person}
                         :layout [:field/name]
                         :selection {:items :people
                                     :selected-index
                                     :selected-person-index}})
        state (:state view)]
    (is (= person-schema (:schema state)))
    (is (= {:field/name "Ada"
            :field/age 36}
           (:value state)))
    (is (= [{:field/name "Ada"
             :field/age 36}]
           (:items state)))
    (is (= 0 (:selected-index state)))
    (is (= false (:new? state)))
    (is (= {:field/name ""
            :field/age 0}
           (:new-value state)))))

(deftest make/renders-combined-model-layout-from-resolved-schema
  (let [view (form/make {:model :person
                         :models {:person
                                  {:schema person-schema
                                   :value {:field/name "Ada"
                                           :field/age 36}}}
                         :text {:field/name "Name"}
                         :layout [:field/name]})
        field-view (form-child view 0)]
    (is (= 2 (count (:children field-view))))
    (is (= "Name"
           (get-in field-view [:children 0 :state :value])))))

(deftest make/renders-keyword-fields-with-prefixed-input
  (let [view (form/make {:schema {:field/id {:type :keyword
                                             :required true
                                             :auto-focus? true}}
                         :text {:field/id "Id"}
                         :layout [:field/id]
                         :value {:field/id :scene/ground}})
        field-view (form-child view 0)
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-keyword-input (:mode control)))
    (is (= "scene/ground"
           (get-in control [:state :value])))
    (is (= true (get-in control [:state :auto-focus?])))))

(deftest make/renders-valid-values-fields-with-select-control
  (let [view (form/make {:schema {:field/role
                                  {:type :keyword
                                   :valid-values
                                   [:role/stable-lad
                                    :role/stable-master]}}
                         :text {:field/role "Role"}
                         :layout [:field/role]
                         :value {:field/role :role/stable-lad}})
        field-view (form-child view 0)
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value nil
             :label ""}
            {:value :role/stable-lad
             :label "role/stable-lad"}
            {:value :role/stable-master
             :label "role/stable-master"}]
           (get-in control [:state :options])))))

(deftest make/renders-context-backed-valid-values-fields-with-select-control
  (let [view (form/make {:schema {:field/place
                                  {:type :keyword
                                   :required true
                                   :valid-values
                                   {:from [:vocabularies :places]
                                    :value-path [:id]
                                    :label-path [:label]}}}
                         :context {:vocabularies
                                   {:places
                                    [{:id :place/dawnkeep-stables
                                      :label "Dawnkeep Stables"}]}}
                         :layout [:field/place]
                         :value {:field/place
                                 :place/dawnkeep-stables}})
        field-view (form-child view 0)
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value :place/dawnkeep-stables
             :label "Dawnkeep Stables"}]
           (get-in control [:state :options])))))

(deftest make/renders-dependent-valid-values-with-current-form-value
  (let [view (form/make {:schema {:source
                                  {:type :keyword
                                   :required true
                                   :valid-values [:landmarks
                                                  :terrain]}
                                  :id
                                  {:type :keyword
                                   :required true
                                   :valid-values
                                   {:from {:field [:source]
                                           :sources
                                           {:landmarks [:landmarks]
                                            :terrain [:terrain]}}
                                    :value-path [:value]
                                    :label-path [:label]}}}
                         :context {:landmarks [{:value :dawnkeep
                                                :label "Dawnkeep"}]
                                   :terrain [{:value :blackmere
                                              :label "Blackmere"}]}
                         :layout [:source :id]
                         :value {:source :terrain
                                 :id :blackmere}})
        id-view (form-child view 1)
        control (nth (:children id-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [:id] (get-in control [:state :field-path])))
    (is (= [{:value :blackmere
             :label "Blackmere"}]
           (filter (get-in control [:state :options])
                   (fn [option]
                     (= :blackmere (:value option))))))))

(deftest make/renders-active-discriminated-union-fields
  (let [view (form/make {:schema
                         {:definitions
                          {:rule-base
                           {:type :object
                            :fields {:type {:type :keyword
                                            :valid-values
                                            [:preferred-position :edge]}}}
                           :preferred-position-rule
                           {:extends :rule-base
                            :fields {:point {:type :number}}}
                           :edge-rule
                           {:extends :rule-base
                            :fields {:target {:type :keyword}}}}
                          :schema {:type :union
                                   :discriminator :type
                                   :base {:ref :rule-base}
                                   :variants
                                   {:preferred-position
                                    {:ref :preferred-position-rule}
                                    :edge {:ref :edge-rule}}}}
                         :value {:type :preferred-position
                                 :point 3}})
        union-control (form-child view 0)
        union-children (object-control-children union-control)
        type-view (head union-children)
        point-view (nth union-children 1)
        target-view (nth union-children 2)]
    (is (= 'pixils/form-object-control (:mode union-control)))
    (is (nil? (-> union-control :state :field-path-prefix)))
    (is (= 2 (count union-children)))
    (is (= :type (-> type-view :state :field-id)))
    (is (= 'pixils/form-field (:mode point-view)))
    (is (contains? (:state point-view) :form-value))
    (is (= :visible (get-in point-view [:style :visibility])))
    (is (nil? target-view))))

(deftest make/renders-nested-discriminated-union-field
  (let [view (form/make {:schema
                         {:definitions
                          {:effect-base
                           {:type :object
                            :fields {:kind {:type :keyword
                                            :valid-values
                                            [:move :wait]}}}
                           :move-effect
                           {:extends :effect-base
                            :fields {:distance {:type :number}}}
                           :wait-effect
                           {:extends :effect-base
                            :fields {:duration {:type :integer}}}
                           :effect
                           {:type :union
                            :discriminator :kind
                            :base {:ref :effect-base}
                            :variants {:move {:ref :move-effect}
                                       :wait {:ref :wait-effect}}}}
                          :schema {:field/effect {:ref :effect}}}
                         :layout [:field/effect]
                         :value {:field/effect {:kind :move
                                                :distance 1.5}}})
        effect-view (form-child view 0)
        union-control (nth (:children effect-view) 1)
        union-children (object-control-children union-control)
        kind-view (head union-children)
        kind-control (nth (:children kind-view) 1)
        distance-view (nth union-children 1)
        distance-control (nth (:children distance-view) 1)
        duration-view (nth union-children 2)]
    (is (= 'pixils/form-object-control (:mode union-control)))
    (is (= 2 (count union-children)))
    (is (= [:field/effect :kind] (get-in kind-view [:state :field-path])))
    (is (= [:kind] (get-in kind-view [:state :local-field-path])))
    (is (= [:field/effect :kind]
           (get-in kind-control [:state :field-path])))
    (is (= [:kind]
           (get-in kind-control [:state :local-field-path])))
    (is (= [:field/effect :distance]
           (get-in distance-view [:state :field-path])))
    (is (= [:distance] (get-in distance-view [:state :local-field-path])))
    (is (= 'pixils/form-select-control (:mode kind-control)))
    (is (= 'ui/number-input (:mode distance-control)))
    (is (= :visible (get-in kind-view [:style :visibility])))
    (is (= :visible (get-in distance-view [:style :visibility])))
    (is (nil? duration-view))))

(deftest make/renders-nested-union-field-with-active-variant-layout
  (let [view (form/make {:schema
                         {:definitions
                          {:effect-base
                           {:type :object
                            :fields {:kind {:type :keyword
                                            :valid-values [:move :wait]}}}
                           :move-effect
                           {:extends :effect-base
                            :fields {:distance {:type :number}}}
                           :wait-effect
                           {:extends :effect-base
                            :fields {:duration {:type :integer}}}
                           :effect
                           {:type :union
                            :discriminator :kind
                            :base {:ref :effect-base}
                            :variants {:move {:ref :move-effect}
                                       :wait {:ref :wait-effect}}}}
                          :schema {:field/effect {:ref :effect}}}
                         :layout {:root [:field/effect]
                                  :fragments
                                  {:effect
                                   {:cases
                                    [{:where {:variant :move}
                                      :layout [:distance :kind]}
                                     {:where {:variant :wait}
                                      :layout [:duration :kind]}]}}}
                         :value {:field/effect {:kind :move
                                                :distance 1.5}}})
        effect-view (form-child view 0)
        union-control (nth (:children effect-view) 1)]
    (is (= [:distance :kind]
           (for [field (object-control-children union-control)]
             (-> field :state :local-field-path head))))))

(deftest make/renders-fragment-case-matching-any-selector
  (let [view (form/make {:schema
                         {:definitions
                          {:effect-base
                           {:type :object
                            :fields {:kind {:type :keyword
                                            :valid-values [:move]}}}
                           :move-effect
                           {:extends :effect-base
                            :fields {:distance {:type :number}}}
                           :effect
                           {:type :union
                            :discriminator :kind
                            :base {:ref :effect-base}
                            :variants {:move {:ref :move-effect}}}}
                          :schema {:primary {:ref :effect}
                                   :secondary {:ref :effect}}}
                         :layout {:root [:primary :secondary]
                                  :fragments
                                  {:effect
                                   {:default [:kind]
                                    :cases
                                    [{:where [{:path [:secondary]}
                                              {:path [:alternate]}]
                                      :layout [:distance :kind]}]}}}
                         :value {:primary {:kind :move
                                           :distance 1.5}
                                 :secondary {:kind :move
                                             :distance 2.5}}})
        primary-view (form-child view 0)
        primary-control (nth (:children primary-view) 1)
        secondary-view (form-child view 1)
        secondary-control (nth (:children secondary-view) 1)]
    (is (= [:kind]
           (for [field (object-control-children primary-control)]
             (-> field :state :local-field-path head))))
    (is (= [:distance :kind]
           (for [field (object-control-children secondary-control)]
             (-> field :state :local-field-path head))))))

(deftest make/renders-active-union-object-field-with-missing-value
  (let [view (form/make {:schema
                         {:definitions
                          {:rule-base
                           {:type :object
                            :fields {:type {:type :keyword
                                            :valid-values [:distance-range]}}}
                           :distance
                           {:type :object
                            :fields {:min {:type :number}
                                     :max {:type :number}}}
                           :distance-rule
                           {:extends :rule-base
                            :fields {:distance {:ref :distance}}}
                           :rule
                           {:type :union
                            :discriminator :type
                            :base {:ref :rule-base}
                            :variants
                            {:distance-range {:ref :distance-rule}}}}
                          :schema {:field/rule {:ref :rule}}}
                         :layout [:field/rule]
                         :value {:field/rule {:type :distance-range}}})
        rule-view (form-child view 0)
        rule-control (nth (:children rule-view) 1)
        rule-children (object-control-children rule-control)
        distance-view (nth rule-children 1)
        distance-control (nth (:children distance-view) 1)
        distance-children (object-control-children distance-control)
        min-view (head distance-children)
        max-view (nth distance-children 1)]
    (is (= :distance (-> distance-view :state :field-id)))
    (is (= 'pixils/form-object-control (:mode distance-control)))
    (is (= :min (-> min-view :state :field-id)))
    (is (= :max (-> max-view :state :field-id)))))

(deftest make/renders-fields-through-named-definition-references
  (let [view (form/make {:schema {:definitions
                                  {:stable-role
                                   {:type :keyword
                                    :valid-values
                                    [:role/stable-lad
                                     :role/stable-master]}}
                                  :schema
                                  {:field/role {:ref :stable-role}}}
                         :text {:field/role "Role"}
                         :layout [:field/role]
                         :value {:field/role :role/stable-lad}})
        field-view (form-child view 0)
        control (nth (:children field-view) 1)]
    (is (= 'pixils/form-select-control (:mode control)))
    (is (= [{:value nil
             :label ""}
            {:value :role/stable-lad
             :label "role/stable-lad"}
            {:value :role/stable-master
             :label "role/stable-master"}]
           (get-in control [:state :options])))))

(deftest make/renders-object-root-fields-without-explicit-layout
  (let [view (form/make {:schema {:type :object
                                  :fields {:relation
                                           {:type :keyword
                                            :valid-values
                                            [:place-relation/works-at]}
                                           :priority
                                           {:type :integer
                                            :min 1}}}
                         :value {:relation :place-relation/works-at
                                 :priority 10}})
        relation-view (form-child view 0)
        relation-control (nth (:children relation-view) 1)
        priority-view (form-child view 1)
        priority-control (nth (:children priority-view) 1)]
    (is (= 2 (count (form-children view))))
    (is (= 'pixils/form-select-control (:mode relation-control)))
    (is (= 'ui/number-input (:mode priority-control)))))

(deftest make/renders-number-fields-with-fractional-input-enabled
  (let [number-view (form/make {:schema {:distance {:type :number}}
                                :value {:distance 0.1}})
        integer-view (form/make {:schema {:count {:type :integer}}
                                 :value {:count 1}})
        number-control (nth (:children (form-child number-view 0)) 1)
        integer-control (nth (:children (form-child integer-view 0)) 1)]
    (is (= 'ui/number-input (:mode number-control)))
    (is (= true (get-in number-control [:state :allow-fractions?])))
    (is (= :blur (get-in number-control [:state :commit-on])))
    (is (= 'ui/number-input (:mode integer-control)))
    (is (= false (get-in integer-control [:state :allow-fractions?])))
    (is (= :blur (get-in integer-control [:state :commit-on])))))

(deftest make/renders-fields-with-form-change-metadata
  (let [view (form/make {:schema {:name {:type :text}
                                  :count {:type :integer}
                                  :enabled? {:type :boolean}
                                  :role {:type :keyword
                                         :valid-values [:a :b]}}
                         :value {:name "Ada"
                                 :count 1
                                 :enabled? false
                                 :role :a}})
        fields (form-children view)
        name-field (head fields)
        count-field (nth fields 1)
        enabled-field (nth fields 2)
        role-field (nth fields 3)
        name-control (nth (:children name-field) 1)
        count-control (nth (:children count-field) 1)
        enabled-control (nth (:children enabled-field) 1)
        role-control (nth (:children role-field) 1)]
    (is (= :name (get-in name-field [:state :field-id])))
    (is (= [:name] (get-in name-field [:state :field-path])))
