;; pixils.form/array-dialog-result-state

(deftest array-dialog-result-state/appends-and-projects-new-item
  (let [state (form/form-state
               {:schema person-schema
                :value {:field/name "Ada"
                        :field/age 36}
                :items [{:field/name "Ada"
                         :field/age 36}]
                :selected-index 0
                :new-value-fn empty-person})
        next-state (form/form-state
                    (form/array-dialog-result-state
                     state
                     {:type :confirm
                      :new? true
                      :value {:field/name "Grace"
                              :field/age 85}}))]
    (is (= [{:field/name "Ada"
             :field/age 36}
            {:field/name "Grace"
             :field/age 85}]
           (:items next-state)))
    (is (= 1 (:selected-index next-state)))
    (is (= {:field/name "Grace"
            :field/age 85}
           (:value next-state)))))

(deftest array-dialog-result-state/replaces-existing-empty-item
  (let [state {:items [{}]
               :selected-index 0
               :projected-index 0
               :projected-item {}
               :value {}}
        replaced (form/array-dialog-result-state
                  state
                  {:type :confirm
                   :new? false
                   :index 0
                   :value {:relation :place-relation/works-at
                           :place-id :workstation/stable-hand-post
                           :anchor :stand}})
        projected (form/projection-state replaced)]
    (is (= [{:relation :place-relation/works-at
             :place-id :workstation/stable-hand-post
             :anchor :stand}]
           (:items replaced)))
    (is (= {:relation :place-relation/works-at
            :place-id :workstation/stable-hand-post
            :anchor :stand}
           (:value projected)))))



;; pixils.form/array-items-change-payload

(deftest array-items-change-payload/updates-nested-form-state
  (let [view (form/array-control-view
              :parts
              {:type :array
               :items {:type :object
                       :fields {:id {:type :keyword}}}}
              {:field-path-prefix [:shape]
               :schema {:type :object
                        :fields {:parts {:type :array
                                         :items {:type :object
                                                 :fields {:id
                                                          {:type :keyword}}}}}}
               :value {:parts [{:id :base}]}}
              [{:id :base}])
        state (assoc (:state view)
                     :items [{:id :base}]
                     :form-value {:shape {:parts [{:id :base}]}})
        payload (form/array-items-change-payload
                 state
                 (assoc state
                        :items [{:id :base}
                                {:id :cove}]))
        next-form-state
        (form/changed-form-state
         {:schema {:shape {:type :object
                           :fields {:parts {:type :array
                                            :items {:type :object
                                                    :fields {:id
                                                             {:type
                                                              :keyword}}}}}}}
          :value {:shape {:parts [{:id :base}]}}}
         payload)]
    (is (= [:shape :parts] (:field-path payload)))
    (is (= [:parts] (:local-field-path payload)))
    (is (= {:shape {:parts [{:id :base}
                            {:id :cove}]}}
           (:form-value payload)))
    (is (= [{:id :base}
            {:id :cove}]
           (-> next-form-state :value :shape :parts)))
    (is (nil? (-> next-form-state :value :parts)))))



