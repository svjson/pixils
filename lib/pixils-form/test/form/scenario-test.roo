(deftest array-item-dialog-body/uses-active-root-union-variant-layout
  (let [body (form/array-item-dialog-body
              {:definitions
               {:rule-base
                {:type :object
                 :fields {:type {:type :keyword
                                 :valid-values [:preferred-position
                                                :distance-range]}}}
                :preferred-position-rule
                {:extends :rule-base
                 :fields {:point {:type :number}}}
                :distance-range-rule
                {:extends :rule-base
                 :fields {:distance {:type :number}}}
                :rule
                {:type :union
                 :discriminator :type
                 :base {:ref :rule-base}
                 :variants {:preferred-position
                            {:ref :preferred-position-rule}
                            :distance-range
                             {:ref :distance-range-rule}}}}
               :schema {:ref :rule}}
              {:layout {:fragments
                        {:rule {:cases
                                [{:where {:variant :preferred-position}
                                  :layout [:point :type]}
                                 {:where {:variant :distance-range}
                                  :layout [:distance :type]}]}}}
               :value {:type :preferred-position
                       :point 3}})
        item-form (head (:children body))
        union-control (head (form-children item-form))]
    (is (= [:point :type]
           (for [field (object-control-children union-control)]
             (-> field :state :field-id))))))

(deftest array-item-dialog-body/keeps-default-root-union-layout-dynamic
  (let [body (form/array-item-dialog-body
              {:definitions
               {:rule-base
                {:type :object
                 :fields {:type {:type :keyword
                                 :valid-values [:preferred-position
                                                :distance-range]}}}
                :preferred-position-rule
                {:extends :rule-base
                 :fields {:point {:type :number}}}
                :distance-range-rule
                {:extends :rule-base
                 :fields {:distance {:type :number}}}
                :rule
                {:type :union
                 :discriminator :type
                 :base {:ref :rule-base}
                 :variants {:preferred-position
                            {:ref :preferred-position-rule}
                            :distance-range
                            {:ref :distance-range-rule}}}}
               :schema {:ref :rule}}
              {:value {:type :preferred-position
                       :point 3}})
        item-form (head (:children body))
        union-control (head (form-children item-form))
        union-children (object-control-children union-control)
        point-view (nth union-children 1)
        distance-view (nth union-children 2)]
    (is (nil? (-> item-form :state :form/layout)))
    (is (nil? (-> union-control :state :layout)))
    (is (= :point (-> point-view :state :field-id)))
    (is (nil? distance-view))))

(deftest array-item-dialog-body/preserves-custom-controls
  (let [custom-control (fn [field-id field-schema field-label opts]
                         {:mode 'test/custom-control
                          :state {:field-id field-id
                                  :label field-label}})
        body (form/array-item-dialog-body
              {:type :object
               :fields {:group {:type :group-membership}}}
              {:controls {:group-membership custom-control}
               :text {:group "Group"}})
        item-form (head (:children body))
        field-view (head (form-children item-form))
        control (nth (:children field-view) 1)]
    (is (= 'test/custom-control (:mode control)))
    (is (= :group (-> control :state :field-id)))
    (is (= "Group" (-> control :state :label)))))
