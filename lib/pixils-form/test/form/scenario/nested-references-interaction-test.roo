(ns pixils.form.scenario.nested-references-interaction-test
  (:require proof.core
            [proof.syntax :as s]
            [pixils.test :as px]))



;; Nested referenced item editors

(deftest nested-references/renders-initial-selected-union-branch
  (s/when []
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800
                                 :buffer-height 400
                                 :render-backend false})]
      (px/eval-file!
       app
       "assets/roo/pixils/form/fixture/nested-references.roo")
      (px/push-mode! app 'nested-references-probe)
      (px/settle-layout! app)
      (for [field (px/find-views app "pixils/form-field")]
        (-> field :state :field-id))))

  (s/then [field-ids]
    (is (= [:groups :members :name :kind :email]
           field-ids))))

(deftest nested-references/selects-through-each-array-level
  (s/given
    (let [app (px/make-app {:package-root "."
                                 :buffer-width 800
                                 :buffer-height 400
                                 :render-backend false})]
      (px/eval-file!
       app
       "assets/roo/pixils/form/fixture/nested-references.roo")
      (px/push-mode! app 'nested-references-probe)
      (px/settle-layout! app)
      app))

  (s/when [app]
    (px/click! app
                    (px/find-view-containing app
                                                  "ui/list-box-item"
                                                  "Reviewers"))
    (px/settle-layout! app)
    (let [reviewer-visible?
          (some? (px/find-view-containing app
                                                "ui/list-box-item"
                                                "Grace"))]
      (px/click! app
                      (px/find-view-containing app
                                                    "ui/list-box-item"
                                                    "Lin"))
      (px/settle-layout! app)
      {:reviewer-visible? reviewer-visible?
       :selected-indices
       (for [control (px/find-views app "pixils/form-array-control")]
         (select-keys (:state control) [:field-id :selected-index]))
       :field-ids
       (for [field (px/find-views app "pixils/form-field")]
         (-> field :state :field-id))
       :selected-member
       (-> (px/find-view app "ui/text-input-inner") :ui-state :value)}))

  (s/then [result]
    (is (= {:reviewer-visible? true
            :selected-indices [{:field-id :groups :selected-index 1}
                               {:field-id :members :selected-index 1}]
            :field-ids [:groups :members :name :kind :command]
            :selected-member "Lin"}
           result))))
