(ns pixils.form.layout-test
  (:require proof.core
            [pixils.form.layout :as layout]))



;; pixils.form.layout/normalize-layout-item

(deftest normalize-layout-item/normalizes-section-layout-shorthand
  (is (= {:title "Identity"
          :layout [:field/name :field/age]
          :type :section
          :class :identity}
         (layout/normalize-layout-item
          [:section.identity "Identity" :field/name :field/age]))))



;; pixils.form.layout/layout-projection

(deftest layout-projection/searches-through-section-children
  (is (= :people
         (layout/layout-projection
          [{:type :section
            :title "People"
            :layout [{:type :selection
                      :projection :people}
                     {:type :action
                      :id :person/save}
                     {:type :form
                      :projection :person
                      :layout [:field/name]}]}]))))



;; pixils.form.layout/layout-selection

(deftest layout-selection/searches-through-section-children
  (is (= {:type :selection
          :projection :people}
         (layout/layout-selection
          [{:type :section
            :title "People"
            :layout [{:type :selection
                      :projection :people}
                     {:type :action
                      :id :person/save}
                     {:type :form
                      :projection :person
                      :layout [:field/name]}]}]))))



;; pixils.form.layout/layout-actions

(deftest layout-actions/searches-through-section-children
  (is (= [{:type :action
           :id :person/save}]
         (layout/layout-actions
          [{:type :section
            :title "People"
            :layout [{:type :selection
                      :projection :people}
                     {:type :action
                      :id :person/save}
                     {:type :form
                      :projection :person
                      :layout [:field/name]}]}]))))



;; pixils.form.layout/section-wrapper

(deftest section-wrapper/defaults-are-depth-aware
  (is (= [:group-box :plain :none]
         [(layout/section-wrapper {} {})
          (layout/section-wrapper {}
                                  {:form/section-depth 1})
          (layout/section-wrapper {}
                                  {:form/section-depth 2
                                   :section-wrappers {2 :none}})])))
